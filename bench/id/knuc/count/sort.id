kn_sort(string[] ks, int[] cs) {
  int i = 1;
  while(i < len(cs)) {
    kn_sink(ks, cs, i);
    i = i + 1;
  }
} return void;
(["a", "b", "c"], [1, 3, 2]):(["b", "c", "a"], [3, 2, 1])
(["b", "a"], [4, 4]):(["a", "b"], [4, 4])

kn_sink(string[] ks, int[] cs, int j) {
  while(j > 0 && kn_before(cs, ks, j) == 1) {
    kn_swap(ks, cs, j);
    j = j - 1;
  }
} return void;
(["a", "b"], [1, 3], 1):(["b", "a"], [3, 1], 1)
(["a", "b"], [3, 1], 1):(["a", "b"], [3, 1], 1)

kn_swap(string[] ks, int[] cs, int j) {
  string tk = ks[j];
  int tc = cs[j];
  ks[j] = ks[j - 1];
} chain (string[] ks, int[] cs, int j) {
  cs[j] = cs[j - 1];
  ks[j - 1] = tk;
  cs[j - 1] = tc;
} return void;
(["a", "b"], [1, 2], 1):(["b", "a"], [2, 1], 1)
(["x", "y", "z"], [1, 2, 3], 2):(["x", "z", "y"], [1, 3, 2], 2)
