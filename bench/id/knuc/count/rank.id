kn_collect(string[] keys, int[] used, int[] vals, string[] ks, int[] cs) {
  int i = 0;
  while(i < len(keys)) {
    kn_take(keys, used, vals, ks, cs, i);
    i = i + 1;
  }
} return void;
(["", "x", "", "y"], [0, 1, 0, 1], [0, 5, 0, 7], [], []):(["", "x", "", "y"], [0, 1, 0, 1], [0, 5, 0, 7], ["x", "y"], [5, 7])
([""], [0], [0], ["z"], [1]):([""], [0], [0], ["z"], [1])

kn_take(string[] keys, int[] used, int[] vals, string[] ks, int[] cs, int i) {
  if(used[i] == 1) {
    push(ks, keys[i]);
    push(cs, vals[i]);
  }
} return void;
(["a", "b"], [1, 0], [3, 4], [], [], 0):(["a", "b"], [1, 0], [3, 4], ["a"], [3], 0)
(["a", "b"], [1, 0], [3, 4], [], [], 1):(["a", "b"], [1, 0], [3, 4], [], [], 1)

kn_before(int[] cs, string[] ks, int j) {
  int b = 0;
  if(cs[j] > cs[j - 1]) {
    b = 1;
  } else if(cs[j] == cs[j - 1]) {
    b = str_cmp(ks[j], ks[j - 1]) < 0;
  }
} return int b;
([3, 5], ["a", "b"], 1):(1)
([5, 5], ["b", "a"], 1):(1)
([5, 5], ["a", "b"], 1):(0)
