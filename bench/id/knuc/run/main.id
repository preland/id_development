main(int argc, string[] argv) {
  string text = read_all();
  kn_run(text);
} return int 0;
stdin "AACG\n" (1, ["p"]):(0) then prints:("A 50.000\nC 25.000\nG 25.000\n\nAA 33.333\nAC 33.333\nCG 33.333\n\n0\tGGT\n0\tGGTA\n0\tGGTATT\n0\tGGTATTTTAATT\n0\tGGTATTTTAATTTATAGT\n")
stdin "GGTA\nGGTA\n" (1, ["p"]):(0) then prints:("G 50.000\nA 25.000\nT 25.000\n\nGG 28.571\nGT 28.571\nTA 28.571\nAG 14.285\n\n2\tGGT\n2\tGGTA\n0\tGGTATT\n0\tGGTATTTTAATT\n0\tGGTATTTTAATTTATAGT\n")

kn_run(string text) {
  string seq = kn_seq(text);
  kn_freq(seq, 1);
  kn_freq(seq, 2);
} chain (string text) {
  kn_each(seq, (import kn_queries));
} return void;
("AACG\n"):() then prints:("A 50.000\nC 25.000\nG 25.000\n\nAA 33.333\nAC 33.333\nCG 33.333\n\n0\tGGT\n0\tGGTA\n0\tGGTATT\n0\tGGTATTTTAATT\n0\tGGTATTTTAATTTATAGT\n")
