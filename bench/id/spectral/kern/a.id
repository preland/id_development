sp_a(int i, int j) {
  float a = 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1);
} return float a;
(0, 0):(1.0)
(1, 2):(0.125)

sp_dot(float[] v, int n, int i) {
  float s = 0.0;
  int j = 0;
  while(j < n) {
    s = s + sp_a(i, j) * v[j];
    j = j + 1;
  }
} return float s;
([0.0, 4.0], 2, 0):(2.0)
([1.0, 1.0], 2, 0):(1.5)

sp_dot_t(float[] v, int n, int i) {
  float s = 0.0;
  int j = 0;
  while(j < n) {
    s = s + sp_a(j, i) * v[j];
    j = j + 1;
  }
} return float s;
([8.0, 0.0], 2, 0):(8.0)
([8.0, 0.0], 2, 1):(4.0)
