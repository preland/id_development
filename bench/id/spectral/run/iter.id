sp_fill(float[] xs, int n, float x) {
  while(n > 0) {
    push(xs, x);
    n = n - 1;
  }
} return void;
([], 3, 1.5):([1.5, 1.5, 1.5])
([2.0], 0, 1.0):([2.0])

sp_iter(float[] u, float[] v, float[] tmp, int n, int times) {
  while(times > 0) {
    sp_atav(u, v, tmp, n);
    sp_atav(v, u, tmp, n);
    times = times - 1;
  }
} return void;
([3.0], [0.0], [0.0], 1, 2):([3.0], [3.0], [3.0])
([3.0], [0.0], [0.0], 1, 0):([3.0], [0.0], [0.0])

sp_acc(float[] u, float[] v, int n, float[] acc) {
  int i = 0;
  while(i < n) {
    acc[0] = acc[0] + u[i] * v[i];
    acc[1] = acc[1] + v[i] * v[i];
    i = i + 1;
  }
} return void;
([1.0, 2.0], [3.0, 4.0], 2, [0.0, 0.0]):([1.0, 2.0], [3.0, 4.0], 2, [11.0, 25.0])
([1.0, 2.0], [3.0, 4.0], 0, [7.0, 8.0]):([1.0, 2.0], [3.0, 4.0], 0, [7.0, 8.0])
