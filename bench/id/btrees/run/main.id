bt_run(int maxd) {
  int md = bt_clamp(maxd);
  bt_stretch(md);
  Tree longlived = bt_make(md);
} chain (int maxd) {
  bt_rounds(md);
  print("long lived tree of depth " + md + "\t check: " + bt_check(longlived));
} return void;
