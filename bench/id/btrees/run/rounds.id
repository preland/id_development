bt_stretch(int md) {
  int s = md + 1;
  Tree t = bt_make(s);
  print("stretch tree of depth " + s + "\t check: " + bt_check(t));
} return void;
(2):() then prints:("stretch tree of depth 3\t check: 15\n")
(3):() then prints:("stretch tree of depth 4\t check: 31\n")

bt_rounds(int md) {
  int d = (import bt_min);
  while(d <= md) {
    bt_round(d, md);
    d = d + 2;
  }
} return void;
(5):() then prints:("32\t trees of depth 4\t check: 992\n")
(7):() then prints:("128\t trees of depth 4\t check: 3968\n32\t trees of depth 6\t check: 4064\n")

bt_round(int d, int md) {
  int iters = 1 << (md - d + (import bt_min));
  int sum = bt_sum(d, iters);
  print(iters + "\t trees of depth " + d + "\t check: " + sum);
} return void;
