fa_pick(float[] cum, float r) {
  int j = 0;
  while(cum[j] < r) {
    j = j + 1;
  }
} return int j;
([0.25, 0.5, 1.0], 0.3):(1)
([0.25, 0.5, 1.0], 0.0):(0)

fa_cum(float[] prob) {
  float[] out = [];
  float acc = 0.0;
  int i = 0;
} chain (float[] prob) {
  while(i < len(prob)) {
    acc = acc + prob[i];
    push(out, acc);
    i = i + 1;
  }
} return float[] out;
([0.5, 0.25, 0.25]):([0.5, 0.75, 1.0])
([]):([])

fa_ch(string syms, float[] cum, int[] rng) {
  float r = fa_rand(rng);
  int j = fa_pick(cum, r);
  int c = charat(syms, j);
} return int c;
("acgt", [0.25, 0.5, 0.75, 1.0], [42]):(99)
("acgt", [0.25, 0.5, 0.75, 1.0], [0]):(97)
