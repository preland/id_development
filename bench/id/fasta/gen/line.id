fa_sym_line(string syms, float[] cum, int[] rng, int m) {
  word ad = alloc(m + 1);
  int i = 0;
  while(i < m) {
    poke8(ad + i, fa_ch(syms, cum, rng));
    i = i + 1;
  }
} chain (string syms, float[] cum, int[] rng, int m) {
  string s = str_of_mem(ad, m);
} return string s;
("acgt", [0.25, 0.5, 0.75, 1.0], [42], 3):("cgg")
("acgt", [0.25, 0.5, 0.75, 1.0], [42], 0):("")

fa_alu_line(string alu, int k, int m) {
  int e = k + m;
  int al = len(alu);
  string s = str_slice(alu, k, fx_min(m, al - k));
} chain (string alu, int k, int m) {
  if(e > al) {
    s = s + str_slice(alu, 0, e - al);
  }
} return string s;
("abcdef", 1, 3):("bcd")
("abcdef", 4, 4):("efab")
