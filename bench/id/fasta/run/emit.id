fa_alu_emit(string alu, int k, int m) {
  print(fa_alu_line(alu, k, m));
  int al = len(alu);
  int nk = (k + m) % al;
} return int nk;
("abcdef", 4, 4):(2) then prints:("efab\n")
("abcdef", 0, 2):(2) then prints:("ab\n")

fa_repeat(string alu, int n, int w) {
  int k = 0;
  while(n > 0) {
    int m = fx_min(n, w);
    k = fa_alu_emit(alu, k, m);
    n = n - m;
  }
} return void;
("abcd", 7, 3):() then prints:("abc\ndab\nc\n")
("abcd", 0, 3):() then prints:("")

fa_random(string syms, float[] cum, int[] rng, int n, int w) {
  while(n > 0) {
    int m = fx_min(n, w);
    print(fa_sym_line(syms, cum, rng, m));
    n = n - m;
  }
} return void;
("acgt", [0.25, 0.5, 0.75, 1.0], [42], 3, 2):() then prints:("cg\ng\n")
("acgt", [0.25, 0.5, 0.75, 1.0], [42], 0, 2):() then prints:("")
