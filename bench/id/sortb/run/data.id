sb_gen(int n) {
  int[] xs = [];
  int s = (import sb_seed);
  while(n > 0) {
    s = (s * 1103515245 + 12345) & 2147483647;
    push(xs, s);
    n = n - 1;
  }
} return int[] xs;
(2):([1406932606, 654583775])
(0):([])

sb_sum(int[] r, int n) {
  int acc = 0;
  int i = 0;
  while(i < n) {
    acc = acc + r[i] * (i + 1);
    i = i + 1;
  }
} return int acc;
([1, 2, 3], 3):(14)
([5], 1):(5)

sb_report(int[] r, int n) {
  print(sb_sum(r, n));
  print(r[0]);
  print(r[n / 2]);
} chain (int[] r, int n) {
  print(r[n - 1]);
} return void;
([1, 2, 3], 3):() then prints:("14\n1\n2\n3\n")
([4], 1):() then prints:("4\n4\n4\n4\n")
