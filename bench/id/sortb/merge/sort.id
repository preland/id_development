sb_sort(int[] a, int[] b, int n) {
  int w = 1;
  int flip = 0;
  while(w < n) {
    sb_dir(a, b, w, n, flip);
    flip = 1 - flip;
    w = w * 2;
  }
} return int flip;
([3, 1, 2], [0, 0, 0], 3):(0)
([2, 1], [0, 0], 2):(1)

sb_zeros(int n) {
  int[] zs = [];
  while(n > 0) {
    push(zs, 0);
    n = n - 1;
  }
} return int[] zs;
(2):([0, 0])
(0):([])
