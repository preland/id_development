sb_merge(int[] src, int[] dst, int lo, int mid, int hi) {
  int i = lo;
  int j = mid;
  int k = lo;
} chain (int[] src, int[] dst, int lo, int mid, int hi) {
  while(i < mid && j < hi) {
    if(src[j] < src[i]) {
      dst[k] = src[j];
      j = j + 1;
    } else {
      dst[k] = src[i];
      i = i + 1;
    }
    k = k + 1;
  }
  while(i < mid) {
    dst[k] = src[i];
    i = i + 1;
    k = k + 1;
  }
  while(j < hi) {
    dst[k] = src[j];
    j = j + 1;
    k = k + 1;
  }
} return void;
