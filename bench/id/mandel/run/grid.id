md_px(int[] acc, int x, int n, float ci) {
  float cr = md_cr(x, n);
  int it = md_iter(0.0, 0.0, cr, ci, 0);
  md_tally(acc, it);
} return void;
([0, 0], 3, 4, 2.0):([0, 2], 3, 4, 2.0)
([0, 0], 3, 4, 0.0):([1, 50], 3, 4, 0.0)

md_row(int[] acc, int y, int n) {
  float ci = md_ci(y, n);
  int x = 0;
  while(x < n) {
    md_px(acc, x, n, ci);
    x = x + 1;
  }
} return void;
([0, 0], 0, 2):([0, 6], 0, 2)
([1, 10], 1, 2):([3, 110], 1, 2)

md_all(int[] acc, int n) {
  int y = 0;
  while(y < n) {
    md_row(acc, y, n);
    y = y + 1;
  }
} return void;
([0, 0], 1):([0, 2], 1)
([0, 0], 2):([2, 106], 2)
