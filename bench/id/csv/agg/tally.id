cv_new(int[] counts, int[] totals) {
  int idx = len(counts);
  push(counts, 0);
  push(totals, 0);
} return int idx;
([], []):(0)
([4, 5], [1, 2]):(2)

cv_scan(int[] counts, int[] totals, int[] out, int i) {
  if(totals[i] > out[0]) {
    out[0] = totals[i];
  }
  if(counts[i] >= (import cv_busy)) {
    out[1] = out[1] + 1;
  }
} return void;
([10, 2], [5, 99], [0, 0], 0):([10, 2], [5, 99], [5, 1], 0)
([10, 2], [5, 99], [50, 3], 1):([10, 2], [5, 99], [99, 3], 1)
