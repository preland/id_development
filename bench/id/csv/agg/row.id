cv_rows(string[] lines, string[] keys, int[] vals, int[] used, int[] cnt, int[] counts, int[] totals, word[] gt) {
  int i = 1;
  while(i < len(lines)) {
    cv_one(lines[i], keys, vals, used, cnt, counts, totals, gt);
    i = i + 1;
  }
} return void;
