cv_row(string line, string[] keys, int[] vals, int[] used, int[] cnt, int[] counts, int[] totals, word[] gt) {
  string[] parts = str_split(line, ",");
  int idx = cv_slot(keys, vals, used, cnt, counts, totals, parts[1]);
  int amount = to_int(parts[2]) * to_int(parts[3]);
} chain (string line, string[] keys, int[] vals, int[] used, int[] cnt, int[] counts, int[] totals, word[] gt) {
  cv_bump(counts, totals, idx, amount);
  gt[0] = gt[0] + amount;
  gt[1] = gt[1] + 1;
} return void;
