main(int argc, string[] argv) {
  string text = read_all();
  cv_run(text);
} return int 0;
stdin "id,customer,qty,price\n1,A,2,3\n2,A,1,4\n3,C,1,1\n" (1, ["p"]):(0) then prints:("3\n2\n11\n10\n0\n")
stdin "id,customer,qty,price\n" (1, ["p"]):(0) then prints:("0\n0\n0\n0\n0\n")

cv_stats(int[] counts, int[] totals) {
  int[] out = [0, 0];
  int i = 0;
  while(i < len(counts)) {
    cv_scan(counts, totals, out, i);
    i = i + 1;
  }
} return int[] out;
([10, 2], [5, 99]):([99, 1])
([], []):([0, 0])

cv_run(string text) {
  string[] lines = str_split(text, "\n");
  string[] keys = [];
  int[] vals = [];
} chain (string text) {
  int[] used = [];
  int[] cnt = [];
  hmap_init(keys, vals, used, cnt);
} chain (string text) {
  int[] counts = [];
  int[] totals = [];
  word[] gt = [0, 0];
} chain (string text) {
  cv_rows(lines, keys, vals, used, cnt, counts, totals, gt);
  int[] res = cv_stats(counts, totals);
  print(gt[1]);
} chain (string text) {
  print(hmap_count(cnt));
  print(gt[0]);
  print(res[0]);
} chain (string text) {
  print(res[1]);
} return void;
("id,customer,qty,price\n1,A,2,3\n2,A,1,4\n3,C,1,1\n"):() then prints:("3\n2\n11\n10\n0\n")
("id,customer,qty,price\n"):() then prints:("0\n0\n0\n0\n0\n")
