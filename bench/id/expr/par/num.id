ex_num(string text, int[] cur) {
  int v = 0;
  while(character_is_digit(ex_peek(text, cur)) == 1) {
    v = v * 10 + ex_peek(text, cur) - 48;
    cur[0] = cur[0] + 1;
  }
  v = v & (import ex_mask);
} return int v;
("123+4", [0]):(123)
("7", [0]):(7)

ex_tm(int op, int f, int g) {
  int r = 0;
  if(op == 42) {
    r = (f * g) & (import ex_mask);
  } else if(g != 0) {
    r = f / g;
  }
} return int r;
(42, 6, 7):(42)
(47, 9, 2):(4)
(47, 7, 0):(0)

ex_pm(int op, int t, int u) {
  int r = (t + u) & (import ex_mask);
  if(op == 45) {
    r = (t - u) & (import ex_mask);
  }
} return int r;
(43, 1, 2):(3)
(45, 1, 2):(1048575)
