ex_tail_t(string text, int[] cur, int f) {
  int op = ex_peek(text, cur);
  cur[0] = cur[0] + 1;
  int g = ex_factor(text, cur);
} chain (string text, int[] cur, int f) {
  int r = ex_tm(op, f, g);
} return int r;
("*3", [0], 4):(12)
("/2", [0], 9):(4)

ex_tail_e(string text, int[] cur, int t) {
  int op = ex_peek(text, cur);
  cur[0] = cur[0] + 1;
  int u = ex_term(text, cur);
} chain (string text, int[] cur, int t) {
  int r = ex_pm(op, t, u);
} return int r;
("+3", [0], 4):(7)
("-3", [0], 4):(1)
