jp_obj(string text, int[] cur, int[] tape, int keylen) {
  int node = jp_new(tape, (import jn_obj), 0, keylen);
  cur[0] = cur[0] + 1;
  jp_ws(text, cur);
} chain (string text, int[] cur, int[] tape, int keylen) {
  int go = 1;
  if(charat(text, cur[0]) == 125) {
    cur[0] = cur[0] + 1;
    go = 0;
  }
  while(go == 1) {
    go = jp_member(text, cur, tape, node);
  }
} return int node;
("{}", [0], [], 0):(0)
("{\"a\":1}", [0], [], 0):(0)

jp_member(string text, int[] cur, int[] tape, int parent) {
  jp_ws(text, cur);
  int klen = jp_key(text, cur);
  jp_ws(text, cur);
} chain (string text, int[] cur, int[] tape, int parent) {
  cur[0] = cur[0] + 1;
  jp_ws(text, cur);
  int child = jp_value(text, cur, tape, klen);
} chain (string text, int[] cur, int[] tape, int parent) {
  jp_attach(tape, parent, child);
  jp_ws(text, cur);
  int go = jp_more(text, cur);
} return int go;
("\"a\":1,", [0], [3, 0, -1, -1, -1, 0], 0):(1)
("\"a\":1}", [0], [3, 0, -1, -1, -1, 0], 0):(0)
