jp_arr(string text, int[] cur, int[] tape, int keylen) {
  int node = jp_new(tape, (import jn_arr), 0, keylen);
  cur[0] = cur[0] + 1;
  jp_ws(text, cur);
} chain (string text, int[] cur, int[] tape, int keylen) {
  int go = 1;
  if(character_code_at(text, cur[0]) == 93) {
    cur[0] = cur[0] + 1;
    go = 0;
  }
  while(go == 1) {
    go = jp_item(text, cur, tape, node);
  }
} return int node;
("[]", [0], [], 0):(0)
("[1,2]", [0], [], 0):(0)

jp_item(string text, int[] cur, int[] tape, int parent) {
  jp_ws(text, cur);
  int child = jp_value(text, cur, tape, 0);
  jp_attach(tape, parent, child);
} chain (string text, int[] cur, int[] tape, int parent) {
  jp_ws(text, cur);
  int go = jp_more(text, cur);
} return int go;
("1,", [0], [5, 0, -1, -1, -1, 0], 0):(1)
("1]", [0], [5, 0, -1, -1, -1, 0], 0):(0)
