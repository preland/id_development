jp_digits(string text, int[] cur) {
  int v = 0;
  while(chr_is_digit(charat(text, cur[0])) == 1) {
    v = v * 10 + charat(text, cur[0]) - 48;
    cur[0] = cur[0] + 1;
  }
} return int v;
("123,", [0]):(123)
("x", [0]):(0)

jp_num(string text, int[] cur, int[] tape, int keylen) {
  int neg = 0;
  if(charat(text, cur[0]) == 45) {
    neg = 1;
    cur[0] = cur[0] + 1;
  }
  int v = jp_digits(text, cur);
} chain (string text, int[] cur, int[] tape, int keylen) {
  if(neg == 1) {
    v = 0 - v;
  }
  int node = jp_new(tape, (import jn_num), v, keylen);
} return int node;
("12", [0], [], 0):(0)
("-3", [0], [9, 9, 9, 9, 9, 9], 0):(1)

jp_more(string text, int[] cur) {
  int c = charat(text, cur[0]);
  cur[0] = cur[0] + 1;
  int go = c == 44;
} return int go;
(",1", [0]):(1)
("]", [0]):(0)
