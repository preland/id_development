jp_strend(string text, int p) {
  while(jp_open(charat(text, p)) == 1) {
    p = p + jp_step(charat(text, p));
  }
} return int p;
("abc\"", 0):(3)
("a\\\"b\"", 0):(4)
("abc", 0):(3)

jp_key(string text, int[] cur) {
  int end = jp_strend(text, cur[0] + 1);
  int klen = end - cur[0] - 1;
  cur[0] = end + 1;
} return int klen;
("\"ab\":1", [0]):(2)
("\"\"", [0]):(0)

jp_str(string text, int[] cur, int[] tape, int keylen) {
  int slen = jp_key(text, cur);
  int node = jp_new(tape, (import jn_str), slen, keylen);
} return int node;
("\"abc\"", [0], [], 7):(0)
("\"abc\"", [0], [1, 2, 3, 4, 5, 6], 7):(1)
