sbd_run(int n) {
  string[] toks = sbd_gen(n);
  string joined = string_join(toks, ",");
  string[] parts = string_split(joined, ",");
} chain (int n) {
  int[] acc = [0, 0];
  sbd_scan(parts, acc);
  print(len(joined));
} chain (int n) {
  print(len(parts));
  print(acc[0]);
  print(acc[1]);
} return void;
