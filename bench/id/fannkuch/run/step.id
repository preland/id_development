fk_perm(int[] perm1, int[] perm, int[] count, int[] st, int r, int n) {
  fk_counts(count, r);
  fk_copy(perm1, perm, n);
  int flips = fk_flips(perm);
} chain (int[] perm1, int[] perm, int[] count, int[] st, int r, int n) {
  fk_tally(st, flips);
  int nr = fk_next(perm1, count, 1, n);
  if(nr == n) {
    nr = 0 - 1;
  }
} return int nr;
([0, 1], [0, 0], [0, 0], [0, 0, 0], 2, 2):(1)
([1, 0], [0, 0], [0, 1], [0, 0, 1], 1, 2):(-1)

fk_iota(int n) {
  int[] xs = [];
  int i = 0;
  while(i < n) {
    push(xs, i);
    i = i + 1;
  }
} return int[] xs;
(3):([0, 1, 2])
(0):([])

fk_zeros(int n) {
  int[] zs = [];
  while(n > 0) {
    push(zs, 0);
    n = n - 1;
  }
} return int[] zs;
(2):([0, 0])
(0):([])
