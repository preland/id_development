main(int argc, string[] argv) {
  int n = fk_n(argc, argv);
  fk_run(n);
} return int 0;
(1, ["p"]):(0) then prints:("228\nPfannkuchen(7) = 16\n")
(2, ["p", "3"]):(0) then prints:("2\nPfannkuchen(3) = 2\n")

fk_n(int argc, string[] argv) {
  int n = (import fk_default);
  if(argc > 1) {
    n = to_int(argv[1]);
  }
} return int n;
(1, ["p"]):(7)
(2, ["p", "5"]):(5)

fk_run(int n) {
  int[] perm1 = order_iota(n);
  int[] count = fk_zeros(n);
  int[] perm = fk_zeros(n);
} chain (int n) {
  int[] st = [0, 0, 0];
  int r = n;
  while(r > 0) {
    r = fk_perm(perm1, perm, count, st, r, n);
  }
} chain (int n) {
  print(st[1]);
  print("Pfannkuchen(" + n + ") = " + st[0]);
} return void;
(1):() then prints:("0\nPfannkuchen(1) = 0\n")
(3):() then prints:("2\nPfannkuchen(3) = 2\n")
