fk_flips(int[] perm) {
  int flips = 0;
  int k = perm[0];
  while(k != 0) {
    fk_rev(perm, k);
    flips = flips + 1;
    k = perm[0];
  }
} return int flips;
([0, 1, 2]):(0)
([3, 0, 1, 2]):(2)

fk_rev(int[] perm, int k) {
  int k2 = (k + 1) >> 1;
  int i = 0;
  while(i < k2) {
    list_swap(perm, i, k - i);
    i = i + 1;
  }
} return void;
([0, 1, 2], 2):([2, 1, 0])
([3, 2, 1, 0], 1):([2, 3, 1, 0])

fk_rot(int[] perm1, int r) {
  int p0 = perm1[0];
  int i = 0;
  while(i < r) {
    perm1[i] = perm1[i + 1];
    i = i + 1;
  }
} chain (int[] perm1, int r) {
  perm1[r] = p0;
} return void;
([0, 1, 2], 2):([1, 2, 0])
([5, 6], 1):([6, 5])
