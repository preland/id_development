fk_next(int[] perm1, int[] count, int r, int n) {
  int cur = r;
  int left = 0;
  while(cur < n) {
    left = fk_rd(perm1, count, cur);
    if(left > 0) {
      break;
    }
    cur = cur + 1;
  }
} return int cur;
([0, 1, 2], [2, 2, 2], 1, 3):(1)
([0, 1, 2], [2, 1, 2], 1, 3):(2)
([0, 1], [1, 1], 1, 2):(2)

fk_rd(int[] perm1, int[] count, int cur) {
  fk_rot(perm1, cur);
  count[cur] = count[cur] - 1;
  int left = count[cur];
} return int left;
([0, 1, 2], [2, 2, 2], 1):(1)
([0, 1], [1, 1], 1):(0)

fk_counts(int[] count, int r) {
  while(r != 1) {
    count[r - 1] = r;
    r = r - 1;
  }
} return void;
([0, 0, 0], 3):([0, 2, 3])
([7, 7], 1):([7, 7])
