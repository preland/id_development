fk_tally(int[] st, int flips) {
  if(flips > st[0]) {
    st[0] = flips;
  }
  fk_sign(st, flips);
} return void;
([2, 0, 0], 5):([5, 5, 1], 5)
([9, 0, 1], 3):([9, -3, 2], 3)

fk_sign(int[] st, int flips) {
  if(st[2] % 2 == 0) {
    st[1] = st[1] + flips;
  } else {
    st[1] = st[1] - flips;
  }
  st[2] = st[2] + 1;
} return void;
([0, 10, 0], 3):([0, 13, 1], 3)
([0, 10, 1], 3):([0, 7, 2], 3)

fk_copy(int[] src, int[] dst, int n) {
  int i = 0;
  while(i < n) {
    dst[i] = src[i];
    i = i + 1;
  }
} return void;
([1, 2, 3], [0, 0, 0], 3):([1, 2, 3], [1, 2, 3])
([1, 2, 3], [9, 9, 9], 2):([1, 2, 3], [1, 2, 9])
