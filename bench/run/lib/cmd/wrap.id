br_wrap(string cmd, string tf, string log) {
  string wc = "time -f %e -o " + tf + " sh -c '" + cmd + "' >> " + log + " 2>&1";
} return string wc;
("true", "t", "l"):("time -f %e -o t sh -c 'true' >> l 2>&1")
("exit 3", "u", "m"):("time -f %e -o u sh -c 'exit 3' >> m 2>&1")

br_tfp(string work) {
  string p = work + "/time.tmp";
} return string p;
("wc"):("wc/time.tmp")
("/x/y"):("/x/y/time.tmp")

br_logp(string work) {
  string p = work + "/results.tsv";
} return string p;
("wc"):("wc/results.tsv")
("/x/y"):("/x/y/results.tsv")
