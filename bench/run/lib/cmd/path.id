br_bin(string work, int tc, string name) {
  string p = work + "/bin/" + (import br_tc)[tc] + "/" + name;
} return string p;
("w", 0, "nbody"):("w/bin/gcc-O2/nbody")
("w", 5, "csv"):("w/bin/id-c/csv")

br_outp(string work, int tc, string name) {
  string p = work + "/out/" + (import br_tc)[tc] + "/" + name + ".out";
} return string p;
("w", 0, "nbody"):("w/out/gcc-O2/nbody.out")
("w", 6, "csv"):("w/out/id-llvm/csv.out")

br_dpath(string work, string file) {
  string p = work + "/data/" + file;
  if(file == "") {
    p = "";
  }
} return string p;
("w", "dna.txt"):("w/data/dna.txt")
("w", ""):("")
