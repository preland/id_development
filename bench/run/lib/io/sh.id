br_append(string path, string text) {
  int h = fs_open(path, "a");
  word ad = mem_of_str(text);
  int n = fs_write_mem(h, ad, len(text));
} chain (string path, string text) {
  int c = fs_close(h);
  int ok = n == len(text);
} return int ok;
