br_last(string path) {
  string txt = fs_read_text(path);
  string[] ls = str_split(str_trim(txt), "\n");
  string first = "";
} chain (string path) {
  if(len(ls) > 0) {
    first = str_trim(list_string_last(ls));
  }
} return string first;
given fs_temp_text("one\ntwo\n") ((import fs_temp_path)):("two")
given fs_temp_text("  pad  ") ((import fs_temp_path)):("pad")

br_resolve(string cmd, string file) {
  int rc = br_sh(cmd + " > " + file);
  string vs = br_last(file);
} return string vs;
given fs_temp_text ("") ("echo hello", (import fs_temp_path)):("hello")
given fs_temp_text ("") ("echo   spaced  ", (import fs_temp_path)):("spaced")
