br_meta_cmd(string work) {
  string cmd = "(uname -sr; lscpu | grep 'Model name'; nproc; gcc --version | head -1; clang --version | head -1; $BR_RUSTC -vV | head -1; node --version; cat /proc/loadavg; ps -eo pcpu,comm --sort=-pcpu | head -6) > " + work + "/meta.txt 2>&1";
} return string cmd;
("w"):("(uname -sr; lscpu | grep 'Model name'; nproc; gcc --version | head -1; clang --version | head -1; $BR_RUSTC -vV | head -1; node --version; cat /proc/loadavg; ps -eo pcpu,comm --sort=-pcpu | head -6) > w/meta.txt 2>&1")
("/x"):("(uname -sr; lscpu | grep 'Model name'; nproc; gcc --version | head -1; clang --version | head -1; $BR_RUSTC -vV | head -1; node --version; cat /proc/loadavg; ps -eo pcpu,comm --sort=-pcpu | head -6) > /x/meta.txt 2>&1")
