br_pad2(int n) {
  string s = "" + n;
  if(n < 10) {
    s = "0" + s;
  }
} return string s;
(5):("05")
(42):("42")

br_fmt2(int h) {
  string tail = br_pad2(h % 100);
  string s = "" + (h / 100) + "." + tail;
} return string s;
(123):("1.23")
(5):("0.05")

br_cs(string t) {
  string[] parts = string_split(t, ".");
  int w = to_int(parts[0]);
  int f = 0;
} chain (string t) {
  if(len(parts) > 1) {
    f = to_int(parts[1]);
  }
  int cs = w * 100 + f;
} return int cs;
("0.29"):(29)
("12.50"):(1250)
