br_median(int[] xs) {
  int m = 0;
  if(len(xs) > 0) {
    int[] srt = list_copy(xs);
    list_sort(srt);
    m = srt[len(srt) / 2];
  }
} return int m;
([3, 1, 2]):(2)
([4, 1, 3, 2]):(3)
([]):(0)

br_spread(int[] xs) {
  int pct = 0;
  int med = br_median(xs);
  if(med > 0) {
    pct = (list_maximum(xs) - list_minimum(xs)) * 100 / med;
  }
} return int pct;
([100, 110, 105]):(9)
([5, 5, 5]):(0)

br_ratio(int a, int b) {
  int r = 0;
  if(b > 0) {
    r = (a * 100 + b / 2) / b;
  }
} return int r;
(123, 100):(123)
(5, 0):(0)
