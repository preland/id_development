br_take(string line, string prefix, int col, int[] outl) {
  if(str_starts(line, prefix) == 1) {
    string[] fs = str_split(line, "\t");
    string cell = br_field(fs, col);
    push(outl, to_int(cell));
  }
} return void;
("R\tg\tn\t0\t29", "R\tg\tn\t", 4, []):("R\tg\tn\t0\t29", "R\tg\tn\t", 4, [29])
("R\tg\tm\t0\t29", "R\tg\tn\t", 4, [7]):("R\tg\tm\t0\t29", "R\tg\tn\t", 4, [7])

br_pick(string rows, string rkind, int tc, string name, int col) {
  string prefix = rkind + "\t" + (import br_tc)[tc] + "\t" + name + "\t";
  string[] ls = str_split(rows, "\n");
  int[] outl = [];
} chain (string rows, string rkind, int tc, string name, int col) {
  int i = 0;
  while(i < len(ls)) {
    br_take(ls[i], prefix, col, outl);
    i = i + 1;
  }
} return int[] outl;
("R\tgcc-O2\tnbody\t0\t29\nR\tgcc-O2\tnbody\t1\t31\nR\tgcc-O3n\tnbody\t0\t5\n", "R", 0, "nbody", 4):([29, 31])
("R\tgcc-O2\tnbody\t0\t29\n", "R", 1, "nbody", 4):([])

br_med(string rows, string rkind, int tc, string name, int col) {
  int[] vl = br_pick(rows, rkind, tc, name, col);
  int m = br_median(vl);
} return int m;
("R\tgcc-O2\tnbody\t0\t30\nR\tgcc-O2\tnbody\t1\t10\nR\tgcc-O2\tnbody\t2\t20\n", "R", 0, "nbody", 4):(20)
("", "R", 0, "nbody", 4):(0)
