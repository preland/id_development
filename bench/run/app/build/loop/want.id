br_want(string name, string filter) {
  int w = filter == "" || str_find(name, filter) >= 0;
} return int w;
("nbody", ""):(1)
("nbody", "bod"):(1)
("nbody", "zzz"):(0)

br_over(int t0, int budget) {
  int r = budget > 0 && ticks() - t0 >= budget * 1000;
} return int r;
(-100000, 1):(1)
(2000000000, 1):(0)
(0, 0):(0)

br_count(int kind, int reps) {
  int n = 1;
  if(kind == 1) {
    n = reps;
  }
} return int n;
(0, 5):(1)
(1, 5):(5)
