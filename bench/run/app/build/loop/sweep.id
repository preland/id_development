br_phase(string work, int kind, int reps, int core, int t0, int budget, string filter) {
  int i = 0;
  int over = 0;
  while(i < len((import br_names)) && over == 0) {
    over = br_row(work, kind, i, reps, core, t0, budget, filter);
    i = i + 1;
  }
} return int over;
