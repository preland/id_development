br_iarg(string[] argv, int k, int dfi) {
  int v = dfi;
  if(k < len(argv)) {
    v = to_int(argv[k]);
  }
} return int v;
(["p", "x", "7"], 2, 5):(7)
(["p"], 2, 5):(5)

br_sarg(string[] argv, int k, string dfs) {
  string vs = dfs;
  if(k < len(argv)) {
    vs = argv[k];
  }
} return string vs;
(["p", "w"], 1, ""):("w")
(["p"], 1, "d"):("d")

br_usage(string prog) {
  eprint("usage: " + prog + " WORKDIR [REPS [CORE [BUDGET_S [FILTER]]]]  -- run from the repository root; see docs/PERFORMANCE.md");
} return void;
("p"):() then eprints:("usage: p WORKDIR [REPS [CORE [BUDGET_S [FILTER]]]]  -- run from the repository root; see docs/PERFORMANCE.md\n")
("benchrun"):() then eprints:("usage: benchrun WORKDIR [REPS [CORE [BUDGET_S [FILTER]]]]  -- run from the repository root; see docs/PERFORMANCE.md\n")
