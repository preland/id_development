br_setup(string work) {
  int mk = fs_mkdir_p(work);
  string rustc = "";
  string root = "";
} chain (string work) {
  if(mk == 1) {
    rustc = br_resolve((import br_rustc_probe), work + "/rustc.path");
    root = br_resolve((import br_root_probe), work + "/root.path");
  }
  environment_put("BR_RUSTC", rustc);
  environment_put("BR_ROOT", root);
} chain (string work) {
  int gen = br_gen_bin(work, "$BR_ROOT/bench/ref/c/gen.c");
  string meta_cmd = "(uname -sr; lscpu | grep 'Model name'; nproc; gcc --version | head -1; clang --version | head -1; $BR_RUSTC -vV | head -1; node --version; cat /proc/loadavg; ps -eo pcpu,comm --sort=-pcpu | head -6) > " + work + "/meta.txt 2>&1";
  int meta = br_sh(meta_cmd);
} return string rustc;
given br_t_work given br_t_root given environment_put("BR_RUSTC", "/bin/true") ((import br_tw)):("/bin/true")
("/proc/nonesuch/w"):("")

br_phases(string work, int reps, int core, int t0, int budget, string filter) {
  br_datas(work, filter);
  int ob = br_phase(work, 0, reps, core, t0, budget, filter);
  int orr = ob;
} chain (string work, int reps, int core, int t0, int budget, string filter) {
  if(ob == 0) {
    orr = br_phase(work, 1, reps, core, t0, budget, filter);
  }
  int rc = orr * 3;
} return int rc;
given br_t_work ((import br_tw), 1, 0, 0, 0, "zzz"):(0)
given br_t_work ((import br_tw), 1, 0, -100000, 1, "zzz"):(3)

br_report(string work, int n) {
  string rows = fs_read_text(path_join(work, "results.tsv"));
  print("```");
  flush();
} chain (string work, int n) {
  int rc = br_sh("cat " + work + "/meta.txt 2>/dev/null");
  print("```");
  br_tables(rows, n);
} return void;
