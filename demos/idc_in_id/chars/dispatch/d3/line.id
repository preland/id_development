// Line tracking for diagnostics: the running line number, and the store
// helper it needs (an imported list cannot be index-assigned directly).

bump_line() {
  lset((import lexline), 0, (import lexline)[0] + 1);
  print("line " + (import lexline)[0]);
} return void;

lset(int[] xs, int i, int n) {
  xs[i] = n;
} return void;
