// Token scanners. Each advances its index parameter inside the loop (so no
// separate cursor declaration is needed) and prints one token. The caller uses
// the returned index to continue. Pattern: decl(buffer) + while + print = the
// full 3-action budget.

scan_ident(string src, int i) {
  string word = "";
  while(is_alnum(charat(src, i))) {
    word = word + chr(charat(src, i));
    i = i + 1;
  }
  print(kindof(word) + " " + word);
} return int i;

// An integer digit run, optionally extended with a '.' + fraction digits
// (see chars/numlit): num_end finds where the number ends and numkind picks
// "int" or "float" for the printed token; the text is sliced verbatim from
// the source, matching idc.py's float/int lexing exactly.
scan_number(string src, int i) {
  int e = digit_run_end(src, i);
  int fe = num_end(src, i, e);
  print(numkind(e, fe) + " " + slice_str(src, i, fe));
} return int fe;

// Caller passes the index of the first char *after* the opening quote, so the
// opening quote is already skipped; we return the index past the closing one.
// Backslash escapes are honored (see str_end), so a `\"` does not end the
// string early; the raw spelling is preserved in the token text.
scan_string(string src, int i) {
  int e = str_end(src, i);
  print("str " + chr(34) + slice_str(src, i, e) + chr(34));
} return int e + 1;
