// Character-class predicates over byte codes (charat returns a byte code, or
// -1 past the end). Each returns 1/0. Note the per-function variable names
// (sp_c, dg_c, ...): the unique-global-name rule forbids reusing a plain `c`.

is_space(int sp_c) {
  int sp = 0;
  if(sp_c == 32 || sp_c == 9 || sp_c == 10 || sp_c == 13) {
    sp = 1;
  }
} return int sp;

is_digit(int dg_c) {
  int dg = 0;
  if(dg_c >= 48 && dg_c <= 57) {
    dg = 1;
  }
} return int dg;

is_alpha(int al_c) {
  int al = 0;
  if((al_c >= 65 && al_c <= 90) || (al_c >= 97 && al_c <= 122) || al_c == 95) {
    al = 1;
  }
} return int al;
