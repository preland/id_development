// Dispatch chain, part 2: the tail of the per-character decision tree.

// number, or hand off
scan_numop(string src_d, int i_d) {
  int ni_d = 0;
  if(is_digit(charat(src_d, i_d))) {
    ni_d = scan_number(src_d, i_d);
  } else {
    ni_d = scan_strop(src_d, i_d);
  }
} return int ni_d;

// string literal (pass the index past the opening quote), else an operator
scan_strop(string src_e, int i_e) {
  int ni_e = 0;
  if(charat(src_e, i_e) == 34) {
    ni_e = scan_string(src_e, i_e + 1);
  } else {
    ni_e = scan_op(src_e, i_e);
  }
} return int ni_e;

// consume to end of line (or end of input)
skip_comment(string src_f, int i_f) {
  while(charat(src_f, i_f) != 10 && charat(src_f, i_f) != -1) {
    i_f = i_f + 1;
  }
} return int i_f;
