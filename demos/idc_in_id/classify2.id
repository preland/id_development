// Identifier-continuation test and keyword recognition.

is_alnum(int an_c) {
  int an = 0;
  if(is_alpha(an_c) || is_digit(an_c)) {
    an = 1;
  }
} return int an;

// The ten id keywords. One big boolean keeps this within the action limit.
is_kw(string kw_w) {
  int kw_yes = 0;
  if(kw_w == "int" || kw_w == "float" || kw_w == "string" || kw_w == "void" || kw_w == "if" || kw_w == "else" || kw_w == "while" || kw_w == "return" || kw_w == "export" || kw_w == "import") {
    kw_yes = 1;
  }
} return int kw_yes;

kindof(string ko_w) {
  string ko_k = "ident";
  if(is_kw(ko_w)) {
    ko_k = "kw";
  }
} return string ko_k;
