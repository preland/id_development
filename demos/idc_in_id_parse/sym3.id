// Lookups: variable type, function return type, and a linear name search.

lookup_var(string name) {
  int idx = find_str((import vnames), name);
  string t = "";
  if(idx >= 0) {
    t = (import vtypes)[idx];
  }
} return string t;

lookup_func(string name) {
  int idx = find_str((import fnames), name);
  string t = "";
  if(idx >= 0) {
    t = (import frets)[idx];
  }
} return string t;

find_str(string[] names, string name) {
  int i = 0;
  int found = 0 - 1;
  while(i < len(names)) {
    found = match_idx(names, i, name, found);
    i = i + 1;
  }
} return int found;
