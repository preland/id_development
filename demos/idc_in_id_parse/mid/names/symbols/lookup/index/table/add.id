ix_hit(string[] names, int[] bucket, int i, string name, int found) {
  int r = found;
  if(names[bucket[i]] == name) {
    r = bucket[i];
  }
} return int r;

// Appending a name and indexing it are one operation, so the index cannot be
// forgotten at a call site: the row number is the table's length *before* the
// name goes in, which is the index the name is about to occupy.
vidx_add(string name) {
  push((import vidx)[str_hash(name)], len((import vnames)));
  push((import vnames), name);
} return void;

fidx_add(string name) {
  push((import fidx)[str_hash(name)], len((import fnames)));
  push((import fnames), name);
} return void;
