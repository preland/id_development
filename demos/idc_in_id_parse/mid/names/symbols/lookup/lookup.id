// Lookups: variable type, function return type, and a linear name search.
//
// The two lookups go through the hash index (see index/); find_str stays for the
// tables that are asked about rarely enough not to need one.
//
// A variable is looked up by name *and* unit, because that is the scope the
// one-type-per-name rule covers. Function names stay program-wide: a call
// resolves to one function wherever it was written.

lookup_var(string name, int unit) {
  int idx = find_vix((import vidx)[str_hash(name)], name, unit);
  string t = "";
  if(idx >= 0) {
    t = (import vtypes)[idx];
  }
} return string t;

lookup_func(string name) {
  int idx = find_ix((import fnames), (import fidx)[str_hash(name)], name);
  string t = "";
  if(idx >= 0) {
    t = (import frets)[idx];
  }
} return string t;

find_str(string[] names, string name) {
  int i = 0;
  int found = 0 - 1;
  while(i < len(names)) {
    found = match_idx(names, i, name, found);
    i = i + 1;
  }
} return int found;
