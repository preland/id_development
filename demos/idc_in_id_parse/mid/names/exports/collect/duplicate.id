// A name may be exported only once (idc.py's pass 1 over exported
// declarations). Without this the second `export` silently re-initialises the
// same C global, which is a program with two owners for one piece of state
// and no complaint from anybody.

add_export2(int id, string owner) {
  chk_dupexp(id, owner);
  add_export(s2_of(id), s1_of(id), owner);
} return void;

chk_dupexp(int id, string owner) {
  if(find_str((import enames), s2_of(id)) >= 0) {
    dupexp_err(id, owner);
  }
} return void;

// The duplicate is recorded anyway, even though it was just rejected: the
// export table is what the later checks read to decide what a name means, and
// a half-built table would have them explaining a second, invented problem.
// Nothing is emitted once a check has failed, so the extra row is never seen.
dupexp_err(int id, string owner) {
  print(loc_at(owner, (import nline)[id]) + "'" + s2_of(id) + "' is already an exported global (exported by '" + export_owner(s2_of(id)) + "')");
  note_failure();
} return void;
