// One entry of `casefn` against one function node.
case_hit(int i, int node) {
  int n = 0;
  if((import casefn)[i] == node) {
    n = 1;
  }
} return int n;

// idc.py's message, word for word -- tests/invalid.sh requires both compilers
// to produce the same text for the same program.
report_cases(int i, int n) {
  print(prog_loc(i) + "function '" + s1_of((import prog)[i]) + "' has " + n + " test case(s); --require-tests needs at least 2 (see docs/TESTS.md)");
  note_failure();
} return void;
