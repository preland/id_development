// Recurse into compound statements when collecting exports.

exp_nested(int id, string owner) {
  if(k_of(id) == "if") {
    exp_branches(id, owner);
  } else {
    exp_loop(id, owner);
  }
} return void;

exp_branches(int id, string owner) {
  exp_list(l1_of(id), owner);
  exp_list(l2_of(id), owner);
} return void;

exp_loop(int id, string owner) {
  if(k_of(id) == "while") {
    exp_list(l1_of(id), owner);
  }
} return void;
