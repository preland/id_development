// The `file:line: error: ` prefix for a diagnostic about function `fname`.
// Looked up rather than threaded: every check would otherwise need to carry a
// file alongside the depth and the function name, and diagnostics are rare
// enough that a linear scan costs nothing.
//
// The line is still 1 -- the token stream carries no line numbers yet, which
// is the next thing the `#file` protocol should also record.
func_loc(string fname) {
} return string func_file(fname) + ":1: error: ";

func_file(string fname) {
  int i = 0;
  string s = "<stdin>";
  while(i < len((import prog))) {
    s = func_file_at(i, fname, s);
    i = i + 1;
  }
} return string s;

func_file_at(int i, string fname, string s) {
  string fpath = s;
  if(s1_of((import prog)[i]) == fname && i < len((import pfile))) {
    fpath = (import pfile)[i];
  }
} return string fpath;
