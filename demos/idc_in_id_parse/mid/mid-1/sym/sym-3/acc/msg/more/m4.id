// The two ways an `import` can fail to resolve: the name exists as somebody's
// private variable, or it does not exist at all.

report_no_export(string name, string owner, int ln) {
  print(loc_at(owner, ln) + "no exported variable named '" + name + "'");
  note_failure();
} return void;

report_not_exported(string name, string owner, int ln) {
  print(loc_at(owner, ln) + "variable '" + name + "' (in function '" + owner_of(name) + "') is not exported");
  note_failure();
} return void;
