// Record a function's return type, and the two table-append helpers.

sym_func(int id) {
  if(k_of(id) == "func") {
    add_func(s1_of(id), s2_of(id));
  }
} return void;

add_var(string name, string type) {
  push((import vnames), name);
  push((import vtypes), type);
} return void;

add_func(string name, string ret) {
  push((import fnames), name);
  push((import frets), ret);
} return void;
