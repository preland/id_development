// Declaration and assignment: does the value fit the slot it is going into?
// decl carries the written type in ns1 and the name in ns2; assign carries
// only a name, and the declared type comes from the symbol table.

chk_decl(int id) {
  if(bad_store(s1_of(id), i1_of(id)) == 1) {
    tc_err(id, "cannot initialize " + s1_of(id) + " '" + s2_of(id) + "' with a " + type_of(i1_of(id)) + " value");
  }
} return void;

chk_assign(int id) {
  if(bad_store(lookup_var(s1_of(id), (import nunit)[id]), i1_of(id)) == 1) {
    tc_err(id, "cannot assign a " + type_of(i1_of(id)) + " value to " + lookup_var(s1_of(id), (import nunit)[id]) + " '" + s1_of(id) + "'");
  }
} return void;

// The one place that decides "this value may not go here". An empty list
// literal is exempt: it has no type of its own and takes the wanted one, so
// judging it here would reject `string[] xs = [];` -- type_arr answers int[]
// for an empty literal, having nothing better to say.
bad_store(string want, int e) {
  int ok = 0;
  if(is_empty_arr(e) == 0 && bad_init(want, type_of(e)) == 1) {
    ok = 1;
  }
} return int ok;
