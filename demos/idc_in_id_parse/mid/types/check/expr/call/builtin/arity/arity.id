// Calling a builtin: the right number of arguments, of the right types.
//
// idc.py checks these inside gen_call, one hand-written `if` per builtin --
// thirty of them, each with its own arity test, its own type test and its own
// wording. The same facts are three questions here (how many, what does
// position `i` want, how is it worded) so a builtin is described rather than
// coded, and adding one is three list entries instead of a new branch.

chk_bi(int id) {
  if(is_builtin(s1_of(id)) == 1) {
    chk_bi_arity(id);
  }
} return void;

// Arity first, and nothing else if it is wrong -- as at a call to a defined
// function, asking what argument 2 should be when there is no argument 2
// would abort on the bounds check rather than report anything.
chk_bi_arity(int id) {
  if(len(l1_of(id)) != bi_arity(s1_of(id))) {
    bi_arity_err(id);
  } else {
    chk_bi_args(id);
  }
} return void;

// Two wordings, because idc.py has two: the flat-store and unsigned-word
// group share one shape and say "takes exactly N argument(s), got M"; every
// other builtin is written out by hand and spells the count as a word.
bi_arity_err(int id) {
  if(is_sysbi(s1_of(id)) == 1) {
    tc_err(id, s1_of(id) + " takes exactly " + bi_arity(s1_of(id)) + " argument" + bi_plural(s1_of(id)) + ", got " + len(l1_of(id)));
  } else {
    tc_err(id, s1_of(id) + " takes " + bi_count(s1_of(id)));
  }
} return void;
