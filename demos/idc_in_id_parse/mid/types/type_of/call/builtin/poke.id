// A word in string context becomes id_str_of_word (a word prints as %lld, an
// int as %d, so they need different helpers); everything else is already a
// string and stays as it is.

to_str3(string code, string type) {
  string s = code;
  if(type == "word") {
    s = "id_str_of_word(" + code + ")";
  }
} return string s;

// The flat-store writes. They return nothing, unlike every other systems
// builtin, so they get their own membership test.
is_pokefn(string name) {
  int ok = 0;
  if(name == "poke8" || name == "poke16" || name == "poke32" || name == "poke64") {
    ok = 1;
  }
} return int ok;
