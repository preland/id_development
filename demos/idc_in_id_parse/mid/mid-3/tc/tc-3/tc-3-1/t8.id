// The two comparison checks. Equality accepts two strings or two numbers;
// ordering accepts only two numbers -- id has no ordering on strings, and
// `"a" < "b"` is far more often a mistake than an intention.

chk_eq(int id) {
  string lt = type_of(i1_of(id));
  string rt = type_of(i2_of(id));
  if(cmp_bad(lt, rt, eq_ok(lt, rt)) == 1) {
    tc_err(id, "cannot compare " + lt + " with " + rt);
  }
} return void;

// Guarded first, so `+` and `&&` -- which reach here through chk_bin's else
// arm -- are not typed at all.
chk_ord(int id) {
  if(is_ordop(s1_of(id)) == 1) {
    chk_ord2(id);
  }
} return void;

chk_ord2(int id) {
  string lt = type_of(i1_of(id));
  string rt = type_of(i2_of(id));
  if(cmp_bad(lt, rt, ord_ok(lt, rt)) == 1) {
    tc_err(id, "cannot order " + lt + " and " + rt);
  }
} return void;
