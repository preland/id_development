// A float in string context becomes id_str_of_float; a string stays as is.

to_str2(string code, string type) {
  string s = code;
  if(type == "float") {
    s = "id_str_of_float(" + code + ")";
  }
} return string s;

// var and import both name a variable; their type is the variable's type.
is_nameref(int id) {
  int ok = 0;
  if(k_of(id) == "var" || k_of(id) == "import") {
    ok = 1;
  }
} return int ok;

// Extends the type_of dispatch chain (type_of2 -> here -> type_of3) with the
// float-literal case.
type_of_float(int id) {
  string t = type_of3(id);
  if(k_of(id) == "float") {
    t = "float";
  }
} return string t;
