// The type of a binary expression that is not a concatenation. Comparisons
// and the logical operators are int; arithmetic and bitwise operators widen
// their operands, mirroring idc.py's arith_result.

tb2(int id) {
  string t = "int";
  if(is_arith(s1_of(id))) {
    t = arith_result(type_of(i1_of(id)), type_of(i2_of(id)));
  }
} return string t;

// The operators whose result type follows their operands. `&& ||` are not
// here: they are predicates, and their result is always int.
is_arith(string s) {
  int ok = 0;
  if(s == "+" || s == "-" || s == "*" || s == "/" || s == "%" || s == "&" || s == "|" || s == "^" || s == "<<" || s == ">>") {
    ok = 1;
  }
} return int ok;

// Widening order is int < word < float, so mixing an index with an address
// gives an address rather than silently truncating it to 32 bits.
arith_result(string lt, string rt) {
  string t = ar2(lt, rt);
  if(lt == "float" || rt == "float") {
    t = "float";
  }
} return string t;
