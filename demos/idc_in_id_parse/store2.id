// Remaining exported state: the second string field, the two child-list
// fields, and the top-level program list.

init_rest() {
  init_c();
  init_d();
} return void;

init_c() {
  export string[] ns2 = [];
  export int[][] nl1 = [];
  export int[][] nl2 = [];
} return void;

init_d() {
  export int[] prog = [];
} return void;
