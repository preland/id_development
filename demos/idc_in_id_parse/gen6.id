// Emit a block of statements, and the start of the statement dispatch.
// A decl is emitted as an assignment (its C declaration was hoisted).

emit_block(int[] stmts, string ind) {
  int i = 0;
  while(i < len(stmts)) {
    emit_stmt(stmts[i], ind);
    i = i + 1;
  }
} return void;

emit_stmt(int id, string ind) {
  if(k_of(id) == "decl") {
    print(ind + s2_of(id) + " = " + emit_expr(i1_of(id)) + ";");
  } else {
    es2(id, ind);
  }
} return void;

es2(int id, string ind) {
  if(k_of(id) == "assign") {
    print(ind + s1_of(id) + " = " + emit_expr(i1_of(id)) + ";");
  } else {
    es3(id, ind);
  }
} return void;
