// Concatenation test, and string-context coercion (mirrors idc.py's
// to_string): an int becomes id_str_of_int, a float id_str_of_float.

is_concat(int id) {
  int ok = 0;
  if(s1_of(id) == "+" && one_is_str(id)) {
    ok = 1;
  }
} return int ok;

one_is_str(int id) {
  int ok = 0;
  if(type_of(i1_of(id)) == "string" || type_of(i2_of(id)) == "string") {
    ok = 1;
  }
} return int ok;

to_str(string code, string type) {
  string s = code;
  if(type == "int") {
    s = "id_str_of_int(" + code + ")";
  } else {
    s = to_str2(code, type);
  }
} return string s;
