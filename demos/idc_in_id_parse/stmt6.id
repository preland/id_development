// Declaration right-hand side, and assignment.

decl_rhs(int[] pos, string type, string name, int exported) {
  int expr = parse_expr(pos);
  skip_semi(pos);
} return int node_decl(type, name, expr, exported);

parse_assign(int[] pos) {
  string name = cur_text(pos);
  advance(pos);
  advance(pos);
} return int assign_rhs(pos, name);

assign_rhs(int[] pos, string name) {
  int expr = parse_expr(pos);
  skip_semi(pos);
} return int node_assign(name, expr);
