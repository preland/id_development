// Parse a type: a base keyword (int/float/string/void) plus any number of
// `[]` suffixes. Shared by declarations, parameters, and return clauses.

parse_type(int[] pos) {
  string t = cur_text(pos);
  advance(pos);
} return string add_brackets(t, pos);

add_brackets(string t, int[] pos) {
  while(cur_text(pos) == "[") {
    advance(pos);
    advance(pos);
    t = t + "[]";
  }
} return string t;
