// The string leaf, and the operator-class predicates.

parse_str(int[] pos) {
  string text = cur_text(pos);
  advance(pos);
} return int node_str(text);

is_relop(string s) {
  int ok = 0;
  if(s == "==" || s == "!=" || s == "<" || s == ">" || s == "<=" || s == ">=") {
    ok = 1;
  }
} return int ok;

is_addop(string s) {
  int ok = 0;
  if(s == "+" || s == "-") {
    ok = 1;
  }
} return int ok;
