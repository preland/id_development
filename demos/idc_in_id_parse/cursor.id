// Cursor over the token store. `pos` is a one-element int[] cell passed by
// reference. cur_kind / cur_text read the current token; advance moves past it.

cur_kind(int[] pos) {
  string k = "eof";
  if(pos[0] < len((import tkind))) {
    k = (import tkind)[pos[0]];
  }
} return string k;

cur_text(int[] pos) {
  string s = "";
  if(pos[0] < len((import ttext))) {
    s = (import ttext)[pos[0]];
  }
} return string s;

advance(int[] pos) {
  pos[0] = pos[0] + 1;
} return void;
