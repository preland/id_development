// A function definition: signature, hoisted locals, body, return.

emit_def(int id) {
  print(sig(id) + " {");
  hoist(id);
  emit_tail(id);
} return void;

emit_tail(int id) {
  emit_block(l2_of(id), "  ");
  emit_ret(id);
  print("}");
} return void;

// `c_rettype id_NAME(params)`
sig(int id) {
  string s = c_type(s2_of(id)) + " id_" + s1_of(id) + "(" + param_str(id) + ")";
} return string s;
