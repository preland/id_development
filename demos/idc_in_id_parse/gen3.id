// Parameter list for a signature: "void" if none, else "c_type name, ...".

param_str(int id) {
} return string pstr(l1_of(id));

pstr(int[] params) {
  string s = "void";
  if(len(params) > 0) {
    s = list_params(params);
  }
} return string s;

list_params(int[] params) {
  string out = "";
  int i = 0;
  while(i < len(params)) {
    out = out + sep_arg(i) + c_type(s1_of(params[i])) + " " + s2_of(params[i]);
    i = i + 1;
  }
} return string out;
