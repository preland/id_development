// id type -> C type. Any list type (ending in `]`) is the generic IdList*;
// otherwise it is a scalar.

c_type(string t) {
  string ct = "IdList*";
  if(charat(t, len(t) - 1) != 93) {
    ct = c_scalar(t);
  }
} return string ct;

c_scalar(string t) {
  string ct = "int";
  if(t == "string") {
    ct = "char*";
  } else {
    ct = cs2(t);
  }
} return string ct;

cs2(string t) {
  string ct = "int";
  if(t == "float") {
    ct = "double";
  } else {
    ct = cs3(t);
  }
} return string ct;
