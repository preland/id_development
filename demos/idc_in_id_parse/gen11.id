// id type -> C type. (Array types are out of scope for emission and fall
// through to int; the runnable programs are scalar.)

c_type(string t) {
  string ct = "int";
  if(t == "string") {
    ct = "char*";
  } else {
    ct = ctype2(t);
  }
} return string ct;

ctype2(string t) {
  string ct = "int";
  if(t == "float") {
    ct = "double";
  } else {
    ct = ctype3(t);
  }
} return string ct;

ctype3(string t) {
  string ct = "int";
  if(t == "void") {
    ct = "void";
  }
} return string ct;
