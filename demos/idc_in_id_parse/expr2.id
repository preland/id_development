// additive and multiplicative levels.

parse_add(int[] pos) {
  int left = parse_mul(pos);
  while(is_addop(cur_text(pos))) {
    left = fold_add(pos, left);
  }
} return int left;

fold_add(int[] pos, int left) {
  string op = cur_text(pos);
  advance(pos);
  int right = parse_mul(pos);
} return int node_bin(op, left, right);

parse_mul(int[] pos) {
  int left = parse_primary(pos);
  while(is_mulop(cur_text(pos))) {
    left = fold_mul(pos, left);
  }
} return int left;
