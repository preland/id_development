// Emit an expression as C. int -> digits; var/str -> the text; bin -> infix;
// call -> id_NAME(args).

emit_expr(int id) {
  string s = "" + i1_of(id);
  if(k_of(id) != "int") {
    s = ee2(id);
  }
} return string s;

// Compute the recursive bin form only when the node is a bin -- evaluating it
// eagerly would recurse into non-existent children of leaf nodes.
ee2(int id) {
  string s = ee3(id);
  if(k_of(id) == "bin") {
    s = "(" + emit_expr(i1_of(id)) + " " + map_op(s1_of(id)) + " " + emit_expr(i2_of(id)) + ")";
  }
} return string s;

ee3(int id) {
  string s = s1_of(id);
  if(k_of(id) == "call") {
    s = "id_" + s1_of(id) + "(" + emit_args(l1_of(id)) + ")";
  }
} return string s;
