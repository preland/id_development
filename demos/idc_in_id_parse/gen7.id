// Expression statement, then the if/while split.

es3(int id, string ind) {
  if(k_of(id) == "exprstmt") {
    print(ind + emit_expr(i1_of(id)) + ";");
  } else {
    es4(id, ind);
  }
} return void;

es4(int id, string ind) {
  if(k_of(id) == "if") {
    emit_if(id, ind);
  } else {
    emit_while(id, ind);
  }
} return void;

emit_if(int id, string ind) {
  print(ind + "if (" + emit_expr(i1_of(id)) + ") {");
  emit_block(l1_of(id), ind + "    ");
  emit_else(id, ind);
} return void;
