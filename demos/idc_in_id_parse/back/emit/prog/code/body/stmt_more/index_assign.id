// Index-assignment emission: `id_list_set(base, idx, box(value));`, and the
// dispatch hook that routes an iassign node out of the statement chain.

emit_iassign(int id, string ind) {
  string elem = elem_type(type_of(i1_of(id)));
  string val = box(emit_expr(l1_of(id)[0]), elem);
  emit_line(ind + iset_code(id, val));
} return void;

iset_code(int id, string val) {
} return string "id_list_set(" + emit_expr(i1_of(id)) + ", " + emit_expr(i2_of(id)) + ", " + val + ");";

es3b(int id, string ind) {
  if(k_of(id) == "iassign") {
    emit_iassign(id, ind);
  } else {
    es4(id, ind);
  }
} return void;
