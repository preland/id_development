// Recurse into the bodies of compound statements when hoisting.

// exported decls are C globals (emitted separately), so only non-exported
// locals are hoisted into the function
hoist_decl(int id) {
  if(i2_of(id) == 0) {
    print("    " + c_type(s1_of(id)) + " " + s2_of(id) + ";");
  }
} return void;

hoist_nested(int id) {
  if(k_of(id) == "if") {
    hoist_branches(id);
  } else {
    hoist_loop(id);
  }
} return void;

hoist_branches(int id) {
  hoist_list(l1_of(id));
  hoist_list(l2_of(id));
} return void;

