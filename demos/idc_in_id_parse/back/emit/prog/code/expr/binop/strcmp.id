// String equality: `a == b` on strings becomes (strcmp(a, b) == 0), matching
// idc.py (and likewise for != and the bare `=` equality).

emit_strcmp(int id) {
  string s = "(strcmp(" + emit_expr(i1_of(id)) + ", " + emit_expr(i2_of(id)) + ") " + map_op(s1_of(id)) + " 0)";
} return string s;

is_strcmp(int id) {
  int ok = 0;
  if(is_eqop(s1_of(id)) && both_str(id)) {
    ok = 1;
  }
} return int ok;

is_eqop(string op) {
  int ok = 0;
  if(op == "==" || op == "!=" || op == "=") {
    ok = 1;
  }
} return int ok;
