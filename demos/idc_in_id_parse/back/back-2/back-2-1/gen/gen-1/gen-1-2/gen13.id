// Binary expression. Three forms: id_concat for string `+`, a strcmp for
// string equality, and ordinary infix otherwise.

emit_bin(int id) {
  string s = emit_op2(id);
  if(is_concat(id)) {
    s = emit_concat(id);
  }
} return string s;

emit_op2(int id) {
  string s = emit_infix(id);
  if(is_strcmp(id)) {
    s = emit_strcmp(id);
  }
} return string s;

emit_infix(int id) {
  string s = "(" + emit_expr(i1_of(id)) + " " + map_op(s1_of(id)) + " " + emit_expr(i2_of(id)) + ")";
} return string s;
