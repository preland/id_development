// Registered once per name; a platform overload does not add a second row.
push_asm_sym(int i) {
  if(asm_first(i) == 1) {
    push_sym_row(i);
  }
} return void;

push_sym_row(int i) {
  push((import fnames), (import afname)[i]);
  push((import frets), (import afret)[i]);
} return void;

// asm functions are registered in the symbol table *before* the checks run,
// not inside emit(). They used to be registered after, which left every type
// check silently inactive on asm-using code -- the checks saw an unknown
// return type and, correctly, declined to guess, so a whole program could go
// unchecked with no diagnostic at all.
emit_checked(int argc, string[] argv) {
  register_asm_syms();
  check_program();
  guarded_emit(argc, argv);
} return void;
