// What the checks need set up before they run: the asm symbols, the extern
// table, and the one thing about the build that the AST cannot tell them.
//
// Whether a native backend is attached is a property of the *build*, not of
// the source: it comes from `--backend` or an `import.id` dependency, both of
// which live in the driver script. So it arrives as a flag, and everything
// below reads it from a cell rather than being handed an argument it would
// have to thread through every pass.
arg_setup(int argc, string[] argv) {
  register_asm_syms();
  init_xtab();
  xok_set(arg_xok(argc, argv, 1, 0));
} return void;

// `--extern-ok` anywhere in the arguments. Scanned rather than tested at a
// fixed position, because the driver also passes `--triple` and the AST dump
// takes a bare `ast`, and a flag whose meaning depends on its index is a trap
// the next flag falls into.
arg_xok(int argc, string[] argv, int i, int ok) {
  int r = ok;
  if(i < argc && argv[i] == "--extern-ok") {
    r = 1;
  } else if(i < argc) {
    r = arg_xok(argc, argv, i + 1, ok);
  }
} return int r;
