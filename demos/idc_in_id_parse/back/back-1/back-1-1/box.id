// Boxing a value into a uniform list cell (a long long), mirroring idc.py's
// box(): an int widens, a float is bit-copied, a pointer (string/list) goes
// through intptr_t. Plus elem_type, which strips a trailing `[]` to get a
// list's element type.

box(string code, string type) {
  string s = box2(code, type);
  if(type == "int") {
    s = "(long long)(" + code + ")";
  }
} return string s;

box2(string code, string type) {
  string s = "(long long)(intptr_t)(" + code + ")";
  if(type == "float") {
    s = "id_box_f(" + code + ")";
  }
} return string s;

elem_type(string t) {
  string out = "";
  int i = 0;
  while(i < len(t) - 2) {
    out = out + chr(charat(t, i));
    i = i + 1;
  }
} return string out;
