// Registered once per name; a platform overload does not add a second row.
push_asm_sym(int i) {
  if(asm_first(i) == 1) {
    push_sym_row(i);
  }
} return void;

push_sym_row(int i) {
  push((import fnames), (import afname)[i]);
  push((import frets), (import afret)[i]);
} return void;

emit_checked(int argc, string[] argv) {
  check_program();
  if(check_failed() == 0) {
    emit(argc, argv);
  }
} return void;
