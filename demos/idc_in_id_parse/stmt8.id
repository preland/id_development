// The body of an if (then block + optional else block), and while.

if_body(int[] pos, int cond) {
  int[] thenl = parse_block(pos);
  int[] elsel = parse_else(pos);
} return int node_if(cond, thenl, elsel);

parse_else(int[] pos) {
  int[] elsel = [];
  if(cur_text(pos) == "else") {
    advance(pos);
    elsel = parse_block(pos);
  }
} return int[] elsel;

parse_while(int[] pos) {
  advance(pos);
  int cond = cond_of(pos);
} return int node_while(cond, parse_block(pos));
