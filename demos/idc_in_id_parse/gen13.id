// Binary expression: ordinary infix, or id_concat when it is a string `+`.

emit_bin(int id) {
  string s = "(" + emit_expr(i1_of(id)) + " " + map_op(s1_of(id)) + " " + emit_expr(i2_of(id)) + ")";
  if(is_concat(id)) {
    s = emit_concat(id);
  }
} return string s;

emit_concat(int id) {
  string s = "id_concat(" + arg_str(i1_of(id)) + ", " + arg_str(i2_of(id)) + ")";
} return string s;

// an operand coerced to string context (id_str_of_int etc.)
arg_str(int id) {
} return string to_str(emit_expr(id), type_of(id));
