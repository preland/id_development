// Expression statement, and the start of an if. cond_of reads `( expr )`.

parse_exprstmt(int[] pos) {
  int expr = parse_expr(pos);
  skip_semi(pos);
} return int node_exprstmt(expr);

parse_if(int[] pos) {
  advance(pos);
  int cond = cond_of(pos);
} return int if_body(pos, cond);

cond_of(int[] pos) {
  advance(pos);
  int c = parse_expr(pos);
  advance(pos);
} return int c;
