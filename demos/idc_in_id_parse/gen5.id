// Recurse into the bodies of compound statements when hoisting.

hoist_nested(int id) {
  if(k_of(id) == "if") {
    hoist_branches(id);
  } else {
    hoist_loop(id);
  }
} return void;

hoist_branches(int id) {
  hoist_list(l1_of(id));
  hoist_list(l2_of(id));
} return void;

hoist_loop(int id) {
  if(k_of(id) == "while") {
    hoist_list(l1_of(id));
  }
} return void;
