// Symbol tables for the type pass. Thanks to id's rule that a variable name
// has one type program-wide, a single global table (name -> type) suffices:
//   vnames[k]/vtypes[k]  every parameter and local declaration
//   fnames[k]/frets[k]   every function and its return type

init_sym() {
  export string[] fnames = [];
  export string[] frets = [];
} return void;
