// type_of(id): the id type of an expression node. Dispatch on kind.
//   int -> int    str -> string    var -> its declared type
//   call -> callee/builtin return type    bin -> int, or string for concat

type_of(int id) {
  string t = "int";
  if(k_of(id) != "int") {
    t = type_of2(id);
  }
} return string t;

type_of2(int id) {
  string t = "string";
  if(k_of(id) != "str") {
    t = type_of3(id);
  }
} return string t;

type_of3(int id) {
  string t = lookup_var(s1_of(id));
  if(k_of(id) != "var") {
    t = type_of4(id);
  }
} return string t;
