// Declaration: [export] type name = expr ;

parse_decl(int[] pos) {
  int exported = take_export(pos);
  string type = parse_type(pos);
} return int finish_decl(pos, type, exported);

take_export(int[] pos) {
  int e = 0;
  if(cur_text(pos) == "export") {
    advance(pos);
    e = 1;
  }
} return int e;

finish_decl(int[] pos, string type, int exported) {
  string name = cur_text(pos);
  advance(pos);
  advance(pos);
} return int decl_rhs(pos, type, name, exported);
