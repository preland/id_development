// Top level is now either an asm declaration or an ordinary function.
parse_top(int[] pos) {
  if(cur_text(pos) == "asm") {
    parse_asm(pos);
  } else {
    push((import prog), parse_func(pos));
  }
} return void;

// asm "triple" name(params) { "insn" ... } return TYPE name;
parse_asm(int[] pos) {
  advance(pos);
  push((import aftriple), unquote(cur_text(pos)));
  advance(pos);
} return int asm_sig(pos);

asm_sig(int[] pos) {
  push((import afname), cur_text(pos));
  advance(pos);
  push((import afparams), parse_params(pos));
} return int asm_lines(pos);
