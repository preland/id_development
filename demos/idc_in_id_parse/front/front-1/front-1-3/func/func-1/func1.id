// Parse every function in the file, pushing each onto the program list.

parse_program(int[] pos) {
  while(cur_kind(pos) != "eof") {
    push((import prog), parse_func(pos));
  }
} return void;

// function: name ( params ) { body } return TYPE expr ;   (or `return void;`)
parse_func(int[] pos) {
  string name = cur_text(pos);
  advance(pos);
} return int func_sig(pos, name);

func_sig(int[] pos, string name) {
  int[] params = parse_params(pos);
  int[] body = parse_block(pos);
} return int func_ret(pos, name, params, body);
