// Parameter list: ( [type name (, type name)*] )

parse_params(int[] pos) {
  int[] params = [];
  scan_params(pos, params);
} return int[] params;

scan_params(int[] pos, int[] params) {
  advance(pos);
  fill_params(pos, params);
  advance(pos);
} return void;

fill_params(int[] pos, int[] params) {
  while(cur_text(pos) != ")" && cur_kind(pos) != "eof") {
    push(params, one_param(pos));
    skip_comma(pos);
  }
} return void;
