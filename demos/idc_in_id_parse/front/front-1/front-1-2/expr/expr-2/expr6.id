// Argument list body + the integer leaf.

fill_args(int[] pos, int[] args) {
  while(cur_text(pos) != ")" && cur_kind(pos) != "eof") {
    push(args, parse_expr(pos));
    skip_comma(pos);
  }
} return void;

skip_comma(int[] pos) {
  if(cur_text(pos) == ",") {
    advance(pos);
  }
} return void;

parse_int(int[] pos) {
  int value = to_int(cur_text(pos));
  advance(pos);
} return int node_int(value);
