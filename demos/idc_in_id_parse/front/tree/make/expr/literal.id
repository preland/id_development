// Expression-leaf constructors.
//
// int: ni1 = the value (for the AST dump), ni2 = 1 when the literal is too
// wide for an int, ns1 = the digits as written -- C emission prints those
// verbatim, since a 64-bit literal cannot survive the trip through an int.

node_int(string text, int value, int big) {
} return int newleaf("int", value, big, text, "");

node_var(string name) {
} return int newleaf("var", 0, 0, name, "");

node_str(string text) {
} return int newleaf("str", 0, 0, text, "");
