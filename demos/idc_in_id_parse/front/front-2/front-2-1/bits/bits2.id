// xor's fold step, and the and level.

fold_bitxor(int[] pos, int left) {
  advance(pos);
  int right = parse_bitand(pos);
} return int node_bin("^", left, right);

parse_bitand(int[] pos) {
  int left = parse_shift(pos);
  while(cur_text(pos) == "&") {
    left = fold_bitand(pos, left);
  }
} return int left;

fold_bitand(int[] pos, int left) {
  advance(pos);
  int right = parse_shift(pos);
} return int node_bin("&", left, right);
