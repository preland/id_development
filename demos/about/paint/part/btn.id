// The button: a filled rectangle inset in its idml cell, label centred.
ab_button() {
  int bx = ab_box("btn", 0);
  int by = ab_box("btn", 1);
  int bw = ab_box("btn", 2);
} chain () {
  int bh = ab_box("btn", 3);
  int col = d2_pack(52, 101, 235);
  d2_l_rect(bx + 16, by + 10, bw - 32, bh - 20, col);
} chain () {
  int lf = gui_font_open("sans-serif", 15);
  int lw = gui_text_width(lf, "Draw a block");
  int ll = gui_font_line(lf);
} chain () {
  int white = d2_pack(255, 255, 255);
  gui_text_draw(lf, bx + (bw - lw) / 2, by + (bh - ll) / 2, "Draw a block", white);
} return void;
given ab_fx ():() then ab_px_btn:(3433963)
given ab_fx ():() then ab_px_blk:(0)


// The "Name:" label, right-aligned in its cell, and the name box beside it.
ab_entry() {
  int lx = ab_box("label", 0);
  int ly = ab_box("label", 1);
  int lw = ab_box("label", 2);
} chain () {
  int lh = ab_box("label", 3);
  int lf = gui_font_open("sans-serif", 16);
  int ll = gui_font_line(lf);
} chain () {
  int tw = gui_text_width(lf, "Name:");
  gui_text_draw(lf, lx + lw - tw - 8, ly + (lh - ll) / 2, "Name:", 4210752);
  gui_textbox_draw((import ab_tb));
} return void;
given ab_fx ():() then ab_px_box:(16777215)
given ab_fx ():() then ab_px_btn:(0)
