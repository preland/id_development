// The hint beside the button: a line of grey text in the hint's cell while its ?@fresh gate is on, and
// nothing once the gate has hidden it, which leaves its cell empty.
ab_hint() {
  int hx = ab_box("hint", 0);
  int hy = ab_box("hint", 1);
  int hw = ab_box("hint", 2);
} chain () {
  int hh = ab_box("hint", 3);
  int hf = gui_font_open("sans-serif", 14);
  int hl = gui_font_line(hf);
} chain () {
  if(hw > 0) {
    gui_text_draw(hf, hx + 8, hy + (hh - hl) / 2, "<- try it", (import theme_l_label_tertiary));
  }
} return void;
