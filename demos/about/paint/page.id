// The title and the two lines of body text, placed in their idml rectangles by the font's own line
// height: each is centred in the height its rectangle was given, and the second line sits one line
// and six pixels under the first.
ab_head() {
  int tx = ab_box("title", 0);
  int ty = ab_box("title", 1);
  int tf = gui_font_open("sans-serif", 28);
} chain () {
  int th = ab_box("title", 3);
  int tl = gui_font_line(tf);
  gui_text_draw(tf, tx + 24, ty + (th - tl) / 2, "About this app", (import theme_l_label));
} chain () {
  int by = ab_box("body", 1);
  int bh = ab_box("body", 3);
  int bf = gui_font_open("sans-serif", 15);
} chain () {
  int bl = gui_font_line(bf);
  int y0 = by + (bh - 2 * bl - 6) / 2;
  gui_text_draw(bf, tx + 24, y0, "A small page built on id's standard GUI toolkit (idstd kit/ui).", (import theme_l_label_secondary));
} chain () {
  gui_text_draw(bf, tx + 24, y0 + bl + 6, "Its layout is read from about.idml at start-up. Click the button.", (import theme_l_label_secondary));
} return void;
