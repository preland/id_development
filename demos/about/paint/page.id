// The whole page, over the whole surface: background, heading, button, canvas and name box.
ab_paint(int k) {
  int bg = (import theme_l_window);
  surface_fill_rectangle(0, 0, (import pixel_surface_width), (import pixel_surface_height), bg);
  ab_head();
} chain (int k) {
  ab_button();
  ab_canvas(k);
  ab_entry();
} chain (int k) {
  ab_hint();
} return void;
