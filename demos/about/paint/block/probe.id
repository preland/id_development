// The pixel at (ab_x, ab_y): inside the button's fill clear of its label (370, 140), inside the first
// block's square (30, 225), or inside the name box clear of its text (300, 150).
ab_pixel(int ab_x, int ab_y) {
  int at = surface_pixel_index(ab_x, ab_y);
  int p = (import surface_pixels)[at];
} return int p;
