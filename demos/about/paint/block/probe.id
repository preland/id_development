// 1 when any pixel of the title's first 16 rows has the title colour.
ab_px_ttl() {
  int i = 0;
  int hit = 0;
  while(i < 3616 && hit == 0) {
    hit = ab_is_ttl(i);
    i = i + 1;
  }
} return int hit;
given ab_fx ():(0)
given ab_fx given ab_head ():(1)
