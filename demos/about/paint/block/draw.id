// 1 when any pixel of the whole surface is not black.
ab_px_any() {
  int i = 0;
  int hit = 0;
  while(i < 268800 && hit == 0) {
    hit = (import sf_l_px)[i] != 0;
    i = i + 1;
  }
} return int hit;
