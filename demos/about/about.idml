# about.idml -- the "about this app" page: a heading over a row holding a name box, a button and a hint
# that shows until the first block (?@fresh), over a canvas. The id program reads every rectangle from
# here at start-up and again at every window size.

Title:Col `title` {}
Body:Col `body` {}
Label:Col `label` {}
Field:Col `field` {}
Btn:Col `btn` {}
Canvas:Col `canvas` {}
Hint:Col `hint` {}

./
Col()[100,100,top-left] {
  Col()[30,100,top-left] {
    Title()[40,100,top-left]{}
    Body()[60,100,top-left]{}
  }
  Row()[15,100,top-left] {
    Spacer()[100,5,top-left]{}
    Label()[100,13,top-left]{}
    Field()[100,34,top-left]{}
    Spacer()[100,2,top-left]{}
    Btn()[100,28,top-left]{}
    Hint()[100,18,top-left]?@fresh{}
  }
  Canvas()[55,100,top-left]{}
}
