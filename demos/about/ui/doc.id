// The page document: about.idml parsed into the toolkit's tape and tiled once at start-up (640x420);
// ab_relayout tiles it again to every size the window takes. The state the page and the program share
// lives in a board (ab_bd), the toolkit's binding tables: the block count (blocks), whether the hint is
// still shown (fresh, which the hint's ?@fresh gate reads), the name box's text (the model cell name)
// and the text the canvas shows (say); the button's press is queued on it as the handler draw. It also
// keeps whether the page has changed since it was drawn (ab_flag).
ab_doc() {
  export int[] ab_t = [];
  export string[] ab_s = [];
  gui_new(ab_t, ab_s);
} chain () {
  int ab_e = gui_load("about.idml", ab_t, ab_s);
  export GuiBd ab_bd = gui_board();
  export int[] ab_rc = [];
} chain () {
  gui_set_num(ab_bd, "fresh", 1);
  gui_bind(ab_t, ab_s, ab_bd);
  gui_layout(ab_t, ab_rc, 640, 420);
} chain () {
  export int[] ab_flag = [0];
} return void;
():() then ab_btn_w:(179)
():() then ab_canvas_y:(189)

// Field k (0 x, 1 y, 2 width, 3 height) of the rectangle the class cls got.
ab_box(string cls, int k) {
  int nd = gui_find_cls((import ab_t), (import ab_s), cls);
  int v = gui_rect_get((import ab_rc), nd, k);
} return int v;
given ab_doc ("btn", 0):(346)
given ab_doc ("body", 3):(76)

// A document, an empty 640x420 surface, the font layer started and the name box made, for the cases.
ab_fx() {
  ab_doc();
  gui_font_init();
  sf_l_init(640, 420);
} chain () {
  ab_field();
} return void;
