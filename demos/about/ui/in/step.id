// The click count after every event the window has queued, or -1 when one of them quit, then the name
// box's once-a-frame work. It stops at the first quit rather than reading on.
ab_events(int k) {
  int[] ev = [0, 0, 0, 0, 0];
  int kind = gfx_event(ev);
  int nk = k;
} chain (int k) {
  while(kind != 0 && nk >= 0) {
    nk = ab_on(kind, ev, nk);
    kind = gfx_event(ev);
  }
  ab_idle();
} return int nk;
