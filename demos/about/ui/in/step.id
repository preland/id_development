// The click count after one event, or -1 when it asks to quit. The name box sees the event first. A click
// on the button counts on the press itself, so holding the button down adds one block, not one per frame,
// and Enter in the name box counts as the button; then what the box holds is what the canvas shows.
ab_on(int kind, int[] ev, int k) {
  int foc = gui_textbox_focused((import ab_tb));
  int r = gui_textbox_event((import ab_tb), kind, ev);
  int c = ab_click(kind, ev) + r / 2 % 2;
} chain (int kind, int[] ev, int k) {
  int q = ab_quit(kind, ev[1], foc);
  int nk = k + c;
  ab_mark(r);
} chain (int kind, int[] ev, int k) {
  if(c > 0) {
    ab_tell();
  }
  if(q == 1) {
    nk = 0 - 1;
  }
} return int nk;
