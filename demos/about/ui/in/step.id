// The click count after one event, or -1 when it asks to quit. The name box sees the event first. A click
// on the button queues the handler draw on the page's board on the press itself, so holding the button
// down queues one, not one per frame, and Enter in the name box queues it as the button does; the count
// itself changes when ab_drain reads the queue.
ab_on(int kind, int[] ev, int k) {
  int foc = gui_textbox_cell((import ab_tb), (import gui_tbw_o_focus));
  int r = gui_textbox_event((import ab_tb), kind, ev);
  int c = ab_click(kind, ev) + r / 2 % 2;
} chain (int kind, int[] ev, int k) {
  int q = ab_quit(kind, ev[1], foc);
  int nk = k;
  ab_mark(r);
} chain (int kind, int[] ev, int k) {
  if(c > 0) {
    gui_fire((import ab_bd), "draw", 0);
  }
  if(q == 1) {
    nk = 0 - 1;
  }
} return int nk;
