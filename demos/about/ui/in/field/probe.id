// What a case can read back of the name box and the canvas text.

// The name box's x.
ab_tb_x() {
  int ab_v = gui_textbox_cell((import ab_tb), 0);
} return int ab_v;
given ab_fx ():(115)
given ab_fx given gui_layout((import ab_t), (import ab_rc), 1000, 600) given ab_place ():(180)

// The name box's height.
ab_tb_h() {
  int ab_v = gui_textbox_cell((import ab_tb), 3);
} return int ab_v;
given ab_fx ():(28)
given ab_fx given gui_textbox_place((import ab_tb), 0, 0, 5, 9) ():(9)

// The text the canvas shows.
ab_say_text() {
  string ab_vs = gui_text((import ab_bd), "say");
} return string ab_vs;
given ab_fx ():("")
given ab_fx given gui_textbox_set((import ab_tb), "Ada") given ab_name given ab_tell ():("Ada")
