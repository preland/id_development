// What a case can read back of the name box and the canvas text.

// Cell k of the name box's small state: 0 its x, 3 its height.
ab_tb_cell(int ab_k) {
  int ab_v = gui_textbox_cell((import ab_tb), ab_k);
} return int ab_v;
given ab_fx (0):(115)
given ab_fx given gui_layout((import ab_t), (import ab_rc), 1000, 600) given ab_place (0):(180)
given ab_fx (3):(28)
given ab_fx given gui_textbox_place((import ab_tb), 0, 0, 5, 9) (3):(9)

// The text the canvas shows.
ab_say_text() {
  string ab_vs = gui_text((import ab_bd), "say");
} return string ab_vs;
given ab_fx ():("")
given ab_fx given gui_textbox_set((import ab_tb), "Ada") given ab_name given ab_tell ():("Ada")
