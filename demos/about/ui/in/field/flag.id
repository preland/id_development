// The name box's once-a-frame work: auto-scroll a drag that rests past an edge, set the pointer's shape,
// and note that the page changed if the box wants redrawing (its caret blinked).
ab_idle() {
  int ab_r = gui_textbox_tick((import ab_tb));
  int ab_h = gui_textbox_hover((import ab_tb), graphics_mouse_x(), graphics_mouse_y());
  ab_mark(ab_r);
} return void;
