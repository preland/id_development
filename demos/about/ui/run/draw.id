// Lay the document out again at the surface's size when the surface changed (ch is 1), and put the name box
// back in its cell. The layout list is refilled in place, so a drag costs no memory.
ab_relayout(int ch) {
  if(ch == 1) {
    gui_layout((import ab_t), (import ab_rc), (import pixel_surface_width), (import pixel_surface_height));
    ab_place();
  }
} return void;
