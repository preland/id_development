given ab_fx (4):(4) then ab_pixel(370, 140):(0)

// 1 when the page must be painted: the window was resized (ch), a click changed the count (k against the
// state's), the last paint never reached the screen, or the name box changed (a key, the caret blinking).
ab_dirty(int ch, int k, int st) {
  int d = 0;
  int f = ab_take();
  if(ch == 1 || k != st / 2 || st % 2 == 1 || f == 1) {
    d = 1;
  }
} return int d;
