// One frame. The state is the click count times two plus whether the last
// frame's picture is stale, so a frame that nothing changed costs no repaint;
// -1 means quit. The surface is fitted to the window first, so everything after
// it, the layout included, is at the window's real size.
ab_tick(int st) {
  int ch = gfx_sync();
  ab_relayout(ch);
  int k = ab_events(st / 2);
} chain (int st) {
  int d = ab_dirty(ch, k, st);
  int shown = ab_draw(k, d);
  sleep_ms(10);
} chain (int st) {
  int out = ab_pack(k, shown);
} return int out;
