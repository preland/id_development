// What the program does with the board once a frame's events are in: read the queue of handlers the page
// fired, and tell the page what changed.

// The click count after reading the queue: one more for every draw that fired, with the name box first
// copied into the model cell name (ab_name). When the count moved, the canvas text is taken from the cell
// (ab_tell) and the page is told (ab_publish). The queue is empty afterwards.
ab_drain(int k) {
  ab_name();
  int nk = k;
  int i = 0;
} chain (int k) {
  while(i < gui_fired((import ab_bd))) {
    nk = nk + (gui_fired_name((import ab_bd), i) == "draw");
    i = i + 1;
  }
  gui_fired_clear((import ab_bd));
  if(nk != k) {
    ab_tell();
    ab_publish(nk);
  }
} return int nk;
