// Tell the page how many blocks there are: write blocks, and fresh (the hint's gate, on until the first
// block), bind them into the layout and tile the page again at the surface's size.
ab_publish(int k) {
  gui_set_num((import ab_bd), "blocks", k);
  gui_set_num((import ab_bd), "fresh", k == 0);
  gui_bind((import ab_t), (import ab_s), (import ab_bd));
} chain (int k) {
  gui_layout((import ab_t), (import ab_rc), (import sf_l_w), (import sf_l_h));
  ab_place();
} return void;
