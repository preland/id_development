// wordcount -- read text on stdin, print each distinct word and how often it
// appeared, in the order the words were first seen.
//
//   ./wordcount < some.txt

main(int argc, string[] argv) {
  init();
  string read_all_v = read_all();
  run(read_all_v);
} return int 0;
stdin "ab cd ab\n" (1, ["prog"]):(0) then prints:("ab 2\ncd 1\n")
stdin "" (1, ["prog"]):(0) then prints:("")

run(string text) {
  tally(text);
  report();
} return void;
given init ("ab cd ab"):() then prints:("ab 2\ncd 1\n")
given init ("x x y"):() then prints:("x 2\ny 1\n")
given init (""):() then prints:("")

// The two tables the whole program shares. An export comes into existence
// when its declaring function runs, so this has to be called before anything
// reads them -- which is why it is main's first action.
init() {
  export string[] words = [];
  export int[] counts = [];
} return void export words;
():()
():() then len((import words)):(0)
