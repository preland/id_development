// wordcount -- read text on stdin, print each distinct word and how often it
// appeared, in the order the words were first seen.
//
//   ./wordcount < some.txt

main(int argc, string[] argv) {
  init();
  tally(read_all());
  report();
} return int 0;

// The two tables the whole program shares. An export comes into existence
// when its declaring function runs, so this has to be called before anything
// reads them -- which is why it is main's first action.
init() {
  export string[] words = [];
  export int[] counts = [];
} return void;
