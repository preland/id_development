// Adding a row, and bumping one.

add(string w) {
  push((import words), w);
  push((import counts), 1);
} return void;

// `(import counts)[k] = ...` does not compile: index-assignment is only
// recognised through a plain name. The list has to be handed to a function
// that takes it as a parameter -- and `lset` is already that function, in the
// standard library. Writing your own is a compile error even under a
// different name, because it would have the same signature and the same body.
inc(int k) {
  lset((import counts), k, (import counts)[k] + 1);
} return void;
