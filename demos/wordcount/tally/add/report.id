// Printing the table.

report() {
  int i = 0;
  while(i < len((import words))) {
    line(i);
    i = i + 1;
  }
} return void;
given wc2_setup ():() then prints:("a 1\nb 1\n")
given wc2_setup ():() then prints:("a 1\nb 1\n") then (import counts)[1]:(1)
given init ():() then prints:("")

line(int i) {
  print((import words)[i] + " " + (import counts)[i]);
} return void;
given wc2_setup (0):() then prints:("a 1\n")
given wc2_setup (1):() then prints:("b 1\n")
