// The tally itself: words[] and counts[] are one table in two lists, indexed
// together. This is how a record is spelled in id -- there is no struct, so a
// row is an index that means the same thing in every column.

bump(string w) {
  int k = find(w);
  if(k < 0) {
    add(w);
  } else {
    inc(k);
  }
} return void;

// -1 when the word is new. There is no `break`, so the loop runs to the end
// even after a hit; the words are distinct, so at most one index can match.
find(string w) {
  int k = 0 - 1;
  int i = 0;
  while(i < len((import words))) {
    k = maybe(k, w, i);
    i = i + 1;
  }
} return int k;

maybe(int k, string w, int i) {
  int r = k;
  if((import words)[i] == w) {
    r = i;
  }
} return int r;
