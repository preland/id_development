// Taking one word out of the text.

take_word(string text, int i) {
  int e = word_end(text, i);
  bump(slice(text, i, e));
} return int e;

word_end(string text, int i) {
  int e = i;
  while(e < len(text) && is_space(charat(text, e)) == 0) {
    e = e + 1;
  }
} return int e;

// id has no substring builtin, so one is built a character at a time. Fine
// for a word; see the tutorial's last section for why not for a whole file.
slice(string s, int a, int b) {
  string out = "";
  while(a < b) {
    out = out + chr(charat(s, a));
    a = a + 1;
  }
} return string out;
