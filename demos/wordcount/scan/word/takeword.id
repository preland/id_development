// Taking one word out of the text.

take_word(string text, int i) {
  int e = word_end(text, i);
  string slice_v = str_slice(text, i, e - i);
  bump(slice_v);
} return int e;
given init ("ab", 0):(2) then wc_len:(1)
given init ("ab cd", 3):(5) then wc_len:(1)

word_end(string text, int i) {
  int e = i;
  while(e < len(text) && is_space_at(text, e) == 0) {
    e = e + 1;
  }
} return int e;
("ab", 0):(2)
("ab cd", 3):(5)
