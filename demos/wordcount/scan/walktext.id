// Walking the text one word at a time.

tally(string text) {
  int i = 0;
  while(i < len(text)) {
    i = step(text, i);
  }
} return void;

// One step of the walk: skip a space, or take a whole word. Either way it
// answers "where does the next step start", which is what keeps the loop
// above down to a single action.
step(string text, int i) {
  int j = i;
  if(is_space_at(text, i) == 1) {
    j = i + 1;
  } else {
    j = take_word(text, i);
  }
} return int j;

// space, newline, tab, carriage return
is_space(int c) {
  int ok = 0;
  if(c == 32 || c == 10 || c == 9 || c == 13) {
    ok = 1;
  }
} return int ok;
