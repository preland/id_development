// The face of a foundation: its top card if any, else a "-X-" suit placeholder.

found_card_face(int x, int i) {
  if((import found)[i] > 0) {
    draw_card_at(x, 4, ((import found)[i] - 1) * 4 + i);
  } else {
    string suit_slot_v = suit_slot(i);
    draw_text(x, 4, suit_slot_v, 7);
  }
} return void;

suit_slot(int i) {
  string ret_s = "-" + (import suits)[i] + "-";
} return string ret_s;
