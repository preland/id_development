// The four foundation piles across the top, each showing its top card (or a
// suit placeholder) with the cursor / source marker beneath.

draw_foundations(int i) {
  while(i < 4) {
    draw_found(i);
    i = i + 1;
  }
} return void;

draw_found(int i) {
  int x = 24 + i * 8;
  draw_found_card(x, i);
  hl_if(2 + i, x, 4);
} return void;

draw_found_card(int x, int i) {
  draw_text(x, 3, "F" + (i + 1), 8);
  found_card_face(x, i);
} return void;
