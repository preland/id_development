// The stock pile: a label, a face-down back (or empty slot), and the cursor /
// source marker beneath it.

draw_stock_pile() {
  draw_text(2, 3, "STK", 8);
  draw_stock_card();
} return void;

draw_stock_card() {
  draw_pile_back(2, 4, len((import stock)));
  hl_if(0, 2, 4);
} return void;

draw_pile_back(int x, int y, int n) {
  if(n > 0) {
    draw_text(x, y, "[#]", 9);
  } else {
    draw_text(x, y, "[ ]", 7);
  }
} return void;
