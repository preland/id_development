// The waste pile: shows its top card face up (or an empty slot), with the
// cursor / source marker beneath.

draw_waste_pile() {
  draw_text(7, 3, "WST", 8);
  draw_waste_card();
} return void;

draw_waste_card() {
  draw_top_card(7, 4, (import waste));
  hl_if(1, 7, 4);
} return void;

draw_top_card(int x, int y, int[] xs) {
  if(len(xs) > 0) {
    draw_card_at(x, y, xs[len(xs) - 1]);
  } else {
    draw_text(x, y, "[ ]", 7);
  }
} return void;
