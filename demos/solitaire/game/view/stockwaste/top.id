// The stock pile: a label, a face-down back (or empty slot), and the cursor /
// source marker beneath it.

draw_stock_pile() {
  term_text(2, 3, "STK", 8);
  draw_stock_card();
} return void;
given make_sw given ui_init given idstd_term_fixture_setup ():() then calls term_text:(2, 3, "STK", 8)
given random_initialize(1) given build_deck given deal_and_ui given idstd_term_fixture_setup ():() then calls term_text:(2, 4, "[#]", 9)
given make_sw given ui_init given idstd_term_fixture_setup ():() then calls draw_stock_card:[1]

draw_stock_card() {
  int len_v = len((import stock));
  draw_pile_back(2, 4, len_v);
  hl_if(0, 2, 4);
} return void;
given make_sw given ui_init given idstd_term_fixture_setup ():() then calls draw_pile_back:(2, 4, 0)
given random_initialize(1) given build_deck given deal_and_ui given idstd_term_fixture_setup ():() then calls draw_pile_back:(2, 4, 24)

draw_pile_back(int x, int y, int n) {
  if(n > 0) {
    term_text(x, y, "[#]", 9);
  } else {
    term_text(x, y, "[ ]", 7);
  }
} return void;
given idstd_term_fixture_setup (2, 4, 1):() then calls term_text:(2, 4, "[#]", 9)
given idstd_term_fixture_setup (2, 4, 0):() then calls term_text:(2, 4, "[ ]", 7)
