// The waste pile: shows its top card face up (or an empty slot), with the
// cursor / source marker beneath.

draw_waste_pile() {
  term_text(7, 3, "WST", 8);
  draw_waste_card();
} return void;
given make_sw given ui_init given idstd_term_t_setup ():() then calls term_text:(7, 3, "WST", 8)
given make_sw given ui_init given idstd_term_t_setup ():() then calls draw_waste_card:[1]

draw_waste_card() {
  draw_top_card(7, 4, (import waste));
  hl_if(1, 7, 4);
} return void;
given make_sw given ui_init given idstd_term_t_setup ():() then calls draw_top_card:[1] then calls hl_if:(1, 7, 4)
given apply_board_setup(0) given labels_init given idstd_term_t_setup ():() then calls draw_top_card:[1] then calls hl_if:(1, 7, 4)

draw_top_card(int x, int y, int[] xs) {
  if(len(xs) > 0) {
    int len_v = len(xs);
    draw_card_at(x, y, xs[len_v - 1]);
  } else {
    term_text(x, y, "[ ]", 7);
  }
} return void;
given idstd_term_t_setup (7, 4, []):() then calls term_text:(7, 4, "[ ]", 7)
given labels_init given idstd_term_t_setup (7, 4, [5]):() then calls draw_card_at:(7, 4, 5)
