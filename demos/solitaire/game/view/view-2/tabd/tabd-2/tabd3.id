// Column markers: when the cursor is on a column, mark the grabbable face-up
// run; when a column is the selected source, mark the picked-up cards.

col_cursor(int col, int x) {
  cur_marker(col, x);
  src_marker(col, x);
} return void;

cur_marker(int col, int x) {
  if(ui_get(0) == col + 6) {
    cur_col_mark(col, x);
  }
} return void;

cur_col_mark(int col, int x) {
  if(col_len(col) == 0) {
    set_cell(x - 1, 7, 62, 13);
  } else {
    mark_grab(col, x);
  }
} return void;
