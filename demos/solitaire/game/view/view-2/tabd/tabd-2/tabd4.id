// Mark the grabbable face-up run (from the face-down boundary to the top) with
// a bright '>' down the left edge of those cards.

mark_grab(int col, int x) {
  mark_rows(col, x, (import fd)[col]);
} return void;

mark_rows(int col, int x, int start) {
  int j = start;
  while(j < col_len(col)) {
    set_cell(x - 1, 7 + j, 62, 13);
    j = j + 1;
  }
} return void;
