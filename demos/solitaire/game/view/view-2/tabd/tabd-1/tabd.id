// Draw all seven tableau columns. Each is positioned 9 cells apart; an empty
// column shows a single slot.

draw_tableau_all(int col) {
  while(col < 7) {
    draw_column(col);
    col = col + 1;
  }
} return void;

draw_column(int col) {
  int x = 2 + col * 9;
  draw_col_body(col, x);
  col_cursor(col, x);
} return void;

draw_col_body(int col, int x) {
  if(col_len(col) == 0) {
    draw_text(x, 7, "[ ]", 7);
  } else {
    draw_col_cards(col, x, 0);
  }
} return void;
