// Draw a column's cards top to bottom: a face-down card shows "[#]", a face-up
// card shows its label in suit color, one card per row.

draw_col_cards(int col, int x, int j) {
  while(j < col_len(col)) {
    draw_col_card(col, x, j);
    j = j + 1;
  }
} return void;

draw_col_card(int col, int x, int j) {
  if(j < (import fd)[col]) {
    draw_text(x, 7 + j, "[#]", 9);
  } else {
    draw_faceup(col, x, j);
  }
} return void;

// Naming the card, then padding and coloring its label, is exactly what
// draw_card_at (setup-2-2/pad.id) already does, so this calls it rather
// than repeating the same four statements under a new name -- which would
// make it a duplicate function, not just a similar one.
draw_faceup(int col, int x, int j) {
  int c = col_of(col)[j];
  draw_card_at(x, 7 + j, c);
} return void;
