// Repaint the whole table each frame: clear the buffer, draw the top piles,
// the tableau, and the status/help lines, then flush to the terminal.

paint() {
  clear();
  draw_all();
  render();
} return void;

draw_all() {
  draw_top();
  draw_tableau_all(0);
  draw_status();
} return void;

draw_top() {
  draw_stock_pile();
  draw_waste_pile();
  draw_foundations(0);
} return void;
