// Title, controls help, and the win banner.

draw_status() {
  draw_text(2, 0, "KLONDIKE SOLITAIRE", 13);
  draw_help();
  draw_win();
} return void;

draw_help() {
  draw_text(2, (import scrh) - 2, "a/d move   space draw/pick/drop   q quit", 6);
  draw_text(2, (import scrh) - 1, "foundations A..K by suit; tableau down, alternating color", 4);
} return void;

draw_win() {
  if(ui_get(4) == 1) {
    win_banner();
  }
} return void;
