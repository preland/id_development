// Draw all seven tableau columns. Each is positioned 9 cells apart; an empty
// column shows a single slot.

draw_tableau_all(int col) {
  while(col < 7) {
    draw_column(col);
    col = col + 1;
  }
} return void;
given ui_init given init_piles given idstd_term_t_setup (0):() then calls draw_column:(0) then calls draw_column:(6)
given ui_init given init_piles given idstd_term_t_setup (7):() then calls draw_column:[0]

draw_column(int col) {
  int x = 2 + col * 9;
  draw_col_body(col, x);
  col_cursor(col, x);
} return void;
given ui_init given init_piles given idstd_term_t_setup (0):() then calls draw_col_body:(0, 2) then calls col_cursor:(0, 2)
given ui_init given init_piles given idstd_term_t_setup (3):() then calls draw_col_body:(3, 29) then calls col_cursor:(3, 29)

draw_col_body(int col, int x) {
  if(col_len(col) == 0) {
    term_text(x, 7, "[ ]", 7);
  } else {
    draw_col_cards(col, x, 0);
  }
} return void;
given init_piles given idstd_term_t_setup (0, 3):() then calls term_text:(3, 7, "[ ]", 7)
given init_piles given push_tab0_card(5) given labels_init given idstd_term_t_setup (0, 3):() then calls draw_col_cards:(0, 3, 0)
