// Column markers: when the cursor is on a column, mark the grabbable face-up
// run; when a column is the selected source, mark the picked-up cards.

col_cursor(int col, int x) {
  cur_marker(col, x);
  src_marker(col, x);
} return void;
given ui_init given init_piles given idstd_term_t_setup (0, 2):() then calls cur_marker:(0, 2) then calls src_marker:(0, 2)
given ui_init given init_piles given idstd_term_t_setup (1, 11):() then calls cur_marker:(1, 11) then calls src_marker:(1, 11)

cur_marker(int col, int x) {
  if((import ui)[0] == col + 6) {
    cur_col_mark(col, x);
  }
} return void;
given ui_init given init_piles given idstd_term_t_setup (0, 3):() then calls cur_col_mark:(0, 3)
given ui_init given init_piles given select_cursor(0, 8, 1, 1) given idstd_term_t_setup (2, 7):() then calls cur_col_mark:(2, 7)
given ui_init given init_piles given idstd_term_t_setup (1, 5):() then calls cur_col_mark:[0]

cur_col_mark(int col, int x) {
  if(col_len(col) == 0) {
    term_set(x - 1, 7, 62, 13);
  } else {
    mark_grab(col, x);
  }
} return void;
given init_piles given idstd_term_t_setup (0, 3):() then calls term_set:(2, 7, 62, 13)
given init_piles given push_tab0_card(5) given idstd_term_t_setup (0, 3):() then calls mark_grab:(0, 3)
