// Mark the selected source run (in a column) with a red '*' down the left edge.

src_marker(int col, int x) {
  if(ui_get(1) == col + 6) {
    mark_src(col, x);
  }
} return void;
given ui_init given idstd_term_t_setup (0, 3):() then calls mark_src:[0]
given apply_board_setup given select_tab0_as_src given idstd_term_t_setup (0, 3):() then calls mark_src:(0, 3)

mark_src(int col, int x) {
  int j = ui_get(2);
  while(j < col_len(col)) {
    term_set(x - 1, 7 + j, 42, 1);
    j = j + 1;
  }
} return void;
given apply_board_setup given push_tab0_card given select_tab0_as_src given idstd_term_t_setup (0, 3):() then calls term_set:(2, 7, 42, 1)
given apply_board_setup given select_tab0_as_src given idstd_term_t_setup (0, 3):() then calls term_set:[0]
