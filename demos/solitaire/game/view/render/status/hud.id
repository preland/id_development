// Title, controls help, and the win banner.

draw_status() {
  term_text(2, 0, "KLONDIKE SOLITAIRE", 13);
  draw_help();
  draw_win();
} return void;
given ui_init given idstd_term_t_setup ():() then calls term_text:(2, 0, "KLONDIKE SOLITAIRE", 13) then calls draw_help:() then calls draw_win:()
given ui_init given idstd_term_t_setup ():() then calls term_text:(2, 1, "a/d move   space draw/pick/drop   q quit", 6) then calls term_text:(2, 2, "foundations A..K by suit; tableau down, alternating color", 4)

draw_help() {
  term_text(2, (import term_h) - 2, "a/d move   space draw/pick/drop   q quit", 6);
  term_text(2, (import term_h) - 1, "foundations A..K by suit; tableau down, alternating color", 4);
} return void;
given idstd_term_t_setup ():() then calls term_text:(2, 1, "a/d move   space draw/pick/drop   q quit", 6)
given idstd_term_t_setup ():() then calls term_text:(2, 2, "foundations A..K by suit; tableau down, alternating color", 4)

draw_win() {
  if((import ui)[4] == 1) {
    win_banner();
  }
} return void;
given win_flag_setup given idstd_term_t_setup ():() then calls term_text:(24, 12, "YOU WIN!   q to quit", 3)
given win_flag_setup given idstd_term_t_setup ():() then calls win_banner:()
given ui_init ():() then calls win_banner:[0]
