// Repaint the whole table each frame: clear the buffer, draw the top piles,
// the tableau, and the status/help lines, then flush to the terminal.

paint() {
  term_clear();
  draw_all();
  term_render();
} return void;
given ui_init given init_piles given labels_init given idstd_term_fixture_setup ():() then calls term_clear:() then calls draw_all:() then calls term_render:()
given ui_init given init_piles given labels_init given idstd_term_fixture_setup ():() then calls draw_top:() then calls draw_tableau_all:(0) then calls draw_status:()

draw_all() {
  draw_top();
  draw_tableau_all(0);
  draw_status();
} return void;
given ui_init given init_piles given labels_init given idstd_term_fixture_setup ():() then calls draw_top:() then calls draw_tableau_all:(0) then calls draw_status:()
given ui_init given init_piles given labels_init given idstd_term_fixture_setup ():() then calls draw_stock_pile:() then calls draw_foundations:(0) then calls draw_help:()

draw_top() {
  draw_stock_pile();
  draw_waste_pile();
  draw_foundations(0);
} return void;
given ui_init given init_piles given labels_init given idstd_term_fixture_setup ():() then calls draw_stock_pile:() then calls draw_waste_pile:() then calls draw_foundations:(0)
given ui_init given init_piles given labels_init given idstd_term_fixture_setup ():() then calls draw_stock_card:() then calls draw_waste_card:() then calls draw_found:(0)
