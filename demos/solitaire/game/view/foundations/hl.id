// Cursor / source markers under a top pile: a bright caret marks the cursor's
// pile, a red plus marks the selected source.

hl_if(int pile, int x, int y) {
  if(ui_get(0) == pile) {
    term_text(x, y + 1, "^^^", 13);
  } else {
    hl_src(pile, x, y);
  }
} return void;
given ui_init given idstd_term_t_setup (6, 2, 4):() then calls term_text:(2, 5, "^^^", 13)
given ui_init given idstd_term_t_setup (0, 2, 4):() then calls hl_src:(0, 2, 4)

hl_src(int pile, int x, int y) {
  if(ui_get(1) == pile) {
    term_text(x, y + 1, "+++", 1);
  }
} return void;
given ui_init given idstd_term_t_setup (-1, 2, 4):() then calls term_text:(2, 5, "+++", 1)
given ui_init given idstd_term_t_setup (0, 2, 4):() then calls term_text:[0]
