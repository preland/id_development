// The four foundation piles across the top, each showing its top card (or a
// suit placeholder) with the cursor / source marker beneath.

draw_foundations(int i) {
  while(i < 4) {
    draw_found(i);
    i = i + 1;
  }
} return void;
given ui_init given init_piles given labels_init given idstd_term_t_setup (0):() then calls draw_found:(0) then calls draw_found:(3)
given ui_init given init_piles given labels_init given idstd_term_t_setup (4):() then calls draw_found:[0]

draw_found(int i) {
  int x = 24 + i * 8;
  draw_found_card(x, i);
  hl_if(2 + i, x, 4);
} return void;
given ui_init given init_piles given labels_init given idstd_term_t_setup (0):() then calls draw_found_card:(24, 0) then calls hl_if:(2, 24, 4)
given ui_init given init_piles given labels_init given idstd_term_t_setup (3):() then calls draw_found_card:(48, 3) then calls hl_if:(5, 48, 4)

draw_found_card(int x, int i) {
  term_text(x, 3, "F" + (i + 1), 8);
  found_card_face(x, i);
} return void;
given init_piles given labels_init given idstd_term_t_setup (24, 0):() then calls term_text:(24, 3, "F1", 8) then calls found_card_face:(24, 0)
given init_piles given labels_init given idstd_term_t_setup (48, 3):() then calls term_text:(48, 3, "F4", 8) then calls found_card_face:(48, 3)
