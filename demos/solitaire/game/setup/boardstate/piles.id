// The tableau: seven initially-empty card columns (an int[][]).

make_tab() {
  export int[][] tab = [];
  add_cols(0);
} return void;
():() then tab_cols_check:(7)
():() then tab0_len_check:(0)

add_cols(int i) {
  while(i < 7) {
    push_col();
    i = i + 1;
  }
} return void;
given make_tab (7):() then tab_cols_check:(7)
given make_tab (0):() then tab_cols_check:(14)

push_col() {
  int[] fresh = [];
  push((import tab), fresh);
} return void;
