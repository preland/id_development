// Deal the shuffled deck: create the piles, deal the seven tableau columns,
// then drop the remaining 24 cards into the stock.

deal() {
  init_piles();
  deal_tableau(0);
  deal_stock();
} return void;

init_piles() {
  make_tab();
  make_meta();
} return void;

deal_stock() {
  while(len((import deck)) > 0) {
    push((import stock), pop((import deck)));
  }
} return void;
