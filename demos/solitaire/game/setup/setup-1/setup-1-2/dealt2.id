// Deal one card into column col. Split out of fill_col's loop body: naming
// both the column array and the popped card, then pushing, is already 3
// actions on its own, leaving no room for the loop's own increment.
deal_one(int col) {
  int[] col_of_v = col_of(col);
  int pop_v = pop((import deck));
  push(col_of_v, pop_v);
} return void;
