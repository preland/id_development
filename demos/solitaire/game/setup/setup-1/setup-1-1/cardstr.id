// A card's printed label (rank text + suit letter) and its color attribute
// (red on white, or black on white) for drawing a face-up card.

card_str(int c) {
  string ret_s = (import ranks)[card_rank(c)] + (import suits)[card_suit(c)];
} return string ret_s;

card_attr(int c) {
  int a = 11;
  if(card_red(c) == 1) {
    a = 10;
  }
} return int a;
