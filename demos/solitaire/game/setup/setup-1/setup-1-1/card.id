// KLONDIKE SOLITAIRE -- written in id on the id game engine.
//
// A card is an int 0..51: rank = c/4 + 1 (1=A .. 13=K), suit = c%4
// (0 clubs, 1 diamonds, 2 hearts, 3 spades). Diamonds and hearts are red.

card_rank(int c) {
} return int c / 4 + 1;

card_suit(int c) {
} return int c % 4;

card_red(int c) {
  int r = 0;
  if(card_suit(c) == 1 || card_suit(c) == 2) {
    r = 1;
  }
} return int r;
