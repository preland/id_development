// Deal the tableau: column col (0-based) gets col+1 cards, of which col are
// face down (the top one is face up).

deal_tableau(int col) {
  while(col < 7) {
    deal_col(col);
    col = col + 1;
  }
} return void;
given init_piles given make_deck (0):() then deck_len_check:(24) then fd1_check:(1)
given init_piles given make_deck (7):() then deck_len_check:(52)

deal_col(int col) {
  fill_col(col, 0);
  lset((import fd), col, col);
} return void;
given init_piles given make_deck (0):() then tab0_len_check:(1) then fd0_check:(0)
given init_piles given make_deck (1):() then calls fill_col:(1, 0) then fd1_check:(1)

fill_col(int col, int j) {
  while(j < col + 1) {
    deal_one(col);
    j = j + 1;
  }
} return void;
