// Fisher-Yates shuffle using the engine's PRNG.

shuffle() {
  shuf(51);
} return void;

shuf(int i) {
  while(i > 0) {
    swap_deck(i, rng_range(i + 1));
    i = i - 1;
  }
} return void;

swap_deck(int i, int j) {
  int t = (import deck)[i];
  lset((import deck), i, (import deck)[j]);
  lset((import deck), j, t);
} return void;
