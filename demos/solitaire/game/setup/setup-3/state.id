// Interaction-state accessors (over the exported `ui` list) and the tableau
// column lookup. `ui` holds: 0 cursor pile (0=stock 1=waste 2..5 foundations
// 6..12 tableau), 1 source pile (-1 none), 2 source start index, 3 spare,
// 4 won, 5 quit.

ui_get(int i) {
  int ret_i = (import ui)[i];
} return int ret_i;

ui_set(int i, int v) {
  lset((import ui), i, v);
} return void;

col_of(int col) {
  int[] ret_li = (import tab)[col];
} return int[] ret_li;
