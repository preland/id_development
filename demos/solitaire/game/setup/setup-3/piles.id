// The tableau: seven initially-empty card columns (an int[][]).

make_tab() {
  export int[][] tab = [];
  add_cols(0);
} return void;

add_cols(int i) {
  while(i < 7) {
    push_col();
    i = i + 1;
  }
} return void;

push_col() {
  int[] fresh = [];
  push((import tab), fresh);
} return void;
