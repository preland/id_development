// Pad a card label to a 3-cell width, and draw a face-up card at a position.

pad3(string s) {
  string out = s;
  if(len(s) < 3) {
    out = s + " ";
  }
} return string out;
("AC"):("AC ")
("10C"):("10C")
("A"):("A ")

draw_card_at(int x, int y, int c) {
  string card_str_v = card_str(c);
  string pad3_v = pad3(card_str_v);
  draw_card_tail(x, y, c, pad3_v);
} return void;
given labels_init given idstd_term_t_setup (2, 3, 0):() then calls draw_card_tail:(2, 3, 0, "AC ")
given labels_init given idstd_term_t_setup (5, 1, 36):() then calls draw_card_tail:(5, 1, 36, "10C")

// draw_card_at already spends its 3 actions naming the padded label, so
// looking up the attribute and drawing it is a tail call.
draw_card_tail(int x, int y, int c, string pad_label) {
  int card_attr_v = card_attr(c);
  term_text(x, y, pad_label, card_attr_v);
} return void;
given idstd_term_t_setup (2, 3, 0, "AC "):() then calls term_text:(2, 3, "AC ", 11)
given idstd_term_t_setup (5, 1, 1, "AD "):() then calls term_text:(5, 1, "AD ", 10)
