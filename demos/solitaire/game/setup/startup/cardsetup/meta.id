// The remaining piles and the interaction state. found[s] is the top rank on
// foundation suit s (0 = empty); fd[col] is the number of face-down cards in a
// tableau column (the rest, on top, are face up).

make_meta() {
  export int[] fd = [0, 0, 0, 0, 0, 0, 0];
  export int[] found = [0, 0, 0, 0];
  make_sw();
} return void;
():() then fd0_check:(0) then found0_check:(0) then calls make_sw:()
():() then fd1_check:(0) then stock_len_check:(0)

make_sw() {
  export int[] stock = [];
  export int[] waste = [];
} return void;
():() then stock_len_check:(0) then waste_len_check:(0)
given make_meta ():() then stock_len_check:(0) then found0_check:(0)

ui_init() {
  export int[] ui = [6, 0 - 1, 0, 0, 0, 0];
} return void;
():() then ui0_check:(6) then ui1_check:(-1)
given make_meta ():() then ui0_check:(6) then fd0_check:(0)
