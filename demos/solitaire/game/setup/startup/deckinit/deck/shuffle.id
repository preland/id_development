// Fisher-Yates shuffle using the engine's PRNG.

shuffle() {
  shuf(51);
} return void;
given idstd_rnd_t_setup given make_deck ():() then calls shuf:(51)
given idstd_rnd_t_setup_neg given make_deck ():() then deck_len_check:(52)

shuf(int i) {
  while(i > 0) {
    int rng_range_v = rnd_range(0, i + 1 - 1);
    swap_deck(i, rng_range_v);
    i = i - 1;
  }
} return void;
