given idstd_rnd_t_setup given make_deck (0):() then deck0_check:(0) then deck1_check:(1)

swap_deck(int i, int j) {
  int t = (import deck)[i];
  lset((import deck), i, (import deck)[j]);
  lset((import deck), j, t);
} return void;
