// Zero-argument witnesses for `then`, reading back the label tables
// labels_init exports -- card_str reads both, but always through a card
// number, so it cannot stand in as a check itself.
ranks1_check() {
  string ret_s = (import ranks)[1];
} return string ret_s;
given labels_init ():("A")
given idstd_rnd_t_setup given sol_init ():("A")

suits0_check() {
  string ret_s = (import suits)[0];
} return string ret_s;
given labels_init ():("C")
given idstd_rnd_t_setup given sol_init ():("C")
