// One frame: read the latest key, handle it, repaint. sol_cont idles ~25ms and
// reports whether to keep looping (stops on quit).

sol_frame() {
  int k = term_key();
  handle(k);
  int ret_i = sol_frame_tail(k);
} return int ret_i;
given random_initialize(1) given sol_init given term_and_quit_setup ():(0)
given ui_init given term_and_quit_setup given random_initialize(1) given sol_init ():(1)

sol_cont(int k) {
  sleep_ms(25);
  int ret_i = 1 - (import ui)[5];
} return int ret_i;
given ui_init (0):(1)
given ui_init given term_and_quit_setup (0):(0)

handle(int k) {
  move_cursor(k);
  handle_action(k);
} return void;
given apply_board_setup(0) (97):() then calls cursor_move:(-1)
given apply_board_setup(0) (32):() then calls cursor_move:[0] then calls do_action:()
