// The action splits on whether a source is already selected: with none, a
// space either draws (on the stock) or selects a source; with a source set, it
// attempts a move to the cursor's pile.

do_action() {
  if((import ui)[1] < 0) {
    do_select();
  } else {
    do_move();
  }
} return void;
given apply_board_setup(0) ():() then calls do_select:()
given apply_board_setup(0) given select_cursor(0, 2, 1, 1) ():() then calls do_move:()

do_select() {
  if((import ui)[0] == 0) {
    draw_stock();
  } else {
    select_src();
  }
} return void;
given apply_board_setup(0) given select_stock_cursor ():() then calls draw_stock:()
given apply_board_setup(0) given select_cursor(0, 1, 1, 1) ():() then calls select_src:()

select_src() {
  if(can_select()) {
    set_src();
  }
} return void;
given apply_board_setup(0) ():() then calls set_src:[0]
given apply_board_setup(0) given select_cursor(0, 1, 1, 1) ():() then calls set_src:()
