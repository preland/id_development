// The space/enter action and the quit key. Space draws/selects/moves; q quits.

handle_action(int k) {
  if(is_act(k)) {
    do_action();
  } else {
    act_quit(k);
  }
} return void;

is_act(int k) {
  int ok = 0;
  if(k == 32 || k == 13 || k == 10) {
    ok = 1;
  }
} return int ok;

act_quit(int k) {
  if(k == 113) {
    ui_set(5, 1);
  }
} return void;
