// The space/enter action and the quit key. Space draws/selects/moves; q quits.

handle_action(int k) {
  if(is_act(k)) {
    do_action();
  } else {
    act_quit(k);
  }
} return void;
given apply_board_setup (32):() then calls do_action:()
given apply_board_setup (113):() then calls act_quit:(113) then calls ui_set:(5, 1)

is_act(int k) {
  int ok = 0;
  if(k == 32 || k == 13 || k == 10) {
    ok = 1;
  }
} return int ok;
(32):(1)
(13):(1)
(10):(1)
(0):(0)

act_quit(int k) {
  if(k == 113) {
    ui_set(5, 1);
  }
} return void;
given ui_init (113):() then calls ui_set:(5, 1)
given ui_init (100):() then calls ui_set:[0]
