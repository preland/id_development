// Apply a cursor delta, clamped to the 0..12 pile range.

cursor_move(int d) {
  int ui_get_v = ui_get(0);
  int wrap_cur_v = wrap_cur(ui_get_v + d);
  ui_set(0, wrap_cur_v);
} return void;
given ui_init (1):() then calls ui_set:(0, 7)
given ui_init (-13):() then calls ui_set:(0, 0)

wrap_cur(int c) {
  int r = c;
  if(c < 0) {
    r = 0;
  }
  if(c > 12) {
    r = 12;
  }
} return int r;
(0):(0)
(-1):(0)
(12):(12)
(13):(12)
