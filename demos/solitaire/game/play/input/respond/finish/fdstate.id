// fd0_one flips a single face-down flag on column 0 -- the minimal state
// needs_flip's AND condition and maybe_flip's flip branch need. A void
// write has no other witness, so it's paired with checks that read the
// touched index back and confirm a neighbouring index was left alone.
fd0_one() {
  lset((import fd), 0, 1);
} return void;
given init_piles ():() then fd0_check:(1)
given init_piles ():() then fd1_check:(0)

fd0_check() {
  int ret_i = (import fd)[0];
} return int ret_i;
given init_piles ():(0)
given init_piles given fd0_one ():(1)

fd1_check() {
  int ret_i = (import fd)[1];
} return int ret_i;
given init_piles ():(0)
given init_piles given fd0_one ():(0)
