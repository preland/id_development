// The stock: a space on it deals one card to the waste, or, when empty,
// recycles the whole waste back into the stock.

draw_stock() {
  if(len((import stock)) > 0) {
    stock_to_waste();
  } else {
    recycle();
  }
} return void;

stock_to_waste() {
  push((import waste), pop((import stock)));
} return void;

recycle() {
  while(len((import waste)) > 0) {
    push((import stock), pop((import waste)));
  }
} return void;
