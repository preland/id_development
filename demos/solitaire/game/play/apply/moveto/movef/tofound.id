// Moving to a foundation: only a single card, of the foundation's suit and the
// next rank up, is accepted.

move_to_found() {
  if((import ui)[0] >= 2) {
    found_move();
  } else {
    cancel_sel();
  }
} return void;
given apply_board_setup(0) given select_cursor(0, 2, 1, 1) ():() then calls found_move:()
given apply_board_setup(0) given select_stock_cursor ():() then calls cancel_sel:()

found_move() {
  int d = (import ui)[0] - 2;
  int c = src_bottom();
  found_try(d, c);
} return void;
given apply_board_setup(0) given select_cursor(0, 2, 1, 1) ():() then calls found_try:(0, 0)
given apply_board_setup(8) given select_cursor(0, 2, 1, 1) ():() then calls found_try:(0, 8)

found_try(int d, int c) {
  if(found_ok(d, c)) {
    found_do(d, c);
  }
} return void;
given apply_board_setup(0) given select_cursor(0, 2, 1, 1) (0, 0):() then calls found_do:(0, 0)
given apply_board_setup(0) given select_cursor(0, 2, 1, 1) (0, 8):() then calls found_do:[0]
