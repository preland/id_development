// found_do already spends its 3 actions removing the source card and
// naming its rank, so recording it on the foundation and finishing the
// move is a tail call.
found_do_tail(int d, int found_rank) {
  integer_list_set((import found), d, found_rank);
  finish_move();
} return void;
given apply_board_setup(0) (0, 5):() then (import found)[0]:(5)
given apply_board_setup(0) (0, 7):() then (import found)[0]:(7) then calls finish_move:()
