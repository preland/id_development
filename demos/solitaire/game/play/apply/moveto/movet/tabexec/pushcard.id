// push_src_cards' loop body already spends 3 actions naming the column,
// naming the card, and pushing it, leaving no room for the loop's own
// increment.
push_one(int d, int j) {
  int[] col_of_v = col_of(d);
  int src_card_v = src_card(j);
  push(col_of_v, src_card_v);
} return void;
