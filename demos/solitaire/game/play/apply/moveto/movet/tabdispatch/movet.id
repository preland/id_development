// Moving to a tableau column: the selection's bottom card must continue the
// column (one rank lower, opposite color), or be a King onto an empty column.

move_to_tab() {
  int d = (import ui)[0] - 6;
  int c = src_bottom();
  tab_try(d, c);
} return void;
given apply_board_setup(0) given push_tab0_card(5) given select_cursor(0, 6, 1, 1) ():() then calls tab_try:(0, 0)
given apply_board_setup(8) given push_tab0_card(5) given select_cursor(0, 6, 1, 1) ():() then calls tab_try:(0, 8)

tab_try(int d, int c) {
  if(tab_fits(d, c)) {
    tab_do(d);
  }
} return void;
given apply_board_setup(0) given push_tab0_card(5) given select_cursor(0, 6, 1, 1) (0, 0):() then calls tab_do:(0)
given apply_board_setup(0) given push_tab0_card(5) given select_cursor(0, 6, 1, 1) (0, 8):() then calls tab_do:[0] then tab0_top_check:(5)

tab_fits(int d, int c) {
  int ok = 0;
  if(empty_col(d)) {
    ok = king_ok(c);
  } else {
    ok = seq_ok(d, c);
  }
} return int ok;
given init_piles given push_tab0_card(5) (1, 48):(1)
given init_piles given push_tab0_card(5) (0, 8):(0)
