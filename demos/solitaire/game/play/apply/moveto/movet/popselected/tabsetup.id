// Cursor and source pile, as two lset writes: (sc_a, sc_b) then (sc_c, sc_d). The four selections the
// tableau and foundation cases need: the waste as source onto a tableau column (0, 6, 1, 1), the tableau
// column's bottom card as source (1, 6, 2, 0), the waste pressed twice, a cancel (0, 1, 1, 1), and the
// waste onto foundation 0 (0, 2, 1, 1).
select_cursor(int sc_a, int sc_b, int sc_c, int sc_d) {
  lset((import ui), sc_a, sc_b);
  lset((import ui), sc_c, sc_d);
} return void;
