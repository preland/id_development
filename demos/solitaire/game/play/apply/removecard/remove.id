// Remove one card from the top of the source pile (waste or tableau column).

remove_src_one() {
  if(ui_get(1) == 1) {
    pop((import waste));
  } else {
    pop_col_src();
  }
} return void;
given apply_board_setup given select_waste_found ():() then waste_len_check:(0)
given apply_board_setup given push_tab0_card given select_tab0_as_src ():() then tab0_len_check:(0)

pop_col_src() {
  int ui_get_v = ui_get(1);
  int[] col_of_v = col_of(ui_get_v - 6);
  pop(col_of_v);
} return void;
given apply_board_setup given push_tab0_card given select_tab0_as_src ():() then tab0_len_check:(0)
given apply_board_setup given push_tab0_card given push_tab0_card2 given select_tab0_as_src ():() then tab0_top_check:(5)
