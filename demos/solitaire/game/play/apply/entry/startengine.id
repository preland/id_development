// term_init's seed parameter is int, and ticks() returns word: passing
// the word straight through narrows it inline, which the compiler now
// rejects, so main() names an int local first and calls this with it.
start_engine(int seed) {
  term_init(64, 24, seed);
  term_setup();
  sol_start();
} return void;

// sol_loop's own case can't call it through sol_start (sol_start reaches
// sol_init, which resets the quit flag ui[5] on every call, so the loop
// never sees it set and never returns). This setup runs the real screen
// init sol_start would have done and marks the quit flag already true, so
// sol_loop can be called directly and is expected to run exactly one frame.
term_and_quit_setup() {
  term_init(64, 24, 1);
  term_setup();
  ui_set(5, 1);
} return void;
