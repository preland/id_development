// Entry point and the frame loop. Solitaire isn't animated, so the loop just
// polls for a key, applies it, repaints, and idles briefly.

main() {
  engine_init(64, 24, ticks());
  term_setup();
  sol_start();
} return int 0;

sol_start() {
  sol_init();
  sol_loop();
  term_done();
} return void;

sol_loop() {
  int running = 1;
  while(running == 1) {
    running = sol_frame();
  }
} return void;
