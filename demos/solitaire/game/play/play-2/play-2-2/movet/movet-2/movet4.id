// Execute a tableau move: copy the selected cards (in order) onto the
// destination column, remove them from the source, then finish.

tab_do(int d) {
  move_run(d);
  finish_move();
} return void;

move_run(int d) {
  push_src_cards(d, 0);
  remove_src_cards();
} return void;

push_src_cards(int d, int j) {
  while(j < src_count()) {
    push(col_of(d), src_card(j));
    j = j + 1;
  }
} return void;
