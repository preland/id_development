// Tableau placement predicates: empty column, King test, and the
// descending-alternating-color sequence test against the column's top card.

empty_col(int d) {
  int ok = 0;
  if(col_len(d) == 0) {
    ok = 1;
  }
} return int ok;

king_ok(int c) {
  int ok = 0;
  if(card_rank(c) == 13) {
    ok = 1;
  }
} return int ok;

seq_ok(int d, int c) {
  int t = top_of(d);
  int ok = 0;
  ok = seq_match(t, c);
} return int ok;
