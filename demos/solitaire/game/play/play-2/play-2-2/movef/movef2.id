// Foundation acceptance test and the commit: remove the card from its source,
// raise the foundation's top rank, then finish (flip + clear + win check).

found_ok(int d, int c) {
  int ok = 0;
  if(found_match(d, c) && src_count() == 1) {
    ok = 1;
  }
} return int ok;

found_match(int d, int c) {
  int ok = 0;
  if(card_suit(c) == d && card_rank(c) == (import found)[d] + 1) {
    ok = 1;
  }
} return int ok;

found_do(int d, int c) {
  remove_src_one();
  int card_rank_v = card_rank(c);
  found_do_tail(d, card_rank_v);
} return void;
