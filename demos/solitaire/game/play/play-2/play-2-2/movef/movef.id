// Moving to a foundation: only a single card, of the foundation's suit and the
// next rank up, is accepted.

move_to_found() {
  if(ui_get(0) >= 2) {
    found_move();
  } else {
    cancel_sel();
  }
} return void;

found_move() {
  int d = ui_get(0) - 2;
  int c = src_bottom();
  found_try(d, c);
} return void;

found_try(int d, int c) {
  if(found_ok(d, c)) {
    found_do(d, c);
  }
} return void;
