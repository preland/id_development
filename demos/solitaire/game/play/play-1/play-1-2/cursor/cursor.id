// Move the cursor left/right across the 13 pile positions with a/h and d/l.

move_cursor(int k) {
  cur_lr(k);
  cur_r(k);
} return void;

cur_lr(int k) {
  if(k == 97 || k == 104) {
    cursor_move(0 - 1);
  }
} return void;

cur_r(int k) {
  if(k == 100 || k == 108) {
    cursor_move(1);
  }
} return void;
