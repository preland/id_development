// A column needs a flip when it has face-down cards but no face-up ones left;
// the win condition is all four foundations complete (top rank 13).

needs_flip(int col) {
  int ok = 0;
  if((import fd)[col] > 0 && col_len(col) == (import fd)[col]) {
    ok = 1;
  }
} return int ok;

check_win() {
  if(all_done()) {
    ui_set(4, 1);
  }
} return void;

all_done() {
  int ok = 0;
  if((import found)[0] == 13 && (import found)[1] == 13 && found_hi()) {
    ok = 1;
  }
} return int ok;
