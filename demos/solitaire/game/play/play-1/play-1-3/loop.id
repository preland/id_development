// One frame: read the latest key, handle it, repaint. sol_cont idles ~25ms and
// reports whether to keep looping (stops on quit).

sol_frame() {
  int k = last_key();
  handle(k);
  paint();
} return int sol_cont(k);

sol_cont(int k) {
  sleep_ms(25);
} return int 1 - ui_get(5);

handle(int k) {
  move_cursor(k);
  handle_action(k);
} return void;
