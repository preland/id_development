// One frame: read the latest key, handle it, repaint. sol_cont idles ~25ms and
// reports whether to keep looping (stops on quit).

sol_frame() {
  int k = last_key();
  handle(k);
  int ret_i = sol_frame_tail(k);
} return int ret_i;

sol_cont(int k) {
  sleep_ms(25);
  int ret_i = 1 - ui_get(5);
} return int ret_i;

handle(int k) {
  move_cursor(k);
  handle_action(k);
} return void;
