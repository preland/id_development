// Record the selected source. For a tableau column the whole face-up run is
// grabbed (start index = the face-down count); for the waste, the single top
// card. src_count is how many cards the selection holds.

set_src() {
  int ui_get_v = ui_get(0);
  ui_set(1, ui_get_v);
  set_src_tail();
} return void;
given apply_board_setup ():() then (import ui)[1]:(6) then (import ui)[2]:(0)
given apply_board_setup given fd0_one ():() then (import ui)[1]:(6) then (import ui)[2]:(1)

src_start() {
  int g = 0;
  if(ui_get(0) >= 6) {
    g = (import fd)[ui_get(0) - 6];
  }
} return int g;
given apply_board_setup given select_same_pile ():(0)
given apply_board_setup given fd0_one ():(1)

src_count() {
  int n = 1;
  if(ui_get(1) >= 6) {
    int ui_get_v = ui_get(1);
    n = col_len(ui_get_v - 6) - ui_get(2);
  }
} return int n;
given apply_board_setup ():(1)
given apply_board_setup given select_tab0_as_src ():(0)
given apply_board_setup given push_tab0_card given select_tab0_as_src ():(1)
