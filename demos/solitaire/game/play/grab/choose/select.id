// Whether the cursor's pile offers a card to pick up: the waste needs a top
// card; a tableau column needs at least one face-up card. (Foundations and the
// stock are not sources.)

can_select() {
  int ok = 0;
  if((import ui)[0] == 1) {
    ok = waste_ok();
  } else {
    ok = sel_tab_ok();
  }
} return int ok;
given apply_board_setup(0) ():(0)
given apply_board_setup(0) given select_cursor(0, 1, 1, 1) ():(1)
given apply_board_setup(0) given push_tab0_card(5) ():(1)

waste_ok() {
  int ok = 0;
  if(len((import waste)) > 0) {
    ok = 1;
  }
} return int ok;
given make_sw ():(0)
given apply_board_setup(0) ():(1)

sel_tab_ok() {
  int ok = 0;
  if((import ui)[0] >= 6 && tab_has_faceup()) {
    ok = 1;
  }
} return int ok;
given apply_board_setup(0) given select_cursor(0, 1, 1, 1) ():(0)
given apply_board_setup(0) ():(0)
given apply_board_setup(0) given push_tab0_card(5) ():(1)
