// The "bottom" card of the selection -- the one whose rank/color decides where
// the group may land. For a tableau source it is the grabbed start card; for
// the waste, the top card. src_card(j) is the j-th card of the selection.

src_bottom() {
  int c = top_waste();
  if(ui_get(1) >= 6) {
    int ui_get_v = ui_get(1);
    c = col_of(ui_get_v - 6)[ui_get(2)];
  }
} return int c;
given apply_board_setup ():(0) then calls top_waste:()
given apply_board_setup given push_tab0_card given select_tab0_as_src ():(5)
given apply_board_setup given push_tab0_card given push_tab0_card2 given select_tab0_as_src ():(5)

top_waste() {
  int ret_i = (import waste)[len((import waste)) - 1];
} return int ret_i;
given apply_board_setup ():(0)
given apply_board_setup given push_waste_card2 ():(8)

src_card(int j) {
  int c = src_bottom();
  if(ui_get(1) >= 6) {
    int ui_get_v = ui_get(1);
    c = col_of(ui_get_v - 6)[ui_get(2) + j];
  }
} return int c;
given apply_board_setup (0):(0)
given apply_board_setup given push_tab0_card given push_tab0_card2 given select_tab0_as_src (0):(5)
given apply_board_setup given push_tab0_card given push_tab0_card2 given select_tab0_as_src (1):(0)
