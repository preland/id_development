// A rectangular border: top/bottom edges, then the two side edges. Uses '-'
// (45), '|' (124), and '+' (43) so it renders on any terminal.

draw_box(int x, int y, int w, int h, int attr) {
  box_edges(x, y, w, h, attr);
  box_corners(x, y, w, h, attr);
} return void;

box_edges(int x, int y, int w, int h, int attr) {
  draw_hline(x + 1, y, w - 2, 45, attr);
  draw_hline(x + 1, y + h - 1, w - 2, 45, attr);
  box_vedges(x, y, w, h, attr);
} return void;

box_vedges(int x, int y, int w, int h, int attr) {
  draw_vline(x, y + 1, h - 2, 124, attr);
  draw_vline(x + w - 1, y + 1, h - 2, 124, attr);
} return void;
