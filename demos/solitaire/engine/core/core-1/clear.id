// Reset every cell to blank (space, attr 0) at the start of each frame.

clear() {
  fill_cells(0);
} return void;

fill_cells(int i) {
  while(i < (import scrw) * (import scrh)) {
    blank_at(i);
    i = i + 1;
  }
} return void;

blank_at(int i) {
  lset((import scr), i, 32);
  lset((import scrc), i, 0);
} return void;
