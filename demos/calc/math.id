// calc demo, part 1: pure helper functions (no main -> compiles to a .o)

add(int x, int y) {
  int sum = x + y;
} return int sum;
(40, 2):(42)
(-5, 5):(0)

// nested if inside a branch is "free", so this stays within the 3-action limit
classify(int n) {
  string label = "";
  if(n < 0) {
    label = "negative";
  } else {
    if(n == 0) {
      label = "zero";
    } else {
      label = "positive";
    }
  }
} return string label;
(-5):("negative")
(0):("zero")
(7):("positive")
