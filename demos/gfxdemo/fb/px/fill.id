// Clear the whole framebuffer to one color, row by row -- the per-frame blank
// (the engine's clear()), here filling pixels instead of character cells.

clear(int c) {
  fill_rows(0, c);
} return void;

fill_rows(int y, int c) {
  while(y < (import gh)) {
    fill_row(y, c);
    y = y + 1;
  }
} return void;

fill_row(int y, int c) {
  int x = 0;
  while(x < (import gw)) {
    pset(x, y, c);
    x = x + 1;
  }
} return void;
