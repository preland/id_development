// Clear the whole framebuffer to one color, row by row -- the per-frame blank
// (the engine's clear()), here filling pixels instead of character cells.

clear(int c) {
  fill_rows(0, c);
} return void;
given idstd_surface_fixture_setup (7):() then idstd_surface_fixture_pixel_sum_text:("px 448")
given idstd_surface_fixture_setup (1):() then idstd_surface_fixture_pixel_sum_text:("px 64")

fill_rows(int y, int c) {
  while(y < (import pixel_surface_height)) {
    fill_row(y, c);
    y = y + 1;
  }
} return void;
given idstd_surface_fixture_setup (0, 3):() then idstd_surface_fixture_pixel_sum_text:("px 192")
given idstd_surface_fixture_setup (8, 3):() then idstd_surface_fixture_pixel_sum_text:("px 0")

fill_row(int y, int c) {
  int x = 0;
  while(x < (import pixel_surface_width)) {
    surface_set_pixel(x, y, c);
    x = x + 1;
  }
} return void;
given idstd_surface_fixture_setup (0, 4):() then idstd_surface_fixture_pixel_sum_text:("px 32")
given idstd_surface_fixture_setup (8, 5):() then idstd_surface_fixture_pixel_sum_text:("px 0")
