// Colors. A pixel is a single int 0xRRGGBB, packed by idstd's d2_pack; the
// surface itself is idstd's list surface (sf_l_init, sf_l_pset).

boxcolor(int t) {
  int r = 100 + (t % 156);
  int g = 200 - (t % 156);
  int c = pack_color_channels(r, g, 255);
} return int c;
