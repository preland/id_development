// Colors. A pixel is a single int 0xRRGGBB; id has no bitwise ops, so we pack
// channels with plain arithmetic (r*65536 + g*256 + b), the same way the engine
// avoids bit tricks in its PRNG.

rgb(int r, int g, int b) {
  int ret_i = r * 65536 + g * 256 + b;
} return int ret_i;

boxcolor(int t) {
  int r = 100 + (t % 156);
  int g = 200 - (t % 156);
  int c = rgb(r, g, 255);
} return int c;
