// The framebuffer: one flat int[] of gw*gh pixels, row-major, top row first.
// Each pixel is a 0xRRGGBB value (see fb/color.id). This mirrors the terminal
// engine's screen buffer, but the cells are pixels instead of characters.

fb_init(int w, int h) {
  export int gw = w;
  export int gh = h;
  fb_alloc(w * h);
} return void;

fb_alloc(int n) {
  export int[] fb = [];
  fb_fill(n);
} return void;

fb_fill(int n) {
  int i = 0;
  while(i < n) {
    push((import fb), 0);
    i = i + 1;
  }
} return void;
