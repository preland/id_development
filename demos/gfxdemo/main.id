// gfxdemo -- the first windowed program in `id`. It opens a 320x200 window via
// the native graphics backend (sys/win/gfx), then runs a frame loop that draws
// a moving box into a software framebuffer and presents it. The drawing is all
// portable `id`; only gfx_open/present/poll/close cross into platform code.
//
//   idc/bin/idc demos/gfxdemo --allow-untested -o gfxdemo && ./gfxdemo
//
// Close the window (or press Esc / q) to quit. Like the terminal engine, every
// function obeys id's rules -- 3 actions, 2-deep nesting, 3 functions per file.

main(int argc, string[] argv) {
  int ok = gfx_open(320, 200, "hey look ma i made it");
  sf_l_init(320, 200);
  loop(ok);
} return int 0;
