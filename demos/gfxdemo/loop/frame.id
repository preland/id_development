// One frame: draw into the framebuffer, present it to the window, then poll one
// input event. gfx_poll returns -2 when the window wants to close, -1 for no
// event, or a key code; alive turns that into a keep-running flag (Esc or q also
// quit).

frame(int t) {
  anim(t);
  gfx_present((import fb));
  int ev = gfx_poll();
} return int ev;

alive(int ev) {
  int a = 1;
  if(ev = 0 - 2 || ev = 27 || ev = 113) {
    a = 0;
  }
} return int a;
