// One frame: draw into the framebuffer, present it to the window, then poll one
// input event. gfx_poll returns -2 when the window wants to close, -1 for no
// event, or a key code; idstd's inp_live turns that into a keep-running flag
// (Esc or q also quit).

frame(int t) {
  anim(t);
  gfx_present((import sf_l_px));
  int ev = gfx_poll();
} return int ev;
