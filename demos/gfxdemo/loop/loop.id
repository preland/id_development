// The frame loop. spin advances a tick counter until a frame reports the window
// wants to close, then tears the window down. sleep_ms paces it (~60fps); the
// engine's terminal games use the same clear -> draw -> present -> poll -> sleep
// shape.

// `ok` is threaded into the loop's live flag rather than discarded: with no
// display gfx_open returns 0 and gfx_poll then returns -1 forever, so a loop
// that starts unconditionally never ends. Every windowed demo in this tree had
// that bug -- `DISPLAY= ./prog` ran until it was killed.
loop(int ok) {
  spin(ok, 0);
  gfx_close();
} return void;

spin(int run, int t) {
  while(run > 0) {
    int frame_v = frame(t);
    run = alive(frame_v);
    t = advance(t);
  }
} return void;

advance(int t) {
  sleep_ms(16);
  int ret_i = t + 1;
} return int ret_i;
