// Draw a filled 40x30 box at (x0, y0) by writing its rows of pixels. sf_l_pset
// clips, which is what makes this safe -- an out-of-range list store aborts
// the process, it is not dropped. See idstd's gfx/px/l/px.id.

fill_box(int x0, int y0, int c) {
  box_rows(x0, y0, c);
} return void;
given idstd_sf_l_t_setup (0, 0, 3):() then idstd_sf_l_t_sum:("px 192")
given idstd_sf_l_t_setup (8, 8, 5):() then idstd_sf_l_t_sum:("px 0")

box_rows(int x0, int y0, int c) {
  int y = y0;
  while(y < y0 + 30) {
    box_row(x0, y, c);
    y = y + 1;
  }
} return void;
given idstd_sf_l_t_setup (0, 0, 2):() then idstd_sf_l_t_sum:("px 128")
given idstd_sf_l_t_setup (0, 8, 2):() then idstd_sf_l_t_sum:("px 0")

box_row(int x0, int y, int c) {
  int x = x0;
  while(x < x0 + 40) {
    sf_l_pset(x, y, c);
    x = x + 1;
  }
} return void;
given idstd_sf_l_t_setup (0, 0, 4):() then idstd_sf_l_t_sum:("px 32")
given idstd_sf_l_t_setup (0, 8, 4):() then idstd_sf_l_t_sum:("px 0")
