// Draw a filled 40x30 box at (x0, y0) by writing its rows of pixels. The runtime
// drops any out-of-range store, so no per-pixel bounds check is needed.

fill_box(int x0, int y0, int c) {
  box_rows(x0, y0, c);
} return void;

box_rows(int x0, int y0, int c) {
  int y = y0;
  while(y < y0 + 30) {
    box_row(x0, y, c);
    y = y + 1;
  }
} return void;

box_row(int x0, int y, int c) {
  int x = x0;
  while(x < x0 + 40) {
    pset(x, y, c);
    x = x + 1;
  }
} return void;
