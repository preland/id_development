// The scene: clear to a dark blue, then draw a 40x30 box that slides across the
// surface, its color cycling with the tick. The motion is pure arithmetic on t,
// wrapped with % so the box stays in bounds.

anim(int t) {
  clear(rgb(10, 10, 30));
  box(t);
} return void;

box(int t) {
  int x0 = t % ((import gw) - 40);
  int y0 = (t / 2) % ((import gh) - 30);
  fill_box(x0, y0, boxcolor(t));
} return void;
