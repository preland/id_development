// The scene: clear to a dark blue, then draw a 40x30 box that slides across the
// surface, its color cycling with the tick. The motion is pure arithmetic on t,
// wrapped with % so the box stays in bounds.

anim(int t) {
  int rgb_v = pack_color_channels(10, 10, 30);
  clear(rgb_v);
  box(t);
} return void;
given gfx_big_setup (0):() then idstd_surface_fixture_pixel_sum_text:("px 1704751408")
given gfx_big_setup (5):() then idstd_surface_fixture_pixel_sum_text:("px 2096431408")

box(int t) {
  int x0 = t % ((import pixel_surface_width) - 40);
  int y0 = (t / 2) % ((import pixel_surface_height) - 30);
  box_paint(x0, y0, t);
} return void;
