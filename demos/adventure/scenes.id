// The two branches of the cavern and the four scenes under them, all read from
// conf.id: fork 0 is the left tunnel (endings 1-4), fork 1 the right (5-8).

scene_fork(int fk) {
  string fk_ans = ask((import fork_ask)[fk]);
  if(fk_ans == "1") {
    scene_play(fk * 2);
  } else {
    if(fk_ans == "2") {
      scene_play(fk * 2 + 1);
    } else {
      print((import fork_stray)[fk]);
    }
  }
} return void;
