scene_play(int sc) {
  string sc_ans = ask((import scene_ask)[sc]);
  if(sc_ans == "1") {
    print((import scene_end_one)[sc]);
  } else {
    if(sc_ans == "2") {
      print((import scene_end_two)[sc]);
    } else {
      print((import scene_end_stray)[sc]);
    }
  }
} return void;
