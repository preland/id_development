// The story text, so the scenes are data and one function plays any of them.
// Scenes 0..3 are river, bridge, chamber, pit (the left fork's two scenes, then
// the right fork's); forks 0..1 are the left and right tunnels, whose scenes
// are 2*fork and 2*fork+1. Endings 1-8 run in scene order.

string[] scene_ask = ["Midstream, something cold brushes your leg.\n  1) Dive down to investigate\n  2) Sprint for the far bank\nChoose: ", "A rope BRIDGE sways over a chasm; a TROLL snores beneath it.\n  1) Tiptoe across quietly\n  2) Cut the bridge once you reach the far side\nChoose: ", "A CROWN rests on a pedestal; a DRAGON sleeps coiled around it.\n  1) Seize the crown\n  2) Bow and back away slowly\nChoose: ", "You land beside an ancient LANTERN and a locked DOOR.\n  1) Light the lantern\n  2) Force the door in the dark\nChoose: "];

string[] scene_end_one = [">> ENDING 1 -- THE PEARL DIVER: you surface clutching a glowing pearl and walk out a living legend.", ">> ENDING 3 -- THE QUIET ESCAPE: you cross unheard and step out into a pale, free dawn.", ">> ENDING 5 -- THE CROWNED FOOL: you lift the crown, the dragon's eye opens, and you reign for four glorious seconds.", ">> ENDING 7 -- THE LANTERN BEARER: light finds a stair, and you climb out reborn as the cavern's quiet keeper."];

string[] scene_end_two = [">> ENDING 2 -- SWEPT AWAY: the current folds over you and the dark takes the rest.", ">> ENDING 4 -- THE TROLL'S REVENGE: the rope snaps a beat too early and the troll wakes very hungry. THE END.", ">> ENDING 6 -- THE WISE GUEST: the dragon approves of your manners and nudges you toward an exit, richer in stories.", ">> ENDING 8 -- THE LAST DOOR: it swings open onto a deeper black, and the black opens onto you. THE END."];

string[] scene_end_stray = [">> Paralyzed by the choice, you slip under without a sound. THE END.", ">> You waver on the planks until they rot through beneath you. THE END.", ">> You stand gawking until the dragon rolls over in its sleep. THE END.", ">> You sit in the pitch dark forever, still deciding. THE END."];

string[] fork_ask = ["The left tunnel forks at an underground RIVER.\n  1) Swim across the dark water\n  2) Search the walls for a BRIDGE\nChoose: ", "The right tunnel opens into a vast CHAMBER above a black PIT.\n  1) Explore the chamber\n  2) Lower yourself into the pit\nChoose: "];

string[] fork_stray = [">> You dither at the fork until the bats carry you off. THE END.", ">> The darkness drinks your nerve and you simply stop. THE END."];
