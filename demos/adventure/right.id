// The RIGHT branch of the cavern: a chamber and a pit leading to endings 5-8.

scene_right() {
  string r = ask("The right tunnel opens into a vast CHAMBER above a black PIT.\n  1) Explore the chamber\n  2) Lower yourself into the pit\nChoose: ");
  if(r == "1") {
    scene_chamber();
  } else {
    if(r == "2") {
      scene_pit();
    } else {
      print(">> The darkness drinks your nerve and you simply stop. THE END.");
    }
  }
} return void;

scene_chamber() {
  string ch = ask("A CROWN rests on a pedestal; a DRAGON sleeps coiled around it.\n  1) Seize the crown\n  2) Bow and back away slowly\nChoose: ");
  if(ch == "1") {
    print(">> ENDING 5 -- THE CROWNED FOOL: you lift the crown, the dragon's eye opens, and you reign for four glorious seconds.");
  } else {
    if(ch == "2") {
      print(">> ENDING 6 -- THE WISE GUEST: the dragon approves of your manners and nudges you toward an exit, richer in stories.");
    } else {
      print(">> You stand gawking until the dragon rolls over in its sleep. THE END.");
    }
  }
} return void;

scene_pit() {
  string pt = ask("You land beside an ancient LANTERN and a locked DOOR.\n  1) Light the lantern\n  2) Force the door in the dark\nChoose: ");
  if(pt == "1") {
    print(">> ENDING 7 -- THE LANTERN BEARER: light finds a stair, and you climb out reborn as the cavern's quiet keeper.");
  } else {
    if(pt == "2") {
      print(">> ENDING 8 -- THE LAST DOOR: it swings open onto a deeper black, and the black opens onto you. THE END.");
    } else {
      print(">> You sit in the pitch dark forever, still deciding. THE END.");
    }
  }
} return void;
