// THE CAVERNS OF CHOICE -- a choose-your-own-adventure.
//
// Run:  idc/bin/idc demos/adventure -o adventure && ./adventure
// At each scene, type an index (1 or 2) and press enter.
//
// The story is a binary tree three choices deep -> 8 endings. The scene text
// lives in conf.id and scenes.id plays any of it by index; engine.id holds the
// entry point and the opening fork. Functions and the shared `ask` helper
// resolve across files automatically.
//
// This demo is the reason the language grew an `input()` builtin: it reads one
// line from stdin and returns it as a string, so a scene can branch on the
// player's choice using ordinary string comparison.

main(int argc, string[] argv) {
  print("==============================\n   THE CAVERNS OF CHOICE\n==============================\nEnter 1 or 2 at each prompt.\n");
  scene_gate();
} return int 0;
stdin "x\n" (1, ["prog"]):(0) then prints:("==============================\n   THE CAVERNS OF CHOICE\n==============================\nEnter 1 or 2 at each prompt.\n\nYou stand before two tunnels.\n  1) Enter the LEFT tunnel\n  2) Enter the RIGHT tunnel\nChoose: \n>> You freeze with indecision and your torch gutters out. THE END.\n")
stdin "2\nx\n" (1, ["prog"]):(0) then prints:("==============================\n   THE CAVERNS OF CHOICE\n==============================\nEnter 1 or 2 at each prompt.\n\nYou stand before two tunnels.\n  1) Enter the LEFT tunnel\n  2) Enter the RIGHT tunnel\nChoose: \nThe right tunnel opens into a vast CHAMBER above a black PIT.\n  1) Explore the chamber\n  2) Lower yourself into the pit\nChoose: \n>> The darkness drinks your nerve and you simply stop. THE END.\n")

// ask(prompt): print the prompt, then return the player's typed line.
ask(string prompt) {
  print(prompt);
  string answer = input();
} return string answer;
stdin "1\n" ("P1"):("1") then prints:("P1\n")
stdin "yes\n" (""):("yes") then prints:("\n")

// The opening fork. `if`/`else` is two actions; the decl is the third. The
// nested `if` lives inside a branch, so it is free -- that is what lets every
// scene validate input without blowing the 3-action limit.
scene_gate() {
  string gate_answer = ask("You stand before two tunnels.\n  1) Enter the LEFT tunnel\n  2) Enter the RIGHT tunnel\nChoose: ");
  if(gate_answer == "1") {
    scene_fork(0);
  } else {
    if(gate_answer == "2") {
      scene_fork(1);
    } else {
      print(">> You freeze with indecision and your torch gutters out. THE END.");
    }
  }
} return void;
stdin "x\n" ():() then prints:("You stand before two tunnels.\n  1) Enter the LEFT tunnel\n  2) Enter the RIGHT tunnel\nChoose: \n>> You freeze with indecision and your torch gutters out. THE END.\n")
stdin "1\nx\n" ():() then prints:("You stand before two tunnels.\n  1) Enter the LEFT tunnel\n  2) Enter the RIGHT tunnel\nChoose: \nThe left tunnel forks at an underground RIVER.\n  1) Swim across the dark water\n  2) Search the walls for a BRIDGE\nChoose: \n>> You dither at the fork until the bats carry you off. THE END.\n")
