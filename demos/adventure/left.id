// The LEFT branch of the cavern: a river fork leading to four endings (1-4).

scene_left() {
  string l = ask("The left tunnel forks at an underground RIVER.\n  1) Swim across the dark water\n  2) Search the walls for a BRIDGE\nChoose: ");
  if(l == "1") {
    scene_river();
  } else {
    if(l == "2") {
      scene_bridge();
    } else {
      print(">> You dither at the fork until the bats carry you off. THE END.");
    }
  }
} return void;

scene_river() {
  string rv = ask("Midstream, something cold brushes your leg.\n  1) Dive down to investigate\n  2) Sprint for the far bank\nChoose: ");
  if(rv == "1") {
    print(">> ENDING 1 -- THE PEARL DIVER: you surface clutching a glowing pearl and walk out a living legend.");
  } else {
    if(rv == "2") {
      print(">> ENDING 2 -- SWEPT AWAY: the current folds over you and the dark takes the rest.");
    } else {
      print(">> Paralyzed by the choice, you slip under without a sound. THE END.");
    }
  }
} return void;

scene_bridge() {
  string br = ask("A rope BRIDGE sways over a chasm; a TROLL snores beneath it.\n  1) Tiptoe across quietly\n  2) Cut the bridge once you reach the far side\nChoose: ");
  if(br == "1") {
    print(">> ENDING 3 -- THE QUIET ESCAPE: you cross unheard and step out into a pale, free dawn.");
  } else {
    if(br == "2") {
      print(">> ENDING 4 -- THE TROLL'S REVENGE: the rope snaps a beat too early and the troll wakes very hungry. THE END.");
    } else {
      print(">> You waver on the planks until they rot through beneath you. THE END.");
    }
  }
} return void;
