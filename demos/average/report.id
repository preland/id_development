// Printing the result, and the one arithmetic edge case.

report(float total, int count) {
  print("count " + count);
  print("sum " + total);
  print_average(total, count);
} return void;

print_average(float total, int count) {
  float mean_v = mean(total, count);
  print("average " + mean_v);
} return void;

// Empty input has no average. Without the guard this is 0.0 / 0, which on a
// float is a quiet nan rather than the trap an integer divide by zero is.
mean(float total, int count) {
  float avg = 0.0;
  if(count > 0) {
    avg = total / count;
  }
} return float avg;
