// One frame: poll one input event, feed it (plus the tick) to the game-state
// update, then render. gfx_poll returns -2 when the window (or
// GFX_MAX_FRAMES) wants to close, -1 for no event, or a key code; alive turns
// that into a keep-running flag (Esc or q also quit), the same convention
// demos/gl3d/loop/frame.id uses.

frame(int t) {
  int ev = gfx_poll();
  world_update(ev, t);
  world_render(t);
} return int ev;

alive(int ev) {
  int a = 1;
  if(ev = 0 - 2 || ev = 27 || ev = 113) {
    a = 0;
  }
} return int a;
