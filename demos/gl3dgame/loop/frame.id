// One frame: poll one input event, feed it (plus the tick) to the game-state
// update, then render. glwin_poll returns -2 when the window (or
// GFX_MAX_FRAMES) wants to close, -1 for no event, or a key code; idstd's
// inp_live turns that into a keep-running flag (Esc or q also quit), the same
// convention demos/gl3d/loop/frame.id uses.

frame(int t) {
  int ev = glwin_poll();
  world_update(ev, t);
  render(t);
} return int ev;
given world_init (0):(-1)
