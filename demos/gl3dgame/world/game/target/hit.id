// Integer AABB collision: the player and target cubes' half-extents
// (world/scene/mesh/objects) sum to less than one grid spacing, so given
// grid-snapped movement they only overlap when they share a grid cell --
// abs(dx) = 0 && abs(dz) = 0. check_hit runs every frame from world_update.

abs_diff(int a, int b) {
  int d = a - b;
  if (d < 0) { d = 0 - d; }
} return int d;
(5, 3):(2)
(2, 7):(5)
(3, 3):(0)

check_hit() {
  if (hit_test()) {
    score_and_respawn();
  }
} return void;
