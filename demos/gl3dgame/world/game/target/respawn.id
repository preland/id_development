// Scoring: bump the score, move the target to a fresh pseudo-random cell,
// and print the new score so a headless run shows real game-state output.

rand_coord() {
  int v = rng_next() % 13;
} return int v - 6;

respawn_target() {
  gs_set(2, rand_coord());
  gs_set(3, rand_coord());
} return void;

score_and_respawn() {
  gs_set(4, gs_get(4) + 1);
  respawn_target();
  print("score: " + gs_get(4));
} return void;
