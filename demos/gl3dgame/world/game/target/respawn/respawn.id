// Scoring: bump the score, move the target to a fresh pseudo-random cell,
// and print the new score so a headless run shows real game-state output.

respawn_target() {
  int rand_coord_v = rand_coord();
  gs_set(2, rand_coord_v);
  respawn_z();
} return void;

score_and_respawn() {
  bump_score();
  respawn_target();
  report_score();
} return void;
