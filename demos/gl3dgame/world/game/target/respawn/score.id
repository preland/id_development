// score_and_respawn's before-and-after: bump the counter, then report it,
// split out so score_and_respawn itself stays under the action limit.

bump_score() {
  int gs_get_v = (import mb)[4];
  integer_list_set((import mb), 4, gs_get_v + 1);
} return void;
given state_init ():() then mb_state:("0,0,3,3,1")
given mb_hit_setup ():() then mb_state:("3,3,3,3,1")

report_score() {
  int gs_get_v2 = (import mb)[4];
  print("score: " + gs_get_v2);
} return void;
given state_init ():() then prints:("score: 0\n")
given state_init given bump_score ():() then prints:("score: 1\n")
