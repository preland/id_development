// Scoring: bump the score, move the target to a fresh pseudo-random cell,
// and print the new score so a headless run shows real game-state output.

respawn_target() {
  int rand_coord_v = rand_coord();
  integer_list_set((import mb), 2, rand_coord_v);
  respawn_z();
} return void;
given state_init ():() then mb_state:("0,0,-1,-1,0")
given state_init ():() then mb_state:("0,0,-1,-1,0") then eprints:("")

score_and_respawn() {
  bump_score();
  respawn_target();
  report_score();
} return void;
given state_init ():() then mb_state:("0,0,-1,-1,1") then prints:("score: 1\n")
given mb_hit_setup ():() then mb_state:("3,3,-1,-1,1") then prints:("score: 1\n")
