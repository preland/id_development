// The target's fresh pseudo-random cell, one axis at a time -- split so
// respawn_target itself stays under the action limit.

rand_coord() {
  int v = rng_next() % 13;
  int ret_i = v - 6;
} return int ret_i;

respawn_z() {
  int rand_coord_v2 = rand_coord();
  gs_set(3, rand_coord_v2);
} return void;
