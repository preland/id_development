// The target's fresh pseudo-random cell, one axis at a time -- split so
// respawn_target itself stays under the action limit.

rand_coord() {
  int v = rnd_next() % 13;
  int ret_i = v - 6;
} return int ret_i;
given state_init ():(-1)
