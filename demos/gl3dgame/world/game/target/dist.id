hit_axis(int hit_ia, int hit_ib) {
  int gs_get_v = (import mb)[hit_ia];
  int gs_get_v2 = (import mb)[hit_ib];
  int ret_i = abs_diff(gs_get_v, gs_get_v2);
} return int ret_i;
