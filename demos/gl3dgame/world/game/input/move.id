// Apply one input event to the player's grid position. Movement is
// unbounded (no clamp): since every object is drawn relative to the player
// (the camera follows it, see world/scene/render), the scene looks the same
// wherever the player wanders.

move_player(int dx, int dz) {
  gs_set(0, gs_get(0) + dx);
  gs_set(1, gs_get(1) + dz);
} return void;

apply_key(int ev) {
  int dx = key_dx(ev);
  int dz = key_dz(ev);
  move_player(dx, dz);
} return void;
