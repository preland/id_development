// Apply one input event to the player's grid position. Movement is
// unbounded (no clamp): since every object is drawn relative to the player
// (the camera follows it, see world/scene/render), the scene looks the same
// wherever the player wanders.

move_player(int dx, int dz) {
  int gs_get_v = (import mb)[0];
  lset((import mb), 0, gs_get_v + dx);
  move_z(dz);
} return void;
given state_init (1, 2):() then mb_state:("1,2,3,3,0")
given state_init (-1, 0):() then mb_state:("-1,0,3,3,0")

move_z(int dz) {
  int gs_get_v2 = (import mb)[1];
  lset((import mb), 1, gs_get_v2 + dz);
} return void;
given state_init (2):() then mb_state:("0,2,3,3,0")
given state_init (-3):() then mb_state:("0,-3,3,3,0")

apply_key(int ev) {
  int dx = key_dx(ev);
  int dz = key_dz(ev);
  move_player(dx, dz);
} return void;
given state_init (100):() then mb_state:("1,0,3,3,0")
given state_init (119):() then mb_state:("0,-1,3,3,0")
