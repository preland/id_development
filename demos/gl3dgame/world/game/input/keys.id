// Turn one glwin_poll() key code into a one-grid-step (dx, dz) delta. Key
// codes are raw ASCII bytes from XLookupString (backends/gl/gl_linux.c):
// 'd'=100/'a'=97 move along x, 's'=115/'w'=119 move along z (w = forward,
// -Z, the same "camera looks down -Z" convention demos/gl3d uses).

key_dx(int ev) {
  int dx = 0;
  if (ev = 100) { dx = 1; }
  else if (ev = 97) { dx = 0 - 1; }
} return int dx;

key_dz(int ev) {
  int dz = 0;
  if (ev = 119) { dz = 0 - 1; }
  else if (ev = 115) { dz = 1; }
} return int dz;
