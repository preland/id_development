// Game state lives in one exported list `mb` (same idiom as
// demos/moonbuggy/game/core/gamestate/state.id), indexed by:
//   0: player x (grid units)   1: player z (grid units)
//   2: target x (grid units)   3: target z (grid units)
//   4: score
// state_init also seeds the PRNG once, before any respawn ever needs a
// random coordinate.

state_init() {
  export int[] mb = [0, 0, 3, 3, 0];
  rnd_init(42);
} return void;

gs_get(int i) {
  int ret_i = (import mb)[i];
} return int ret_i;
