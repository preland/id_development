// Game state lives in one exported list `mb` (same idiom as
// demos/moonbuggy/game/core/gamestate/state.id), indexed by:
//   0: player x (grid units)   1: player z (grid units)
//   2: target x (grid units)   3: target z (grid units)
//   4: score
// state_init also seeds the PRNG once, before any respawn ever needs a
// random coordinate.

state_init() {
  export int[] mb = [0, 0, 3, 3, 0];
  rnd_init(42);
} return void;
():() then mb_state:("0,0,3,3,0")
():() then mb_state:("0,0,3,3,0") then eprints:("")

// One check for the whole 5-slot state, so every function elsewhere that
// mutates `mb` (world/game/*) can confirm the slot it touched -- and only
// that slot -- moved, the same shape as demos/gl3d's mesh_state.
mb_state() {
  string s = (import mb)[0] + "," + (import mb)[1] + "," + (import mb)[2] + "," + (import mb)[3] + "," + (import mb)[4];
} return string s;
given state_init ():("0,0,3,3,0")
given state_init ():("0,0,3,3,0") then eprints:("")
