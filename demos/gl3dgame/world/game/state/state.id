// Game state lives in one exported list `mb` (same idiom as
// demos/moonbuggy/game/core/core-3/state.id), indexed by:
//   0: player x (grid units)   1: player z (grid units)
//   2: target x (grid units)   3: target z (grid units)
//   4: score
// state_init also seeds the PRNG (world/game/state/rng) once, before any
// respawn ever needs a random coordinate.

state_init() {
  export int[] mb = [0, 0, 3, 3, 0];
  rng_seed(42);
} return void;

gs_get(int i) {
} return int (import mb)[i];
