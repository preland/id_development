// The 8 corners of a cube, indexed 0..7 (same bit-by-arithmetic addressing
// as demos/gl3d/scene/mesh/geom/corners.id), generalized with a `half`
// half-extent parameter (a milli-unit int, see backends/gl/gl.h) so the same
// geometry builds the player, target, and pillar cubes at different sizes.

corner_x(int i, int half) {
} return int ((i % 2) * 2 - 1) * half;

corner_y(int i, int half) {
} return int (((i / 2) % 2) * 2 - 1) * half;

corner_z(int i, int half) {
} return int (((i / 4) % 2) * 2 - 1) * half;
