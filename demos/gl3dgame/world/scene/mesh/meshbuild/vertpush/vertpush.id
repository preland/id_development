// Push one vertex slot's 3 coordinates onto `verts`. Split from
// fill_cube_verts (vertbuild.id) to keep each function's action count at or
// under 3, the same decomposition demos/gl3d/scene/mesh/meshbuild/vertpush.id
// uses.

push_cube_vertex(int[] verts, int half, int slot) {
  int c = face_corner(slot);
  push_cube_xyz(verts, half, c);
} return void;

push_cube_xyz(int[] verts, int half, int c) {
  int corner_x_v = corner_x(c, half);
  push(verts, corner_x_v);
  push_cube_yz(verts, half, c);
} return void;
