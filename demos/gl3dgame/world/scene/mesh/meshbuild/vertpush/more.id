// The rest of push_cube_xyz's 3 coordinates -- split further so
// push_cube_yz itself stays under the action limit.

push_cube_yz(int[] verts, int half, int c) {
  int corner_y_v = corner_y(c, half);
  push(verts, corner_y_v);
  push_cube_z(verts, half, c);
} return void;

push_cube_z(int[] verts, int half, int c) {
  int corner_z_v = corner_z(c, half);
  push(verts, corner_z_v);
} return void;
