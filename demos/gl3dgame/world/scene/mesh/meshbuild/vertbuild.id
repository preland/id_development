// Build one cube's flattened vertex list: 36 vertices (12 triangles * 3), 3
// milli-unit ints each, in the order backends/gl/gl.h's gl_draw_tris wants.
// Parameterized by `half` (see geom/corners.id) so this one builder makes
// the player, target, and pillar meshes (world/scene/mesh/objects) at
// different sizes -- each call returns its own fresh list.

build_cube_verts(int half) {
  int[] verts = [];
  fill_cube_verts(verts, half, 0);
} return int[] verts;

fill_cube_verts(int[] verts, int half, int slot) {
  while (slot < 36) {
    push_cube_vertex(verts, half, slot);
    slot = slot + 1;
  }
} return void;
