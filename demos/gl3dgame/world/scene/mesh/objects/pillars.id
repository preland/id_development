// The pillar field: one shared gray cube mesh, instanced at 8 fixed world
// positions (grid units, like the player/target coordinates in
// world/game/state/gsinit.id) to give the scene depth and something for the
// depth buffer to sort against as the camera moves. Static -- never
// respawned, unlike the target.

init_pillar_mesh() {
  export int[] pillar_verts = cube_vertices(350);
  export int[] pillar_colors = cube_colors(120*65536+120*256+150);
  init_pillar_layout();
} return void;
():()
():() then eprints:("")

init_pillar_layout() {
  export int[] pillar_x = [0-4, 4, 0-4, 4, 0, 0, 0-3, 3];
  export int[] pillar_z = [0-4, 0-4, 4, 4, 0-6, 6, 0, 0];
} return void;
():()
():() then eprints:("")
