// The target cube's mesh, built once at startup: a smaller gold cube (it
// spins in place every frame -- see world/scene/render/draw/instances.id).

init_target_mesh() {
  export int[] target_verts = build_cube_verts(400);
  export int[] target_colors = build_cube_colors(255*65536+200*256+60);
} return void;
