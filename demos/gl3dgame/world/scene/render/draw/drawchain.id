// Top of the per-frame draw chain: clear, draw the player + target, draw the
// pillar field, then present. Split across 3 small functions to keep each
// one at or under the 3-action limit, the same reason demos/gl3d's
// scene/render/draw.id splits clear/place from submit.

draw_all(int view, int t) {
  draw_foreground(view, t);
  draw_pillars(view);
  gl_end_frame();
} return void;
given world_init (3, 0):() then calls draw_foreground:(3, 0) then calls draw_pillars:(3)
given world_init (5, 100):() then calls draw_foreground:(5, 100) then calls draw_pillars:(5)
given world_init (0, 0):()
given world_init (0, 100):() then eprints:("")

draw_foreground(int view, int t) {
  gl_begin_frame(15, 15, 35);
  draw_dynamic(view, t);
} return void;
given world_init (3, 0):() then calls draw_dynamic:(3, 0)
given world_init (5, 100):() then calls draw_dynamic:(5, 100)
given world_init (0, 0):()
given world_init (0, 100):() then eprints:("")

draw_dynamic(int view, int t) {
  draw_player(view);
  draw_target(view, t);
} return void;
given world_init (3, 0):() then calls draw_player:(3) then calls draw_target:(3, 0)
given world_init (5, 100):() then calls draw_player:(5) then calls draw_target:(5, 100)
given world_init (0, 0):()
given world_init (0, 100):() then eprints:("")
