// Draw the two "dynamic" objects. The player is always drawn at the view's
// own origin (0,0,0) -- the chase camera follows it, so it never needs its
// own translate. The target is drawn at its position *relative to the
// player* (world/game/state's tx,tz minus px,pz, scaled to milli-units by
// the 1600 grid spacing) and spins for visibility.

draw_player(int view) {
  gl_set_modelview(view);
  gl_draw_tris((import player_verts), (import player_colors), 12);
} return void;

draw_target(int view, int t) {
  int mv = target_mv(view, t);
  gl_set_modelview(mv);
  gl_draw_tris((import target_verts), (import target_colors), 12);
} return void;

target_mv(int view, int t) {
  int dx = (gs_get(2) - gs_get(0)) * 1600;
  int dz = (gs_get(3) - gs_get(1)) * 1600;
  int rel = gl_mat_translate(dx, 0, dz);
} return int gl_mat_mul(view, gl_mat_mul(rel, gl_mat_rotate_y((t * 3000) % 360000)));
