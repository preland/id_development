// Walk the pillar field (world/scene/mesh/objects/pillars.id's pillar_x /
// pillar_z), drawing one pillar per position.

draw_pillars(int view) {
  loop_pillars(view, 0);
} return void;
given world_init (3):() then calls loop_pillars:(3, 0)
given world_init (5):() then calls loop_pillars:(5, 0)
given world_init (0):()
given world_init (5):() then eprints:("")

loop_pillars(int view, int i) {
  while (i < len((import pillar_x))) {
    draw_one_pillar(view, i);
    i = i + 1;
  }
} return void;
given world_init (3, 7):() then calls draw_one_pillar:(3, 7)
given world_init (4, 6):() then calls draw_one_pillar:(4, 6)
given world_init (0, 8):()
given world_init (0, 0):() then eprints:("")
