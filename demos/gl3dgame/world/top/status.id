// world_update's occasional status line, split out so the `if` block it
// runs inside stays under the action limit.

report_status() {
  int gs_get_v3 = (import mb)[4];
  report_pos(gs_get_v3);
} return void;
given state_init ():() then prints:("pos 0,0 score 0\n")
given mb_hit_setup ():() then prints:("pos 3,3 score 0\n")

report_pos(int score) {
  int gs_get_v = (import mb)[0];
  int gs_get_v2 = (import mb)[1];
  print("pos " + gs_get_v + "," + gs_get_v2 + " score " + score);
} return void;
given state_init (5):() then prints:("pos 0,0 score 5\n")
given mb_hit_setup (2):() then prints:("pos 3,3 score 2\n")
