// The top-level game orchestration: one-time setup, one per-frame state
// update (input + collision + an occasional status line), and rendering.
// Delegates everything to game/ (state, input, target logic) and scene/
// (mesh + GL rendering) -- see their READMEs.

world_init() {
  state_init();
  scene_init();
} return void;
():() then mb_state:("0,0,3,3,0")
():() then mb_state:("0,0,3,3,0") then eprints:("")

world_update(int ev, int t) {
  apply_key(ev);
  check_hit();
  if (t % 60 == 0) {
    report_status();
  }
} return void;
given world_init (0, 1):() then mb_state:("0,0,3,3,0")
given world_init (100, 60):() then mb_state:("1,0,3,3,0") then prints:("pos 1,0 score 0\n")
