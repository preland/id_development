// One frame: render the scene at tick t (see scene/render), then poll one
// input event. glwin_poll returns -2 when the window (or GFX_MAX_FRAMES) wants
// to close, -1 for no event, or a key code; alive turns that into a
// keep-running flag (Esc or q also quit).

frame(int t) {
  render(t);
  int ev = glwin_poll();
} return int ev;

alive(int ev) {
  int a = 1;
  if(ev = 0 - 2 || ev = 27 || ev = 113) {
    a = 0;
  }
} return int a;
