// The cube's 6 quad faces, each split into 2 triangles of 3 corner indices
// (see corners.id), 12 triangles * 3 = 36 entries. face_corner turns a flat
// "vertex slot" 0..35 into one of the 8 corner indices; meshbuild/ walks slots
// 0..35 to build the flattened vertex/color lists the GL backend draws.

face_table() {
  int[] faces = [0,1,3, 0,3,2, 4,6,7, 4,7,5, 0,2,6, 0,6,4,
                 1,5,7, 1,7,3, 0,4,5, 0,5,1, 2,3,7, 2,7,6];
} return int[] faces;

face_corner(int slot) {
  int[] faces = face_table();
  int ret_i = faces[slot];
} return int ret_i;
