// The 8 corners of a unit cube, indexed 0..7: idstd's d3_cube_x/y/z (bit 0 of i
// picks the x sign, bit 1 the y sign, bit 2 the z sign) at half = 1000. Each
// coordinate is a milli-unit int (see backends/gl/gl.h) -- 1000 means 1.0, so
// the cube spans -1..1.

corner_x(int i) {
  int ret_i = d3_cube_x(i, 1000);
} return int ret_i;
(0):(-1000)
(1):(1000)

corner_y(int i) {
  int ret_i = d3_cube_y(i, 1000);
} return int ret_i;
(0):(-1000)
(3):(1000)

corner_z(int i) {
  int ret_i = d3_cube_z(i, 1000);
} return int ret_i;
(0):(-1000)
(7):(1000)
