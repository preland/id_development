// The 8 corners of a unit cube, indexed 0..7 and addressed by plain integer
// arithmetic (id has no bitwise ops): bit 0 of i picks the x sign, bit 1 the
// y sign, bit 2 the z sign, read off with % and / the same way boxcolor packs
// channels in demos/gfxdemo/fb/color.id. Each coordinate is a milli-unit int
// (see backends/gl/gl.h) -- 1000 means 1.0, so the cube spans -1..1.

corner_x(int i) {
  int ret_i = ((i % 2) * 2 - 1) * 1000;
} return int ret_i;

corner_y(int i) {
  int ret_i = (((i / 2) % 2) * 2 - 1) * 1000;
} return int ret_i;

corner_z(int i) {
  int ret_i = (((i / 4) % 2) * 2 - 1) * 1000;
} return int ret_i;
