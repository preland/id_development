// The last color pushed, not only the count -- mirrors verts_state
// (vertbuild.id), which mutation-testing push_z against showed was needed:
// a case that only counts elements does not notice a wrong one.
colors_state() {
  string colors_summary = (import colors)[0] + "," + len((import colors)) + "," + (import colors)[len((import colors)) - 1];
} return string colors_summary;
