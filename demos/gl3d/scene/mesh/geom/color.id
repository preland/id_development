// One color per corner, packed 0xRRGGBB the same way demos/gfxdemo/fb/color.id
// packs pixels -- each channel toggles with a bit of the corner index so all 8
// corners are visually distinct, which makes the cube's rotation and the GPU's
// per-vertex color interpolation (see backends/gl/gl.h's gl_draw_tris) obvious.

corner_color(int i) {
  int r = 40 + (i % 2) * 180;
  int gb = corner_gb(i);
  int ret_i = r * 65536 + gb;
} return int ret_i;

corner_gb(int i) {
  int g = 40 + ((i / 2) % 2) * 180;
  int b = 40 + ((i / 4) % 2) * 180;
  int ret_i = g * 256 + b;
} return int ret_i;
