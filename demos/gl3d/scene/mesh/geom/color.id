(7):(14474460)

corner_green_blue(int corner_index) {
  int green_channel = 40 + ((corner_index / 2) % 2) * 180;
  int blue_channel = 40 + ((corner_index / 4) % 2) * 180;
  int packed_green_blue = green_channel * 256 + blue_channel;
} return int packed_green_blue;
