// Build the flattened per-vertex color list: one packed 0xRRGGBB int per
// vertex slot, parallel to (import verts) from vertbuild.id -- exactly the
// shape backends/gl/gl.h's gl_draw_tris expects for its "colors" argument.

build_colors() {
  export int[] colors = [];
  fill_colors(0);
} return void;
():() then colors_state:("2631720,36,2677980")
():() then colors_state:("2631720,36,2677980") then eprints:("")

fill_colors(int slot) {
  while(slot < 36) {
    push_color(slot);
    slot = slot + 1;
  }
} return void;
given build_colors (36):() then colors_state:("2631720,36,2677980")
given build_colors (35):() then colors_state:("2631720,37,2677980")

push_color(int slot) {
  int c = d3_cube_corner(slot);
  int corner_color_v = corner_color(c);
  push((import colors), corner_color_v);
} return void;
given build_colors (0):() then colors_state:("2631720,37,2631720")
