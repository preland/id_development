// Build the flattened vertex position list: 36 vertices (12 triangles * 3),
// 3 milli-unit ints each = 108 ints total, in the exact order
// backends/gl/gl.h's gl_draw_tris expects. Mirrors demos/gfxdemo/fb/fb.id's
// fb_alloc/fb_fill shape: an exported list, filled by walking an index.

build_vertices() {
  export int[] mesh_positions = [];
  fill_vertices(0);
} return void;
():() then vertices_state:("verts_state -1000,108,1000")
():() then vertices_state:("verts_state -1000,108,1000") then eprints:("")

fill_vertices(int slot) {
  while(slot < 36) {
    push_vertex(slot);
    slot = slot + 1;
  }
} return void;
given build_vertices (36):() then vertices_state:("verts_state -1000,108,1000")
given build_vertices (35):() then vertices_state:("verts_state -1000,111,1000")

// The last coordinate pushed, not only the count, so a case that pushes the
// wrong value (rather than the wrong number of values) still goes red -- a
// mutation check on push_z caught this the first way round (mutate.id
// house rule: strengthen a case that stays green).
vertices_state() {
  string vertices_summary = "verts_state " + ((import mesh_positions)[0] + "," + len((import mesh_positions)) + "," + (import mesh_positions)[len((import mesh_positions)) - 1]);
} return string vertices_summary;
