// The rest of push_xyz's 3 coordinates -- split further so push_yz itself
// stays under the action limit.

push_yz(int c) {
  int corner_y_v = corner_y(c);
  push((import verts), corner_y_v);
  push_z(c);
} return void;

push_z(int c) {
  int corner_z_v = corner_z(c);
  push((import verts), corner_z_v);
} return void;
