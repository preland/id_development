// The rest of push_xyz's 3 coordinates -- split further so push_yz itself
// stays under the action limit.

push_yz(int c) {
  int corner_y_v = cube_at(c, 2, (import cube_half));
  push((import verts), corner_y_v);
  push_z(c);
} return void;
given build_verts (0):() then verts_state:("verts_state -1000,110,-1000")
given build_verts (7):() then verts_state:("verts_state -1000,110,1000")

push_z(int c) {
  int corner_z_v = cube_at(c, 4, (import cube_half));
  push((import verts), corner_z_v);
} return void;
given build_verts (0):() then verts_state:("verts_state -1000,109,-1000")
given build_verts (7):() then verts_state:("verts_state -1000,109,1000")
