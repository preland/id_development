// The rest of push_xyz's 3 coordinates -- split further so push_yz itself
// stays under the action limit.

push_height_and_depth(int cube_corner_index) {
  int corner_y_position = cube_at(cube_corner_index, 2, (import cube_half));
  push((import mesh_positions), corner_y_position);
  push_z(cube_corner_index);
} return void;
given build_vertices (0):() then vertices_state:("verts_state -1000,110,-1000")
given build_vertices (7):() then vertices_state:("verts_state -1000,110,1000")

push_z(int cube_corner_index) {
  int corner_z_position = cube_at(cube_corner_index, 4, (import cube_half));
  push((import mesh_positions), corner_z_position);
} return void;
given build_vertices (0):() then vertices_state:("verts_state -1000,109,-1000")
given build_vertices (7):() then vertices_state:("verts_state -1000,109,1000")
