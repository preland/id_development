// Push one vertex slot's 3 coordinates onto (import verts). Split from
// fill_verts (vertbuild.id) to keep each function's action count at or under
// 3, the same decomposition demos/gfxdemo/loop/anim/grid.id uses for its
// nested box-fill loops.

push_vertex(int slot) {
  int c = cube_corner(slot);
  push_xyz(c);
} return void;
given build_verts (0):() then verts_state:("verts_state -1000,111,-1000")
given build_verts (35):() then verts_state:("verts_state -1000,111,1000")

push_xyz(int c) {
  int corner_x_v = cube_at(c, 1, (import cube_half));
  push((import verts), corner_x_v);
  push_yz(c);
} return void;
given build_verts (0):() then verts_state:("verts_state -1000,111,-1000")
given build_verts (7):() then verts_state:("verts_state -1000,111,1000")
