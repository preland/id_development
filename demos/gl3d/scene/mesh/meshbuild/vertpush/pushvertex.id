// Push one vertex slot's 3 coordinates onto (import verts). Split from
// fill_verts (vertbuild.id) to keep each function's action count at or under
// 3, the same decomposition demos/gfxdemo/loop/anim/grid.id uses for its
// nested box-fill loops.

push_vertex(int slot) {
  int cube_corner_index = cube_corner(slot);
  push_all_axes(cube_corner_index);
} return void;
given build_vertices (0):() then vertices_state:("verts_state -1000,111,-1000")
given build_vertices (35):() then vertices_state:("verts_state -1000,111,1000")

push_all_axes(int cube_corner_index) {
  int corner_x_position = cube_at(cube_corner_index, 1, (import cube_half));
  push((import mesh_positions), corner_x_position);
  push_height_and_depth(cube_corner_index);
} return void;
