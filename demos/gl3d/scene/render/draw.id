// The actual GL calls for one frame: clear + load the modelview, then submit
// the mesh and present. Split into two so each function stays at or under the
// 3-action limit (the same reason demos/gfxdemo/loop/frame.id keeps
// presenting and polling in separate steps).

draw_scene(int placement_matrix) {
  clear_and_place(placement_matrix);
  submit_triangles();
} return void;
given mesh_initialize (0):() then calls clear_and_place:(0)
given mesh_initialize (5):() then calls clear_and_place:(5)

// The three real GL calls in this file take no case-observable state (no
// exported global they leave a trace in, and glClear/glLoadMatrixf/
// glDrawArrays have nothing an `id` check could read back), so all a case
// can honestly prove is that the call completes rather than trapping -- a
// no-op probe build first confirmed these run safely with no window open.
clear_and_place(int placement_matrix) {
  gl_begin_frame(15, 15, 35);
  gl_set_modelview(placement_matrix);
} return void;
(0):()
(5):()

submit_triangles() {
  int triangle_total = (import triangle_count);
  gl_draw_tris((import mesh_positions), (import colors), triangle_total);
  gl_end_frame();
} return void;
