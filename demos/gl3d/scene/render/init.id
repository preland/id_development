// One-time scene setup: build the mesh, then build the projection matrix
// once (it never changes frame to frame) and stash its handle in an exported
// global so render/frame.id can reuse it every frame.

scene_initialize() {
  mesh_initialize();
  export int projection_matrix = gl_mat_perspective(60000, 1333, 100, 10000);
} return void;
