// gl3d -- the first hardware-accelerated 3D program in `id`. It opens a
// 640x480 window via the native GL backend (host/dev/win/gl), builds a cube mesh
// and its matrices once, then runs a frame loop that spins the cube and
// presents it through a real GPU pipeline (see scene/render for the per-frame
// work). Only glwin_open/gl_*/glwin_poll/glwin_close cross into platform code; the
// mesh, the matrix composition order, and the frame loop are all portable id.
//
//   idc/bin/idc demos/gl3d --allow-untested -o gl3d && ./gl3d
//
// Close the window (or press Esc / q) to quit. GFX_MAX_FRAMES lets a headless
// build run N frames and exit on its own (see host/dev/win/gfx and host/dev/win/gl).

// main()'s no-display path: the build harness runs every case with IDSTD_GFX=none
// (docs/TESTS.md), which makes glwin_open() fail the same way on every machine,
// whatever its own DISPLAY is, so ok=0
// and loop(ok) returns through spin's run<=0 branch without ever calling
// frame -- the one path that does not depend on GFX_MAX_FRAMES, an
// environment variable this build does not export.
main(int argc, string[] argv) {
  int ok = glwin_open(640, 480, "id gl3d -- spinning cube");
  scene_init();
  loop(ok);
} return int 0;
