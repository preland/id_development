main(int argc, string[] argv) {
  int thread_count = thread_count_from_arguments(argc, argv);
  int checksum = fractal_checksum(thread_count);
  print("hash " + checksum);
} return int 0;
(1, ["p"]):(0) then prints:("hash 4135956\n")
(2, ["p", "3"]):(0) then prints:("hash 4135956\n")

thread_count_from_arguments(int argc, string[] argv) {
  int requested_threads = 0 - 1;
  if(argc > 1) {
    requested_threads = to_int(argv[1]);
  }
} return int requested_threads;
(1, ["p"]):(-1)
(2, ["p", "4"]):(4)

fractal_checksum(int thread_count) {
  int[] row_totals = [];
  if(thread_count < 0) {
    row_totals = thread_map_serial(fractal_row_total, (import fractal_size));
  } else {
    row_totals = thread_map(fractal_row_total, (import fractal_size), thread_count);
  }
} chain (int thread_count) {
  int checksum = fractal_fold_checksum(row_totals);
} return int checksum;
(-1):(4135956)
(2):(4135956)
