// A per-frame status line, printed roughly once a second (60 ticks @ 16ms).
// flight/ has no stored state at all -- every camera value is a pure
// function of the tick t, so this can read the same altitude/distance the
// renderer will use just by calling those functions itself.

world_update(int tick) {
  if (tick % 60 = 0) {
    int flown_distance = flown(tick);
    int current_altitude = altitude(tick);
    print("frame " + tick + "  dist " + flown_distance + "mm  alt " + current_altitude + "mm");
  }
} return void;
(0):() then prints:("frame 0  dist 0mm  alt 2800mm\n")
(60):() then prints:("frame 60  dist 5400mm  alt 2820mm\n")
(1):() then prints:("")
