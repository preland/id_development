// Per-frame rendering: rebuild the camera and projection matrices fresh
// (see flight/ for why) and hand off to flight/draw.id.

world_render(int tick) {
  int view = build_view(tick);
  render_with_view(view);
} return void;
given world_initialize (0):() then calls render_with_view:(4)
given world_initialize (700):() then calls render_with_view:(4)
given world_initialize (0):()
given world_initialize (700):() then eprints:("")

render_with_view(int view) {
  int projection_slot = build_projection();
  gl_set_projection(projection_slot);
  draw_scene(view);
} return void;
given world_initialize (7):() then calls draw_scene:(7)
given world_initialize (5):() then calls draw_scene:(5)
given world_initialize (0):()
given world_initialize (5):() then eprints:("")
