// Top-level orchestration: one-time setup (terrain heightmap + mesh), a
// per-frame status line printed roughly once a second (60 ticks @ 16ms), and
// per-frame rendering. Delegates to terrain/ (heightmap generation + mesh
// build) and flight/ (camera matrices + GL draw calls) -- see their comments.
// flight/ has no stored state at all: every camera value is a pure function
// of the tick t, so world_update can read the same altitude/distance the
// renderer will use just by calling those functions itself.

world_init() {
  terrain_init(9001);
  mesh_init();
} return void;

world_update(int t) {
  if (t % 60 = 0) {
    print("frame " + t + "  dist " + flown(t) + "mm  alt " + altitude(t) + "mm");
  }
} return void;

world_render(int t) {
  int view = build_view(t);
  gl_set_projection(build_proj());
  draw_scene(view);
} return void;
