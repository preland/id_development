// No case-observable state either (see demos/gl3d/scene/render/draw.id's
// note on the same shape); a no-window probe build confirmed these run
// safely with no GL context current.
clear_and_place(int view) {
  gl_begin_frame(135, 206, 235);
  gl_set_modelview(view);
} return void;
