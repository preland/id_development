// The actual GL calls for one frame: clear to sky-blue + load the modelview,
// then submit the (static, built once in terrain/mesh) terrain mesh and
// present. Split into 3 small functions to stay at or under the 3-action
// limit -- same shape as demos/gl3d/scene/render/draw.id.

draw_scene(int view) {
  clear_and_place(view);
  submit_tris();
} return void;

clear_and_place(int view) {
  gl_begin_frame(135, 206, 235);
  gl_set_modelview(view);
} return void;

submit_tris() {
  int tri_count_v = tri_count();
  gl_draw_tris((import verts), (import colors), tri_count_v);
  gl_end_frame();
} return void;
