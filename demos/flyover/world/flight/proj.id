// The perspective projection, rebuilt fresh every frame from the window's
// LIVE aspect ratio (backends/gl/README.md's resize recipe) so a runtime
// resize never stretches the image -- 70-degree vertical FOV, near 0.1,
// far 60 units (comfortably covers the whole 54.6-unit-deep terrain).

build_projection() {
  int window_aspect = gl_aspect_x1000();
  int perspective_matrix = gl_mat_perspective(70000, window_aspect, 100, 60000);
} return int perspective_matrix;
