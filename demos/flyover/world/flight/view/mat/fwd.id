// The translate half of build_view's modelview: lift to cruise altitude and
// slide the world forward past the camera by flown(t).

forward_translate(int tick) {
  int eye_altitude = altitude(tick);
  int distance_ahead = flown(tick);
  int translation_matrix = gl_mat_translate(0, 0 - eye_altitude, distance_ahead);
} return int translation_matrix;
(700):(0)
(60):(0)
(0):(0)
