// The camera's motion, entirely as pure functions of the tick t -- no stored
// state at all, so world/world.id's status print and view.id's matrix build
// always agree, just by calling the same functions.
//
// flown: distance flown in milli-units, 90/tick (~5.6 units/sec at the
// engine's 16ms tick), wrapped modulo the terrain's total depth (39 rows *
// 1400 spacing = 54600) so the flyover loops forever once it reaches the far
// edge -- the "scroll across a large heightmap" endless strategy.
// altitude: a fixed cruise height plus a slow vertical bob (wave.id).
// bank_deg: a slow +-3 degree roll for a bit of life, also via wave.id.

flown(int tick) {
  int wrapped_distance = (tick * 90) % 54600;
} return int wrapped_distance;
(700):(8400)
(1000):(35400)
(0):(0)

altitude(int tick) {
  int bob = triangle(tick, 240, 40);
  int eye_height = 2800 + bob;
} return int eye_height;
(0):(2800)
(120):(2840)

bank_angle(int tick) {
  int triangle_wave = triangle(tick, 480, 6000);
  int centered_bank = triangle_wave - 3000;
} return int centered_bank;
(0):(-3000)
(240):(3000)
