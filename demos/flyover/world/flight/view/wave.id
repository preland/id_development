// A pure-integer triangle wave: 0 at t%period==0, ramps up to amp at the
// half-period, back down to 0 at the full period. Used by motion.id for both
// the altitude bob and the bank oscillation (two different (period, amp)
// calls into this one function, not two copies of the same logic).

triangle(int t, int period, int amp) {
  int v = t % period;
  if(v > period / 2) {
    v = period - v;
  }
  int ret_i = (v * amp * 2) / period;
} return int ret_i;
