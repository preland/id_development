// The 3 terrain shades, packed 0xRRGGBB the same way demos/gfxdemo/fb/color.id
// and demos/gl3d/scene/mesh/geom/color.id pack pixels: dark green low, brown
// mid, light/near-white peaks.

shade_low() {
} return int 20 * 65536 + 110 * 256 + 40;

shade_mid() {
} return int 120 * 65536 + 90 * 256 + 50;

shade_high() {
} return int 225 * 65536 + 225 * 256 + 225;
