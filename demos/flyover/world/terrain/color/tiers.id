// Height -> color-tier dispatch, a chain of small functions (not a nested
// pyramid) per README's "deep dispatch" guidance: below 900mm is a low green
// valley, 900..1899mm a brown hillside, 1900mm+ a light/white peak.

height_color(int h) {
  int c = 0;
  if(h < 900) {
    c = pack_color_channels(20, 110, 40);
  } else {
    c = height_color_high(h);
  }
} return int c;
(500):(1338920)
(2000):(14803425)

height_color_high(int h) {
  int c = 0;
  if(h < 1900) {
    c = pack_color_channels(120, 90, 50);
  } else {
    c = pack_color_channels(225, 225, 225);
  }
} return int c;
(1000):(7887410)
