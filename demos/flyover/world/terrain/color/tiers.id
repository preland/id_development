// Height -> color-tier dispatch, a chain of small functions (not a nested
// pyramid) per README's "deep dispatch" guidance: below 900mm is a low green
// valley, 900..1899mm a brown hillside, 1900mm+ a light/white peak.

height_color(int terrain_height) {
  int base_terrain_color = 0;
  if(terrain_height < 900) {
    base_terrain_color = pack_color_channels(20, 110, 40);
  } else {
    base_terrain_color = height_color_high(terrain_height);
  }
} return int base_terrain_color;
(500):(1338920)
(2000):(14803425)

height_color_high(int terrain_height) {
  int upper_terrain_color = 0;
  if(terrain_height < 1900) {
    upper_terrain_color = pack_color_channels(120, 90, 50);
  } else {
    upper_terrain_color = pack_color_channels(225, 225, 225);
  }
} return int upper_terrain_color;
