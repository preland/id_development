// The heightmap: a flat exported int[] `heights`, GRID_W=13 columns by
// GRID_D=40 rows (520 cells), indexed heights[gz*13 + gx] -- see
// mesh/geom/index.id for the same 13/40 constants used to decode a mesh
// vertex slot back into a grid cell. terrain_init seeds the PRNG (random/),
// fills the grid with raw random heights, then smooths it (smooth/) into
// rolling hills -- pure integer arithmetic throughout, no floats or trig.

terrain_init(int seed) {
  rnd_init(seed);
  alloc_heights();
  generate_heights();
} return void;
(9001):() then heights_state:("614,520")
(1):() then heights_state:("1614,520")

// heights: heights[100] alone, for smooth_cell/smooth_rows/smooth_cols/
// smooth_heights' own cases: lset overwrites a cell in place, so
// heights_state's first-element-and-length check (build.id) never moves --
// a case has to look at the one cell it actually touched.
alloc_heights() {
  export int[] heights = [];
} return void;
():()
():() then eprints:("")

generate_heights() {
  raw_fill(0);
  smooth_heights();
} return void;
