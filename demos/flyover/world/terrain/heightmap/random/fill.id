// Fill all 520 heightmap cells (13*40, see ../gen.id) with a raw random
// milli-unit height 0..3199 from idstd's Park-Miller PRNG.
// Mirrors demos/gl3d's build_verts/fill_verts shape: an exported list, filled
// by walking an index with a while loop.

raw_fill(int i) {
  while(i < 520) {
    push_height(i);
    i = i + 1;
  }
} return void;
given world_init (520):() then heights_state:("614,520")
given world_init (519):() then heights_state:("614,521")

push_height(int i) {
  int rng_height_v = rng_height();
  push((import heights), rng_height_v);
} return void;
given world_init (0):() then heights_state:("614,521")
given world_init (5):() then heights_state:("614,521") then eprints:("")

rng_height() {
  int v = random_next() % 3200;
} return int v;
given world_init ():(1365)
given world_init ():(1365) then eprints:("")
