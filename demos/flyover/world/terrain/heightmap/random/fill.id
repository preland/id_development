// Fill all 520 heightmap cells (13*40, see ../gen.id) with a raw random
// milli-unit height 0..3199 from the Park-Miller PRNG (rng.id/rng2.id).
// Mirrors demos/gl3d's build_verts/fill_verts shape: an exported list, filled
// by walking an index with a while loop.

raw_fill(int i) {
  while(i < 520) {
    push_height(i);
    i = i + 1;
  }
} return void;

push_height(int i) {
  push((import heights), rng_height());
} return void;

rng_height() {
  int v = rng_next() % 3200;
} return int v;
