neighborhood_sum(int grid_index) {
  int center_and_left = (import heights)[grid_index] + (import heights)[grid_index - 1];
  int right_and_above = (import heights)[grid_index + 1] + (import heights)[grid_index - 13];
  int total_height = center_and_left + right_and_above + (import heights)[grid_index + 13];
} return int total_height;
