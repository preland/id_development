// Average one interior cell (grid coordinate gz,gx, grid width 13) with its
// left/right/up/down neighbors and write the result back. sum5 does the
// 5-value sum (kept separate to stay under the 3-action limit); lset is the
// generic "store into a list element" helper (an imported list can't be
// index-assigned directly, but passing it as a parameter makes the lvalue an
// identifier again, and lists are reference-semantic so the store is shared
// -- same trick demos/gl3dgame/world/game/state/mutate.id uses).

smooth_cell(int gz, int grid_column) {
  int grid_index = gz * 13 + grid_column;
  int sum = neighborhood_sum(grid_index);
  integer_list_set((import heights), grid_index, sum / 5);
} return void;
