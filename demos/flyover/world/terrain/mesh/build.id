// mesh_positions[0]/colors[0] and both lengths together, for every mesh-building
// case elsewhere -- same shape as demos/gl3d's mesh_state.
mesh_state() {
  string mesh_summary = (import mesh_positions)[0] + "," + len((import mesh_positions)) + "," + (import colors)[0] + "," + len((import colors));
} return string mesh_summary;
