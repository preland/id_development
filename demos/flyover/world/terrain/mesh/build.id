// The mesh module's public surface: build both flattened lists once at
// startup (meshbuild/) -- same shape as demos/gl3d/scene/mesh/api.id. The
// terrain never changes after this, so the per-frame cost is just rebuilding
// the camera matrices (flight/), not rebuilding geometry.

mesh_init() {
  build_verts();
  build_colors();
} return void;
given world_init ():() then mesh_state:("-8400,8424,1338920,2808")
given world_init ():() then mesh_state:("-8400,8424,1338920,2808") then eprints:("")

// verts[0]/colors[0] and both lengths together, for every mesh-building
// case elsewhere -- same shape as demos/gl3d's mesh_state.
mesh_state() {
  string st = (import verts)[0] + "," + len((import verts)) + "," + (import colors)[0] + "," + len((import colors));
} return string st;
given world_init ():("-8400,8424,1338920,2808")
given world_init ():("-8400,8424,1338920,2808") then eprints:("")

// heights[0] and its length, for terrain-only cases that never touch the
// mesh (world_init reaches both, but this stays honest about which state
// each case actually needs).
heights_state() {
  string st = (import heights)[0] + "," + len((import heights));
} return string st;
