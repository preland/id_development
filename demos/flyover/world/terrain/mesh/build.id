// heights[0] and its length, for terrain-only cases that never touch the
// mesh (world_init reaches both, but this stays honest about which state
// each case actually needs).
heights_state() {
  string heights_summary = (import heights)[0] + "," + len((import heights));
} return string heights_summary;
