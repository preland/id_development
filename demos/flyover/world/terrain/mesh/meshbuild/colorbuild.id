// Build the flattened per-vertex color list: one packed 0xRRGGBB int per
// vertex slot, parallel to (import verts) from vertbuild.id -- exactly the
// shape backends/gl/gl.h's gl_draw_tris expects for its "colors" argument.

build_colors() {
  export int[] colors = [];
  fill_colors(0);
} return void;
given world_init ():() then mesh_state:("-8400,8424,1338920,2808")
given world_init ():() then mesh_state:("-8400,8424,1338920,2808") then eprints:("")

fill_colors(int slot) {
  while(slot < 2808) {
    push_color(slot);
    slot = slot + 1;
  }
} return void;
given world_init (2808):() then mesh_state:("-8400,8424,1338920,2808")
given world_init (2807):() then mesh_state:("-8400,8424,1338920,2809")

push_color(int slot) {
  int c = slot_corner(slot);
  int corner_color_v = corner_color(c);
  push((import colors), corner_color_v);
} return void;
given world_init (0):() then mesh_state:("-8400,8424,1338920,2809")
given world_init (5):() then mesh_state:("-8400,8424,1338920,2809") then eprints:("")
