// Push one vertex slot's 3 coordinates onto (import mesh_positions). Split from
// fill_verts (vertbuild.id) to keep each function's action count at or under
// 3 -- same decomposition demos/gl3d/scene/mesh/meshbuild/vertpush/pushvertex.id uses.

push_vertex(int slot) {
  int grid_corner = slot_corner(slot);
  push_all_axes(grid_corner);
} return void;
given world_initialize (0):() then mesh_state:("-8400,8427,1338920,2808")
given world_initialize (5):() then mesh_state:("-8400,8427,1338920,2808") then eprints:("")

push_all_axes(int grid_corner) {
  push_x(grid_corner);
  push_y(grid_corner);
  push_z(grid_corner);
} return void;
given world_initialize (0):() then mesh_state:("-8400,8427,1338920,2808")
given world_initialize (5):() then mesh_state:("-8400,8427,1338920,2808") then eprints:("")
