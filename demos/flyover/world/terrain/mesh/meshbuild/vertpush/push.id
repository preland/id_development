// Push one vertex slot's 3 coordinates onto (import verts). Split from
// fill_verts (vertbuild.id) to keep each function's action count at or under
// 3 -- same decomposition demos/gl3d/scene/mesh/meshbuild/vertpush/pushvertex.id uses.

push_vertex(int slot) {
  int c = slot_corner(slot);
  push_xyz(c);
} return void;
given world_init (0):() then mesh_state:("-8400,8427,1338920,2808")
given world_init (5):() then mesh_state:("-8400,8427,1338920,2808") then eprints:("")

push_xyz(int c) {
  push_x(c);
  push_y(c);
  push_z(c);
} return void;
given world_init (0):() then mesh_state:("-8400,8427,1338920,2808")
given world_init (5):() then mesh_state:("-8400,8427,1338920,2808") then eprints:("")
