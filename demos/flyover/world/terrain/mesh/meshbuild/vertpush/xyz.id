// One coordinate each, so push_xyz (push.id) stays within its own 3-action
// budget while pushing all 3 -- the three bodies read alike but read
// different sources (corner_x, the height list, corner_z), so they are not
// the same logic three times.

push_x(int grid_corner) {
  int corner_x_position = corner_x(grid_corner);
  push((import mesh_positions), corner_x_position);
} return void;
given world_initialize (0):() then mesh_state:("-8400,8425,1338920,2808")
given world_initialize (5):() then mesh_state:("-8400,8425,1338920,2808") then eprints:("")

push_y(int grid_corner) {
  int corner_y_position = (import heights)[grid_corner];
  push((import mesh_positions), corner_y_position);
} return void;
given world_initialize (0):() then mesh_state:("-8400,8425,1338920,2808")
given world_initialize (5):() then mesh_state:("-8400,8425,1338920,2808") then eprints:("")

push_z(int grid_corner) {
  int corner_z_position = corner_z(grid_corner);
  push((import mesh_positions), corner_z_position);
} return void;
given world_initialize (0):() then mesh_state:("-8400,8425,1338920,2808")
given world_initialize (5):() then mesh_state:("-8400,8425,1338920,2808") then eprints:("")
