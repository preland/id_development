// One coordinate each, so push_xyz (push.id) stays within its own 3-action
// budget while pushing all 3 -- the three bodies read alike but call
// different corner_* functions, so they are not the same logic three times.

push_x(int c) {
  int corner_x_v = corner_x(c);
  push((import verts), corner_x_v);
} return void;

push_y(int c) {
  int corner_y_v = corner_y(c);
  push((import verts), corner_y_v);
} return void;

push_z(int c) {
  int corner_z_v = corner_z(c);
  push((import verts), corner_z_v);
} return void;
