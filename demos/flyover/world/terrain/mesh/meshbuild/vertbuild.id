// Build the flattened vertex position list: 2808 vertex slots (936 triangles
// * 3), 3 milli-unit ints each, in the exact order backends/gl/gl.h's
// gl_draw_tris expects. Mirrors demos/gl3d/scene/mesh/meshbuild/vertbuild.id:
// an exported list, filled by walking a flat slot index.

build_verts() {
  export int[] verts = [];
  fill_verts(0);
} return void;

fill_verts(int slot) {
  while(slot < 2808) {
    push_vertex(slot);
    slot = slot + 1;
  }
} return void;
