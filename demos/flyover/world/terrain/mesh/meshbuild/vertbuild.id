// Build the flattened vertex position list: 2808 vertex slots (936 triangles
// * 3), 3 milli-unit ints each, in the exact order backends/gl/gl.h's
// gl_draw_tris expects. Mirrors demos/gl3d/scene/mesh/meshbuild/vertbuild.id:
// an exported list, filled by walking a flat slot index.

build_vertices() {
  export int[] mesh_positions = [];
  fill_vertices(0);
} return void;
given world_initialize ():() then mesh_state:("-8400,8424,1338920,2808")
given world_initialize ():() then mesh_state:("-8400,8424,1338920,2808") then eprints:("")

fill_vertices(int slot) {
  while(slot < 2808) {
    push_vertex(slot);
    slot = slot + 1;
  }
} return void;
given world_initialize (2808):() then mesh_state:("-8400,8424,1338920,2808")
given world_initialize (2807):() then mesh_state:("-8400,8427,1338920,2808")
