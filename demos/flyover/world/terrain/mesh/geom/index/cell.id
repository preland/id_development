// Decode a flattened mesh "vertex slot" back into a heightmap grid index, the
// same shared-corner trick demos/gl3d/scene/mesh/geom/face.id uses for its
// cube: rather than storing a giant per-triangle vertex list, every one of
// the 936 triangles' 3*936=2808 vertex slots is computed from arithmetic on
// the slot number. There are 12*39=468 quad cells (grid 13 wide, 40 deep);
// slot/6 is the cell (6 vertex-slots per cell: 2 triangles * 3 corners),
// slot%6 picks which of the cell's 4 corners via the tri-of-a-quad table
// [0,1,2, 1,3,2] (corner 0=near-left,1=near-right,2=far-left,3=far-right).

corner_index(int cell, int local) {
  int cgx = cell % 12;
  int cgz = cell / 12;
  int ret_i = corner_from_cell(cgx, cgz, local);
} return int ret_i;

corner_from_cell(int cgx, int cgz, int local) {
  int gx = cgx + local % 2;
  int ret_i = (cgz + local / 2) * 13 + gx;
} return int ret_i;
