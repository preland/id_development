// Maze/world dimensions, centralized so every module (gen, collision,
// rendering, raycast) agrees on the same grid. grid_w/grid_h are ODD (2*N+1):
// even coordinates are always-wall "pillars", odd coordinates are carvable
// room cells or the walls between them -- the classic maze-on-a-grid trick
// (see maze/grid/README below in maze/gen/run.id).
int grid_w = 15;

// Slightly non-square on purpose, giving the maze a less boxy footprint.
int grid_h = 13;

// World-space size of one grid cell, in milli-units (2.0 world units).
int spacing = 2000;

// Wall cube half-extent = half of (import spacing), so wall cubes tile
// seamlessly with no gap and no overlap.
int wall_half = 1000;

// eye_y is the camera's fixed height (dead center of the wall cubes'
// vertical extent -- there's no floor/ceiling distinction, see the README's
// rough edges).
int eye_y = 0;

// move_speed is milli-units of travel per movement key event (WASD).
int move_speed = 70;

// turn_speed: degrees turned per Q/E key event.
int turn_speed = 4;

// num_targets: how many shootable cubes exist at once (respawn.id keeps
// this many alive).
int num_targets = 3;

// shoot_step: the raycast's per-iteration step size, in milli-units.
int shoot_step = 150;
