// ticks() returns word and rnd_init wants an int seed; split out of
// game_init because naming that int local is a third action on top of the
// fetch and the seed call.

seed_rng() {
  word ticks_v = ticks();
  int seed = ticks_v;
  random_initialize(seed);
} return void;
():() then calls random_initialize:[1]
():() then eprints:("")
