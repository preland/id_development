given random_initialize(127772) ():() then calls create_actors:[1] then calls create_scene_meshes:[1] then (import player)[0]:(-12000) then (import wall_vertices)[0]:(-1000)

// The actors turn and shoot along idstd's fx_sin_deg/fx_cos_deg, whose table
// fx_trig_init exports, so it runs before either actor can move.
create_actors() {
  fixed_point_trig_initialize();
  create_player();
  create_targets();
} return void;
