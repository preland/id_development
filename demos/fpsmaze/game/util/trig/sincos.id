// sin_deg/cos_deg: integer sine/cosine (x1000) for any integer degree,
// built from table.id's 0..90 table + quadhelp.id's symmetry. cos(d) is
// just sin(d+90) -- no separate table needed.

sin_deg(int d) {
  int nd = norm_deg(d);
  int q = nd / 90;
  int r = nd % 90;
} return int sin_by_quadrant(q, r);

cos_deg(int d) {
} return int sin_deg(d + 90);

sin_by_quadrant(int q, int r) {
  int v = 0;
  if (q < 2) { v = sin_q01(q, r); } else { v = sin_q23(q, r); }
} return int v;
