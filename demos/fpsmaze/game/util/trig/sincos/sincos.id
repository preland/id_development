// sin_deg/cos_deg: integer sine/cosine (x1000) for any integer degree,
// built from table.id's 0..90 table + quadhelp.id's symmetry. cos(d) is
// just sin(d+90) -- no separate table needed.

sin_deg(int d) {
  int nd = norm_deg(d);
  int ret_i = sin_deg_norm(nd);
} return int ret_i;

cos_deg(int d) {
  int ret_i = sin_deg(d + 90);
} return int ret_i;

sin_deg_norm(int nd) {
  int q = nd / 90;
  int r = nd % 90;
  int ret_i = sin_by_quadrant(q, r);
} return int ret_i;
