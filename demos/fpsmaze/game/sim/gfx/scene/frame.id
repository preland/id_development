// Per-frame matrix setup, then hand off to draw/dispatch.id. Both view and
// projection are rebuilt fresh every frame (never held across frames, since
// the native matrix pool is an unfreed ring buffer -- see
// backends/gl/README.md's "known rough edges").

render(int t) {
  int view = build_view();
  render_proj();
  draw_frame(view);
} return void;

render_proj() {
  int build_proj_v = build_proj();
  gl_set_projection(build_proj_v);
} return void;
