// One-time GPU mesh setup: wall/target cube geometry (the floor is cheap
// enough to rebuild every frame -- see mesh/objects/floor).

create_scene_meshes() {
  create_wall_mesh();
  create_target_mesh();
} return void;
():() then calls create_wall_mesh:[1] then (import wall_vertices)[0]:(-1000)
():() then calls create_target_mesh:[1] then (import target_vertices)[0]:(-400)
