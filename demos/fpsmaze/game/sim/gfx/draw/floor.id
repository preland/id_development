// The floor is a single static world-space plane, so its modelview is just
// `view` itself -- no per-instance translate needed (unlike the wall/target
// cubes in cells/, which are drawn relative to the maze grid).

draw_floor(int view) {
  gl_set_modelview(view);
  draw_floor_tris();
} return void;

draw_floor_tris() {
  int[] floor_verts_v = floor_verts();
  int[] floor_colors_v = floor_colors();
  gl_draw_tris(floor_verts_v, floor_colors_v, 2);
} return void;
