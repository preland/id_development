target_model_view_at_row(int view, int world_x, int target_index) {
  int target_row = (import target_rows)[target_index];
  int world_z = target_row * (import spacing) - ((import grid_height) * (import spacing)) / 2 + (import spacing) / 2;
  int target_placed_matrix = cell_compose(view, world_x, world_z);
} return int target_placed_matrix;
