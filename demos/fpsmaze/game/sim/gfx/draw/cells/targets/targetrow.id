
draw_one_target(int view, int i) {
  int mv = target_mv(view, i);
  gl_set_modelview(mv);
  gl_draw_tris((import target_verts), (import target_colors), 12);
} return void;

target_mv(int view, int i) {
  int tgx_get_v = tgx_get(i);
  int wx = world_x_of_cell(tgx_get_v);
  int ret_i = target_mv_z(view, wx, i);
} return int ret_i;

target_mv_z(int view, int wx, int i) {
  int tgz_get_v = tgz_get(i);
  int wz = world_z_of_cell(tgz_get_v);
  int ret_i = cell_compose(view, wx, wz);
} return int ret_i;
