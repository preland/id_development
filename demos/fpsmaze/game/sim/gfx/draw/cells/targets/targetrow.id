draw_one_target(int view, int i) {
  int mv = target_mv(view, i);
  gl_set_modelview(mv);
  gl_draw_tris((import target_verts), (import target_colors), 12);
} return void;

target_mv(int view, int i) {
  int wx = world_x_of_cell(tgx_get(i));
  int wz = world_z_of_cell(tgz_get(i));
} return int gl_mat_mul(view, gl_mat_translate(wx, 0, wz));
