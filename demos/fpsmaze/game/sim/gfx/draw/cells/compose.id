// Shared by targets/ and walls/: composing a cell's world-space translate
// with the view matrix is identical logic for both kinds of cube (only the
// coordinates differ, and those are already just parameters), so it lives
// here once instead of being duplicated under each.

cell_compose(int view, int wx, int wz) {
  int gl_mat_translate_v = gl_mat_translate(wx, 0, wz);
  int ret_i = gl_mat_mul(view, gl_mat_translate_v);
} return int ret_i;
