// Walk the whole grid, drawing one wall cube per wall cell. Split into two
// nested loop functions (z outer, x inner in wallrow.id) instead of one
// function with a nested while, to stay within the block-nesting-depth-2
// limit and each function's own 3-action budget.

draw_walls(int view) {
  walls_loop_z(view, 0);
} return void;
given create_scene_meshes given create_maze (0):() then calls walls_loop_z:(0, 0)
given create_scene_meshes given create_maze (99):() then calls walls_loop_z:(99, 0)

walls_loop_z(int view, int row) {
  while (row < (import grid_height)) {
    walls_loop_x(view, row, 0);
    row = row + 1;
  }
} return void;
given create_scene_meshes given create_maze (7, 12):() then calls walls_loop_x:(7, 12, 0)
given create_scene_meshes given create_maze (4, 11):() then calls walls_loop_x:(4, 11, 0)
given create_scene_meshes given create_maze (7, 13):() then calls walls_loop_x:[0]

walls_loop_x(int view, int row, int column) {
  while (column < (import grid_width)) {
    draw_wall_if_present(view, column, row);
    column = column + 1;
  }
} return void;
given create_scene_meshes given create_maze (3, 5, 14):() then calls draw_wall_if_present:(3, 14, 5)
given create_scene_meshes given create_maze (4, 6, 13):() then calls draw_wall_if_present:(4, 14, 6)
given create_scene_meshes given create_maze (3, 5, 15):() then calls draw_wall_if_present:[0]
