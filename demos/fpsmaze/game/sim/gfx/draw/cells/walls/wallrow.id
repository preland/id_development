
draw_wall_if_present(int view, int column, int row) {
  if (grid_get(column, row) = 1) { draw_one_wall(view, column, row); }
} return void;
given create_maze given create_scene_meshes (0, 1, 1):() then calls draw_one_wall:(0, 1, 1)
given open_room_setup given create_scene_meshes (0, 2, 1):() then calls draw_one_wall:(0, 2, 1)
given open_room_setup (0, 1, 1):() then calls draw_one_wall:[0]

draw_one_wall(int view, int column, int row) {
  int model_view = wall_model_view(view, column, row);
  gl_set_modelview(model_view);
  gl_draw_tris((import wall_vertices), (import wall_colors), 12);
} return void;
given create_scene_meshes (0, 1, 1):() then calls wall_model_view:(0, 1, 1)
given create_scene_meshes (5, 2, 3):() then calls wall_model_view:(5, 2, 3)

wall_model_view(int view, int column, int row) {
  int world_x = world_x_of_cell(column);
  int world_z = row * (import spacing) - ((import grid_height) * (import spacing)) / 2 + (import spacing) / 2;
  int wall_matrix = cell_compose(view, world_x, world_z);
} return int wall_matrix;
(0, 0, 0):(1) then calls cell_compose:(0, -14000, -12000)
(9, 14, 12):(1) then calls cell_compose:(9, 14000, 12000)
