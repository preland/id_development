
draw_wall_if_present(int view, int x, int z) {
  if (grid_get(x, z) = 1) { draw_one_wall(view, x, z); }
} return void;

draw_one_wall(int view, int x, int z) {
  int mv = wall_mv(view, x, z);
  gl_set_modelview(mv);
  gl_draw_tris((import wall_verts), (import wall_colors), 12);
} return void;

wall_mv(int view, int x, int z) {
  int wx = world_x_of_cell(x);
  int wz = world_z_of_cell(z);
  int ret_i = cell_compose(view, wx, wz);
} return int ret_i;
