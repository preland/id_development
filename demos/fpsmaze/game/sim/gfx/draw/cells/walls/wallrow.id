
draw_wall_if_present(int view, int x, int z) {
  if (grid_get(x, z) = 1) { draw_one_wall(view, x, z); }
} return void;
given maze_init given scene_init (0, 1, 1):() then calls draw_one_wall:(0, 1, 1)
given open_room_setup given scene_init (0, 2, 1):() then calls draw_one_wall:(0, 2, 1)
given open_room_setup (0, 1, 1):() then calls draw_one_wall:[0]

draw_one_wall(int view, int x, int z) {
  int mv = wall_mv(view, x, z);
  gl_set_modelview(mv);
  gl_draw_tris((import wall_verts), (import wall_colors), 12);
} return void;
given scene_init (0, 1, 1):() then calls wall_mv:(0, 1, 1)
given scene_init (5, 2, 3):() then calls wall_mv:(5, 2, 3)

wall_mv(int view, int x, int z) {
  int wx = world_x_of_cell(x);
  int wz = z * (import spacing) - ((import grid_h) * (import spacing)) / 2 + (import spacing) / 2;
  int ret_i = cell_compose(view, wx, wz);
} return int ret_i;
(0, 0, 0):(1) then calls cell_compose:(0, -14000, -12000)
(9, 14, 12):(1) then calls cell_compose:(9, 14000, 12000)
