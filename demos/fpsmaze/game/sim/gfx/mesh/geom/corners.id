// The 8 corners of a cube, indexed 0..7 by bit arithmetic, generalized with
// a `half` half-extent parameter (a milli-unit int) so the same geometry
// builds wall, target, and (if needed) any other cube at different sizes --
// same trick as demos/gl3dgame/world/scene/mesh/geom/corners.id.

corner_x(int i, int half) {
} return int ((i % 2) * 2 - 1) * half;

corner_y(int i, int half) {
} return int (((i / 2) % 2) * 2 - 1) * half;

corner_z(int i, int half) {
} return int (((i / 4) % 2) * 2 - 1) * half;
