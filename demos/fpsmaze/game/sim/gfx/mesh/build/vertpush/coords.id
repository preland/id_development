// push_cube_xyz's y and z coordinate pushes -- x lives in vertpush.id
// itself since that file had room for one more function.

push_cube_y(int[] verts, int half, int c) {
  int corner_y_v = corner_y(c, half);
  push(verts, corner_y_v);
} return void;

push_cube_z(int[] verts, int half, int c) {
  int corner_z_v = corner_z(c, half);
  push(verts, corner_z_v);
} return void;
