// Build the flattened per-vertex color list: one packed 0xRRGGBB int
// repeated for all 36 slots -- every cube this program draws is a single
// flat color, not per-corner gradient shading.

build_cube_colors(int color) {
  int[] cols = [];
  fill_cube_colors(cols, color, 0);
} return int[] cols;

fill_cube_colors(int[] cols, int color, int slot) {
  while (slot < 36) {
    push(cols, color);
    slot = slot + 1;
  }
} return void;
