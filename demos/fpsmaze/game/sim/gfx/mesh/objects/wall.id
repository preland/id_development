// The wall cube's mesh, built once at startup: a slate-gray cube exactly
// (import wall_half)*2 wide, so instances tile with no gap/overlap (conf.id).

init_wall_mesh() {
  int wall_half_v = (import wall_half);
  export int[] wall_verts = d3_cube_verts(wall_half_v);
  export int[] wall_colors = d3_cube_colors(90 * 65536 + 90 * 256 + 110);
} return void;
