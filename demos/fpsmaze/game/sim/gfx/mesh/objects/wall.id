// The wall cube's mesh, built once at startup: a slate-gray cube exactly
// wall_half()*2 wide, so instances tile with no gap/overlap (config/tune.id).

init_wall_mesh() {
  export int[] wall_verts = build_cube_verts(wall_half());
  export int[] wall_colors = build_cube_colors(90 * 65536 + 90 * 256 + 110);
} return void;
