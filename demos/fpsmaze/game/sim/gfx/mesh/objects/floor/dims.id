// The floor is one big quad spanning the whole maze footprint, sitting at
// the bottom of the wall cubes' vertical extent (there's no separate
// floor/ceiling model -- see the README's rough edges).

floor_half_x() {
  int ret_i = ((import grid_w) * (import spacing)) / 2;
} return int ret_i;
():(15000)
():(15000) then floor_half_z:(13000)

floor_half_z() {
  int ret_i = ((import grid_h) * (import spacing)) / 2;
} return int ret_i;
():(13000)
():(13000) then floor_half_x:(15000)

floor_y() {
  int ret_i = 0 - (import wall_half);
} return int ret_i;
():(-1000)
():(-1000) then floor_half_x:(15000)
