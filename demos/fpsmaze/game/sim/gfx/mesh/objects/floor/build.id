// The floor's 2 triangles (6 vertices), built fresh each frame (see
// draw/floor.id) rather than cached -- it's tiny and never changes shape,
// so there's no benefit to exporting it like the wall/target meshes.

floor_verts() {
  int[] verts = [0 - floor_half_x(), floor_y(), 0 - floor_half_z(),
             floor_half_x(), floor_y(), 0 - floor_half_z(),
             floor_half_x(), floor_y(), floor_half_z(),
             0 - floor_half_x(), floor_y(), 0 - floor_half_z(),
             floor_half_x(), floor_y(), floor_half_z(),
             0 - floor_half_x(), floor_y(), floor_half_z()];
} return int[] verts;

floor_colors() {
  int col = floor_color();
  int[] cols = [col, col, col, col, col, col];
} return int[] cols;

floor_color() {
} return int 40 * 65536 + 40 * 256 + 55;
