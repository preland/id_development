// The floor's 2 triangles (6 vertices), built fresh each frame (see
// draw/floor.id) rather than cached -- it's tiny and never changes shape,
// so there's no benefit to exporting it like the wall/target meshes.

floor_vertices() {
  int[] floor_corners = [0 - floor_half((import grid_width)), floor_y(), 0 - floor_half((import grid_height)),
             floor_half((import grid_width)), floor_y(), 0 - floor_half((import grid_height)),
             floor_half((import grid_width)), floor_y(), floor_half((import grid_height)),
             0 - floor_half((import grid_width)), floor_y(), 0 - floor_half((import grid_height)),
             floor_half((import grid_width)), floor_y(), floor_half((import grid_height)),
             0 - floor_half((import grid_width)), floor_y(), floor_half((import grid_height))];
} return int[] floor_corners;
():([-15000, -1000, -13000, 15000, -1000, -13000, 15000, -1000, 13000, -15000, -1000, -13000, 15000, -1000, 13000, -15000, -1000, 13000])
():([-15000, -1000, -13000, 15000, -1000, -13000, 15000, -1000, 13000, -15000, -1000, -13000, 15000, -1000, 13000, -15000, -1000, 13000]) then floor_colors:([2631735, 2631735, 2631735, 2631735, 2631735, 2631735])

floor_colors() {
  int tile_color = floor_color();
  int[] vertex_colors = [tile_color, tile_color, tile_color, tile_color, tile_color, tile_color];
} return int[] vertex_colors;
():([2631735, 2631735, 2631735, 2631735, 2631735, 2631735])
():([2631735, 2631735, 2631735, 2631735, 2631735, 2631735]) then floor_color:(2631735)

floor_color() {
  int floor_rgb = 40 * 65536 + 40 * 256 + 55;
} return int floor_rgb;
():(2631735)
():(2631735) then floor_colors:([2631735, 2631735, 2631735, 2631735, 2631735, 2631735])
