// Append direction i to opts if it's valid, then hand the next i back to
// fill_valid's while loop via the return clause (keeps the loop body itself
// to a single call, one action).

try_add_valid(int[] options, int column, int row, int candidate_direction) {
  if (neighbor_valid(candidate_direction, column, row)) { push(options, candidate_direction); }
  int following_direction = candidate_direction + 1;
} return int following_direction;
given create_maze ([], 1, 1, 0):(1)
given create_maze ([], 1, 1, 1):(2)
