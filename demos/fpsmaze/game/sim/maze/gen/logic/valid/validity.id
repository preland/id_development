// A candidate room cell (nx,nz) is a valid carve target when it's inside
// the grid and still an un-carved wall (grid value 1).

in_bounds(int column, int row) {
  int ok = 1;
  if (column < 0 || column >= (import grid_width) || row < 0 || row >= (import grid_height)) { ok = 0; }
} return int ok;
(14, 12):(1)
(15, 12):(0)

is_unvisited(int column, int row) {
  int unvisited = grid_get(column, row) = 1;
} return int unvisited;
given create_maze (3, 5):(1)
given stack_one_room_setup (3, 5):(0)

check_valid(int column, int row) {
  int cell_valid = in_bounds(column, row) && is_unvisited(column, row);
} return int cell_valid;
given create_maze (3, 5):(1)
given stack_one_room_setup (3, 5):(0)
