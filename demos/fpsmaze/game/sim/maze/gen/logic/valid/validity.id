// the grid and still an un-carved wall (grid value 1).

in_bounds(int x, int z) {
  int ok = 1;
  if (x < 0 || x >= (import grid_w) || z < 0 || z >= (import grid_h)) { ok = 0; }
} return int ok;
(14, 12):(1)
(15, 12):(0)

is_unvisited(int x, int z) {
  int ret_i = grid_get(x, z) = 1;
} return int ret_i;
