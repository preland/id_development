// A candidate room cell (nx,nz) is a valid carve target when it's inside
// the grid and still an un-carved wall (grid value 1).

in_bounds(int x, int z) {
  int ok = 1;
  if (x < 0 || x >= grid_w() || z < 0 || z >= grid_h()) { ok = 0; }
} return int ok;

is_unvisited(int x, int z) {
} return int grid_get(x, z) = 1;

check_valid(int x, int z) {
} return int in_bounds(x, z) && is_unvisited(x, z);
