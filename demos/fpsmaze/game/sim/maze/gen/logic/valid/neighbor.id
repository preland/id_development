// Gather the direction indices (0..3, see core/dirs) that lead to a still
// unvisited room cell from (x,z) -- an empty list here means "dead end,
// backtrack" to genmaze.id's caller.

neighbor_valid(int neighbor_direction, int column, int row) {
  int neighbor_column = column + direction_delta_x(neighbor_direction);
  int neighbor_row = row + direction_delta_z(neighbor_direction);
  int neighbor_ok = check_valid(neighbor_column, neighbor_row);
} return int neighbor_ok;
given create_maze (0, 1, 1):(0)
given create_maze (1, 1, 1):(1)

gather_valid(int column, int row) {
  int[] options = [];
  fill_valid(options, column, row, 0);
} return int[] options;
given create_maze (1, 1):([1, 3])
given create_maze (7, 6):([0, 1, 2, 3])

fill_valid(int[] options, int column, int row, int fill_direction) {
  while (fill_direction < 4) {
    fill_direction = try_add_valid(options, column, row, fill_direction);
  }
} return void;
given create_maze ([], 1, 1, 0):([1, 3])
given create_maze ([], 1, 1, 2):([3])
