// Gather the direction indices (0..3, see core/dirs) that lead to a still
// unvisited room cell from (x,z) -- an empty list here means "dead end,
// backtrack" to run.id's caller.

neighbor_valid(int i, int x, int z) {
  int nx = x + dir_dx(i);
  int nz = z + dir_dz(i);
  int ret_i = check_valid(nx, nz);
} return int ret_i;

gather_valid(int x, int z) {
  int[] opts = [];
  fill_valid(opts, x, z, 0);
} return int[] opts;

fill_valid(int[] opts, int x, int z, int i) {
  while (i < 4) {
    i = try_add_valid(opts, x, z, i);
  }
} return void;
