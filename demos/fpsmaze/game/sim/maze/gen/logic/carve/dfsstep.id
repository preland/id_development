// One DFS step at frontier cell (x,z), given its already-gathered valid
// neighbor directions: no options means a dead end, so backtrack
// (core/stack/query.id's pop_room); otherwise pick one uniformly at random
// and carve into it.

do_step(int x, int z, int[] opts) {
  if (len(opts) = 0) { pop_room(); } else { carve_random(x, z, opts); }
} return void;
given stack_t_full_setup (0, 0, []):() then stack_empty:(1)
given stack_t_empty_setup given random_initialize(1) (3, 5, [0, 1, 2, 3]):() then top_x:(1)

carve_random(int x, int z, int[] opts) {
  int pick = random_next() % len(opts);
  int dir = opts[pick];
  do_carve(x, z, dir);
} return void;
given stack_t_empty_setup given random_initialize(1) (3, 5, [0, 1, 2, 3]):() then top_x:(1)
given stack_t_empty_setup given random_initialize(127772) (3, 5, [0, 1, 2, 3]):() then top_x:(5)

do_carve(int x, int z, int dir) {
  int nx = x + dir_dx(dir);
  int nz = z + dir_dz(dir);
  carve_between(x, z, nx, nz);
} return void;
given stack_t_empty_setup (3, 5, 2):() then top_x:(1)
given stack_t_empty_setup (3, 5, 3):() then top_x:(5)
