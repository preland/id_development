// Knock down the wall cell between (x,z) and (nx,nz) -- the grid coordinate
// exactly halfway between them, since both are 2 apart on one axis -- then
// visit the new room cell.

carve_between(int x, int z, int nx, int nz) {
  int wx = (x + nx) / 2;
  int wz = (z + nz) / 2;
  open_and_push(wx, wz, nx, nz);
} return void;

open_and_push(int wx, int wz, int nx, int nz) {
  grid_set(wx, wz, 0);
  push_room(nx, nz);
} return void;
