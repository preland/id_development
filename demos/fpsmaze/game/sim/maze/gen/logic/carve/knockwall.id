// Knock down the wall cell between (x,z) and (nx,nz) -- the grid coordinate
// exactly halfway between them, since both are 2 apart on one axis -- then
// visit the new room cell.

carve_between(int column, int row, int neighbor_column, int neighbor_row) {
  int wall_column = (column + neighbor_column) / 2;
  int wall_row = (row + neighbor_row) / 2;
  open_and_push(wall_column, wall_row, neighbor_column, neighbor_row);
} return void;
given stack_empty_setup (3, 5, 1, 5):() then top_x:(1)
given stack_empty_setup (3, 5, 5, 5):() then top_x:(5)

open_and_push(int opening_column, int opening_row, int neighbor_column, int neighbor_row) {
  grid_set(opening_column, opening_row, 0);
  push_room(neighbor_column, neighbor_row);
} return void;
given stack_empty_setup (2, 5, 1, 5):() then top_x:(1)
given stack_empty_setup (4, 5, 5, 5):() then top_x:(5)
