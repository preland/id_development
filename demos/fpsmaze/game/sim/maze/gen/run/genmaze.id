// gen_maze: randomized DFS / recursive backtracker over the grid built by
// maze/grid/init.id. Seed the frontier stack at (sx,sz), then repeatedly
// step until the stack empties (every reachable room cell has been visited
// and backtracked out of) -- a full spanning-tree maze with exactly one
// path between any two rooms.

gen_maze(int sx, int sz) {
  gen_state_init(sx, sz);
  run_gen();
} return void;
given maze_init given idstd_rnd_t_setup (1, 1):() then stack_empty:(1)
given maze_init given idstd_rnd_t_setup_neg (1, 1):() then stack_empty:(1)

run_gen() {
  while (stack_empty() = 0) {
    gen_step();
  }
} return void;
given stack_t_full_setup given idstd_rnd_t_setup ():() then stack_empty:(1)
given stack_t_full_setup given idstd_rnd_t_setup_neg ():() then stack_empty:(1)

gen_step() {
  int x = top_x();
  int z = top_z();
  gen_step_at(x, z);
} return void;
given stack_t_full_setup given idstd_rnd_t_setup ():() then top_x:(1)
given stack_t_full_setup given idstd_rnd_t_setup_neg ():() then top_x:(5)
