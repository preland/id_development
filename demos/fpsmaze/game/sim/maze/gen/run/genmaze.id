// gen_maze: randomized DFS / recursive backtracker over the grid built by
// maze/grid/init.id. Seed the frontier stack at (sx,sz), then repeatedly
// step until the stack empties (every reachable room cell has been visited
// and backtracked out of) -- a full spanning-tree maze with exactly one
// path between any two rooms.

carve_maze(int start_column, int start_row) {
  create_carving_state(start_column, start_row);
  run_carving();
} return void;
given create_maze given random_initialize(1) (1, 1):() then stack_empty:(1)
given create_maze given random_initialize(127772) (1, 1):() then stack_empty:(1)

run_carving() {
  while (stack_empty() == 0) {
    carve_step();
  }
} return void;
given stack_one_room_setup given random_initialize(1) ():() then stack_empty:(1)
given stack_one_room_setup given random_initialize(127772) ():() then stack_empty:(1)

carve_step() {
  int column = list_last((import stack_columns));
  int row = list_last((import stack_rows));
  carve_step_at(column, row);
} return void;
given stack_one_room_setup given random_initialize(1) ():() then top_x:(1)
given stack_one_room_setup given random_initialize(127772) ():() then top_x:(5)
