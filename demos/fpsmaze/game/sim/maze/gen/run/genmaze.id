// gen_maze: randomized DFS / recursive backtracker over the grid built by
// maze/grid/init.id. Seed the frontier stack at (sx,sz), then repeatedly
// step until the stack empties (every reachable room cell has been visited
// and backtracked out of) -- a full spanning-tree maze with exactly one
// path between any two rooms.

gen_maze(int sx, int sz) {
  gen_state_init(sx, sz);
  run_gen();
} return void;
given maze_init given rnd_init(1) (1, 1):() then stack_empty:(1)
given maze_init given rnd_init(127772) (1, 1):() then stack_empty:(1)

run_gen() {
  while (stack_empty() = 0) {
    gen_step();
  }
} return void;
given stack_t_full_setup given rnd_init(1) ():() then stack_empty:(1)
given stack_t_full_setup given rnd_init(127772) ():() then stack_empty:(1)

gen_step() {
  int x = lst_last((import stackx));
  int z = lst_last((import stackz));
  gen_step_at(x, z);
} return void;
given stack_t_full_setup given rnd_init(1) ():() then top_x:(1)
given stack_t_full_setup given rnd_init(127772) ():() then top_x:(5)
