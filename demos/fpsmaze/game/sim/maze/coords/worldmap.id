// Grid cell -> world-space milli-unit coordinate (centered maze: grid cell 0
// maps to the most-negative world coordinate, so the maze straddles world
// origin instead of sitting entirely in positive space). x and z use grid_w
// and grid_h respectively since the grid isn't square (conf.id).

world_x_of_cell(int gx) {
  int ret_i = gx * (import spacing) - ((import grid_w) * (import spacing)) / 2 + (import spacing) / 2;
} return int ret_i;

world_z_of_cell(int gz) {
  int ret_i = gz * (import spacing) - ((import grid_h) * (import spacing)) / 2 + (import spacing) / 2;
} return int ret_i;
