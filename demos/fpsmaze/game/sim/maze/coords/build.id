// The maze module's single entry point: allocate the all-wall grid, then
// carve it starting from room (1,1) (grid coordinates -- always odd/odd,
// see conf.id's grid_w/grid_h comment).

maze_build() {
  maze_init();
  gen_maze(1, 1);
} return void;
