// Read/write one grid cell. grid_set uses the generic lset "store into an
// imported list" idiom (see demos/gl3dgame/world/game/state/mutate.id):
// passing the imported list as a parameter makes it an assignable identifier
// again, and lists are reference-semantic so the store is shared.

grid_get(int x, int z) {
} return int (import mgrid)[grid_index(x, z)];

grid_set(int x, int z, int v) {
  lset((import mgrid), grid_index(x, z), v);
} return void;

lset(int[] xs, int i, int v) {
  xs[i] = v;
} return void;
