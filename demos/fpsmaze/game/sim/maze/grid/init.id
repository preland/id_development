// Allocate the grid, every cell starting as wall (1); maze/gen carves it
// into a maze afterwards.

maze_init() {
  export int[] mgrid = build_all_walls();
} return void;

build_all_walls() {
  int[] g = [];
  fill_walls(g, 0);
} return int[] g;

fill_walls(int[] g, int i) {
  while (i < grid_w() * grid_h()) {
    push(g, 1);
    i = i + 1;
  }
} return void;
