// Target state: num_targets() shootable cubes, stored as parallel exported
// lists of GRID cell coordinates (not world milli-units -- targets always
// sit exactly on a room cell, see spawn/rand.id).

targets_init() {
  export int[] tgx = [];
  export int[] tgz = [];
  fill_targets(0);
} return void;

tgx_get(int i) {
  int ret_i = (import tgx)[i];
} return int ret_i;

tgz_get(int i) {
  int ret_i = (import tgz)[i];
} return int ret_i;
