// Target state: (import num_targets) shootable cubes, stored as parallel exported
// lists of GRID cell coordinates (not world milli-units -- targets always
// sit exactly on a room cell, see spawn/rand.id).

targets_init() {
  export int[] tgx = [];
  export int[] tgz = [];
  fill_targets(0);
} return void;
given idstd_rnd_t_setup ():() then calls fill_targets:(0)
given idstd_rnd_t_setup_neg ():() then calls fill_targets:(0)

