// Move target `i` to a fresh random room cell (reuses maze/grid/access.id's
// generic lset -- same helper, not a redefinition).

respawn_target(int i) {
  respawn_x(i);
  respawn_z(i);
} return void;
given idstd_rnd_t_setup given targets_init (0):() then calls respawn_x:(0)
given idstd_rnd_t_setup given targets_init (1):() then calls respawn_z:(1)

respawn_x(int i) {
  int rand_room_x_v = rand_room_x();
  lset((import tgx), i, rand_room_x_v);
} return void;
given idstd_rnd_t_setup given targets_init (0):() then calls rand_room_x:[1]
given idstd_rnd_t_setup given targets_init (0):() then calls rnd_next:[1]

respawn_z(int i) {
  int rand_room_z_v = rand_room_z();
  lset((import tgz), i, rand_room_z_v);
} return void;
given idstd_rnd_t_setup given targets_init (0):() then calls rand_room_z:[1]
given idstd_rnd_t_setup given targets_init (0):() then calls rnd_next:[1]
