// Move target `i` to a fresh random room cell (reuses maze/grid/access.id's
// generic lset -- same helper, not a redefinition).

respawn_target(int i) {
  respawn_axis(i, (import grid_w), (import tgx));
  respawn_axis(i, (import grid_h), (import tgz));
} return void;
given random_initialize(1) given targets_init (0):() then calls respawn_axis:(0, 15, (import tgx))
given random_initialize(1) given targets_init (1):() then calls respawn_axis:(1, 13, (import tgz))

respawn_axis(int i, int cells, int[] pos) {
  int rand_room_v = rand_room(cells);
  lset(pos, i, rand_room_v);
} return void;
given random_initialize(1) given targets_init (0, 15, (import tgx)):() then calls rand_room:(15)
given random_initialize(1) given targets_init (0, 13, (import tgz)):() then calls random_next:[1]
