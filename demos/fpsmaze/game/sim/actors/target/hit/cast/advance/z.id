// The z half of ray_advance's DDA step (advance.id): -cos(yaw) is the
// shooter's local z-direction, the same forward vector player movement uses
// (player/move/vec/fwd.id).

ray_advance_z() {
  int rc_get_v2 = (import rc)[1];
  int ps_get_v2 = ps_get(2);
  ray_advance_z_apply(rc_get_v2, ps_get_v2);
} return void;
given player_init given fx_trig_init given rc_setup ():() then calls lset:((import rc), 1, 1850)
given player_init given fx_trig_init given rc_setup ():() then calls fx_cos_deg:(0)

ray_advance_z_apply(int rc_get_v2, int ps_get_v2) {
  int cos_deg_v = fx_cos_deg(ps_get_v2);
  int shoot_step_v2 = (import shoot_step);
  lset((import rc), 1, (rc_get_v2 + (0 - cos_deg_v) * shoot_step_v2 / 1000));
} return void;
given fx_trig_init given rc_setup (2000, 0):() then calls lset:((import rc), 1, 1850)
given fx_trig_init given rc_setup (2000, 90):() then calls fx_cos_deg:(90)
