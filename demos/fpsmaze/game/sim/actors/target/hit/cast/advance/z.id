// The z half of ray_advance's DDA step (advance.id): -cos(yaw) is the
// shooter's local z-direction, the same forward vector player movement uses
// (player/move/vec/fwd.id).

ray_advance_z() {
  int rc_get_v2 = (import rc)[1];
  int ps_get_v2 = (import ps)[2];
  ray_advance_z_apply(rc_get_v2, ps_get_v2);
} return void;
given player_init given fixed_point_trig_initialize given rc_setup ():() then calls lset:((import rc), 1, 1850)
given player_init given fixed_point_trig_initialize given rc_setup ():() then calls fixed_point_cos_degrees:(0)

ray_advance_z_apply(int ray_z_pos, int ray_yaw_deg) {
  int cos_deg_v = fixed_point_cos_degrees(ray_yaw_deg);
  int shoot_step_v2 = (import shoot_step);
  lset((import rc), 1, (ray_z_pos + (0 - cos_deg_v) * shoot_step_v2 / 1000));
} return void;
given fixed_point_trig_initialize given rc_setup (2000, 0):() then calls lset:((import rc), 1, 1850)
given fixed_point_trig_initialize given rc_setup (2000, 90):() then calls fixed_point_cos_degrees:(90)
