// Fixture for cases needing raycast state (rc) already initialized:
// ray_init takes parameters, so no zero-argument given can reach it
// directly -- this wraps it with concrete literals.

ray_setup() {
  create_ray(1000, 2000);
} return void;
():() then calls create_ray:(1000, 2000)
given ray_setup given integer_list_set((import ray), 3, 1) ():() then ray_state_text:("x=1000 z=2000 steps=0 done=0")
():() then calls create_ray:[1]
