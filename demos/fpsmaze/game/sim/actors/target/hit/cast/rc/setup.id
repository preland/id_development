// Fixture for cases needing raycast state (rc) already initialized:
// ray_init takes parameters, so no zero-argument given can reach it
// directly -- this wraps it with concrete literals.

rc_setup() {
  ray_init(1000, 2000);
} return void;
():() then calls ray_init:(1000, 2000)
given rc_setup given lset((import rc), 3, 1) ():() then rc_state:("x=1000 z=2000 steps=0 done=0")
():() then calls ray_init:[1]
