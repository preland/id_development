// shoot(): the space-bar action (see game/sim/actors/input/shoot.id). Walks
// an integer DDA ray from the player's position along their facing
// direction, one (import shoot_step) at a time, up to 60 steps (60*150 = 9000
// milli-units, comfortably past the maze's far corner), stopping the
// instant it hits a target or a wall.

shoot() {
  int ps_get_v = (import ps)[0];
  int ps_get_v2 = (import ps)[1];
  shoot_at(ps_get_v, ps_get_v2);
} return void;
given game_init ():() then calls shoot_at:(-12000, -10000)
given game_init given integer_list_set((import ps), 0, 500) ():() then calls shoot_at:(500, -10000)

shoot_at(int x, int z) {
  ray_init(x, z);
  ray_loop();
} return void;
given game_init (500, 700):() then calls ray_init:(500, 700)
given game_init (300, 400):() then calls ray_init:(300, 400)
given game_init (0, 0):() then calls ray_loop:[1]

// yaw stays 0 the whole walk (advance.id never touches ps), so rc(0) never
// moves off cell_x=8 -- an even (pillar) column -- and by the time rc(1) has
// walked far enough for cell_z to become even too, that cell is guaranteed
// wall, so the loop is certain to set rc(3)=1 and stop well before the
// 60-step cap, whatever the real maze carve looked like.
ray_loop() {
  while ((import rc)[2] < 60 && (import rc)[3] = 0) {
    ray_advance();
    ray_check_stop();
  }
} return void;
