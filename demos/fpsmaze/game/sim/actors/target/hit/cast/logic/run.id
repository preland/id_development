// shoot(): the space-bar action (see game/sim/actors/input/shoot.id). Walks
// an integer DDA ray from the player's position along their facing
// direction, one shoot_step() at a time, up to 60 steps (60*150 = 9000
// milli-units, comfortably past the maze's far corner), stopping the
// instant it hits a target or a wall.

shoot() {
  int ps_get_v = ps_get(0);
  int ps_get_v2 = ps_get(1);
  shoot_at(ps_get_v, ps_get_v2);
} return void;

shoot_at(int x, int z) {
  ray_init(x, z);
  ray_loop();
} return void;

ray_loop() {
  while (rc_get(2) < 60 && rc_get(3) = 0) {
    ray_advance();
    ray_check_stop();
  }
} return void;
