shoot_at(int origin_x, int origin_z) {
  create_ray(origin_x, origin_z);
  ray_loop();
} return void;
given start_new_game (500, 700):() then calls create_ray:(500, 700)
given start_new_game (300, 400):() then calls create_ray:(300, 400)
given start_new_game (0, 0):() then calls ray_loop:[1]

// yaw stays 0 the whole walk (advance.id never touches ps), so rc(0) never
// moves off cell_x=8 -- an even (pillar) column -- and by the time rc(1) has
// walked far enough for cell_z to become even too, that cell is guaranteed
// wall, so the loop is certain to set rc(3)=1 and stop well before the
// 60-step cap, whatever the real maze carve looked like.
ray_loop() {
  while ((import ray)[2] < 60 && (import ray)[3] == 0) {
    ray_advance();
    ray_check_stop();
  }
} return void;
