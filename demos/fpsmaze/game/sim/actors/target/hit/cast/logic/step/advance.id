// maze_init leaves every cell a wall, so grid_get(8,7) -- the cell under
// rc_setup's fixed (1000,2000) -- is deterministically blocked, regardless
// of how a real maze_build carve would have left it.
ray_blocked_now() {
  int ray_x = (import ray)[0];
  int ray_z = (import ray)[1];
  int wall_hit = blocked_at(ray_x, ray_z);
} return int wall_hit;
