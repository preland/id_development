// cell_x(1000) is always 8, an even (pillar) column, and target x-coordinates
// are always odd (spawn/rand.id) -- so no target can ever sit there, and
// ray_hit_now() at this rc is deterministically 0 no matter how the maze or
// the target list were randomized.
ray_hit_now() {
  int ray_x = (import ray)[0];
  int probe_column = cell_x(ray_x);
  int target_hit = ray_hit_now_z(probe_column);
} return int target_hit;
