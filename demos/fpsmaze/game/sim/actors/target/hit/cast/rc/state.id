// The raycast's own tiny state list `rc`, re-initialized fresh on every
// shot (see logic/run.id's shoot()): 0=x, 1=z (world milli-units, walked
// forward step by step), 2=steps taken, 3=done flag (hit a wall or a
// target).

ray_init(int x, int z) {
  export int[] rc = [x, z, 0, 0];
} return void;
(1000, 2000):() then rc_x:(1000)
(555, 999):() then rc_z:(999)

rc_get(int i) {
  int ret_i = (import rc)[i];
} return int ret_i;
given rc_setup (0):(1000)
given rc_setup (3):(0)

rc_set(int i, int v) {
  lset((import rc), i, v);
} return void;
given rc_setup (0, 42):() then rc_x:(42)
given rc_setup (1, 77):() then rc_z:(77)
