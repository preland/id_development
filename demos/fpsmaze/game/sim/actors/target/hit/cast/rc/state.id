// The raycast's own tiny state list `rc`, re-initialized fresh on every
// shot (see logic/run.id's shoot()): 0=x, 1=z (world milli-units, walked
// forward step by step), 2=steps taken, 3=done flag (hit a wall or a
// target).

create_ray(int start_x, int start_z) {
  export int[] ray = [start_x, start_z, 0, 0];
} return void export ray;
(1000, 2000):() then (import ray)[0]:(1000)
(555, 999):() then (import ray)[1]:(999)

