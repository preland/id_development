// Zero-argument witnesses for rc's two fixed fields (used as `then` checks
// elsewhere, since rc_get itself takes a parameter and can't be one).

rc_x() {
  int r = rc_get(0);
} return int r;
given rc_setup ():(1000)
given rc_setup ():(1000) then rc_z:(2000)

rc_z() {
  int r = rc_get(1);
} return int r;
given rc_setup ():(2000)
given rc_setup ():(2000) then rc_x:(1000)
