ray_advance_x_apply(int ray_x_position, int ray_yaw_degrees) {
  int sine_value = fixed_point_sin_degrees(ray_yaw_degrees);
  int x_step_length = (import shoot_step);
  integer_list_set((import ray), 0, (ray_x_position + (0 - sine_value) * x_step_length / 1000));
} return void;
