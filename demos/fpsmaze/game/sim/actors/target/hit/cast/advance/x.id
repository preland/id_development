// The x half of ray_advance's DDA step (advance.id): -sin(yaw) is the
// shooter's local x-direction, frozen at the yaw the shot was fired at.

ray_advance_x() {
  int rc_get_v = (import rc)[0];
  int ps_get_v = (import ps)[2];
  ray_advance_x_apply(rc_get_v, ps_get_v);
} return void;
given player_init given fixed_point_trig_initialize given rc_setup ():() then calls integer_list_set:((import rc), 0, 1000)
given player_init given fixed_point_trig_initialize given rc_setup ():() then calls fixed_point_sin_degrees:(0)

ray_advance_x_apply(int ray_x_pos, int ray_yaw_deg) {
  int sin_deg_v = fixed_point_sin_degrees(ray_yaw_deg);
  int shoot_step_v = (import shoot_step);
  integer_list_set((import rc), 0, (ray_x_pos + (0 - sin_deg_v) * shoot_step_v / 1000));
} return void;
given fixed_point_trig_initialize given rc_setup (1000, 0):() then calls integer_list_set:((import rc), 0, 1000)
given fixed_point_trig_initialize given rc_setup (1000, 90):() then calls integer_list_set:((import rc), 0, 850)
