// try_hit(cx,cz): if a target sits there, score it and respawn it
// elsewhere, returning 1; otherwise 0 (and no side effect).

try_hit(int cx, int cz) {
  int idx = find_target_at(cx, cz);
  int did = apply_hit(idx);
} return int did;
