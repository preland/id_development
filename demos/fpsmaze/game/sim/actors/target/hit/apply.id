// try_hit(cx,cz): if a target sits there, score it and respawn it
// elsewhere, returning 1; otherwise 0 (and no side effect).

try_hit(int cell_column, int cell_row) {
  int hit_target_index = find_target_at(cell_column, cell_row);
  int did = apply_hit(hit_target_index);
} return int did;
