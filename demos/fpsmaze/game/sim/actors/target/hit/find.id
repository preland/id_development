// Is any target sitting at grid cell (cx,cz)? Returns its index, or -1.
// Only (import num_targets) (3) entries, so a full linear scan every call is
// cheap -- no need to short-circuit the loop.

find_target_at(int cx, int cz) {
  int found = scan_loop(cx, cz, 0, 0 - 1);
} return int found;
given game_init (0, 0):(-1)
given random_initialize(1) given targets_init (1, 5):(0)

scan_loop(int cx, int cz, int i, int found) {
  while (i < (import num_targets)) {
    found = check_one(cx, cz, i, found);
    i = i + 1;
  }
} return int found;
given game_init (0, 0, 0, -1):(-1)
(0, 0, 3, -1):(-1)

check_one(int cx, int cz, int i, int found) {
  int f = found;
  if ((import tgx)[i] = cx && (import tgz)[i] = cz) { f = i; }
} return int f;
given game_init (0, 0, 0, -1):(-1)
given random_initialize(1) given targets_init (1, 5, 0, -1):(0)
