
strafe_left() {
  int right_dx_v = right_dx();
  int right_dz_v = right_dz();
  try_apply_delta(0 - right_dx_v, 0 - right_dz_v);
} return void;
given player_init given maze_init given fx_trig_init ():() then ps_x:(-12000)
given open_room_setup given fx_trig_init ():() then ps_x:(-12070)

strafe_right() {
  int right_dx_v = right_dx();
  int right_dz_v = right_dz();
  try_apply_delta(right_dx_v, right_dz_v);
} return void;
given player_init given maze_init given fx_trig_init ():() then ps_x:(-12000)
given open_room_setup given fx_trig_init ():() then ps_x:(-11930)

// Test check: the player's world-x (see state.id's index layout), read
// through a zero-argument wrapper since ps_get itself takes an index and
// 'then' checks take none.
ps_x() {
  int ret_i = ps_get(0);
} return int ret_i;
given player_init ():(-12000)
given open_room_setup given fx_trig_init given strafe_right ():(-11930)
