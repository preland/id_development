// The forward-vector, derived so that a world point at camPos + forward*d
// lands on the camera's -Z axis after view = rotate_y(-yaw)*translate(-cam)
// (see ../../../../gfx/frame.id and the README's derivation): forward =
// (-sin(yaw), -cos(yaw)). Scaled by (import move_speed) and divided back
// down so the result is a milli-unit step per key event.

fwd_dx() {
  int ps_get_v = ps_get(2);
  int ret_i = (0 - fx_sin_deg(ps_get_v)) * (import move_speed) / 1000;
} return int ret_i;

fwd_dz() {
  int ps_get_v = ps_get(2);
  int ret_i = (0 - fx_cos_deg(ps_get_v)) * (import move_speed) / 1000;
} return int ret_i;
