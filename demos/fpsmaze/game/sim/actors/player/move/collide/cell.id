// Is the grid cell under world point (wx,wz) a wall? Used to block movement
// (see apply.id) -- the player is treated as a point, not an AABB (a scope
// cut noted in the README).

blocked_at(int wx, int wz) {
  int cell_x_v = cell_x(wx);
  int cell_z_v = cell_z(wz);
  int ret_i = grid_get(cell_x_v, cell_z_v) = 1;
} return int ret_i;
