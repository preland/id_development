// Is the grid cell under world point (wx,wz) a wall? Used to block movement
// (see apply.id) -- the player is treated as a point, not an AABB (a scope
// cut noted in the README).

blocked_at(int world_x, int world_z) {
  int probe_column = cell_x(world_x);
  int probe_row = (world_z + ((import grid_height) * (import spacing)) / 2) / (import spacing);
  int is_blocked = grid_get(probe_column, probe_row) == 1;
} return int is_blocked;
