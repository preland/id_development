// Q/E turning (see game/sim/actors/input): adjust yaw by turn_speed()
// degrees and fold back into 0..359 (game/util/trig/table.id's norm_deg).

turn_left() {
  ps_set(2, norm_deg(ps_get(2) - turn_speed()));
} return void;

turn_right() {
  ps_set(2, norm_deg(ps_get(2) + turn_speed()));
} return void;
