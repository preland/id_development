turn_by(int delta) {
  int scaled_degrees = ((import player)[2] + delta) * (import degree_scale);
  int folded_degrees = fixed_point_norm_degrees(scaled_degrees);
  integer_list_set((import player), 2, folded_degrees / (import degree_scale));
} return void;
