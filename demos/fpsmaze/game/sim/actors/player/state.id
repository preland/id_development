// Player state: one exported list `ps`, indexed by:
//   0: x (world milli-units)   1: z (world milli-units)
//   2: yaw (integer degrees, 0..359 -- see game/util/trig)   3: score
// Spawned at the center of maze room (1,1) (see maze/build.id), facing yaw 0.

create_player() {
  export int[] player = [world_x_of_cell(1), (import spacing) -((import grid_height) * (import spacing)) / 2 + (import spacing) / 2, 0, 0];
} return void export player;
():() then (import player)[0]:(-12000) then (import player)[1]:(-10000)
():() then (import player)[2]:(0)
