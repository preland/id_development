// Player state: one exported list `ps`, indexed by:
//   0: x (world milli-units)   1: z (world milli-units)
//   2: yaw (integer degrees, 0..359 -- see game/util/trig)   3: score
// Spawned at the center of maze room (1,1) (see maze/build.id), facing yaw 0.

player_init() {
  export int[] ps = [world_x_of_cell(1), 1 * (import spacing) - ((import grid_h) * (import spacing)) / 2 + (import spacing) / 2, 0, 0];
} return void;
():() then ps_x:(-12000) then ps_z:(-10000)
():() then ps_yaw:(0)

ps_get(int i) {
  int ret_i = (import ps)[i];
} return int ret_i;
given player_init (0):(-12000)
given player_init (2):(0)

ps_set(int i, int v) {
  lset((import ps), i, v);
} return void;
given player_init (0, 500):() then ps_x:(500)
given player_init (1, 999):() then ps_z:(999)
