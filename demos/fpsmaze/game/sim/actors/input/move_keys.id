// w=119 forward, s=115 back, a=97 strafe left, d=100 strafe right.

try_move_forward(int event_code) {
  if (event_code = 119) { move_forward(); } else if (event_code = 115) { move_backward(); }
} return void;
given open_room_setup given fixed_point_trig_initialize (119):() then calls move_forward:()
given open_room_setup given fixed_point_trig_initialize (115):() then calls move_backward:()

try_move_strafe(int event_code) {
  if (event_code = 97) { strafe_left(); } else if (event_code = 100) { strafe_right(); }
} return void;
given open_room_setup given fixed_point_trig_initialize (97):() then calls strafe_left:()
given open_room_setup given fixed_point_trig_initialize (100):() then calls strafe_right:()
