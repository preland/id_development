// One key event -> game effect. Key codes are raw ASCII from XLookupString
// (backends/gl/gl_linux.c), same convention demos/gl3dgame's input/keys.id
// uses -- arrow keys don't reach `id` at all (XLookupString returns no
// string for them), so turning uses Q/E instead, per the backend's own
// limitation.

apply_input_key(int event_code) {
  try_move(event_code);
  try_turn(event_code);
  try_shoot(event_code);
} return void;
given open_room_setup given fixed_point_trig_initialize (119):() then calls move_forward:()
given create_player (113):() then calls turn_left:()

try_move(int event_code) {
  try_move_forward(event_code);
  try_move_strafe(event_code);
} return void;
given open_room_setup given fixed_point_trig_initialize (119):() then calls move_forward:()
given open_room_setup given fixed_point_trig_initialize (97):() then calls strafe_left:()

// q=113 turn left, e=101 turn right.
try_turn(int event_code) {
  if (event_code == 113) { turn_left(); } else if (event_code == 101) { turn_right(); }
} return void;
given create_player (113):() then calls turn_left:()
given create_player (101):() then calls turn_right:()
