// The frame loop: same shape as demos/gl3dgame/loop/loop.id. spin ticks
// until a frame reports the window wants to close.

// `ok` is threaded into the loop's live flag rather than discarded: with no
// display glwin_open returns 0 and glwin_poll then returns -1 forever, so a loop
// that starts unconditionally never ends. Every windowed demo in this tree had
// that bug -- `DISPLAY= ./prog` ran until it was killed.
loop(int ok) {
  spin(ok, 0);
  glwin_close();
} return void;
(0):() then calls spin:(0, 0)
(-1):() then calls spin:(-1, 0)

spin(int run, int frame_number) {
  while (run > 0) {
    run = frame(frame_number);
    sleep_ms(16);
    frame_number = frame_number + 1;
  }
} return void;
(0, 0):() then calls frame:[0]
(-1, 5):() then calls frame:[0]
