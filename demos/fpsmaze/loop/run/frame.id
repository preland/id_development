// One frame: drain every buffered input event (see input/drain.id -- the
// backend can queue more than one key between frames), advance/render the
// scene, then an occasional status line.

frame(int t) {
  int alive = drain_input();
  render(t);
  maybe_report(t);
} return int alive;
