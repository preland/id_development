// -2 = quit (close button or GFX_MAX_FRAMES), 27 = Esc: either stops the
// loop. Anything else is a game key (game/sim/actors/input/dispatch.id).

handle_event(int event_code, int alive) {
  int still_alive = alive;
  if (event_code = 0 - 2 || event_code = 27) { still_alive = 0; } else { apply_input_key(event_code); }
} return int still_alive;
(-2, 1):(0)
(27, 1):(0)
(0, 1):(1) then calls apply_input_key:(0)
