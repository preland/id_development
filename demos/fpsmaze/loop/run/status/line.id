// The status line itself: split from print_status because the cell lookup,
// the raw xz/yaw/score reads, and the final print together run past one
// block's 3-action budget.

status_rest(int x, int z) {
  int cx = cell_x(x);
  int cz = (z + ((import grid_h) * (import spacing)) / 2) / (import spacing);
  status_line(x, z, cx, cz);
} return void;
given player_init (-12000, -10000):() then calls status_line:(-12000, -10000, 1, 1)
given player_init (0, 0):() then calls status_line:(0, 0, 7, 6)

status_line(int x, int z, int cx, int cz) {
  int yaw = ps_get(2);
  int score = ps_get(3);
  print("cell=(" + cx + "," + cz + ") xz=(" + x + "," + z + ") yaw=" + yaw
    + " score=" + score);
} return void;
given player_init (-12000, -10000, 1, 1):() then prints:("cell=(1,1) xz=(-12000,-10000) yaw=0 score=0\n")
given player_init (0, 0, 7, 6):() then prints:("cell=(7,6) xz=(0,0) yaw=0 score=0\n")
