// A throttled status line (once a second at ~60fps) so a headless run shows
// real game state on stdout (id has no separate stderr print builtin).

maybe_report(int t) {
  if (t % 60 = 0) { print_status(); }
} return void;
given player_init (0):() then calls print_status:()
given player_init (1):() then calls print_status:[0]
given player_init (60):() then calls print_status:[1]

print_status() {
  int x = ps_get(0);
  int z = ps_get(1);
  status_rest(x, z);
} return void;
given player_init ():() then calls status_rest:(-12000, -10000)
given player_init ():() then prints:("cell=(1,1) xz=(-12000,-10000) yaw=0 score=0\n")
