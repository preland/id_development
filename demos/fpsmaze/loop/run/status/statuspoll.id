// A throttled status line (once a second at ~60fps) so a headless run shows
// real game state on stdout (id has no separate stderr print builtin).

maybe_report(int t) {
  if (t % 60 = 0) { print_status(); }
} return void;

print_status() {
  int x = ps_get(0);
  int z = ps_get(1);
  status_rest(x, z);
} return void;
