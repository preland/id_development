//main fn is the default entrypoint of an executable
main(int argc, string[] argv) {
  if(argc != 2) {
    print("usage: " + argv[0] + " <message>");
  } else {
    print("hello world: " + argv[1])
  }
} return int 0; // return does not contribute to action limit
(1, ["prog"]):(0) then prints:("usage: prog <message>\n")
(2, ["prog", "hi"]):(0) then prints:("hello world: hi\n")

//a variable name may recur across functions but must keep one type;
//exported names are reserved globally
testfn() {
  otherfn();
  //variables are only globally accessible if export/import is used
  //otherwise, the usage is a compiler error
  export int value = main(2, ["hello_world", "hi"]);
  string result = processresult();
} return string result;
():("nominal performance") then prints:("otherfn was called\nhello world: hi\n")
():("nominal performance") then calls otherfn:()

processresult() {
  string processed = "";
  if((import value) = 0) {
    processed = "nominal performance";
  } else {
    processed = "error detected";
  }
} return string processed; // in the case of a void function, this would be "return void;"
