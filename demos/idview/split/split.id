
scan_files(string src, int i) {
  while(i < len(src)) {
    i = take_line(src, i);
  }
} return void;

take_line(string src, int i) {
  int e = line_end(src, i);
  handle_line(src, i, e);
  int ret_i = e + 1;
} return int ret_i;

// Only marker lines matter; everything else is body text, already covered by
// the offsets recorded when its file was opened.
handle_line(string src, int i, int e) {
  if(is_marker(src, i)) {
    open_file(src, i, e);
  }
} return void;
