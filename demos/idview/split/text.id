
line_end(string src, int i) {
  while(charat(src, i) != 10 && charat(src, i) != 0 - 1) {
    i = i + 1;
  }
} return int i;

slice_str(string src, int a, int b) {
  string out = "";
  while(a < b) {
    int charat_v = charat(src, a);
    out = out + chr(charat_v);
    a = a + 1;
  }
} return string out;

// A marker is "#file " at the start of a line. 35 is '#', 102 is 'f'.
is_marker(string src, int i) {
  int ok = 0;
  if(charat(src, i) == 35 && charat(src, i + 1) == 102) {
    ok = 1;
  }
} return int ok;
