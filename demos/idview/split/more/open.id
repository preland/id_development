// A file's body runs from just past its marker line to the start of the next
// marker, so opening one closes the previous.
open_file(string src, int i, int e) {
  close_last(i);
  register_file(src, i, e);
} return void;

close_last(int e) {
  if(len((import ends)) < len((import paths))) {
    push((import ends), e);
  }
} return void;

print_file(string src, int k) {
  print("==== " + (import paths)[k]);
  print_body(src, k);
} return void;
