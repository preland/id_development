// open_file already spends its 3 actions closing the previous file and
// naming the new path, so recording its start/end offsets is a tail call.
// is_marker checks only "#f", so a marker line can be shorter than the 6-byte
// "#file " prefix; holding the path's start at e names such a file "".
register_file(string src, int i, int e) {
  int start_v = fx_min(i + 6, e);
  register_path(src, start_v, e);
} return void;
given init_view ("#file a.id\n", 0, 10):() then iv_path_start:("a.id,11")
given init_view ("#f\n", 0, 2):() then iv_path_start:(",3")

// print_file already spends its 3 actions on the header line, so the blank
// line and the body slice/print are a tail call. A marker on the last line with
// no newline after it records a start one past the end of the input; holding
// the start at the end makes that body "".
print_body(string src, int k) {
  print("");
  int start_v = fx_min((import starts)[k], (import ends)[k]);
  print_span(src, start_v, (import ends)[k]);
} return void;
given iv2_setup ("#file a.id\nBODY\nTAIL", 0):() then prints:("\nBODY\n")
given iv2_setup ("#file a.id\nHELLO\nZZZZ", 0):() then prints:("\nHELLO")

// rnd()'s own second-call case: seeded, then already advanced one call, so a
// further call proves the state persists instead of resetting each time.
iv_rnd_seed7_primed() {
  iv_rnd_init(7);
  rnd();
} return void;
():() then rnd:(2052263231)
