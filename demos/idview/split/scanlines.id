
scan_files(string src, int i) {
  while(i < len(src)) {
    i = take_line(src, i);
  }
} return void;
given init_view ("hello\nworld\n", 0):() then iv_len:(0)
given init_view ("#file a.id\nbody\n", 0):() then iv_len:(1)

take_line(string src, int i) {
  int e = str_eol(src, i);
  handle_line(src, i, e);
  int ret_i = e + 1;
} return int ret_i;
given init_view ("hello\n", 0):(6)
given init_view ("#file a.id\nbody", 0):(11)

// Only marker lines matter; everything else is body text, already covered by
// the offsets recorded when its file was opened.
handle_line(string src, int i, int e) {
  if(is_marker(src, i)) {
    open_file(src, i, e);
  }
} return void;
given init_view ("#file a.id\n", 0, 10):() then iv_len:(1)
given init_view ("hello\n", 0, 5):() then iv_len:(0)
