// idview -- show a randomly chosen `id` source file.
//
// `id` has no filesystem access, so the file *set* arrives on stdin: the
// driver (tools/idview.sh) concatenates every .id file with a `#file <path>`
// marker between them, exactly the protocol bin/idc already uses to give the
// compiler file boundaries. This program splits that stream back apart, picks
// one, and prints it.
//
// Files are recorded as offsets into the input rather than copied out, so
// nothing is built by repeated concatenation -- which in `id` would be
// quadratic in the size of the file.

// Cased with input that has no "#file " marker in it, so scan_files() never
// opens a file and finish()'s show() call stays on the deterministic branch
// -- see pick.id's note on why the marked-input path is not reachable
// honestly here.
main(int argc, string[] argv) {
  init_view();
  string read_all_v = read_all();
  run(read_all_v);
} return int 0;
stdin "hello world\n" (1, ["prog"]):(0) then prints:("idview: no id files on stdin\n")
stdin "" (1, ["prog"]):(0) then prints:("idview: no id files on stdin\n")

run(string src) {
  scan_files(src, 0);
  int len_v = len(src);
  finish(src, len_v);
} return void;
given init_view ("hello world"):() then prints:("idview: no id files on stdin\n")
given init_view (""):() then prints:("idview: no id files on stdin\n")

init_view() {
  export string[] paths = [];
  export int[] starts = [];
  export int[] ends = [];
} return void;
():()
():() then iv_len:(0)
