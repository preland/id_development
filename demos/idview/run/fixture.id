// A populated paths/starts/ends table for split/'s own cases, and a single
// string check that reads all three back together. init_view() (main.id) is
// their sole declarer; register_path/close_last only push onto what it
// already declared, so this composes them rather than re-exporting.
iv2_setup() {
  init_view();
  register_path("#file a.id\nBODY\nTAIL", 6, 10);
  close_last(16);
} return void;
():() then iv_state:("a.id,11,16")
():() then iv_state:("a.id,11,16") then prints:("")

iv_state() {
  string iv_s = (import paths)[0] + "," + (import starts)[0] + "," + (import ends)[0];
} return string iv_s;
