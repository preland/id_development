// run() already spends its 3 actions scanning the input and naming its
// length, so closing the last file's span and showing one is a tail call.
// Cased with an empty table only, for the reason show()'s own cases give.
finish(string src, int len_v) {
  close_last(len_v);
  show(src);
} return void;
given init_view ("x", 0):() then prints:("idview: no id files on stdin\n")
given init_view ("y", 5):() then prints:("idview: no id files on stdin\n")

// pick.id's rnd() state: a literal seed, so a case can pin what rnd() next
// answers instead of ticks() picking a fresh one every run.
iv_rnd_init(word seed) {
  export word[] iv_rnd_st = [seed];
} return void;
(7):() then rnd:(1059165278)
(3):() then rnd:(243117059)

// rnd()'s own first-call case: a freshly seeded state, no prior rnd() call.
iv_rnd_seed7() {
  iv_rnd_init(7);
} return void;
