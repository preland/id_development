// Choosing one. `id` has no random builtin, so this is a 64-bit LCG seeded
// from ticks() (monotonic milliseconds), with the high bits taken -- the low
// bits of an LCG cycle far too regularly to index a small list with.
show(string src) {
  int n = len((import paths));
  if(n > 0) {
    int pick_v = pick(n);
    print_file(src, pick_v);
  } else {
    print("idview: no id files on stdin");
  }
} return void;

pick(int n) {
  word rnd_v = rnd();
  int ret_i = umod(rnd_v, n);
} return int ret_i;

rnd() {
  word s = ticks();
  s = s * 6364136223846793005 + 1442695040888963407;
  word ret_w = ushr(s, 33);
} return word ret_w;
