// Choosing one. `id` has no random builtin, so this is a 64-bit LCG seeded
// from iv_rnd_st (split.more/finish.id's iv_rnd_init), with the high bits
// taken -- the low bits of an LCG cycle far too regularly to index a small
// list with. init_view() seeds it from ticks() for a real run, so the file
// idview prints still differs every real run; a case seeds it with a literal
// instead (split.more/finish.id's iv_rnd_seed7, split.more/registerfile.id's
// iv_rnd_seed7_primed), which is what makes rnd() itself casable.
//
// show()'s n > 0 branch is still not cased: reaching it needs a "#file "
// marker in the case's stdin, which run/main.id's own note says is out of
// reach here. The n == 0 branch does not reach pick()/rnd() and is cased
// below. pick(1) stays pinned via given: umod(x, 1) is 0 for every x, so it
// does not depend on which literal rnd() answers, only that rnd() itself no
// longer traps for want of a seed.
show(string src) {
  int n = len((import paths));
  if(n > 0) {
    int pick_v = pick(n);
    print_file(src, pick_v);
  } else {
    print("idview: no id files on stdin");
  }
} return void;
given init_view ("a.id"):() then prints:("idview: no id files on stdin\n")
given init_view ("b.id"):() then prints:("idview: no id files on stdin\n")

pick(int n) {
  word rnd_v = rnd();
  int ret_i = umod(rnd_v, n);
} return int ret_i;
given iv_rnd_seed7 (1):(0)
given iv_rnd_seed7 (0):() then traps:("remainder by zero")

rnd() {
  word s = (import iv_rnd_st)[0];
  s = s * 6364136223846793005 + 1442695040888963407;
  wset((import iv_rnd_st), 0, s);
} chain () {
  word ret_w = ushr(s, 33);
} return word ret_w;
