// idview -- show a randomly chosen `id` source file.
//
// `id` has no filesystem access, so the file *set* arrives on stdin: the
// driver (tools/idview.sh) concatenates every .id file with a `#file <path>`
// marker between them, exactly the protocol bin/idc already uses to give the
// compiler file boundaries. This program splits that stream back apart, picks
// one, and prints it.
//
// Files are recorded as offsets into the input rather than copied out, so
// nothing is built by repeated concatenation -- which in `id` would be
// quadratic in the size of the file.

main(int argc, string[] argv) {
  init_view();
  run(read_all());
} return int 0;

run(string src) {
  scan_files(src, 0);
  close_last(len(src));
  show(src);
} return void;

init_view() {
  export string[] paths = [];
  export int[] starts = [];
  export int[] ends = [];
} return void;
