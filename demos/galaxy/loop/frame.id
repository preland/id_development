// One frame: render the galaxy at tick t (scene/render), print a periodic
// status line so a headless run has observable proof of progress (particle
// count + the current swirl angle), then poll one input event. glwin_poll
// returns -2 when the window (or GFX_MAX_FRAMES) wants to close, -1 for no
// event, or a key code; idstd's inp_live turns that into a keep-running flag
// (Esc or q also quit) -- same convention as demos/gl3d/loop/frame.id.

frame(int tick) {
  render(tick);
  status(tick);
  int input_event = glwin_poll();
} return int input_event;
given initialize_math given build_particles (0):(-1)
given initialize_math given build_particles (1):(-1)

status(int tick) {
  if (tick % 60 == 0) {
    string status_message = status_line(tick);
    print(status_message);
  }
} return void;
(0):() then prints:("frame 0 particles 6000000 swirl_millideg 0\n")
(1):() then prints:("")
