// One frame: render the galaxy at tick t (galaxy/render), print a periodic
// status line so a headless run has observable proof of progress (particle
// count + the current swirl angle), then poll one input event. gfx_poll
// returns -2 when the window (or GFX_MAX_FRAMES) wants to close, -1 for no
// event, or a key code; alive turns that into a keep-running flag (Esc or q
// also quit) -- same convention as demos/gl3d/loop/frame.id.

frame(int t) {
  render(t);
  status(t);
  int ev = gfx_poll();
} return int ev;

alive(int ev) {
  int a = 1;
  if(ev = 0 - 2 || ev = 27 || ev = 113) {
    a = 0;
  }
} return int a;

status(int t) {
  if (t % 60 = 0) { print(status_line(t)); }
} return void;
