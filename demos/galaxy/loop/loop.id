// The frame loop, the same shape as demos/gl3d/loop/loop.id: spin advances
// a tick counter until a frame reports the window wants to close, then tears
// the window down.

loop() {
  spin(1, 0);
  gfx_close();
} return void;

spin(int run, int t) {
  while(run > 0) {
    run = alive(frame(t));
    sleep_ms(16);
    t = t + 1;
  }
} return void;
