// max_radius: the particle cloud's outer radius, in milli-units.
int max_radius = 5000;

// particle_count is the single source of truth for the cloud's size:
// scene/particles/gen/buildparticles.id's fill loop, gl_draw_points' count argument
// (render/pipeline/draw.id) and the status line (render/swirl.id) all read
// it rather than repeating the literal.
int particle_count = 6000000;
