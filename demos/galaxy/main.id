// galaxy -- thousands of additively-blended, light-emitting particles
// arranged into a swirling spiral galaxy, hardware-rendered via the native
// GL backend (host/dev/win/gl). Opens an 1024x768 window, builds the whole
// particle cloud once (see scene/particles), then runs a frame loop that
// rigidly swirls the galaxy about its own axis while a tilted camera looks
// down on it (see scene/render). Only glwin_open/gl_*/glwin_poll/glwin_close
// cross into platform code -- the spiral shape, the sine table, the PRNG
// and the frame loop are all portable id, the same split demos/gl3d and
// demos/gl3dgame use.
//
//   idc/bin/idc demos/galaxy --allow-untested -o galaxy && ./galaxy
//
// Close the window (or press Esc / q) to quit. GFX_MAX_FRAMES lets a
// headless build run N frames and exit on its own.

// main()'s no-display path: the build harness runs every case with
// IDSTD_GFX=none (docs/TESTS.md), which makes glwin_open() fail the same way
// on every machine, whatever its own DISPLAY is, so ok=0
// and loop(ok) returns through spin's run<=0 branch without ever calling
// frame -- the one path that does not depend on GFX_MAX_FRAMES, an
// environment variable this build does not export.
main(int argc, string[] argv) {
  int ok = glwin_open(1024, 768, "id galaxy -- spiral particle viewer");
  scene_initialize();
  loop(ok);
} return int 0;
