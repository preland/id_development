// The two halves of sin_q's dispatch (sin.id): quadrants 0/1 (0..179 deg,
// non-negative) and quadrants 2/3 (180..359 deg, negative), each further
// split by reflecting the in-quadrant remainder r through the table
// (sin(90+r) = cos(r) = sin90(90-r), sin(180+r) = -sin(r), sin(270+r) =
// -cos(r) = -sin90(90-r)).

sin_q01(int q, int r) {
  int s = sin90(r);
  if (q = 1) { s = sin90(90 - r); }
} return int s;

sin_q23(int q, int r) {
  int s = 0 - sin90(r);
  if (q = 3) { s = 0 - sin90(90 - r); }
} return int s;
