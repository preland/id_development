// Push one particle's 3 milli-unit coordinates onto (import pos), in the
// x,y,z order backends/gl/gl.h's gl_draw_points expects -- the same
// decomposition demos/gl3d/scene/mesh/meshbuild/vertpush.id uses for its
// per-vertex push.

push_position(int r, int theta) {
  int particle_x_v = particle_x(r, theta);
  push((import pos), particle_x_v);
  push_yz(r, theta);
} return void;

push_yz(int r, int theta) {
  int particle_y_v = particle_y(r);
  push((import pos), particle_y_v);
  push_z(r, theta);
} return void;

push_z(int r, int theta) {
  int particle_z_v = particle_z(r, theta);
  push((import pos), particle_z_v);
} return void;
