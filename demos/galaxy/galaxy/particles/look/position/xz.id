// Polar-to-Cartesian, on the disk's own x/z plane (y is the thin vertical
// jitter, y.id): x = r*cos(theta), z = r*sin(theta), both divided back down
// from the r*table product to milli-units. r is already a milli-unit
// (particles/shape/radius.id) and fx_cos_deg/fx_sin_deg return x1000 values
// (idstd core/math/trig), so the product is x1000*1000 -- hence /1000.

particle_x(int r, int theta) {
  int ret_i = r * fx_cos_deg(theta) / 1000;
} return int ret_i;

particle_z(int r, int theta) {
  int ret_i = r * fx_sin_deg(theta) / 1000;
} return int ret_i;
