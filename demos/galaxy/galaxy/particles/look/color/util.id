// Small shared helpers: clamp255 keeps a wobbled channel in 0..255,
// pack_rgb packs 3 channel bytes into one 0xRRGGBB int (id has no bitwise
// ops, so this is plain arithmetic -- the same trick
// demos/gfxdemo/fb/color.id's rgb(r,g,b) uses).

clamp255(int v) {
  int r = v;
  if (v < 0) { r = 0; }
  else if (v > 255) { r = 255; }
} return int r;

pack_rgb(int r, int g, int b) {
} return int r * 65536 + g * 256 + b;
