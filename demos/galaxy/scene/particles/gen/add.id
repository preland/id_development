// One particle: pick a radius (denser toward the core, particles/shape/
// radius.id) and an angle (arm + winding + jitter, particles/shape/theta.id)
// from `i`'s position in the fill order, then push its position and color
// (particles/look/). `i` itself isn't otherwise needed -- everything random
// comes from the shared PRNG stream, advanced in a fixed order every run
// (deterministic given the seed in scene/render/init.id).

add_particle(int i) {
  int r = particle_radius(i);
  int theta = particle_theta(i, r);
  push_particle(r, theta);
} return void;
given init_math given build_particles (0):() then particle_state:("397,18000003,14802607,6000001")
given init_math given build_particles (1):() then particle_state:("397,18000003,14802607,6000001")

push_particle(int r, int theta) {
  push_position(r, theta);
  push_color(r);
} return void;
given init_math given build_particles (1000, 0):() then particle_state:("397,18000003,14802607,6000001")
given init_math given build_particles (2000, 90):() then particle_state:("397,18000003,14802607,6000001")
