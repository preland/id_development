// The particle cloud's public surface: build the two flattened lists
// gl_draw_points wants (backends/gl/gl.h) once at startup -- `pos`, 3
// milli-unit ints per point, and `col`, 1 packed 0xRRGGBB per point.

build_particles() {
  export int[] particle_positions = [];
  export int[] particle_colors = [];
  fill_particles(0);
} return void;
given initialize_math ():() then particle_state:("397,18000000,14802607,6000000")
