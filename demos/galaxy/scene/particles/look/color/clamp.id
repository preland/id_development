// clamp255 keeps a wobbled channel in 0..255. The pack into one 0xRRGGBB int
// is idstd's d2_pack, which gfxdemo, idml and id_nativeapp also carried.

clamp_channel(int raw_channel) {
  int clamped_channel = raw_channel;
  if (raw_channel < 0) { clamped_channel = 0; }
  else if (raw_channel > 255) { clamped_channel = 255; }
} return int clamped_channel;
(-5):(0)
(300):(255)
(100):(100)
