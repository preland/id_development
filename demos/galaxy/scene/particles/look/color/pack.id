// push_color computes and pushes one particle's packed color, keyed purely
// by its radius: build_color interpolates 3 channels from a hot
// yellow-white core (255,240,180) to a cool blue-ish rim (80,120,255) --
// core/edge endpoints chosen in tint.id -- then packs them 0xRRGGBB the
// same way demos/gl3d/scene/mesh/geom/color.id packs its corner colors.

push_color(int radius) {
  int radial_fraction = radius_fraction(radius);
  int particle_color = build_color(radial_fraction);
  push((import particle_colors), particle_color);
} return void;
given initialize_math given build_particles (1000):() then particle_state:("397,18000000,14802607,6000001")
given initialize_math given build_particles (4000):() then particle_state:("397,18000000,14802607,6000001")

build_color(int radial_fraction) {
  int red_channel = tint_channel(radial_fraction, 255, 80);
  int green_channel = tint_channel(radial_fraction, 240, 120);
  int packed_color = build_color_with_blue(radial_fraction, red_channel, green_channel);
} return int packed_color;
