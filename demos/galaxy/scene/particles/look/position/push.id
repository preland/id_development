// Push one particle's 3 milli-unit coordinates onto (import pos), in the
// x,y,z order backends/gl/gl.h's gl_draw_points expects -- the same
// decomposition demos/gl3d/scene/mesh/meshbuild/vertpush/pushvertex.id uses for its
// per-vertex push.

push_position(int radius, int theta) {
  int x_coordinate = particle_x(radius, theta);
  push((import particle_positions), x_coordinate);
  push_height_and_depth(radius, theta);
} return void;
given initialize_math given build_particles (1000, 0):() then particle_state:("397,18000003,14802607,6000000")
given initialize_math given build_particles (2000, 90):() then particle_state:("397,18000003,14802607,6000000")

push_height_and_depth(int radius, int theta) {
  int y_coordinate = particle_y(radius);
  push((import particle_positions), y_coordinate);
  push_z(radius, theta);
} return void;
given initialize_math given build_particles (1000, 0):() then particle_state:("397,18000002,14802607,6000000")
given initialize_math given build_particles (2000, 90):() then particle_state:("397,18000002,14802607,6000000")

push_z(int radius, int theta) {
  int z_coordinate = particle_z(radius, theta);
  push((import particle_positions), z_coordinate);
} return void;
given initialize_math given build_particles (1000, 0):() then particle_state:("397,18000001,14802607,6000000")
given initialize_math given build_particles (2000, 90):() then particle_state:("397,18000001,14802607,6000000")
