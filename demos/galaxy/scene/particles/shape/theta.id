// particle_theta assigns i to one of 3 spiral arms 120 degrees apart
// (arm_base), adds a winding term proportional to radius (so the angle
// sweeps further out at larger r -- the actual "spiral" in spiral galaxy),
// and a small PRNG jitter so the arms read as a scatter of stars rather
// than a rigid wire. Everything here is a plain integer degree (0..~400
// before idstd's fx_sin_deg reduces it mod 360) -- a different scale from the
// milli-degrees backends/gl/gl.h's gl_mat_rotate_* expects, kept strictly
// on the particles/ side of the seam.

particle_theta(int particle_index, int radius) {
  int base = arm_base(particle_index);
  int spiral_angle = particle_theta_wind(base, radius);
} return int spiral_angle;
given initialize_math (0, 0):(-16)
given initialize_math (1, 5000):(404)

particle_theta_wind(int base, int radius) {
  int wind = radius * 60 / 1000;
  int angle_jitter = noise_range(20);
  int wound_angle = base + wind + angle_jitter;
} return int wound_angle;
given initialize_math (0, 0):(-16)
given initialize_math (120, 5000):(404)

arm_base(int particle_index) {
  int arm = particle_index % 3;
  int arm_angle = arm * 120;
} return int arm_angle;
(0):(0)
(4):(120)
