// One-time setup: seed the math (sine table + PRNG), build the whole
// particle cloud, then print a startup line so a headless run has
// observable proof of what was generated before the first frame ever
// renders.

scene_initialize() {
  initialize_math();
  build_particles();
  print_startup();
} return void;
():() then prints:("galaxy: 6000000 particles, seed 1337\n")
():() then particle_state:("397,18000000,14802607,6000000")

initialize_math() {
  fixed_point_trig_initialize();
  random_initialize(1337);
} return void;
():()
():() then eprints:("")

print_startup() {
  int startup_particle_count = (import particle_count);
  print("galaxy: " + startup_particle_count + " particles, seed 1337");
} return void;
():() then prints:("galaxy: 6000000 particles, seed 1337\n")
():() then eprints:("")
