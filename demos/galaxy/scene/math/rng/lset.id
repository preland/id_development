// noise_range(half) is symmetric jitter in -half..+half, used for angle,
// height and color noise alike (particles/shape/theta.id,
// particles/look/position/y.id, particles/look/color/tint.id).

noise_range(int half) {
  int span = 2 * half + 1;
  int symmetric_noise = random_range(0, span - 1) - half;
} return int symmetric_noise;
