// control-flow demo: exercises float math, modulo, boolean operators,
// string concatenation with numeric coercion, and array indexing.
// One file, three functions, each within the 3-action limit.
//
// Note: variable names (parameters included) are unique program-wide, so
// every binding below has its own name.

// Single file, so no room for a fourth function: num is inlined as a
// literal into both calls rather than named, to hold main at 3 actions.
main(int argc, string[] argv) {
  string parity = describe(7);
  string label_v = label(7);
  print(parity + " / " + label_v);
} return int 0;

// `if`(1) + `else`(1) + decl(1) = 3 actions; the nested if is free.
describe(int d) {
  string out = "";
  if(d % 2 == 0) {
    out = d + " is even";
  } else {
    if(d > 5 && d < 10) {
      out = d + " is a big odd";
    } else {
      out = d + " is a small odd";
    }
  }
} return string out;

label(int k) {
  string[] names = ["small", "medium", "large"];
  string ret_s = names[k - 6];
} return string ret_s;
