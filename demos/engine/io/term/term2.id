// The rest of term_done, split into two links to stay within the action
// limit: the color-reset message, then the screen clear and flush.

term_done_msg(string chr_v, string sgr_v) {
  put(chr_v + "[?25h" + sgr_v);
  string chr_v2 = chr(27);
  term_done_clear(chr_v2);
} return void;

term_done_clear(string chr_v2) {
  put(chr_v2 + "[2J" + chr_v2 + "[H");
  flush();
} return void;
