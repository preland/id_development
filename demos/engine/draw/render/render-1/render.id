// Render the whole buffer to the terminal: home the cursor, emit every row,
// then reset color and flush. Each row is positioned absolutely so a dropped
// byte can never shift the picture.

render() {
  string chr_v = chr(27);
  put(chr_v + "[H");
  render_body();
} return void;

render_rows(int y) {
  while(y < (import scrh)) {
    render_row(y);
    y = y + 1;
  }
} return void;

render_row(int y) {
  string rowpos_v = rowpos(y);
  string row_str_v = row_str(y);
  put(rowpos_v + row_str_v);
} return void;
