// The four box corners ('+'), split so each block stays within the action
// limit.

box_corners(int x, int y, int w, int h, int attr) {
  set_cell(x, y, 43, attr);
  set_cell(x + w - 1, y, 43, attr);
  box_corners2(x, y, w, h, attr);
} return void;

box_corners2(int x, int y, int w, int h, int attr) {
  set_cell(x, y + h - 1, 43, attr);
  set_cell(x + w - 1, y + h - 1, 43, attr);
} return void;
