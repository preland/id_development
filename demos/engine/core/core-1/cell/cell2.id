// Bounds-checked cell write, the bounds test, and the blank-cell appender used
// while allocating the buffer.

set_cell(int x, int y, int ch, int attr) {
  if(in_bounds(x, y)) {
    write_cell(x, y, ch, attr);
  }
} return void;

in_bounds(int x, int y) {
  int ok = 0;
  if(x >= 0 && x < (import scrw) && y >= 0 && y < (import scrh)) {
    ok = 1;
  }
} return int ok;

blank_cell() {
  push((import scr), 32);
  push((import scrc), 0);
} return void;
