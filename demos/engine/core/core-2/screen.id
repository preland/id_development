// Screen buffer allocation. The buffer is one flat list of w*h cells (row
// major); a parallel attribute list holds each cell's color. Both start blank
// (space, attr 0).

screen_init(int w, int h) {
  export int scrw = w;
  export int scrh = h;
  alloc_screen(w * h);
} return void;

alloc_screen(int n) {
  export int[] scr = [];
  export int[] scrc = [];
  fill_screen(n);
} return void;

fill_screen(int n) {
  int i = 0;
  while(i < n) {
    blank_cell();
    i = i + 1;
  }
} return void;
