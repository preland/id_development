// fsdemo -- reading and writing a file from `id`.
//
// `id` has no filesystem builtins: the whole of BUILTIN_NAMES gives a program
// stdin (input/read_all) and stdout (print/put/flush) and nothing else, so
// until now a "file program" in id was a filter and the caller chose the files
// with `< in > out`. The backends/fs backend supplies the missing eight
// functions at link time, exactly the way backends/gfx supplies a window.
//
//   bin/idc demos/fsdemo -o fsdemo && ./fsdemo
//
// Nothing below names C, a file descriptor, or a libc call -- fs_open and its
// seven siblings are ordinary `id` calls that no `.id` file defines, and the
// conf.id beside this file is what says where they come from. Compile the
// same source with a different code generator and the source does not change.
main(int argc, string[] argv) {
  string path = "fsdemo.txt";
  write_file(path, "the quick brown fox\njumps over\nthe lazy dog\n");
  show(path);
} return int 0;
(1, ["prog"]):(0) then prints:("wrote 44 bytes to fsdemo.txt (close 0)\nread 44 bytes back (close 0):\nthe quick brown fox\njumps over\nthe lazy dog\n\nremoved fsdemo.txt (rc 0), exists now 0\nreopening it gives -1, errno 2\n")
(3, ["prog", "a", "b"]):(0) then prints:("wrote 44 bytes to fsdemo.txt (close 0)\nread 44 bytes back (close 0):\nthe quick brown fox\njumps over\nthe lazy dog\n\nremoved fsdemo.txt (rc 0), exists now 0\nreopening it gives -1, errno 2\n")

// show/render/show_tail/gone/report's own cases read this file back for real
// (rather than only exercising the not-found path), so this writes one with
// known, fixed content -- 3 bytes, "hi\n" -- that they can size a buffer to.
fsdemo_t_setup() {
  write_file("fsdemo_case.txt", "hi\n");
} return void;
():() then prints:("wrote 3 bytes to fsdemo_case.txt (close 0)\n")
():() then fsdemo_t_size:(3)

fsdemo_t_size() {
  int n = fs_size("fsdemo_case.txt");
} return int n;
given fsdemo_t_setup ():(3)
given fsdemo_t_setup ():(3) then prints:("")
