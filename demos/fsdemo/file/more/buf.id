// Buffers. fs_read never writes past the list it is given -- it clamps the
// count to len(buf) -- so the caller sizes the buffer, and a buffer of n
// bytes is a list of n cells.
zeros(int n) {
  int[] buf = [];
  int i = 0;
  while(i < n) {
    push(buf, 0);
    i = i + 1;
  }
} return int[] buf;

// One byte per cell, back into a string.
text_of(int[] buf) {
  string s = "";
  int i = 0;
  while(i < len(buf)) {
    s = s + chr(buf[i]);
    i = i + 1;
  }
} return string s;
