// One byte per cell, back into a string. (A buffer to read into is sized with
// lst_fill; fs_read never writes past the list it is given.)
text_of(int[] buf) {
  string s = "";
  int i = 0;
  while(i < len(buf)) {
    s = s + chr(buf[i]);
    i = i + 1;
  }
} return string s;
([65, 66]):("AB")
([]):("")
