// write_file() already spends its 3 actions opening the file and turning
// the text into bytes, so sizing the write and reporting it is a tail call.
write_tail(string path, int h, int[] bytes_of_v, string text) {
  int len_v = len(text);
  int n = fs_write(h, bytes_of_v, len_v);
  wrote(path, h, n);
} return void;
