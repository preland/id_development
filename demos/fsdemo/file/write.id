// Writing: turn the text into bytes, hand them to the backend, close.
write_file(string path, string text) {
  int h = fs_open(path, "w");
  int[] bytes_of_v = bytes_of(text);
  write_tail(path, h, bytes_of_v, text);
} return void;
("/dev/null", "hi"):() then prints:("wrote 2 bytes to /dev/null (close 0)\n")
("/dev/null", ""):() then prints:("wrote 0 bytes to /dev/null (close 0)\n")

wrote(string path, int h, int n) {
  int rc = fs_close(h);
  print("wrote " + n + " bytes to " + path + " (close " + rc + ")");
} return void;
("test.txt", -1, 5):() then prints:("wrote 5 bytes to test.txt (close -1)\n")
("x.txt", -1, 0):() then prints:("wrote 0 bytes to x.txt (close -1)\n")

// A string becomes one byte per cell. fs_write takes an int[] because the
// backend is a separately compiled object and cannot reach id's flat store;
// a list is a pointer this side already owns.
bytes_of(string text) {
  int[] buf = [];
  int i = 0;
  while(i < len(text)) {
    int charat_v = charat(text, i);
    push(buf, charat_v);
    i = i + 1;
  }
} return int[] buf;
("AB"):([65, 66])
(""):([])
