// Reading: ask how big the file is, size a buffer to match, fill it.
show(string path) {
  int[] buf = zeros(fs_size(path));
  render(fs_open(path, "r"), buf);
  gone(path);
} return void;

render(int h, int[] buf) {
  int n = fs_read(h, buf, len(buf));
  print("read " + n + " bytes back (close " + fs_close(h) + "):");
  print(text_of(buf));
} return void;
