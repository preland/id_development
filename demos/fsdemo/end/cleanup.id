// Teardown, and the failure convention. Every entry point returns an int, so
// a failure is -1 and the reason is fetched separately with fs_error.
//
// The two calls are deliberately in *separate statements* from the print that
// reports them: fs_error reads state that fs_open sets, and operands of one
// expression are not ordered, so `fs_open(...) + fs_error()` could ask for the
// reason before there is one. (It did, in the first draft of this file: the
// errno printed as 0.) One call per statement, and the order is the order.
gone(string path) {
  int rc = fs_remove(path);
  int h = fs_open(path, "r");
  report(path, rc, h);
} return void;
given fs_temp_text ("hi\n") ((import fs_temp_path)):() then fsdemo_t_gone:(1)
("fsdemo_case_missing4.txt"):() then prints:("removed fsdemo_case_missing4.txt (rc -1), exists now 0\nreopening it gives -1, errno 2\n")

report(string path, int rc, int h) {
  int fs_exists_v = fs_exists(path);
  print("removed " + path + " (rc " + rc + "), exists now " + fs_exists_v);
  report_reopen(h);
} return void;
("nope.txt", 0, -1):() then prints:("removed nope.txt (rc 0), exists now 0\nreopening it gives -1, errno 0\n")
("nope2.txt", -1, 5):() then prints:("removed nope2.txt (rc -1), exists now 0\nreopening it gives 5, errno 0\n")

report_reopen(int h) {
  int fs_error_v = fs_error();
  print("reopening it gives " + h + ", errno " + fs_error_v);
} return void;
(5):() then prints:("reopening it gives 5, errno 0\n")
(-1):() then prints:("reopening it gives -1, errno 0\n")
