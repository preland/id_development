// The negation and primary productions.

parse_neg(int[] pos) {
  advance(pos);
  int x = parse_unary(pos);
} return int node_un("-", x);

// primary: '(' expr ')' | INT
parse_primary(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "(") {
    node = parse_paren(pos);
  } else {
    node = parse_int(pos);
  }
} return int node;

parse_paren(int[] pos) {
  advance(pos);
  int e = parse_expr(pos);
  advance(pos);
} return int e;
