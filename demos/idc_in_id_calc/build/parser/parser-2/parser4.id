// Leaf parse + operator-class predicates.

parse_int(int[] pos) {
  int value = to_int(cur_text(pos));
  advance(pos);
} return int node_int(value);

is_addop(string s) {
  int ok = 0;
  if(s == "+" || s == "-") {
    ok = 1;
  }
} return int ok;

is_mulop(string s) {
  int ok = 0;
  if(s == "*" || s == "/" || s == "%") {
    ok = 1;
  }
} return int ok;
