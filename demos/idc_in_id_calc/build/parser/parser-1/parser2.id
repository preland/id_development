// multiplicative: unary (('*' | '/' | '%') unary)*

parse_mul(int[] pos) {
  int left = parse_unary(pos);
  while(is_mulop(cur_text(pos))) {
    left = fold_mul(pos, left);
  }
} return int left;

fold_mul(int[] pos, int left) {
  string op = cur_text(pos);
  advance(pos);
  int right = parse_unary(pos);
} return int node_bin(op, left, right);

// unary: '-' unary | primary
parse_unary(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "-") {
    node = parse_neg(pos);
  } else {
    node = parse_primary(pos);
  }
} return int node;
