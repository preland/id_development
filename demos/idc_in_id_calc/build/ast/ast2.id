// More node constructors, plus the kind accessor.

node_bin(string op, int left, int right) {
  int ret_i = newnode(2, left, right, op);
} return int ret_i;

node_un(string op, int x) {
  int ret_i = newnode(3, x, 0, op);
} return int ret_i;

node_kind(int id) {
  int ret_i = (import nkind)[id];
} return int ret_i;
