// AST construction. A node is four parallel cells: nkind, na, nb, ns.
// newnode appends one cell to each list and returns the new node's id.
//
// node kinds:  1 = INT literal (na = value)
//              2 = BINOP       (ns = operator, na = left id, nb = right id)
//              3 = UNOP        (ns = operator, na = operand id)

store_ints(int nk, int a, int b) {
  push((import nkind), nk);
  push((import na), a);
  push((import nb), b);
} return void;

newnode(int nk, int a, int b, string s) {
  store_ints(nk, a, b);
  push((import ns), s);
  int ret_i = len((import ns)) - 1;
} return int ret_i;

node_int(int value) {
  int ret_i = newnode(1, value, 0, "");
} return int ret_i;
