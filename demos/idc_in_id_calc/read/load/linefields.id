// Line helpers for the loader.

// turn the line src[i..e) into a token: kind = before the first space,
// value = after it. Empty lines are skipped.
proc_line(string src, int i, int e) {
  int sp = find_space(src, i, e);
  if(i < e) {
    emit_tok(src, i, sp, e);
  }
} return void;

// index of the first space in src[i..e), or e if none
find_space(string src, int i, int e) {
  while(i < e && charat(src, i) != 32) {
    i = i + 1;
  }
} return int i;
