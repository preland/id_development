// Turning one non-empty line's [i, e) span into a token: kind text, then
// value text, then the push. Naming both slices and the kind code is 4
// actions on its own, so the value slice and the push are a tail call.

emit_tok(string src, int i, int sp, int e) {
  string slice_v = str_slice(src, i, sp - i);
  int kindcode_v = kindcode(slice_v);
  emit_tok_tail(src, sp, e, kindcode_v);
} return void;

// A line with no space ("eof") has sp == e, so the value would start one past
// the line's end. Holding the start at e makes that value "", the same answer
// a line with nothing after its space gives.
emit_tok_tail(string src, int sp, int e, int kindcode_v) {
  int start_v = fx_min(sp + 1, e);
  string slice_v2 = str_slice(src, start_v, e - start_v);
  push_tok(kindcode_v, slice_v2);
} return void;
