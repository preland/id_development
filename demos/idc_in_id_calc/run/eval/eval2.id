// Operator application: dispatch on the operator string, one decision per
// helper, delegating to the next when it doesn't match.

apply(string op, int l, int r) {
  int v = 0;
  if(op == "+") {
    v = l + r;
  } else {
    v = apply2(op, l, r);
  }
} return int v;

apply2(string op, int l, int r) {
  int v = 0;
  if(op == "-") {
    v = l - r;
  } else {
    v = apply3(op, l, r);
  }
} return int v;

apply3(string op, int l, int r) {
  int v = 0;
  if(op == "*") {
    v = l * r;
  } else {
    v = apply4(op, l, r);
  }
} return int v;
