// AST evaluator. Walks the tree via the node_* accessors and returns the
// integer value of the subtree. Dispatch on (import nkind)[id] with a chain of helpers
// (one decision each) so every block stays within the 3-action / 2-deep limits.

eval_expr(int id) {
  int v = 0;
  if((import nkind)[id] == 1) {
    v = (import na)[id];
  } else {
    v = eval_op(id);
  }
} return int v;
given ast_setup (0):(2)
given ast_setup (2):(5)

eval_op(int id) {
  int v = 0;
  if((import nkind)[id] == 3) {
    int node_a_v = (import na)[id];
    v = 0 - eval_expr(node_a_v);
  } else {
    v = eval_bin(id);
  }
} return int v;
given ast_setup (2):(5)
given ast_setup (3):(-2)

eval_bin(int id) {
  int node_a_v = (import na)[id];
  int l = eval_expr(node_a_v);
  int ret_i = eval_bin_right(id, l);
} return int ret_i;
