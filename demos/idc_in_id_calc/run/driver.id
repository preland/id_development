// Driver: set up state, load the token stream, parse one expression, then
// print and evaluate the resulting AST.

main(int argc, string[] argv) {
  setup();
  load();
  calc();
} return int 0;
stdin "int 5\neof\n" (1, ["prog"]):(0) then prints:("5\n= 5\n")
stdin "int 9\neof\n" (3, ["prog", "a", "b"]):(0) then prints:("9\n= 9\n")

calc() {
  int[] pos = [0];
  int root = parse_add(pos);
  show(root);
} return void;
given tok_setup ():() then prints:("(- (+ 2 (* 3 4)) 5)\n= 9\n")
given tok_setup ():() then prints:("(- (+ 2 (* 3 4)) 5)\n= 9\n") then eprints:("")

show(int root) {
  string print_ast_v = print_ast(root);
  print(print_ast_v);
  show_tail(root);
} return void;
given ast_setup (2):() then prints:("(+ 2 3)\n= 5\n")
given ast_setup (0):() then prints:("2\n= 2\n")
