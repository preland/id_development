// Driver: set up state, load the token stream, parse one expression, then
// print and evaluate the resulting AST.

main(int argc, string[] argv) {
  setup();
  load();
  calc();
} return int 0;

calc() {
  int[] pos = [0];
  int root = parse_expr(pos);
  show(root);
} return void;

show(int root) {
  print(print_ast(root));
  print("= " + eval_expr(root));
} return void;
