// AST pretty-printer: renders a node subtree as an S-expression.
// Dispatch on kind via a chain of helpers (one decision each), like the parser.
//
//   print_ast -> print_op -> print_bin
//
// INT   -> the integer's digits
// UNOP  -> (op operand)
// BINOP -> (op left right)

print_ast(int id) {
  string s = "";
  if((import nkind)[id] == 1) {
    s = "" + (import na)[id];
  } else {
    s = print_op(id);
  }
} return string s;
given ast_setup (0):("2")
given ast_setup (2):("(+ 2 3)")

print_op(int id) {
  string s = "";
  if((import nkind)[id] == 3) {
    int node_a_v = (import na)[id];
    s = "(" + (import ns)[id] + " " + print_ast(node_a_v) + ")";
  } else {
    s = print_bin(id);
  }
} return string s;
given ast_setup (3):("(- 2)")
given ast_setup (2):("(+ 2 3)")

print_bin(int id) {
  int node_a_v = (import na)[id];
  int node_b_v = (import nb)[id];
  string s = "(" + (import ns)[id] + " " + print_ast(node_a_v) + " " + print_ast(node_b_v) + ")";
} return string s;
given ast_setup (2):("(+ 2 3)")
given ast_setup (3):("(- 2 2)")
