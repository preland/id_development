// More node constructors, plus the kind accessor.

node_bin(string op, int left, int right) {
  int ret_i = newnode(2, left, right, op);
} return int ret_i;
given setup ("+", 0, 1):(0) then store_state:("2,0,1")
given setup ("*", 2, 3):(0) then store_state:("2,2,3")

node_un(string op, int x) {
  int ret_i = newnode(3, x, 0, op);
} return int ret_i;
given setup ("-", 5):(0) then store_state:("3,5,0")
given setup ("-", 9):(0) then store_state:("3,9,0")
