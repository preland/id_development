// Leaf parse + operator-class predicates.

parse_int(int[] pos) {
  string cur_text_v = cur_text(pos);
  int value = to_int(cur_text_v);
  int ret_i = parse_int_tail(pos, value);
} return int ret_i;

is_addop(string s) {
  int ok = 0;
  if(s == "+" || s == "-") {
    ok = 1;
  }
} return int ok;

is_mulop(string s) {
  int ok = 0;
  if(s == "*" || s == "/" || s == "%") {
    ok = 1;
  }
} return int ok;
