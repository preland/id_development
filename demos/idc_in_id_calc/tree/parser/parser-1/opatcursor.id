// The while conditions in parser1.id and parser2.id must re-check the
// operator class at the current cursor position every iteration, so the
// composition of cur_text and is_addop/is_mulop is a function rather than
// a name computed once before the loop.

is_addop_at(int[] pos) {
  string cur_text_v = cur_text(pos);
  int ok = is_addop(cur_text_v);
} return int ok;

is_mulop_at(int[] pos) {
  string cur_text_v = cur_text(pos);
  int ok = is_mulop(cur_text_v);
} return int ok;
