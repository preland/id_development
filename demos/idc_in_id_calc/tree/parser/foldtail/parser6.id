// fold_add and fold_mul each already use their 3 actions naming the
// operator and advancing past it, so parsing the right operand and building
// the node is split into these tail calls.

fold_add_tail(int[] pos, int left, string op) {
  int right = parse_mul(pos);
  int ret_i = node_bin(op, left, right);
} return int ret_i;

fold_mul_tail(int[] pos, int left, string op) {
  int right = parse_unary(pos);
  int ret_i = node_bin(op, left, right);
} return int ret_i;
