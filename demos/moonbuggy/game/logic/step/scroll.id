// Scroll the terrain one column to the left and append a fresh column on the
// right, so craters approach the buggy from ahead.

scroll() {
  shift_ground(0);
  add_column();
} return void;
given game_setup ():() then ground_state:("1,60,1")
given crater_setup ():() then ground_state:("1,60,1")

shift_ground(int column) {
  while(column < (import term_width) - 1) {
    integer_list_set((import ground), column, (import ground)[column + 1]);
    column = column + 1;
  }
} return void;
given crater_setup (0):() then ground_state:("1,60,1")
given crater_setup (59):() then ground_state:("1,60,0")

add_column() {
  int new_column = next_column();
  integer_list_set((import ground), (import term_width) - 1, new_column);
} return void;
given game_setup ():() then ground_state:("1,60,1")
