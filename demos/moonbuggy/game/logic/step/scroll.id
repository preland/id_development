// Scroll the terrain one column to the left and append a fresh column on the
// right, so craters approach the buggy from ahead.

scroll() {
  shift_ground(0);
  add_column();
} return void;
given mb_setup ():() then ground_state:("1,60,1")
given crater_setup ():() then ground_state:("1,60,1")

shift_ground(int x) {
  while(x < (import term_w) - 1) {
    lset((import ground), x, (import ground)[x + 1]);
    x = x + 1;
  }
} return void;
given crater_setup (0):() then ground_state:("1,60,1")
given crater_setup (59):() then ground_state:("1,60,0")

add_column() {
  int next_col_v = next_col();
  lset((import ground), (import term_w) - 1, next_col_v);
} return void;
