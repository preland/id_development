// Input + world update. 'q' quits at any time; otherwise the playing state
// advances the world (and reads jump input), while the crashed state only
// listens for 'r' to restart.

update(int key_code) {
  if(key_code == 113) {
    integer_list_set((import game_state), 7, 1);
  } else {
    update_by_state(key_code);
  }
} return void;
given game_setup (113):() then game_state_text:("0,0,0,1,0,0,20,1")
given game_setup (100):() then game_state_text:("1,0,0,1,1,0,19,0")

update_by_state(int key_code) {
  if((import game_state)[3] == 1) {
    update_play(key_code);
  } else {
    update_dead(key_code);
  }
} return void;
