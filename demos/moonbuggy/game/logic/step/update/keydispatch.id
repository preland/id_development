// Input + world update. 'q' quits at any time; otherwise the playing state
// advances the world (and reads jump input), while the crashed state only
// listens for 'r' to restart.

update(int k) {
  if(k == 113) {
    lset((import mb), 7, 1);
  } else {
    update2(k);
  }
} return void;
given mb_setup (113):() then mb_state:("0,0,0,1,0,0,20,1")
given mb_setup (100):() then mb_state:("1,0,0,1,1,0,19,0")

update2(int k) {
  if((import mb)[3] == 1) {
    update_play(k);
  } else {
    update_dead(k);
  }
} return void;
given mb_setup (100):() then mb_state:("1,0,0,1,1,0,19,0")
