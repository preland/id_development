// Restart on 'r' after a crash, and the jump trigger: pressing space or 'j'
// while grounded gives the buggy an upward velocity.

update_dead(int key_code) {
  if(key_code == 114) {
    game_reset();
  }
} return void;
given game_setup_with_slot(3, 0) (114):() then game_state_text:("0,0,0,1,0,0,20,0") then ground_state:("1,60,1")
given game_setup_with_slot(3, 0) (100):() then game_state_text:("0,0,0,0,0,0,20,0")

try_jump(int key_code) {
  if(is_jump(key_code) && grounded()) {
    integer_list_set((import game_state), 2, 3);
  }
} return void;
given game_setup (32):() then game_state_text:("0,0,3,1,0,0,20,0")
given dirty_setup (32):() then game_state_text:("0,5,3,1,7,0,20,0")

is_jump(int key_code) {
  int ok = 0;
  if(key_code == 32 || key_code == 106) {
    ok = 1;
  }
} return int ok;
(32):(1)
(106):(1)
(100):(0)
