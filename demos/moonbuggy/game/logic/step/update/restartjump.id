// Restart on 'r' after a crash, and the jump trigger: pressing space or 'j'
// while grounded gives the buggy an upward velocity.

update_dead(int k) {
  if(k == 114) {
    mb_reset();
  }
} return void;
given mb_setup_set(3, 0) (114):() then mb_state:("0,0,0,1,0,0,20,0") then ground_state:("1,60,1")
given mb_setup_set(3, 0) (100):() then mb_state:("0,0,0,0,0,0,20,0")

try_jump(int k) {
  if(is_jump(k) && grounded()) {
    integer_list_set((import mb), 2, 3);
  }
} return void;
given mb_setup (32):() then mb_state:("0,0,3,1,0,0,20,0")
given dirty_setup (32):() then mb_state:("0,5,3,1,7,0,20,0")

is_jump(int k) {
  int ok = 0;
  if(k == 32 || k == 106) {
    ok = 1;
  }
} return int ok;
(32):(1)
(106):(1)
(100):(0)
