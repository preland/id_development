// Vertical physics: height += velocity, velocity -= gravity (1 per tick). When
// the height returns to the ground the buggy settles (height and velocity 0),
// giving a clean parabolic hop.

physics() {
  int off = (import mb)[1] + (import mb)[2];
  physics_tail(off);
} return void;
