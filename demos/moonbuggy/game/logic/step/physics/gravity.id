// Vertical physics: height += velocity, velocity -= gravity (1 per tick). When
// the height returns to the ground the buggy settles (height and velocity 0),
// giving a clean parabolic hop.

physics() {
  int off = gs_get(1) + gs_get(2);
  physics_tail(off);
} return void;
given dirty_setup ():() then mb_state:("0,8,2,1,7,0,20,0")
given mb_setup ():() then mb_state:("0,0,0,1,0,0,20,0")

land(int off) {
  gs_set(1, off);
  if(off <= 0) {
    settle();
  }
} return void;
given mb_setup (5):() then mb_state:("0,5,0,1,0,0,20,0")
given mb_setup (0):() then mb_state:("0,0,0,1,0,0,20,0")

settle() {
  gs_set(1, 0);
  gs_set(2, 0);
} return void;
given dirty_setup ():() then mb_state:("0,0,0,1,7,0,20,0")
given mb_setup ():() then mb_state:("0,0,0,1,0,0,20,0")
