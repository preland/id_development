// Decide the next column to scroll in. While a crater is in progress, keep
// emitting gap columns; otherwise count down a cooldown, then occasionally
// start a new crater of width 2-3.

next_column() {
  int column_is_solid = 1;
  if((import game_state)[5] > 0) {
    column_is_solid = count_down(5, 0);
  } else {
    column_is_solid = ground_or_new();
  }
} return int column_is_solid;
