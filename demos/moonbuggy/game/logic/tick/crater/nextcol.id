given crater_setup ():(0) then mb_state:("0,0,0,1,0,1,20,0")

count_down(int cd_slot, int cd_ret) {
  int gs_get_v = (import mb)[cd_slot];
  integer_list_set((import mb), cd_slot, gs_get_v - 1);
} return int cd_ret;
