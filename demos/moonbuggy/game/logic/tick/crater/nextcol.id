// Decide the next column to scroll in. While a crater is in progress, keep
// emitting gap columns; otherwise count down a cooldown, then occasionally
// start a new crater of width 2-3.

next_col() {
  int c = 1;
  if(gs_get(5) > 0) {
    c = pop_crater();
  } else {
    c = ground_or_new();
  }
} return int c;
given mb_setup ():(1) then mb_state:("0,0,0,1,0,0,19,0")
given crater_setup ():(0) then mb_state:("0,0,0,1,0,1,20,0")

pop_crater() {
  int gs_get_v = gs_get(5);
  gs_set(5, gs_get_v - 1);
} return int 0;
given crater_setup ():(0) then mb_state:("0,0,0,1,0,1,20,0")
given crater_setup ():(0) then mb_state:("0,0,0,1,0,1,20,0") then eprints:("")

ground_or_new() {
  int c = 1;
  if(gs_get(6) > 0) {
    c = cool_tick();
  } else {
    c = roll_crater();
  }
} return int c;
given mb_setup ():(1) then mb_state:("0,0,0,1,0,0,19,0")
given mb_setup ():(1) then mb_state:("0,0,0,1,0,0,19,0") then eprints:("")
