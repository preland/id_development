given crater_setup ():(0) then game_state_text:("0,0,0,1,0,1,20,0")

count_down(int counter_slot, int column_result) {
  int current_count = (import game_state)[counter_slot];
  integer_list_set((import game_state), counter_slot, current_count - 1);
} return int column_result;
