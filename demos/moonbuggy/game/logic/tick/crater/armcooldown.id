// begin_crater already spends its 3 actions opening the crater, so arming
// the next cooldown is a tail call.
begin_crater_delay() {
  int delay_jitter = random_range(0, 6 - 1);
  integer_list_set((import game_state), 6, 8 + delay_jitter);
} return void;
