// begin_crater already spends its 3 actions opening the crater, so arming
// the next cooldown is a tail call.
begin_cooldown() {
  int rng_range_v2 = rnd_range(0, 6 - 1);
  gs_set(6, 8 + rng_range_v2);
} return void;
