// The random crater start (the cooldown tick is nextcol.id's count_down): a
// 1-in-4 chance per eligible tick to open a crater 1..2 columns wide here (plus
// this column), and arm a cooldown of 8..13 ticks before the next one.

roll_crater() {
  int c = 1;
  if(random_range(0, 4 - 1) == 0) {
    c = begin_crater();
  }
} return int c;
given mb_setup ():(1) then mb_state:("0,0,0,1,0,0,20,0")
given mb_setup ():(1) then mb_state:("0,0,0,1,0,0,20,0") then eprints:("")

begin_crater() {
  int rng_range_v = random_range(0, 2 - 1);
  integer_list_set((import mb), 5, 1 + rng_range_v);
  begin_cooldown();
} return int 0;
given mb_setup ():(0) then mb_state:("0,0,0,1,0,2,10,0")
