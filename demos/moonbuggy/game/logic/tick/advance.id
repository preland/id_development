// Advance the world by one tick: apply physics, scroll the terrain, then check
// for a crash and award distance.

advance() {
  physics();
  scroll();
  post_scroll();
} return void;

post_scroll() {
  collide();
  bump_score();
} return void;

grounded() {
  int ok = 0;
  if(gs_get(1) <= 0) {
    ok = 1;
  }
} return int ok;
