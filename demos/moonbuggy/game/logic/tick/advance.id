// Advance the world by one tick: apply physics, scroll the terrain, then check
// for a crash and award distance.

advance() {
  physics();
  scroll();
  post_scroll();
} return void;
given game_setup ():() then game_state_text:("1,0,0,1,1,0,19,0")
