// Scroll the terrain one column to the left and append a fresh column on the
// right, so craters approach the buggy from ahead.

scroll() {
  shift_ground(0);
  add_column();
} return void;

shift_ground(int x) {
  while(x < (import scrw) - 1) {
    lset((import ground), x, (import ground)[x + 1]);
    x = x + 1;
  }
} return void;

add_column() {
  lset((import ground), (import scrw) - 1, next_col());
} return void;
