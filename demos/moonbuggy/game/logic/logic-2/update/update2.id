// Restart on 'r' after a crash, and the jump trigger: pressing space or 'j'
// while grounded gives the buggy an upward velocity.

update_dead(int k) {
  if(k == 114) {
    mb_reset();
  }
} return void;

try_jump(int k) {
  if(is_jump(k) && grounded()) {
    gs_set(2, 3);
  }
} return void;

is_jump(int k) {
  int ok = 0;
  if(k == 32 || k == 106) {
    ok = 1;
  }
} return int ok;
