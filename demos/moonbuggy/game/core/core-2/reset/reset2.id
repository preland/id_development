// Remaining reset helpers: clear height/velocity/tick, re-arm the crater
// spawner, and refill the terrain as solid ground.

reset_phys() {
  gs_set(1, 0);
  gs_set(2, 0);
  gs_set(4, 0);
} return void;

reset_spawn() {
  gs_set(5, 0);
  gs_set(6, 20);
} return void;

reset_ground(int x) {
  while(x < (import scrw)) {
    lset((import ground), x, 1);
    x = x + 1;
  }
} return void;
