// Restart after a crash: zero the score/physics, mark alive, re-arm the
// cooldown, and flatten the terrain. (The exported lists already exist, so this
// stores into them rather than re-declaring.)

mb_reset() {
  reset_state();
  reset_ground(0);
} return void;

reset_state() {
  gs_set(0, 0);
  gs_set(3, 1);
  reset_state2();
} return void;

reset_state2() {
  reset_phys();
  reset_spawn();
} return void;
