// First-time setup: the state list (alive, cooldown 20 so the start is flat for
// a moment) and a fully solid terrain.

mb_init() {
  export int[] mb = [0, 0, 0, 1, 0, 0, 20, 0];
  init_ground();
} return void;

init_ground() {
  export int[] ground = [];
  fill_ground(0);
} return void;

fill_ground(int x) {
  while(x < (import scrw)) {
    push((import ground), 1);
    x = x + 1;
  }
} return void;
