// Restart after a crash: zero the score/physics, mark alive, re-arm the
// cooldown, and flatten the terrain. (The exported lists already exist, so this
// stores into them rather than re-declaring.)

game_reset() {
  reset_state();
  reset_ground(0);
} return void;
given crater_setup ():() then game_state_text:("0,0,0,1,0,0,20,0") then ground_state:("1,60,1")
given game_setup ():() then game_state_text:("0,0,0,1,0,0,20,0") then ground_state:("1,60,1")

reset_state() {
  integer_list_set((import game_state), 0, 0);
  integer_list_set((import game_state), 3, 1);
  reset_physics_and_craters();
} return void;
given crater_setup ():() then game_state_text:("0,0,0,1,0,0,20,0")
given game_setup ():() then game_state_text:("0,0,0,1,0,0,20,0")

reset_physics_and_craters() {
  reset_phys();
  set_two_slots(5, 0, 6, 20);
} return void;
given crater_setup ():() then game_state_text:("0,0,0,1,0,0,20,0")
given dirty_setup ():() then game_state_text:("0,0,0,1,0,0,20,0")
