// Remaining reset helpers: clear height/velocity/tick, re-arm the crater
// spawner, and refill the terrain as solid ground.

reset_phys() {
  gs_set(1, 0);
  gs_set(2, 0);
  gs_set(4, 0);
} return void;
given dirty_setup ():() then mb_state:("0,0,0,1,0,0,20,0")
given mb_setup ():() then mb_state:("0,0,0,1,0,0,20,0")

reset_spawn() {
  gs_set(5, 0);
  gs_set(6, 20);
} return void;
given crater_setup ():() then mb_state:("0,0,0,1,0,0,20,0")
given mb_setup ():() then mb_state:("0,0,0,1,0,0,20,0")

reset_ground(int x) {
  while(x < (import term_w)) {
    lset((import ground), x, 1);
    x = x + 1;
  }
} return void;
given crater_setup (0):() then ground_state:("1,60,1")
given crater_setup (10):() then ground_state:("1,60,1")
