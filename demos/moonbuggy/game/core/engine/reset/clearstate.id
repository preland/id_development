// Remaining reset helpers: clear height/velocity/tick, and refill the terrain as solid ground.

reset_phys() {
  lset((import mb), 1, 0);
  lset((import mb), 2, 0);
  lset((import mb), 4, 0);
} return void;
given dirty_setup ():() then mb_state:("0,0,0,1,0,0,20,0")
given mb_setup ():() then mb_state:("0,0,0,1,0,0,20,0")

reset_ground(int x) {
  while(x < (import term_w)) {
    lset((import ground), x, 1);
    x = x + 1;
  }
} return void;
given crater_setup (0):() then ground_state:("1,60,1")
given crater_setup (10):() then ground_state:("1,60,1")
