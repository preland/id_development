// MOON BUGGY -- a real-time side-scroller written in id, on the id game engine.
//
// Drive a buggy across the lunar surface; the terrain scrolls toward you and
// craters open in the ground. Tap [space] (or j) to jump them. Hit a crater on
// the ground and you crash. [q] quits, [r] restarts after a crash.
//
// Built on the engine's frame loop: each frame reads the latest key, updates
// the physics + terrain, repaints the whole screen, and sleeps ~70ms.
//
// Game state lives in one exported list `mb`, indexed by:
//   0 score   1 height (cells above ground)   2 vy (vertical velocity)
//   3 alive   4 tick    5 crater_left (crater columns still to spawn)
//   6 cooldown (ticks until another crater may start)   7 quit
// The terrain is the exported list `ground`: ground[x] = 1 solid, 0 crater.

// main() seeds start_engine from ticks() (wall clock), so the seed itself
// is not a literal a case can pin -- but a case can still feed the process a real quit
// keystroke via stdin: term_key() (idstd's getkey()) reads whatever stdin
// gives it, "q" ends play()'s loop through the ordinary key path (see
// keydispatch.id), and the run completes, so main()/start() are witnessed by
// what they call rather than by the seed.
main(int argc, string[] argv) {
  word ticks_v = ticks();
  int seed = ticks_v;
  start_engine(seed);
} return int 0;
stdin "q" (1, ["prog"]):(0) then calls start_engine:[1]
stdin "q" (2, ["prog", "x"]):(0) then calls term_done:[1]

start() {
  mb_init();
  play();
  term_done();
} return void;
given term_setup_mb(60, 20) stdin "q" ():() then calls mb_init:[1] then calls term_done:[1] then mb_state:("0,0,0,1,0,0,20,1")
given term_setup_mb(60, 20) stdin "q" ():() then calls play:[1] then (import mb)[7]:(1)

play() {
  int running = 1;
  while(running == 1) {
    running = frame();
  }
} return void;
given mb_setup_set(7, 1) ():() then mb_state:("1,0,0,1,1,0,19,1")
