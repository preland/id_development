// MOON BUGGY -- a real-time side-scroller written in id, on the id game engine.
//
// Drive a buggy across the lunar surface; the terrain scrolls toward you and
// craters open in the ground. Tap [space] (or j) to jump them. Hit a crater on
// the ground and you crash. [q] quits, [r] restarts after a crash.
//
// Built on the engine's frame loop: each frame reads the latest key, updates
// the physics + terrain, repaints the whole screen, and sleeps ~70ms.
//
// Game state lives in one exported list `mb`, indexed by:
//   0 score   1 height (cells above ground)   2 vy (vertical velocity)
//   3 alive   4 tick    5 crater_left (crater columns still to spawn)
//   6 cooldown (ticks until another crater may start)   7 quit
// The terrain is the exported list `ground`: ground[x] = 1 solid, 0 crater.

// main() and start() are not cased: main() seeds from ticks() (wall clock,
// not a literal a case can pin -- the same reason demos/idview/pick.id's
// rnd() is skipped), and start() calls mb_init() itself, right before
// play(), so no given can leave quit set when play()'s loop starts -- it is
// always freshly 0, and nothing inside start() ever sets it, so the loop
// never ends. play() is cased directly below via quit_setup, which sets
// quit before play() runs and nothing after it resets it.
main(int argc, string[] argv) {
  word ticks_v = ticks();
  int seed = ticks_v;
  start_engine(seed);
} return int 0;

start() {
  mb_init();
  play();
  term_done();
} return void;

play() {
  int running = 1;
  while(running == 1) {
    running = frame();
  }
} return void;
