// One frame: read the latest key, update the world, repaint. wait_cont sleeps
// for the frame interval and reports whether to keep looping (stops on quit).

frame() {
  int key_code = term_key();
  update(key_code);
  int keep_looping = frame_tail(key_code);
} return int keep_looping;
given game_setup ():(1)
given game_setup_with_slot(7, 1) ():(0)

wait_cont(int key_code) {
  sleep_ms(70);
  int keep_looping = 1 - (import game_state)[7];
} return int keep_looping;
given game_setup (0):(1)
given game_setup_with_slot(7, 1) (5):(0)
given game_setup_with_slot(7, 1) (0):(0)
