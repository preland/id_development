// One frame: read the latest key, update the world, repaint. wait_cont sleeps
// for the frame interval and reports whether to keep looping (stops on quit).

frame() {
  int k = term_key();
  update(k);
  int ret_i = frame_tail(k);
} return int ret_i;
given mb_setup ():(1)
given quit_setup ():(0)

wait_cont(int k) {
  sleep_ms(70);
  int ret_i = 1 - gs_get(7);
} return int ret_i;
given mb_setup (0):(1)
given quit_setup (0):(0)
