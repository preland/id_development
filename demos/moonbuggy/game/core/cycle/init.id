// First-time setup: the state list (alive, cooldown 20 so the start is flat for
// a moment) and a fully solid terrain.

mb_init() {
  export int[] mb = [0, 0, 0, 1, 0, 0, 20, 0];
  init_ground();
} return void;
given term_setup_mb ():() then mb_state:("0,0,0,1,0,0,20,0")
given term_setup_mb ():() then mb_state:("0,0,0,1,0,0,20,0") then eprints:("")

init_ground() {
  export int[] ground = [];
  fill_ground(0);
} return void;
given term_setup_mb ():() then ground_state:("1,60,1")
given term_setup_mb ():() then ground_state:("1,60,1") then eprints:("")

fill_ground(int x) {
  while(x < (import term_w)) {
    push((import ground), 1);
    x = x + 1;
  }
} return void;
given term_setup_mb given init_ground (60):() then ground_state:("1,60,1")
given term_setup_mb given init_ground (59):() then ground_state:("1,61,1")
