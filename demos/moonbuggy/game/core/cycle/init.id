// First-time setup: the state list (alive, cooldown 20 so the start is flat for
// a moment) and a fully solid terrain.

create_game() {
  export int[] game_state = [0, 0, 0, 1, 0, 0, 20, 0];
  create_ground();
} return void;
given setup_game_terminal(60, 20) ():() then game_state_text:("0,0,0,1,0,0,20,0")
given setup_game_terminal(60, 20) ():() then game_state_text:("0,0,0,1,0,0,20,0") then eprints:("")

create_ground() {
  export int[] ground = [];
  fill_ground(0);
} return void;
given setup_game_terminal(60, 20) ():() then ground_state:("1,60,1")
given setup_game_terminal(60, 20) ():() then ground_state:("1,60,1") then eprints:("")

fill_ground(int column) {
  while(column < (import term_width)) {
    push((import ground), 1);
    column = column + 1;
  }
} return void;
given setup_game_terminal(60, 20) given create_ground (60):() then ground_state:("1,60,1")
given setup_game_terminal(60, 20) given create_ground (59):() then ground_state:("1,61,1")
