// The buggy sprite (a body row over a wheels row) raised by its current height,
// and the solid-ground column beneath the surface.

solid_col(int x) {
  int ground_row_v = ground_row();
  term_set(x, ground_row_v, 61, 2);
  solid_col_tail(x);
} return void;
given mb_setup (0):() then idstd_term_t_sum:("screen 38507")
given mb_setup (0):() then idstd_term_t_sum:("screen 38507") then eprints:("")

// solid_col already spends its 3 actions on the surface cell, so the wall
// beneath it is a tail call.
solid_col_tail(int x) {
  int ground_row_v2 = ground_row();
  term_vline(x, ground_row_v2 + 1, 3, 58, 4);
} return void;
given mb_setup (0):() then idstd_term_t_sum:("screen 38478")
given mb_setup (0):() then idstd_term_t_sum:("screen 38478") then eprints:("")

draw_buggy() {
  int top = ground_row() - 2 - gs_get(1);
  draw_body(top);
} return void;
