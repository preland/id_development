// solid_col already spends its 3 actions on the surface cell, so the wall
// beneath it is a tail call.
solid_column_tail(int column) {
  int wall_surface_row = ground_row();
  term_vertical_line(column, wall_surface_row + 1, 3, 58, 4);
} return void;
