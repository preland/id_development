// Draw the terrain row: each solid column is a green '=' surface with a darker
// subsurface below; a crater column leaves a gap. ground_row is the surface y.

ground_row() {
  int ret_i = (import term_h) - 4;
} return int ret_i;

draw_ground(int x) {
  while(x < (import term_w)) {
    draw_col(x);
    x = x + 1;
  }
} return void;

draw_col(int x) {
  if((import ground)[x] == 1) {
    solid_col(x);
  } else {
    int ground_row_v = ground_row();
    term_set(x, ground_row_v, 32, 0);
  }
} return void;
