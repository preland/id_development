// draw_buggy already spends its 2 actions locating the row, leaving only 1
// action of room, so the body row is here and the wheels row is a further
// tail call.
draw_body(int top) {
  int bx_v = bx();
  draw_text(bx_v, top, "[**]", 13);
  draw_buggy_tail(top);
} return void;

draw_buggy_tail(int top) {
  int bx_v2 = bx();
  draw_text(bx_v2, top + 1, "o##o", 7);
} return void;
