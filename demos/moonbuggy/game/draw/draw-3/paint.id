// Repaint the whole frame: clear the buffer, draw the world (sky, terrain,
// buggy), then the HUD and any crash overlay, and flush to the terminal.

paint() {
  clear();
  draw_world();
  finish_paint();
} return void;

draw_world() {
  draw_sky();
  draw_ground(0);
  draw_buggy();
} return void;

finish_paint() {
  draw_hud();
  maybe_gameover();
  render();
} return void;
