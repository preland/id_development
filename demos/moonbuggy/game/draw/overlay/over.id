// The crash overlay: a centered panel shown while the buggy is wrecked.

maybe_gameover() {
  if((import mb)[3] == 0) {
    draw_gameover();
  }
} return void;
given mb_setup ():() then idstd_term_t_sum:("screen 38400")
given mb_setup_set(3, 0) ():() then idstd_term_t_sum:("screen 40945")

draw_gameover() {
  int cx = (import term_w) / 2 - 12;
  term_box(cx, 6, 24, 5, 1);
  gameover_text(cx);
} return void;
given mb_setup ():() then idstd_term_t_sum:("screen 40945")
given mb_setup ():() then idstd_term_t_sum:("screen 40945") then eprints:("")

gameover_text(int cx) {
  term_text(cx + 4, 7, "*** CRASHED ***", 1);
  term_text(cx + 3, 9, "r restart   q quit", 8);
} return void;
