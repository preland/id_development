// The crash overlay: a centered panel shown while the buggy is wrecked.

maybe_gameover() {
  if(gs_get(3) == 0) {
    draw_gameover();
  }
} return void;

draw_gameover() {
  int cx = (import scrw) / 2 - 12;
  draw_box(cx, 6, 24, 5, 1);
  gameover_text(cx);
} return void;

gameover_text(int cx) {
  draw_text(cx + 4, 7, "*** CRASHED ***", 1);
  draw_text(cx + 3, 9, "r restart   q quit", 8);
} return void;
