// Drawing primitives over the cell buffer: a run of text, a horizontal line,
// and a vertical line. Each is one decl + one loop within the action budget.

draw_text(int x, int y, string s, int attr) {
  int i = 0;
  while(i < len(s)) {
    set_cell(x + i, y, charat(s, i), attr);
    i = i + 1;
  }
} return void;

draw_hline(int x, int y, int n, int ch, int attr) {
  int i = 0;
  while(i < n) {
    set_cell(x + i, y, ch, attr);
    i = i + 1;
  }
} return void;

draw_vline(int x, int y, int n, int ch, int attr) {
  int i = 0;
  while(i < n) {
    set_cell(x, y + i, ch, attr);
    i = i + 1;
  }
} return void;
