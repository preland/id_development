// Frame finish (reset color + flush), absolute row positioning, and building a
// row into a single string (so a row is one put, not one put per cell).

finish_frame() {
  string sgr_v = sgr(0);
  put(sgr_v);
  flush();
} return void;

rowpos(int y) {
  string ret_s = chr(27) + "[" + (y + 1) + ";1H";
} return string ret_s;

row_str(int y) {
  string out = "";
  int x = 0;
  while(x < (import scrw)) {
    out = out + cell_str(y, x);
    x = x + 1;
  }
} return string out;
