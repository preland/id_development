// Low-level cell access. cell_idx maps (x, y) to a buffer offset; lset is the
// generic "store into a list element" helper (an imported list cannot be
// index-assigned directly, but passing it as a parameter makes the lvalue an
// identifier again, and lists are reference-semantic so the store is shared).

cell_idx(int x, int y) {
} return int y * (import scrw) + x;

lset(int[] xs, int i, int v) {
  xs[i] = v;
} return void;

write_cell(int x, int y, int ch, int attr) {
  lset((import scr), cell_idx(x, y), ch);
  lset((import scrc), cell_idx(x, y), attr);
} return void;
