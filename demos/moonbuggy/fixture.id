// All 8 `mb` slots together (score, height, vy, alive, tick, crater_left,
// cooldown, quit -- game/core/engine/mb.id), for every case elsewhere that
// changes game state.
mb_state() {
  string st = (import mb)[0] + "," + (import mb)[1] + "," + (import mb)[2] + "," + (import mb)[3] + "," + (import mb)[4] + "," + (import mb)[5] + "," + (import mb)[6] + "," + (import mb)[7];
} return string st;
