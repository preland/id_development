// The two declaring chains every game/ case needs: term_init (term_w/h/
// scr/attr/pal, and it seeds rnd_ -- host/io/term/init.id) and mb_init
// (mb, and ground via init_ground). term_setup_mb is split out on its own
// for mb_init's own cases, which must not call mb_init from their given.
// A fixed seed (42) makes every crater/cooldown roll elsewhere reproducible.
term_setup_mb(int mb_tw, int mb_th) {
  term_init(mb_tw, mb_th, 42);
} return void;
(60, 20):()
(60, 20):() then eprints:("")

mb_setup() {
  term_setup_mb(60, 20);
  mb_init();
} return void;
