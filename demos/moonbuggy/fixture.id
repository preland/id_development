// All 8 `mb` slots together (score, height, vy, alive, tick, crater_left,
// cooldown, quit -- game/core/engine/mb.id), for every case elsewhere that
// changes game state.
game_state_text() {
  string state_text = (import game_state)[0] + "," + (import game_state)[1] + "," + (import game_state)[2] + "," + (import game_state)[3] + "," + (import game_state)[4] + "," + (import game_state)[5] + "," + (import game_state)[6] + "," + (import game_state)[7];
} return string state_text;
