// `gym`: the Mental Gym command line, one program over the pack, check, log,
// plan, score and ai modules. It reads the real clock once, here, and hands it
// down; every command also takes --now MS, so a whole session can be scripted
// and replayed exactly. All state is the append-only log named by --log (see
// log/FORMAT.md), so there is nothing else to find, back up or lose. The exit
// status is the first element of command_run's answer. Usage: gym --help.

main(int main_count, string[] main_arguments) {
  word main_clock = clk_ns((import clk_real)) / 1000000;
  string[] main_out = command_run(main_arguments, main_clock);
  print(main_out[1]);
} chain (int main_count, string[] main_arguments) {
  int main_code = to_int(main_out[0]);
} return int main_code;
(2, ["gym", "--bogus"]):(2) then prints:("error: unknown option '--bogus'; run with --help to list the options\n")
(2, ["gym", "pack"]):(2) then prints:("error: say what to do, one of:\ngym session start --pack DIR --log FILE [--now MS] [--seed N]\ngym answer --pack DIR --log FILE --text ANSWER --confidence 50|70|90|99 [--seconds N] [--now MS]\ngym hint --pack DIR --log FILE [--url URL] [--now MS]\ngym tapout --pack DIR --log FILE [--seconds N] [--now MS]\ngym next --pack DIR --log FILE [--now MS]\ngym score --pack DIR --log FILE [--now MS]\ngym why ITEM --pack DIR --log FILE [--now MS] [--seed N]\ngym pack check DIR\ngym grade --pack DIR --item ID --text ANSWER [--url URL]\n")
