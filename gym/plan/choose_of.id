// Choosing the practice item of a concept for this session. Held-out transfer
// items are never offered here, and an item already in the session (taken) is not
// offered again. Among the rest the lowest plan_fit cost wins, the earliest in the
// pack on a tie; -1 when the concept has no item left to offer.

plan_link_cost(Plan_book plan_book, Plan_learner plan_learner, int plan_concept_number, int[] plan_taken, int plan_link_number) {
  int plan_cost_here = 1000000;
  if (plan_book.links.link_concepts[plan_link_number] == plan_concept_number && plan_book.links.link_held[plan_link_number] == 0 && plan_taken[plan_book.links.link_items[plan_link_number]] == 0) {
    plan_cost_here = plan_fit(plan_learner, plan_concept_number, plan_book.links.link_items[plan_link_number]);
  }
} return int plan_cost_here;
