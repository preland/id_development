plan_choose(Plan_book plan_book, Plan_learner plan_learner, int plan_concept_number, int[] plan_taken) {
  int plan_chosen = 0 - 1;
  int plan_chosen_cost = 1000000;
  int plan_at = 0;
} chain (Plan_book plan_book, Plan_learner plan_learner, int plan_concept_number, int[] plan_taken) {
  int plan_cost_found = 0;
  while (plan_at < len(plan_book.links.link_items)) {
    plan_cost_found = plan_link_cost(plan_book, plan_learner, plan_concept_number, plan_taken, plan_at);
    if (plan_cost_found < plan_chosen_cost) {
      plan_chosen = plan_book.links.link_items[plan_at];
      plan_chosen_cost = plan_cost_found;
    }
    plan_at = plan_at + 1;
  }
} return int plan_chosen;
