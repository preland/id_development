plan_replay(Plan_book plan_book, Log_events plan_events) {
  Plan_learner plan_learner = plan_blank_learner(plan_book);
  int plan_at = 0;
  while (plan_at < len(plan_events.kinds)) {
    plan_replay_event(plan_book, plan_learner, plan_events, plan_at);
    plan_at = plan_at + 1;
  }
} return Plan_learner plan_learner;
