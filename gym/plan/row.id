// Applying retarget.id to a finished plan. plan_swap_note words the reason a row
// was changed (it is appended to the row, so `gym why` shows it). plan_adjust_row
// reads the learner's history on the first concept of the row's item, picks the
// level (kinds.id) and the target difficulty (raised by plan_difficulty_step when
// the latest attempt on the concept was fluent) and swaps the item when another
// scores lower. plan_adjust does it for every main-set row of a version 2 pack
// and leaves a version 1 plan exactly as the planner made it.

plan_swap_note(Pack plan_pack, Plan_book plan_book, int plan_old_item, int plan_new_item, string plan_level, string plan_concept_id) {
  string plan_old_kind = pack_field(plan_pack, pack_find(plan_pack, "item", plan_book.catalog.items[plan_old_item]), "kind");
  string plan_new_kind = pack_field(plan_pack, pack_find(plan_pack, "item", plan_book.catalog.items[plan_new_item]), "kind");
  string plan_note = "";
} chain (Pack plan_pack, Plan_book plan_book, int plan_old_item, int plan_new_item, string plan_level, string plan_concept_id) {
  if (plan_new_kind != plan_old_kind) {
    plan_note = "; exercise kind " + plan_new_kind + " instead of " + plan_old_kind + " (" + plan_level + " on " + plan_concept_id + ")";
  }
  if (plan_book.catalog.bases[plan_new_item] > plan_book.catalog.bases[plan_old_item]) {
    plan_note = plan_note + "; harder, because your last answer on it was fast and confident";
  }
  if (plan_note == "") {
    plan_note = "; closer to your level of difficulty";
  }
} return string plan_note;
