plan_adjust_row(Pack plan_pack, Plan_book plan_book, Log_events plan_events, Plan_session plan_session, int plan_row) {
  int plan_item_number = lst_str_index(plan_book.catalog.items, plan_session.ids[plan_row]);
  int plan_concept_number = plan_first_concept(plan_book, plan_item_number);
  int[] plan_counts = plan_tally_until(plan_book, plan_events, plan_concept_number, len(plan_events.kinds));
} chain (Pack plan_pack, Plan_book plan_book, Log_events plan_events, Plan_session plan_session, int plan_row) {
  string plan_level = plan_level_of(plan_counts);
  int plan_target = plan_book.catalog.bases[plan_item_number] + plan_counts[(import plan_tally_fluent)] * (import plan_difficulty_step);
  int plan_swap = plan_best_candidate(plan_book, plan_pack, plan_session, plan_item_number, plan_concept_number, plan_level, plan_target);
} chain (Pack plan_pack, Plan_book plan_book, Log_events plan_events, Plan_session plan_session, int plan_row) {
  if (plan_swap != plan_item_number) {
    plan_session.reasons[plan_row] = plan_session.reasons[plan_row] + plan_swap_note(plan_pack, plan_book, plan_item_number, plan_swap, plan_level, plan_book.catalog.concepts[plan_concept_number]);
    plan_session.ids[plan_row] = plan_book.catalog.items[plan_swap];
  }
} return void;
