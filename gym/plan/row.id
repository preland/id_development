plan_adjust(Pack plan_pack, Plan_book plan_book, Log_events plan_events, Plan_session plan_session) {
  int plan_row = 0;
  int plan_has_parts = pack_has_parts(plan_pack);
  while (plan_has_parts == 1 && plan_row < len(plan_session.ids)) {
    if (plan_session.phases[plan_row] == "main") {
      plan_adjust_row(plan_pack, plan_book, plan_events, plan_session, plan_row);
    }
    plan_row = plan_row + 1;
  }
} chain (Pack plan_pack, Plan_book plan_book, Log_events plan_events, Plan_session plan_session) {
  int plan_concept_at = 0;
  while (plan_has_parts == 1 && plan_concept_at < len(plan_book.catalog.concepts)) {
    plan_order_concept(plan_pack, plan_book, plan_events, plan_session, plan_concept_at);
    plan_concept_at = plan_concept_at + 1;
  }
} return void;
