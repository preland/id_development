plan_new_concepts(Plan_book plan_book, Plan_learner plan_learner) {
  int[] plan_fresh = [];
  int plan_at = 0;
  while (plan_at < len(plan_learner.skill.counts) && len(plan_fresh) < (import plan_new_limit)) {
    if (plan_learner.skill.counts[plan_at] == 0 && plan_unlocked(plan_book, plan_learner, plan_at) == 1) {
      push(plan_fresh, plan_at);
    }
    plan_at = plan_at + 1;
  }
} return int[] plan_fresh;
