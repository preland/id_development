(Plan_learner(Plan_memory([], [], []), Plan_skill([1000.0, 1000.0], [0, 2]), Plan_shelf([], [], [])), 0):(0)
(Plan_learner(Plan_memory([], [], []), Plan_skill([1000.0, 1000.0], [0, 2]), Plan_shelf([], [], [])), -1):(0)

plan_unlocked(Plan_book plan_book, Plan_learner plan_learner, int plan_concept_number) {
  int plan_open = 1;
  int plan_at = 0;
  while (plan_at < len(plan_book.needs.need_concepts)) {
    if (plan_book.needs.need_concepts[plan_at] == plan_concept_number && plan_met(plan_learner, plan_book.needs.need_required[plan_at]) == 0) {
      return 0;
    }
    plan_at = plan_at + 1;
  }
} return int plan_open;
