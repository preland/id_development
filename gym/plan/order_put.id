plan_rows_write(Pack plan_pack, Plan_session plan_session, int[] plan_row_list, string[] plan_old_ids, string[] plan_new_ids, string[] plan_new_reasons, string plan_level, string plan_concept_id) {
  int plan_at = 0;
  while (plan_at < len(plan_row_list)) {
    plan_session.ids[plan_row_list[plan_at]] = plan_new_ids[plan_at];
    plan_session.reasons[plan_row_list[plan_at]] = plan_new_reasons[plan_at] + plan_moved_text(plan_pack, plan_old_ids[plan_at], plan_new_ids[plan_at], plan_level, plan_concept_id);
    plan_at = plan_at + 1;
  }
} return void;
