plan_mark_links(Plan_book plan_book, Plan_learner plan_learner, int[] plan_blocked, int[] plan_taken, int plan_seed, int[] plan_marks) {
  int plan_at = 0;
  int plan_probe_item = 0;
  while (plan_at < len(plan_book.links.link_items)) {
    plan_probe_item = plan_book.links.link_items[plan_at];
    if (plan_book.links.link_held[plan_at] == 1 && plan_blocked[plan_probe_item] == 0 && plan_taken[plan_probe_item] == 0) {
      lset(plan_marks, plan_probe_item, plan_learner.shelf.attempts[plan_probe_item] * 1000 + plan_noise(plan_seed, plan_probe_item));
    }
    plan_at = plan_at + 1;
  }
} return void;
