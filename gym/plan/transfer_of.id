plan_transfer_marks(Plan_book plan_book, Plan_learner plan_learner, int[] plan_taken, int plan_seed) {
  int[] plan_probe_marks = list_filled(len(plan_book.catalog.items), (import plan_item_none));
  int[] plan_blocked_items = list_filled(len(plan_book.catalog.items), 0);
  plan_block_links(plan_book, plan_learner, plan_blocked_items);
} chain (Plan_book plan_book, Plan_learner plan_learner, int[] plan_taken, int plan_seed) {
  plan_mark_links(plan_book, plan_learner, plan_blocked_items, plan_taken, plan_seed, plan_probe_marks);
} return int[] plan_probe_marks;
