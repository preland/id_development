// The marks of the transfer lane: one per item, lower first, plan_item_none for an
// item that may not be offered. A held-out item may be offered once every concept it
// tests has had an attempt (so a probe never comes before the idea it probes), and
// not when it is already in the session. Its mark is 1000 times the attempts it has
// had, so a probe never shown goes before one shown, plus seeded noise to order ties.
// plan_block_links marks the items that test a concept never attempted; plan_mark_links
// marks the held-out items that are not blocked.

plan_block_links(Plan_book plan_book, Plan_learner plan_learner, int[] plan_blocked) {
  int plan_at = 0;
  while (plan_at < len(plan_book.links.link_items)) {
    if (plan_learner.skill.counts[plan_book.links.link_concepts[plan_at]] == 0) {
      lset(plan_blocked, plan_book.links.link_items[plan_at], 1);
    }
    plan_at = plan_at + 1;
  }
} return void;
