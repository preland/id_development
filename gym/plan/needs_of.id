// The prerequisites of a pack: one row per (concept, requires:) pair, by position.
// A required id the pack does not define is kept as -1, so the concept that names
// it can never be unlocked; that is the safe reading of a broken pack.

plan_need_add(Plan_needs plan_needs, int plan_concept_number, int plan_required_number) {
  push(plan_needs.need_concepts, plan_concept_number);
  push(plan_needs.need_required, plan_required_number);
} return void;
(Plan_needs([], []), 3, 1):(Plan_needs([3], [1]))
(Plan_needs([0], [2]), 1, -1):(Plan_needs([0, 1], [2, -1]))

plan_need_concept(Plan_needs plan_needs, string[] plan_concept_ids, int plan_concept_number, string plan_text) {
  string[] plan_named = plan_pieces(plan_text);
  int plan_at = 0;
  int plan_looked = 0;
} chain (Plan_needs plan_needs, string[] plan_concept_ids, int plan_concept_number, string plan_text) {
  while (plan_at < len(plan_named)) {
    plan_looked = list_string_index(plan_concept_ids, plan_named[plan_at]);
    plan_need_add(plan_needs, plan_concept_number, plan_looked);
    plan_at = plan_at + 1;
  }
} return void;
(Plan_needs([], []), ["a", "b"], 1, "a"):(Plan_needs([1], [0]))
(Plan_needs([], []), ["a", "b"], 1, "ghost, a"):(Plan_needs([1, 1], [-1, 0]))
(Plan_needs([0], [1]), ["a", "b"], 0, ""):(Plan_needs([0], [1]))

plan_build_needs(Pack plan_pack, string[] plan_concept_ids) {
  int[] plan_concept_blocks = pack_blocks_of(plan_pack, "concept");
  int[] plan_empty_needing = [];
  int[] plan_empty_required = [];
} chain (Pack plan_pack, string[] plan_concept_ids) {
  Plan_needs plan_needs = Plan_needs(plan_empty_needing, plan_empty_required);
  int plan_at = 0;
  while (plan_at < len(plan_concept_blocks)) {
    plan_need_concept(plan_needs, plan_concept_ids, plan_at, pack_field(plan_pack, plan_concept_blocks[plan_at], "requires"));
    plan_at = plan_at + 1;
  }
} return Plan_needs plan_needs;
given pack_fixture_parse("concept: a\nconcept: b\nrequires: a\nconcept: c\nrequires: a, b\n") ((import pack_fixture_book), ["a", "b", "c"]):(Plan_needs([1, 2, 2], [0, 0, 1]))
given pack_fixture_parse("concept: a\nrequires: ghost\n") ((import pack_fixture_book), ["a"]):(Plan_needs([0], [-1]))
given pack_fixture_parse("") ((import pack_fixture_book), []):(Plan_needs([], []))
