(Plan_book(Plan_catalog(["c", "d"], ["i", "j"], [1000, 1000]), Plan_links([0, 1, 1], [0, 0, 1], [0, 0, 0]), Plan_needs([], [])), -1, 0):(0)

plan_tally_event(Plan_book plan_book, Log_events plan_events, int plan_index, int plan_concept_number, int[] plan_tally) {
  if (plan_events.kinds[plan_index] != "attempt") {
    return;
  }
  string plan_verdict_seen = log_text_at(plan_events, plan_index, (import log_slot_verdict));
  int plan_item_found = lst_str_index(plan_book.catalog.items, log_text_at(plan_events, plan_index, (import log_slot_item)));
} chain (Plan_book plan_book, Log_events plan_events, int plan_index, int plan_concept_number, int[] plan_tally) {
  int plan_member = plan_verdict_seen != "pending" && plan_item_found >= 0 && plan_item_in_concept(plan_book, plan_item_found, plan_concept_number) == 1;
  int plan_missed = plan_verdict_seen != "correct" || log_tapped_at(plan_events, plan_index) == 1;
  int plan_hints_seen = log_number_at(plan_events, plan_index, (import log_slot_hints));
} chain (Plan_book plan_book, Log_events plan_events, int plan_index, int plan_concept_number, int[] plan_tally) {
  int plan_sure = log_number_at(plan_events, plan_index, (import log_slot_confidence)) >= (import score_confident_level);
  int plan_clean = plan_missed == 0 && plan_hints_seen == 0;
  int plan_quick = log_number_at(plan_events, plan_index, (import log_slot_seconds)) <= (import plan_fast_seconds);
} chain (Plan_book plan_book, Log_events plan_events, int plan_index, int plan_concept_number, int[] plan_tally) {
  if (plan_member == 1) {
    plan_tally[(import plan_tally_attempts)] = plan_tally[(import plan_tally_attempts)] + 1;
    plan_tally[(import plan_tally_misses)] = plan_tally[(import plan_tally_misses)] + plan_missed;
    plan_tally[(import plan_tally_clean)] = plan_tally[(import plan_tally_clean)] + plan_clean;
  }
  if (plan_member == 1) {
    plan_tally[(import plan_tally_sure_errors)] = plan_tally[(import plan_tally_sure_errors)] + (plan_missed == 1 && plan_sure == 1);
    plan_tally[(import plan_tally_fluent)] = plan_clean == 1 && plan_sure == 1 && plan_quick == 1;
  }
} return void;
