plan_tally_until(Plan_book plan_book, Log_events plan_events, int plan_concept_number, int plan_until) {
  int[] plan_tally = [0, 0, 0, 0, 0];
  int plan_at = 0;
  while (plan_at < plan_until && plan_at < len(plan_events.kinds)) {
    plan_tally_event(plan_book, plan_events, plan_at, plan_concept_number, plan_tally);
    plan_at = plan_at + 1;
  }
} return int[] plan_tally;
