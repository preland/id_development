plan_row_keys(Pack plan_pack, Plan_book plan_book, Plan_session plan_session, int[] plan_row_list, string plan_level) {
  int[] plan_keys = [];
  int plan_at = 0;
  while (plan_at < len(plan_row_list)) {
    push(plan_keys, plan_kind_key(plan_pack, plan_book, plan_session.ids[plan_row_list[plan_at]], plan_level));
    plan_at = plan_at + 1;
  }
} return int[] plan_keys;
