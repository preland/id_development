plan_kind_key(Pack plan_pack, Plan_book plan_book, string plan_item_id, string plan_level) {
  string plan_key_kind = pack_field(plan_pack, pack_find(plan_pack, "item", plan_item_id), "kind");
  int plan_item_place = list_string_index(plan_book.catalog.items, plan_item_id);
  int plan_sort_key = plan_kind_rank(plan_level, plan_key_kind) * 10000 + plan_book.catalog.bases[plan_item_place];
} return int plan_sort_key;
