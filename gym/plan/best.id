// The best item to give for a concept: the one already planned or, when another
// practice item of the concept scores strictly lower (retarget.id), that item.
// Answers the item's number in the book.

plan_best_candidate(Plan_book plan_book, Pack plan_pack, Plan_session plan_session, int plan_current_item, int plan_concept_number, string plan_level, int plan_target) {
  int plan_best = plan_current_item;
  int plan_best_score = plan_candidate_score(plan_book, plan_pack, plan_current_item, plan_level, plan_target);
  int plan_at = 0;
} chain (Plan_book plan_book, Pack plan_pack, Plan_session plan_session, int plan_current_item, int plan_concept_number, string plan_level, int plan_target) {
  while (plan_at < len(plan_book.links.link_items)) {
    int plan_score_here = plan_link_score(plan_book, plan_pack, plan_session, plan_concept_number, plan_level, plan_target, plan_at);
    if (plan_score_here < plan_best_score) {
      plan_best = plan_book.links.link_items[plan_at];
      plan_best_score = plan_score_here;
    }
    plan_at = plan_at + 1;
  }
} return int plan_best;
