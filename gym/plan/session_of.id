plan_due_count(Plan_learner plan_learner, word plan_at_time) {
  int plan_due_total = 0;
  int plan_at = 0;
  while (plan_at < len(plan_learner.memory.lasts)) {
    if (plan_recall_score(plan_learner, plan_at, plan_at_time) <= (import plan_due_score)) {
      plan_due_total = plan_due_total + 1;
    }
    plan_at = plan_at + 1;
  }
} return int plan_due_total;
