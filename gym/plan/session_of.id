// The session plan, four phases in 25 minutes. Rows come out in the order the
// learner meets them, each tagged with its phase and its reason:
//   "warmup"   5 min  due reviews, cold: hints are not offered (plan_hints_allowed)
//   "main"    13 min  weak concepts first, then new ones; items chosen so the expected
//                     first-try success sits in the 75 to 85 percent band when it can
//   "transfer" 5 min  one or two held-out items from concepts already practised
//   the cooldown (2 min) has no items: it shows plan_due_count for tomorrow.
// The clock (now, in ms since the epoch) and the seed are arguments, so a plan for a
// fixed time and seed is always the same. No item is in a plan twice.

plan_build_session(Plan_book plan_book, Plan_learner plan_learner, word plan_now, int plan_seed) {
  string[] plan_plan_ids = [];
  string[] plan_plan_phases = [];
  string[] plan_plan_reasons = [];
} chain (Plan_book plan_book, Plan_learner plan_learner, word plan_now, int plan_seed) {
  Plan_session plan_planned = Plan_session(plan_plan_ids, plan_plan_phases, plan_plan_reasons);
  int[] plan_used_items = lst_filled(len(plan_book.catalog.items), 0);
  int[] plan_recall_marks = plan_scores(plan_learner, plan_now);
} chain (Plan_book plan_book, Plan_learner plan_learner, word plan_now, int plan_seed) {
  plan_warm_up(plan_book, plan_learner, plan_now, plan_recall_marks, plan_used_items, plan_planned);
  plan_main(plan_book, plan_learner, plan_now, plan_seed, plan_recall_marks, plan_used_items, plan_planned);
  plan_transfer(plan_book, plan_learner, plan_used_items, plan_seed, plan_planned);
} return Plan_session plan_planned;
