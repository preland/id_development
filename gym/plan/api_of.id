given plan_world_parse(1) ((import plan_fixture_pack), Log_events([], [], []), 864000000, 0):(Plan_session(["coin_1", "coin_2"], ["main", "main"], ["new: no prerequisites; expected first-try success 76%", "new: no prerequisites; expected first-try success 50%"]))

plan_why(Plan_session plan_session_in, string plan_item_identifier_in) {
  int plan_row_found = list_string_index(plan_session_in.identifiers, plan_item_identifier_in);
  string plan_why_line = "";
  if (plan_row_found >= 0) {
    plan_why_line = plan_session_in.reasons[plan_row_found];
  }
} return string plan_why_line;
