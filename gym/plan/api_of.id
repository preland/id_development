// What the CLI and the window call. plan_for_log goes from a loaded pack and a
// replayed log to a plan in one step; plan_why answers the "why am I seeing this?"
// question for one item of a plan ("" when the item is not in it). A program that
// also needs the learner (for plan_due_count, say) calls plan_build_book and
// plan_replay itself, then plan_build_session.

plan_for_log(Pack plan_pack, Log_events plan_events, word plan_now, int plan_seed) {
  Plan_book plan_book = plan_build_book(plan_pack);
  Plan_learner plan_learner = plan_replay(plan_book, plan_events);
  Plan_session plan_planned = plan_build_session(plan_book, plan_learner, plan_now, plan_seed);
} chain (Pack plan_pack, Log_events plan_events, word plan_now, int plan_seed) {
  plan_adjust(plan_pack, plan_book, plan_events, plan_planned);
  plan_with_synthesis(plan_pack, plan_book, plan_learner, plan_events, plan_now, plan_planned);
} return Plan_session plan_planned;
