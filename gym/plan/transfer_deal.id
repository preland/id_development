// The transfer finisher: up to plan_transfer_slots held-out items, lowest mark first,
// each tagged "transfer". Items come only from concepts the learner has already
// practised, and they are never offered anywhere else in the plan.

plan_transfer(Plan_book plan_book, Plan_learner plan_learner, int[] plan_taken, int plan_seed, Plan_session plan_session) {
  int[] plan_probe_marks = plan_transfer_marks(plan_book, plan_learner, plan_taken, plan_seed);
  int plan_probe = plan_strike(plan_probe_marks, (import plan_item_none) - 1, (import plan_item_none));
  int plan_probes_given = 0;
} chain (Plan_book plan_book, Plan_learner plan_learner, int[] plan_taken, int plan_seed, Plan_session plan_session) {
  while (plan_probe >= 0 && plan_probes_given < (import plan_transfer_slots)) {
    plan_push(plan_session, plan_taken, plan_probe, plan_book.catalog.items[plan_probe], "transfer", plan_why_transfer(plan_book, plan_probe));
    plan_probe = plan_strike(plan_probe_marks, (import plan_item_none) - 1, (import plan_item_none));
    plan_probes_given = plan_probes_given + 1;
  }
} return void;
