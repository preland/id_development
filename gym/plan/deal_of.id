// Dealing review rows, which are the warm-up and the weak part of the main set. A
// concept qualifies when its recall score in marks is at or under the limit; the
// lowest goes first, is struck from marks, and gets the item plan_choose offers
// (no row if it has none left). The warm-up reviews are cold: its phase is "warmup",
// the only phase in which hints are not offered (plan_hints_allowed).

plan_deal_review(Plan_book plan_book, Plan_learner plan_learner, word plan_now, int[] plan_marks, int[] plan_taken, Plan_session plan_session, int plan_limit, string plan_phase, string plan_label) {
  int plan_pick = plan_strike(plan_marks, plan_limit, (import plan_never_score));
  int plan_item_pick = 0 - 1;
  if (plan_pick >= 0) {
    plan_item_pick = plan_choose(plan_book, plan_learner, plan_pick, plan_taken);
  }
} chain (Plan_book plan_book, Plan_learner plan_learner, word plan_now, int[] plan_marks, int[] plan_taken, Plan_session plan_session, int plan_limit, string plan_phase, string plan_label) {
  if (plan_item_pick >= 0) {
    plan_push(plan_session, plan_taken, plan_item_pick, plan_book.catalog.items[plan_item_pick], plan_phase, plan_why_review(plan_learner, plan_pick, plan_item_pick, plan_now, plan_label));
  }
} return void;
