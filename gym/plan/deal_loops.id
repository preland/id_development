plan_weak(Plan_book plan_book, Plan_learner plan_learner, word plan_now, int[] plan_marks, int[] plan_taken, Plan_session plan_rows, int[] plan_keys, int plan_seed, int plan_quota) {
  int plan_rows_before = 0;
  while (plan_lowest(plan_marks, (import plan_mastery_score)) >= 0 && len(plan_rows.identifiers) < plan_quota) {
    plan_rows_before = len(plan_rows.identifiers);
    plan_deal_review(plan_book, plan_learner, plan_now, plan_marks, plan_taken, plan_rows, (import plan_mastery_score), "main", "weak");
    if (len(plan_rows.identifiers) > plan_rows_before) {
      push(plan_keys, plan_key(plan_seed, plan_rows_before % (import plan_depth), plan_rows_before));
    }
  }
} return void;
