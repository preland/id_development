// The two loops over plan_deal_review. The warm-up deals concepts whose recall is
// at or under plan_due_score until it holds plan_warm_up_slots rows. The weak part of
// the main set deals concepts under plan_mastery_score until it holds a quota of
// rows, giving each row a sort key: its round is its position modulo plan_depth, so
// the weak rows spread over the rounds the new concepts also use.

plan_warm_up(Plan_book plan_book, Plan_learner plan_learner, word plan_now, int[] plan_marks, int[] plan_taken, Plan_session plan_session) {
  while (plan_lowest(plan_marks, (import plan_due_score)) >= 0 && len(plan_session.identifiers) < (import plan_warm_up_slots)) {
    plan_deal_review(plan_book, plan_learner, plan_now, plan_marks, plan_taken, plan_session, (import plan_due_score), "warmup", "due");
  }
} return void;
