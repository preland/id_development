// Choosing the synthesis item to offer. plan_synthesis_tries answers how often
// the learner has attempted an item when it is a synthesis item that is unlocked
// (synthesis.id) and not already in the plan, and plan_item_none for anything
// else; plan_synthesis_pick then takes the item attempted least often, the
// earliest in the pack on a tie, and answers -1 when none qualifies. Preferring
// the least attempted keeps one synthesis item from coming back while another is
// still new.

plan_synthesis_tries(Pack plan_pack, Plan_book plan_book, Plan_learner plan_learner, Log_events plan_events, word plan_now, Plan_session plan_session, int plan_item_number) {
  int plan_tries = (import plan_item_none);
  string plan_item_id = plan_book.catalog.items[plan_item_number];
  string plan_item_kind = pack_field(plan_pack, pack_find(plan_pack, "item", plan_item_id), "kind");
} chain (Pack plan_pack, Plan_book plan_book, Plan_learner plan_learner, Log_events plan_events, word plan_now, Plan_session plan_session, int plan_item_number) {
  if (plan_item_kind == "synthesis" && list_string_index(plan_session.ids, plan_item_id) < 0 && plan_synthesis_ready(plan_book, plan_learner, plan_events, plan_now, plan_item_number) == 1) {
    plan_tries = plan_learner.shelf.attempts[plan_item_number];
  }
} return int plan_tries;
