plan_synthesis_pick(Pack plan_pack, Plan_book plan_book, Plan_learner plan_learner, Log_events plan_events, word plan_now, Plan_session plan_session) {
  int plan_picked = 0 - 1;
  int plan_picked_tries = (import plan_item_none);
  int plan_at = 0;
} chain (Pack plan_pack, Plan_book plan_book, Plan_learner plan_learner, Log_events plan_events, word plan_now, Plan_session plan_session) {
  while (plan_at < len(plan_book.catalog.items)) {
    int plan_tries_here = plan_synthesis_tries(plan_pack, plan_book, plan_learner, plan_events, plan_now, plan_session, plan_at);
    if (plan_tries_here < plan_picked_tries) {
      plan_picked = plan_at;
      plan_picked_tries = plan_tries_here;
    }
    plan_at = plan_at + 1;
  }
} return int plan_picked;
