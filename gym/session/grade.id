session_self_grade(Pack session_book, string session_log_path, word session_now, string session_met_text) {
  Log_replay session_replayed = log_replay(session_log_path);
  string[] session_shown = session_view(session_replayed.events);
  string session_escaped = log_escape(session_shown[(import session_slot_item)]);
} chain (Pack session_book, string session_log_path, word session_now, string session_met_text) {
  int session_waiting_at = log_pending_index(session_replayed.events, session_escaped, len(session_replayed.events.kinds));
  int session_block = pack_find(session_book, "item", session_shown[(import session_slot_item)]);
  string session_refusal = "";
} chain (Pack session_book, string session_log_path, word session_now, string session_met_text) {
  if (session_waiting_at < 0 || session_block < 0) {
    session_refusal = "no free answer is waiting to be graded: answer a free item with gym answer first";
  }
  string[] session_rubric = [];
  string session_marks = "";
} chain (Pack session_book, string session_log_path, word session_now, string session_met_text) {
  if (session_refusal == "") {
    session_rubric = pack_fields(session_book, session_block, "rubric");
    session_marks = session_met_marks(session_met_text, len(session_rubric));
  }
  string session_verdict = session_verdict_of(session_marks);
  int session_written = 0 - 1;
} chain (Pack session_book, string session_log_path, word session_now, string session_met_text) {
  if (session_refusal == "" && session_marks == "") {
    session_refusal = "the rubric has " + len(session_rubric) + " line(s): pass --met with " + len(session_rubric) + " values, each 1 (met) or 0 (not met), such as --met " + session_met_example(len(session_rubric));
  }
  if (session_refusal == "") {
    session_written = log_record_graded(session_log_path, session_now, session_shown[(import session_slot_item)], session_verdict, "self", session_marks);
  }
  if (session_refusal == "" && session_written < 0) {
    session_refusal = "the log could not be written";
  }
} chain (Pack session_book, string session_log_path, word session_now, string session_met_text) {
  string[] session_result = ["refused", session_refusal];
  if (session_refusal == "") {
    session_result = ["ok", "", session_verdict, session_marks, session_shown[(import session_slot_item)], str_join(session_rubric, "\n")];
  }
} return string[] session_result;
