session_route_free(Pack session_book, string session_log_path, word session_now, string session_url) {
  Log_replay session_replayed = log_replay(session_log_path);
  string[] session_shown = session_view(session_replayed.events);
  string session_item_id = session_shown[(import session_slot_item)];
} chain (Pack session_book, string session_log_path, word session_now, string session_url) {
  string session_escaped = log_escape(session_item_id);
  int session_waiting_at = log_pending_index(session_replayed.events, session_escaped, len(session_replayed.events.kinds));
  string[] session_feedback = grade_outcome("refused", "no free answer is waiting");
} chain (Pack session_book, string session_log_path, word session_now, string session_url) {
  if (session_waiting_at >= 0) {
    session_feedback = grade_attempt(session_url, session_log_path, session_waiting_at, session_book, session_item_id);
  }
  string[] session_route = session_take_feedback(session_log_path, session_now, session_item_id, session_feedback);
} return string[] session_route;
