session_attempt_index(Log_events session_events, int session_plan_at, int session_which) {
  int session_found = 0 - 1;
  int session_seen = 0;
  int session_at = session_plan_at + 1;
} chain (Log_events session_events, int session_plan_at, int session_which) {
  while (session_at < len(session_events.kinds)) {
    if (session_events.kinds[session_at] == "attempt" && session_seen == session_which) {
      session_found = session_at;
    }
    session_seen = session_seen + (session_events.kinds[session_at] == "attempt");
    session_at = session_at + 1;
  }
} return int session_found;
