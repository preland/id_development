session_count_after(Log_events session_events, int session_plan_at, string session_kind) {
  int session_total = 0;
  int session_at = session_plan_at + 1;
  while (session_at < len(session_events.kinds)) {
    session_total = session_total + (session_events.kinds[session_at] == session_kind);
    session_at = session_at + 1;
  }
} return int session_total;
