// The presentation that goes with a result: session_show_item looks at the newest
// attempt at an item and answers [lines, reason, belief], where reason is the line
// `gym why` prints, lines are the presentation texts to show (empty when the
// policy says to add nothing) and belief is the written misconception the answer
// resembles ("" when none). A free answer still waiting for its grade gets no
// presentation, since whether it was right is not known. session_show_attempt does
// it for one attempt, from the learner's history on the item's first concept up
// to that attempt (plan_tally_until, plan_present_choice); session_show_lines words
// the kinds the policy chose, in order. A synthesis or compare item also gets its `bridge` line, the general
// principle it makes the learner extract, shown only now that the attempt is made. Presentations belong to version 2 packs: a
// pack with no `part:` anywhere has none, so its results are shown exactly as before.

session_show_lines(Pack session_book, int session_concept_block, int session_item_block, string session_kinds_text, string session_mode, string session_basis, int session_rotate) {
  string[] session_kinds = [];
  string[] session_rows = [];
  int session_at = 0;
} chain (Pack session_book, int session_concept_block, int session_item_block, string session_kinds_text, string session_mode, string session_basis, int session_rotate) {
  if (session_kinds_text != "" && session_concept_block >= 0) {
    session_kinds = str_split(session_kinds_text, ",");
  }
  while (session_at < len(session_kinds)) {
    push(session_rows, session_line(session_book, session_concept_block, session_item_block, session_kinds[session_at], session_mode, session_basis, session_rotate));
    session_at = session_at + 1;
  }
  string session_bridge_text = pack_field(session_book, session_item_block, "bridge");
} chain (Pack session_book, int session_concept_block, int session_item_block, string session_kinds_text, string session_mode, string session_basis, int session_rotate) {
  if (session_bridge_text != "") {
    push(session_rows, "  the general idea (bridge): " + session_bridge_text);
  }
  string session_joined = str_join(session_rows, "\n");
} return string session_joined;
