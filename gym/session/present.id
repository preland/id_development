session_show_item(Pack session_book, Log_events session_events, string session_item_id) {
  int session_attempt_at = session_last_attempt(session_events, log_escape(session_item_id));
  string[] session_nothing = ["", "", ""];
  if (session_attempt_at >= 0 && log_text_at(session_events, session_attempt_at, (import log_slot_verdict)) == "pending") {
    session_nothing = ["", "waiting for a grade on your free answer: mark it with gym selfgrade", ""];
  }
} chain (Pack session_book, Log_events session_events, string session_item_id) {
  if (session_attempt_at >= 0 && log_text_at(session_events, session_attempt_at, (import log_slot_verdict)) != "pending" && pack_has_parts(session_book) == 1) {
    session_nothing = session_show_attempt(session_book, session_events, session_attempt_at);
  }
} return string[] session_nothing;
