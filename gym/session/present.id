session_show_attempt(Pack session_book, Log_events session_events, int session_attempt_at) {
  Plan_book session_numbers = plan_build_book(session_book);
  string session_item_id = log_text_at(session_events, session_attempt_at, (import log_slot_item));
  int session_item_block = pack_find(session_book, "item", session_item_id);
} chain (Pack session_book, Log_events session_events, int session_attempt_at) {
  string[] session_listed = plan_pieces(pack_field(session_book, session_item_block, "concepts"));
  string session_concept_id = "";
  if (len(session_listed) > 0) {
    session_concept_id = session_listed[0];
  }
} chain (Pack session_book, Log_events session_events, int session_attempt_at) {
  int session_concept_block = pack_find(session_book, "concept", session_concept_id);
  int session_concept_number = lst_str_index(session_numbers.catalog.concepts, session_concept_id);
  int[] session_counts = plan_tally_until(session_numbers, session_events, session_concept_number, session_attempt_at);
} chain (Pack session_book, Log_events session_events, int session_attempt_at) {
  string[] session_choice = plan_present_choice(log_text_at(session_events, session_attempt_at, (import log_slot_verdict)), log_number_at(session_events, session_attempt_at, (import log_slot_confidence)), log_number_at(session_events, session_attempt_at, (import log_slot_hints)), log_number_at(session_events, session_attempt_at, (import log_slot_seconds)), session_counts[(import plan_tally_misses)]);
  string session_basis_text = pack_field(session_book, session_item_block, "prompt") + " " + log_text_at(session_events, session_attempt_at, (import log_slot_answer));
  int session_aimed = str_find(session_choice[0], "non_example") >= 0;
} chain (Pack session_book, Log_events session_events, int session_attempt_at) {
  string session_belief_found = "";
  if (session_aimed == 1) {
    session_belief_found = session_belief(session_book, session_concept_block, session_basis_text);
  }
  string session_target = session_basis_text;
} chain (Pack session_book, Log_events session_events, int session_attempt_at) {
  if (session_belief_found != "") {
    session_target = session_belief_found;
  }
  string session_lines_found = session_show_lines(session_book, session_concept_block, session_item_block, session_choice[0], session_choice[1], session_target, session_counts[(import plan_tally_misses)]);
  string[] session_shown_set = [session_lines_found, session_choice[2], session_belief_found];
} return string[] session_shown_set;
