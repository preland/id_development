session_view(Log_events session_events) {
  string[] session_shown = ["none", "", "", "", "", "", "0", "no"];
  int session_plan_at = session_plan_index(session_events);
  if (session_plan_at < 0) {
    return session_shown;
  }
} chain (Log_events session_events) {
  string[] session_ids = session_list(session_events, session_plan_at, (import log_slot_ids), ",");
  int session_moved = session_count_after(session_events, session_plan_at, "session_next");
  int session_answered = session_count_after(session_events, session_plan_at, "attempt");
} chain (Log_events session_events) {
  int session_closed = session_count_after(session_events, session_plan_at, "session_end");
  string session_state = "waiting";
  if (session_answered > session_moved) {
    session_state = "committed";
  }
} chain (Log_events session_events) {
  if (session_moved >= len(session_ids)) {
    session_state = "over";
  }
  if (session_closed > 0) {
    session_state = "closed";
  }
  session_shown = [session_state, "" + (session_moved + 1), "" + len(session_ids), "", "", "", "0", "no"];
} chain (Log_events session_events) {
  if (session_moved < len(session_ids)) {
    session_shown = session_item_view(session_events, session_plan_at, session_moved, session_state, len(session_ids));
  }
} return string[] session_shown;
