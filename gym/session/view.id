// Where the current session stands, from the log alone: eight text slots (the
// session_slot_* constants) that a command prints and a window can paint. The
// state is none (no session started), waiting (the item on screen has no
// attempt yet), committed (it has one and the learner has not moved on), over
// (every item has been moved past) or closed (a session_end followed the plan).
// The item on screen is the one after the session_next events seen so far, which
// is how a hint knows the attempt it follows: it may be given only while the
// state is committed.

session_item_view(Log_events session_events, int session_plan_at, int session_moved, string session_state, int session_total) {
  string[] session_ids = session_list(session_events, session_plan_at, (import log_slot_ids), ",");
  string[] session_phases = session_list(session_events, session_plan_at, (import log_slot_phases), ",");
  string[] session_reasons = session_list(session_events, session_plan_at, (import log_slot_reasons), "\n");
} chain (Log_events session_events, int session_plan_at, int session_moved, string session_state, int session_total) {
  int session_hints = session_hint_count(session_events, session_plan_at, session_ids[session_moved]);
  int session_try = session_attempt_index(session_events, session_plan_at, session_moved);
  string session_flag = "no";
} chain (Log_events session_events, int session_plan_at, int session_moved, string session_state, int session_total) {
  if (session_try >= 0) {
    session_flag = (import log_flags)[log_tapped_at(session_events, session_try)];
  }
  string[] session_item_shown = [session_state, "" + (session_moved + 1), "" + session_total, session_ids[session_moved], session_phases[session_moved], session_reasons[session_moved], "" + session_hints, session_flag];
} return string[] session_item_shown;
