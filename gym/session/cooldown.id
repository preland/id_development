// The cooldown at the end of a session (spec, "A session", step 4): where the
// learner's confidence was off, and how many concepts will be due a day on.
// session_misses lists the attempts of the current session that were wrong at a
// confidence of 90 or more, newest last, as "item (99%)" (hypercorrection, P10:
// these are the ones worth a sentence). session_cool_down_text writes the lines
// from the pack, the replayed log and the clock; the due count is the planner's
// own (plan_due_count) a day after the clock.

session_misses(Log_events session_events, int session_plan_at) {
  string[] session_missed = [];
  int session_at = session_plan_at + 1;
  while (session_at < len(session_events.kinds)) {
    if (session_events.kinds[session_at] == "attempt" && log_number_at(session_events, session_at, (import log_slot_confidence)) >= (import score_confident_level) && log_text_at(session_events, session_at, (import log_slot_verdict)) != "correct") {
      push(session_missed, log_text_at(session_events, session_at, (import log_slot_item)) + " (" + log_text_at(session_events, session_at, (import log_slot_confidence)) + "%)");
    }
    session_at = session_at + 1;
  }
} return string[] session_missed;
given log_fixture_parse("1\tsession_plan\ta,b\tmain,main\tr\\nr\n2\tattempt\ta\tx\t99\tincorrect\t0\t5\tno\t\n3\tattempt\tb\tx\t90\tcorrect\t0\t5\tno\t\n") ((import log_fixture_events), 0):(["a (99%)"])
