given log_fixture_parse("1\tsession_plan\ta,b\tmain,main\tr\\nr\n2\tattempt\ta\tx\t99\tincorrect\t0\t5\tno\t\n3\tattempt\tb\tx\t99\tincorrect\t0\t5\tno\t\n") ((import log_fixture_events), 0):(["a (99%)", "b (99%)"])

session_cool_down_text(Pack session_book, Log_events session_events, word session_now) {
  Plan_book session_numbers = plan_build_book(session_book);
  Plan_learner session_learner = plan_replay(session_numbers, session_events);
  int session_plan_at = session_plan_index(session_events);
} chain (Pack session_book, Log_events session_events, word session_now) {
  string[] session_missed = session_misses(session_events, session_plan_at);
  string[] session_ids = session_list(session_events, session_plan_at, (import log_slot_ids), ",");
  int session_due = plan_due_count(session_learner, session_now + (import score_day));
} chain (Pack session_book, Log_events session_events, word session_now) {
  string session_calibration = "none this session: your confidence matched your results";
  if (len(session_missed) > 0) {
    session_calibration = "wrong at 90% or more confidence: " + str_join(session_missed, ", ");
  }
  string session_text = "session complete\nitems this session: " + len(session_ids) + "\n" + session_calibration + "\nconcepts due a day from now: " + session_due;
} return string session_text;
