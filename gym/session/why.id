// "Why am I seeing this?" (P11) for one item. If the current session's plan holds
// the item, the answer is the reason written into that plan when the session
// started, with the item's place in it. If not, a plan made now from the same pack
// and log is asked, and the answer says so. An item the pack does not have, or one
// no plan would include, is said plainly rather than given an invented reason.

session_reason(Pack session_book, Log_events session_events, string session_item_id, word session_now, int session_seed) {
  int session_block = pack_find(session_book, "item", session_item_id);
  int session_plan_at = session_plan_index(session_events);
  string session_text = "unknown item: the pack has no item " + session_item_id;
} chain (Pack session_book, Log_events session_events, string session_item_id, word session_now, int session_seed) {
  string[] session_ids = [];
  string[] session_reasons = [];
  if (session_block >= 0 && session_plan_at >= 0) {
    session_ids = session_list(session_events, session_plan_at, (import log_slot_ids), ",");
    session_reasons = session_list(session_events, session_plan_at, (import log_slot_reasons), "\n");
  }
} chain (Pack session_book, Log_events session_events, string session_item_id, word session_now, int session_seed) {
  int session_row = list_string_index(session_ids, session_item_id);
  Plan_session session_fresh = plan_for_log(session_book, session_events, session_now, session_seed);
  string session_fresh_reason = plan_why(session_fresh, session_item_id);
} chain (Pack session_book, Log_events session_events, string session_item_id, word session_now, int session_seed) {
  if (session_block >= 0) {
    session_text = session_item_id + " is not in the current session, and a plan made now would not include it";
  }
  if (session_block >= 0 && session_fresh_reason != "") {
    session_text = session_item_id + " is not in the current session; a plan made now would include it: " + session_fresh_reason;
  }
  if (session_row >= 0) {
    session_text = session_item_id + " (place " + (session_row + 1) + " in the current session): " + session_reasons[session_row];
  }
} return string session_text;
given log_fixture_parse("1\tsession_plan\ta,b\twarmup,main\tdue: x\\nnew: y\n") given model_fixture_pack("concept: c\nitem: a\nconcepts: c\ndifficulty: 1000\nitem: b\nconcepts: c\ndifficulty: 1000\n") ((import model_fixture_book), (import log_fixture_events), "b", 100, 1):("b (place 2 in the current session): new: y")
given log_fixture_parse("1\tsession_plan\ta,b\twarmup,main\tdue: x\\nnew: y\n") given model_fixture_pack("concept: c\nitem: a\nconcepts: c\ndifficulty: 1000\n") ((import model_fixture_book), (import log_fixture_events), "zzz", 100, 1):("unknown item: the pack has no item zzz")
given log_fixture_parse("") given model_fixture_pack("concept: c\nitem: a\nconcepts: c\ndifficulty: 1000\nitem: b\nconcepts: c\ndifficulty: 1500\n") ((import model_fixture_book), (import log_fixture_events), "a", 100, 1):("a is not in the current session; a plan made now would include it: new: no prerequisites; expected first-try success 50%")
