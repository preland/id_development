session_move_refusal(Log_events session_events, string[] session_shown) {
  string session_refusal = session_move_gate(session_shown);
  int session_ungraded_now = session_ungraded(session_events, session_shown);
  if (session_refusal == "" && session_ungraded_now == 1) {
    session_refusal = "this free answer is not graded yet: run gym selfgrade --met 1,0,... (one 1 or 0 per rubric line) so it counts, then gym next";
  }
} return string session_refusal;
(Log_events([1], ["attempt"], [["1", "attempt", "a", "x", "70", "pending", "0", "5", "no", ""]]), ["committed", "1", "2", "a", "main", "r", "0", "no"]):("this free answer is not graded yet: run gym selfgrade --met 1,0,... (one 1 or 0 per rubric line) so it counts, then gym next")
(Log_events([1], ["attempt"], [["1", "attempt", "a", "x", "70", "correct", "0", "5", "no", ""]]), ["committed", "1", "2", "a", "main", "r", "0", "no"]):("")
