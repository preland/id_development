// Moving on to the next item. A session_next event is appended only once the item
// on screen has an attempt (answered or tapped out), so a learner cannot skip a
// rep without a trace; moving past the last item also appends session_end, which
// closes the session. session_move_gate says why not ("" when the move may
// happen); an item list that is already past its end may still be closed.
// session_move_on answers ["refused", why] or ["ok", "", "open"] or
// ["ok", "", "closed"].

session_move_gate(string[] session_shown) {
  string session_refusal = "";
  if (session_shown[(import session_slot_state)] == "none") {
    session_refusal = "no session is running: start one with gym session start";
  }
  if (session_refusal == "" && session_shown[(import session_slot_state)] == "closed") {
    session_refusal = "the session is closed: start another with gym session start";
  }
} chain (string[] session_shown) {
  if (session_refusal == "" && session_shown[(import session_slot_state)] == "waiting") {
    session_refusal = "answer this item or tap out first: the next item opens only after an attempt";
  }
} return string session_refusal;
(["none", "", "", "", "", "", "0", "no"]):("no session is running: start one with gym session start")
(["closed", "3", "2", "", "", "", "0", "no"]):("the session is closed: start another with gym session start")
(["waiting", "1", "2", "a", "main", "r", "0", "no"]):("answer this item or tap out first: the next item opens only after an attempt")
(["committed", "1", "2", "a", "main", "r", "0", "no"]):("")
(["over", "3", "2", "", "", "", "0", "no"]):("")

session_move_on(string session_log_path, word session_now) {
  Log_replay session_replayed = log_replay(session_log_path);
  string[] session_shown = session_view(session_replayed.events);
  string session_refusal = session_move_refusal(session_replayed.events, session_shown);
} chain (string session_log_path, word session_now) {
  int session_written = 0 - 1;
  int session_ending = session_refusal == "" && (session_shown[(import session_slot_state)] == "over" || session_shown[(import session_slot_number)] == session_shown[(import session_slot_total)]);
  if (session_refusal == "" && session_shown[(import session_slot_state)] == "committed") {
    session_written = log_record_next(session_log_path, session_now, session_shown[(import session_slot_item)]);
  }
} chain (string session_log_path, word session_now) {
  int session_ended = 0 - 1;
  if (session_ending == 1) {
    session_ended = log_record_session(session_log_path, session_now, "end");
  }
  if (session_refusal == "" && session_shown[(import session_slot_state)] == "committed" && session_written < 0) {
    session_refusal = "the log could not be written";
  }
} chain (string session_log_path, word session_now) {
  if (session_refusal == "" && session_ending == 1 && session_ended < 0) {
    session_refusal = "the log could not be written";
  }
  string[] session_result = ["refused", session_refusal];
  if (session_refusal == "") {
    session_result = ["ok", "", "open"];
  }
} chain (string session_log_path, word session_now) {
  if (session_refusal == "" && session_ending == 1) {
    session_result = ["ok", "", "closed"];
  }
} return string[] session_result;
given model_fixture_log_file("1\tsession_plan\ta,b\tmain,main\tr1\\nr2\n2\tattempt\ta\t1/2\t90\tincorrect\t0\t5\tno\t\n") ((import model_fixture_log), 100):(["ok", "", "open"]) then model_fixture_size:(92)
