given model_fixture_log_file("1\tsession_plan\ta,b\twarmup,main\tr1\\nr2\n2\tattempt\ta\t1/2\t90\tincorrect\t0\t5\tno\t\n") given model_fixture_pack("item: a\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\nhint_nudge: Begin.\nhint_question: Ask.\nhint_step: Step.\nhint_example: Eg 1/3.\n") ((import model_fixture_book), (import model_fixture_log), 100, "http://127.0.0.1:1"):(["refused", "hints are unavailable in the warm-up, which is the cold strength test"]) then model_fixture_size:(75)
