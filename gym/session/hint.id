// Giving the next rung of the hint ladder (P4). session_hint_gate says why a hint
// may not be given now ("" when it may): there must be a session, the item on
// screen must already have a committed attempt (the answer gate of the whole
// design: no help before a try), the phase must allow hints (the warm-up does
// not, plan_hints_allowed), the learner must not have tapped out (the worked
// example is already shown) and fewer than four rungs may have been shown.
// session_hint_next then asks coach_hint for the next rung, which falls back to
// the pack's own words when no model answers, logs a hint_shown event and
// answers ["refused", why] or ["ok", "", text, source, label, rung, why the
// source is not the model].

session_hint_gate(string[] session_shown) {
  string session_refusal = "";
  if (session_shown[(import session_slot_state)] == "none") {
    session_refusal = "no session is running: start one with gym session start";
  }
  if (session_refusal == "" && (session_shown[(import session_slot_state)] == "over" || session_shown[(import session_slot_state)] == "closed")) {
    session_refusal = "the session is over: start another with gym session start";
  }
} chain (string[] session_shown) {
  if (session_refusal == "" && session_shown[(import session_slot_state)] == "waiting") {
    session_refusal = "answer first: a hint comes only after you commit an attempt (an answer and a confidence); if you are stuck, gym tapout shows the worked example";
  }
  if (session_refusal == "" && plan_hints_allowed(session_shown[(import session_slot_phase)]) == 0) {
    session_refusal = "hints are unavailable in the warm-up, which is the cold strength test";
  }
  if (session_refusal == "" && session_shown[(import session_slot_tapped)] == "yes") {
    session_refusal = "you tapped out on this item, so the worked example was already shown";
  }
} chain (string[] session_shown) {
  if (session_refusal == "" && session_shown[(import session_slot_hints)] == "4") {
    session_refusal = "all four rungs are already shown for this item";
  }
} return string session_refusal;
(["none", "", "", "", "", "", "0", "no"]):("no session is running: start one with gym session start")
(["over", "3", "2", "", "", "", "0", "no"]):("the session is over: start another with gym session start")
(["closed", "3", "2", "", "", "", "0", "no"]):("the session is over: start another with gym session start")
(["waiting", "1", "2", "a", "main", "r", "0", "no"]):("answer first: a hint comes only after you commit an attempt (an answer and a confidence); if you are stuck, gym tapout shows the worked example")
(["waiting", "1", "2", "a", "warmup", "r", "0", "no"]):("answer first: a hint comes only after you commit an attempt (an answer and a confidence); if you are stuck, gym tapout shows the worked example")
(["committed", "1", "2", "a", "warmup", "r", "0", "no"]):("hints are unavailable in the warm-up, which is the cold strength test")
(["committed", "1", "2", "a", "main", "r", "0", "yes"]):("you tapped out on this item, so the worked example was already shown")
(["committed", "1", "2", "a", "main", "r", "4", "no"]):("all four rungs are already shown for this item")
(["committed", "1", "2", "a", "main", "r", "3", "no"]):("")
(["committed", "2", "2", "b", "transfer", "r", "0", "no"]):("")

session_hint_next(Pack session_book, string session_log_path, word session_now, string session_url) {
  Log_replay session_replayed = log_replay(session_log_path);
  string[] session_shown = session_view(session_replayed.events);
  string session_refusal = session_hint_gate(session_shown);
} chain (Pack session_book, string session_log_path, word session_now, string session_url) {
  int session_plan_at = session_plan_index(session_replayed.events);
  int session_rung = 0;
  int session_attempt_at = 0 - 1;
} chain (Pack session_book, string session_log_path, word session_now, string session_url) {
  string[] session_coached = ["", "none", session_refusal];
  if (session_refusal == "") {
    session_rung = to_int(session_shown[(import session_slot_hints)]) + 1;
    session_attempt_at = session_attempt_index(session_replayed.events, session_plan_at, to_int(session_shown[(import session_slot_number)]) - 1);
  }
  if (session_refusal == "") {
    session_coached = coach_hint(session_url, session_log_path, session_attempt_at, session_book, session_shown[(import session_slot_item)], session_rung);
  }
} chain (Pack session_book, string session_log_path, word session_now, string session_url) {
  int session_written = 0 - 1;
  if (session_refusal == "" && session_coached[1] == "none") {
    session_refusal = session_coached[2];
  }
  if (session_refusal == "") {
    session_written = log_record_hint(session_log_path, session_now, session_shown[(import session_slot_item)], session_rung);
  }
} chain (Pack session_book, string session_log_path, word session_now, string session_url) {
  string[] session_result = ["refused", session_refusal];
  if (session_refusal == "" && session_written < 0) {
    session_result = ["refused", "the log could not be written"];
  }
  if (session_refusal == "" && session_written >= 0) {
    session_result = ["ok", "", session_coached[0], session_coached[1], (import pack_rung_labels)[session_rung - 1], "" + session_rung, session_coached[2]];
  }
} return string[] session_result;
given model_fixture_log_file("1\tsession_plan\ta,b\tmain,main\tr1\\nr2\n2\tattempt\ta\t1/2\t90\tincorrect\t0\t5\tno\t\n") given model_fixture_pack("item: a\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\nhint_nudge: Begin.\nhint_question: Ask.\nhint_step: Step.\nhint_example: Eg 1/3.\n") ((import model_fixture_book), (import model_fixture_log), 100, "http://127.0.0.1:1"):(["ok", "", "Begin.", "authored", "nudge", "1", "the model server answered -1"]) then model_fixture_size:(92)
