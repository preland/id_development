// The table of a replayed log: one entry per attempt event, in file order.
score_table(Log_events score_events, Pack score_book) {
  word[] score_times = [];
  word[] score_gaps = [];
  int[] score_seconds = [];
} chain (Log_events score_events, Pack score_book) {
  string[] score_items = [];
  string[] score_concepts = [];
  int[] score_transfers = [];
} chain (Log_events score_events, Pack score_book) {
  int[] score_confidences = [];
  int[] score_corrects = [];
  int[] score_hints = [];
} chain (Log_events score_events, Pack score_book) {
  int[] score_taps = [];
  int[] score_shows = [];
  Score_aid score_help = Score_aid(score_hints, score_taps, score_shows);
} chain (Log_events score_events, Pack score_book) {
  Score_marks score_marked = Score_marks(score_confidences, score_corrects, score_help);
  Score_moments score_moment = Score_moments(score_times, score_gaps, score_seconds);
  Score_labels score_label_set = Score_labels(score_items, score_concepts, score_transfers);
} chain (Log_events score_events, Pack score_book) {
  Score_table score_made = Score_table(score_moment, score_label_set, score_marked);
  string[] score_seen_items = [];
  word[] score_seen_times = [];
} chain (Log_events score_events, Pack score_book) {
  int score_at = 0;
  while (score_at < len(score_events.kinds)) {
    if (score_events.kinds[score_at] == "attempt") {
      score_append(score_made, score_events, score_book, score_at, score_seen_items, score_seen_times);
    }
    score_at = score_at + 1;
  }
} return Score_table score_made;
