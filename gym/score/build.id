// Building the table the scoreboard reads: one entry per attempt of a replayed log, in log order, labelled from
// the pack. Everything the learner did that is not an attempt (hints shown, sessions) is ignored here, because
// the hints used are recorded on the attempt itself.

// The ms since the previous attempt at the same item, or -1 for the first; the item's time is then updated.
// A time earlier than the previous one (a log written out of order) counts as 0 apart, so it is neither a first
// attempt nor a delayed one.
score_gap(string[] score_seen_items, word[] score_seen_times, string score_item, word score_time) {
  int score_row = lst_str_index(score_seen_items, score_item);
  word score_distance = 0 - 1;
  word[] score_seen_alias = score_seen_times;
} chain (string[] score_seen_items, word[] score_seen_times, string score_item, word score_time) {
  if (score_row < 0) {
    push(score_seen_items, score_item);
    push(score_seen_times, score_time);
  } else {
    score_distance = score_time - score_seen_alias[score_row];
    score_seen_alias[score_row] = score_time;
  }
  if (score_row >= 0 && score_distance < 0) {
    score_distance = 0;
  }
} return word score_distance;
([], [], "a", 100):(-1)
(["a", "b"], [100, 200], "b", 150):(0)
(["a", "b"], [100, 200], "b", 200):(0)
(["a", "b"], [100, 200], "a", 86400100):(86400000)
(["a"], [100], "b", 90):(-1)

// Adds attempt number `score_at` of the events to every column of the table, the item's seen-before record
// included.
score_append(Score_table score_table_in, Log_events score_events, Pack score_book, int score_at, string[] score_seen_items, word[] score_seen_times) {
  string score_item = log_text_at(score_events, score_at, (import log_slot_item));
  word score_distance = score_gap(score_seen_items, score_seen_times, score_item, score_events.times[score_at]);
  score_push_moments(score_table_in, score_events, score_at, score_distance);
} chain (Score_table score_table_in, Log_events score_events, Pack score_book, int score_at, string[] score_seen_items, word[] score_seen_times) {
  score_push_labels(score_table_in, score_book, score_item);
  score_push_marks(score_table_in, score_events, score_at);
} return void;
