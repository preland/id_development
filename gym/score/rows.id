// Adding one attempt to the columns of a Score_table: its moments, its labels from the pack, its marks.

// The time, the gap to the previous attempt at the item (given) and the seconds of attempt number `score_at`.
score_push_moments(Score_table score_table_in, Log_events score_events, int score_at, word score_gap_in) {
  push(score_table_in.moments.times, score_events.times[score_at]);
  push(score_table_in.moments.gaps, score_gap_in);
  push(score_table_in.moments.seconds, log_number_at(score_events, score_at, (import log_slot_seconds)));
} return void;
(Score_table(Score_moments([], [], []), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))), Log_events([100, 200], ["attempt", "attempt"], [["100", "attempt", "i1", "a", "90", "correct", "2", "42", "yes", "partial"], ["200", "attempt", "i1", "a", "50", "incorrect", "0", "7", "no", ""]]), 1, 100):(Score_table(Score_moments([200], [100], [7]), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))))
(Score_table(Score_moments([5], [-1], [3]), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))), Log_events([100], ["attempt"], [["100", "attempt", "i1", "a", "90", "correct", "2", "42", "yes", "partial"]]), 0, -1):(Score_table(Score_moments([5, 100], [-1, -1], [3, 42]), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))))

// The item, its concepts as ",a,b," (spaces removed) and its transfer flag, from the pack. An item the pack does
// not know has no concepts (",") and is not a transfer item. A synthesis item also carries the marker
// ~synthesis among its concepts (",ca,cb,~synthesis,"), which is how score_synthesis finds its attempts.
score_push_labels(Score_table score_table_in, Pack score_book, string score_item) {
  int score_block = pack_find(score_book, "item", score_item);
  string score_text = ",";
  int score_flag = 0;
} chain (Score_table score_table_in, Pack score_book, string score_item) {
  if (score_block >= 0) {
    score_text = "," + str_replace(pack_field(score_book, score_block, "concepts"), " ", "") + ",";
    score_flag = pack_field(score_book, score_block, "transfer") == "yes";
    if (pack_field(score_book, score_block, "kind") == "synthesis") {
      score_text = score_text + (import score_synthesis_mark) + ",";
    }
  }
  push(score_table_in.labels.items, score_item);
  push(score_table_in.labels.concepts, score_text);
} chain (Score_table score_table_in, Pack score_book, string score_item) {
  push(score_table_in.labels.transfers, score_flag);
} return void;
given pack_fixture_parse("item: i1\nconcepts: ca, cb\ntransfer: yes\nitem: i2\nconcepts: cb\n") (Score_table(Score_moments([], [], []), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))), (import pack_fixture_book), "i1"):(Score_table(Score_moments([], [], []), Score_labels(["i1"], [",ca,cb,"], [1]), Score_marks([], [], Score_aid([], [], []))))
given pack_fixture_parse("item: i1\nconcepts: ca, cb\ntransfer: yes\nitem: i2\nconcepts: cb\n") (Score_table(Score_moments([], [], []), Score_labels(["i1"], [",ca,cb,"], [1]), Score_marks([], [], Score_aid([], [], []))), (import pack_fixture_book), "i2"):(Score_table(Score_moments([], [], []), Score_labels(["i1", "i2"], [",ca,cb,", ",cb,"], [1, 0]), Score_marks([], [], Score_aid([], [], []))))
given pack_fixture_parse("item: i1\nconcepts: ca\n") (Score_table(Score_moments([], [], []), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))), (import pack_fixture_book), "missing"):(Score_table(Score_moments([], [], []), Score_labels(["missing"], [","], [0]), Score_marks([], [], Score_aid([], [], []))))
given pack_fixture_parse("item: i1\nconcepts: ca, cb\nkind: synthesis\n") (Score_table(Score_moments([], [], []), Score_labels([], [], []), Score_marks([], [], Score_aid([], [], []))), (import pack_fixture_book), "i1"):(Score_table(Score_moments([], [], []), Score_labels(["i1"], [",ca,cb,~synthesis,"], [0]), Score_marks([], [], Score_aid([], [], []))))

// The confidence, whether it was right (a correct verdict without a tap-out; a self-grade is not read), the
// hints shown and whether the learner tapped out, of attempt number `score_at`.
score_push_marks(Score_table score_table_in, Log_events score_events, int score_at) {
  int score_tap = log_tapped_at(score_events, score_at);
  int score_right = log_text_at(score_events, score_at, (import log_slot_verdict)) == "correct" && score_tap == 0;
  push(score_table_in.marks.confidences, log_number_at(score_events, score_at, (import log_slot_confidence)));
} chain (Score_table score_table_in, Log_events score_events, int score_at) {
  push(score_table_in.marks.corrects, score_right);
  push(score_table_in.marks.aid.hints, log_number_at(score_events, score_at, (import log_slot_hints)));
  push(score_table_in.marks.aid.tapped, score_tap);
} chain (Score_table score_table_in, Log_events score_events, int score_at) {
  push(score_table_in.marks.aid.shown, score_shown_after(score_events, score_at));
} return void;
