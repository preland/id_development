// Hints plus hints shown after the attempt, attempt by attempt: the hints column independence is measured on
// (retention keeps reading the attempt's own hints, since a hint after the answer does not make the answer aided).
score_helped(int[] score_hints, int[] score_after_hints) {
  int[] score_summed = [];
  int score_at = 0;
  while (score_at < len(score_hints)) {
    push(score_summed, score_hints[score_at] + score_after_hints[score_at]);
    score_at = score_at + 1;
  }
} return int[] score_summed;
