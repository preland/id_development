// The hints a learner asked for after committing an attempt. The engine only gives a hint once an attempt is
// committed (P1), so the hint is a hint_shown event after the attempt, never a field of it; independence has to
// count those events, or a learner who leans on hints after every miss would look independent.

// How many hint_shown events for the attempt's item follow attempt number `score_at`, before the next attempt
// at the same item (hints for another item, and the later attempt's own hints, are not this attempt's).
score_shown_after(Log_events score_events, int score_at) {
  string score_item = log_text_at(score_events, score_at, (import log_slot_item));
  int score_count = 0;
  int score_next = score_at + 1;
} chain (Log_events score_events, int score_at) {
  int score_open = 1;
  while (score_next < len(score_events.kinds) && score_open == 1) {
    score_count = score_count + (score_events.kinds[score_next] == "hint_shown" && log_text_at(score_events, score_next, (import log_slot_item)) == score_item);
    score_open = 1 - (score_events.kinds[score_next] == "attempt" && log_text_at(score_events, score_next, (import log_slot_item)) == score_item);
    score_next = score_next + 1;
  }
} return int score_count;
