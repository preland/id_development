// Hints plus tap-outs per solved attempt, week by week: the trend that should fall as the scaffolding fades.
score_independence_trend(Score_table score_table_in, word score_now, int score_weeks, int score_minimum) {
  Score_figures score_list = score_weekly_aid(score_table_in.moments.times, score_table_in.marks.corrects, score_helped(score_table_in.marks.aid.hints, score_table_in.marks.aid.shown), score_table_in.marks.aid.tapped, score_now, score_weeks, score_minimum);
} return Score_figures score_list;
