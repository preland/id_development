// Week-by-week figures over a whole table, oldest to newest, for the last `score_weeks` weeks ending at now
// (milliseconds; the clock is always an argument). Labels count the weeks back: "1", "0" with 0 the latest.

score_retention_trend(Score_table score_table_in, word score_now, int score_weeks, int score_minimum) {
  int[] score_mask = score_retained(score_table_in.moments.gaps, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped);
  Score_figures score_list = score_weekly_accuracy(score_table_in.moments.times, score_mask, score_table_in.marks.corrects, score_now, score_weeks, score_minimum);
} return Score_figures score_list;
