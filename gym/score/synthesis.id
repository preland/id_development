// Synthesis (the sixth number): accuracy on synthesis items, those with
// `kind: synthesis` in the pack, counting only attempts made without a hint and
// without a tap-out, so it measures whether separate pieces of knowledge have
// joined up and not how well the learner can be helped. Same rule as the other
// figures: below the minimum number of counted attempts it is "not enough data".
// The mask of unaided attempts is score_clean over a list of ones (every attempt counted as right).

score_synthesis(Score_table score_table_in, int score_minimum) {
  int[] score_synthesis_items = score_with_concept(score_table_in.labels.concepts, (import score_synthesis_mark));
  int[] score_all_right = score_every(score_table_in.marks.corrects);
  int[] score_unaided_mask = score_clean(score_all_right, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped);
} chain (Score_table score_table_in, int score_minimum) {
  int[] score_mask = score_both(score_synthesis_items, score_unaided_mask);
  Score_figure score_result = score_accuracy(score_mask, score_table_in.marks.corrects, score_minimum);
} return Score_figure score_result;
