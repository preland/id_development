// Fluency per concept: the median seconds of the clean correct answers at items that test the concept.

score_fluency_concept(Score_table score_table_in, string score_concept, int score_minimum) {
  int[] score_mask = score_clean(score_table_in.marks.corrects, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped);
  int[] score_scoped = score_with_concept(score_table_in.labels.concepts, score_concept);
  int[] score_counted = score_both(score_mask, score_scoped);
} chain (Score_table score_table_in, string score_concept, int score_minimum) {
  Score_figure score_result = score_median(score_counted, score_table_in.moments.seconds, score_minimum);
} return Score_figure score_result;
