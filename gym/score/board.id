// The headline numbers over a whole table. Each answers with a Score_figure: its sample size, whether that
// is enough (at least `score_minimum` attempts; pass score_default_minimum for the default of 5), and the value.

// Retention (spec P9): accuracy on attempts at least a day after the previous attempt at the item, with no
// hint and no tap-out.
score_retention(Score_table score_table_in, int score_minimum) {
  int[] score_mask = score_retained(score_table_in.moments.gaps, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped);
  Score_figure score_result = score_accuracy(score_mask, score_table_in.marks.corrects, score_minimum);
} return Score_figure score_result;
