// Transfer (spec P9): accuracy on the held-out items, those with `transfer: yes` in the pack.
score_transfer(Score_table score_table_in, int score_minimum) {
  Score_figure score_result = score_accuracy(score_table_in.labels.transfers, score_table_in.marks.corrects, score_minimum);
} return Score_figure score_result;
