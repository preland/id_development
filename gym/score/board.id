// Independence (spec P9): hints shown plus tap-outs, for each attempt that was solved. Lower is better.
score_independence(Score_table score_table_in, int score_minimum) {
  int[] score_mask = score_every(score_table_in.marks.corrects);
  Score_figure score_result = score_per_solved(score_mask, score_table_in.marks.corrects, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped, score_minimum);
} return Score_figure score_result;
