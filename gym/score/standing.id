// Fluency (spec P9): the median seconds of the answers that were right with no hint and no tap-out.
score_fluency(Score_table score_table_in, int score_minimum) {
  int[] score_mask = score_clean(score_table_in.marks.corrects, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped);
  Score_figure score_result = score_median(score_mask, score_table_in.moments.seconds, score_minimum);
} return Score_figure score_result;
