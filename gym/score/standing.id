// as three floats in a row: how many, the mean confidence, and the share right.
score_calibration_table(Score_table score_table_in) {
  int[] score_mask = score_first(score_table_in.moments.gaps);
  float[] score_cells = score_bins(score_mask, score_table_in.marks.confidences, score_table_in.marks.corrects);
} return float[] score_cells;
