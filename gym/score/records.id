// The best week of accuracy on held-out items among the last `score_weeks` weeks ending at now, counting only
// weeks with at least `score_minimum` transfer attempts.
score_record_transfer(Score_table score_table_in, word score_now, int score_weeks, int score_minimum) {
  Score_figures score_weekly = score_transfer_trend(score_table_in, score_now, score_weeks, score_minimum);
  Score_figure score_result = score_best(score_weekly);
} return Score_figure score_result;
