// Retention per concept: the retention rule applied to the attempts at items that test the concept (an item
// with two concepts counts for both).

score_retention_concept(Score_table score_table_in, string score_concept, int score_minimum) {
  int[] score_mask = score_retained(score_table_in.moments.gaps, score_table_in.marks.aid.hints, score_table_in.marks.aid.tapped);
  int[] score_scoped = score_with_concept(score_table_in.labels.concepts, score_concept);
  int[] score_counted = score_both(score_mask, score_scoped);
} chain (Score_table score_table_in, string score_concept, int score_minimum) {
  Score_figure score_result = score_accuracy(score_counted, score_table_in.marks.corrects, score_minimum);
} return Score_figure score_result;
