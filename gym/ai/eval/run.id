evaluation_slice(string evaluation_url, string evaluation_pack_directory, string evaluation_set_path, string evaluation_results_path, int evaluation_from, int evaluation_count) {
  Pack evaluation_set = pack_new("eval");
  int evaluation_at = evaluation_from;
  int evaluation_kept = 0;
} chain (string evaluation_url, string evaluation_pack_directory, string evaluation_set_path, string evaluation_results_path, int evaluation_from, int evaluation_count) {
  pack_read_text(evaluation_set, evaluation_set_path, fs_read_text(evaluation_set_path));
  int evaluation_all = len(pack_identifiers(evaluation_set, "item"));
  while (evaluation_at < evaluation_all && evaluation_at < evaluation_from + evaluation_count) {
    evaluation_kept = evaluation_kept + evaluation_timed(evaluation_url, evaluation_pack_directory, evaluation_set, evaluation_at, evaluation_results_path);
    evaluation_at = evaluation_at + 1;
  }
} return int evaluation_kept;
