// Running the grader evaluation: eval_case grades one attempt of the set
// exactly as `gym grade` does (a throwaway log, the real gate, the real prompt)
// and answers its row cells; eval_timed measures that exchange on the monotonic
// clock, puts the milliseconds in the time cell and appends the row to the
// results file; eval_slice does that for count attempts from number `from`, so
// forty attempts at ten seconds each can be run in slices that fit the
// one-minute limit. The results file is append-only, one run per file.

evaluation_case(string evaluation_url, string evaluation_pack_directory, Pack evaluation_set, int evaluation_block) {
  Pack evaluation_book = pack_load(evaluation_pack_directory);
  string evaluation_target = pack_field(evaluation_set, evaluation_block, "target");
  string[] evaluation_feedback = probe_attempt(evaluation_url, evaluation_pack_directory, evaluation_target, pack_field(evaluation_set, evaluation_block, "answer"));
} chain (string evaluation_url, string evaluation_pack_directory, Pack evaluation_set, int evaluation_block) {
  int evaluation_found = pack_find(evaluation_book, "item", evaluation_target);
  string evaluation_reference = "";
  if (evaluation_found >= 0) {
    evaluation_reference = pack_field(evaluation_book, evaluation_found, "answer");
  }
} chain (string evaluation_url, string evaluation_pack_directory, Pack evaluation_set, int evaluation_block) {
  string[] evaluation_case_made = evaluation_cells(evaluation_set, evaluation_block, evaluation_reference, evaluation_feedback);
} return string[] evaluation_case_made;
given pack_fixture_directory("item: x\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\n", "") given pack_fixture_parse("item: 0\ntarget: x\nanswer: 3/8\nverdict: incorrect\nerror_type: slip\n") ("http://127.0.0.1:1", ".", (import pack_fixture_book), 0):(["0", "x", "incorrect", "slip", "unreachable", "", "", "", "", "1/3", "", "", "the model server answered -1"])
given pack_fixture_directory("item: x\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\n", "") given pack_fixture_parse("item: 1\ntarget: y\nanswer: 3/8\nverdict: correct\nerror_type: none\n") ("http://127.0.0.1:1", ".", (import pack_fixture_book), 0):(["1", "y", "correct", "none", "refused", "", "", "", "", "", "", "", "refused: the pack has no such item"])

evaluation_timed(string evaluation_url, string evaluation_pack_directory, Pack evaluation_set, int evaluation_block, string evaluation_results_path) {
  word evaluation_started = clock_nanoseconds((import clock_mono)) / 1000000;
  string[] evaluation_cells_got = evaluation_case(evaluation_url, evaluation_pack_directory, evaluation_set, evaluation_block);
  word evaluation_finished = clock_nanoseconds((import clock_mono)) / 1000000;
} chain (string evaluation_url, string evaluation_pack_directory, Pack evaluation_set, int evaluation_block, string evaluation_results_path) {
  evaluation_cells_got[(import evaluation_slot_milliseconds)] = "" + (evaluation_finished - evaluation_started);
  int evaluation_written = fs_append_text(evaluation_results_path, string_join(evaluation_cells_got, "\t") + "\n");
  int evaluation_kept = evaluation_written > 0;
} return int evaluation_kept;
