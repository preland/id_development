// The summary of a results file: eval_sums adds the marks of every row
// (marks.id), eval_report writes them as the lines the evaluation is judged by.
// Agreement is counted over all rows, so a refused, unreachable or unsure reply
// counts as a miss; the valid-reply line says how many were not. The phase 2
// gate of the spec is verdict agreement of 90 of 100.

eval_sums(string eval_results_text) {
  string[] eval_lines = str_lines(eval_results_text);
  int[] eval_sums_made = [0, 0, 0, 0, 0, 0, 0, 0, 0];
  int eval_at = 0;
} chain (string eval_results_text) {
  while (eval_at < len(eval_lines)) {
    eval_total(eval_sums_made, eval_marks(eval_lines[eval_at]));
    eval_at = eval_at + 1;
  }
} return int[] eval_sums_made;
("3\ta\tpartly\tslip\tgraded\tpartly\tslip\t85\t100\tref\tr\tf\t\n4\tb\tcorrect\tnone\tunsure\t\t\t\t50\tref\t\t\tempty field: right\n"):([2, 1, 1, 1, 0, 0, 0, 0, 150])
(""):([0, 0, 0, 0, 0, 0, 0, 0, 0])
("junk\n\n3\ta\tcorrect\tnone\tgraded\tincorrect\tslip\t85\t10\tref\tr\tf\t\n"):([1, 0, 1, 0, 0, 0, 0, 0, 10])

eval_report(string eval_results_text) {
  int[] eval_sums_got = eval_sums(eval_results_text);
  string eval_rows = "" + eval_sums_got[0];
  string[] eval_lines_made = ["rows: " + eval_rows, "verdict agreement: " + eval_sums_got[1] + " of " + eval_rows, "error_type agreement: " + eval_sums_got[3] + " of " + eval_rows, "valid replies: " + eval_sums_got[2] + " of " + eval_rows + " (the rest were refused, unreachable or unsure)", "self_grade (confidence under the floor): " + eval_sums_got[6], "over-credit (said correct, the author did not): " + eval_sums_got[7]];
} chain (string eval_results_text) {
  string[] eval_more = ["right restates the reference although the verdict is not correct: " + eval_sums_got[4], "flaw longer than " + (import grade_flaw_limit) + " characters: " + eval_sums_got[5], "total milliseconds: " + eval_sums_got[8]];
  string eval_text_made = str_join(eval_lines_made, "\n") + "\n" + str_join(eval_more, "\n");
} return string eval_text_made;
("3\ta\tpartly\tslip\tgraded\tpartly\tslip\t85\t100\tref\tr\tf\t\n"):("rows: 1\nverdict agreement: 1 of 1\nerror_type agreement: 1 of 1\nvalid replies: 1 of 1 (the rest were refused, unreachable or unsure)\nself_grade (confidence under the floor): 0\nover-credit (said correct, the author did not): 0\nright restates the reference although the verdict is not correct: 0\nflaw longer than 160 characters: 0\ntotal milliseconds: 100")
