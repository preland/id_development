// One result row of the grader evaluation (set.txt): what the author expected
// of an attempt and what the model said, as thirteen cells in the eval_slot_*
// order of conf.id, joined by tabs into one line of a results file. eval_clean
// flattens a model's text so a tab or line break in it cannot split a row;
// eval_cells builds the cells from the evaluation set, the reference answer of
// the item it targets and the feedback list (feedback.id). The time cell is
// left empty here: whoever measured the exchange fills it (run.id).

evaluation_clean(string evaluation_text) {
  string evaluation_without_tabs = str_replace(evaluation_text, "\t", " ");
  string evaluation_flat = str_replace(evaluation_without_tabs, "\n", " ");
} return string evaluation_flat;
("a\tb\nc"):("a b c")
("plain"):("plain")
("\t\n"):("  ")

evaluation_cells(Pack evaluation_set, int evaluation_block, string evaluation_reference, string[] evaluation_feedback) {
  string[] evaluation_row_made = [pack_identifier_of(evaluation_set, evaluation_block), pack_field(evaluation_set, evaluation_block, "target"), pack_field(evaluation_set, evaluation_block, "verdict"), pack_field(evaluation_set, evaluation_block, "error_type"), evaluation_feedback[(import grade_slot_status)], evaluation_feedback[(import grade_slot_verdict)], evaluation_feedback[(import grade_slot_error_type)], evaluation_feedback[(import grade_slot_confidence)], "", evaluation_clean(evaluation_reference), evaluation_clean(evaluation_feedback[(import grade_slot_right)]), evaluation_clean(evaluation_feedback[(import grade_slot_flaw)]), evaluation_clean(evaluation_feedback[(import grade_slot_reason)])];
} return string[] evaluation_row_made;
