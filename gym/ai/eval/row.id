given pack_fixture_parse("item: 4\ntarget: b\nverdict: correct\nerror_type: none\n") ((import pack_fixture_book), 0, "A", ["unsure", "empty field: right", "", "", "", "", "", ""]):(["4", "b", "correct", "none", "unsure", "", "", "", "", "A", "", "", "empty field: right"])
