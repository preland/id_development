// What `gym ai probe` is made of, so the grader can be tried against a live
// server without a session: probe_attempt records the given answer as a
// committed attempt in a throwaway log (fs_mktemp, confidence 70, no hints, the
// checker's verdict, the clock fixed at 1 because the log is thrown away) and
// grades that attempt through grade_attempt exactly as the app does, and
// probe_lines prints the feedback list one labelled field per line. The program
// that wires them to a command line is gymprobe/main.id.

probe_attempt(string probe_url, string probe_pack_directory, string probe_item_identifier, string probe_answer) {
  Pack probe_book = pack_load(probe_pack_directory);
  int probe_block = pack_find(probe_book, "item", probe_item_identifier);
  string probe_folder = fs_mktemp("gym_probe_", 1);
} chain (string probe_url, string probe_pack_directory, string probe_item_identifier, string probe_answer) {
  string[] probe_result = grade_outcome("refused", "refused: the pack has no such item");
  string probe_log = probe_folder + "/learner.log";
  if (probe_block >= 0) {
    string probe_verdict = check_answer(pack_field(probe_book, probe_block, "answer_kind"), pack_field(probe_book, probe_block, "answer"), pack_field(probe_book, probe_block, "tolerance"), probe_answer);
    int probe_wrote = log_record_attempt(probe_log, 1, probe_item_identifier, probe_answer, 70, probe_verdict, 0, 1, 0, "");
    probe_result = grade_attempt(probe_url, probe_log, 0, probe_book, probe_item_identifier);
  }
} return string[] probe_result;
given pack_fixture_directory("item: x\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\n", "") ("http://127.0.0.1:1", ".", "x", "3/8"):(["unreachable", "the model server answered -1", "", "", "", "", "", ""])
given pack_fixture_directory("item: x\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\n", "") ("http://127.0.0.1:1", ".", "y", "3/8"):(["refused", "refused: the pack has no such item", "", "", "", "", "", ""])
given pack_fixture_directory("item: x\nprompt: P\nanswer_kind: fraction\nanswer: 1/3\n", "") ("http://127.0.0.1:1", ".", "x", ""):(["refused", "refused: the attempt holds no answer", "", "", "", "", "", ""])

probe_lines(string[] probe_feedback) {
  string[] probe_rows = ["status: " + probe_feedback[0], "reason: " + probe_feedback[1], "verdict: " + probe_feedback[2], "right: " + probe_feedback[3], "flaw: " + probe_feedback[4], "next_step: " + probe_feedback[5], "error_type: " + probe_feedback[6], "confidence: " + probe_feedback[7]];
  string probe_text = str_join(probe_rows, "\n");
} return string probe_text;
(["graded", "", "correct", "r", "none", "n", "none", "90"]):("status: graded\nreason: \nverdict: correct\nright: r\nflaw: none\nnext_step: n\nerror_type: none\nconfidence: 90")
(["refused", "why", "", "", "", "", "", ""]):("status: refused\nreason: why\nverdict: \nright: \nflaw: \nnext_step: \nerror_type: \nconfidence: ")
