// Wording the next hint rung after a committed attempt. coach_hint is the
// public entry and answers [text, source, reason] (hint.id): source "model" for
// a reworded hint that passed the leak check, "authored" for the pack's rung
// verbatim when the model failed, was unreachable or leaked, and "none" with no
// text when the rung cannot be shown (the gate refused, the item or rung is not
// there, or the pack has no text for the rung). The same gate as the grader
// runs first, so no hint is requested before an attempt is in the log. The rung
// is 1 to 4, in the order of pack_rung_keys. coach_exchange is the only
// function that sends anything, and it sends the authored rung, never the
// reference answer.

coach_exchange(string coach_url, Log_events coach_events, int coach_index, Pack coach_book, int coach_block, int coach_rung) {
  string coach_authored = pack_field(coach_book, coach_block, (import pack_rung_keys)[coach_rung - 1]);
  string coach_user_text = coach_prompt((import pack_rung_labels)[coach_rung - 1], coach_authored, pack_field(coach_book, coach_block, "prompt"), log_text_at(coach_events, coach_index, (import log_slot_answer)));
  string[] coach_cells = ["", "", ""];
} chain (string coach_url, Log_events coach_events, int coach_index, Pack coach_book, int coach_block, int coach_rung) {
  int coach_code = 0 - 9;
  string[] coach_result = ["", "none", "the pack has no text for this rung"];
  if (coach_authored != "") {
    coach_code = model_ask(coach_url, (import coach_system), coach_user_text, (import coach_schema), coach_cells);
    coach_result = [coach_authored, "authored", "the model server answered " + coach_code];
  }
} chain (string coach_url, Log_events coach_events, int coach_index, Pack coach_book, int coach_block, int coach_rung) {
  if (coach_code == 200) {
    coach_result = coach_judge(coach_cells[(import http_r_body)], pack_field(coach_book, coach_block, "answer_kind"), pack_field(coach_book, coach_block, "answer"), pack_field(coach_book, coach_block, "tolerance"), coach_authored);
  }
} return string[] coach_result;
