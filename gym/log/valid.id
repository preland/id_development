// Is a field of a log line what its slot allows? These are the checks that make
// a hand-edited or half-written line "malformed" rather than a surprise later:
// numbers are plain digits of bounded length, so none can overflow, and every
// word comes from a fixed list.

log_digits_ok(string log_field_text, int log_most) {
  int log_good = 0;
  if (len(log_field_text) > 0 && len(log_field_text) <= log_most && check_digit_total(log_field_text) == len(log_field_text)) {
    log_good = 1;
  }
} return int log_good;
("0", 3):(1)
("123", 3):(1)
("1234", 3):(0)
("", 3):(0)
("-1", 3):(0)
("1a", 3):(0)
("1.5", 3):(0)

log_attempt_ok(string[] log_fields) {
  int log_confidence_ok = log_digits_ok(log_fields[(import log_slot_confidence)], 2) == 1 && lst_find((import log_confidences), to_int(log_fields[(import log_slot_confidence)])) == 1;
  int log_verdict_ok = lst_str_index((import log_verdicts), log_fields[(import log_slot_verdict)]) >= 0;
  int log_hints_ok = log_digits_ok(log_fields[(import log_slot_hints)], 1) == 1 && to_int(log_fields[(import log_slot_hints)]) <= (import log_hint_top);
} chain (string[] log_fields) {
  int log_item_ok = log_fields[(import log_slot_item)] != "";
  int log_all_ok = log_confidence_ok + log_verdict_ok + log_hints_ok + log_item_ok == 4;
} return int log_all_ok;
(["1", "attempt", "i", "a", "90", "correct", "0", "5", "no", ""]):(1)
(["1", "attempt", "i", "a", "91", "correct", "0", "5", "no", ""]):(0)
(["1", "attempt", "i", "a", "50", "right", "0", "5", "no", ""]):(0)
(["1", "attempt", "i", "a", "50", "correct", "5", "5", "no", ""]):(0)
(["1", "attempt", "", "a", "50", "correct", "4", "5", "no", ""]):(0)
(["1", "attempt", "i", "a", "x", "correct", "0", "5", "no", ""]):(0)

log_effort_ok(string[] log_fields) {
  int log_seconds_ok = log_digits_ok(log_fields[(import log_slot_seconds)], (import log_seconds_digits));
  int log_tapped_ok = lst_str_index((import log_flags), log_fields[(import log_slot_tapped)]) >= 0;
  int log_grade_ok = lst_str_index((import log_grades), log_fields[(import log_slot_grade)]) >= 0;
} chain (string[] log_fields) {
  int log_effort_all = log_seconds_ok + log_tapped_ok + log_grade_ok == 3;
} return int log_effort_all;
(["1", "attempt", "i", "a", "90", "correct", "0", "5", "no", ""]):(1)
(["1", "attempt", "i", "a", "90", "correct", "0", "5", "yes", "partial"]):(1)
(["1", "attempt", "i", "a", "90", "correct", "0", "-5", "no", ""]):(0)
(["1", "attempt", "i", "a", "90", "correct", "0", "5", "maybe", ""]):(0)
(["1", "attempt", "i", "a", "90", "correct", "0", "5", "no", "great"]):(0)
(["1", "attempt", "i", "a", "90", "correct", "0", "12345678", "no", ""]):(0)
