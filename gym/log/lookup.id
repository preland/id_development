// Asking a Log_summary about one name: its attempts (0 if never) and its latest time (-1 if never).

log_count_of(Log_summary log_book, string log_name) {
  int log_row = lst_str_index(log_book.names, log_name);
  int log_count_found = 0;
  if (log_row >= 0) {
    log_count_found = log_book.counts[log_row];
  }
} return int log_count_found;
(Log_summary(["a", "b"], [2, 5], [10, 20]), "b"):(5)
(Log_summary(["a", "b"], [2, 5], [10, 20]), "zz"):(0)

log_last_of(Log_summary log_book, string log_name) {
  int log_row = lst_str_index(log_book.names, log_name);
  word log_last_found = 0 - 1;
  if (log_row >= 0) {
    log_last_found = log_book.lasts[log_row];
  }
} return word log_last_found;
(Log_summary(["a", "b"], [2, 5], [10, 20]), "a"):(10)
(Log_summary(["a", "b"], [2, 5], [10, 20]), "zz"):(-1)
