// Appending the two session events, each refused unless its line is valid, as
// the other recorders are: the bytes written, or -1 when nothing was written.

log_record_plan(string log_path, word log_time, string[] log_plan_identifiers, string[] log_plan_phases, string[] log_plan_reasons) {
  string log_event = log_line_plan(log_time, log_plan_identifiers, log_plan_phases, log_plan_reasons);
  int log_written = log_append_line(log_path, log_event);
} return int log_written;
