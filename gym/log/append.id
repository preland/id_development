// The only way anything gets into a log, and it only ever adds at the end:
// fs_append_text opens the file for appending (creating it when it is not there),
// so there is no code path that rewrites or truncates it. A line that would not
// pass log_fields_ok is refused before it is written, so the file never gets a
// line its own reader would skip. Each answers the bytes written, or -1 when the
// line was refused or the file could not be written.

log_append_line(string log_path, string log_event) {
  int log_written = 0 - 1;
  string[] log_cut = str_split(log_event, "\t");
  if (log_fields_ok(log_cut) == 1) {
    log_written = fs_append_text(log_path, log_event + "\n");
  }
} return int log_written;
