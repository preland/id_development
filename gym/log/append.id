log_record_attempt(string log_path, word log_time, string log_item, string log_answer, int log_confidence, string log_verdict, int log_hints, int log_seconds, int log_tapped, string log_grade) {
  string log_event = log_line_attempt(log_time, log_item, log_answer, log_confidence, log_verdict, log_hints, log_seconds, log_tapped, log_grade);
  int log_written = log_append_line(log_path, log_event);
} return int log_written;
