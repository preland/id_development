log_line_graded(word log_time, string log_item, string log_verdict, string log_source, string log_met) {
  string[] log_fields = ["" + log_time, "graded", log_escape(log_item), log_verdict, log_source, log_met];
  string log_event = str_join(log_fields, "\t");
} return string log_event;
