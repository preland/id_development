// The `graded` event: the verdict on an answer that the checker could not decide
// (a free answer, logged as an attempt with the verdict pending). Fields: ITEM,
// VERDICT (correct or incorrect), SOURCE (model for the grader, self for the
// learner marking the rubric) and MET, the rubric lines marked met as a comma
// list of 1 and 0 ("1,0,1"; empty when the grader gave no per-line marks).
// log_graded_ok is the validity rule, log_line_graded writes the line and
// log_record_graded appends it, refused unless the reader would accept it.

log_graded_ok(string[] log_fields) {
  string log_met_text = log_fields[(import log_slot_graded_met)];
  string log_without_zeros = str_replace(log_met_text, "0", "");
  string log_without_ones = str_replace(log_without_zeros, "1", "");
} chain (string[] log_fields) {
  string log_bare = str_replace(log_without_ones, ",", "");
  int log_graded_good = log_fields[(import log_slot_item)] != "" && lst_str_index((import log_graded_verdicts), log_fields[(import log_slot_graded_verdict)]) >= 0 && lst_str_index((import log_graded_sources), log_fields[(import log_slot_graded_source)]) >= 0;
  int log_graded_valid = log_graded_good == 1 && log_bare == "" && len(log_met_text) <= (import log_graded_met_reach);
} return int log_graded_valid;
