log_record_graded(string log_path, word log_time, string log_item, string log_verdict, string log_source, string log_met) {
  string log_event = log_line_graded(log_time, log_item, log_verdict, log_source, log_met);
  int log_written = log_append_line(log_path, log_event);
} return int log_written;
