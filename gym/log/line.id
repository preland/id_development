// Writing the text of one event, without its line break. The fields are in the
// order FORMAT.md gives, separated by tabs, and the item and the answer pass
// through log_escape. An answer longer than log_answer_limit bytes is cut to
// that length, which may split a multi-byte character; the cut is only ever of a
// pasted essay, and the line stays one valid line. The clock is an argument.

log_line_attempt(word log_time, string log_item, string log_answer, int log_confidence, string log_verdict, int log_hints, int log_seconds, int log_tapped, string log_grade) {
  int log_keep = fx_min(len(log_answer), (import log_answer_limit));
  string log_clipped = str_sub(log_answer, 0, log_keep);
  string log_tapped_text = (import log_flags)[log_tapped > 0];
} chain (word log_time, string log_item, string log_answer, int log_confidence, string log_verdict, int log_hints, int log_seconds, int log_tapped, string log_grade) {
  string[] log_fields = ["" + log_time, "attempt", log_escape(log_item), log_escape(log_clipped), "" + log_confidence, log_verdict, "" + log_hints, "" + log_seconds, log_tapped_text, log_grade];
  string log_event = str_join(log_fields, "\t");
} return string log_event;
(1760000000000, "dice_1", "3/8", 90, "correct", 0, 42, 0, ""):("1760000000000\tattempt\tdice_1\t3/8\t90\tcorrect\t0\t42\tno\t")
(5, "x", "a\tb\nc", 50, "incorrect", 4, 0, 1, "partial"):("5\tattempt\tx\ta\\tb\\nc\t50\tincorrect\t4\t0\tyes\tpartial")
(7, "y", "", 99, "unparseable", 1, 3, 5, "correct"):("7\tattempt\ty\t\t99\tunparseable\t1\t3\tyes\tcorrect")
(1, "i", "", 90, "correct", 0, 1, 0, ""):("1\tattempt\ti\\t90\tcorrect\t0\t1\tno\t")

log_line_hint(word log_time, string log_item, int log_rung) {
  string[] log_fields = ["" + log_time, "hint_shown", log_escape(log_item), "" + log_rung];
  string log_event = str_join(log_fields, "\t");
} return string log_event;
(1760000000000, "dice_1", 2):("1760000000000\thint_shown\tdice_1\t2")
(9, "a\tb", 4):("9\thint_shown\ta\\tb\t4")

log_line_session(word log_time, string log_edge) {
  string log_event = "" + log_time + "\tsession_" + log_edge;
} return string log_event;
(1760000000000, "start"):("1760000000000\tsession_start")
(1760000060000, "end"):("1760000060000\tsession_end")
