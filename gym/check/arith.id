// Exact arithmetic on whole numbers held in a word. Nothing here may wrap: a
// product that would pass check_word_maximum answers -1, because a wrapped
// product would be a different, plausible, wrong fraction.

check_greatest_divisor(word check_first, word check_second) {
  word check_big = check_first;
  word check_small = check_second;
  while (check_small != 0) {
    word check_remainder = check_big % check_small;
    check_big = check_small;
    check_small = check_remainder;
  }
} return word check_big;
