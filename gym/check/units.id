// A decimal answer is right when it is within the item's absolute tolerance of
// the reference. Both are compared in whole units of 1/check_scale_unit (a
// billionth), cut towards zero, which is exact for any decimal of nine places or
// fewer: 0.51 against 0.5 with tolerance 0.01 is exactly on the edge and passes,
// where binary floats would put 0.51 - 0.5 a hair over 0.01. The long division
// below keeps every product under 9.2e18, so no word wraps.

check_fraction_units(word check_leftover, word check_divisor) {
  word check_gathered = 0;
  word check_carry = check_leftover;
  int check_step = 0;
} chain (word check_leftover, word check_divisor) {
  while (check_step < 9) {
    check_gathered = check_gathered * 10 + check_carry * 10 / check_divisor;
    check_carry = check_carry * 10 % check_divisor;
    check_step = check_step + 1;
  }
} return word check_gathered;
(1, 3):(333333333)
(0, 7):(0)
(1, 8):(125000000)
(5, 6):(833333333)[time:O(1), mem:O(1)]
(899999999999999999, 900000000000000000):(999999999)[time:O(1), mem:O(1)]

check_units(Ratio check_ratio) {
  word check_size = check_absolute(check_ratio.top);
  word check_whole_part = check_size / check_ratio.bottom;
  word check_leftover = check_size % check_ratio.bottom;
} chain (Ratio check_ratio) {
  word check_tail = check_fraction_units(check_leftover, check_ratio.bottom);
  word check_units_found = (check_whole_part * (import check_scale_unit) + check_tail) * check_sign_of(check_ratio.top);
} return word check_units_found;
(Ratio(1, 3, 1)):(333333333)
(Ratio(-1, 3, 1)):(-333333333)
(Ratio(3, 8, 1)):(375000000)
(Ratio(5, 1, 1)):(5000000000)
(Ratio(0, 1, 1)):(0)
(Ratio(9000000000, 1, 1)):(9000000000000000000)

check_scaled_close(Ratio check_target, Ratio check_guess, Ratio check_allowance) {
  word check_gap = check_absolute(check_units(check_target) - check_units(check_guess));
  word check_allowed = check_units(check_allowance);
  int check_inside = check_gap <= check_allowed;
} return int check_inside;
(Ratio(1, 2, 1), Ratio(51, 100, 1), Ratio(1, 100, 1)):(1)
(Ratio(1, 2, 1), Ratio(52, 100, 1), Ratio(1, 100, 1)):(0)
(Ratio(1, 2, 1), Ratio(49, 100, 1), Ratio(1, 100, 1)):(1)
(Ratio(5, 12, 1), Ratio(4167, 10000, 1), Ratio(1, 1000, 1)):(1)
