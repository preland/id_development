// One decimal number, as written by a person: an optional sign, digits, at most
// one point, ".5" and "5." included. It becomes the exact fraction digits over a
// power of ten, so 0.375 is 375/1000 and no float is ever involved. The result
// is not reduced; check_number does that once, at the end. Anything else, more
// than check_digit_limit digits included, comes back with valid 0.

check_unsigned(string check_piece) {
  string check_rest = check_piece;
  if (str_starts(check_piece, "-") + str_starts(check_piece, "+") > 0) {
    check_rest = str_sub(check_piece, 1, len(check_piece) - 1);
  }
} return string check_rest;
("-3"):("3")
("+3"):("3")
("-"):("")
("--3"):("-3")

check_build(string check_digits, int check_places, int check_negative, int check_extra) {
  Ratio check_made = Ratio(0, 1, 0);
  int check_total = check_digit_total(check_digits);
  if (check_total == len(check_digits) && check_total > 0 && check_total <= (import check_digit_limit) && check_extra < 2) {
    check_made.top = check_word_value(check_digits) * (1 - 2 * check_negative);
    check_made.bottom = check_word_value("1" + str_repeat("0", check_places));
    check_made.valid = 1;
  }
} return Ratio check_made;
("375", 3, 0, 1):(Ratio(375, 1000, 1))
("5", 1, 1, 1):(Ratio(-5, 10, 1))
("12a", 0, 0, 0):(Ratio(0, 1, 0))
("", 0, 0, 0):(Ratio(0, 1, 0))
("1", 0, 0, 2):(Ratio(0, 1, 0))
("123456789012345678", 0, 0, 0):(Ratio(123456789012345678, 1, 1))
("1234567890123456789", 0, 0, 0):(Ratio(0, 1, 0))

check_decimal(string check_piece) {
  int check_negative = str_starts(check_piece, "-");
  string check_body = check_unsigned(check_piece);
  int check_dot = str_find(check_body, ".");
} chain (string check_piece) {
  string check_digits = str_replace(check_body, ".", "");
  int check_places = 0;
  if (check_dot >= 0) {
    check_places = len(check_body) - check_dot - 1;
  }
} chain (string check_piece) {
  int check_extra = len(check_body) - len(check_digits);
  Ratio check_found = check_build(check_digits, check_places, check_negative, check_extra);
} return Ratio check_found;
("0.375"):(Ratio(375, 1000, 1))
("-.5"):(Ratio(-5, 10, 1))
("+.5"):(Ratio(5, 10, 1))
("5."):(Ratio(5, 1, 1))
("007"):(Ratio(7, 1, 1))
("-0"):(Ratio(0, 1, 1))
(""):(Ratio(0, 1, 0))
("."):(Ratio(0, 1, 0))
("1.2.3"):(Ratio(0, 1, 0))
("1e5"):(Ratio(0, 1, 0))
("--3"):(Ratio(0, 1, 0))
("3/8"):(Ratio(0, 1, 0))
("123456789012345678"):(Ratio(123456789012345678, 1, 1))
("1234567890123456789"):(Ratio(0, 1, 0))
