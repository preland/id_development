// What is wrong with an item's answer fields, in words an author can act on, or
// "" when the checker can read them. `pack check` reports the message with the
// file and line of the item.

check_problem(string check_kind, string check_reference, string check_slack) {
  string check_message = "";
  Ratio check_margin_seen = check_margin(check_kind, check_slack);
  if (check_known(check_kind) == 0) {
    check_message = "unknown answer kind '" + check_kind + "'";
  }
} chain (string check_kind, string check_reference, string check_slack) {
  if (check_known(check_kind) == 1 && check_normal(check_kind, check_reference) == "") {
    check_message = "reference answer '" + check_reference + "' cannot be read as a " + check_kind;
  }
  if (check_kind == "decimal" && str_trim(check_slack) == "") {
    check_message = "a decimal item needs a tolerance";
  }
  if (check_margin_seen.valid == 0) {
    check_message = "tolerance '" + check_slack + "' is not a number of zero or more";
  }
} return string check_message;
("integer", "42", ""):("")
("fraction", "3/8", ""):("")
("decimal", "0.5", "0.01"):("")
("choice", "B", ""):("")
("text", "dependent", ""):("")
("integer", "2.5", ""):("reference answer '2.5' cannot be read as a integer")
("percent", "abc", ""):("reference answer 'abc' cannot be read as a percent")
("choice", "bc", ""):("reference answer 'bc' cannot be read as a choice")
("decimal", "0.5", ""):("a decimal item needs a tolerance")
("decimal", "0.5", "-1"):("tolerance '-1' is not a number of zero or more")
("number", "1", ""):("unknown answer kind 'number'")
