// Any number a learner may type for a fraction, decimal or percent answer:
// 3/8, 6/16, -3/8, 0.375, .375, +.5, 37.5% and 3 / 8 are all exact fractions in
// lowest terms, and 37.5% is the same fraction as 3/8. One slash at most and one
// percent sign at the end; anything else is not a number (valid 0).

check_pair(string check_core) {
  string[] check_parts = string_split(check_core, "/");
  Ratio check_result = Ratio(0, 1, 0);
  if (len(check_parts) == 2) {
    check_result = check_divide(check_decimal(check_parts[0]), check_decimal(check_parts[1]));
  }
} return Ratio check_result;
("3/8"):(Ratio(3, 8, 1))
("-3/-8"):(Ratio(3, 8, 1))
("1/"):(Ratio(0, 1, 0))
("/2"):(Ratio(0, 1, 0))
("1/2/3"):(Ratio(0, 1, 0))
("7"):(Ratio(0, 1, 0))

check_fraction(string check_core) {
  Ratio check_found = check_decimal(check_core);
  if (string_find(check_core, "/") >= 0) {
    check_found = check_pair(check_core);
  }
} return Ratio check_found;
("3/8"):(Ratio(3, 8, 1))
("0.5"):(Ratio(5, 10, 1))
("0.5/2"):(Ratio(5, 20, 1))
("x"):(Ratio(0, 1, 0))

check_number(string check_raw) {
  string check_squeezed = check_squeeze(check_raw);
  int check_percent = string_ends_with(check_squeezed, "%");
  string check_core = check_squeezed;
} chain (string check_raw) {
  if (check_percent == 1) {
    check_core = str_sub(check_squeezed, 0, len(check_squeezed) - 1);
  }
  Ratio check_value = check_fraction(check_core);
  Ratio check_hundred = Ratio(100, 1, 1);
} chain (string check_raw) {
  if (check_percent == 1) {
    check_value = check_divide(check_value, check_hundred);
  }
  Ratio check_exact = check_reduce(check_value);
} return Ratio check_exact;
("3/8"):(Ratio(3, 8, 1))
("6/16"):(Ratio(3, 8, 1))
("-3/8"):(Ratio(-3, 8, 1))
("3/-8"):(Ratio(-3, 8, 1))
("0.375"):(Ratio(3, 8, 1))
(".375"):(Ratio(3, 8, 1))
("+.5"):(Ratio(1, 2, 1))
("37.5%"):(Ratio(3, 8, 1))
("50%"):(Ratio(1, 2, 1))
(" 3 / 8 "):(Ratio(3, 8, 1))
("37.5 %"):(Ratio(3, 8, 1))
("3/8%"):(Ratio(3, 800, 1))
("0"):(Ratio(0, 1, 1))
("0/5"):(Ratio(0, 1, 1))
("7"):(Ratio(7, 1, 1))
("-7"):(Ratio(-7, 1, 1))
("1/0"):(Ratio(0, 1, 0))
("%"):(Ratio(0, 1, 0))
("5%%"):(Ratio(0, 1, 0))
("abc"):(Ratio(0, 1, 0))
(""):(Ratio(0, 1, 0))
("1 1/2"):(Ratio(0, 1, 0))
("1,5"):(Ratio(0, 1, 0))
("123456789012345678"):(Ratio(123456789012345678, 1, 1))
("1234567890123456789"):(Ratio(0, 1, 0))
("999999999999999999/999999999999999998"):(Ratio(999999999999999999, 999999999999999998, 1))
