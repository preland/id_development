// One line of a pack file is "key: value". The key is the text before the first
// colon, lower-cased, and has no spaces in it; the value is everything after,
// trimmed, colons included. A line that is not of that shape splits to two empty
// strings, and the reader reports it.

pack_cut(string pack_line, int pack_colon) {
  string pack_head = str_sub(pack_line, 0, pack_colon);
  string pack_tail = str_sub(pack_line, pack_colon + 1, len(pack_line) - pack_colon - 1);
  string[] pack_pair = [string_lower(string_trim(pack_head)), string_trim(pack_tail)];
} return string[] pack_pair;
("Name: Dice", 4):(["name", "Dice"])
("prompt: Odds: 1/6?", 6):(["prompt", "Odds: 1/6?"])
("key:", 3):(["key", ""])

pack_split(string pack_line) {
  int pack_colon = string_find(pack_line, ":");
  string[] pack_pair = ["", ""];
  if (pack_colon > 0) {
    pack_pair = pack_cut(pack_line, pack_colon);
  }
} chain (string pack_line) {
  if (string_find(pack_pair[0], " ") >= 0) {
    pack_pair = ["", ""];
  }
} return string[] pack_pair;
("name: Dice"):(["name", "Dice"])
("Hint_Nudge:   Think about it  "):(["hint_nudge", "Think about it"])
("no colon here"):(["", ""])
(": value only"):(["", ""])
("two words: value"):(["", ""])
("url: http://x"):(["url", "http://x"])
