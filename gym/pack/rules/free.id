// Rules for items whose answer is prose. A free answer is never decided by the
// checker: the grader model or the learner marks it line by line against the
// item's rubric, so the rubric has to be there and has to have at least two
// lines (one line is a verdict, not a checklist). And an item may say which
// concept presentation best explains its answer; the word must be one of the
// five the concepts carry.

pack_free_gaps(Pack pack_book, int pack_block) {
  string[] pack_found_problems = [];
  int pack_rubric_total = len(pack_fields(pack_book, pack_block, "rubric"));
  string pack_who = "free item '" + pack_id_of(pack_book, pack_block) + "'";
} chain (Pack pack_book, int pack_block) {
  if (pack_field(pack_book, pack_block, "answer_kind") == "free" && pack_rubric_total < 2) {
    push(pack_found_problems, pack_say(pack_book, pack_block, "rubric", pack_who + " has " + pack_rubric_total + " rubric line(s); a free item needs at least 2 checkable statements to mark against"));
  }
} return string[] pack_found_problems;
given pack_fixture_parse("item: i\nanswer_kind: free\nrubric: a\nrubric: b\n") ((import pack_fixture_book), 0):([])
given pack_fixture_parse("item: i\nanswer_kind: free\nrubric: a\n") ((import pack_fixture_book), 0):(["t.txt:3: free item 'i' has 1 rubric line(s); a free item needs at least 2 checkable statements to mark against"])
given pack_fixture_parse("item: i\nanswer_kind: free\n") ((import pack_fixture_book), 0):(["t.txt:1: free item 'i' has 0 rubric line(s); a free item needs at least 2 checkable statements to mark against"])
given pack_fixture_parse("item: i\nanswer_kind: integer\nrubric: a\n") ((import pack_fixture_book), 0):([])

pack_presentation_label(Pack pack_book, int pack_block) {
  string[] pack_found_problems = [];
  string pack_presentation_value = pack_field(pack_book, pack_block, "presentation");
  string pack_presentation_message = "item '" + pack_id_of(pack_book, pack_block) + "' has presentation '" + pack_presentation_value + "'; use intuition, definition, example, non_example or worked";
} chain (Pack pack_book, int pack_block) {
  if (pack_presentation_value != "" && list_string_index((import pack_presentations), pack_presentation_value) < 0) {
    push(pack_found_problems, pack_say(pack_book, pack_block, "presentation", pack_presentation_message));
  }
} return string[] pack_found_problems;
given pack_fixture_parse("item: i\npresentation: worked\n") ((import pack_fixture_book), 0):([])
given pack_fixture_parse("item: i\npresentation: story\n") ((import pack_fixture_book), 0):(["t.txt:2: item 'i' has presentation 'story'; use intuition, definition, example, non_example or worked"])
given pack_fixture_parse("item: i\n") ((import pack_fixture_book), 0):([])
