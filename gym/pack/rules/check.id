// pack check DIR itself: a directory that is not one answers that and nothing
// else; otherwise the problems of loading come first, then the whole-pack rules,
// then the rules of each concept and each item. Empty means the pack is good.

pack_check(string pack_directory) {
  Pack pack_book = pack_load(pack_directory);
  string[] pack_all_problems = [];
  if (fs_is_directory(pack_directory) == 0) {
    push(pack_all_problems, pack_directory + ": not a directory");
    return pack_all_problems;
  }
} chain (string pack_directory) {
  list_string_extend(pack_all_problems, pack_book.notes.problems);
  list_string_extend(pack_all_problems, pack_empty_problems(pack_book));
  list_string_extend(pack_all_problems, pack_duplicates(pack_book, "concept"));
} chain (string pack_directory) {
  list_string_extend(pack_all_problems, pack_duplicates(pack_book, "item"));
  list_string_extend(pack_all_problems, pack_concept_problems(pack_book));
  list_string_extend(pack_all_problems, pack_item_problems(pack_book));
} return string[] pack_all_problems;
("/nonexistent/gym/pack/dir"):(["/nonexistent/gym/pack/dir: not a directory"])
