given pack_fixture_parse("concept: a\nzzz: 1\nitem: i\nyyy: 2\n") ((import pack_fixture_book), "item", pack_unknown_keys, ["earlier"]):((import pack_fixture_book), "item", pack_unknown_keys, ["earlier", "t.txt:4: unknown key 'yyy' in a item; see gym/pack/FORMAT.md"])

pack_concept_problems(Pack pack_book) {
  string[] pack_found_problems = [];
  pack_collect(pack_book, "concept", pack_unknown_keys, pack_found_problems);
  pack_collect(pack_book, "concept", pack_repeated_keys, pack_found_problems);
} chain (Pack pack_book) {
  pack_collect(pack_book, "concept", pack_missing_keys, pack_found_problems);
  pack_collect(pack_book, "concept", bind(pack_listed_problems, "requires"), pack_found_problems);
  pack_collect(pack_book, "concept", pack_part_gaps, pack_found_problems);
} return string[] pack_found_problems;
given pack_fixture_parse("concept: a\nname: A\nsummary: S\nsource: P\n") ((import pack_fixture_book)):([])
given pack_fixture_parse("concept: a\nname: A\nname: B\nsummary: S\nrequires: z\n") ((import pack_fixture_book)):(["t.txt:3: 'name' is written twice; only the first counts, so delete one", "t.txt:1: concept 'a' has no 'source' (missing or blank)", "t.txt:5: unknown concept 'z' in 'requires'"])

pack_item_problems(Pack pack_book) {
  string[] pack_found_problems = [];
  pack_collect(pack_book, "item", pack_unknown_keys, pack_found_problems);
  pack_collect(pack_book, "item", pack_repeated_keys, pack_found_problems);
} chain (Pack pack_book) {
  pack_collect(pack_book, "item", pack_missing_keys, pack_found_problems);
  pack_collect(pack_book, "item", pack_missing_rungs, pack_found_problems);
  pack_collect(pack_book, "item", bind(pack_listed_problems, "concepts"), pack_found_problems);
} chain (Pack pack_book) {
  pack_collect(pack_book, "item", pack_item_labels, pack_found_problems);
  pack_collect(pack_book, "item", pack_item_rating, pack_found_problems);
  pack_collect(pack_book, "item", pack_item_answer, pack_found_problems);
} chain (Pack pack_book) {
  pack_collect(pack_book, "item", pack_transfer_gaps, pack_found_problems);
  pack_collect(pack_book, "item", pack_synthesis_gaps, pack_found_problems);
  pack_collect(pack_book, "item", pack_free_gaps, pack_found_problems);
} chain (Pack pack_book) {
  pack_collect(pack_book, "item", pack_presentation_label, pack_found_problems);
} return string[] pack_found_problems;
