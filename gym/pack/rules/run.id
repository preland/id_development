// `pack check DIR`: load a pack and apply every rule. pack_collect runs one
// rule over every block of one kind, appending what it finds to a list the
// caller owns; pack_concept_problems and pack_item_problems name the rules of
// each kind, and pack_check adds the load problems and the whole-pack rules. An
// empty answer means the pack is good. Problems come grouped by rule, not
// sorted, and each reads "file:line: message".

pack_collect(Pack pack_book, string pack_kind, func(Pack, int) return string[] pack_rule, string[] pack_sink) {
  int[] pack_kind_blocks = pack_blocks_of(pack_book, pack_kind);
  int pack_at = 0;
  while (pack_at < len(pack_kind_blocks)) {
    list_string_extend(pack_sink, pack_rule(pack_book, pack_kind_blocks[pack_at]));
    pack_at = pack_at + 1;
  }
} return void;
