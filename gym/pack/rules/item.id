given pack_fixture_parse("item: i\nhint_nudge: n\nhint_question:\n") ((import pack_fixture_book), 0):(["t.txt:3: item 'i' has no rung 2, 'hint_question' (the guiding question); a ladder has exactly 4 rungs", "t.txt:1: item 'i' has no rung 3, 'hint_step' (the partial step); a ladder has exactly 4 rungs", "t.txt:1: item 'i' has no rung 4, 'hint_example' (the worked example); a ladder has exactly 4 rungs"])

pack_item_rating(Pack pack_book, int pack_block) {
  string[] pack_found_problems = [];
  string pack_rating_text = pack_field(pack_book, pack_block, "difficulty");
  int pack_rating_digits = check_digit_total(pack_rating_text);
} chain (Pack pack_book, int pack_block) {
  if (pack_rating_text != "" && (pack_rating_digits != len(pack_rating_text) || len(pack_rating_text) > 4 || to_int(pack_rating_text) < (import pack_difficulty_floor) || to_int(pack_rating_text) > (import pack_difficulty_ceiling))) {
    push(pack_found_problems, pack_say(pack_book, pack_block, "difficulty", "difficulty '" + pack_rating_text + "' must be a whole number from 100 to 3000"));
  }
} return string[] pack_found_problems;
