// Rules about the values of one item. A blank or absent value is not reported
// here, because pack_missing_keys already says so at the same place; these rules
// speak only when a value is there and is wrong. The ladder has exactly four
// rungs, nudge then guiding question then partial step then worked example, and
// a missing rung is the one problem that names which rung it was.

pack_missing_rungs(Pack pack_book, int pack_block) {
  string[] pack_found_problems = [];
  string pack_who = "item '" + pack_identifier_of(pack_book, pack_block) + "'";
  string[] pack_rungs = (import pack_rung_keys);
} chain (Pack pack_book, int pack_block) {
  string[] pack_labels = (import pack_rung_labels);
  int pack_at = 0;
  while (pack_at < len(pack_rungs)) {
    if (pack_field(pack_book, pack_block, pack_rungs[pack_at]) == "") {
      push(pack_found_problems, pack_say(pack_book, pack_block, pack_rungs[pack_at], pack_who + " has no rung " + (pack_at + 1) + ", '" + pack_rungs[pack_at] + "' (the " + pack_labels[pack_at] + "); a ladder has exactly 4 rungs"));
    }
    pack_at = pack_at + 1;
  }
} return string[] pack_found_problems;
