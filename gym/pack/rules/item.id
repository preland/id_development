pack_item_answer(Pack pack_book, int pack_block) {
  string[] pack_found_problems = [];
  string pack_form_value = pack_field(pack_book, pack_block, "answer_kind");
  string pack_answer_value = pack_field(pack_book, pack_block, "answer");
} chain (Pack pack_book, int pack_block) {
  string pack_answer_message = check_problem(pack_form_value, pack_answer_value, pack_field(pack_book, pack_block, "tolerance"));
  if (pack_form_value != "" && pack_answer_value != "" && pack_answer_message != "") {
    push(pack_found_problems, pack_say(pack_book, pack_block, "answer", pack_answer_message));
  }
} return string[] pack_found_problems;
