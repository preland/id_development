// Asking a Pack what a block holds. A block is a number from 0 to
// len(book.blocks.files) - 1 and the callers keep it in range; every block has at
// least one row, the concept: or item: line that opened it, so its kind and id
// are always there. A field that is not in the block reads as "" or -1, never as
// an error, and the rules in rules/ decide whether that is a problem.

pack_kind_of(Pack pack_book, int pack_block) {
  string pack_kind = pack_book.rows.keys[pack_book.blocks.firsts[pack_block]];
} return string pack_kind;
(Pack(Pack_rows(["concept", "name"], ["a", "A"], [1, 2]), Pack_blocks(["f.txt"], [0], [2]), Pack_notes("r", [], 0)), 0):("concept")
(Pack(Pack_rows(["concept", "name", "item"], ["a", "A", "i"], [1, 2, 3]), Pack_blocks(["f.txt", "f.txt"], [0, 2], [2, 1]), Pack_notes("r", [], 0)), 1):("item")

pack_id_of(Pack pack_book, int pack_block) {
  string pack_id = pack_book.rows.values[pack_book.blocks.firsts[pack_block]];
} return string pack_id;
(Pack(Pack_rows(["concept", "name"], ["a", "A"], [1, 2]), Pack_blocks(["f.txt"], [0], [2]), Pack_notes("r", [], 0)), 0):("a")
(Pack(Pack_rows(["concept", "name", "item"], ["a", "A", "i"], [1, 2, 3]), Pack_blocks(["f.txt", "f.txt"], [0, 2], [2, 1]), Pack_notes("r", [], 0)), 1):("i")

pack_row_index(Pack pack_book, int pack_block, string pack_key) {
  int pack_at = pack_book.blocks.firsts[pack_block];
  int pack_end = pack_at + pack_book.blocks.counts[pack_block];
  int pack_none = 0 - 1;
} chain (Pack pack_book, int pack_block, string pack_key) {
  while (pack_at < pack_end) {
    if (pack_book.rows.keys[pack_at] == pack_key) {
      return pack_at;
    }
    pack_at = pack_at + 1;
  }
} return int pack_none;
(Pack(Pack_rows(["concept", "name", "item", "name"], ["a", "A", "i", "I"], [1, 2, 3, 4]), Pack_blocks(["f.txt", "f.txt"], [0, 2], [2, 2]), Pack_notes("r", [], 0)), 0, "name"):(1)
(Pack(Pack_rows(["concept", "name", "item", "name"], ["a", "A", "i", "I"], [1, 2, 3, 4]), Pack_blocks(["f.txt", "f.txt"], [0, 2], [2, 2]), Pack_notes("r", [], 0)), 1, "name"):(3)
(Pack(Pack_rows(["concept", "name", "item", "name"], ["a", "A", "i", "I"], [1, 2, 3, 4]), Pack_blocks(["f.txt", "f.txt"], [0, 2], [2, 2]), Pack_notes("r", [], 0)), 0, "summary"):(-1)
(Pack(Pack_rows(["concept", "name", "item", "name"], ["a", "A", "i", "I"], [1, 2, 3, 4]), Pack_blocks(["f.txt", "f.txt"], [0, 2], [2, 2]), Pack_notes("r", [], 0)), 0, "item"):(-1)
