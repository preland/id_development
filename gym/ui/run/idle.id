// Copy what the learner typed into the session as events: the answer box's text as a type event while the rep waits for its attempt, the note box's text as a note event. Answers 1 if it sent any.
gym_lead() {
  Session gym_state = (import gym_live)[0];
  string gym_typed = gui_textbox_text((import gym_answer_box));
  int gym_open = gym_state.cells[(import gym_cell_stage)] == (import gym_stage_waiting) && gym_typed != gym_state.texts[(import gym_text_answer)];
} chain () {
  string gym_noted = gui_textbox_text((import gym_note_box));
  int gym_wrote = gym_noted != gym_state.texts[(import gym_text_note)];
  if(gym_open == 1) {
    gym_dispatch_text((import gym_event_type), gym_typed);
  }
} chain () {
  if(gym_wrote == 1) {
    gym_dispatch_text((import gym_event_note), gym_noted);
  }
  int gym_sent = gym_open || gym_wrote;
} return int gym_sent;
