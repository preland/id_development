// What a frame does whether or not an event came: let the text boxes blink their caret, copy what was typed into the session, and turn the clock into a tick event.

// The once-a-frame work. Answers 1 when the picture is to be painted again: a caret blinked, text was copied, or a second ticked.
gym_idle() {
  int gym_blink = gui_textbox_tick((import gym_answer_box)) % 2 || gui_textbox_tick((import gym_note_box)) % 2;
  int gym_copied = gym_lead();
  int gym_ticked = gym_pulse();
} chain () {
  int gym_bits = gym_blink || gym_copied || gym_ticked;
} return int gym_bits;
