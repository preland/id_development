// 1 when gym_line can be read: it is blank, it is a note (it starts with #), or it is a script word with the fields it needs.
gym_script_valid(string gym_line) {
  string[] gym_fields = str_split(gym_line, " ");
  int gym_slot = lst_str_index((import gym_script_words), gym_fields[0]);
  int gym_good = gym_script_fits(gym_fields, gym_slot) || len(str_trim(gym_line)) == 0 || str_starts(gym_line, "#") == 1;
} return int gym_good;
