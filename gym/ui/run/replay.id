// Run script line gym_line (line number gym_number) on gym_holder[0]. Answers 1 for a line that could not be read, after naming it on stderr, and 0 otherwise.
gym_replay_line(World gym_world, Session[] gym_holder, string gym_line, int gym_number) {
  int gym_ok = gym_script_valid(gym_line);
  Event gym_made = gym_script_event(gym_holder[0], gym_line);
  gym_deliver(gym_world, gym_holder, gym_made);
} chain (World gym_world, Session[] gym_holder, string gym_line, int gym_number) {
  if(gym_ok == 0) {
    eprint("gym window: script line " + gym_number + ": '" + gym_line + "' is not a script word, or lacks its fields\n" + (import gym_usage));
  }
  int gym_bad = 1 - gym_ok;
} return int gym_bad;
