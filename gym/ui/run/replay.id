// Replaying a script on a session. The session lives in a one-cell list (gym_holder), which is the one place that is allowed to change: each event goes through gym_deliver, so a script drives the same reducer and the same engine operations a person would, and what it writes to the log is what a person's clicks would have written.

// Run every line of the script text gym_script, in order, on the session in gym_holder[0]. A line that is none of the script words is named on stderr with its number and the words there are, and the rest still run. Answers how many lines could not be read.
gym_replay(World gym_world, Session[] gym_holder, string gym_script) {
  string[] gym_rows = str_split(gym_script, "\n");
  int gym_at = 0;
  int gym_bad = 0;
} chain (World gym_world, Session[] gym_holder, string gym_script) {
  while(gym_at < len(gym_rows)) {
    gym_bad = gym_bad + gym_replay_line(gym_world, gym_holder, gym_rows[gym_at], gym_at + 1);
    gym_at = gym_at + 1;
  }
} return int gym_bad;
