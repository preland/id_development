// Names for the numbers of the state, as a dump says them.

// The name of phase gym_phase, or "finished" once the clock is past the last.
gym_phase_text(int gym_phase) {
  string gym_text = "finished";
  if(gym_phase >= 0 && gym_phase < (import gym_phase_over)) {
    gym_text = (import gym_phase_names)[gym_phase];
  }
} return string gym_text;
(0):("Warm-up")
(3):("Cool-down")
(4):("finished")

// The name of the scoreboard metric whose definition is open, or "none".
gym_define_text(int gym_open) {
  string gym_text = "none";
  if(gym_open >= 0) {
    gym_text = (import gym_metric_names)[gym_open];
  }
} return string gym_text;
(-1):("none")
(2):("Calibration")
