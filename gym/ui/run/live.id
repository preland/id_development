// The live session: the window mode's one piece of changing state, a list of one Session in the export gym_live. The loop replaces the cell with the new state after every event (run/dispatch.id), so nothing else is ever changed in place.

// Start the live session: the first item in play, nothing picked, the clock at zero. It knows nothing of the log yet; gym_live_begin reads that.
gym_live_open() {
  Session gym_opening = gym_start(0);
  export Session[] gym_live = [gym_opening];
} return void export gym_live;
