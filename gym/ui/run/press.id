given gym_live_open given gym_fixture_ready_live given gym_fixture_down(700, 280) (4, [4, 700, 280, 1, 0], 2, 5):(5)
given gym_live_open given gym_fixture_ready_live given gym_fixture_down(700, 280) (4, [4, 700, 280, 1, 0], 3, -1):(-1)

// A click at (gym_left, gym_top): a press and a release there. Answers the command of the button it lands on, or -1.
gym_hit(int gym_left, int gym_top) {
  int[] gym_down = [3, gym_left, gym_top, 1, 1];
  int[] gym_up = [4, gym_left, gym_top, 1, 0];
  int gym_armed = gym_press(3, gym_down);
} chain (int gym_left, int gym_top) {
  int gym_found = gym_press(4, gym_up);
} return int gym_found;
