// A log file of the case's own for the cases of the functions that open a world from the command line, kept apart from the script a case replays.

// Make a folder with fs_mktemp (so no two cases share one) and keep the path of a learner.log in it, which does not exist yet, in the export gym_fixture_trail_log.
gym_fixture_trail() {
  string gym_trail_folder = fs_mktemp("gym_ui_trail_", 1);
  export string gym_fixture_trail_log = gym_trail_folder + "/learner.log";
} return void export gym_fixture_trail_log;
given gym_fixture_trail ():() then fs_exists((import gym_fixture_trail_log)):(0)
given gym_fixture_trail ():() then path_base((import gym_fixture_trail_log)):("learner.log")
