// Write the surface to the file at gym_path as a binary PPM (P6, 255). Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
gym_ppm_write(string gym_path) {
  int gym_handle = fs_open(gym_path, "w");
  string gym_head = "P6\n" + (import sf_l_w) + " " + (import sf_l_h) + "\n255\n";
  int gym_lost = 1;
} chain (string gym_path) {
  if(gym_handle >= 0) {
    gym_lost = fs_write(gym_handle, exec_bytes(gym_head), len(gym_head)) - len(gym_head);
    gym_lost = gym_lost + gym_ppm_rows(gym_handle);
    gym_lost = gym_lost + fs_close(gym_handle);
  }
  if(gym_lost != 0) {
    eprint("gym window: the picture could not be written; check that the folder exists and that you may write to it [" + gym_path + "]");
  }
} return int gym_lost;
