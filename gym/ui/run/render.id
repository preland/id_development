// Paint the state on a surface of the window's size and write it to the file at gym_path. Answers 0, or 1 after naming on stderr what went wrong.
gym_render(Session gym_state, string gym_path) {
  gym_ui_open((import gym_window_width), (import gym_window_height));
  gym_paint(gym_state);
  int gym_lost = gym_picture_file_write(gym_path);
} return int gym_lost;
