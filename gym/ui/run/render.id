// A picture of a state in a file: the whole window painted on a fresh surface and written as a binary PPM, for --render-after and for looking at a screen without a display.

// Open a surface of gym_width by gym_height, start the font layer, tile the idml page and make the widgets: all a paint needs. The window mode and the render both start here.
gym_ui_open(int gym_width, int gym_height) {
  sf_l_init(gym_width, gym_height);
  gui_font_init();
  gym_page(gym_width, gym_height);
} chain (int gym_width, int gym_height) {
  gym_widgets();
} return void;
