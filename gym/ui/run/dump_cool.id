// The cool-down facts in a dump.

// A line for each line of the cool-down text, which is empty until the session is over.
gym_dump_cool(Session gym_state) {
  string[] gym_lines = [];
  string[] gym_parts = str_lines(gym_state.texts[(import gym_text_cool)]);
  int gym_at = 0;
} chain (Session gym_state) {
  while(gym_at < len(gym_parts)) {
    push(gym_lines, "cool " + gym_parts[gym_at]);
    gym_at = gym_at + 1;
  }
} return string[] gym_lines;
(Session([0, 0, 0, 0, 0, 0, 0, 0, 300, -1, 0, 0, 0, 0, 0], ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""])):([])
(Session([0, 0, 0, 0, 0, 0, 0, 0, 300, -1, 0, 0, 0, 0, 0], ["", "", "", "", "", "", "", "", "", "", "a\nb", "", "", "", "", "", "", "", "", "", ""])):(["cool a", "cool b"])
