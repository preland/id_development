// Two answers of the event functions put together: paint again if either says so (bit 1), close if either says so (bit 2).
gym_merge(int gym_left_bits, int gym_right_bits) {
  int gym_paint_again = gym_left_bits % 2 || gym_right_bits % 2;
  int gym_close = gym_left_bits / 2 || gym_right_bits / 2;
  int gym_both = gym_paint_again + 2 * gym_close;
} return int gym_both;
