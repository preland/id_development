// Give one event to both text boxes. Answers 1 if either wants to be drawn again plus 2 if either was activated (Enter in it).
gym_boxes_event(int gym_kind, int[] gym_input) {
  int gym_first_bits = gui_textbox_event((import gym_answer_box), gym_kind, gym_input);
  int gym_second_bits = gui_textbox_event((import gym_note_box), gym_kind, gym_input);
  int gym_bits = gym_merge(gym_first_bits % 2, gym_second_bits % 2) + 2 * (gym_first_bits / 2 % 2 || gym_second_bits / 2 % 2);
} return int gym_bits;
