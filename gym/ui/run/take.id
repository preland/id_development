// One window event, given to the buttons, the text boxes and the reducer.

// Take in one event as gfx_event wrote it (gym_kind and gym_input: 1 key, 2 text, 3 down, 4 up, 5 move, 7 close). The text boxes see it first; a press and release on a button gives that button's event to the reducer; a key the boxes did not have the keyboard for gives a key event, and Enter in a box gives an Enter. Answers 1 for the picture to be painted again plus 2 when the window was closed.
gym_take(int gym_kind, int[] gym_input) {
  int gym_typing = gym_typing_now();
  int gym_box_bits = gym_boxes_event(gym_kind, gym_input);
  int gym_synced = gym_lead();
} chain (int gym_kind, int[] gym_input) {
  int gym_command = 0 - 1;
  if(gym_kind >= 3 && gym_kind <= 5) {
    gym_command = gym_press(gym_kind, gym_input);
  }
  if(gym_command >= 0) {
    gym_dispatch(gym_command_event(gym_command));
  }
} chain (int gym_kind, int[] gym_input) {
  if(gym_kind == 1 && gym_typing == 0) {
    gym_dispatch_number((import gym_event_key), gym_input[1]);
  }
  if(gym_box_bits / 2 % 2 == 1) {
    gym_dispatch_number((import gym_event_key), (import gym_key_enter));
  }
  int gym_bits = 1 + 2 * (gym_kind == 7);
} return int gym_bits;
