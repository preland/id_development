// 1 when either text box has the keyboard.
gym_typing_now() {
  int gym_answer_focus = gui_textbox_cell((import gym_answer_box), (import gui_tbw_o_focus));
  int gym_note_focus = gui_textbox_cell((import gym_note_box), (import gui_tbw_o_focus));
