// The rows of a PPM: the bytes of the surface, top to bottom.

// Write every row of the surface to the open file gym_handle. Answers how many bytes did not get there, 0 when all did.
gym_ppm_rows(int gym_handle) {
  int gym_top = 0;
  int gym_lost = 0;
  while(gym_top < (import sf_l_h)) {
    int[] gym_bytes = gym_ppm_row(gym_top);
    gym_lost = gym_lost + len(gym_bytes) - fs_write(gym_handle, gym_bytes, len(gym_bytes));
    gym_top = gym_top + 1;
  }
} return int gym_lost;
