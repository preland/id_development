// One row of the surface as the bytes of a binary PPM: red, green and blue of each pixel, left to right.
gym_ppm_row(int gym_top) {
  int[] gym_bytes = [];
  int gym_left = 0;
  while(gym_left < (import sf_l_w)) {
    int gym_color = (import sf_l_px)[sf_l_idx(gym_left, gym_top)];
    lst_extend(gym_bytes, [gym_color / 65536 % 256, gym_color / 256 % 256, gym_color % 256]);
    gym_left = gym_left + 1;
  }
} return int[] gym_bytes;
