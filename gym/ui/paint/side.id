// How many items the next session brings back, large, with a line saying which ones. Before the session is over the count is not known, and the card says so.
gym_paint_due(Session gym_state) {
  int[] gym_box = gym_rectangle_of("cool_due");
  string[] gym_lines = str_lines(gym_state.texts[(import gym_text_cool)]);
  string gym_due = "after the session";
} chain (Session gym_state) {
  gym_inset(gym_box, (import gym_card_inset));
  gym_card(gym_box[0], gym_box[1], gym_box[2], gym_box[3], (import th_l_surface), (import th_l_separator));
  if(len(gym_lines) >= 4) {
    gym_due = str_after(gym_lines[3], ": ") + " due";
  }
} chain (Session gym_state) {
  int gym_end = gym_block(28, 1, "Next session: " + gym_due, gym_box[0] + 16, gym_box[1] + 12, gym_box[2] - 32, (import th_l_label));
  gym_end = gym_block(14, 0, "Items you missed, or needed a hint for, come back first.", gym_box[0] + 16, gym_end + 4, gym_box[2] - 32, (import th_l_label_secondary));
} return void;
