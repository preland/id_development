// The other two parts of the cool-down screen.

// The caption over the note box. It says how to keep the line (Enter writes it to the log) and, once it is kept, that it is.
gym_paint_note(Session gym_state) {
  int[] gym_area = gym_rectangle_of("cool_note");
  string gym_caption = "What would you tell yourself an hour ago? Press Enter to keep it.";
  if(gym_state.cells[(import gym_cell_saved)] == 1) {
    gym_caption = "Kept in your log. Change it and press Enter to keep the new line.";
  }
} chain (Session gym_state) {
  gym_label(gym_caption, gym_area[0] + 14, gym_area[1] + 2, 22, (import th_l_label_secondary));
} return void;
