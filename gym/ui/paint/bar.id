// The session bar: the four phases in a row with the one the clock is in marked, and the time left in it. It shows where the learner is in the session and says nothing about how much is done.

// Draw the session bar in the cell of the page called phases: the four phases, then a line with the current phase and the time left in it.
gym_paint_bar(Session gym_state) {
  int[] gym_box = gym_rectangle_of("phases");
  int gym_index = 0;
  while(gym_index < len((import gym_phase_names))) {
    gym_paint_phase(gym_state, gym_box, gym_index);
    gym_index = gym_index + 1;
  }
} chain (Session gym_state) {
  gym_paint_status(gym_state, gym_box);
} return void;
