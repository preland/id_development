// Draw phase gym_index in its quarter of the bar: the current phase in the accent colour, the ones behind it pale, the ones to come plain, each labelled with its name.
gym_paint_phase(Session gym_state, int[] gym_box, int gym_index) {
  int gym_now = gym_state.cells[(import gym_cell_phase)];
  int gym_slot = (gym_box[2] - 24) / len((import gym_phase_names));
