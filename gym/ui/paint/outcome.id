// The outcome card under the buttons of the rep screen: what to do before an attempt, and after one the result, the reference answer, the reason and the hint rungs revealed so far.

// Draw the outcome card. Before an attempt it explains the order of a rep; after one it shows the result.
gym_paint_outcome(Session gym_state) {
  int[] gym_box = gym_rectangle_of("outcome");
  gym_inset(gym_box, (import gym_card_inset));
  gym_card(gym_box[0], gym_box[1], gym_box[2], gym_box[3], (import theme_l_surface), (import theme_l_separator));
} chain (Session gym_state) {
  int gym_stage = gym_state.cells[(import gym_cell_stage)];
  if(gym_stage == (import gym_stage_waiting)) {
    int gym_end = gym_block(15, 0, "Type your answer, pick how sure you are, then Submit. Hints open once you have committed an attempt. Tap out shows the worked example if you would rather see the answer.", gym_box[0] + 16, gym_box[1] + 14, gym_box[2] - 32, (import theme_l_label_secondary));
  }
  if(gym_stage != (import gym_stage_waiting)) {
    gym_paint_result(gym_state, gym_box);
  }
} chain (Session gym_state) {
  gym_paint_notice(gym_state, gym_box);
} return void;
