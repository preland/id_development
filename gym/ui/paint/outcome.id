// The result of a finished rep inside the outcome card gym_box: the verdict, the reference answer, the reason, and the hint rungs revealed.
gym_paint_result(Session gym_state, int[] gym_box) {
  int gym_left = gym_box[0] + 16;
  int gym_span = gym_box[2] - 32;
  string gym_why = "Why: " + string_replace(gym_state.texts[(import gym_text_rubric)], "\n", "; ");
} chain (Session gym_state, int[] gym_box) {
  int gym_row = gym_block(18, 1, gym_verdict_text(gym_state), gym_left, gym_box[1] + 10, gym_span, gym_verdict_color(gym_state));
  gym_row = gym_block(15, 0, "Reference answer: " + gym_state.texts[(import gym_text_reference)], gym_left, gym_row + 2, gym_span, (import theme_l_label));
  gym_row = gym_block(14, 0, gym_why, gym_left, gym_row + 2, gym_span, (import theme_l_label_secondary));
} chain (Session gym_state, int[] gym_box) {
  gym_paint_rungs(gym_state, gym_left, gym_row + 6, gym_span);
} return void;
