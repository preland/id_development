// One whole picture of a state: tile the page for its screen, put the widgets in place, draw the background, the session bar, the screen and then the widgets over it. Everything drawn comes from the state; nothing is read from a clock or a window.

// Paint the state on the surface (sf_l_init made one): the whole window.
gym_paint(Session gym_state) {
  gym_layout(gym_state);
  gym_place(gym_state);
  surface_fill_rectangle(0, 0, (import pixel_surface_width), (import pixel_surface_height), (import theme_l_window));
} chain (Session gym_state) {
  gym_paint_bar(gym_state);
  gym_paint_screen(gym_state);
  gym_paint_widgets(gym_state);
} return void;
