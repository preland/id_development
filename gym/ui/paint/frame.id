// The screen the state shows, under the session bar.
gym_paint_screen(Session gym_state) {
  int gym_shown = gym_state.cells[(import gym_cell_screen)];
  if(gym_shown == (import gym_screen_repetition)) {
    gym_paint_repetition(gym_state);
  }
  if(gym_shown == (import gym_screen_score)) {
    gym_paint_score(gym_state);
  }
} chain (Session gym_state) {
  if(gym_shown == (import gym_screen_cool_down)) {
    gym_paint_cool(gym_state);
  }
} return void;
