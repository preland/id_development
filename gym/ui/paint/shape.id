// The rectangles the screens are made of.

// A filled rectangle of colour gym_fill with a one pixel border of colour gym_edge.
gym_card(int gym_left, int gym_top, int gym_span, int gym_tall, int gym_fill, int gym_edge) {
  d2_l_rect(gym_left, gym_top, gym_span, gym_tall, gym_edge);
  d2_l_rect(gym_left + 1, gym_top + 1, gym_span - 2, gym_tall - 2, gym_fill);
} return void;
given gym_fixture_fonts (10, 10, 20, 20, 255, 65280):() then gym_fixture_pixel(10, 10):(65280) then gym_fixture_pixel(15, 15):(255) then gym_fixture_pixel(30, 30):(0)
given gym_fixture_fonts (0, 0, 5, 5, 1, 2):() then gym_fixture_pixel(0, 0):(2) then gym_fixture_pixel(2, 2):(1) then gym_fixture_pixel(4, 4):(2)

// A frame of colour gym_color, gym_width pixels thick, just inside the rectangle: the mark that shows a chosen button.
gym_outline(int[] gym_box, int gym_width, int gym_color) {
  d2_l_rect(gym_box[0], gym_box[1], gym_box[2], gym_width, gym_color);
  d2_l_rect(gym_box[0], gym_box[1] + gym_box[3] - gym_width, gym_box[2], gym_width, gym_color);
  d2_l_rect(gym_box[0], gym_box[1], gym_width, gym_box[3], gym_color);
} chain (int[] gym_box, int gym_width, int gym_color) {
  d2_l_rect(gym_box[0] + gym_box[2] - gym_width, gym_box[1], gym_width, gym_box[3], gym_color);
} return void;
given gym_fixture_fonts ([10, 10, 30, 30], 3, 255):([10, 10, 30, 30], 3, 255) then gym_fixture_pixel(10, 20):(255) then gym_fixture_pixel(25, 25):(0) then gym_fixture_pixel(38, 20):(255) then gym_fixture_pixel(20, 38):(255)
given gym_fixture_fonts ([0, 0, 4, 4], 1, 7):([0, 0, 4, 4], 1, 7) then gym_fixture_pixel(0, 2):(7) then gym_fixture_pixel(2, 2):(0) then gym_fixture_pixel(3, 3):(7)

// Draw gym_text with its left edge at gym_left and the line vertically centred in the band of gym_tall pixels from gym_top, in a plain 14 pixel sans-serif and colour gym_color.
gym_label(string gym_text, int gym_left, int gym_top, int gym_tall, int gym_color) {
  int gym_font = gui_face("sans-serif", 14, 0);
  int gym_font_height = gui_font_line(gym_font);
  gui_text_draw(gym_font, gym_left, gym_top + (gym_tall - gym_font_height) / 2, gym_text, gym_color);
} return void;
