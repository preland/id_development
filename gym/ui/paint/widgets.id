// The widgets, drawn over the cards: the buttons of the screen in play, a frame round the chosen confidence and the current screen, and the text box of the screen.

// Draw the visible buttons, mark the chosen ones, and draw the text box the screen has, after bringing its text in line with the state.
gym_paint_widgets(Session gym_state) {
  gym_boxes_follow(gym_state);
  gym_draw_buttons(gym_state);
  gym_mark_chosen(gym_state);
} chain (Session gym_state) {
  gym_draw_boxes(gym_state);
} return void;
