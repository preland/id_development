// Draw button gym_command if the state shows it.
gym_draw_button(Session gym_state, int gym_command) {
  if(gym_command_visible(gym_state, gym_command) == 1) {
    gui_btn_draw((import gym_buttons)[gym_command]);
  }
} return void;
