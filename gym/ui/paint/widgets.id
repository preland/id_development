// Draw every button that has a place on the screen the state shows.
gym_draw_buttons(Session gym_state) {
  int gym_command = 0;
  while(gym_command < (import gym_command_count)) {
    gym_draw_button(gym_state, gym_command);
    gym_command = gym_command + 1;
  }
} return void;
