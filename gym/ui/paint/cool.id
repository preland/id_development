// The card of where confidence was off: the items of the session and the answers that were wrong at 90 percent or more, or a plain line while the session is still going.
gym_paint_off(Session gym_state) {
  int[] gym_box = gym_rectangle_of("cool_items");
  gym_inset(gym_box, (import gym_card_inset));
  gym_card(gym_box[0], gym_box[1], gym_box[2], gym_box[3], (import theme_l_surface_raised), (import theme_l_separator));
} chain (Session gym_state) {
  string[] gym_lines = str_lines(gym_state.texts[(import gym_text_cool)]);
  int gym_end = gym_block(18, 1, "Where your confidence was off", gym_box[0] + 16, gym_box[1] + 10, gym_box[2] - 32, (import theme_l_label));
  gym_paint_off_list(gym_lines, gym_box, gym_end);
} return void;
