// The lines of the cool-down text that belong on the card of gym_box, under the heading that ends at gym_top: the number of items and the confident misses (the first line says the session is complete and the last is the due count, which has its own card). With no text yet, a line saying when it will come.
gym_paint_off_list(string[] gym_lines, int[] gym_box, int gym_top) {
  int gym_row = gym_top + 4;
  int gym_at = 1;
  if(len(gym_lines) == 0) {
    gym_row = gym_block(14, 0, "This fills in when the last item is done: the answers you were sure of and got wrong.", gym_box[0] + 16, gym_row, gym_box[2] - 32, (import theme_l_label_secondary));
  }
} chain (string[] gym_lines, int[] gym_box, int gym_top) {
  while(gym_at < fixed_point_minimum(len(gym_lines) - 1, 3)) {
    gym_row = gym_block(14, 0, gym_lines[gym_at], gym_box[0] + 16, gym_row + 4, gym_box[2] - 32, (import theme_l_label_secondary));
    gym_at = gym_at + 1;
  }
} return void;
