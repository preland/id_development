// Draw gym_text wrapped to gym_span pixels at (gym_left, gym_top) in the sans-serif at gym_size pixels (bold when gym_bold is 1) and colour gym_color. Answers the y just under the last line.
gym_block(int gym_size, int gym_bold, string gym_text, int gym_left, int gym_top, int gym_span, int gym_color) {
  int gym_font = gui_face("sans-serif", gym_size, gym_bold);
  string[] gym_lines = gym_wrap_lines(gym_font, gym_text, gym_span);
  int gym_step = gui_font_line(gym_font) + 3;
} chain (int gym_size, int gym_bold, string gym_text, int gym_left, int gym_top, int gym_span, int gym_color) {
  int gym_row = 0;
  int gym_end = gym_top + len(gym_lines) * gym_step;
  while(gym_row < len(gym_lines)) {
    gui_text_draw(gym_font, gym_left, gym_top + gym_row * gym_step, gym_lines[gym_row], gym_color);
    gym_row = gym_row + 1;
  }
} return int gym_end;
