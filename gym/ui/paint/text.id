// Text and boxes on the surface: breaking a text into lines that fit a width, drawing a block of it, and the filled rectangle with a border every card is made of.

// The lines the text gym_text breaks into when each may be gym_width pixels wide in font gym_font: words stay whole and share a line while they fit, and a word wider than the width gets a line to itself.
gym_wrap_lines(int gym_font, string gym_text, int gym_width) {
  string[] gym_lines = [];
  string[] gym_pieces = string_words(gym_text);
  string gym_current = "";
} chain (int gym_font, string gym_text, int gym_width) {
  int gym_at = 0;
  while(gym_at < len(gym_pieces)) {
    gym_current = gym_wrap_step(gym_lines, gym_font, gym_current, gym_pieces[gym_at], gym_width);
    gym_at = gym_at + 1;
  }
  if(len(gym_current) > 0) {
    push(gym_lines, gym_current);
  }
} return string[] gym_lines;
given gym_fixture_fonts given gym_fixture_open(14) (0, "", 1000):([])
given gym_fixture_fonts given gym_fixture_open(14) (0, "alpha beta gamma", 1000):(["alpha beta gamma"])
