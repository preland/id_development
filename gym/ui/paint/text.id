given gym_fixture_fonts given gym_fixture_open(14) (0, "alpha beta gamma alpha beta gamma alpha beta gamma alpha beta gamma", 1):(["alpha", "beta", "gamma", "alpha", "beta", "gamma", "alpha", "beta", "gamma", "alpha", "beta", "gamma"])[time:O(n), mem:O(n)]

// Add word gym_piece to the line being built, gym_current, when it still fits in gym_width; else push gym_current onto gym_lines and start the next line with the word. Answers the line being built.
gym_wrap_step(string[] gym_lines, int gym_font, string gym_current, string gym_piece, int gym_width) {
  int gym_room = gym_width - gui_text_width(gym_font, gym_current);
  int gym_need = gui_text_width(gym_font, " " + gym_piece);
  string gym_carry = gym_piece;
} chain (string[] gym_lines, int gym_font, string gym_current, string gym_piece, int gym_width) {
  if(len(gym_current) > 0 && gym_need <= gym_room) {
    gym_carry = gym_current + " " + gym_piece;
  }
  if(len(gym_current) > 0 && gym_need > gym_room) {
    push(gym_lines, gym_current);
  }
} return string gym_carry;
