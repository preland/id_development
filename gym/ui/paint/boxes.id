// Put gym_wanted in text box gym_widget unless it holds that already, which keeps the caret and the selection where they are.
gym_follow_box(GuiTextBox gym_widget, string gym_wanted) {
  if(gui_textbox_text(gym_widget) != gym_wanted) {
    gui_textbox_set(gym_widget, gym_wanted);
  }
} return void;
