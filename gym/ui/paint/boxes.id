// Draw the text box of the screen the state shows: the answer box on the rep screen, the note box on the cool-down screen.
gym_draw_boxes(Session gym_state) {
  int gym_shown = gym_state.cells[(import gym_cell_screen)];
  if(gym_shown == (import gym_screen_repetition)) {
    gui_textbox_draw((import gym_answer_box));
  }
  if(gym_shown == (import gym_screen_cool_down)) {
    gui_textbox_draw((import gym_note_box));
  }
} return void;
