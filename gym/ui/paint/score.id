// One metric: a card with its name over its line. The "?" button that opens its definition is drawn over the card's right end.
gym_paint_row(Session gym_state, int gym_metric) {
  int[] gym_box = gym_rectangle_of("score_list");
  int gym_top = gym_metric_top(gym_metric);
  gym_card(gym_box[0] + 10, gym_top, gym_box[2] - 20, (import gym_metric_step) - 8, (import th_l_surface_raised), (import th_l_separator));
} chain (Session gym_state, int gym_metric) {
  int gym_end = gym_block(15, 1, (import gym_metric_names)[gym_metric], gym_box[0] + 24, gym_top + 6, gym_box[2] - 90, (import th_l_label));
  gym_label(gym_state.texts[(import gym_text_metric) + gym_metric], gym_box[0] + 24, gym_top + 26, 20, (import th_l_label_secondary));
} return void;
