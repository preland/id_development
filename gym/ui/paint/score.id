// The heading of the metric list and a row for each metric.
gym_paint_list(Session gym_state) {
  int[] gym_box = gym_rectangle_of("score_list");
  int gym_metric = 0;
  int gym_end = gym_block(20, 1, "Scoreboard", gym_box[0] + 16, gym_box[1] + 8, gym_box[2] - 32, (import th_l_label));
} chain (Session gym_state) {
  gym_label("Delayed, unassisted, new-context results only; " + gym_state.texts[(import gym_text_head)] + ".", gym_box[0] + 16, gym_box[1] + 30, 20, (import th_l_label_tertiary));
  while(gym_metric < len((import gym_metric_names))) {
    gym_paint_row(gym_state, gym_metric);
    gym_metric = gym_metric + 1;
  }
} return void;
