// The caption over the answer box and the question beside the confidence buttons. The caption names the rule the screen keeps: the answer and the confidence come before any help.
gym_paint_captions() {
  int[] gym_answer_cell = gym_rectangle_of("answer");
  int[] gym_choice_cell = gym_rectangle_of("choice_label");
  gym_label("Your answer", gym_answer_cell[0] + 14, gym_answer_cell[1] + 2, 22, (import theme_l_label_secondary));
} chain () {
  gym_label("How sure are you? Pick one before you submit.", gym_choice_cell[0] + 14, gym_choice_cell[1], gym_choice_cell[3], (import theme_l_label_secondary));
} return void;
