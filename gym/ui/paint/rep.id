// The prompt of the item in play on a raised card, under a small caption.
gym_paint_question(Session gym_state) {
  int[] gym_box = gym_rectangle_of("prompt");
  gym_inset(gym_box, (import gym_card_inset));
  gym_card(gym_box[0], gym_box[1], gym_box[2], gym_box[3], (import theme_l_surface_raised), (import theme_l_separator));
} chain (Session gym_state) {
  gym_label("Question", gym_box[0] + 16, gym_box[1] + 8, 22, (import theme_l_label_tertiary));
  int gym_end = gym_block(20, 0, gym_state.texts[(import gym_text_prompt)], gym_box[0] + 16, gym_box[1] + 34, gym_box[2] - 32, (import theme_l_label));
} return void;
