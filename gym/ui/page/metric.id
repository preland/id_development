// The rectangle of the "?" button of scoreboard metric gym_metric: a square at the right end of its row.
gym_help_box(int gym_metric) {
  int[] gym_list = gym_rectangle_of("score_list");
  int gym_top = gym_metric_top(gym_metric);
  int[] gym_box = [gym_list[0] + gym_list[2] - 46, gym_top + 4, 28, 28];
} return int[] gym_box;
