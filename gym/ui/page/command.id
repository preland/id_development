// 1 when the button of command gym_command can be pressed in the state, as the engine's own gates say (gym/session): the levels and Tap out while the rep waits for its attempt, Submit with an answer and a confidence, Hint only after a committed attempt and never in the warm-up, Next once the rep is finished. The screen buttons and the scoreboard "?" are always on.
gym_command_enabled(Session gym_state, int gym_command) {
  string[] gym_seen_now = gym_seen(gym_state);
  string gym_typed = gym_state.texts[(import gym_text_answer)];
  int gym_ready = 1;
} chain (Session gym_state, int gym_command) {
  if(gym_command < (import gym_command_submit) || gym_command == (import gym_command_tap_out)) {
    gym_ready = session_answer_gate(gym_seen_now, "tap-out", (import session_confidence_default)) == "";
  }
  if(gym_command == (import gym_command_submit)) {
    gym_ready = session_answer_gate(gym_seen_now, gym_typed, gym_state.cells[(import gym_cell_confidence)]) == "";
  }
  if(gym_command == (import gym_command_hint)) {
    gym_ready = session_hint_gate(gym_seen_now) == "";
  }
} chain (Session gym_state, int gym_command) {
  if(gym_command == (import gym_command_next)) {
    gym_ready = session_move_gate(gym_seen_now) == "";
  }
} return int gym_ready;
