// Which commands show on a screen, which are enabled in a state, and where each button sits. The enabled rules are the engine's own gates, so the screen shows what the engine would accept.

// 1 when command gym_command has a button on the screen the state shows: the confidence levels, Submit, Hint, Tap out and Next on the rep screen, the three screen buttons always, and the "?" of each metric on the scoreboard.
gym_command_visible(Session gym_state, int gym_command) {
  int gym_shown = gym_state.cells[(import gym_cell_screen)];
  int gym_always = gym_command >= (import gym_command_screens) && gym_command < (import gym_command_help);
  int gym_visible = gym_always + (gym_command < (import gym_command_screens) && gym_shown == (import gym_screen_repetition)) + (gym_command >= (import gym_command_help) && gym_shown == (import gym_screen_score));
} return int gym_visible;
