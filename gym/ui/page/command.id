// The rectangle of command gym_command's button: its cell on the page shrunk by the button inset, the "?" box of its row on the scoreboard, and all zero when the button is not on the screen the state shows.
gym_command_box(Session gym_state, int gym_command) {
  int[] gym_box = [0, 0, 0, 0];
  if(gym_command < (import gym_command_help)) {
    gym_box = gym_rectangle_of((import gym_command_cells)[gym_command]);
    gym_inset(gym_box, (import gym_button_inset));
  }
  if(gym_command >= (import gym_command_help)) {
    gym_box = gym_help_box(gym_command - (import gym_command_help));
  }
} chain (Session gym_state, int gym_command) {
  if(gym_command_visible(gym_state, gym_command) == 0) {
    gym_box = [0, 0, 0, 0];
  }
} return int[] gym_box;
