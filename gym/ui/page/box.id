gym_place_box(GuiTextBox gym_widget, string gym_class, int gym_visible) {
  int[] gym_area = gym_rectangle_of(gym_class);
  int gym_pad = (import gym_card_inset);
  gui_textbox_place(gym_widget, gym_area[0] + gym_pad, gym_area[1] + 26, (gym_area[2] - 2 * gym_pad) * gym_visible, (gym_area[3] - 26 - gym_pad) * gym_visible);
} return void;
