// Putting every widget where the page says, in the state's screen. Done after every layout, before painting or hit-testing, so a window resize and a screen change both reach the widgets.

// Place and enable all sixteen buttons and place the two text boxes for the state.
gym_place(Session gym_state) {
  int gym_command = 0;
  while(gym_command < (import gym_command_count)) {
    gym_place_button(gym_state, gym_command);
    gym_command = gym_command + 1;
  }
  gym_place_boxes(gym_state);
} return void;
