// Put the answer box in its cell on the rep screen and the note box in its cell on the cool-down screen; the box of a screen that is not showing gets no size.
gym_place_boxes(Session gym_state) {
  int gym_shown = gym_state.cells[(import gym_cell_screen)];
  gym_place_box((import gym_answer_box), "answer", gym_shown == (import gym_screen_repetition));
  gym_place_box((import gym_note_box), "cool_note", gym_shown == (import gym_screen_cool_down));
} return void;
