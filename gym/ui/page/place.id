// Put button gym_command at its rectangle and switch it on or off for the state; a button not on this screen gets an empty rectangle, so no click reaches it.
gym_place_button(Session gym_state, int gym_command) {
  GuiButton gym_pushed = (import gym_buttons)[gym_command];
  int[] gym_box = gym_command_box(gym_state, gym_command);
  gui_btn_place(gym_pushed, gym_box[0], gym_box[1], gym_box[2], gym_box[3]);
} chain (Session gym_state, int gym_command) {
  gui_btn_enable(gym_pushed, gym_command_enabled(gym_state, gym_command));
} return void;
