// Probes for the cases of the page and the paint: what a paint left on the surface and where the page put a cell.

// The pixel of the surface at (gym_left, gym_top), found from the row length, not the index helper.
gym_fixture_pixel(int gym_left, int gym_top) {
  int gym_place_at = gym_top * (import sf_l_w) + gym_left;
  int gym_color = (import sf_l_px)[gym_place_at];
} return int gym_color;
given gym_fixture_fonts (0, 0):(0)
given gym_fixture_fonts given d2_l_rect(5, 5, 2, 2, 255) (5, 5):(255)

// 1 when some pixel of the gym_span by gym_tall rectangle at (gym_left, gym_top) is not colour gym_ground.
gym_fixture_inked(int gym_left, int gym_top, int gym_span, int gym_tall, int gym_ground) {
  int gym_across = 0;
  int gym_found = 0;
  while(gym_across < gym_span * gym_tall && gym_found == 0) {
    gym_found = gym_fixture_pixel(gym_left + gym_across % gym_span, gym_top + gym_across / gym_span) != gym_ground;
    gym_across = gym_across + 1;
  }
} return int gym_found;
given gym_fixture_fonts (0, 0, 10, 10, 0):(0)
given gym_fixture_fonts given d2_l_rect(3, 3, 1, 1, 7) (0, 0, 10, 10, 0):(1)
given gym_fixture_fonts given d2_l_rect(3, 3, 1, 1, 7) (4, 4, 5, 5, 0):(0)

// Number gym_field (0 x, 1 y, 2 width, 3 height) of the rectangle the page gave the cell whose class is gym_class.
gym_fixture_area(string gym_class, int gym_field) {
  int[] gym_box = gym_rectangle_of(gym_class);
  int gym_number = gym_box[gym_field];
} return int gym_number;
given gym_fixture_make(0) given gym_fixture_stock given gym_fixture_ready ("prompt", 3):(125)
given gym_fixture_make(0) given gym_fixture_stock given gym_fixture_ready ("answer", 1):(195)
