// The rectangle of the cell whose idml class is gym_class, as x, y, width and height in pixels; all zero for a cell on a screen that is not showing.
gym_rectangle_of(string gym_class) {
  int gym_node = gui_find_cls((import gym_tape), (import gym_strings), gym_class);
  int[] gym_box = [gui_rect_get((import gym_rectangles), gym_node, 0), gui_rect_get((import gym_rectangles), gym_node, 1), gui_rect_get((import gym_rectangles), gym_node, 2), gui_rect_get((import gym_rectangles), gym_node, 3)];
} return int[] gym_box;
