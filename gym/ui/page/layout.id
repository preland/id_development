// Shrink the rectangle gym_box by gym_amount on every side.
gym_inset(int[] gym_box, int gym_amount) {
  gym_box[0] = gym_box[0] + gym_amount;
  gym_box[1] = gym_box[1] + gym_amount;
  gym_box[2] = gym_box[2] - 2 * gym_amount;
} chain (int[] gym_box, int gym_amount) {
  gym_box[3] = gym_box[3] - 2 * gym_amount;
} return void;
