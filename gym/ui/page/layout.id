// Tiling the page for the screen in play, and reading a rectangle back out of it.

// Open the screen the state is on (its gate in the page), bind the gates and tile the page again at the surface's size. Needs gym_page, and the surface made.
gym_layout(Session gym_state) {
  int gym_shown = gym_state.cells[(import gym_cell_screen)];
  gui_set_num((import gym_board), "show_rep", gym_shown == (import gym_screen_repetition));
  gui_set_num((import gym_board), "show_score", gym_shown == (import gym_screen_score));
} chain (Session gym_state) {
  gui_set_num((import gym_board), "show_cool", gym_shown == (import gym_screen_cool_down));
  gui_bind((import gym_tape), (import gym_strings), (import gym_board));
  gui_layout((import gym_tape), (import gym_rectangles), (import sf_l_w), (import sf_l_h));
} return void;
