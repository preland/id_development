// Setting up what the window draws with: the idml page tiled to a size, the sixteen buttons, and the two text boxes. They live in exports because the toolkit's widgets keep their own small state (hover, press, caret), the way the about demo keeps its name box; the session state they are drawn from stays in the reducer's Session.

// Parse the idml page (gym_page_lines) and tile it to gym_width by gym_height, into the exports gym_tape, gym_strings, gym_rectangles and gym_board. All three screens start hidden; gym_layout opens one.
gym_page(int gym_width, int gym_height) {
  export int[] gym_tape = [];
  export string[] gym_strings = [];
  gui_new(gym_tape, gym_strings);
} chain (int gym_width, int gym_height) {
  string gym_source = str_join((import gym_page_lines), "\n");
  int gym_error = gui_parse(gym_source, gym_tape, gym_strings, "", fs_read_text);
  export GuiBd gym_board = gui_board();
} chain (int gym_width, int gym_height) {
  export int[] gym_rectangles = [];
  gui_bind(gym_tape, gym_strings, gym_board);
  gui_layout(gym_tape, gym_rectangles, gym_width, gym_height);
} return void;
(960, 640):() then gym_fixture_area("phases", 2):(557)
(480, 320):() then gym_fixture_area("phases", 2):(278)

// Make the sixteen buttons (one per command, in the order of gym_command_labels) and the two text boxes, in the exports gym_buttons, gym_answer_box and gym_note_box. The font layer must be started.
gym_widgets() {
  int gym_face_regular = gui_face("sans-serif", 15, 0);
  export GuiButton[] gym_buttons = [];
  gym_make_buttons(gym_buttons, gym_face_regular);
} chain () {
  export GuiTextBox gym_answer_box = gui_textbox_new("", "Type your answer", gym_face_regular, 80);
  export GuiTextBox gym_note_box = gui_textbox_new("", "One line, in your own words", gym_face_regular, 120);
} return void;
given gym_fixture_fonts ():() then gym_fixture_buttons():(16) then gym_fixture_boxes(1):("")
