// Doing an engine operation for the learner: the call into gym/session that appends to the log, then reading the state back from the log. What the engine refuses (no confidence, no attempt yet, a hint in the warm-up) comes back as a notice for the screen, and nothing is written.

// Do the operation gym_event stands for on the session in gym_holder[0] and replace it with the state the log now shows.
gym_perform(World gym_world, Session[] gym_holder, Event gym_event) {
  Session gym_before = gym_holder[0];
  word gym_moment = gym_session_time(gym_world, gym_before);
  string[] gym_result = gym_operate(gym_world, gym_before, gym_event.kind, gym_moment);
} chain (World gym_world, Session[] gym_holder, Event gym_event) {
  gym_adopt(gym_world, gym_holder, gym_event.kind, gym_result);
} return void;
