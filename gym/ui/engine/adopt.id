// Keep the cool-down line in the log (a cooldown_note event, log/FORMAT.md). A line that is empty is refused, since nothing would be kept.
gym_keep_note(World gym_world, string gym_line, word gym_moment) {
  string[] gym_result = ["refused", "write a line first: what would you tell yourself an hour ago?"];
  int gym_written = 0 - 1;
  if(len(gym_line) > 0) {
    gym_written = log_record_note(gym_world.record.log, gym_moment, gym_line);
  }
} chain (World gym_world, string gym_line, word gym_moment) {
  if(gym_written >= 0) {
    gym_result = ["ok", ""];
  }
  if(gym_written < 0 && len(gym_line) > 0) {
    gym_result = ["refused", "the log could not be written; check that its folder exists and that you may write to it"];
  }
} return string[] gym_result;
