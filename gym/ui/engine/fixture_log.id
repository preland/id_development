// The fixture of the engine cases that need a log on disk: a folder of the case's own (fs_mktemp, so no two cases share one) holding a log with the text the case gives, and a world over the probability pack that reads and appends to it. Each case is its own process and runs in the gym directory, so the pack is packs/probability.

// Make the folder and its learner.log, and open the world on them with the clock at gym_origin.
gym_fixture_world(string gym_log_text, word gym_origin) {
  string gym_folder = fs_mktemp("gym_ui_", 1);
  int gym_wrote = fs_append_text(gym_folder + "/learner.log", gym_log_text);
  gym_world_open("packs/probability", gym_folder + "/learner.log", gym_origin, "http://127.0.0.1:1", 1);
} return void;
("", 5):() then gym_fixture_logged():("")
("1\tsession_start\n", 7):() then gym_fixture_logged():("1\tsession_start\n")

// What the world's log holds now.
gym_fixture_logged() {
  string gym_text = fs_read_text((import gym_setting).record.log);
} return string gym_text;
given gym_fixture_world("1\tsession_start\n", 5) ():("1\tsession_start\n")
given gym_fixture_world("", 5) ():("")

// How many items the world's pack holds.
gym_fixture_item_count() {
  int gym_item_total = len(pack_ids((import gym_setting).book, "item"));
} return int gym_item_total;
given gym_fixture_world("", 5) ():(60)
given gym_fixture_world("1\tsession_start\n", 9) ():(60)
