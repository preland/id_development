  gym_texts[(import gym_text_metric) + 1] = gym_metric_value(score_transfer(gym_table, gym_least), gym_least, "");
  gym_texts[(import gym_text_metric) + 2] = gym_metric_value(score_calibration(gym_table, gym_least), gym_least, "");
} chain (World gym_world, Session gym_state, Log_events gym_entries) {
