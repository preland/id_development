// One event on the live session: the shell of the pure reducer. Events the reducer owns go to gym_reduce; the five that are engine operations (commit the attempt, show a hint, tap out, move on, keep the cool-down line) are done against the log by gym_perform, which then reads the whole state back from it. Enter is turned into the operation it stands for on the screen it is pressed on.

// Give event gym_event to the session in gym_holder[0]. The holder is the one cell that changes; the old state stays valid for anyone still holding it.
gym_deliver(World gym_world, Session[] gym_holder, Event gym_event) {
  Event gym_real = gym_translate(gym_holder[0], gym_event);
  int gym_engine = list_index_of((import gym_engine_kinds), gym_real.kind) >= 0;
  if(gym_engine == 0) {
    gym_holder[0] = gym_reduce(gym_holder[0], gym_real);
  }
} chain (World gym_world, Session[] gym_holder, Event gym_event) {
  if(gym_engine == 1) {
    gym_perform(gym_world, gym_holder, gym_real);
  }
} return void;
