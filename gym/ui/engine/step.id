// The event that stands for gym_event on the screen gym_state shows: Enter on the rep screen commits the attempt while the rep waits and moves on once it is finished; Enter on the cool-down screen keeps the line. Any other event is itself.
gym_translate(Session gym_state, Event gym_event) {
  int gym_kind = gym_event.kind;
  int gym_enter = gym_event.kind == (import gym_event_key) && gym_event.value == (import gym_key_enter);
  int gym_here = gym_state.cells[(import gym_cell_screen)];
} chain (Session gym_state, Event gym_event) {
  if(gym_enter == 1 && gym_here == (import gym_screen_repetition)) {
    gym_kind = (import gym_event_next);
  }
  if(gym_enter == 1 && gym_here == (import gym_screen_repetition) && gym_state.cells[(import gym_cell_stage)] == (import gym_stage_waiting)) {
    gym_kind = (import gym_event_submit);
  }
  if(gym_enter == 1 && gym_here == (import gym_screen_cool_down)) {
    gym_kind = (import gym_event_save);
  }
} chain (Session gym_state, Event gym_event) {
  Event gym_real = Event(gym_kind, gym_event.value, gym_event.text);
} return Event gym_real;
