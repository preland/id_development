// Reading the words of the rep back from the pack: the prompt of the item in play and, once the attempt is committed, the reference answer and the rubric lines (the why of a good solution), and the hint rungs shown so far. Nothing here is kept between operations; the pack and the log are the truth.

// Fill the prompt, reference and rubric texts for the item gym_view names. The reference and the rubric stay empty until the attempt is committed, so the answer is never in the state before the learner has tried.
gym_adopt_texts(World gym_world, Session gym_state, string[] gym_view) {
  string[] gym_texts = gym_state.texts;
  int gym_found = pack_find(gym_world.book, "item", gym_view[(import session_slot_item)]);
  int gym_playing = gym_state.cells[(import gym_cell_closed)] == 0 && gym_found >= 0;
} chain (World gym_world, Session gym_state, string[] gym_view) {
  int gym_done = gym_state.cells[(import gym_cell_stage)] != (import gym_stage_waiting);
  gym_texts[(import gym_text_reference)] = "";
  gym_texts[(import gym_text_rubric)] = "";
} chain (World gym_world, Session gym_state, string[] gym_view) {
  if(gym_playing == 1) {
    gym_texts[(import gym_text_prompt)] = pack_field(gym_world.book, gym_found, "prompt");
  }
  if(gym_playing * gym_done == 1) {
    gym_texts[(import gym_text_reference)] = pack_field(gym_world.book, gym_found, "answer");
    gym_texts[(import gym_text_rubric)] = string_join(pack_fields(gym_world.book, gym_found, "rubric"), "\n");
  }
  gym_adopt_rungs(gym_world, gym_state, gym_found);
} return void;
