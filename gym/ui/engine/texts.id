// Set rung gym_rung's text: empty when the rung is not showing, what it already holds if it holds something, else the pack's hint for it.
gym_adopt_rung(World gym_world, Session gym_state, int gym_found, int gym_rung) {
  string[] gym_texts = gym_state.texts;
  int gym_slot = (import gym_text_rung) + gym_rung;
  int gym_tapped = gym_state.cells[(import gym_cell_stage)] == (import gym_stage_tapped);
} chain (World gym_world, Session gym_state, int gym_found, int gym_rung) {
  int gym_showing = (1 - gym_tapped) * (gym_rung < gym_state.cells[(import gym_cell_hints)]) + gym_tapped * (gym_rung == (import gym_rung_count) - 1);
  string gym_wording = "";
  if(gym_showing * (gym_found >= 0) == 1) {
    gym_wording = pack_field(gym_world.book, gym_found, (import pack_rung_keys)[gym_rung]);
  }
} chain (World gym_world, Session gym_state, int gym_found, int gym_rung) {
  if(gym_showing == 1 && len(gym_texts[gym_slot]) > 0) {
    gym_wording = gym_texts[gym_slot];
  }
  gym_texts[gym_slot] = gym_wording;
} return void;
