// The hint rungs showing for the item in play, in the four text cells from gym_text_rung: rung r shows when fewer than the hints given have gone by (a tap-out shows only the worked example). A rung already holding its words keeps them, since the model may have reworded it; one that has none yet gets the pack's own.
gym_adopt_rungs(World gym_world, Session gym_state, int gym_found) {
  int gym_rung = 0;
  while(gym_rung < (import gym_rung_count)) {
    gym_adopt_rung(gym_world, gym_state, gym_found, gym_rung);
    gym_rung = gym_rung + 1;
  }
} return void;
