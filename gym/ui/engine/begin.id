// Opening a session in the window. The log is the only state, so a log whose last session is still going is picked up where it stopped; otherwise the planner makes a new session (gym/plan) and records it, exactly as `gym session start` does.

// Put in gym_holder[0] the state of the session this world's log holds, planning a new one first when there is none running. When the planner has nothing to offer, the question card says why.
gym_begin_session(World gym_world, Session[] gym_holder) {
  Log_replay gym_replayed = log_replay(gym_world.record.log);
  string[] gym_view = session_view(gym_replayed.events);
  string[] gym_planning = ["ok", ""];
} chain (World gym_world, Session[] gym_holder) {
  int gym_vacant = gym_view[(import session_slot_state)] == "none" || gym_view[(import session_slot_state)] == "closed" || gym_view[(import session_slot_state)] == "over";
  if(gym_vacant == 1) {
    gym_planning = session_start_plan(gym_world.book, gym_world.record.log, gym_world.record.origin, gym_world.record.seed);
  }
  Session gym_fresh = gym_start(0);
} chain (World gym_world, Session[] gym_holder) {
  Log_replay gym_planned = log_replay(gym_world.record.log);
  Session gym_beginning = gym_derive(gym_world, gym_fresh, gym_planned.events);
  gym_beginning.texts[(import gym_text_notice)] = "";
} chain (World gym_world, Session[] gym_holder) {
  if(gym_planning[0] == "refused") {
    gym_beginning.texts[(import gym_text_prompt)] = gym_planning[1];
  }
  gym_holder[0] = gym_beginning;
} return void;
