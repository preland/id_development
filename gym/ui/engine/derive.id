// The cool-down text for a session that is over (session_cool_down_text: where confidence was off and what is due a day on), or nothing while the session is still going or was never planned.
gym_adopt_cool(World gym_world, Session gym_state, Log_events gym_entries, int gym_plan_at) {
  string gym_text = "";
  word gym_moment = gym_session_time(gym_world, gym_state);
  if(gym_state.cells[(import gym_cell_closed)] == 1 && gym_plan_at >= 0) {
    gym_text = session_cool_down_text(gym_world.book, gym_entries, gym_moment);
  }
} chain (World gym_world, Session gym_state, Log_events gym_entries, int gym_plan_at) {
  gym_state.texts[(import gym_text_cool)] = gym_text;
} return void;
