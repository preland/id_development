// The screen state, derived. After every engine operation the log is replayed and the state is rebuilt from it plus the window's own transient state (what is typed, the picked confidence, the screen, the open definition, the clock): nothing about the rep is remembered by the window itself.

// The state after reading gym_entries: gym_before with everything the log and the pack decide replaced by what they say now.
gym_derive(World gym_world, Session gym_before, Log_events gym_entries) {
  Session gym_after = gym_copy(gym_before);
  string[] gym_view = session_view(gym_entries);
  int gym_plan_at = session_plan_index(gym_entries);
} chain (World gym_world, Session gym_before, Log_events gym_entries) {
  gym_adopt_cells(gym_after, gym_view, gym_entries, gym_plan_at);
  gym_adopt_texts(gym_world, gym_after, gym_view);
  gym_adopt_score(gym_world, gym_after, gym_entries);
} chain (World gym_world, Session gym_before, Log_events gym_entries) {
  gym_adopt_cool(gym_world, gym_after, gym_entries, gym_plan_at);
} return Session gym_after;
