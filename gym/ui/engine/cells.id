// The numbers that depend on the attempt: the stage of the rep (waiting, committed, tapped out), whether the committed answer was right, and how many hint rungs are showing (a tap-out shows them all, as the worked example). Only called while an item is in play.
gym_adopt_help(Session gym_state, string[] gym_view, Log_events gym_entries, int gym_plan_at) {
  int[] gym_cells = gym_state.cells;
  int gym_tapped = gym_view[(import session_slot_tapped)] == "yes";
  int gym_attempt = session_attempt_index(gym_entries, gym_plan_at, gym_cells[(import gym_cell_item)]);
} chain (Session gym_state, string[] gym_view, Log_events gym_entries, int gym_plan_at) {
  string gym_verdict = "";
  gym_cells[(import gym_cell_stage)] = (gym_view[(import session_slot_state)] == "committed") * (1 + gym_tapped);
  gym_cells[(import gym_cell_hints)] = to_int(gym_view[(import session_slot_hints)]) + gym_tapped * (import gym_rung_count);
} chain (Session gym_state, string[] gym_view, Log_events gym_entries, int gym_plan_at) {
  if(gym_attempt >= 0) {
    gym_verdict = log_text_at(gym_entries, gym_attempt, (import log_slot_verdict));
  }
  gym_cells[(import gym_cell_correct)] = gym_verdict == "correct" && gym_tapped == 0;
} return void;
