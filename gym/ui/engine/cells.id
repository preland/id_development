// Reading the state of the rep back from the log (session_view): which item of the plan is in play, whether any is, how far it has got, and the phase the plan puts it in. The window keeps none of this itself, so closing it and opening it again on the same log lands on the same screen.

// Copy the numbers of gym_view (the eight slots of session_view) into the state: the position in the plan, whether an item is in play, how many the plan holds, then the help and the phase. Moving to another item starts a fresh rep.
gym_adopt_cells(Session gym_state, string[] gym_view, Log_events gym_entries, int gym_plan_at) {
  int[] gym_cells = gym_state.cells;
  string gym_mode = gym_view[(import session_slot_state)];
  int gym_open = gym_mode == "waiting" || gym_mode == "committed";
} chain (Session gym_state, string[] gym_view, Log_events gym_entries, int gym_plan_at) {
  int gym_position = fixed_point_maximum(to_int(gym_view[(import session_slot_number)]) - 1, 0);
  gym_cells[(import gym_cell_closed)] = 1 - gym_open;
  gym_cells[(import gym_cell_total)] = to_int(gym_view[(import session_slot_total)]);
} chain (Session gym_state, string[] gym_view, Log_events gym_entries, int gym_plan_at) {
  if(gym_open == 1 && gym_position != gym_cells[(import gym_cell_item)]) {
    gym_begin(gym_state, gym_position);
  }
  if(gym_open == 1) {
    gym_adopt_help(gym_state, gym_view, gym_entries, gym_plan_at);
  }
  gym_adopt_phase(gym_state, gym_view);
} return void;
