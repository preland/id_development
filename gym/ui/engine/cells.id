// Put the state in the phase the plan gives the item in play (warm-up, main set, transfer), or in the cool-down once nothing is left to play; a plan that was never made changes nothing. A new phase starts its own clock, and entering the cool-down shows that screen.
gym_adopt_phase(Session gym_state, string[] gym_view) {
  int[] gym_cells = gym_state.cells;
  int gym_was = gym_cells[(import gym_cell_phase)];
  int gym_now_phase = gym_was;
} chain (Session gym_state, string[] gym_view) {
  if(gym_cells[(import gym_cell_closed)] == 0) {
    gym_now_phase = fixed_point_maximum(lst_str_index((import gym_plan_phases), gym_view[(import session_slot_phase)]), 0);
  }
  if(gym_cells[(import gym_cell_closed)] == 1 && gym_view[(import session_slot_state)] != "none") {
    gym_now_phase = fixed_point_maximum(gym_was, (import gym_phase_cool_down));
  }
  if(gym_now_phase != gym_was) {
    gym_cells[(import gym_cell_phase)] = gym_now_phase;
    gym_cells[(import gym_cell_phase_started)] = gym_cells[(import gym_cell_elapsed)];
  }
} chain (Session gym_state, string[] gym_view) {
  gym_clock(gym_state);
  if(gym_now_phase == (import gym_phase_cool_down) && gym_was < (import gym_phase_cool_down)) {
    gym_cells[(import gym_cell_screen)] = (import gym_screen_cool_down);
  }
} return void;
