// The log a script leaves behind, from the same start: what the screen did, as lines of the append-only file. The hints and the closing of the session are in it, and so is the cool-down line.
gym_golden_log(string gym_script_text, string gym_log_text) {
  string gym_golden_place = fs_mktemp("gym_golden_", 1);
  int gym_golden_started = fs_append_text(gym_golden_place + "/learner.log", gym_log_text);
  gym_world_open("packs/probability", gym_golden_place + "/learner.log", 1760000000000, "http://127.0.0.1:1", 1);
} chain (string gym_script_text, string gym_log_text) {
  Session gym_golden_first = gym_start(0);
  Session[] gym_golden_cell = [gym_golden_first];
  gym_begin_session((import gym_setting), gym_golden_cell);
} chain (string gym_script_text, string gym_log_text) {
  int gym_golden_wrong = gym_replay((import gym_setting), gym_golden_cell, gym_script_text);
  string gym_golden_logged = fs_read_text(gym_golden_place + "/learner.log");
} return string gym_golden_logged;
