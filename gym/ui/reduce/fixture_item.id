// Stand-in contents for the cases that paint: the texts of an item of the gym_fixture_ tables (prompt, reference answer, the why line as the rubric, the four rungs) put in the state held in gym_fixture_state, and a cool-down text. The window never calls these; it reads the pack.

// Fill the state's prompt, reference, rubric and four rung texts from the stand-in item the state is at.
gym_fixture_stock() {
  string[] gym_texts = (import gym_fixture_state).texts;
  int gym_item = (import gym_fixture_state).cells[(import gym_cell_item)];
  gym_texts[(import gym_text_prompt)] = (import gym_fixture_prompts)[gym_item];
} chain () {
  gym_texts[(import gym_text_reference)] = (import gym_fixture_answers)[gym_item];
  gym_texts[(import gym_text_rubric)] = (import gym_fixture_reasons)[gym_item];
  gym_fixture_rung_texts(gym_texts, gym_item);
} return void;
given gym_fixture_make(2) ():() then gym_fixture_text(3):("0.15") then gym_fixture_text(6):("Ask what independent means for the chance of both happening.")
given gym_fixture_make(0) ():() then gym_fixture_text(2):("A fair six-sided die is rolled once. What is the probability of an even number? Answer as a fraction in lowest terms.") then gym_fixture_text(9):("P = favourable / possible = 3/6 = 1/2.")

// Put the four rungs of stand-in item gym_item in the rung cells of gym_texts.
gym_fixture_rung_texts(string[] gym_texts, int gym_item) {
  int gym_rung = 0;
  while(gym_rung < (import gym_rung_count)) {
    gym_texts[(import gym_text_rung) + gym_rung] = (import gym_fixture_rungs)[gym_item * (import gym_rung_count) + gym_rung];
    gym_rung = gym_rung + 1;
  }
} return void;
