// Put a finished session's cool-down text in the state: three items, one confident miss, two concepts due.
gym_fixture_cooled() {
  string[] gym_texts = (import gym_fixture_state).texts;
  gym_texts[(import gym_text_cool)] = "session complete\nitems this session: 3\nwrong at 90% or more confidence: space_2 (99%), space_3 (90%)\nconcepts due a day from now: 2";
} return void;
