given gym_fixture_make(0) given gym_fixture_put(5, "no") ((import gym_fixture_state), 1):() then gym_fixture_text(5):("") then gym_fixture_cell(1):(1)

// Show screen gym_target (a gym_screen_* value); a number that is no screen changes nothing.
gym_screen(Session gym_state, int gym_target) {
  int[] gym_cells = gym_state.cells;
  if(gym_target >= 0 && gym_target < (import gym_screen_count)) {
    gym_cells[(import gym_cell_screen)] = gym_target;
  }
} return void;
