// Open the definition of scoreboard metric gym_metric, or close it when it is the one already open; a number that is no metric changes nothing.
gym_define(Session gym_state, int gym_metric) {
  int[] gym_cells = gym_state.cells;
  int gym_shown = gym_cells[(import gym_cell_define)];
  if(gym_metric >= 0 && gym_metric < len((import gym_metric_names))) {
    gym_cells[(import gym_cell_define)] = gym_metric;
  }
} chain (Session gym_state, int gym_metric) {
  if(gym_shown == gym_metric) {
    gym_cells[(import gym_cell_define)] = 0 - 1;
  }
} return void;
