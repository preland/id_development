// Starting a rep at a position of the plan, and the two settings that live on screen: which screen shows and which scoreboard definition is open.

// Begin the rep at position gym_position of the plan: nothing picked or typed, no notice, and the rep clock set to the session clock. The shell calls it when the log says the learner moved to another item.
gym_begin(Session gym_state, int gym_position) {
  int[] gym_cells = gym_state.cells;
  string[] gym_texts = gym_state.texts;
  gym_cells[(import gym_cell_item)] = gym_position;
} chain (Session gym_state, int gym_position) {
  gym_cells[(import gym_cell_confidence)] = 0;
  gym_cells[(import gym_cell_started)] = gym_cells[(import gym_cell_elapsed)];
  gym_texts[(import gym_text_answer)] = "";
} chain (Session gym_state, int gym_position) {
  gym_texts[(import gym_text_notice)] = "";
} return void;
