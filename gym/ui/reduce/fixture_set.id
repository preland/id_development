// More fixtures for the reducer's cases: writing straight into the state held in gym_fixture_state, which sets up a situation without going through the rule under test, and giving the state an item of the stand-in tables to paint.

// Set number gym_index of gym_fixture_state to gym_value.
gym_fixture_set(int gym_index, int gym_value) {
  int[] gym_cells = (import gym_fixture_state).cells;
  gym_cells[gym_index] = gym_value;
} return void;
given gym_fixture_make(0) (1, 3):() then gym_fixture_cell(1):(3)
given gym_fixture_make(0) (9, 2):() then gym_fixture_cell(9):(2)

// Put gym_given in gym_fixture_state as the typed answer.
gym_fixture_say(string gym_given) {
  string[] gym_texts = (import gym_fixture_state).texts;
  gym_texts[0] = gym_given;
} return void;
given gym_fixture_make(0) ("1/2"):() then gym_fixture_text(0):("1/2")
given gym_fixture_make(0) ("x"):() then gym_fixture_text(0):("x")

// Put gym_given in text number gym_index of gym_fixture_state.
gym_fixture_put(int gym_index, string gym_given) {
  string[] gym_texts = (import gym_fixture_state).texts;
  gym_texts[gym_index] = gym_given;
} return void;
given gym_fixture_make(0) (5, "no"):() then gym_fixture_text(5):("no")
given gym_fixture_make(0) (20, "head"):() then gym_fixture_text(20):("head")
