// Pick the confidence for the rep, one of gym_levels, while the rep is waiting; any other number, or a pick after the commit, changes nothing.
gym_choose(Session gym_state, int gym_level) {
  int[] gym_cells = gym_state.cells;
  int gym_known = lst_index_of((import gym_levels), gym_level) >= 0;
  int gym_waiting = gym_cells[(import gym_cell_stage)] == (import gym_stage_waiting);
} chain (Session gym_state, int gym_level) {
  if(gym_known * gym_waiting == 1) {
    gym_cells[(import gym_cell_confidence)] = gym_level;
  }
} return void;
