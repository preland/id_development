given gym_fixture_make(0) given gym_fixture_set(2, 90) given gym_fixture_say("x") ((import gym_fixture_state)):(Session([0, 0, 90, 0, 0, 0, 0, 0, 300, -1, 0, 0, 0, 0, 0], ["x", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]))

// The state after the event, as a new value: gym_old is left exactly as it was.
gym_reduce(Session gym_old, Event gym_event) {
  Session gym_after = gym_copy(gym_old);
  gym_apply(gym_after, gym_event);
} return Session gym_after;
