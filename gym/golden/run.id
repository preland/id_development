// The golden transcript: the whole scripted session of conf.id's golden_script
// (a session on the probability pack, a day-later session, and the scoreboard)
// run through command_run against a fresh log, with every clock given by --now.
// golden_block runs one command and writes it as a block: the command, its
// output, its exit status and the log's size before and after. It also marks a
// violation of the append-only rule: the log got smaller, or a refused command
// changed it. golden_run replays the script up to a step and answers that
// step's block and the number of violations so far, so each case below is one
// readable moment of the session and also proves nothing before it broke the log.
// The cases run in the gym directory, so the pack is packs/probability.

golden_block(string golden_log, string golden_line) {
  int golden_before = len(fs_read_text(golden_log));
  string[] golden_arguments = str_split("gym|" + golden_line + "|--pack|packs/probability|--log|" + golden_log, "|");
  string[] golden_result = command_run(golden_arguments, 0);
} chain (string golden_log, string golden_line) {
  int golden_after = len(fs_read_text(golden_log));
  int golden_bad = golden_after < golden_before;
  if (golden_result[0] != "0" && golden_after != golden_before) {
    golden_bad = 1;
  }
} chain (string golden_log, string golden_line) {
  string golden_text = "$ gym " + str_replace(golden_line, "|", " ") + "\n" + golden_result[1] + "\n[exit " + golden_result[0] + "; log " + golden_before + " -> " + golden_after + " bytes]";
  string[] golden_made = [golden_text, "" + golden_bad];
} return string[] golden_made;
given fs_temp_text("") ((import fs_temp_path), "answer|--text|1/3|--now|5"):(["$ gym answer --text 1/3 --now 5\nrefused: no session is running: start one with gym session start\n[exit 1; log 0 -> 0 bytes]", "0"])
given fs_temp_text("") ((import fs_temp_path), "hint|--now|5"):(["$ gym hint --now 5\nrefused: no session is running: start one with gym session start\n[exit 1; log 0 -> 0 bytes]", "0"])

golden_run(int golden_count) {
  string golden_log = fs_mktemp("golden_", 1) + "/learner.log";
  string[] golden_lines = (import golden_script);
  string[] golden_last = ["", "0"];
} chain (int golden_count) {
  int golden_at = 0;
  int golden_total = 0;
  while (golden_at < golden_count) {
    golden_last = golden_block(golden_log, golden_lines[golden_at]);
    golden_total = golden_total + to_int(golden_last[1]);
    golden_at = golden_at + 1;
  }
} chain (int golden_count) {
  string[] golden_report = [golden_last[0], "" + golden_total];
} return string[] golden_report;
