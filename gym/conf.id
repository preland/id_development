string[] command_options = ["|pack|str|||the pack directory: concepts and items as .txt files", "|log|str|||the learner's log file, append-only; it is the only state", "|now|str|||the clock, in milliseconds since the epoch (default: the real clock)", "|seed|str|||the plan's tie-breaking seed (default 1)", "|text|str|||your answer", "|confidence|str|||50, 70, 90 or 99; an answer is not taken without one", "|seconds|str|||seconds you took (default 0)", "|url|str|||the model server (default: GYM_MODEL_URL, else http://127.0.0.1:8184)", "|item|str|||an item id", "|met|str|||for a free answer, which rubric lines you met: 1 or 0 for each, such as 1,0,1"];

string command_usage = "gym session start --pack DIR --log FILE [--now MS] [--seed N]\ngym answer --pack DIR --log FILE --text ANSWER --confidence 50|70|90|99 [--seconds N] [--now MS]\ngym hint --pack DIR --log FILE [--url URL] [--now MS]\ngym tapout --pack DIR --log FILE [--seconds N] [--now MS]\ngym next --pack DIR --log FILE [--now MS]\ngym score --pack DIR --log FILE [--now MS]\ngym why ITEM --pack DIR --log FILE [--now MS] [--seed N]\ngym pack check DIR\ngym grade --pack DIR --item ID --text ANSWER [--url URL]\ngym selfgrade --pack DIR --log FILE --met 1,0,1 [--now MS]\ngym grade eval SET RESULTS [FROM [COUNT]] --pack DIR [--url URL]\ngym grade report RESULTS\ngym [window] --pack DIR --log FILE [--now MS] [--seed N] [--url URL] [--script S.txt [--dump] [--render-after OUT.ppm]]";

int command_digits_limit = 9;

string[] golden_script = ["session|start|--now|1760000000000", "hint|--now|1760000001000", "answer|--text|1/3|--now|1760000002000", "answer|--text|1/3|--confidence|90|--seconds|12|--now|1760000060000", "next|--now|1760000061000", "answer|--text|1/3|--confidence|99|--seconds|20|--now|1760000120000", "hint|--url|http://127.0.0.1:1|--now|1760000121000", "next|--now|1760000122000", "tapout|--seconds|30|--now|1760000150000", "next|--now|1760000151000", "session|start|--now|1760086400000", "answer|--text|1/3|--confidence|90|--seconds|9|--now|1760086520000", "hint|--url|http://127.0.0.1:1|--now|1760086521000", "score|--now|1760086522000", "why|independence_1|--now|1760086523000"];


// Constants of the Mental Gym window (gym/ui): where each field of the session state sits, the events the reducer takes, and the session's four phases. The window plays the pack's items through the engine in gym/session; the gym_fixture_ tables hold stand-in items for the pixel cases.

// The state's numbers, Session.cells. The window's own: which screen shows, the confidence picked (0 for none), the session clock in seconds, the scoreboard metric whose definition is open (-1 for none), the clock reading when the rep began, whether the cool-down line is saved. Read back from the log after every engine operation: the position of the item in play in the plan, the stage of the rep (waiting, committed, tapped out), whether the committed answer was right, how many hint rungs are revealed, the phase the plan puts the item in, the seconds left in that phase, the clock reading when the phase began, how many items the plan holds and whether no item is in play (1 before a plan exists and once every item is done).
int gym_cell_screen = 0;
int gym_cell_item = 1;
int gym_cell_confidence = 2;
int gym_cell_stage = 3;
int gym_cell_correct = 4;
int gym_cell_hints = 5;
int gym_cell_elapsed = 6;
int gym_cell_phase = 7;
int gym_cell_remaining = 8;
int gym_cell_define = 9;
int gym_cell_started = 10;
int gym_cell_phase_started = 11;
int gym_cell_saved = 12;
int gym_cell_total = 13;
int gym_cell_closed = 14;

// The state's texts, Session.texts. The typed answer and the cool-down line are the window's. The rest are read back from the log and the pack after every engine operation: the prompt of the item in play, the reference answer and the rubric lines (empty until the attempt is committed), the notice of the last refusal, the four hint rungs shown so far, the cool-down text, the five scoreboard lines, the four lines of the confidence table and the head of the scoreboard.
int gym_text_answer = 0;
int gym_text_note = 1;
int gym_text_prompt = 2;
int gym_text_reference = 3;
int gym_text_rubric = 4;
int gym_text_notice = 5;
int gym_text_rung = 6;
int gym_text_cool = 10;
int gym_text_metric = 11;
int gym_text_bin = 16;
int gym_text_head = 20;



// The screens, and the stages of a rep: waiting for an attempt, the attempt committed, the learner tapped out.
int gym_screen_repetition = 0;
int gym_screen_score = 1;
int gym_screen_cool_down = 2;
int gym_stage_waiting = 0;
int gym_stage_committed = 1;
int gym_stage_tapped = 2;

// The events the reducer takes (Event.kind). The value or the text each uses: type and note carry a text; confidence a level; tick the seconds that passed; screen a screen; define a metric; key a key code; save keeps the cool-down line in the log; the rest nothing.
int gym_event_type = 1;
int gym_event_confidence = 2;
int gym_event_submit = 3;
int gym_event_hint = 4;
int gym_event_tap_out = 5;
int gym_event_tick = 6;
int gym_event_next = 7;
int gym_event_screen = 8;
int gym_event_define = 9;
int gym_event_note = 10;
int gym_event_key = 11;
int gym_event_save = 12;

// The key codes gym_event_key knows (the codes gfx_event gives): Esc, Enter and Tab.
int gym_key_escape = 1011;
int gym_key_enter = 1009;
int gym_key_tab = 1010;

// The confidence levels a learner can commit, in percent, and the number of hint rungs on the ladder.
int[] gym_levels = [50, 70, 90, 99];
int gym_rung_count = 4;

// The session's four phases (spec, "A session"): their names and lengths in seconds, warm-up 5 minutes, main set 13, transfer 5, cool-down 2.
string[] gym_phase_names = ["Warm-up", "Main set", "Transfer", "Cool-down"];
int[] gym_phase_seconds = [300, 780, 300, 120];

// The names of the rungs of the hint ladder, in the order they are revealed.
string[] gym_rung_names = ["Nudge", "Guiding question", "Partial step", "Worked example"];

// The five scoreboard metrics, in the order of score_metric_names; the definition shown for each is score_define's.
string[] gym_metric_names = ["Retention", "Transfer", "Calibration", "Independence", "Fluency"];

// Stand-in items for the pixel cases only (the window plays the pack's own items): a prompt, a reference answer, a why line and four hint rungs for each of four items.
string[] gym_fixture_prompts = ["A fair six-sided die is rolled once. What is the probability of an even number? Answer as a fraction in lowest terms.", "Two fair coins are tossed. What is the probability that both land heads? Answer as a fraction.", "Events A and B are independent, P(A) = 0.3 and P(B) = 0.5. What is P(A and B)? Answer as a decimal.", "A bag holds 3 red and 1 blue marble. Two are drawn without replacement. What is the probability that both are red? Answer as a fraction in lowest terms."];
string[] gym_fixture_answers = ["1/2", "1/4", "0.15", "1/2"];
string[] gym_fixture_reasons = ["Faces 2, 4 and 6 are even, so 3 of the 6 outcomes count, and 3/6 reduces to 1/2.", "Each coin is heads with probability 1/2 and the tosses are independent, so the chances multiply: 1/2 * 1/2 = 1/4.", "For independent events the probabilities multiply: 0.3 * 0.5 = 0.15.", "The first marble is red with chance 3/4. Then 2 red remain among 3 marbles, so the second is red with chance 2/3, and 3/4 * 2/3 = 1/2."];
string[] gym_fixture_rungs = ["Start by listing the outcomes that count as even.", "How many faces are even, and how many faces are there in all?", "Three faces count, out of six possible faces.", "P = favourable / possible = 3/6 = 1/2.", "Think about whether one toss changes the other.", "If two events are independent, how do their probabilities combine?", "Each coin has the same chance of heads; combine the two chances.", "P(both heads) = 1/2 * 1/2 = 1/4.", "Ask what independent means for the chance of both happening.", "What do you do to the two probabilities when the events do not affect each other?", "Combine 0.3 and 0.5 by the rule for independent events.", "P(A and B) = P(A) * P(B) = 0.3 * 0.5 = 0.15.", "The second draw depends on what the first draw took.", "After one red marble is gone, how many marbles are left, and how many of them are red?", "The first draw is red with chance 3/4; now work out the second draw the same way.", "P = 3/4 * 2/3 = 6/12 = 1/2."];

// The index of the cool-down phase, the phase number a finished session has, and how many screens there are.
int gym_phase_cool_down = 3;
int gym_phase_over = 4;
int gym_screen_count = 3;

// The layout of the window in idml (kit/ui/idml), one line per element of the list: the session bar over three screens of which one shows at a time (the gates show_rep, show_score and show_cool). The program reads every rectangle from the tiled page and draws into it.
