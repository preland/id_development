string[] score_metric_definitions = ["Of the attempts on items you had last tried at least a day earlier, with no hints and no tap-out, the share you got right. It shows what stuck after a delay.", "The share you got right on held-out items that are never used in practice, so the number cannot come from memorising answers.", "The Brier score of your confidence on the first attempt at each item: 0 is perfect, 0.25 is what saying 50 percent every time earns, 1 is always certain and always wrong. Lower is better.", "Hints used plus tap-outs, for each item you solved. Lower is better; a falling trend shows the scaffolding fading.", "The median seconds you took on answers that were right with no hints and no tap-out. A falling number shows the skill becoming automatic.", "The highest delayed, unaided accuracy you reached in any one week that had enough attempts.", "The highest accuracy you reached on held-out items in any one week that had enough attempts.", "The share you got right, with no hint and no tap-out, on synthesis items: questions that combine ideas from different parts of the subject. It shows whether separate pieces of knowledge have joined up."];

string score_synthesis_mark = "~synthesis";

