string grade_system = "You grade one learner answer for a practice item. Reply with one JSON object and nothing else, with the keys verdict, right, flaw, next_step, error_type and confidence. First compare the learner's final answer with the reference answer, then judge the reasoning against the rubric lines. verdict: correct when the final answer matches the reference and the reasoning is sound; partly when the method is right but a slip or an unfinished step spoils the final answer, or when the final answer is right but the reasoning is wrong or missing; incorrect when the method is wrong, a misconception is used or the reply is off the point. right: one sentence of at most 20 words naming one step the learner actually wrote that is right; never credit a step the learner did not write and never copy the reference answer; if no step is right, name what the learner attempted. flaw: one short sentence of at most 20 words naming the exact wrong step, or none. next_step: one concrete thing to do next, without writing out the reference answer. error_type: misconception when the learner used a wrong rule or idea (such as adding probabilities that should be multiplied, ignoring the condition, or counting the wrong sample space), slip only when the idea is right and one number or reading is wrong, incomplete when the work stops early, off_topic when the reply does not address the question, none for a correct answer. confidence: a whole number from 0 to 100, how sure you are of the grade. Example. Item: a bag holds 3 red and 2 blue balls, what is the probability of drawing blue? Reference 2/5. Learner: there are 5 balls and 3 are red, so 3/5. Reply: {\"verdict\":\"partly\",\"right\":\"Used favourable over total with 5 balls.\",\"flaw\":\"Counted the 3 red balls instead of the 2 blue ones.\",\"next_step\":\"Underline the colour the question asks for before counting.\",\"error_type\":\"slip\",\"confidence\":85}";

string grade_schema = "{\"type\":\"object\",\"properties\":{\"verdict\":{\"type\":\"string\",\"enum\":[\"correct\",\"partly\",\"incorrect\"]},\"right\":{\"type\":\"string\"},\"flaw\":{\"type\":\"string\"},\"next_step\":{\"type\":\"string\"},\"error_type\":{\"type\":\"string\",\"enum\":[\"misconception\",\"slip\",\"incomplete\",\"off_topic\",\"none\"]},\"confidence\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100}},\"required\":[\"verdict\",\"right\",\"flaw\",\"next_step\",\"error_type\",\"confidence\"]}";

string[] grade_field_names = ["verdict", "right", "flaw", "next_step", "error_type"];

string[] grade_verdicts = ["correct", "partly", "incorrect"];

string[] grade_error_types = ["misconception", "slip", "incomplete", "off_topic", "none"];

string[] grade_praise_phrases = ["great job", "well done", "good job", "nice work", "nice job", "excellent", "fantastic", "awesome", "amazing", "perfect", "bravo", "you got it", "spot on", "good answer", "great answer"];

