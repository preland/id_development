// The words that follow an answer, a hint and a tap-out, from the result lists of
// session_answer_item, session_hint_next and session_tap_out. A refusal is
// always "refused: " and the reason, so a script can tell it from a result by the
// first word (the program also exits 1).

command_answer_text(string[] command_result, string[] command_route, string[] command_shown) {
  string command_text = "refused: " + command_result[1];
  string command_show = command_show_text(command_shown);
  string command_tail = "next: gym hint for help (not in the warm-up), gym next to move on";
} chain (string[] command_result, string[] command_route, string[] command_shown) {
  if (command_result[0] == "ok" && command_result[2] != "pending") {
    command_text = "verdict: " + command_result[2] + "\nreference: " + command_result[3] + "\nwhy, what a good solution shows:\n  - " + string_replace(command_result[4], "\n", "\n  - ") + "\n" + command_show + command_tail;
  }
  if (command_result[0] == "ok" && command_result[2] == "pending") {
    command_text = command_free_text(command_result) + "\n" + command_route_text(command_route, command_shown);
  }
} return string command_text;
(["refused", "no session is running"], ["none", "", ""], ["", "", ""]):("refused: no session is running")
(["ok", "", "incorrect", "1/3", "R1\nR2", "a", "main"], ["none", "", ""], ["", "", ""]):("verdict: incorrect\nreference: 1/3\nwhy, what a good solution shows:\n  - R1\n  - R2\nnext: gym hint for help (not in the warm-up), gym next to move on")
(["ok", "", "correct", "7", "R3", "b", "warmup"], ["none", "", ""], ["", "right and unassisted: nothing to add", ""]):("verdict: correct\nreference: 7\nwhy, what a good solution shows:\n  - R3\npresentation: right and unassisted: nothing to add\nnext: gym hint for help (not in the warm-up), gym next to move on")
(["ok", "", "pending", "model proof", "R1\nR2", "a", "main"], ["self", "", "the model server answered -1"], ["", "", ""]):("verdict: pending (a free answer is marked against the rubric, not decided by the checker)\nreference: model proof\nrubric, mark each line you met:\n  1. R1\n  2. R2\nthe grader could not be used (the model server answered -1), so mark your answer yourself, line by line:\n  gym selfgrade --met 1,0,... (one value per rubric line: 1 = met, 0 = not met)\nuntil you do, gym next is refused and the answer counts for nothing")
(["ok", "", "pending", "model proof", "R1\nR2", "a", "main"], ["model", "incorrect", "missed the base case"], ["  worked: W", "wrong with low confidence (70%): the worked example in full, since this is the first miss on the concept", ""]):("verdict: pending (a free answer is marked against the rubric, not decided by the checker)\nreference: model proof\nrubric, mark each line you met:\n  1. R1\n  2. R2\ngraded by the model: incorrect\n  missed the base case\npresentation: wrong with low confidence (70%): the worked example in full, since this is the first miss on the concept\n  worked: W\nnext: gym hint for help (not in the warm-up), gym next to move on")

command_hint_text(string[] command_result) {
  string command_text = "refused: " + command_result[1];
  if (command_result[0] == "ok" && command_result[3] == "model") {
    command_text = "hint " + command_result[5] + " of 4 (" + command_result[4] + "): " + command_result[2] + "\nsource: reworded by the model for your attempt";
  }
  if (command_result[0] == "ok" && command_result[3] == "authored") {
    command_text = "hint " + command_result[5] + " of 4 (" + command_result[4] + "): " + command_result[2] + "\nsource: the pack's own words (" + command_result[6] + ")";
  }
} return string command_text;
(["refused", "answer first"]):("refused: answer first")
(["ok", "", "Begin.", "authored", "nudge", "1", "the model server answered -1"]):("hint 1 of 4 (nudge): Begin.\nsource: the pack's own words (the model server answered -1)")
(["ok", "", "Count them.", "model", "guiding question", "2", ""]):("hint 2 of 4 (guiding question): Count them.\nsource: reworded by the model for your attempt")

command_tap_text(string[] command_result) {
  string command_text = "refused: " + command_result[1];
  if (command_result[0] == "ok") {
    command_text = "tapped out: the answer is " + command_result[3] + "\nwhy, what a good solution shows:\n  - " + string_replace(command_result[4], "\n", "\n  - ") + "\nworked example: " + command_result[7] + "\nthis counts as a miss, so the item comes back sooner\nnext: gym next";
  }
} return string command_text;
(["refused", "this item already has an attempt"]):("refused: this item already has an attempt")
(["ok", "", "tapped out", "1/3", "R1", "a", "main", "Eg 1/3."]):("tapped out: the answer is 1/3\nwhy, what a good solution shows:\n  - R1\nworked example: Eg 1/3.\nthis counts as a miss, so the item comes back sooner\nnext: gym next")
(["ok", "", "tapped out", "7", "R3\nR4", "b", "transfer", "Eg 7."]):("tapped out: the answer is 7\nwhy, what a good solution shows:\n  - R3\n  - R4\nworked example: Eg 7.\nthis counts as a miss, so the item comes back sooner\nnext: gym next")
