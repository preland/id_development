// The scoreboard as words: the five metrics of the spec (P9, P10), each with its
// figure and the sample behind it, or "not enough data" when there are too few
// attempts, and under it the definition from score_define so the learner can see
// what the number means. Nothing here is a streak, a point or a minute.

command_metric_line(string command_name, Score_figure command_figure, int command_minimum) {
  string command_value = score_describe(command_figure, command_minimum);
  if (command_figure.enough == 1) {
    command_value = plan_decimal(command_figure.value, 3) + " (n = " + command_figure.sample + ")";
  }
  string command_line = command_name + ": " + command_value + "\n  " + score_define(command_name);
} return string command_line;
("retention", Score_figure(4, 1, 0.75), 5):("retention: 0.750 (n = 4)\n  Of the attempts on items you had last tried at least a day earlier, with no hints and no tap-out, the share you got right. It shows what stuck after a delay.")
("transfer", Score_figure(2, 0, 0.0), 5):("transfer: not enough data (n = 2, need 5)\n  The share you got right on held-out items that are never used in practice, so the number cannot come from memorising answers.")

command_score_text(Score_table command_table) {
  int command_minimum = (import score_default_minimum);
  Score_figure command_retention = score_retention(command_table, command_minimum);
  Score_figure command_transfer = score_transfer(command_table, command_minimum);
} chain (Score_table command_table) {
  Score_figure command_calibration = score_calibration(command_table, command_minimum);
  Score_figure command_independence = score_independence(command_table, command_minimum);
  Score_figure command_fluency = score_fluency(command_table, command_minimum);
} chain (Score_table command_table) {
  string command_head = "scoreboard from " + len(command_table.moments.times) + " logged attempts; only delayed, unassisted and held-out results count";
  Score_figure command_synthesis = score_synthesis(command_table, command_minimum);
  string[] command_lines = [command_head, command_metric_line("retention", command_retention, command_minimum), command_metric_line("transfer", command_transfer, command_minimum), command_metric_line("calibration", command_calibration, command_minimum), command_metric_line("independence", command_independence, command_minimum), command_metric_line("fluency", command_fluency, command_minimum), command_metric_line("synthesis", command_synthesis, command_minimum)];
} chain (Score_table command_table) {
  string command_text = str_join(command_lines, "\n");
} return string command_text;
