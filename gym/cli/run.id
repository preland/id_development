// The whole command line as one function of its words and the clock. command_run
// reads the options with opt_parse (the table in conf.id), then command_dispatch
// picks the command from the plain words. The answer is [exit code, text]: main
// prints the text and exits with the code. 0 is done, 1 is refused by a rule of
// the design, 2 is a command line that cannot be run.

command_dispatch(string[] command_values, string[] command_rest, word command_clock) {
  string command_first = command_word(command_rest, 0);
  string command_second = command_word(command_rest, 1);
  string[] command_out = ["2", "error: say what to do, one of:\n" + (import command_usage)];
} chain (string[] command_values, string[] command_rest, word command_clock) {
  if (command_first == "session" && command_second == "start") {
    command_out = command_session_start(command_values, command_clock);
  }
  if (command_first == "answer") {
    command_out = command_answer(command_values, command_clock);
  }
  if (command_first == "hint") {
    command_out = command_hint(command_values, command_clock);
  }
} chain (string[] command_values, string[] command_rest, word command_clock) {
  if (command_first == "tapout") {
    command_out = command_tap_out(command_values, command_clock);
  }
  if (command_first == "next") {
    command_out = command_next(command_values, command_clock);
  }
  if (command_first == "score") {
    command_out = command_score(command_values, command_clock);
  }
} chain (string[] command_values, string[] command_rest, word command_clock) {
  if (command_first == "why") {
    command_out = command_why(command_values, command_clock, command_rest);
  }
  if (command_first == "pack" && command_second == "check") {
    command_out = command_pack_check(command_values, command_rest);
  }
  if (command_first == "grade" && command_second != "eval" && command_second != "report") {
    command_out = command_grade(command_values, command_clock);
  }
} chain (string[] command_values, string[] command_rest, word command_clock) {
  if (command_first == "grade" && command_second == "eval") {
    command_out = command_grade_evaluation(command_values, command_rest, command_clock);
  }
  if (command_first == "grade" && command_second == "report") {
    command_out = command_grade_report(command_rest);
  }
  if (command_first == "selfgrade") {
    command_out = command_self_grade(command_values, command_clock);
  }
} return string[] command_out;
(["", "", "", "", "", "", "", "", "", ""], ["bogus"], 5):(["2", "error: say what to do, one of:\ngym session start --pack DIR --log FILE [--now MS] [--seed N]\ngym answer --pack DIR --log FILE --text ANSWER --confidence 50|70|90|99 [--seconds N] [--now MS]\ngym hint --pack DIR --log FILE [--url URL] [--now MS]\ngym tapout --pack DIR --log FILE [--seconds N] [--now MS]\ngym next --pack DIR --log FILE [--now MS]\ngym score --pack DIR --log FILE [--now MS]\ngym why ITEM --pack DIR --log FILE [--now MS] [--seed N]\ngym pack check DIR\ngym grade --pack DIR --item ID --text ANSWER [--url URL]\ngym selfgrade --pack DIR --log FILE --met 1,0,1 [--now MS]\ngym grade eval SET RESULTS [FROM [COUNT]] --pack DIR [--url URL]\ngym grade report RESULTS\ngym [window] --pack DIR --log FILE [--now MS] [--seed N] [--url URL] [--script S.txt [--dump] [--render-after OUT.ppm]]"])
