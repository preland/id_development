// `gym grade eval` and `gym grade report`: the grader evaluation (ai/eval/set.txt)
// from the command line. `gym grade eval SET RESULTS [FROM [COUNT]] --pack DIR`
// grades the attempts of SET numbered FROM to FROM + COUNT - 1 (default from 0,
// 1000 of them) through the model and appends one row each to RESULTS, so forty
// attempts run in slices of a few that fit the time limit; `gym grade report
// RESULTS` prints the agreement and failure counts of a results file. Neither
// writes a log. command_whole reads FROM and COUNT: the fallback for no word, -1
// for a word that is not a whole number.

command_whole(string command_text, int command_fallback) {
  int command_made = command_fallback;
  if (command_text != "") {
    command_made = 0 - 1;
  }
  if (log_digits_ok(command_text, 9) == 1) {
    command_made = to_int(command_text);
  }
} return int command_made;
("", 7):(7)
("12", 7):(12)
("x", 7):(-1)
("-3", 7):(-1)

command_grade_evaluation(string[] command_values, string[] command_rest, word command_clock) {
  string command_refusal = command_check(command_values, command_clock, ["pack"]);
  string command_set = command_word(command_rest, 2);
  string command_results = command_word(command_rest, 3);
} chain (string[] command_values, string[] command_rest, word command_clock) {
  int command_from = command_whole(command_word(command_rest, 4), 0);
  int command_count = command_whole(command_word(command_rest, 5), 1000);
  string command_url = options_get((import command_options), command_values, "url");
} chain (string[] command_values, string[] command_rest, word command_clock) {
  if (command_url == "") {
    command_url = model_address();
  }
  if (command_refusal == "" && (command_set == "" || command_results == "")) {
    command_refusal = "error: say which files: gym grade eval SET RESULTS [FROM [COUNT]] --pack DIR";
  }
  if (command_refusal == "" && (command_from < 0 || command_count < 0)) {
    command_refusal = "error: FROM and COUNT are whole numbers, such as: gym grade eval set.txt results.tsv 0 4 --pack DIR";
  }
} chain (string[] command_values, string[] command_rest, word command_clock) {
  int command_kept = 0;
  string[] command_out = ["2", command_refusal];
  if (command_refusal == "") {
    command_kept = evaluation_slice(command_url, options_get((import command_options), command_values, "pack"), command_set, command_results, command_from, command_count);
    command_out = ["0", "graded " + command_kept + " attempts into " + command_results];
  }
} return string[] command_out;
