command_grade_report(string[] command_rest) {
  string command_results = command_word(command_rest, 2);
  string[] command_out = ["2", "error: say which results file: gym grade report RESULTS"];
  if (command_results != "" && fs_exists(command_results) == 1) {
    command_out = ["0", evaluation_report(fs_read_text(command_results))];
  }
} return string[] command_out;
