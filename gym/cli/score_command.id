// `gym score` and `gym why`: the five metrics with their sample sizes and
// definitions ("not enough data" when there is too little), and the reason one
// item is on the plan (P11). `--now` is accepted by both; the scoreboard does
// not use it, because every figure is a function of the logged times alone.

command_score(string[] command_values, word command_clock) {
  string command_refusal = command_check(command_values, command_clock, ["pack", "log"]);
  string[] command_out = ["2", command_refusal];
  if (command_refusal != "") {
    return command_out;
  }
} chain (string[] command_values, word command_clock) {
  Pack command_book = pack_load(opt_get((import command_options), command_values, "pack"));
  Log_replay command_replayed = log_replay(opt_get((import command_options), command_values, "log"));
  Score_table command_table = score_table(command_replayed.events, command_book);
} chain (string[] command_values, word command_clock) {
  command_out = ["0", command_score_text(command_table)];
} return string[] command_out;
given command_fixture_files("item: a\nprompt: Q1?\nanswer_kind: fraction\nanswer: 1/3\n", "") (["pack", "learner.log", "", "", "", "", "", "", ""], 5):(["0", "scoreboard from 0 logged attempts; only delayed, unassisted and held-out results count\nretention: not enough data (n = 0, need 5)\n  Of the attempts on items you had last tried at least a day earlier, with no hints and no tap-out, the share you got right. It shows what stuck after a delay.\ntransfer: not enough data (n = 0, need 5)\n  The share you got right on held-out items that are never used in practice, so the number cannot come from memorising answers.\ncalibration: not enough data (n = 0, need 5)\n  The Brier score of your confidence on the first attempt at each item: 0 is perfect, 0.25 is what saying 50 percent every time earns, 1 is always certain and always wrong. Lower is better.\nindependence: not enough data (n = 0, need 5)\n  Hints used plus tap-outs, for each item you solved. Lower is better; a falling trend shows the scaffolding fading.\nfluency: not enough data (n = 0, need 5)\n  The median seconds you took on answers that were right with no hints and no tap-out. A falling number shows the skill becoming automatic."])
given command_fixture_files("item: a\nprompt: Q1?\nanswer_kind: fraction\nanswer: 1/3\n", "") (["pack", "", "", "", "", "", "", "", ""], 5):(["2", "error: --log is required; gym --help lists every option"])

command_why(string[] command_values, word command_clock, string[] command_rest) {
  string command_refusal = command_check(command_values, command_clock, ["pack", "log"]);
  string command_item = opt_get((import command_options), command_values, "item");
  if (command_item == "") {
    command_item = command_word(command_rest, 1);
  }
} chain (string[] command_values, word command_clock, string[] command_rest) {
  if (command_refusal == "" && command_item == "") {
    command_refusal = "error: say which item: gym why ITEM --pack DIR --log FILE";
  }
  string[] command_out = ["2", command_refusal];
  if (command_refusal != "") {
    return command_out;
  }
} chain (string[] command_values, word command_clock, string[] command_rest) {
  Pack command_book = pack_load(opt_get((import command_options), command_values, "pack"));
  Log_replay command_replayed = log_replay(opt_get((import command_options), command_values, "log"));
  command_out = ["0", session_reason(command_book, command_replayed.events, command_item, command_now(command_values, command_clock), command_number(command_values, "seed", 1))];
} return string[] command_out;
given command_fixture_files("item: a\nprompt: Q?\nanswer_kind: fraction\nanswer: 1/3\nitem: b\nprompt: Q2?\nanswer_kind: fraction\nanswer: 1/2\n", "1\tsession_plan\ta,b\twarmup,main\tdue: x\\nnew: y\n") (["pack", "learner.log", "100", "", "", "", "", "", ""], 5, ["why", "b"]):(["0", "b (place 2 in the current session): new: y"])
