given command_fixture_files("item: a\n", "") (["pack", "", "", "", "", "", "", "", ""], 5):(["2", "error: --log is required; gym --help lists every option"])

command_tap_out(string[] command_values, word command_clock) {
  string command_refusal = command_check(command_values, command_clock, ["pack", "log"]);
  string[] command_out = ["2", command_refusal];
  if (command_refusal != "") {
    return command_out;
  }
} chain (string[] command_values, word command_clock) {
  Pack command_book = pack_load(opt_get((import command_options), command_values, "pack"));
  int command_confidence = command_number(command_values, "confidence", (import session_confidence_default));
  int command_seconds = command_number(command_values, "seconds", 0);
} chain (string[] command_values, word command_clock) {
  string[] command_result = session_tap_out(command_book, opt_get((import command_options), command_values, "log"), command_now(command_values, command_clock), command_confidence, command_seconds);
  command_out = ["1", command_tap_text(command_result)];
  if (command_result[0] == "ok") {
    command_out[0] = "0";
  }
} return string[] command_out;
