// blocks -- a block-coding tool written in id. A program is a .blk file
// (FORMAT.md); this tool checks it against id's rules, runs it on a virtual
// machine of its own, runs the test cases of its functions, and edits it as
// blocks in a window.
//
//   blocks run FILE.blk [--frames N]    run the green flag, print what was said
//                                       and the final state
//   blocks check FILE.blk               report the rule violations, with the
//                                       code id gives each; exit 1 if any
//   blocks test FILE.blk                run every function's cases in the VM
//   blocks edit FILE.blk [--script S.txt [--dump] [--boxes] [--render-after OUT.ppm]]
//                                       the block editor; with a script, headless
//   blocks render FILE.blk OUT.ppm [--size W H]
//                                       the picture of the editor on the file

main(int argument_count, string[] argument_values) {
  int block_status = command_main(argument_count, argument_values);
} return int block_status;
(1, ["blocks"]):(2) then eprints:("usage: blocks run FILE.blk [--frames N] | blocks check FILE.blk | blocks test FILE.blk | blocks edit FILE.blk [--script S.txt [--dump] [--boxes] [--render-after OUT.ppm]] | blocks render FILE.blk OUT.ppm [--size W H]\n")
(3, ["blocks", "test", "/nonexistent/none.blk"]):(2) then eprints:("blocks: cannot read /nonexistent/none.blk, or it is empty\n")
