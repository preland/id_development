// The refusals about the shape of what is exported (refuse_forward.id and
// refuse_equal.id) applied to every stage of a function, whatever the program:
// exporter_refuse_stage to one stage, exporter_refuse_stages to all of them.

exporter_refuse_stage(int exporter_number_function, int exporter_number_stage) {
  exporter_refuse_forward(exporter_number_function, exporter_number_stage);
  exporter_refuse_earlier(exporter_number_function, exporter_number_stage);
} return void;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  b()\nfn b() return void\n  say(\"z\")\n(): ()\n(1): ()") (1, 1):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn a() return void\n  say(\"x\")\nfn b() return void\n  say(\"y\")\n(): ()\n(1): ()") (1, 0):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn a() return void\n  say(\"x\")\n  say(\"y\")\nfn b() return void\n  say(\"y\")\n(): ()\n(1): ()") (1, 0):() then len((import model_diagnostics)):(0)

exporter_refuse_stages(int exporter_number_function) {
  int exporter_number_stage = 0;
  exporter_refuse_blocks(exporter_number_function);
  while (exporter_number_stage < len((import constant_export_ordinals))) {
    exporter_refuse_stage(exporter_number_function, exporter_number_stage);
    exporter_number_stage = exporter_number_stage + 1;
  }
} return void;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  b()\nfn b() return void\n  say(\"z\")\n(): ()\n(1): ()") (1):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn a() return void\n  say(\"x\")\n  say(\"y\")\n(): ()\n(1): ()") (0):() then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nvar int x\nfn f() return void\n  x = 1\n(): ()\n(1): ()") (0):() then len((import model_diagnostics)):(0)
