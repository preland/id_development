// What follows the first word of a statement, without the spaces around it:
// the condition of an 'if' or 'while', the value of a 'return'.

exporter_rest(string exporter_text_line, string exporter_text_head) {
  string exporter_text_tail = str_sub(exporter_text_line, len(exporter_text_head), len(exporter_text_line) - len(exporter_text_head));
  string exporter_text_rest = string_trim(exporter_text_tail);
} return string exporter_text_rest;
("if a < b", "if"):("a < b")
("else", "else"):("")
("return  x ", "return"):("x")

exporter_path(int exporter_number_sprite, string exporter_text_name, string exporter_text_suffix) {
  string exporter_text_directory = exporter_directory(exporter_number_sprite);
  string exporter_text_file = exporter_text_name;
  if (exporter_text_name == exporter_text_directory) {
    exporter_text_file = exporter_text_name + exporter_text_suffix;
  }
} chain (int exporter_number_sprite, string exporter_text_name, string exporter_text_suffix) {
  string exporter_text_path = exporter_text_directory + "/" + exporter_text_file;
} return string exporter_text_path;
given model_load("t.blk", "sprite Words\nsprite __sys") (0, "words", "_variable"):("words/words_variable")
given model_load("t.blk", "sprite Words\nsprite __sys") (0, "text", "_function"):("words/text")
