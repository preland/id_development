// A script that waits is cut into stages, each a function of its own, so a
// local declared before a wait is not there after it. exporter_local_name
// finds the name a body line declares (empty for any other line),
// exporter_wait_after the first wait on the top level after a line (-1 for
// none) and exporter_used_after how many lines from one on mention a name.

exporter_local_name(string exporter_text_line) {
  string[] exporter_texts_tokens = lexer_tokens(exporter_text_line);
  int exporter_number_type = model_type(exporter_texts_tokens, 0);
  string exporter_text_name = list_string_get_or(exporter_texts_tokens, 1 + (exporter_number_type > 3) * 2, "");
} chain (string exporter_text_line) {
  if (exporter_number_type == 0 || model_is_name(exporter_text_name) == 0) {
    exporter_text_name = "";
  }
} return string exporter_text_name;
("  int n = 0"):("n")
("  string[] words = []"):("words")
("  n = 1"):("")

exporter_wait_after(int exporter_number_function, int exporter_number_line) {
  int exporter_number_wait = -1;
  int exporter_number_next = exporter_number_line + 1;
  while (exporter_number_next < (import model_function_body_end)[exporter_number_function] && exporter_number_wait < 0) {
    if (str_starts(str_trim((import model_line_texts)[exporter_number_next]), "wait(") && exporter_top(exporter_number_next) == 1) {
      exporter_number_wait = exporter_number_next;
    }
    exporter_number_next = exporter_number_next + 1;
  }
} return int exporter_number_wait;
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"a\")\n  wait(1.0)\n  say(\"b\")\n  wait(2.0)") (0, 1):(3)[time:O(n), mem:O(1)]
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"a\")\n  wait(1.0)\n  say(\"b\")\n  wait(2.0)") (0, 3):(5)[time:O(n), mem:O(1)]
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"a\")\n  wait(1.0)") (0, 3):(-1)

exporter_used_after(int exporter_number_function, string exporter_text_name, int exporter_number_from) {
  int exporter_number_found = 0;
  int exporter_number_next = exporter_number_from;
  while (exporter_number_next < (import model_function_body_end)[exporter_number_function]) {
    exporter_number_found = exporter_number_found + (list_string_index(lexer_tokens((import model_line_texts)[exporter_number_next]), exporter_text_name) >= 0);
    exporter_number_next = exporter_number_next + 1;
  }
} return int exporter_number_found;
given model_load("t.blk", "sprite S\nfn f() return void\n  int n = 0\n  wait(1.0)\n  say(int_to_str(n))\n  n = 2") (0, "n", 4):(2)[time:O(n), mem:O(1)]
given model_load("t.blk", "sprite S\nfn f() return void\n  int n = 0\n  wait(1.0)\n  say(int_to_str(n))") (0, "n", 3):(1)[time:O(n), mem:O(1)]
given model_load("t.blk", "sprite S\nfn f() return void\n  int n = 0\n  wait(1.0)\n  say(\"x\")") (0, "n", 3):(0)
