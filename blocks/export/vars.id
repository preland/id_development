exporter_assigns_element(int exporter_number_variable) {
  int exporter_number_found = 0;
  int exporter_number_index = 0;
  while (exporter_number_index < len((import model_line_texts))) {
    exporter_number_found = exporter_number_found + str_starts((import model_line_texts)[exporter_number_index], (import model_variable_names)[exporter_number_variable] + "[");
    exporter_number_index = exporter_number_index + 1;
  }
} return int exporter_number_found;
