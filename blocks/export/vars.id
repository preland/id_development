exporter_variable_files(int exporter_number_variable) {
  string exporter_text_path = exporter_path((import model_variable_sprites)[exporter_number_variable], (import model_variable_names)[exporter_number_variable], "_variable");
  exporter_add(exporter_text_path + ".id", exporter_variable_text(exporter_number_variable));
  if (exporter_assigns_element(exporter_number_variable) > 0) {
    exporter_add(exporter_text_path + "_at.id", exporter_fill((import constant_template_at), exporter_number_variable));
  }
} chain (int exporter_number_variable) {
  if (exporter_assigns_clear(exporter_number_variable) > 0) {
    exporter_add(exporter_text_path + "_clear.id", exporter_fill((import constant_template_clear), exporter_number_variable));
  }
} return void;
