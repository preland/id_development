// The sprites' state in the exported program: one variable, sprite_states,
// six cells to a sprite (the machine's own, constant_sprite_initial), which
// the motion blocks of runtime/ read and write. It is added to the model's
// variable tables as if the .blk had declared it, on a sprite row past the
// last, so that it gets its setter, getter and starter like any variable and
// its files go to the runtime directory (exporter_directory).

exporter_states_text() {
  string[] exporter_texts_cells = [];
  int exporter_number_index = 0;
  while (exporter_number_index < exporter_sprite_count()) {
    push(exporter_texts_cells, (import constant_export_state_initial));
    exporter_number_index = exporter_number_index + 1;
  }
} chain () {
  string exporter_text_list = "[" + str_join(exporter_texts_cells, ", ") + "]";
} return string exporter_text_list;
given model_load("t.blk", "sprite A\nsprite B\nsprite __sys") ():("[0.0, 0.0, 90.0, 100.0, 1.0, -1.0, 0.0, 0.0, 90.0, 100.0, 1.0, -1.0]")
given model_load("t.blk", "sprite A") ():("[0.0, 0.0, 90.0, 100.0, 1.0, -1.0]")

exporter_states_add() {
  int exporter_number_used = exporter_motion();
  if (exporter_number_used > 0) {
    push((import model_variable_names), (import constant_export_states));
    push((import model_variable_types), (import constant_type_float_list));
    push((import model_variable_sprites), len((import model_sprite_names)));
  }
  if (exporter_number_used > 0) {
    push((import model_variable_initials), exporter_states_text());
    push((import model_variable_lines), 0);
  }
} return void;
given model_load("t.blk", "sprite A\nfn f() return void\n  move(1.0)\n(): ()\n(1): ()") ():() then len((import model_variable_names)):(1) then (import model_variable_initials):(["[0.0, 0.0, 90.0, 100.0, 1.0, -1.0]"])
given model_load("t.blk", "sprite A\nfn f() return void\n  say(\"x\")\n(): ()\n(1): ()") ():() then len((import model_variable_names)):(0)

exporter_directory(int exporter_number_sprite) {
  string exporter_text_directory = "runtime";
  if (exporter_number_sprite < len((import model_sprite_names)) && str_starts((import model_sprite_names)[exporter_number_sprite], "__") == 0) {
    exporter_text_directory = str_lower((import model_sprite_names)[exporter_number_sprite]);
  }
} return string exporter_text_directory;
given model_load("t.blk", "sprite Cat\nsprite __sys") (0):("cat")
given model_load("t.blk", "sprite Cat\nsprite __sys") (1):("runtime")
given model_load("t.blk", "sprite Cat\nsprite __sys") (2):("runtime")
