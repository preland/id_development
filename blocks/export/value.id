// What a return can name. id's return clause (and an early return) takes a
// name or a literal; a variable of the program is an (import NAME) there, so
// it is not a name either. The checker (rules/returned.id) refuses every
// return that is not simple, so the export writes a return as it stands.

exporter_is_simple(string exporter_text_value, int exporter_number_function) {
  string[] exporter_texts_tokens = lexer_tokens(exporter_text_value);
  int exporter_number_simple = len(exporter_texts_tokens) == 1;
  if (exporter_number_simple == 1 && exporter_is_global(exporter_texts_tokens[0], exporter_number_function) == 1) {
    exporter_number_simple = 0;
  }
} return int exporter_number_simple;
given model_load("t.blk", "sprite S\nvar int n\nfn f(int p) return void") ("5", 0):(1)
given model_load("t.blk", "sprite S\nvar int n\nfn f(int p) return void") ("\"a b\"", 0):(1)
given model_load("t.blk", "sprite S\nvar int n\nfn f(int n) return void") ("n", 0):(1)
given model_load("t.blk", "sprite S\nvar int n\nfn f(int p) return void") ("x", 0):(1)
given model_load("t.blk", "sprite S\nvar int n\nfn f(int p) return void") ("n", 0):(0)
given model_load("t.blk", "sprite S\nvar int n\nfn f(int p) return void") ("x + 1", 0):(0)
given model_load("t.blk", "sprite S\nvar int n\nfn f(int p) return void") ("-1", 0):(0)
