exporter_empty_start(string exporter_text_line, int exporter_number_scan) {
  int exporter_number_start = 0 - 1;
  int exporter_number_next = string_skip_spaces(exporter_text_line, exporter_number_scan + 1);
  int exporter_number_previous = exporter_skip_back(exporter_text_line, exporter_number_scan - 1);
} chain (string exporter_text_line, int exporter_number_scan) {
  if (character_code_at(exporter_text_line, exporter_number_scan) == 91 && exporter_number_next < len(exporter_text_line) && character_code_at(exporter_text_line, exporter_number_next) == 93) {
    exporter_number_start = exporter_number_scan;
  }
  if (character_code_at(exporter_text_line, exporter_number_scan) == 93 && exporter_number_previous >= 0 && character_code_at(exporter_text_line, exporter_number_previous) == 91) {
    exporter_number_start = exporter_number_previous;
  }
} return int exporter_number_start;
