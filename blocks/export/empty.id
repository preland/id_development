  int exporter_number_type = 0 - 1;
  int exporter_number_callee = 0 - 1;
} chain (string exporter_text_line, int exporter_number_at) {
  if (exporter_number_open >= 0) {
    exporter_number_callee = list_string_index((import model_function_names), exporter_before(exporter_text_line, exporter_number_open));
  }
  int exporter_number_argument = 0;
  if (exporter_number_callee >= 0) {
    exporter_number_argument = exporter_argument_index(exporter_text_line, exporter_number_open, exporter_number_at);
    if (exporter_number_argument < (import model_function_parameter_count)[exporter_number_callee]) {
      exporter_number_type = (import model_pat)[(import model_function_parameter_start)[exporter_number_callee] + exporter_number_argument];
    }
  }
} chain (string exporter_text_line, int exporter_number_at) {
  if (exporter_number_type <= (import constant_type_list)) {
    exporter_number_type = 0 - 1;
  }
} return int exporter_number_type;
