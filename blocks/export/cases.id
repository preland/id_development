// The test cases of a function in id's case syntax. The .blk case is read the
// way the machine's runner reads it (run/parse.id) and its literals are
// written again with the spacing id programs use. 'given NAME = VALUE' sets
// a variable of the program through its setter and 'then NAME:(VALUE)' reads
// one through its getter; every case of a function that does not start the
// variables itself (main does) first runs variables_start.

exporter_tidy(string exporter_text_literal) {
  string[] exporter_texts_tokens = lexer_tokens(exporter_text_literal);
  string exporter_text_result = "";
  int exporter_number_index = 0;
} chain (string exporter_text_literal) {
  while (exporter_number_index < len(exporter_texts_tokens)) {
    exporter_text_result = exporter_text_result + exporter_texts_tokens[exporter_number_index];
    if (exporter_texts_tokens[exporter_number_index] == ",") {
      exporter_text_result = exporter_text_result + " ";
    }
    exporter_number_index = exporter_number_index + 1;
  }
} return string exporter_text_result;
("[ 1 , 2 ]"):("[1, 2]")
("\"a b\" , - 5"):("\"a b\", -5")
(""):("")

exporter_given(string exporter_text_entry) {
  string exporter_text_rest = str_sub(exporter_text_entry, 2, len(exporter_text_entry) - 2);
  int exporter_number_equals = string_find(exporter_text_rest, "=");
  string exporter_text_value = str_sub(exporter_text_rest, exporter_number_equals + 1, len(exporter_text_rest) - exporter_number_equals - 1);
} chain (string exporter_text_entry) {
  string exporter_text_clause = "given " + string_trim(str_sub(exporter_text_rest, 0, exporter_number_equals)) + "_set(" + exporter_tidy(exporter_text_value) + ") ";
} return string exporter_text_clause;
("G|count = 10"):("given count_set(10) ")
("G|xs = [ 1 , 2 ]"):("given xs_set([1, 2]) ")

exporter_then(string exporter_text_entry) {
  string exporter_text_rest = str_sub(exporter_text_entry, 2, len(exporter_text_entry) - 2);
  int exporter_number_bar = string_find(exporter_text_rest, "|");
  string exporter_text_value = str_sub(exporter_text_rest, exporter_number_bar + 1, len(exporter_text_rest) - exporter_number_bar - 1);
} chain (string exporter_text_entry) {
  string exporter_text_clause = " then " + str_sub(exporter_text_rest, 0, exporter_number_bar) + "_get:(" + exporter_tidy(exporter_text_value) + ")";
} return string exporter_text_clause;
("T|count|15"):(" then count_get:(15)")
("T|xs|[ 1 , 2 ]"):(" then xs_get:([1, 2])")
