// The files of the later stages of the scripts (resume.id writes one), each
// next to its script's page. Only a program that broadcasts has stages.

exporter_resume_file(int exporter_number_function, int exporter_number_stage) {
  string[] exporter_texts_lines = exporter_script_lines(exporter_number_function, exporter_number_stage);
  string exporter_text_path = exporter_path((import model_function_sprites)[exporter_number_function], exporter_after(exporter_number_function, exporter_number_stage), "_function");
  if (len(exporter_texts_lines) > 0 && ((import model_function_message)[exporter_number_function] != "" || (import model_function_names)[exporter_number_function] == "main") && exporter_uses("broadcast") == 1) {
    exporter_add(exporter_text_path + ".id", exporter_resume(exporter_number_function, exporter_number_stage));
  }
} return void;
given exporter_initial given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") (1, 1):() then (import exporter_paths):(["s/a_after_one.id"])
given exporter_initial given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") (1, 2):() then (import exporter_paths):([])
given exporter_initial given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  wait(1.0)\n  say(\"y\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)") (0, 1):() then (import exporter_paths):(["s/main_after_one.id"])

exporter_resumes() {
  int exporter_number_function = 0;
  while (exporter_number_function < len((import model_function_names))) {
    int exporter_number_stage = 1;
    while (exporter_number_stage < len((import constant_export_ordinals))) {
      exporter_resume_file(exporter_number_function, exporter_number_stage);
      exporter_number_stage = exporter_number_stage + 1;
    }
    exporter_number_function = exporter_number_function + 1;
  }
} return void;
given exporter_initial given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n  wait(2.0)\n  say(\"z\")\n(): ()\n(1): ()") ():() then (import exporter_paths):(["s/a_after_one.id", "s/a_after_two.id"])
given exporter_initial given model_load("t.blk", "sprite S\nfn a() return void\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") ():() then (import exporter_paths):([])
