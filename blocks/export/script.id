given model_load("t.blk", "sprite S\nvar int n\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)") (0, 1):("given variables_start given schedule_initial ")
