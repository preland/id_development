// What the program uses, read off the text of its bodies. A word followed by
// '(' anywhere counts (a name that merely ends in the word counts too, which
// only adds a runtime file the program does not call). The motion blocks and
// the program's sprites decide whether the exported program carries the
// sprites' state (sprite_states).

exporter_uses(string exporter_text_word) {
  string exporter_text_all = str_join((import model_line_texts), "\n");
  int exporter_number_found = str_find(exporter_text_all, exporter_text_word + "(") >= 0;
} return int exporter_number_found;
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"x\")\n(): ()\n(1): ()") ("say"):(1)
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"x\")\n(): ()\n(1): ()") ("wait"):(0)

exporter_motion() {
  int exporter_number_used = 0;
  int exporter_number_index = 0;
  while (exporter_number_index < len((import constant_export_motion))) {
    exporter_number_used = exporter_number_used + exporter_uses((import constant_export_motion)[exporter_number_index]);
    exporter_number_index = exporter_number_index + 1;
  }
} return int exporter_number_used;
given model_load("t.blk", "sprite S\nfn f() return void\n  move(1.0)\n  turn(2.0)\n(): ()\n(1): ()") ():(2)
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"x\")\n(): ()\n(1): ()") ():(0)

exporter_sprite_count() {
  int exporter_number_count = 0;
  int exporter_number_index = 0;
  while (exporter_number_index < len((import model_sprite_names))) {
    exporter_number_count = exporter_number_count + (str_starts((import model_sprite_names)[exporter_number_index], "__") == 0);
    exporter_number_index = exporter_number_index + 1;
  }
} return int exporter_number_count;
given model_load("t.blk", "sprite A\nsprite B\nsprite __sys") ():(2)
given model_load("t.blk", "sprite A") ():(1)
