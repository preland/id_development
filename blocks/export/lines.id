// What surrounds the body of a function in the exported text. The last line
// of a function that returns something is its 'return', which becomes the
// return clause (exporter_returned is what it returns, empty when the body has
// no such line); and main starts by setting the program's variables, which id
// has to be told to do because an export has no value before its setter ran.

exporter_has_return(int exporter_number_function) {
  int exporter_number_end = (import model_function_body_end)[exporter_number_function];
  int exporter_number_found = exporter_number_end > (import model_function_body_start)[exporter_number_function] && str_starts((import model_line_texts)[exporter_number_end - 1], "return");
} return int exporter_number_found;
given model_load("t.blk", "sprite S\nfn f() return int\n  return 1\n(): (1)\n(): (2)\nfn g() return void\n  say(\"x\")\n(): ()\n(1): ()") (0):(1)
given model_load("t.blk", "sprite S\nfn f() return int\n  return 1\n(): (1)\n(): (2)\nfn g() return void\n  say(\"x\")\n(): ()\n(1): ()") (1):(0)
given model_load("t.blk", "sprite S\nfn g() return void\n(): ()\n(1): ()") (0):(0)

exporter_returned(int exporter_number_function) {
  string exporter_text_value = "";
  int exporter_number_last = (import model_function_body_end)[exporter_number_function] - 1;
  if (exporter_has_return(exporter_number_function) == 1) {
    string exporter_text_line = (import model_line_texts)[exporter_number_last];
    string exporter_text_tail = str_sub(exporter_text_line, 6, len(exporter_text_line) - 6);
    exporter_text_value = str_trim(exporter_text_tail);
  }
} return string exporter_text_value;
given model_load("t.blk", "sprite S\nfn f() return int\n  return n + 1\n(): (1)\n(): (2)\nfn g() return void\n  say(\"x\")\n(): ()\n(1): ()") (0):("n + 1")
given model_load("t.blk", "sprite S\nfn f() return int\n  return n + 1\n(): (1)\n(): (2)\nfn g() return void\n  say(\"x\")\n(): ()\n(1): ()") (1):("")

exporter_start(string[] exporter_texts_lines, int exporter_number_function) {
  if ((import model_function_names)[exporter_number_function] == "main" && len((import model_variable_names)) > 0) {
    push(exporter_texts_lines, "  variables_start();");
  }
  if ((import model_function_names)[exporter_number_function] == "main" && exporter_uses("broadcast") == 1) {
    push(exporter_texts_lines, "  schedule_initial();");
  }
} return void;
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\nfn main(int argc, string[] argv) return int") ([], 1):(["  variables_start();"])
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\nfn main(int argc, string[] argv) return int") ([], 0):([])
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int") ([], 0):([])
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)") ([], 0):(["  schedule_initial();"])
