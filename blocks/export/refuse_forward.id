// The first of the refusals about the shape of what is exported (the rest are
// in refuse_equal.id). idc rejects a function whose whole body is one call
// that passes its parameters on unchanged (E0406, a pure forwarder), and a
// stage of a script cut at a wait is a function of its own with no parameters,
// so a stage that only calls another function is one. These are checked in
// every program, since a script that does not wait can be a forwarder too.
// exporter_checked tells which functions are exported at all: every function
// at its first stage, a later stage only where the scheduler cuts the script,
// and never the first stage of main, which idc leaves alone, or of a function
// that runs on no message, which the rule checker (E0406, E0407) has judged.

exporter_checked(int exporter_number_function, int exporter_number_stage) {
  int exporter_number_checked = len(exporter_script_lines(exporter_number_function, exporter_number_stage)) > 0 && str_starts((import model_function_names)[exporter_number_function], "__") == 0;
  int exporter_number_main = (import model_function_names)[exporter_number_function] == "main";
  int exporter_number_cut = exporter_uses("broadcast") == 1 && ((import model_function_message)[exporter_number_function] != "" || exporter_number_main == 1);
} chain (int exporter_number_function, int exporter_number_stage) {
  if (exporter_number_stage > 0 && exporter_number_cut == 0) {
    exporter_number_checked = 0;
  }
  if (exporter_number_stage == 0 && (exporter_number_main == 1 || (import model_function_message)[exporter_number_function] == "")) {
    exporter_number_checked = 0;
  }
} return int exporter_number_checked;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") (1, 0):(1)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") (1, 1):(1)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") (1, 2):(0)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") (0, 0):(0)
given model_load("t.blk", "sprite S\nfn __c() return void\n  say(\"x\")\nfn d() return void\n  say(\"y\")") (0, 0):(0)

exporter_forwarded(string[] exporter_texts_lines, string exporter_text_names) {
  string exporter_text_line = list_string_get_or(exporter_texts_lines, 0, "");
  int exporter_number_open = str_find(exporter_text_line, "(");
  string exporter_text_callee = "";
} chain (string[] exporter_texts_lines, string exporter_text_names) {
  if (len(exporter_texts_lines) == 1 && exporter_number_open > 0 && str_ends(exporter_text_line, ");")) {
    exporter_text_callee = str_trim(str_sub(exporter_text_line, 0, exporter_number_open));
  }
  if (exporter_text_callee != "" && str_sub(exporter_text_line, exporter_number_open + 1, len(exporter_text_line) - exporter_number_open - 3) != exporter_text_names) {
    exporter_text_callee = "";
  }
} return string exporter_text_callee;
(["  b();"], ""):("b")
(["  b(x, y);"], "x, y"):("b")
(["  b(x, y);"], "x"):("")
(["  b();", "  c();"], ""):("")
(["  say(\"S\", \"y\");"], ""):("")

exporter_refuse_forward(int exporter_number_function, int exporter_number_stage) {
  string exporter_text_callee = "";
  if (exporter_checked(exporter_number_function, exporter_number_stage) == 1) {
    exporter_text_callee = exporter_forwarded(exporter_script_lines(exporter_number_function, exporter_number_stage), exporter_names(exporter_number_function, exporter_number_stage));
  }
  if (exporter_text_callee != "") {
    model_error((import model_line_numbers)[(import model_function_body_end)[exporter_number_function] - 1], "", "'" + exporter_after(exporter_number_function, exporter_number_stage) + "' would export as a function whose only statement is a call of '" + exporter_text_callee + "', which idc rejects as a pure forwarder (E0406) -- add another statement to this script or to this part of it after a wait, or call '" + exporter_text_callee + "' where the script is started and delete the script");
  }
} return void;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  b()\nfn b() return void\n  say(\"z\")\n(): ()\n(1): ()") (1, 1):() then len((import model_diagnostics)):(1)
