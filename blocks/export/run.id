// The export: exporter_tree decides the files of the project from the loaded
// model, exporter_write puts them under a directory (printing each path, which
// is the tree listing of the golden), and exporter_run is the command's body.
// The sprites' state is added to the model first because the files of the
// variables and conf.id depend on it.

exporter_tree() {
  exporter_initial();
  exporter_states_add();
  exporter_conf();
} chain () {
  exporter_variables();
  if (len((import model_variable_names)) > 0) {
    exporter_starts();
  }
  exporter_main();
} chain () {
  exporter_pages();
  exporter_runtime();
  exporter_schedule();
} return void;
given model_load("t.blk", "sprite Cat\nfn main(int argc, string[] argv) return int\n  say(\"hi\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)") ():() then (import exporter_paths):(["conf.id", "main.id", "runtime/say.id"])
given model_load("t.blk", "sprite Cat\nvar int n\nfn bump() return void\n  n = n + 1\n(): ()\ngiven n = 2 (): ()") ():() then (import exporter_paths):(["conf.id", "cat/n.id", "variables.id", "cat/bump.id"])

exporter_write(string exporter_text_directory) {
  int exporter_number_bad = 0;
  int exporter_number_index = 0;
  while (exporter_number_index < len((import exporter_paths))) {
    exporter_number_bad = exporter_number_bad + exporter_put(exporter_text_directory + "/" + (import exporter_paths)[exporter_number_index], (import exporter_contents)[exporter_number_index]);
    print((import exporter_paths)[exporter_number_index]);
    exporter_number_index = exporter_number_index + 1;
  }
} return int exporter_number_bad;
given exporter_initial given exporter_add("a.id", "x") ("/proc/blocks_export_none"):(1) then prints:("a.id\n")
given exporter_initial ("/proc/blocks_export_none"):(0)

exporter_run(string exporter_text_directory) {
  exporter_tree();
  int exporter_number_status = exporter_write(exporter_text_directory) > 0;
  if (exporter_number_status == 1) {
    eprint("blocks: cannot write the exported project under " + exporter_text_directory);
  }
} return int exporter_number_status;
given model_load("t.blk", "sprite S") ("/proc/blocks_export_none"):(1) then eprints:("blocks: cannot write the exported project under /proc/blocks_export_none\n")
given model_load("t.blk", "sprite T") ("/proc/blocks_export_other"):(1) then eprints:("blocks: cannot write the exported project under /proc/blocks_export_other\n")
