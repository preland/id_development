// The statements that leave or start other scripts. A 'return' in the middle
// of a body names a value or a literal, as id's does; a broadcast of a
// literal message is the calls of the scripts that run on it, in the order
// they are written, so the exported program starts them one after another
// where the machine interleaves them (docs: what the export cannot say).

exporter_return(string exporter_text_value) {
  string exporter_text_result = "return;";
  if (exporter_text_value != "") {
    exporter_text_result = "return " + exporter_text_value + ";";
  }
} return string exporter_text_result;
(""):("return;")
("r"):("return r;")
("5"):("return 5;")

exporter_handlers(string exporter_text_message) {
  string exporter_text_calls = "";
  int exporter_number_row = 0;
  while (exporter_number_row < len((import model_function_names))) {
    if ((import model_function_message)[exporter_number_row] == exporter_text_message) {
      exporter_text_calls = exporter_text_calls + "schedule_spawn(" + exporter_number_row + ");\n";
    }
    exporter_number_row = exporter_number_row + 1;
  }
} return string exporter_text_calls;
given model_load("t.blk", "sprite S\nfn a() return void on \"go\"\nfn b() return void\nfn c() return void on \"go\"") ("go"):("schedule_spawn(0);\nschedule_spawn(2);\n")
given model_load("t.blk", "sprite S\nfn a() return void on \"go\"\nfn b() return void") ("stop"):("")

exporter_broadcast(string exporter_text_line, int exporter_number_function) {
  string exporter_text_result = exporter_expression(exporter_text_line, exporter_number_function) + ";";
  if (string_starts_with(exporter_text_line, "broadcast(\"") && string_ends_with(exporter_text_line, "\")")) {
    string exporter_text_message = str_sub(exporter_text_line, 11, len(exporter_text_line) - 13);
    exporter_text_result = exporter_handlers(exporter_text_message);
  }
} return string exporter_text_result;
given model_load("t.blk", "sprite S\nfn a() return void on \"go\"\nfn b() return void") ("broadcast(\"go\")", 1):("schedule_spawn(0);\n")
given model_load("t.blk", "sprite S\nfn a() return void on \"go\"\nfn b() return void") ("broadcast(\"stop\")", 1):("")
given model_load("t.blk", "sprite S\nfn a() return void on \"go\"\nfn b() return void") ("broadcast(m)", 1):("broadcast(m);")
