exporter_schedule() {
  int exporter_number_index = 0;
  if (exporter_uses("broadcast") == 1) {
    exporter_dispatch();
    exporter_resumes();
  }
  while (exporter_number_index < len((import constant_runtime_schedule_paths)) && exporter_uses("broadcast") == 1) {
    exporter_add((import constant_runtime_schedule_paths)[exporter_number_index], (import constant_runtime_schedule_texts)[exporter_number_index]);
    exporter_number_index = exporter_number_index + 1;
  }
} return void;
