// The one place that knows which function is which script. schedule_dispatch
// (runtime/schedule_dispatch.id) is given a script (the row of its function in
// the program) and a stage and calls the function of that stage; the
// scheduler (conf.id, constant_runtime_schedule_texts) knows nothing else
// about the program, so how scripts are run can change without touching this.
// exporter_schedule adds all of it when the program broadcasts.

exporter_entry(string[] exporter_texts_lines, int exporter_number_function, int exporter_number_stage) {
  string[] exporter_texts_part = exporter_script_lines(exporter_number_function, exporter_number_stage);
  string exporter_text_target = exporter_after(exporter_number_function, exporter_number_stage);
  if (len(exporter_texts_part) > 0 && ((import model_function_message)[exporter_number_function] != "" || ((import model_function_names)[exporter_number_function] == "main" && exporter_number_stage > 0))) {
    push(exporter_texts_lines, "  if (schedule_script == " + exporter_number_function + " && schedule_stage == " + exporter_number_stage +") {");
    push(exporter_texts_lines, "    " + exporter_text_target + "();");
    push(exporter_texts_lines, "  }");
  }
} return void;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  say(\"x\")\n  wait(1.0)\n  say(\"y\")\n(): ()\n(1): ()") ([], 1, 1):(["  if (schedule_script == 1 && schedule_stage == 1) {", "    a_after_one();", "  }"])
