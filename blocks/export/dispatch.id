exporter_dispatch() {
  string[] exporter_texts_lines = [];
  int exporter_number_function = 0;
  while (exporter_number_function < len((import model_function_names))) {
    int exporter_number_stage = 0;
    while (exporter_number_stage < len((import constant_export_ordinals))) {
      exporter_entry(exporter_texts_lines, exporter_number_function, exporter_number_stage);
      exporter_number_stage = exporter_number_stage + 1;
    }
    exporter_number_function = exporter_number_function + 1;
  }
} chain () {
  string exporter_text_head = "schedule_dispatch(int schedule_script, int schedule_stage) {\n" + exporter_chain(exporter_texts_lines, "int schedule_script, int schedule_stage") + "} return void;\n";
  string exporter_text_file = exporter_text_head + "given schedule_initial (-1, 0):() then (import schedule_table):([0, -1, 0, 0, 1, 0])\ngiven schedule_initial (-2, 1):() then (import schedule_table):([0, -1, 0, 0, 1, 0])\n";
  exporter_add("runtime/schedule_dispatch.id", exporter_text_file);
} return void;
