// The second refusal about the shape of what is exported (refuse_forward.id
// has the first). idc rejects two functions with one signature and the same
// logic that differ only in the values of their literals (E0407); a stage
// that is all that differs between two scripts that wait is exactly that.
// exporter_refuse_equal compares a stage with one before it (so a pair is
// reported once, at the later one), exporter_refuse_earlier with all of them.

exporter_refuse_equal(int exporter_number_function, int exporter_number_stage, int exporter_number_other, int exporter_number_step) {
  int exporter_number_before = exporter_number_other < exporter_number_function || (exporter_number_other == exporter_number_function && exporter_number_step < exporter_number_stage);
  string exporter_text_key = "";
  if (exporter_number_before == 1 && exporter_checked(exporter_number_function, exporter_number_stage) == 1 && exporter_checked(exporter_number_other, exporter_number_step) == 1) {
    exporter_text_key = exporter_key(exporter_number_function, exporter_number_stage);
  }
} chain (int exporter_number_function, int exporter_number_stage, int exporter_number_other, int exporter_number_step) {
  if (exporter_text_key != "" && exporter_text_key == exporter_key(exporter_number_other, exporter_number_step)) {
    model_error((import model_line_numbers)[(import model_function_body_end)[exporter_number_function] - 1], "", "'" + exporter_after(exporter_number_other, exporter_number_step) + "' and '" + exporter_after(exporter_number_function, exporter_number_stage) + "' would export as functions that differ only in the values of their literals, which idc rejects (E0407) -- make the two scripts do different things (not the same steps with other numbers or texts), or merge them into one script");
  }
} return void;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  wait(1.0)\n  say(\"x\")\n  say(\"y\")\nfn b() return void on \"go\"\n  wait(2.0)\n  say(\"u\")\n  say(\"v\")\n(): ()\n(1): ()") (2, 1, 1, 1):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  wait(1.0)\n  say(\"x\")\n  say(\"y\")\nfn b() return void on \"go\"\n  wait(2.0)\n  say(\"u\")\n  say(\"v\")\n(): ()\n(1): ()") (1, 1, 2, 1):() then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  wait(1.0)\n  say(\"x\")\n  say(\"y\")\nfn b() return void on \"go\"\n  wait(2.0)\n  say(\"u\")\n  n = 1\n(): ()\n(1): ()") (2, 1, 1, 1):() then len((import model_diagnostics)):(0)

exporter_refuse_earlier(int exporter_number_function, int exporter_number_stage) {
  int exporter_number_other = 0;
  while (exporter_number_other < len((import model_function_names))) {
    int exporter_number_step = 0;
    while (exporter_number_step < len((import constant_export_ordinals))) {
      exporter_refuse_equal(exporter_number_function, exporter_number_stage, exporter_number_other, exporter_number_step);
      exporter_number_step = exporter_number_step + 1;
    }
    exporter_number_other = exporter_number_other + 1;
  }
} return void;
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  wait(1.0)\n  say(\"x\")\n  say(\"y\")\nfn b() return void on \"go\"\n  wait(2.0)\n  say(\"u\")\n  say(\"v\")\n(): ()\n(1): ()") (2, 1):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)\nfn a() return void on \"go\"\n  wait(1.0)\n  say(\"x\")\n  say(\"y\")\nfn b() return void on \"go\"\n  wait(2.0)\n  say(\"u\")\n  say(\"v\")\n(): ()\n(1): ()") (1, 1):() then len((import model_diagnostics)):(0)
