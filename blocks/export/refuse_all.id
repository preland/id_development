// exporter_refuse is the command's check: in a program that broadcasts (the
// only one the exporter schedules) every function of the program goes through
// all the refusals, and each one found is a diagnostic, so the export stops
// before it writes anything. The refusals about the shape of the exported
// functions (refuse_stages.id) apply to every program, broadcasting or not.

exporter_refuse_all(int exporter_number_function) {
  exporter_refuse_function(exporter_number_function);
  exporter_refuse_across(exporter_number_function);
  exporter_refuse_main(exporter_number_function);
} return void;
given model_load("t.blk", "sprite S\nvar string m\nfn f() return void\n  int n = 0\n  broadcast(m)\n  wait(1.0)\n  say(int_to_str(n))") (0):() then len((import model_diagnostics)):(3)
given model_load("t.blk", "sprite S\nfn f() return void\n  say(\"x\")") (0):() then len((import model_diagnostics)):(0)

exporter_refuse() {
  int exporter_number_function = 0;
  while (exporter_number_function < len((import model_function_names))) {
    if (exporter_uses("broadcast") == 1) {
      exporter_refuse_all(exporter_number_function);
    }
    exporter_refuse_stages(exporter_number_function);
    exporter_number_function = exporter_number_function + 1;
  }
} return void;
given model_load("t.blk", "sprite S\nfn a() return void on \"go\"\n  if x\n    wait(1.0)\nfn main(int argc, string[] argv) return int\n  broadcast(\"go\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\"]): (0)") ():() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn a() return void\n  if x\n    wait(1.0)") ():() then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nfn a() return void\n  b()\nfn b() return void\n  say(\"x\")") ():() then len((import model_diagnostics)):(0)
