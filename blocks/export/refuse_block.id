given model_load("t.blk", "sprite S\nfn f(int n) return int\n  int t = 0\n  if n > 0\n    t = t + n\n    t = t * 2\n    t = t + 1\n    return t + 100\n  return t + 1\n(3): (107)\n(0): (1)") (8, 0):(0)

exporter_refuse_blocks(int exporter_number_function) {
  int exporter_number_line = (import model_function_body_start)[exporter_number_function];
  while (exporter_number_line < (import model_function_body_end)[exporter_number_function]) {
    if (exporter_overflowing(exporter_number_line, exporter_number_function) == 1) {
      model_error((import model_line_numbers)[exporter_number_line], "", "'return' of an expression in a block of '" + (import model_function_names)[exporter_number_function] + "' that already holds three actions cannot be exported: the export names the value on a line of its own before the return, a fourth action that idc refuses (E0201) -- put the block into a function of its own, or return a variable that is already set");
    }
    exporter_number_line = exporter_number_line + 1;
  }
} return void;
