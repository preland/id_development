// The type of a name in a function, and the list blocks spelled for it.

exporter_type_of(string exporter_text_name, int exporter_number_function) {
  int exporter_number_type = exporter_parameter_type(exporter_text_name, exporter_number_function);
  if (exporter_number_type < 0) {
    exporter_number_type = exporter_local_type(exporter_text_name, exporter_number_function);
  }
  if (exporter_number_type < 0 && lst_str_index((import model_variable_names), exporter_text_name) >= 0) {
    exporter_number_type = (import model_variable_types)[lst_str_index((import model_variable_names), exporter_text_name)];
  }
} return int exporter_number_type;
given model_load("t.blk", "sprite S\nvar string[] words\nfn f(int[] xs) return void\n  float[] fs = [1.5]") ("xs", 0):(4)
given model_load("t.blk", "sprite S\nvar string[] words\nfn f(int[] xs) return void\n  float[] fs = [1.5]") ("fs", 0):(5)
given model_load("t.blk", "sprite S\nvar string[] words\nfn f(int[] xs) return void\n  float[] fs = [1.5]") ("words", 0):(6)
given model_load("t.blk", "sprite S\nvar string[] words\nfn f(int[] xs) return void\n  float[] fs = [1.5]") ("nothing", 0):(-1)

exporter_list_word(string exporter_text_word, string exporter_text_line, int exporter_number_end, int exporter_number_function) {
  int exporter_number_comma = str_findat(exporter_text_line, ",", exporter_number_end);
  string exporter_text_argument = str_trim(str_sub(exporter_text_line, exporter_number_end + 1, exporter_number_comma - exporter_number_end - 1));
  int exporter_number_type = exporter_type_of(exporter_text_argument, exporter_number_function);
} chain (string exporter_text_word, string exporter_text_line, int exporter_number_end, int exporter_number_function) {
  string exporter_text_result = exporter_text_word;
  if (exporter_number_type >= 0 && exporter_text_word == "insert") {
    exporter_text_result = (import constant_export_insert)[exporter_number_type];
  }
  if (exporter_number_type >= 0 && exporter_text_word == "delete") {
    exporter_text_result = (import constant_export_delete)[exporter_number_type];
  }
} return string exporter_text_result;
given model_load("t.blk", "sprite S\nfn f(int[] xs, string[] ss) return void") ("insert", "insert(xs, 1, 7)", 6, 0):("lst_insert")
given model_load("t.blk", "sprite S\nfn f(int[] xs, string[] ss) return void") ("delete", "delete(ss, 0)", 6, 0):("lst_str_delete")
given model_load("t.blk", "sprite S\nfn f(float[] fs) return void") ("insert", "insert(fs, 1, 7.5)", 6, 0):("lst_float_insert")
given model_load("t.blk", "sprite S\nfn f(float[] fs) return void") ("delete", "delete(fs, 0)", 6, 0):("lst_float_delete")
given model_load("t.blk", "sprite S\nfn f(int[] xs, string[] ss) return void") ("insert", "insert(zz, 1, 7)", 6, 0):("insert")

exporter_is_global(string exporter_text_name, int exporter_number_function) {
  int exporter_number_global = lst_str_index((import model_variable_names), exporter_text_name) >= 0;
  if (exporter_number_global == 1 && exporter_parameter_type(exporter_text_name, exporter_number_function) >= 0) {
    exporter_number_global = 0;
  }
  if (exporter_number_global == 1 && exporter_local_type(exporter_text_name, exporter_number_function) >= 0) {
    exporter_number_global = 0;
  }
} return int exporter_number_global;
given model_load("t.blk", "sprite S\nvar int a\nvar int p\nvar int q\nfn f(int p) return void\n  int q = 1") ("a", 0):(1)
given model_load("t.blk", "sprite S\nvar int a\nvar int p\nvar int q\nfn f(int p) return void\n  int q = 1") ("p", 0):(0)
given model_load("t.blk", "sprite S\nvar int a\nvar int p\nvar int q\nfn f(int p) return void\n  int q = 1") ("q", 0):(0)
given model_load("t.blk", "sprite S\nvar int a\nvar int p\nvar int q\nfn f(int p) return void\n  int q = 1") ("z", 0):(0)
