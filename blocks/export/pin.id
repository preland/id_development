// What a later stage is known to leave behind. A line that sets a variable of
// the program (NAME_set(VALUE);) to a literal is a fact the stage's cases can
// pin: after the stage the variable reads that literal. exporter_set_name and
// exporter_set_value take such a line apart (the name is empty for any other
// line) and exporter_digits says whether a text is a number.

exporter_set_name(string exporter_text_line) {
  int exporter_number_at = str_find(exporter_text_line, "_set(");
  string exporter_text_name = "";
  if (exporter_number_at > 2 && str_starts(exporter_text_line, "  ") && str_ends(exporter_text_line, ");")) {
    exporter_text_name = str_sub(exporter_text_line, 2, exporter_number_at - 2);
  }
} chain (string exporter_text_line) {
  if (list_string_index((import model_variable_names), exporter_text_name) < 0) {
    exporter_text_name = "";
  }
} return string exporter_text_name;
given model_load("t.blk", "sprite S\nvar int n") ("  n_set(2);"):("n")
given model_load("t.blk", "sprite S\nvar int n") ("  m_set(2);"):("")
given model_load("t.blk", "sprite S\nvar int n") ("    n_set(2);"):("")
given model_load("t.blk", "sprite S\nvar int n") ("  say(\"S\", \"y\");"):("")

exporter_set_value(string exporter_text_line) {
  int exporter_number_at = str_find(exporter_text_line, "_set(");
  string exporter_text_value = "";
  if (exporter_number_at >= 0) {
    exporter_text_value = str_sub(exporter_text_line, exporter_number_at + 5, len(exporter_text_line) - exporter_number_at - 7);
  }
} return string exporter_text_value;
("  n_set(2);"):("2")
("  words_set(\"a b\");"):("\"a b\"")
("  say(\"S\", \"y\");"):("")

exporter_digits(string exporter_text_value) {
  int exporter_number_all = len(exporter_text_value) > 0;
  int exporter_number_at = 0;
  while (exporter_number_at < len(exporter_text_value)) {
    exporter_number_all = exporter_number_all * (charat(exporter_text_value, exporter_number_at) >= 46 && charat(exporter_text_value, exporter_number_at) <= 57 && charat(exporter_text_value, exporter_number_at) != 47);
    exporter_number_at = exporter_number_at + 1;
  }
} return int exporter_number_all;
("12"):(1)
("2.5"):(1)
("n + 1"):(0)
(""):(0)
("1234567890123456"):(1)[time:O(n), mem:O(1)]
("12345678"):(1)[time:O(n), mem:O(1)]
