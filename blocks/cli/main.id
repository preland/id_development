// The command line. bkx_main is main without the process around it: it
// answers the exit status. 'run FILE [--frames N]' runs a program, 'check
// FILE' reports the rule violations in it, 'test FILE' runs the test cases of
// every function, 'edit FILE' opens the block editor (cli/edit.id, cli/script.id)
// and 'render FILE OUT' draws it. Anything else prints the usage and answers 2.

command_dispatch(string block_command_word, string block_path, string[] block_argument_values) {
  int block_state = 2;
  if (block_command_word == "run") {
    block_state = command_run(block_path, command_frames(block_argument_values));
  }
  if (block_command_word == "check") {
    block_state = command_check(block_path);
  }
} chain (string block_command_word, string block_path, string[] block_argument_values) {
  if (block_command_word == "test") {
    block_state = command_test(block_path);
  }
  if (block_command_word == "edit") {
    block_state = command_edit(block_path, command_option_value(block_argument_values, "--script", ""), block_argument_values);
  }
  if (block_command_word == "render") {
    block_state = command_render(block_path, block_argument_values);
  }
} chain (string block_command_word, string block_path, string[] block_argument_values) {
  if (block_command_word == "export") {
    block_state = command_export(block_path, block_argument_values);
  }
  if (block_state == 2 && list_string_index((import constant_commands), block_command_word) < 0) {
    eprint((import constant_usage));
  }
} return int block_state;
("bogus", "x.blk", ["blocks"]):(2) then eprints:("usage: blocks run FILE.blk [--frames N] | blocks check FILE.blk | blocks test FILE.blk | blocks edit FILE.blk [--script S.txt [--dump] [--boxes] [--render-after OUT.ppm]] | blocks render FILE.blk OUT.ppm [--size W H] | blocks export FILE.blk OUTDIR\n")
("check", "/nonexistent/none.blk", ["blocks"]):(2) then eprints:("blocks: cannot read /nonexistent/none.blk, or it is empty\n")
("edit", "/nonexistent/none.blk", ["blocks", "edit", "/nonexistent/none.blk"]):(2) then eprints:("blocks: cannot read /nonexistent/none.blk, or it is empty\n")
("render", "x.blk", ["blocks", "render", "x.blk"]):(2) then eprints:("blocks: render needs a .blk file that can be read and the picture to write: blocks render FILE.blk OUT.ppm [--size W H] [x.blk]\n")

command_main(int block_argument_count, string[] block_argument_values) {
  int block_state = 2;
  if (block_argument_count >= 3) {
    block_state = command_dispatch(block_argument_values[1], block_argument_values[2], block_argument_values);
  } else {
    eprint((import constant_usage));
  }
} return int block_state;
(1, ["blocks"]):(2) then eprints:("usage: blocks run FILE.blk [--frames N] | blocks check FILE.blk | blocks test FILE.blk | blocks edit FILE.blk [--script S.txt [--dump] [--boxes] [--render-after OUT.ppm]] | blocks render FILE.blk OUT.ppm [--size W H] | blocks export FILE.blk OUTDIR\n")
(3, ["blocks", "check", "/nonexistent/none.blk"]):(2) then eprints:("blocks: cannot read /nonexistent/none.blk, or it is empty\n")
