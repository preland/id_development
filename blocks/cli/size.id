// The --size W H option of `blocks render`: the window's size in the state of the
// session, when the option is there with both numbers.

command_resize(int[][] editor_matrix_session, string[] block_argument_values) {
  int block_index = list_string_index(block_argument_values, "--size");
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  if (block_index >= 0 && block_index + 2 < len(block_argument_values)) {
    bel_state[(import graph_view_state_width)] = to_int(block_argument_values[block_index + 1]);
    bel_state[(import graph_view_state_height)] = to_int(block_argument_values[block_index + 2]);
  }
} return void;
