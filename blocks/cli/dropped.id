// The cases of command_taken make a scratch directory with fs_mktemp; this
// removes it afterwards so a run leaves nothing behind in the temp directory.

command_taken_drop() {
  int block_dropped = exec_drop((import command_taken_path));
  block_dropped = block_dropped + fs_exists((import command_taken_path));
} return int block_dropped;
given command_taken_setup ("conf.id") ():(1)
given command_taken_setup ("other.id") ():(1)
