// The 'export' command: load the program, apply the rules, and write it as an
// id project under the directory named after the file (export/). Its status
// is 2 when the file cannot be read or the directory is missing from the
// command line, 1 for rule violations or a file that could not be written.

command_export(string block_path, string[] block_argument_values) {
  int block_state = 2;
  if (len(block_argument_values) >= 4) {
    block_state = command_load(block_path);
  } else {
    eprint((import constant_usage));
  }
} chain (string block_path, string[] block_argument_values) {
  if (block_state == 0) {
    block_state = command_report();
  }
  if (block_state == 0 && command_taken(block_argument_values[3]) == 1) {
    eprint("blocks: " + block_argument_values[3] + " already holds conf.id, so it is an earlier export or another project; export into a new directory\n");
    block_state = 2;
  }
  if (block_state == 0) {
    block_state = exporter_run(block_argument_values[3]);
  }
} return int block_state;
