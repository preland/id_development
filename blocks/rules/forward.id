// E0406 for a whole function: one that is no more than a call of another
// function of the program, with its own parameters in the same order and the
// same return type, says nothing the target does not. main and a script that
// runs on a message are left alone (a script is started by the scheduler, so
// it may be read as a function value, which idc exempts). checker_forwarded
// names the callee of a one-line body, checker_forwarder reports the function.

checker_forwarded(int block_function_row) {
  string block_line = string_trim((import model_line_texts)[(import model_function_body_start)[block_function_row]]);
  int block_parenthesis = string_find(block_line, "(");
  string block_callee = "";
} chain (int block_function_row) {
  if (block_parenthesis > 0 && block_line == str_sub(block_line, 0, block_parenthesis) + "(" + exporter_names(block_function_row, 0) + ")") {
    block_callee = str_sub(block_line, 0, block_parenthesis);
  }
} return string block_callee;
given model_load("t.blk", "sprite S\nfn a(int x, int y) return void\n  b(x, y)\nfn b(int x, int y) return void\n  say(\"z\")") (0):("b")
given model_load("t.blk", "sprite S\nfn a(int x, int y) return void\n  b(y, x)\nfn b(int x, int y) return void\n  say(\"z\")") (0):("")
given model_load("t.blk", "sprite S\nfn a() return void\n  b()\nfn b() return void\n  say(\"z\")") (0):("b")

checker_forwarder(int block_function_row) {
  string block_callee = "";
  int block_target = -1;
  if ((import model_function_body_end)[block_function_row] - (import model_function_body_start)[block_function_row] == 1 && (import model_function_names)[block_function_row] != "main" && (import model_function_message)[block_function_row] == "") {
    block_callee = checker_forwarded(block_function_row);
  }
} chain (int block_function_row) {
  block_target = list_string_index((import model_function_names), block_callee);
  string block_name = (import model_function_names)[block_function_row];
  if (block_callee != "" && block_target >= 0 && block_target != block_function_row && (import model_function_return_types)[block_target] == (import model_function_return_types)[block_function_row]) {
    model_error((import model_line_numbers)[(import model_function_body_start)[block_function_row]], "E0406", "function '" + block_name + "' only calls '" + block_callee + "' with its own parameters, a pure forwarder; delete '" + block_name + "' and call '" + block_callee + "' where it was called");
  }
} return void;
given model_load("t.blk", "sprite S\nfn a(int x) return void\n  b(x)\nfn b(int x) return void\n  say(\"z\")") (0):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn a(int x) return void\n  b(x)\n  b(x)\nfn b(int x) return void\n  say(\"z\")") (0):() then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nfn a(int x) return void\n  b(x)\nfn b(int x) return int\n  return x") (0):() then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  main(argc, argv)") (0):() then len((import model_diagnostics)):(0)
