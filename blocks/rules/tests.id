// E0501 and E0502: every function needs two test cases, and no two of a
// function's cases may be the same. Cases are compared with their spaces
// removed, as id compares them as tokens, so spacing cannot make one differ.

checker_case_total(int[] block_cell_x, int block_function_row) {
  int block_count = 0;
  int block_character = 0;
  while (block_character < len(block_cell_x)) {
    block_count = block_count + (block_cell_x[block_character] == block_function_row);
    block_character = block_character + 1;
  }
} return int block_count;
given model_load("t.blk", "sprite S\nfn a() return void\n(1):()\n(2):()\nfn b() return void\n(1):()\n(2):()\n(3):()") ((import model_can), 0):(2)
given model_load("t.blk", "sprite S\nfn a() return void\n(1):()\n(2):()\nfn b() return void\n(1):()\n(2):()\n(3):()") ((import model_can), 1):(3)

checker_function_cases(int block_function_row) {
  int block_count = checker_case_total((import model_can), block_function_row);
  if (block_count < (import constant_minimum_cases)) {
    model_error((import model_function_line)[block_function_row], "E0501", "function '" + (import model_function_names)[block_function_row] + "' has " + block_count + " test case(s); at least " + (import constant_minimum_cases) + " are required");
  }
} return void;
given model_load("t.blk", "sprite S\nfn a() return void\n(1):()") (0):() then (import model_diagnostics):(["t.blk:2: error: function 'a' has 1 test case(s); at least 2 are required [E0501]"])
