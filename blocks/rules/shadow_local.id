// The local half of E0309: every body line that starts with a type declares a
// local ('int n = 0', 'string[] words = []'); its name is checked against the
// program's variables the way a parameter's is.

checker_shadow_line(int block_line_index) {
  string[] block_texts = lexer_tokens((import model_line_texts)[block_line_index]);
  int block_type = model_type(block_texts, 0);
  string block_name_text = list_string_get_or(block_texts, 1 + (block_type > 3) * 2, "");
} chain (int block_line_index) {
  if (block_type > 0 && (import model_line_indents)[block_line_index] > 0 && model_is_name(block_name_text) == 1) {
    checker_shadow((import model_line_numbers)[block_line_index], block_name_text, "local");
  }
} return void;
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\n  int n = 0") (3):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\n  int m = 0") (3):() then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\n  int[] n = []") (3):() then len((import model_diagnostics)):(1)

checker_shadow_locals() {
  int block_line_index = 0;
  while (block_line_index < len((import model_line_numbers))) {
    checker_shadow_line(block_line_index);
    block_line_index = block_line_index + 1;
  }
} return void;
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\n  int n = 0\n  int n = 1") ():() then len((import model_diagnostics)):(2)
given model_load("t.blk", "sprite S\nvar int n\nfn f() return void\n  n = 1") ():() then len((import model_diagnostics)):(0)
