// The rest of E0303's walk: every function's parameters, and every local
// declaration, which is a body line that starts with a type ('int n = 0' or
// 'string[] words = []'). bkc_names runs the three walks over one pair of
// lists and so reports a clash wherever the two uses are.

checker_parameters(string[] block_name_number, int[] block_note_text) {
  int block_function_row = 0;
  while (block_function_row < len((import model_function_names))) {
    checker_function_parameters(block_name_number, block_note_text, block_function_row);
    block_function_row = block_function_row + 1;
  }
} return void;
given model_load("t.blk", "sprite S\nfn f(int a) return void\nfn g(string a) return void") ([], []):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn f(int a) return void\nfn g(int a) return void") ([], []):(["a"], [1]) then len((import model_diagnostics)):(0)

checker_local(string[] block_name_number, int[] block_note_text, int block_line_index) {
  string[] block_texts = lexer_tokens((import model_line_texts)[block_line_index]);
  int block_type = model_type(block_texts, 0);
  string block_name_text = list_string_get_or(block_texts, 1 + (block_type > 3) * 2, "");
} chain (string[] block_name_number, int[] block_note_text, int block_line_index) {
  if (block_type > 0 && (import model_line_indents)[block_line_index] > 0 && model_is_name(block_name_text) == 1) {
    checker_note(block_name_number, block_note_text, block_name_text, block_type, (import model_line_numbers)[block_line_index]);
  }
} return void;
given model_load("t.blk", "sprite S\nfn f() return void\n  int n = 0\n  string n = \"\"") (["n"], [1], 3):() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nfn f() return void\n  int n = 0\n  n = 1") ([], [], 3):([], [], 3) then len((import model_diagnostics)):(0)
given model_load("t.blk", "sprite S\nfn f() return void\n  int[] xs = []") ([], [], 2):(["xs"], [4], 2)

checker_names() {
  string[] block_name_number = [];
  int[] block_note_text = [];
  checker_variables(block_name_number, block_note_text);
} chain () {
  checker_parameters(block_name_number, block_note_text);
  int block_line_index = 0;
  while (block_line_index < len((import model_line_numbers))) {
    checker_local(block_name_number, block_note_text, block_line_index);
    block_line_index = block_line_index + 1;
  }
} return void;
given model_load("t.blk", "sprite S\nvar int a\nfn f() return void\n  float a = 1.0") ():() then len((import model_diagnostics)):(1)
given model_load("t.blk", "sprite S\nvar int a\nfn f(int b) return void\n  int c = 1") ():() then len((import model_diagnostics)):(0)
