// Reading a type from tokens: int, float, string or void, then optionally []
// to make a list of it. The answer is conf.id's bkk_ty_ code, or -1 when the
// token is no type or the type is void[]. Whether a token can be a name is
// here too, since a type is always followed by one.

model_type(string[] block_texts, int block_position_index) {
  int block_type = list_string_index((import constant_type_names), list_string_get_or(block_texts, block_position_index, ""));
  int block_line_number = 0;
  if (list_string_get_or(block_texts, block_position_index + 1, "") == "[" && list_string_get_or(block_texts, block_position_index + 2, "") == "]") {
    block_line_number = 1;
  }
} chain (string[] block_texts, int block_position_index) {
  if (block_line_number == 1 && block_type > 0) {
    block_type = block_type + (import constant_type_list);
  } else if (block_line_number == 1) {
    block_type = 0 - 1;
  }
} return int block_type;
(["int"], 0):(1)
(["x", "float", "[", "]"], 1):(5)
(["string", "[", "]"], 0):(6)
(["void", "[", "]"], 0):(-1)
(["void"], 0):(0)
(["bool"], 0):(-1)
([], 0):(-1)

model_is_name(string block_token) {
  int block_ok = 0;
  if (lexer_class(character_code_at(block_token, 0)) == (import constant_class_word)) {
    block_ok = 1;
  }
} return int block_ok;
("abc"):(1)
("_x1"):(1)
("1x"):(0)
("("):(0)
(""):(0)
