// The parameter list of a function header. bkm_want checks one expected
// token and reports E0101 when it is missing; bkm_param reads one 'TYPE
// NAME' and the comma after it; bkm_params reads them until the closing
// parenthesis. A parameter that cannot be read answers the end of the line,
// which stops the loop, and has already been reported.

model_want(string[] block_texts, int block_position_index, string block_token, int block_line_index) {
  int block_ok = 1;
  string block_got = lst_str_get_or(block_texts, block_position_index, "end of line");
  if (block_got != block_token) {
    block_ok = 0;
    model_error((import model_line_numbers)[block_line_index], "E0101", "expected '" + block_token + "', found '" + block_got + "'");
  }
} return int block_ok;
given model_initial given model_lines("fn") (["fn", "f"], 2, "(", 0):(0) then (import model_diagnostics):(["input.blk:1: error: expected '(', found 'end of line' [E0101]"])
given model_initial given model_lines("fn") (["fn", "f", "("], 2, "(", 0):(1) then len((import model_diagnostics)):(0)
given model_initial given model_lines("fn") (["fn", "f", "x"], 2, "(", 0):(0) then (import model_diagnostics):(["input.blk:1: error: expected '(', found 'x' [E0101]"])

model_parameter(string[] block_texts, int block_position_index, int block_line_index) {
  int block_type = model_type(block_texts, block_position_index);
  int block_at = block_position_index + 1 + (block_type > 3) * 2;
  string block_name_text = lst_str_get_or(block_texts, block_at, "");
} chain (string[] block_texts, int block_position_index, int block_line_index) {
  int block_next_index = len(block_texts);
  if (block_type > 0 && model_is_name(block_name_text) == 1) {
    push((import model_pan), block_name_text);
    push((import model_pat), block_type);
    block_next_index = block_at + 1;
  } else {
    model_error((import model_line_numbers)[block_line_index], "E0102", "expected 'TYPE NAME' for a parameter, found '" + lst_str_get_or(block_texts, block_position_index, "end of line") + "'");
  }
} chain (string[] block_texts, int block_position_index, int block_line_index) {
  if (lst_str_get_or(block_texts, block_next_index, "") == ",") {
    block_next_index = block_next_index + 1;
  }
} return int block_next_index;
given model_initial given model_lines("x") (["int", "n", ",", "float", "f"], 0, 0):(3) then (import model_pan):(["n"]) then (import model_pat):([1])
given model_initial given model_lines("x") (["int", "n", ",", "float", "f"], 3, 0):(5) then (import model_pan):(["f"]) then (import model_pat):([2])
given model_initial given model_lines("x") (["string", "[", "]", "xs", ")"], 0, 0):(4) then (import model_pat):([6])
given model_initial given model_lines("x") (["wat", "n"], 0, 0):(2) then len((import model_pan)):(0) then (import model_diagnostics):(["input.blk:1: error: expected 'TYPE NAME' for a parameter, found 'wat' [E0102]"])

model_parameters(string[] block_texts, int block_position_index, int block_line_index) {
  while (lst_str_get_or(block_texts, block_position_index, ")") != ")") {
    block_position_index = model_parameter(block_texts, block_position_index, block_line_index);
  }
} return int block_position_index;
