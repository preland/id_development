given model_initial given model_lines("x\ny") (1):() then len((import model_diagnostics)):(1)

model_case(int block_line_index) {
  int block_function_number = len((import model_function_names));
  if (block_function_number == 0) {
    model_error((import model_line_numbers)[block_line_index], "E0102", "a test case belongs to a function; write it under the function it tests");
  } else {
    push((import model_can), block_function_number - 1);
    push((import model_case_lines), (import model_line_numbers)[block_line_index]);
    push((import model_cat), (import model_line_texts)[block_line_index]);
  }
} return void;
