model_body(int block_line_index) {
  int block_function_number = len((import model_function_names));
  if (block_function_number == 0) {
    model_error((import model_line_numbers)[block_line_index], "E0102", "an indented line belongs to a function; declare one with 'fn NAME(...) return TYPE' first");
  } else {
    lset((import model_function_body_end), block_function_number - 1, block_line_index + 1);
  }
} return void;
