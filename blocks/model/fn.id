// A function header line becomes a function row and its parameter rows. The
// body lines that follow are attached one by one by bkm_body, and the cases
// under the body by bkm_case; both belong to the last function declared.

model_function(string[] block_texts, int block_line_index) {
  int block_position_origin = len((import model_pan));
  int block_ok = model_want(block_texts, 2, "(", block_line_index);
  int block_position_index = 3;
} chain (string[] block_texts, int block_line_index) {
  if (block_ok == 1) {
    block_position_index = model_parameters(block_texts, 3, block_line_index);
  }
  int block_return_type = 0 - 2;
  if (block_ok == 1) {
    block_return_type = model_return_type_name(block_texts, block_position_index, block_line_index);
  }
} chain (string[] block_texts, int block_line_index) {
  if (block_return_type >= 0 && model_is_name(lst_str_get_or(block_texts, 1, "")) == 1 && len((import model_sprite_names)) > 0) {
    model_add_function(block_texts, block_line_index, block_return_type, block_position_origin);
  } else if (block_return_type >= 0) {
    model_error((import model_line_numbers)[block_line_index], "E0102", "expected 'fn NAME(...) return TYPE' inside a sprite");
  }
} return void;
