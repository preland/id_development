// A function header: 'fn NAME(TYPE NAME, ...) return TYPE', optionally
// followed by 'on "message"' to make the function the script that runs when
// that message is broadcast. bkm_rtype checks everything after the last
// parameter and answers the return type code, -1 when the type is wrong (and
// reported) or -2 when a token before it was missing (already reported).

model_event(string[] block_texts) {
  int block_count = len(block_texts);
  string block_message = "";
  if (block_count >= 2 && block_texts[block_count - 2] == "on") {
    block_message = lexer_unquote(block_texts[block_count - 1]);
  }
} return string block_message;
(["fn", "f", "(", ")", "return", "void", "on", "\"go\""]):("go")
(["fn", "f", "(", ")", "return", "void"]):("")
(["on"]):("")

model_return_type_name(string[] block_texts, int block_position_index, int block_line_index) {
  int block_return_type = 0 - 2;
  if (model_want(block_texts, block_position_index, ")", block_line_index) == 1 && model_want(block_texts, block_position_index + 1, "return", block_line_index) == 1) {
    block_return_type = model_type(block_texts, block_position_index + 2);
  }
  if (block_return_type == 0 - 1) {
    model_error((import model_line_numbers)[block_line_index], "E0102", "expected a return type (void, int, float, string or a list of one), found '" + list_string_get_or(block_texts, block_position_index + 2, "end of line") + "'");
  }
} chain (string[] block_texts, int block_position_index, int block_line_index) {
  int block_end = block_position_index + 3 + (block_return_type > 3) * 2;
  string block_tail = list_string_get_or(block_texts, block_end, "");
  if (block_return_type >= 0 && block_tail != "" && (block_tail != "on" || len(block_texts) != block_end + 2)) {
    model_error((import model_line_numbers)[block_line_index], "E0102", "expected the end of the line or 'on \"message\"' after the return type, found '" + block_tail + "'");
  }
} return int block_return_type;
