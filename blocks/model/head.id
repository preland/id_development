model_add_function(string[] block_texts, int block_line_index, int block_return_type, int block_position_origin) {
  push((import model_function_names), block_texts[1]);
  push((import model_function_sprites), len((import model_sprite_names)) - 1);
  push((import model_function_return_types), block_return_type);
} chain (string[] block_texts, int block_line_index, int block_return_type, int block_position_origin) {
  push((import model_function_message), model_event(block_texts));
  push((import model_function_line), (import model_line_numbers)[block_line_index]);
  push((import model_function_body_start), block_line_index + 1);
} chain (string[] block_texts, int block_line_index, int block_return_type, int block_position_origin) {
  push((import model_function_body_end), block_line_index + 1);
  push((import model_function_parameter_start), block_position_origin);
  push((import model_function_parameter_count), len((import model_pan)) - block_position_origin);
} return void;
