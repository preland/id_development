// The diagnostics as one text, one per line, for the cases of every function
// that reports one (its 'then' check names this: a case cannot read the list
// of a function that only reaches it through a callee).

model_diagnostic_list() {
  string block_text = string_join((import model_diagnostics), "\n");
} return string block_text;
given model_initial ():("")
given model_initial given model_error(2, "E0101", "x") given model_error(5, "E0102", "y") ():("input.blk:2: error: x [E0101]\ninput.blk:5: error: y [E0102]")
