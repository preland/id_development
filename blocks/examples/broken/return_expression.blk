// A return names a variable or a literal, never an expression (idc gives the
// mistake no code, only its message): set a variable on the line before and
// return it. pick returns an expression twice, once nested and once last.
sprite Early

fn pick(int n) return int
  int total = 0
  if n > 0
    total = total + n
    return total + 100
  return total * 2
(3): (103)
(0): (0)

fn main(int argc, string[] argv) return int
  int shown = pick(argc)
  say(int_to_str(shown))
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)
