// E0203: a sprite's page holds at most three functions; this one has four.
// The fourth belongs on another sprite's page.
sprite Cat
var int n

fn reset() return void
  n = 1
(): () then n: (1)
given n = 5 (): () then n: (1)

fn grow() return void
  n = n + 1
(): () then n: (1)
given n = 5 (): () then n: (6)

fn shrink() return void
  n = n - 1
(): () then n: (-1)
given n = 5 (): () then n: (4)

fn double() return void
  n = n * 2
(): () then n: (0)
given n = 5 (): () then n: (10)
