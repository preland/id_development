// E0402: twice does exactly what double does, with other names for its
// parameter and its local; one of them should go and the other be called.
sprite Cat
fn double(int a) return int
  int r = a * 2
  return r
(2): (4)
(3): (6)

fn twice(int x) return int
  int y = x * 2
  return y
(2): (4)
(5): (10)
