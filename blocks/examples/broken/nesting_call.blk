// Call nesting (docs/SPEC.md 7.1, idc gives it no code): say(f(g(x))) holds a
// call inside a call inside a call. Name the inner result first.
sprite Cat
var int n

fn twice(int x) return int
  return x
(1): (1)
(2): (2)

fn main(int argc, string[] argv) return int
  say(int_to_str(twice(twice(n))))
  return 0
(1, ["blocks"]): (0)
(2, ["blocks"]): (0)
