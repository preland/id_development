// E0201: the exported main starts with variables_start(), so the else, the
// third action of main, would open a chain segment apart from its if. Make the
// if and else the first two actions, or move them into a function.
sprite Cat
var int n

fn main(int argc, string[] argv) return int
  n = 1
  if n > 0
    say("a")
  else
    say("b")
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)
