// An empty list as an argument and as a local assignment. total counts a
// list, main passes an empty one and then empties a local it filled.
sprite Empty

fn total(int[] xs) return int
  int n = len(xs) * 2
  return n
([1, 2]): (4)
([]): (0)

fn main(int argc, string[] argv) return int
  int[] ys = [4, 5, 6]
  ys = []
  int r = total([]) + total(ys)
  return r
(1, ["blocks"]): (0)
(2, ["blocks"]): (0)
