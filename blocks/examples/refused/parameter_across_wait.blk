// Export refuses: the parameter argc of main is used after the wait.
sprite S
var int heard

fn main(int argc, string[] argv) return int
  broadcast("go")
  wait(1.0)
  heard = argc
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)

fn a() return void on "go"
  say("x")
(): ()
given heard = 4 (): ()
