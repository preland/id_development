// A function that returns an expression from inside an if body that already
// holds three actions. The export would name the value on a line of its own
// before the return, a fourth action, so the export is refused.
sprite Early

fn pick(int n) return int
  int total = 0
  if n > 0
    total = total + n
    total = total * 2
    total = total + 1
    return total + 100
  return total
(3): (107)
(0): (0)

fn main(int argc, string[] argv) return int
  int first = pick(3)
  int second = pick(0)
  say(int_to_str(first + second))
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)
