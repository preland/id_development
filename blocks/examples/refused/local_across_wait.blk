// Export refuses: the local n lives across the wait.
sprite S
var int heard
var string msg

fn main(int argc, string[] argv) return int
  broadcast("go")
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)

fn a() return void on "go"
  int n = heard
  wait(1.0)
  heard = n + 1
(): () then heard: (1)
given heard = 4 (): () then heard: (5)
