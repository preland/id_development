// Export refuses: the wait is inside an if, not on the script top level.
sprite S
var int heard
var string msg

fn main(int argc, string[] argv) return int
  broadcast("go")
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)

fn a() return void on "go"
  heard = heard + 1
  if heard > 0
    wait(1.0)
  say("x")
(): () then heard: (1)
given heard = 4 (): () then heard: (5)
