// A function that returns from inside an if body. A return names a variable
// or a literal, so the value is set on the line before and the return names
// it; the helper keeps the body within three actions.
sprite Early

fn scaled(int n) return int
  int total = n * 2
  total = total + 1
  return total
(3): (7)
(0): (1)

fn pick(int n) return int
  int total = 0
  if n > 0
    total = scaled(n)
    total = total + 100
    return total
  return total
(3): (107)
(0): (0)

fn main(int argc, string[] argv) return int
  int first = pick(3)
  int second = pick(0)
  say(int_to_str(first + second))
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0)
