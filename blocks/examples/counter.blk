// A counter. bump is a custom block with two cases; tally calls it in a loop
// and records each count in a list; main runs tally and says the total.
// Every body holds at most three actions per block, which is why the loop
// body is exactly three lines.
sprite Counter
var int count
var int[] history

fn bump(int by) return int
  count = count + by
  int total = count
  return total
(1): (1)
given count = 10 (5): (15) then count: (15)

fn tally(int n) return void
  int i = 0
  while i < n
    bump(1)
    push(history, count)
    i = i + 1
(3): () then count: (3) then history: ([1, 2, 3])
(0): () then count: (0) then history: ([])

fn main(int argc, string[] argv) return int
  tally(5)
  say(int_to_str(count))
  return 0
(1, ["blocks"]): (0)
(2, ["blocks", "x"]): (0) then count: (5)
