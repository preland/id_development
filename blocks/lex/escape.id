// A string token back to the text it stands for: the quotes come off, \n
// becomes a newline and any other backslash pair becomes its second
// character, so \" and \\ are a quote and a backslash.

lexer_inner(string block_token) {
  int block_count = len(block_token);
  if (block_count >= 2 && character_code_at(block_token, block_count - 1) == 34) {
    block_count = block_count - 1;
  }
} return int block_count;
("\"ab\""):(3)
("\"ab"):(3)
("\""):(1)

lexer_decode_escape(string block_token, int block_index) {
  string block_character_code = chr(character_code_at(block_token, block_index));
  if (character_code_at(block_token, block_index) == 92) {
    block_character_code = chr(character_code_at(block_token, block_index + 1));
  }
  if (character_code_at(block_token, block_index) == 92 && character_code_at(block_token, block_index + 1) == 110) {
    block_character_code = "\n";
  }
} return string block_character_code;
("a\\nb", 1):("\n")
("a\\\"b", 1):("\"")
("abc", 1):("b")

lexer_unquote(string block_token) {
  string block_out = "";
  int block_index = 1;
  int block_count = lexer_inner(block_token);
} chain (string block_token) {
  while (block_index < block_count) {
    block_out = block_out + lexer_decode_escape(block_token, block_index);
    block_index = block_index + 1 + (character_code_at(block_token, block_index) == 92);
  }
} return string block_out;
("\"hi there\""):("hi there")
("\"a\\nb\""):("a\nb")
("\"q\\\"q\""):("q\"q")
("\"\""):("")
