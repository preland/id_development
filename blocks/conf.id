int constant_sub_not_equal = 10;
// The statements a line may start with, by position: if, while and else open
// or continue a block, break and return leave one, the three types begin a
// declaration. Anything else is an assignment or a call.
string[] constant_statement = ["if", "while", "else", "break", "return", "int", "float", "string"];
int constant_statement_no_breaks = 0 - 1;
string[] constant_assign = ["=", "[", "("];
// The value a variable starts with when its declaration gives none, by type
// code (source text, compiled like any initializer).
string[] constant_defaults = ["", "0", "0.0", "\"\"", "[]", "[]", "[]"];
string constant_system = "__sys";
string constant_initial_function = "__init";
string constant_flag_function = "__flag";
// The virtual machine. Every value is a float in a slot of the value stack
// (an int is a whole float, a string an index into the string pool, a list an
// index into the list pool); the compiler knows which, the machine does not.
// Each thread owns bkk_stack_n slots of bkv_vl and bkk_depth_n frames of
// bkk_frame slots in them, and bkk_cs_cell cells of the call stack bkv_cs per
// frame (the return pc, the caller's frame pointer, the slot the result goes
// to). A thread's row of bkv_th has bkk_th_n cells: the next pc, the frame
// pointer, the call depth, its state, the millisecond it wakes, its sprite.
int constant_depth_count = 32;
int constant_stack_count = 4096;
int constant_call_stack_cell = 3;
int constant_call_stack_count = 96;
int constant_maximum_thread = 16;
int constant_thread_count = 6;
int constant_thread_entry_counter = 0;
int constant_thread_frame_pointer = 1;
int constant_thread_data_pointer = 2;
int constant_thread_state = 3;
int constant_thread_wake = 4;
int constant_thread_stack_pointer = 5;
int constant_statement_free = 0;
int constant_statement_ready = 1;
int constant_statement_sleep = 2;
int constant_frame_milliseconds = 33;
// bkv_rg: the clock in milliseconds, the number of runtime errors, the number
// of frames run.
int constant_registers_now = 0;
int constant_registers_error = 1;
int constant_registers_frames = 2;
// A sprite's row of bkv_sx: position, direction in degrees (90 is right, 0
// is up), size in percent, visible (1 or 0), the string-pool index of what it
// last said (-1 for nothing).
int constant_sprite_count = 6;
int constant_sprite_x = 0;
int constant_sprite_y = 1;
int constant_sprite_direction = 2;
int constant_sprite_size = 3;
int constant_sprite_visible = 4;
int constant_sprite_say = 5;
float[] constant_sprite_initial = [0.0, 0.0, 90.0, 100.0, 1.0, -1.0];
// What a handler answers besides the next pc: -1 to yield, -2 when the thread
// has finished, and, from bkk_r_trap down, a runtime error whose number is
// the distance below it.
int constant_result_yield = 0 - 1;
int constant_result_done = 0 - 2;
int constant_result_trap = 0 - 10;
string[] constant_trap_message = ["", "division by zero", "remainder by zero", "list index out of bounds", "pop from an empty list", "text span out of bounds", "calls nested too deep", "no such list"];
// The classes of instruction the machine dispatches on, by opcode: moves,
