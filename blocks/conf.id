int constant_opcode_float_operation = 6;
int constant_opcode_string_operation = 7;
int constant_opcode_jump = 8;
int constant_opcode_jump_zero = 9;
int constant_opcode_jump_nonzero = 10;
int constant_opcode_call = 11;
int constant_opcode_return_type = 12;
int constant_opcode_yield = 13;
int constant_opcode_builtin = 14;
int constant_opcode_list_get = 15;
int constant_opcode_list_set = 16;
