float constant_turn = 360.0;
int constant_frames_default = 600;
int constant_case_frames = 2000;
string constant_usage = "usage: blocks run FILE.blk [--frames N] | blocks check FILE.blk | blocks test FILE.blk | blocks edit FILE.blk [--script S.txt [--dump] [--boxes] [--render-after OUT.ppm]] | blocks render FILE.blk OUT.ppm [--size W H] | blocks export FILE.blk OUTDIR";
string constant_prefix_system = "__";
