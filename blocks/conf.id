// Constants of the block tool. Every one is named bkk_ so that no local
// (bk_) or function (bkl_, bkm_, bkc_, bkg_, bkv_, bkr_, bkx_) can collide
// with it. The lexer's character classes first, then the rest as the modules
// that read them need them.
int constant_class_end = 0;
int constant_class_word = 1;
int constant_class_number = 2;
int constant_class_string = 3;
int constant_class_operation = 4;
string constant_pairs = " == != <= >= && || ";
// Type codes. A list type is its element type plus three, so the element of
// a list is found by subtracting bkk_ty_lst; void exists only as a return type.
int constant_type_void = 0;
int constant_type_integer = 1;
int constant_type_float = 2;
int constant_type_string = 3;
int constant_type_integer_list = 4;
int constant_type_float_list = 5;
int constant_type_string_list = 6;
int constant_type_list = 3;
string[] constant_type_names = ["void", "int", "float", "string"];
// The words a column-0 line may start with in a .blk file.
string constant_heads = " sprite var fn ( given ";
// Words the rule checker treats specially: statements that cost no action,
// and the statements that open a nested block.
string[] constant_free = ["return", "break"];
string[] constant_control = ["if", "while"];
int constant_maximum_actions = 3;
int constant_maximum_depth = 2;
int constant_maximum_functions = 3;
int constant_minimum_cases = 2;
int constant_levels = 16;
string[] constant_type_full = ["void", "int", "float", "string", "int[]", "float[]", "string[]"];
// The instruction set. An instruction is bkk_icell cells in bkg_cd: op, d, a,
// b, x. A pc is the index of its op cell. d is a slot written (or the list
// slot of an lset), a and b are slots read, x is the odd one out: a constant,
// a branch target, a global's number, a function number, a builtin number or
// the sub-operation of an arithmetic op.
int constant_opcode_move = 0;
int constant_opcode_load_integer = 1;
int constant_opcode_load_constant = 2;
int constant_opcode_global_load = 3;
int constant_opcode_global_store = 4;
