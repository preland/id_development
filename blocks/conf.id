int[] constant_operator_class = [0, 0, 0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 4, 5, 6, 7, 8];
int constant_builtin_string_length = 27;
// Which handler a builtin goes to: 0 the sprites and the clock, 1 lists, 2
