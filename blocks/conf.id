string constant_runtime_move = "move(float[] move_states, int move_base, float move_steps) {\n  float move_radians = move_states[move_base + 2] * (import motion_radians);\n  move_states[move_base] = snap_position(move_states[move_base] + move_steps * flt_sin(move_radians));\n  move_states[move_base + 1] = snap_position(move_states[move_base + 1] + move_steps * flt_cos(move_radians));\n} return void;\n([0.0, 0.0, 90.0, 100.0, 1.0, -1.0], 0, 10.0):([10.0, 0.0, 90.0, 100.0, 1.0, -1.0])\n([0.0, 0.0, 0.0, 100.0, 1.0, -1.0], 0, 5.0):([0.0, 5.0, 0.0, 100.0, 1.0, -1.0])\n\nturn(float[] turn_states, int turn_base, float turn_degrees) {\n  turn_states[turn_base + 2] = wrap_degrees(turn_states[turn_base + 2] + turn_degrees);\n} return void;\n([0.0, 0.0, 350.0, 100.0, 1.0, -1.0], 0, 15.0):([0.0, 0.0, 5.0, 100.0, 1.0, -1.0])\n([0.0, 0.0, 90.0, 100.0, 1.0, -1.0], 0, -90.0):([0.0, 0.0, 0.0, 100.0, 1.0, -1.0])\n\npoint(float[] point_states, int point_base, float point_degrees) {\n  point_states[point_base + 2] = wrap_degrees(point_degrees);\n} return void;\n([0.0, 0.0, 90.0, 100.0, 1.0, -1.0], 0, 450.0):([0.0, 0.0, 90.0, 100.0, 1.0, -1.0])\n([0.0, 0.0, 90.0, 100.0, 1.0, -1.0], 0, -90.0):([0.0, 0.0, 270.0, 100.0, 1.0, -1.0])\n";
