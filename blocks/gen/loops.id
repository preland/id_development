  int block_call_stack = generator_condition(block_texts);
  int block_inner = generator_emit((import constant_opcode_jump_zero), 0, block_call_stack, 0, 0);
} chain (string[] block_texts, int block_function_row, int block_line_index, int block_level) {
  int block_old = (import generator_state)[(import constant_statement_breaks)];
  lset((import generator_state), (import constant_statement_breaks), len((import generator_break_stack)));
  int block_next_index = generator_block(block_function_row, block_line_index + 1, block_level + 1);
} chain (string[] block_texts, int block_function_row, int block_line_index, int block_level) {
  generator_wend(block_top, block_inner, block_old);
} return int block_next_index;
