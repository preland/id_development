given model_load("t.blk", "sprite S\nfn f() return void\n  if 1\n    int a = 1\n  else\n    int b = 2") given generator_initial (["if", "1"], 0, 2, 1):(6) then generator_codes:("25:1,0,0,0,1,9,0,0,0,20,1,1,0,0,1,8,0,0,0,25,1,2,0,0,2")

generator_else(int block_function_row, int block_next_index, int block_level, int block_inner) {
  string block_cursor = "";
  if (block_next_index < (import model_function_body_end)[block_function_row] && (import model_line_indents)[block_next_index] == block_level) {
    block_cursor = (import model_line_texts)[block_next_index];
  }
  if (block_cursor == "else") {
    block_next_index = generator_else_block(block_function_row, block_next_index, block_level, block_inner);
  }
} chain (int block_function_row, int block_next_index, int block_level, int block_inner) {
  if (block_cursor != "else") {
    generator_patch(block_inner, len((import generator_code)));
  }
} return int block_next_index;
