// if and else. The condition's jz skips the block when the condition is 0;
// when an else follows at the same indent, a jmp at the end of the if block
// skips the else block and the jz is pointed just after it.

generator_if(string[] block_texts, int block_function_row, int block_line_index, int block_level) {
  int block_call_stack = generator_condition(block_texts);
  int block_inner = generator_emit((import constant_opcode_jump_zero), 0, block_call_stack, 0, 0);
  int block_next_index = generator_block(block_function_row, block_line_index + 1, block_level + 1);
} chain (string[] block_texts, int block_function_row, int block_line_index, int block_level) {
  block_next_index = generator_else(block_function_row, block_next_index, block_level, block_inner);
} return int block_next_index;
