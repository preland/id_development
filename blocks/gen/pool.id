// The constant pools and the local symbol table. A string literal is an
// index into bkg_ks (the same text is stored once), and the runtime starts
// its string pool as a copy of that list, so a string value is always such an
// index. A float literal is an index into bkg_kf. A local is a row of
// bkg_sn/bkg_sl/bkg_sy: name, frame slot, type code; bkg_declare adds one
// (E0302 when the name is already a local of the function).

generator_kind_string(string block_text) {
  int block_height = list_string_index((import generator_string_constants), block_text);
  if (block_height < 0) {
    push((import generator_string_constants), block_text);
    block_height = len((import generator_string_constants)) - 1;
  }
} return int block_height;
given generator_initial given list_string_extend((import generator_string_constants), ["a", "b"]) ("b"):(1) then len((import generator_string_constants)):(2)
given generator_initial given list_string_extend((import generator_string_constants), ["a"]) ("z"):(1) then (import generator_string_constants):(["a", "z"])

generator_kind_float(float block_float_value) {
  push((import generator_float_constants), block_float_value);
  int block_height = len((import generator_float_constants)) - 1;
} return int block_height;
given generator_initial (2.5):(0) then (import generator_float_constants)[0]:(2.5)
given generator_initial (4.25):(0) then len((import generator_float_constants)):(1)

generator_declare(string block_name_text, int block_type, int block_slot) {
  if (list_string_index((import generator_symbol_names), block_name_text) >= 0) {
    generator_error("E0302", "variable '" + block_name_text + "' is declared twice in this function");
  }
  push((import generator_symbol_names), block_name_text);
  push((import generator_symbol_slots), block_slot);
} chain (string block_name_text, int block_type, int block_slot) {
  push((import generator_symbol_types), block_type);
} return void;
