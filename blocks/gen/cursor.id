// Reading the tokens of the line being compiled. The compiler's registers
// (the exported list bkg_st, indexed by conf.id's bkk_st_ names) hold the
// cursor; bkg_eat takes the next token only if it is the one asked for,
// bkg_take takes whatever is next, and bkg_need is bkg_eat that reports
// E0101 when the token is not there. Past the end of the line the next
// token is "".

generator_eat(string[] block_texts, string block_token) {
  int block_ok = 0;
  if (lst_str_get_or(block_texts, (import generator_state)[(import constant_statement_position_index)], "") == block_token) {
    lset((import generator_state), (import constant_statement_position_index), (import generator_state)[(import constant_statement_position_index)] + 1);
    block_ok = 1;
  }
} return int block_ok;
given generator_initial given lset((import generator_state), 0, 1) (["a", ")"], ")"):(1) then (import generator_state)[0]:(2)
given generator_initial (["a", ")"], ")"):(0) then (import generator_state)[0]:(0)
given generator_initial given lset((import generator_state), 0, 1) (["a"], ")"):(0) then (import generator_state)[0]:(1)

generator_take(string[] block_texts) {
  string block_token = lst_str_get_or(block_texts, (import generator_state)[(import constant_statement_position_index)], "");
  lset((import generator_state), (import constant_statement_position_index), (import generator_state)[(import constant_statement_position_index)] + 1);
} return string block_token;
given generator_initial given lset((import generator_state), 0, 1) (["a", "b"]):("b") then (import generator_state)[0]:(2)
given generator_initial given lset((import generator_state), 0, 1) (["a"]):("") then (import generator_state)[0]:(2)

generator_need(string[] block_texts, string block_token) {
  int block_ok = generator_eat(block_texts, block_token);
  if (block_ok == 0) {
    generator_error("E0101", "expected '" + block_token + "', found '" + lst_str_get_or(block_texts, (import generator_state)[(import constant_statement_position_index)], "end of line") + "'");
  }
} return int block_ok;
