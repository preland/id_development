// One function. bkg_ftrow writes its row of the function table (entry pc,
// parameter count, return type, sprite), bkg_regs resets the compiler for it
// and declares its parameters in the first slots, and bkg_fn compiles the
// body as a block at indent level one. bkg_finish ends it: a function that
// returns a value must end with a return (E0602), and every function gets a
// final ret so that control never runs off its code.

generator_function_table_row(int block_function_row) {
  lset((import generator_function_table), block_function_row * (import constant_function_table_count) + (import constant_function_table_entry_counter), len((import generator_code)));
  lset((import generator_function_table), block_function_row * (import constant_function_table_count) + (import constant_function_table_parameter_count), (import model_function_parameter_count)[block_function_row]);
  lset((import generator_function_table), block_function_row * (import constant_function_table_count) + (import constant_function_table_return_type), (import model_function_return_types)[block_function_row]);
} chain (int block_function_row) {
  lset((import generator_function_table), block_function_row * (import constant_function_table_count) + (import constant_function_table_stack_pointer), (import model_function_sprites)[block_function_row]);
} return void;
