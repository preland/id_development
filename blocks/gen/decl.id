  int block_type = model_type(block_texts, 0);
  int block_at = 1 + (block_type > 3) * 2;
  string block_name_text = list_string_get_or(block_texts, block_at, "");
} chain (string[] block_texts) {
  lset((import generator_state), (import constant_statement_position_index), block_at + 1);
  int block_slot = generator_alloc(1);
  generator_need(block_texts, "=");
} chain (string[] block_texts) {
  int block_element_type_code = generator_bin(block_texts, block_slot, block_type, (import constant_prefix_minimum));
  generator_declare(block_name_text, block_type, block_slot);
  generator_check_set(block_name_text, block_type, block_element_type_code);
} chain (string[] block_texts) {
  generator_done(block_texts);
} return void;
