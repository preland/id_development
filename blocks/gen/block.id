// Blocks. A block is the run of body lines at one indent level; a line one
// level deeper belongs to the statement above it. bkg_block compiles lines
// from li while they are at least level lv deep and answers the first line
// that is not, forgetting the locals the block declared when it ends.
// bkg_done reports what is left on a line after its statement (E0102).

generator_trim(int block_count) {
  while (len((import generator_symbol_names)) > block_count) {
    pop((import generator_symbol_names));
    pop((import generator_symbol_slots));
    pop((import generator_symbol_types));
  }
} return void;
