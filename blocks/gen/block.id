generator_block(int block_function_row, int block_line_index, int block_level) {
  int block_mark = len((import generator_symbol_names));
  while (block_line_index < (import model_function_body_end)[block_function_row] && (import model_line_indents)[block_line_index] >= block_level) {
    block_line_index = generator_line(block_function_row, block_line_index, block_level);
  }
  generator_trim(block_mark);
} return int block_line_index;
