// The whole program. bkg_prog compiles the function rows from one on (the
// test runner adds generated functions after the program's own) into the
// code table, first making the function table as long as the rows need.
// Function numbers are model rows, so a call is an instruction naming a row
// and the table is indexed by it.

generator_program(int block_from) {
  int block_function_row = block_from;
  list_fill((import generator_function_table), len((import model_function_names)) * (import constant_function_table_count) - len((import generator_function_table)), 0);
  while (block_function_row < len((import model_function_names))) {
    generator_function(block_function_row);
    block_function_row = block_function_row + 1;
  }
} return void;
