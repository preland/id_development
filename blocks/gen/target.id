// The three kinds of line that start with a name, once the name and the
// token after it are read. bkg_assign dispatches (conf.id's bkk_assign:
// '=', '[', '('); bkg_set assigns a variable; bkg_setelem assigns an element
// of a list variable; bkg_discard is a call used as a statement.

generator_assign(string[] block_texts) {
  string block_name_text = generator_take(block_texts);
  int block_mode = list_string_index((import constant_assign), generator_take(block_texts));
  if (block_mode == 0) {
    generator_set(block_texts, block_name_text);
  }
} chain (string[] block_texts) {
  if (block_mode == 1) {
    generator_set_element(block_texts, block_name_text);
  }
  if (block_mode == 2) {
    generator_discard(block_texts, block_name_text);
  }
  if (block_mode < 0) {
    generator_error("E0102", "expected '=', '[' or '(' after '" + block_name_text + "'");
  }
} chain (string[] block_texts) {
  generator_done(block_texts);
} return void;
