generator_set_element(string[] block_texts, string block_name_text) {
  int block_thread_slot = generator_alloc(3);
  int block_list_type = generator_load(block_thread_slot, block_name_text);
  int block_integer_type = generator_bin(block_texts, block_thread_slot + 1, 0, (import constant_prefix_minimum));
} chain (string[] block_texts, string block_name_text) {
  generator_need(block_texts, "]");
  generator_need(block_texts, "=");
  int block_variable_kind = generator_bin(block_texts, block_thread_slot + 2, block_list_type - (import constant_type_list), (import constant_prefix_minimum));
} chain (string[] block_texts, string block_name_text) {
  int block_element_type_code = generator_element_type_type(block_list_type, block_integer_type);
  generator_check_set(block_name_text, block_element_type_code, block_variable_kind);
  if (block_element_type_code >= 0 && block_element_type_code == block_variable_kind) {
    generator_emit((import constant_opcode_list_set), block_thread_slot, block_thread_slot + 1, block_thread_slot + 2, 0);
  }
} return void;
