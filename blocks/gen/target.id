given model_load("t.blk", "sprite S\nvar int n") given generator_initial (["say", "(", "\"hi\"", ")"]):() then len((import generator_string_constants)):(1) then generator_codes:("10:1,1,0,0,0,14,0,1,0,0")
given model_load("t.blk", "sprite S\nvar int n") given generator_initial (["n", "n"]):() then len((import model_diagnostics)):(1)

generator_set(string[] block_texts, string block_name_text) {
  int block_variable_table = generator_variable_type(block_name_text);
  int block_call_stack = generator_alloc(1);
  int block_type = generator_bin(block_texts, block_call_stack, block_variable_table, (import constant_prefix_minimum));
} chain (string[] block_texts, string block_name_text) {
  generator_check_set(block_name_text, block_variable_table, block_type);
  if (block_variable_table == block_type) {
    generator_store(block_name_text, block_call_stack);
  }
} return void;
