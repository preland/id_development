generator_alloc(int block_count) {
  int block_slot = (import generator_state)[(import constant_statement_slot)];
  integer_list_set((import generator_state), (import constant_statement_slot), block_slot + block_count);
  if (block_slot + block_count > (import constant_frame)) {
    generator_error("E0201", "this function needs more than " + (import constant_frame) + " slots for its variables and temporaries; split it into smaller functions");
  }
} return int block_slot;
