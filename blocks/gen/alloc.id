// Reporting an error from the compiler, and handing out frame slots. Every
// value a function computes lives in a slot of its frame, numbered from 0:
// parameters first, then locals and temporaries in the order they are asked
// for, none reused. A frame has bkk_frame slots.

generator_error(string block_code, string block_message) {
  model_error((import generator_state)[(import constant_statement_line)], block_code, block_message);
  integer_list_set((import generator_state), (import constant_statement_error), (import generator_state)[(import constant_statement_error)] + 1);
} return void;
