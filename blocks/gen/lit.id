// Literals. A number with a point is a float, kept in the float pool and
// loaded by ldk; any other is an int loaded by ldi, and more than nine digits
// does not fit an int. A string is unquoted, pooled, and its pool index
// loaded by ldi; one that never closes is E0105. Each answers its type code
// and writes the value to the slot dest.

generator_number(int block_destination, string block_token) {
  int block_type = (import constant_type_integer);
  int block_key_code = string_find(block_token, ".");
  int block_variant = to_int(block_token);
} chain (int block_destination, string block_token) {
  if (len(block_token) > 9 && block_key_code < 0) {
    generator_error("E0104", "the integer " + block_token + " is too large for an int; the largest has nine digits here");
  }
  if (block_key_code >= 0) {
    block_type = (import constant_type_float);
    block_variant = generator_kind_float(float_parse(block_token));
  }
  generator_emit((import constant_opcode_load_integer) + block_type - 1, block_destination, 0, 0, block_variant);
} return int block_type;
