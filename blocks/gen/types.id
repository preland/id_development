    block_ok = 1;
  }
} chain (string block_character_code, int block_type, int block_function_type) {
  if (block_character_code == "e" && block_function_type >= (import constant_type_integer_list) && block_type == block_function_type - (import constant_type_list)) {
    block_ok = 1;
  }
  if (block_character_code == "a" && (block_type == (import constant_type_string) || block_type >= (import constant_type_integer_list))) {
    block_ok = 1;
  }
} return int block_ok;
