// Expressions, by precedence climbing. bkg_bin compiles an expression whose
// operators bind at least as tight as minp (conf.id's bkk_binpre) into the
// slot dest: the left operand first, then, while the next token is a binary
// operator that binds that tight, bkg_step for it. Every compile function of
// this kind answers the type code of what it compiled, or -1 after an error,
// and leaves its token cursor after the last token it used.

generator_precedence(string[] block_texts) {
  int block_key_code = lst_str_index((import constant_binary_operator), lst_str_get_or(block_texts, (import generator_state)[(import constant_statement_position_index)], ""));
  int block_position = 0;
  if (block_key_code >= 0) {
    block_position = (import constant_binary_precedence)[block_key_code];
  }
} return int block_position;
given generator_initial given lset((import generator_state), 0, 1) (["a", "+"]):(5)
given generator_initial given lset((import generator_state), 0, 1) (["a", "&&"]):(2)
given generator_initial (["a", "+"]):(0)

generator_bin(string[] block_texts, int block_destination, int block_want, int block_minimum_position) {
  int block_type = generator_unary(block_texts, block_destination, block_want);
  while (generator_precedence(block_texts) >= block_minimum_position) {
    block_type = generator_step(block_texts, block_destination, block_type);
  }
} return int block_type;
