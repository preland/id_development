generator_step(string[] block_texts, int block_destination, int block_list_type) {
  int block_key_code = lst_str_index((import constant_binary_operator), generator_take(block_texts));
  int block_sub = (import constant_binary_substitute)[block_key_code];
  int block_type = 0 - 1;
} chain (string[] block_texts, int block_destination, int block_list_type) {
  if (block_sub >= (import constant_sub_and)) {
    block_type = generator_logic(block_texts, block_destination, block_list_type, block_key_code);
