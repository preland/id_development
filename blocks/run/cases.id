// Every test case of the loaded program. bkr_case runs case c: its tokens
// become tagged entries (item.id), a malformed one is reported by bkr_shape,
// and a good one has its functions generated (casetext.id), added at the end
// of the model and compiled; if they compile they are run, if not the
// diagnostics are replaced by one at the case's line. bkr_cases runs them all
// in order and answers the number that failed.

runner_case(int block_character) {
  string[] block_as = runner_parse(lexer_tokens((import model_cat)[block_character]));
  int block_function_row = (import model_can)[block_character];
  int block_ok = runner_shape(block_character, block_function_row, block_as);
} chain (int block_character) {
  int block_count_initial = len((import model_function_names));
  int block_diagnostic_first = len((import model_diagnostics));
  if (block_ok == 1) {
    model_add(runner_case_text(block_function_row, block_as) + runner_wanted_text(block_function_row, block_as) + runner_then_text(block_as));
    runner_adopt(block_count_initial, block_function_row);
    generator_program(block_count_initial);
  }
} chain (int block_character) {
  int block_bad = len((import model_diagnostics)) > block_diagnostic_first;
  if (block_ok == 1 && block_bad == 0) {
    runner_exec(block_character, block_function_row, block_as, block_count_initial);
  }
  if (block_ok == 1 && block_bad == 1) {
    runner_no_compile(block_character, block_diagnostic_first);
  }
} return void;
given runner_load("t.blk", "sprite S\nvar int n\nfn inc(int by) return int\n  n = n + by\n  return n\n(1): (1)\n(2): (2)") (0):() then model_diagnostic_list:("")
given runner_load("t.blk", "sprite S\nvar int n\nfn inc(int by) return int\n  n = n + by\n  return n\n(1): (1)\n(2): (3)") (1):() then model_diagnostic_list:("t.blk:7: test failed: inc(2) = 2, expected 3")
given runner_load("t.blk", "sprite S\nvar int n\nfn inc(int by) return int\n  n = n + by\n  return n\ngiven n = 5 (1): (6) then n: (6)\n(2): (3)") (0):() then model_diagnostic_list:("")
given runner_load("t.blk", "sprite S\nvar int n\nfn bump() return void\n  n = n + 1\n(): () then n: (1)\n(): () then n: (2)") (1):() then model_diagnostic_list:("t.blk:6: test failed: bump() then n = 1, expected 2")
given runner_load("t.blk", "sprite S\nfn f(int a) return int\n  return a\n(1, 2): (1)\n(2): (2)") (0):() then model_diagnostic_list:("t.blk:4: error: this case passes 2 argument(s) but 'f' takes 1 [E0503]")
given runner_load("t.blk", "sprite S\nfn f(int a) return int\n  return a\n(q): (1)\n(2): (2)") (0):() then model_diagnostic_list:("t.blk:4: error: the test case does not compile: t.blk:2: error: undefined variable 'q' [E0301]")

runner_cases() {
  int block_character = 0;
  int block_diagnostic_first = len((import model_diagnostics));
  while (block_character < len((import model_can))) {
    runner_case(block_character);
    block_character = block_character + 1;
  }
} chain () {
  int block_bad = len((import model_diagnostics)) - block_diagnostic_first;
} return int block_bad;
given runner_load("t.blk", "sprite S\nfn f(int a) return int\n  return a\n(1): (1)\n(2): (2)") ():(0)
given runner_load("t.blk", "sprite S\nfn f(int a) return int\n  return a\n(1): (1)\n(2): (5)\n(3): (4)") ():(2)
