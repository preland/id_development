// A test case as a list of tagged entries: "G|name = value" for each given,
// "A|args" for the arguments, "E|value" for the expected value, "T|name|value"
// for each then, and "X|message" for something that is no part of a case (the
// rest of the line is dropped). bkr_item reads one entry at token i and
// answers where the next begins; the group after a ':' is the expected value
// and any other is the arguments (bkr_tag). bkr_then reads a then clause.

runner_tag(string[] block_texts, int block_index) {
  string block_tag = "A|";
  if (lst_str_get_or(block_texts, block_index - 1, "") == ":") {
    block_tag = "E|";
  }
} return string block_tag;
(["(", "a", ")", ":", "(", "b", ")"], 0):("A|")
(["(", "a", ")", ":", "(", "b", ")"], 4):("E|")

runner_then(string[] block_as, string[] block_texts, int block_index) {
  int block_character = runner_close(block_texts, block_index + 3);
  int block_next_index = len(block_texts);
  int block_ok = lst_str_get_or(block_texts, block_index + 2, "") == ":" && lst_str_get_or(block_texts, block_index + 3, "") == "(";
} chain (string[] block_as, string[] block_texts, int block_index) {
  if (block_ok == 1) {
    push(block_as, "T|" + lst_str_get_or(block_texts, block_index + 1, "") + "|" + runner_join(block_texts, block_index + 4, block_character - 1));
    block_next_index = block_character;
  } else {
    push(block_as, "X|a then clause is 'then NAME:(VALUE)'");
  }
} return int block_next_index;
([], ["then", "n", ":", "(", "5", ")"], 0):(6)
([], ["then", "n", "(", "5", ")"], 0):(5)

runner_item(string[] block_as, string[] block_texts, int block_index) {
  int block_next_index = block_index + 1;
  string block_token = block_texts[block_index];
  int block_character = runner_close(block_texts, block_index);
} chain (string[] block_as, string[] block_texts, int block_index) {
  if (block_token == "given") {
    block_next_index = runner_group_end(block_texts, block_index + 1);
    push(block_as, "G|" + runner_join(block_texts, block_index + 1, block_next_index));
  }
  if (block_token == "(") {
    push(block_as, runner_tag(block_texts, block_index) + runner_join(block_texts, block_index + 1, block_character - 1));
    block_next_index = block_character;
  }
  if (block_token == "then") {
    block_next_index = runner_then(block_as, block_texts, block_index);
  }
} chain (string[] block_as, string[] block_texts, int block_index) {
  if (block_token != "given" && block_token != "(" && block_token != "then" && block_token != ":") {
    push(block_as, "X|unexpected '" + block_token + "' in a test case; a case is (ARGS):(EXPECTED), with given and then clauses if it needs them");
    block_next_index = len(block_texts);
  }
} return int block_next_index;
([], ["given", "n", "=", "5", "(", ")"], 0):(4)
([], ["(", "1", ",", "2", ")", ":", "(", "3", ")"], 0):(5)
([], [":", "(", "3", ")"], 0):(1)
([], ["wat", "(", ")"], 0):(3)
