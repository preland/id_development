// Starting a run of the loaded program: a fresh machine with __init done, the
// green flag (__flag, which calls main) started if the program has a main,
// and the machine run for at most n frames. bkr_lines is what a run shows:
// the lines said, then the state of the sprites and variables.

runner_start(int block_count) {
  runner_fresh();
  int block_flag = lst_str_index((import model_function_names), (import constant_flag_function));
  if (block_flag >= 0) {
    machine_spawn(block_flag);
  }
} chain (int block_count) {
  machine_run(block_count);
} return void;
given runner_load("t.blk", "sprite S\nvar int n\nfn main(int argc, string[] argv) return int\n  n = argc\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\", \"y\"]): (0)") (10):() then machine_registers:("r=33_0_1") then (import machine_gl)[0]:(1.0)
given runner_load("t.blk", "sprite S\nvar int n = 7\nfn f() return void\n(): ()\n(1): ()") (10):() then (import machine_gl)[0]:(7.0) then machine_registers:("r=0_0_0")

runner_lines() {
  string[] block_lists = [];
  lst_str_extend(block_lists, (import machine_out));
  push(block_lists, "-- state after " + (import machine_registers_group)[(import constant_registers_frames)] + " frame(s) --");
} chain () {
  lst_str_extend(block_lists, machine_dump());
} return string[] block_lists;
given runner_load("t.blk", "sprite S\nvar int n = 7\nfn f() return void\n(): ()\n(1): ()") given runner_start(5) ():(["-- state after 0 frame(s) --", "S: x=0 y=0 dir=90 size=100 visible=1", "n = 7"])
given runner_load("t.blk", "sprite S\nfn main(int argc, string[] argv) return int\n  say(\"hi\")\n  return 0\n(1, [\"x\"]): (0)\n(2, [\"x\", \"y\"]): (0)") given runner_start(5) ():(["S: hi", "-- state after 1 frame(s) --", "S: x=0 y=0 dir=90 size=100 visible=1"])
