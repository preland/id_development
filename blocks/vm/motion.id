// A sprite's motion and looks, on its row of the sprite table starting at
// base. Direction is in degrees with 90 pointing right and 0 up, kept in
// [0, 360); move steps along it. A position is rounded to a millionth, so
// that a step of 10 at 90 degrees lands on exactly 10 and not on the 10 minus
// a rounding error that sin and cos would leave. show and hide set the visible
// cell. The ids are conf.id's bkk_bi_ numbers.

machine_snap(float block_float_value) {
  float block_frame_record = float_round(block_float_value * (import constant_snap)) / (import constant_snap);
} return float block_frame_record;
(2.5000004):(2.5)
(0.0000004):(0.0)
(9.9999999):(10.0)

machine_wrap(float block_float_value) {
  float block_frame_width = block_float_value - (import constant_turn) * float_floor(block_float_value / (import constant_turn));
} return float block_frame_width;
(370.0):(10.0)
(-90.0):(270.0)
(450.0):(90.0)
(360.0):(0.0)

machine_motion(float[] block_sprite_state, int block_base, int block_identifier, float block_float_first, float block_float_second) {
  float block_drag = block_sprite_state[block_base + (import constant_sprite_direction)] * (import constant_rad);
  if (block_identifier == (import constant_builtin_move)) {
    block_sprite_state[block_base + (import constant_sprite_x)] = machine_snap(block_sprite_state[block_base + (import constant_sprite_x)] + block_float_first * float_sin(block_drag));
    block_sprite_state[block_base + (import constant_sprite_y)] = machine_snap(block_sprite_state[block_base + (import constant_sprite_y)] + block_float_first * float_cos(block_drag));
  }
  if (block_identifier == (import constant_builtin_turn)) {
    block_sprite_state[block_base + (import constant_sprite_direction)] = machine_wrap(block_sprite_state[block_base + (import constant_sprite_direction)] + block_float_first);
  }
} chain (float[] block_sprite_state, int block_base, int block_identifier, float block_float_first, float block_float_second) {
  if (block_identifier == (import constant_builtin_go_to)) {
    block_sprite_state[block_base + (import constant_sprite_x)] = block_float_first;
    block_sprite_state[block_base + (import constant_sprite_y)] = block_float_second;
  }
  if (block_identifier == (import constant_builtin_point)) {
    block_sprite_state[block_base + (import constant_sprite_direction)] = machine_wrap(block_float_first);
  }
  if (block_identifier == (import constant_builtin_show)) {
    block_sprite_state[block_base + (import constant_sprite_visible)] = 1.0;
  }
} chain (float[] block_sprite_state, int block_base, int block_identifier, float block_float_first, float block_float_second) {
  if (block_identifier == (import constant_builtin_hide)) {
    block_sprite_state[block_base + (import constant_sprite_visible)] = 0.0;
  }
} return void;
