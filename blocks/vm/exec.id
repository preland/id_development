// Running a thread until it stops. bkv_exec steps from the thread's saved pc
// until a step answers a negative status; bkv_stop then does what the status
// asks: a yield saves the pc after the instruction (the thread goes on from
// there when it next runs), a finished thread needs nothing, and a trap is
// reported by bkv_fail, which writes the error to the output, counts it and
// frees the thread.

machine_exec(int block_thread_slot) {
  int block_program_counter = (import machine_thread)[block_thread_slot * (import constant_thread_count) + (import constant_thread_entry_counter)];
  int block_record = 0;
  while (block_record >= 0) {
    block_record = machine_step(block_thread_slot, block_program_counter);
    if (block_record >= 0) {
      block_program_counter = block_record;
    }
  }
} chain (int block_thread_slot) {
  machine_stop(block_thread_slot, block_program_counter, block_record);
} return void;
