machine_sub(float[] block_value_list, string[] block_pool, int block_frame_pointer, int block_delta, int block_first_value, int[] block_thread_pointer) {
  int block_height = block_value_list[block_frame_pointer + block_first_value];
  int block_index = block_value_list[block_frame_pointer + block_first_value + 1];
  int block_count = block_value_list[block_frame_pointer + block_first_value + 2];
} chain (float[] block_value_list, string[] block_pool, int block_frame_pointer, int block_delta, int block_first_value, int[] block_thread_pointer) {
  int block_ok = block_index >= 0 && block_count >= 0 && block_index + block_count <= len(block_pool[block_height]);
  if (block_ok == 1) {
    push(block_pool, str_sub(block_pool[block_height], block_index, block_count));
    block_value_list[block_frame_pointer + block_delta] = len(block_pool) - 1;
  } else {
    block_thread_pointer[0] = 5;
  }
} return void;
