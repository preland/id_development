// bkv_run: frames until no thread is left or n frames have run in all. The
// count of frames run so far is the machine's own register, so a run can be
// resumed with a larger n.

machine_run(int block_count) {
  while ((import machine_registers_group)[(import constant_registers_frames)] < block_count && machine_live() > 0) {
    machine_frame();
  }
} return void;
