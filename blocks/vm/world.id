machine_wait(int block_thread_slot, float block_secs) {
  int block_row = block_thread_slot * (import constant_thread_count);
  int block_wait_milliseconds = block_secs * 1000.0;
  lset((import machine_thread), block_row + (import constant_thread_state), (import constant_statement_sleep));
} chain (int block_thread_slot, float block_secs) {
  lset((import machine_thread), block_row + (import constant_thread_wake), (import machine_registers_group)[(import constant_registers_now)] + block_wait_milliseconds);
} return void;
