// The builtins that touch the sprites and the clock. say adds a line
// 'Sprite: text' to the output and remembers it as the sprite's speech; wait
// puts the thread to sleep for that many seconds of the machine's clock (it
// answers -1, a yield, instead of the next pc); broadcast starts every script
// that runs on that message; xpos, ypos and direction read the sprite;
// the rest are motion and looks (motion.id). The sprite is the one the
// thread's first function belongs to.

machine_say(int block_thread_slot, int block_height) {
  int block_row = (import machine_thread)[block_thread_slot * (import constant_thread_count) + (import constant_thread_stack_pointer)];
  push((import machine_out), (import model_sprite_names)[block_row] + ": " + (import machine_sprite_list)[block_height]);
  float[] block_float_sprite = (import machine_sprite_state);
} chain (int block_thread_slot, int block_height) {
  block_float_sprite[block_row * (import constant_sprite_count) + (import constant_sprite_say)] = block_height;
} return void;
