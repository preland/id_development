// broadcast: every function whose broadcast message (the model's bkm_fne)
// is the broadcast text becomes a new thread. The text is found in the
// string pool by its index; an empty message starts nothing, since an empty
// bkm_fne means a function runs on no message.

machine_broadcast(int block_height) {
  int block_function_row = 0;
  while (block_function_row < len((import model_function_message))) {
    if ((import model_function_message)[block_function_row] == (import machine_sprite_list)[block_height] && (import machine_sprite_list)[block_height] != "") {
      machine_spawn(block_function_row);
    }
    block_function_row = block_function_row + 1;
  }
} return void;
