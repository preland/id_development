machine_leave(int[] block_thread, int[] block_call_stack_cells, float[] block_value_list, int block_thread_slot, int block_first_value) {
  int block_row = block_thread_slot * (import constant_thread_count);
  int block_frame_pointer = block_thread[block_row + (import constant_thread_frame_pointer)];
  int block_depth = block_thread[block_row + (import constant_thread_data_pointer)];
} chain (int[] block_thread, int[] block_call_stack_cells, float[] block_value_list, int block_thread_slot, int block_first_value) {
  int block_base = block_thread_slot * (import constant_call_stack_count) + (block_depth - 1) * (import constant_call_stack_cell);
  int block_caller_frame_pointer = block_call_stack_cells[block_base + 1];
  int block_destination_slot = block_call_stack_cells[block_base + 2];
} chain (int[] block_thread, int[] block_call_stack_cells, float[] block_value_list, int block_thread_slot, int block_first_value) {
  if (block_first_value >= 0) {
    block_value_list[block_caller_frame_pointer + block_destination_slot] = block_value_list[block_frame_pointer + block_first_value];
  }
  integer_list_set(block_thread, block_row + (import constant_thread_data_pointer), block_depth - 1);
  integer_list_set(block_thread, block_row + (import constant_thread_frame_pointer), block_caller_frame_pointer);
} return void;
