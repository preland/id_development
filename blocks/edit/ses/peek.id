// Test check: what the session bke_t_session made holds that the reducer changes:
// whether a literal is being typed and what has been typed, the dirty flag, the
// run flag, the palette's category and the document, its lines joined with |.

editor_test_peek() {
  int[] bel_state = (import editor_test_integers)[(import constant_y_state)];
  string editor_string_first_value = "ed=" + bel_state[(import constant_session_editing)] + " buf=" + (import editor_test_strings)[(import constant_z_buffer)][0] + " dirty=" + bel_state[(import constant_session_dirty)];
  string editor_string_second = " run=" + bel_state[(import constant_session_run)] + " tab=" + bel_state[(import constant_session_tab)] + " " + str_join((import editor_test_strings)[(import constant_z_doc)], "|");
} chain () {
  string editor_string_all = editor_string_first_value + editor_string_second;
} return string editor_string_all;
given editor_test_session("sprite S\n") ():("ed=0 buf= dirty=0 run=0 tab=0 sprite S|")
given editor_test_session("") given editor_test_cell(15, 3) ():("ed=0 buf= dirty=0 run=0 tab=3 ")

editor_test_grip() {
  int[] bel_state = (import editor_test_integers)[(import constant_y_state)];
  string editor_string_first_value = "gk=" + bel_state[(import constant_session_grab_kind)] + " ga=" + bel_state[(import constant_session_anchor)] + " gp=" + bel_state[(import constant_session_grab_position)] + " gd=" + bel_state[(import constant_session_drag)];
  string editor_string_second = " at=" + bel_state[(import constant_session_grab_x)] + "," + bel_state[(import constant_session_grab_y)] + " pan=" + bel_state[(import graph_view_state_drag)];
} chain () {
  string editor_string_all = editor_string_first_value + editor_string_second;
} return string editor_string_all;
given editor_test_session("") ():("gk=0 ga=0 gp=-1 gd=0 at=0,0 pan=0")
given editor_test_session("") given editor_test_hold(5) ():("gk=3 ga=5 gp=-1 gd=0 at=0,0 pan=0")

editor_test_stage() {
  string editor_string_first_value = "names=" + str_join((import editor_test_strings)[(import constant_z_names)], ",") + " says=" + str_join((import editor_test_strings)[(import constant_z_says)], ",");
  string editor_string_second = " geo=" + list_text((import editor_test_integers)[(import constant_y_sprite_state)], ",") + " run=" + (import editor_test_integers)[(import constant_y_state)][(import constant_session_run)] + " fr=" + (import editor_test_integers)[(import constant_y_state)][(import constant_session_frame)];
  string editor_string_all = editor_string_first_value + editor_string_second;
} return string editor_string_all;
given editor_test_session("sprite A\nsprite B\n") ():("names=A,B says=, geo=0,0,90,100,1,0,0,90,100,1 run=0 fr=0")
given editor_test_session("") ():("names= says= geo= run=0 fr=0")
