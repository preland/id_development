editor_press(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_x, int editor_integer_y, int editor_integer_column_number, int editor_integer_delta) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  int[] bel_width = editor_where(bel_state, editor_integer_x, editor_integer_y, len(editor_string_session[(import constant_z_pal)]));
  int[] bel_group = editor_grab(editor_matrix_layout, bel_state, editor_integer_x, editor_integer_y, bel_width);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_x, int editor_integer_y, int editor_integer_column_number, int editor_integer_delta) {
  editor_hold(bel_state, bel_group, editor_integer_x, editor_integer_y);
  if (bel_group[0] == (import constant_grab_pan)) {
    int editor_integer_code = editor_pan(bel_state, (import graph_view_event_down), editor_integer_x, editor_integer_y, editor_integer_column_number, editor_integer_delta);
  }
} return void;
