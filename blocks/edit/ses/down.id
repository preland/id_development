// A press. Whatever is being typed is put in its line first (a click anywhere
// else ends it). Then the press takes hold of what is under the point (bke_grab)
// and the state remembers it, where it was and that it is not yet a drag
// (bke_hold); a press on the picture's background starts a pan. Only the left
// button presses.

editor_hold(int[] bel_state, int[] bel_group, int editor_integer_x, int editor_integer_y) {
  bel_state[(import constant_session_grab_kind)] = bel_group[0];
  bel_state[(import constant_session_anchor)] = bel_group[1];
  bel_state[(import constant_session_grab_position)] = bel_group[2];
} chain (int[] bel_state, int[] bel_group, int editor_integer_x, int editor_integer_y) {
  bel_state[(import constant_session_grab_x)] = editor_integer_x;
  bel_state[(import constant_session_grab_y)] = editor_integer_y;
  bel_state[(import constant_session_drag)] = 0;
} return void;
