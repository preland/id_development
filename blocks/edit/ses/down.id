editor_down(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_x, int editor_integer_y, int editor_integer_button, int editor_integer_clicks) {
  int editor_integer_bits = 0;
  if (editor_integer_button == 1) {
    editor_integer_bits = editor_commit(editor_string_session, editor_matrix_session, editor_matrix_layout);
    editor_press(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_integer_x, editor_integer_y, editor_integer_button, editor_integer_clicks);
  }
} return int editor_integer_bits;
