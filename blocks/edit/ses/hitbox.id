// From the window to the picture and back to a box. The script area shows the
// layout through the camera (pan in pixels, zoom in percent, as the graph kit's
// graph_view_screen applies it); bke_world is its inverse, bke_hitbox the topmost box
// under a point of the window.

editor_world(int editor_integer_session, int editor_integer_pan, int editor_integer_zoom) {
  int editor_integer_relative = editor_integer_session - editor_integer_pan;
  int editor_integer_width = fx_fdiv(editor_integer_relative * 100, editor_integer_zoom);
} return int editor_integer_width;
