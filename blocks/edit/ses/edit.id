// Typing into a literal. A click on a pill starts it (bke_begin: the pill's
// line and number are kept in the state, its text goes in the buffer); text events
// add to the buffer and Backspace takes from it; Enter (or a click anywhere else)
// puts the buffer in the line in place of the pill, Esc drops it. Changing the document
// changes everything derived from it (bke_changed), which is what the bits
// answer: 3 is a different picture and a different document.

editor_changed(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout) {
  editor_layout_again(editor_string_session, editor_matrix_layout);
  editor_refill_palette(editor_string_session, editor_matrix_session);
  editor_matrix_session[(import constant_y_state)][(import constant_session_dirty)] = 1;
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout) {
  int editor_integer_bits = (import constant_event_paint) + (import constant_event_doc);
} return int editor_integer_bits;
