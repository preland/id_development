editor_commit(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  string editor_string_old = list_string_get_or(editor_string_session[(import constant_z_doc)], bel_state[(import constant_session_element)], "");
  int editor_integer_bits = bel_state[(import constant_session_editing)];
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout) {
  if (bel_state[(import constant_session_editing)] == 1) {
    editor_set_line(editor_string_session[(import constant_z_doc)], bel_state[(import constant_session_element)], bel_state[(import constant_session_edit_start)], editor_string_session[(import constant_z_buffer)][0]);
