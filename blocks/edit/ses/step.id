// What is left to do after the reducer: bke_effects does the part of its answer that
// is not a list. A changed document stops the program (the machine's tables are the
// checker's too, so they are rebuilt) and is checked again; the flag starts the
// program, stop stops it, save writes the file the session was opened from.
// bke_step is the reducer and then this; it answers 1 when the picture is to be painted
// again. It is what a window loop and a script both call.

editor_effects(string[][] editor_string_session, int[][] editor_matrix_session, int editor_integer_bits) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  if (editor_integer_bits / 2 % 2 == 1) {
    bel_state[(import constant_session_run)] = 0;
    editor_check(editor_string_session, editor_matrix_session);
  }
  if (editor_integer_bits / 4 % 2 == 1) {
    editor_launch(editor_string_session, editor_matrix_session);
  }
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int editor_integer_bits) {
  if (editor_integer_bits / 8 % 2 == 1) {
    bel_state[(import constant_session_run)] = 0;
  }
  if (editor_integer_bits / 16 % 2 == 1) {
    int editor_integer_record_count = editor_save(editor_string_session, editor_matrix_session, editor_string_session[(import constant_z_path)][0]);
  }
} return void;
