} chain (int[][] editor_matrix_layout, string[] bet_doc, int editor_integer_row_number, int editor_integer_world_y) {
  if (editor_integer_kind == (import constant_kind_hat)) {
    bel_session = [editor_integer_line_text + 1, 1];
  }
  if (editor_integer_kind == (import constant_kind_cap)) {
    bel_session = [editor_end(bet_doc, editor_integer_line_text), editor_integer_indent];
  }
} return int[] bel_session;
