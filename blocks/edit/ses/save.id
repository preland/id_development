// Saving. The document is its lines joined with a newline, which is the text of the
// file it was read from byte for byte until it is edited, so saving an unedited
// document rewrites the file with the same bytes. Answers 0, or 1 after saying on
// stderr that the file could not be written; the dirty flag is cleared on 0.

editor_save(string[][] editor_string_session, int[][] editor_matrix_session, string editor_string_path) {
  string editor_string_text = string_join(editor_string_session[(import constant_z_doc)], "\n");
  int editor_integer_count = exec_file_put(editor_string_path, editor_string_text, 420);
  int editor_integer_record_count = editor_integer_count != len(editor_string_text);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, string editor_string_path) {
  if (editor_integer_record_count == 0) {
    editor_matrix_session[(import constant_y_state)][(import constant_session_dirty)] = 0;
  } else {
    eprint("blocks: cannot write " + editor_string_path + "; check that the folder exists and that you may write to it");
  }
} return int editor_integer_record_count;
