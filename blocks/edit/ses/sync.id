editor_refill_palette(string[][] editor_string_session, int[][] editor_matrix_session) {
  string[] bet_texts = [];
  int[] bel_repeat_position = [];
  editor_pal(editor_string_session[(import constant_z_doc)], editor_matrix_session[(import constant_y_state)][(import constant_session_tab)], bet_texts, bel_repeat_position);
