editor_layout_again(string[][] editor_string_session, int[][] editor_matrix_layout) {
  string[] bet_texts = [];
  int[][] editor_matrix_new = editor_layout(editor_string_session[(import constant_z_doc)], bet_texts);
  editor_swap(editor_string_session, editor_matrix_layout, bet_texts, editor_matrix_new);
} return void;
