// Keeping what is derived from the document in step with it. The layout (a pure
// function of the document, edit/lay/) and the palette of the current category
// (its Variables and My Blocks follow the document's own) are rebuilt after
// every edit, into the lists the session already holds, so the bundles keep
// their identity.

editor_swap(string[][] editor_string_session, int[][] editor_matrix_layout, string[] bet_texts, int[][] editor_matrix_new) {
  editor_string_session[(import constant_z_text)] = bet_texts;
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < len(editor_matrix_new)) {
    editor_matrix_layout[editor_integer_key_code] = editor_matrix_new[editor_integer_key_code];
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return void;
