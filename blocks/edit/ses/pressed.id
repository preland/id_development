// Test setup: a press at a point of the window, as the reducer takes it, on the session bke_t_session made.

editor_test_pressed(int editor_integer_x, int editor_integer_y) {
  editor_press((import editor_test_strings), (import editor_test_integers), (import editor_test_boxes), editor_integer_x, editor_integer_y, 1, 1);
} return void;
given editor_test_session("sprite S\n") (200, 10):() then editor_test_grip:("gk=4 ga=1 gp=-1 gd=0 at=200,10 pan=0")
given editor_test_session("sprite S\n") (600, 500):() then editor_test_grip:("gk=1 ga=0 gp=-1 gd=0 at=600,500 pan=1")

editor_test_event(int editor_integer_kind, int editor_integer_first_value, int editor_integer_second, int editor_integer_column_number, int editor_integer_delta) {
  int editor_integer_paint = editor_step((import editor_test_strings), (import editor_test_integers), (import editor_test_boxes), editor_integer_kind, editor_integer_first_value, editor_integer_second, editor_integer_column_number, editor_integer_delta);
} return void;
given editor_test_session("sprite S\n") (6, 400, 300, 0, 0):() then editor_test_look:("doc 2 diag 0 pal 7 boxes 1 sprites S pan 16,16")
given editor_test_session("sprite S\n") (3, 200, 10, 1, 1):() then editor_test_grip:("gk=4 ga=1 gp=-1 gd=0 at=200,10 pan=0")
