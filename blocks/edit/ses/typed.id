// Test setups that start and fill a text of the session bke_t_session made:
// bke_t_begin starts typing into a pill box, bke_t_str puts text in the first (only)
// cell of one of the text lists (2 the typing buffer, 7 the file's path).

editor_test_string(int editor_integer_which, string editor_string_text) {
  string[] bet_cell = (import editor_test_strings)[editor_integer_which];
  bet_cell[0] = editor_string_text;
} return void;
given editor_test_session("") (2, "abc"):() then editor_test_peek:("ed=0 buf=abc dirty=0 run=0 tab=0 ")
given editor_test_session("") (2, ""):() then editor_test_peek:("ed=0 buf= dirty=0 run=0 tab=0 ")

editor_test_begin(int editor_integer_box) {
  editor_begin((import editor_test_strings), (import editor_test_integers), (import editor_test_boxes), editor_integer_box);
} return void;
given editor_test_session("sprite S\nfn f() return void\n  move(10.0)\n") (4):() then editor_test_peek:("ed=1 buf=10.0 dirty=0 run=0 tab=0 sprite S|fn f() return void|  move(10.0)|")
given editor_test_session("sprite S\n") (-1):() then editor_test_peek:("ed=0 buf= dirty=0 run=0 tab=0 sprite S|")
