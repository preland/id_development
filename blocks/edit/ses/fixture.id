// Test setup and check for the session functions that take the state: bke_t_blank
// makes the state at the start (a copy of conf.id's bkk_st0) with the window's
// size, as the export bke_t_st; bke_t_set puts a value in one of its cells;
// bke_t_stdump shows all the cells, comma separated.

editor_test_blank(int editor_integer_width, int editor_integer_height) {
  int[] bel_state = lst_copy((import constant_state_initial));
  bel_state[(import graph_view_state_width)] = editor_integer_width;
  bel_state[(import graph_view_state_height)] = editor_integer_height;
} chain (int editor_integer_width, int editor_integer_height) {
  export int[] editor_test_state = bel_state;
} return void;
