// The button coming up, which is where a gesture ends. A button pressed and
// released on itself is clicked (the answer carries which: run, stop or save, for
// the caller to do); a tab released on itself becomes the palette's category; a
// block held and dragged is dropped (bke_drop); a block held and not dragged is a
// click, which on a pill starts typing into it; a pan ends. The gesture is over
// after any release of the left button.

editor_tab_to(string[][] editor_string_session, int[][] editor_matrix_session, int editor_integer_key_code) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  bel_state[(import constant_session_tab)] = editor_integer_key_code;
  bel_state[(import constant_session_palette_scroll)] = 0;
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int editor_integer_key_code) {
  editor_refill_palette(editor_string_session, editor_matrix_session);
} return void;
