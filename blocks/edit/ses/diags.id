// The diagnostics the checker collected (bkm_dg), split into the line each is
// on and its message.

editor_diagnostics_list(string[] bet_message, int[] bel_line_text) {
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < len((import model_diagnostics))) {
    push(bet_message, editor_diagnostic_message((import model_diagnostics)[editor_integer_key_code]));
    push(bel_line_text, editor_diagnostic_line((import model_diagnostics)[editor_integer_key_code]));
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return void;
given model_initial given model_error(3, "E0201", "too long") ([], []):(["too long [E0201]"], [3])
given model_initial given model_error(2, "E0102", "a") given model_error(5, "E0201", "b") ([], []):(["a [E0102]", "b [E0201]"], [2, 5])
