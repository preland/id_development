} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_x, int editor_integer_y, int editor_integer_mask) {
  if (editor_integer_far == 1 && (bel_state[(import constant_session_grab_kind)] == (import constant_grab_pal) || bel_state[(import constant_session_grab_kind)] == (import constant_grab_block))) {
    bel_state[(import constant_session_drag)] = 1;
  }
  int editor_integer_bits = (import constant_event_paint);
} return int editor_integer_bits;
