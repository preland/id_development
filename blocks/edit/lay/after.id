// The cursor of a layout after a row: the next free top, the effective indent
// of the line (its indent, one more when it opens a body), and for a row that
// opens a body the width of its header, its line and the top of its arm,
// kept at its level so a cap or an else further down can find them. The facts
// come as a list: effective indent, width, line, bottom, opens a body.

editor_lay_after(int[] bel_cursor, int editor_integer_level, int[] bel_field) {
  bel_cursor[(import constant_unit_y)] = bel_field[3];
  bel_cursor[(import constant_unit_pending)] = bel_field[0];
  if (bel_field[4] == 1) {
    editor_lay_open(bel_cursor, editor_integer_level, bel_field);
  }
} return void;
