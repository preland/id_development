// Test checks over a whole document: bke_t_flat lays it out and shows every box (bke_boxes), a box to a line joined with |; bke_t_put adds one box to the layout bke_t_open made.

editor_test_flat(string[] bet_doc) {
  string[] bet_texts = [];
  int[][] editor_matrix_layout = editor_layout(bet_doc, bet_texts);
  string editor_string_all = str_join(editor_boxes(editor_matrix_layout, bet_texts), "|");
} return string editor_string_all;
