editor_lay_strip(int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  string editor_string_unit = string_trim(bet_doc[editor_integer_index]);
  int editor_integer_key_code = editor_kind(bet_doc[editor_integer_index]);
  int editor_integer_ban = editor_integer_key_code == (import constant_kind_banner);
} chain (int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  int editor_integer_y = bel_cursor[(import constant_unit_y)] + editor_integer_ban * (bel_cursor[(import constant_unit_y)] > 0) * (import constant_metric_function_gap);
  int editor_integer_height = (import constant_metric_strip) + editor_integer_ban * ((import constant_metric_banner_height) - (import constant_metric_strip));
  editor_box(editor_matrix_layout, bet_texts, [editor_integer_key_code, 0, editor_integer_y, len(editor_string_unit) * (import constant_metric_character_width) + 2 * (import constant_metric_pad), editor_integer_height, editor_integer_index, (import constant_cat_lit), 0, -1, 0], editor_string_unit);
