// Rows that are not a statement of a body: a function's hat (main reads "when
// green flag clicked", every other function "define" and its header), and the
// strips, which show a line as it is: a sprite's banner, a variable, a test case
// or a comment. A hat and a banner start a new group and are set off from the
// one above by a gap.

editor_hat_text(string editor_string_unit) {
  string editor_string_text_list = "define " + str_sub(editor_string_unit, 3, len(editor_string_unit) - 3);
  if (string_starts_with(editor_string_unit, "fn main(") == 1) {
    editor_string_text_list = "when green flag clicked";
  }
} return string editor_string_text_list;
("fn main(int argc, string[] argv) return int"):("when green flag clicked")
("fn walk(int n) return void"):("define walk(int n) return void")

editor_lay_hat(int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  string editor_string_unit = string_trim(bet_doc[editor_integer_index]);
  string editor_string_text_list = editor_hat_text(editor_string_unit);
  int editor_integer_y = bel_cursor[(import constant_unit_y)] + (bel_cursor[(import constant_unit_y)] > 0) * (import constant_metric_function_gap);
} chain (int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  int editor_integer_cat = (import constant_cat_mine) + (string_starts_with(editor_string_unit, "fn main(") == 1) * ((import constant_cat_control) - (import constant_cat_mine));
  editor_box(editor_matrix_layout, bet_texts, [(import constant_kind_hat), 0, editor_integer_y, len(editor_string_text_list) * (import constant_metric_character_width) + 2 * (import constant_metric_pad), (import constant_metric_hath), editor_integer_index, editor_integer_cat, 0, -1, 0], editor_string_text_list);
  editor_lay_after(bel_cursor, 0, [0, 0, editor_integer_index, editor_integer_y + (import constant_metric_hath), 0]);
} return void;
