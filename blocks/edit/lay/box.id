// The boxes of a layout. A layout is a list of lists (conf.id's bkk_l_ columns:
// kind, left, top, width, height, document line, category, indent, pill number,
// bits), one entry per box, and a list of the texts the boxes carry. The layout
// is a pure function of the document: the painter and the hit test read it and
// nothing writes it but the functions of this directory.

editor_lists(int editor_integer_count) {
  int[][] editor_matrix_layout = [];
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < editor_integer_count) {
    int[] bel_end_index = [];
    push(editor_matrix_layout, bel_end_index);
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return int[][] editor_matrix_layout;
