// A statement of a body as a row: the row itself (its width known from its
// pieces before it is pushed), then its pieces, then the cursor moves down. An
// if, a while and an else open a body: they note their width, line and the
// top of their arm at their level of indent, and the next line is effectively
// one level in. An else first ends the arm of the if above it.

editor_lay_statement(int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  string editor_string_unit = string_trim(bet_doc[editor_integer_index]);
  int editor_integer_indent = editor_indent(bet_doc[editor_integer_index]);
  string[] bet_pieces = editor_pieces(editor_string_unit);
} chain (int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  int editor_integer_level = fixed_point_minimum(editor_integer_indent, (import constant_unit_top));
  int editor_integer_x = fixed_point_maximum(editor_integer_indent - 1, 0) * (import constant_metric_arm);
  int editor_integer_y = bel_cursor[(import constant_unit_y)];
} chain (int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  int editor_integer_els = editor_string_unit == "else";
  int editor_integer_header = string_starts_with(editor_string_unit, "if ") + string_starts_with(editor_string_unit, "while ") + editor_integer_els;
  int editor_integer_width = fixed_point_maximum(editor_wide(bet_pieces), editor_integer_els * bel_cursor[(import constant_unit_width) + editor_integer_level]);
} chain (int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  if (editor_integer_els == 1) {
    editor_lay_arm(editor_matrix_layout, bet_texts, bel_cursor, editor_integer_level, editor_integer_y);
  }
  editor_box(editor_matrix_layout, bet_texts, [(import constant_kind_statement) + editor_integer_els, editor_integer_x, editor_integer_y, editor_integer_width, (import constant_metric_row_height), editor_integer_index, editor_cat(editor_string_unit), editor_integer_indent, -1, editor_integer_header], "");
  int editor_integer_end = editor_lay_pieces(editor_matrix_layout, bet_texts, bet_pieces, editor_integer_index, editor_integer_x, editor_integer_y, editor_integer_indent);
} chain (int[][] editor_matrix_layout, string[] bet_texts, int[] bel_cursor, string[] bet_doc, int editor_integer_index) {
  editor_lay_after(bel_cursor, editor_integer_level, [editor_integer_indent + editor_integer_header, editor_integer_width, editor_integer_index, editor_integer_y + (import constant_metric_row_height), editor_integer_header]);
} return void;
