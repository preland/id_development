// Test setup for the functions that read a finished layout: bke_t_laid lays a
// document out and keeps document, layout and box texts as exports (bke_t_sdoc,
// bke_t_slo, bke_t_stx); bke_t_scene reports how many boxes and texts there are.

editor_test_laid(string[] bet_doc) {
  string[] bet_texts = [];
  int[][] editor_matrix_layout = editor_layout(bet_doc, bet_texts);
  export string[] editor_test_stage_document = bet_doc;
} chain (string[] bet_doc) {
  export string[] editor_test_stage_texts = bet_texts;
  export int[][] editor_test_stage_layout = editor_matrix_layout;
} return void;
(["  x = 1"]):() then editor_test_scene:("3 boxes 3 texts")
([]):() then editor_test_scene:("0 boxes 0 texts")

editor_test_scene() {
  string editor_string_count = len((import editor_test_stage_layout)[(import constant_layout_kind)]) + " boxes " + len((import editor_test_stage_texts)) + " texts";
} return string editor_string_count;
given editor_test_laid(["  x = 1"]) ():("3 boxes 3 texts")
given editor_test_laid(["sprite S", "sprite T"]) ():("2 boxes 2 texts")
