editor_events(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_character_code) {
  int[] bel_event = [0, 0, 0, 0, 0];
  int editor_integer_dirty = 0;
  if (editor_integer_character_code == 1) {
    editor_integer_dirty = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_size), (import pixel_surface_width), (import pixel_surface_height), 0, 0);
  }
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_character_code) {
  int editor_integer_kind = graphics_event(bel_event);
  int editor_integer_quit = 0;
  while (editor_integer_kind != 0 && editor_integer_quit == 0) {
    editor_integer_quit = editor_integer_quit || editor_integer_kind == 7;
    editor_integer_dirty = fixed_point_maximum(editor_integer_dirty, editor_take(editor_string_session, editor_matrix_session, editor_matrix_layout, bel_event));
    editor_integer_kind = graphics_event(bel_event);
  }
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_character_code) {
  int editor_integer_bits = editor_integer_dirty + 2 * editor_integer_quit;
} return int editor_integer_bits;
