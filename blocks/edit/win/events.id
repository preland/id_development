// session in turn (bke_step).

editor_take(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int[] bel_event) {
  int editor_integer_paint = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, bel_event[0], bel_event[1], bel_event[2], bel_event[3], bel_event[4]);
} return int editor_integer_paint;
