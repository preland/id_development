// One frame, as callgraph's and word's do it: the surface is fitted to the window,
// the waiting events are taken (bke_events), the program takes its turn (bke_tick)
// when it is running, the picture is painted when the first frame, a resize, an
// event or the program asks for it, and it is shown. Every frame is shown, painted
// or not: GFX_MAX_FRAMES counts shown frames. A frame waits 33 ms while the program runs, the machine's own frame time, so a wait block takes the time it says. Answers 1 when the window was closed.

editor_frame(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_first) {
  int editor_integer_character_code = gfx_sync();
  int editor_integer_bits = editor_events(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_integer_character_code);
  int editor_integer_ran = editor_tick(editor_string_session, editor_matrix_session);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_first) {
  if (editor_integer_first + editor_integer_character_code + editor_integer_bits % 2 + editor_integer_ran > 0) {
    editor_paint(editor_string_session, editor_matrix_session, editor_matrix_layout);
  }
  int editor_integer_shown = graphics_present((import surface_pixels));
  sleep_ms(1 + 32 * editor_matrix_session[(import constant_y_state)][(import constant_session_run)]);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_first) {
  int editor_integer_quit = editor_integer_bits / 2;
} return int editor_integer_quit;
