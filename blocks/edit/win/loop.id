editor_loop(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_ok, int editor_integer_maximum) {
  int editor_integer_count = 0;
  int editor_integer_quit = editor_integer_ok == 0;
  while (editor_integer_quit == 0 && editor_integer_count != editor_integer_maximum) {
    editor_integer_quit = editor_frame(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_integer_count == 0);
    editor_integer_count = editor_integer_count + 1;
  }
} return int editor_integer_count;
