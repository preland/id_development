// The script words that are the keyboard and the window. key NAME: the key goes down
// and, for a printable one, its text arrives, as the window gives both. text STR:
// each character of what follows the word (the rest of the line, spaces included)
// as a text event. size W H: the window becomes W by H.

editor_do_key(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string[] bet_field) {
  int editor_integer_code = editor_key_code(bet_field[1]);
  int editor_integer_first_value = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_key), editor_integer_code, 0, 0, 0);
  if (editor_integer_code >= 32 && editor_integer_code < 127) {
    int editor_integer_second = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_text), editor_integer_code, 0, 0, 0);
  }
} return void;
