editor_do_text(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  int editor_integer_from = fixed_point_minimum(5, len(editor_string_line));
  string editor_string_chars = str_sub(editor_string_line, editor_integer_from, len(editor_string_line) - editor_integer_from);
  int editor_integer_key_code = 0;
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  while (editor_integer_key_code < len(editor_string_chars)) {
    int editor_integer_position = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_text), character_code_at(editor_string_chars, editor_integer_key_code), 0, 0, 0);
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return void;
