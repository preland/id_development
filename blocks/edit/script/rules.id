// The rule violations of a session as text, as many lines as there are, each as
// the line number and the message `blocks check` prints (the code is at its end).

editor_state_rules(string[][] editor_string_session, int[][] editor_matrix_session) {
  string editor_string_all = "violations " + len(editor_string_session[(import constant_z_diag)]) + "\n";
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < len(editor_string_session[(import constant_z_diag)])) {
    editor_string_all = editor_string_all + "  line " + editor_matrix_session[(import constant_y_diagnostic_lines)][editor_integer_key_code] + ": " + editor_string_session[(import constant_z_diag)][editor_integer_key_code] + "\n";
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return string editor_string_all;
given editor_test_session("sprite S\nfn f() return void\n  move(10.0)\n") ((import editor_test_strings), (import editor_test_integers)):("violations 1\n  line 2: function 'f' has 0 test case(s); at least 2 are required [E0501]\n")
given editor_test_session("sprite S\n") ((import editor_test_strings), (import editor_test_integers)):("violations 0\n")
