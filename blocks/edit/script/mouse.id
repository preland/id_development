// The script words that are the pointer. down X Y [BUTTON [CLICKS]], up X Y and move X Y
// give the reducer the event the window would have given; a move reports the
// left button held while a press is going on. wheel X Y DY moves the pointer to
// (X, Y) first and then turns the wheel, DY notches (down positive).

editor_do_mouse(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string[] bet_field) {
  int editor_integer_kind = lst_str_index((import constant_mouse_verbs), bet_field[0]) + 3;
  int editor_integer_held = editor_matrix_session[(import constant_y_state)][(import constant_session_grab_kind)] != 0;
  int editor_integer_column_number = (editor_integer_kind == (import graph_view_event_down)) * editor_option_integer(bet_field, 3, 1) + (editor_integer_kind == (import graph_view_event_up)) + (editor_integer_kind == (import graph_view_event_move)) * editor_integer_held;
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string[] bet_field) {
  int editor_integer_paint = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_integer_kind, to_int(bet_field[1]), to_int(bet_field[2]), editor_integer_column_number, (editor_integer_kind == (import graph_view_event_down)) * editor_option_integer(bet_field, 4, 1));
} return void;
