// One line of a script: its word (conf.id's bkk_verbs) and fields, run as the
// events they stand for. A blank line and a line that starts with # do nothing and
// are fine. Answers 1 when the line is fine, 0 when its word is not one of
// bkk_verbs, it has fewer fields than the word needs (bkk_verb_need) or a save
// could not be written.

editor_command_word(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  string[] bet_field = str_split(editor_string_line, " ");
  int editor_integer_verb = lst_str_index((import constant_verbs), bet_field[0]);
  int editor_integer_act = (editor_integer_verb >= 0) * (len(bet_field) >= (import constant_verb_need)[fx_max(editor_integer_verb, 0)]) * (editor_integer_verb + 1);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  if (editor_integer_act == 1) {
    editor_do_wheel(editor_string_session, editor_matrix_session, editor_matrix_layout, bet_field);
  }
  if (editor_integer_act >= 2 && editor_integer_act <= 4) {
    editor_do_mouse(editor_string_session, editor_matrix_session, editor_matrix_layout, bet_field);
  }
  if (editor_integer_act == 5) {
    editor_do_key(editor_string_session, editor_matrix_session, editor_matrix_layout, bet_field);
  }
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  if (editor_integer_act == 6) {
    editor_do_text(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_string_line);
  }
  if (editor_integer_act == 7) {
    editor_do_size(editor_string_session, editor_matrix_session, editor_matrix_layout, bet_field);
  }
  if (editor_integer_act == 8) {
    editor_do_drag(editor_string_session, editor_matrix_session, editor_matrix_layout, bet_field);
  }
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  if (editor_integer_act == 9) {
    editor_do_click(editor_string_session, editor_matrix_session, editor_matrix_layout, (import constant_metric_pal) + (import constant_metric_flag_x) + 14, 18);
  }
  if (editor_integer_act == 10) {
    editor_do_click(editor_string_session, editor_matrix_session, editor_matrix_layout, (import constant_metric_pal) + (import constant_metric_stop_x) + 14, 18);
  }
  if (editor_integer_act == 11) {
    editor_do_frames(editor_string_session, editor_matrix_session, to_int(bet_field[1]));
  }
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string editor_string_line) {
  int editor_integer_record_count = 0;
  if (editor_integer_act == 12) {
    editor_integer_record_count = editor_do_save(editor_string_session, editor_matrix_session, bet_field[1]);
  }
  int editor_integer_ok = (editor_integer_act > 0) * (1 - editor_integer_record_count) + (bet_field[0] == "") + (str_starts(bet_field[0], "#") == 1);
} return int editor_integer_ok;
