// A session as text, for --dump after a script and for the cases: the camera, the
// palette's category, whether a literal is being typed (and what), the violations of
// the rules as `check` prints them, whether the program runs, the sprites and the
// document, a line to a line behind a bar so that a blank line and a trailing
// space show.

editor_state_head(string[][] editor_string_session, int[][] editor_matrix_session) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  string editor_string_cam = "camera " + bel_state[(import graph_view_state_pan_x)] + " " + bel_state[(import graph_view_state_pan_y)] + " " + bel_state[(import graph_view_state_zoom)] + "\n";
  string editor_string_tab = "tab " + (import constant_cat_name)[bel_state[(import constant_session_tab)]] + "\n";
} chain (string[][] editor_string_session, int[][] editor_matrix_session) {
  string editor_string_edited = "typing none\n";
  if (bel_state[(import constant_session_editing)] == 1) {
    editor_string_edited = "typing line " + bel_state[(import constant_session_element)] + " pill " + bel_state[(import constant_session_edit_start)] + " " + str_quote(editor_string_session[(import constant_z_buffer)][0]) + "\n";
  }
  string editor_string_head = editor_string_cam + editor_string_tab + editor_string_edited;
} return string editor_string_head;
given editor_test_session("sprite S\nfn f() return void\n  move(10.0)\n") ((import editor_test_strings), (import editor_test_integers)):("camera 16 16 100\ntab Motion\ntyping none\n")
