// The script words that are a gesture of the whole hand. drag X1 Y1 X2 Y2 presses at
// the first point, moves through the middle to the second and lets go there, the
// events a person's drag makes; the click on a button is a press and a release at
// one point. frames N gives the program N turns, as N frames of the window would.

editor_do_click(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_x, int editor_integer_y) {
  int editor_integer_first_value = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_down), editor_integer_x, editor_integer_y, 1, 1);
  int editor_integer_second = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_up), editor_integer_x, editor_integer_y, 1, 0);
} return void;
