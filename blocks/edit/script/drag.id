editor_do_drag(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string[] bet_field) {
  int[] bel_position = [to_int(bet_field[1]), to_int(bet_field[2]), to_int(bet_field[3]), to_int(bet_field[4])];
  int editor_integer_first_value = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_down), bel_position[0], bel_position[1], 1, 1);
  int editor_integer_second = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_move), (bel_position[0] + bel_position[2]) / 2, (bel_position[1] + bel_position[3]) / 2, 1, 0);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, string[] bet_field) {
  int editor_integer_column_number = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_move), bel_position[2], bel_position[3], 1, 0);
  int editor_integer_delta = editor_step(editor_string_session, editor_matrix_session, editor_matrix_layout, (import graph_view_event_up), bel_position[2], bel_position[3], 1, 0);
} return void;
