editor_do_frames(string[][] editor_string_session, int[][] editor_matrix_session, int editor_integer_count) {
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < editor_integer_count) {
    int editor_integer_ran = editor_tick(editor_string_session, editor_matrix_session);
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return void;
