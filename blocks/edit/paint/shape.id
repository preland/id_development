// The body of a box: an arm is a plain rectangle, anything else a rounded one with
// an edge a shade darker than its face; a box that breaks a rule (bad is 1) gets the
// red of conf.id's bkk_x_bad round it first, so it shows as an outline. The
// rectangle is [left, top, width, height] on the surface, rad the corner radius.

editor_shape(int editor_integer_kind, int[] bel_row_number, int editor_integer_face, int editor_integer_rad, int editor_integer_bad) {
  if (editor_integer_bad == 1) {
    draw_rounded_rectangle(bel_row_number[0] - 2, bel_row_number[1] - 2, bel_row_number[2] + 4, bel_row_number[3] + 4, editor_integer_rad + 2, (import constant_x_bad));
  }
  if (editor_integer_kind == (import constant_kind_arm)) {
    d2_l_rect(bel_row_number[0], bel_row_number[1], bel_row_number[2], bel_row_number[3], editor_integer_face);
  }
  if (editor_integer_kind != (import constant_kind_arm) && editor_integer_kind != (import constant_kind_note) && editor_integer_kind != (import constant_kind_label)) {
    editor_round(bel_row_number, editor_integer_face, editor_integer_rad);
  }
} return void;
