editor_round(int[] bel_row_number, int editor_integer_face, int editor_integer_rad) {
  draw_rounded_rectangle(bel_row_number[0], bel_row_number[1], bel_row_number[2], bel_row_number[3], editor_integer_rad, editor_dark(editor_integer_face));
  draw_rounded_rectangle(bel_row_number[0] + 1, bel_row_number[1] + 1, bel_row_number[2] - 2, bel_row_number[3] - 2, fixed_point_maximum(editor_integer_rad - 1, 0), editor_integer_face);
} return void;
