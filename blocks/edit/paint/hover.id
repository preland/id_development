editor_draw_tip(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  int editor_integer_x = bel_state[(import graph_view_state_mouse_x)] + (import constant_metric_pal);
  int editor_integer_y = bel_state[(import graph_view_state_mouse_y)] + (import constant_metric_bar);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout) {
  int editor_integer_key_code = editor_hit_box(editor_matrix_layout, bel_state, editor_integer_x, editor_integer_y) * (bel_state[(import constant_session_drag)] == 0) - (bel_state[(import constant_session_drag)] == 1);
  string[] bet_tip = editor_tip_lines(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_integer_key_code);
  if (len(bet_tip) > 0 && editor_in(editor_integer_x, editor_integer_y, (import constant_metric_pal), (import constant_metric_bar), bel_state[(import graph_view_state_width)] - (import constant_metric_pal) - (import constant_metric_stage), 4000) == 1) {
    graph_view_tip(bet_tip, editor_integer_x, editor_integer_y);
