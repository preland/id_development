// The tooltip under the pointer. The box under it is found (bke_hitbox) and the
// violations of its line are wrapped (bke_tiplines); when there are any they are
// drawn in the graph kit's tooltip box at the pointer. No tooltip while a block is
// being dragged, when the pointer is off the script area, or when the line is
// fine.

editor_tip_lines(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  string[] bet_tip = [];
  int editor_integer_line_text = list_get_or(editor_matrix_layout[(import constant_layout_line)], editor_integer_key_code, 0 - 2) + 1;
  int editor_integer_index = 0;
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  while (editor_integer_index < len(editor_matrix_session[(import constant_y_diagnostic_lines)])) {
    if (editor_matrix_session[(import constant_y_diagnostic_lines)][editor_integer_index] == editor_integer_line_text) {
      list_string_extend(bet_tip, editor_wrap(editor_string_session[(import constant_z_diag)][editor_integer_index], 56));
    }
    editor_integer_index = editor_integer_index + 1;
  }
} return string[] bet_tip;
