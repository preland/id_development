// A block drawn on its own, at zoom 100, with its top left at a point: a palette
// entry, and the block that follows the pointer in a drag. A statement is laid out as
// the one line of a document, so it looks exactly as it will in the script; a
// reporter is a single pill in the colour of its category.

editor_draw_layout(int[][] editor_matrix_layout, string[] bet_texts, int editor_integer_ox, int editor_integer_offset_vertical) {
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < len(bet_texts)) {
    editor_draw_one(editor_matrix_layout, bet_texts[editor_integer_key_code], editor_integer_key_code, editor_integer_ox, editor_integer_offset_vertical);
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return void;
