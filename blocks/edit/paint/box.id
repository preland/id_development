editor_draw_box(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  int[] bel_row_number = editor_rect(editor_matrix_layout, bel_state, editor_integer_key_code);
  int editor_integer_field = editor_flags(editor_string_session, editor_matrix_session, editor_matrix_layout, editor_integer_key_code);
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  int editor_integer_kind = editor_matrix_layout[(import constant_layout_kind)][editor_integer_key_code];
  int editor_integer_cat = editor_matrix_layout[(import constant_layout_cat)][editor_integer_key_code];
  int editor_integer_face = editor_face_color(editor_integer_kind, editor_integer_cat) + editor_integer_field / 2 % 2 * ((import constant_x_typing) - editor_face_color(editor_integer_kind, editor_integer_cat));
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  int editor_integer_rad = fx_max(graph_view_screen(4, 0, bel_state[(import graph_view_state_zoom)]), 1);
  editor_shape(editor_integer_kind, bel_row_number, editor_integer_face, editor_integer_rad, editor_integer_field % 2);
  editor_words(editor_shown(editor_string_session, editor_integer_key_code, editor_integer_field), editor_integer_kind, editor_integer_cat, bel_row_number, bel_state[(import graph_view_state_zoom)]);
} return void;
