// One box of the layout on the surface. bke_flags says what is special about it: bit
// 0 when a rule that its line breaks outlines it (the violations are kept as
// the 1-based line they are on), bit 1 when it is the pill being typed into.
// bke_shown is the text it shows (what has been typed, and a caret, for that pill).
// bke_draw_box draws its body and then its text.

editor_flags(string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  int[] bel_state = editor_matrix_session[(import constant_y_state)];
  int editor_integer_line_text = editor_matrix_layout[(import constant_layout_line)][editor_integer_key_code];
  int editor_integer_kind = editor_matrix_layout[(import constant_layout_kind)][editor_integer_key_code];
} chain (string[][] editor_string_session, int[][] editor_matrix_session, int[][] editor_matrix_layout, int editor_integer_key_code) {
  int editor_integer_bad = (import constant_hot)[editor_integer_kind] == 1 && lst_index_of(editor_matrix_session[(import constant_y_diagnostic_lines)], editor_integer_line_text + 1) >= 0;
  int editor_integer_typing = editor_integer_kind == (import constant_kind_pill) && bel_state[(import constant_session_editing)] == 1 && editor_integer_line_text == bel_state[(import constant_session_element)] && editor_matrix_layout[(import constant_layout_segment)][editor_integer_key_code] == bel_state[(import constant_session_edit_start)];
  int editor_integer_bits = editor_integer_bad + 2 * editor_integer_typing;
} return int editor_integer_bits;
