editor_shown(string[][] editor_string_session, int editor_integer_key_code, int editor_integer_flags) {
  string editor_string_text_list = editor_string_session[(import constant_z_text)][editor_integer_key_code];
  if (editor_integer_flags / 2 % 2 == 1) {
    editor_string_text_list = editor_string_session[(import constant_z_buffer)][0] + "_";
  }
} return string editor_string_text_list;
