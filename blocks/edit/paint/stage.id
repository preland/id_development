editor_draw_bubble(string editor_string_say, int[] bel_position, int editor_integer_origin) {
  int editor_integer_count = fixed_point_minimum(len(editor_string_say), (import constant_metric_bub));
  string editor_string_text_list = str_sub(editor_string_say, 0, editor_integer_count);
  int editor_integer_width = len(editor_string_text_list) * 8 + 12;
} chain (string editor_string_say, int[] bel_position, int editor_integer_origin) {
  int editor_integer_x = fixed_point_clamp(bel_position[0] - editor_integer_width / 2, editor_integer_origin, editor_integer_origin + (import constant_metric_stage_width) - editor_integer_width);
  int editor_integer_y = fixed_point_maximum(bel_position[1] - bel_position[2] - 22, (import constant_metric_bar) + (import constant_metric_stage_margin));
  draw_rounded_rectangle(editor_integer_x, editor_integer_y, editor_integer_width, 18, 5, (import constant_x_ink));
} chain (string editor_string_say, int[] bel_position, int editor_integer_origin) {
