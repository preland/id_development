// The stage panel on the right. The machine's sprites are drawn as they are in the
// session: a disc in the colour of its place in the order, with a line out of it
// in the direction it faces (90 is right, 0 is up), a speech bubble with what it
// last said, and under the stage a list of them with their numbers. The stage
// runs 480 units across, drawn 3 in 5 of that.

editor_stage_point(int[] bel_state, int[] bel_geometry, int editor_integer_index) {
  int editor_integer_origin = bel_state[(import graph_view_state_width)] - (import constant_metric_stage) + (import constant_metric_stage_margin);
  int editor_integer_cell_x = editor_integer_origin + (import constant_metric_stage_width) / 2 + bel_geometry[5 * editor_integer_index] * 3 / 5;
  int editor_integer_cell_y = (import constant_metric_bar) + (import constant_metric_stage_margin) + (import constant_metric_stage_height) / 2 - bel_geometry[5 * editor_integer_index + 1] * 3 / 5;
} chain (int[] bel_state, int[] bel_geometry, int editor_integer_index) {
  int editor_integer_row_number = fixed_point_maximum(bel_geometry[5 * editor_integer_index + 3] * (import constant_metric_sprite_row) / 100, 3);
  int[] bel_position = [editor_integer_cell_x, editor_integer_cell_y, editor_integer_row_number];
} return int[] bel_position;
