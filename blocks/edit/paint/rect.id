// Where a box of the layout is on the surface. The script area shows the layout
// through the camera of the state (pan in pixels, zoom in percent: the graph kit's
// graph_view_screen applies it) and starts bkk_c_pal across and bkk_c_bar down. The answer
// is [left, top, width, height] in pixels; the size is never less than a pixel.

editor_rect(int[][] editor_matrix_layout, int[] bel_state, int editor_integer_key_code) {
  int editor_integer_zoom = bel_state[(import graph_view_state_zoom)];
  int editor_integer_x = graph_view_screen(editor_matrix_layout[(import constant_layout_x)][editor_integer_key_code], bel_state[(import graph_view_state_pan_x)] + (import constant_metric_pal), editor_integer_zoom);
  int editor_integer_y = graph_view_screen(editor_matrix_layout[(import constant_layout_y)][editor_integer_key_code], bel_state[(import graph_view_state_pan_y)] + (import constant_metric_bar), editor_integer_zoom);
} chain (int[][] editor_matrix_layout, int[] bel_state, int editor_integer_key_code) {
  int editor_integer_width = fx_max(graph_view_screen(editor_matrix_layout[(import constant_layout_width)][editor_integer_key_code], 0, editor_integer_zoom), 1);
  int editor_integer_height = fx_max(graph_view_screen(editor_matrix_layout[(import constant_layout_height)][editor_integer_key_code], 0, editor_integer_zoom), 1);
  int[] bel_row_number = [editor_integer_x, editor_integer_y, editor_integer_width, editor_integer_height];
} return int[] bel_row_number;
