editor_pal_function_first(string[] bet_texts, int[] bel_repeat_position, string editor_string_header) {
  push(bet_texts, editor_call_of(editor_string_header));
  push(bel_repeat_position, str_find(editor_string_header, ") return void") < 0);
} return void;
([], [], "fn f() return void"):(["f()"], [0], "fn f() return void")
([], [], "fn f(int a) return string"):(["f(0)"], [1], "fn f(int a) return string")
