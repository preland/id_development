// Where a statement's arguments are. A pill is a span of the line's text, as a
// start and an end (end excluded); bke_spans answers them all, flat, so pill k
// is cells 2k and 2k+1. The text of the line is cut by tokens (scan.id), the
// brackets of a call or an index kept at the outer level by their depth.

editor_range(int[] bel_sprites, int[][] editor_matrix_text_list, int editor_integer_first_value, int editor_integer_second) {
  if (editor_integer_first_value <= editor_integer_second) {
    list_extend(bel_sprites, [editor_matrix_text_list[0][editor_integer_first_value], editor_matrix_text_list[1][editor_integer_second]]);
  }
} return void;
([], [[1, 4, 6], [3, 5, 9], [0, 0, 0]], 1, 2):([4, 9])
([7], [[1, 4, 6], [3, 5, 9], [0, 0, 0]], 2, 1):([7])

editor_close(string[] bet_titles, int[] bel_delta, int editor_integer_from) {
  int editor_integer_key_code = editor_integer_from;
  while (editor_integer_key_code < len(bet_titles) && (bel_delta[editor_integer_key_code] != 0 || (bet_titles[editor_integer_key_code] != ")" && bet_titles[editor_integer_key_code] != "]"))) {
    editor_integer_key_code = editor_integer_key_code + 1;
  }
} return int editor_integer_key_code;
(["f", "(", "a", ")"], [0, 0, 1, 0], 2):(3)
(["f", "(", "g", "(", ")", ")"], [0, 0, 1, 1, 1, 0], 2):(5)
(["f", "(", "a"], [0, 0, 1], 2):(3)

editor_equal(string[] bet_titles, int[] bel_delta) {
  int editor_integer_key_code = 0;
  while (editor_integer_key_code < len(bet_titles) && (bet_titles[editor_integer_key_code] != "=" || bel_delta[editor_integer_key_code] != 0)) {
    editor_integer_key_code = editor_integer_key_code + 1;
  }
  int editor_integer_at = editor_integer_key_code - (editor_integer_key_code >= len(bet_titles)) * (editor_integer_key_code + 1);
} return int editor_integer_at;
(["x", "=", "1"], [0, 0, 0]):(1)
(["f", "(", "a", "=", ")"], [0, 0, 1, 1, 0]):(-1)
(["x", "==", "1"], [0, 0, 0]):(-1)
