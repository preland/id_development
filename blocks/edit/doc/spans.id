// The pills of a block line: the spans of its text that are arguments. The form
// of the line says where they are: 0 none (else, break), 1 the rest of the line
// (if, while, return), 2 an assignment or a declaration (the index of an element
// and the value), 3 a call (each argument), 4 a bare expression (all of it, as a
// palette reporter is).

editor_form(string[] bet_titles, int[] bel_delta) {
  int editor_integer_field = 4;
  if (list_string_index((import constant_rest_width), bet_titles[0]) >= 0) {
    editor_integer_field = 1;
  }
  if (list_string_index((import constant_none_width), bet_titles[0]) >= 0) {
    editor_integer_field = 0;
  }
} chain (string[] bet_titles, int[] bel_delta) {
  if (editor_integer_field == 4 && editor_equal(bet_titles, bel_delta) >= 0) {
    editor_integer_field = 2;
  }
  if (editor_integer_field == 4 && len(bet_titles) > 1 && bet_titles[1] == "(") {
    editor_integer_field = 3;
  }
} return int editor_integer_field;
(["else"], [0]):(0)
(["while", "a"], [0, 0]):(1)
(["return"], [0]):(1)
(["x", "=", "1"], [0, 0, 0]):(2)
(["f", "(", ")"], [0, 0, 0]):(3)
(["1", "+", "1"], [0, 0, 0]):(4)
(["f", "(", "a", "=", ")"], [0, 0, 1, 1, 0]):(3)

editor_spans(string editor_string_unit) {
  string[] bet_titles = [];
  int[][] editor_matrix_text_list = editor_scan(editor_string_unit, bet_titles);
  int[] bel_sprites = [];
} chain (string editor_string_unit) {
  if (len(bet_titles) > 0) {
    editor_fill(bel_sprites, bet_titles, editor_matrix_text_list);
  }
} return int[] bel_sprites;
("move(10.0)"):([5, 9])
("goto(0.0, 0.0)"):([5, 8, 10, 13])
("say(\"a, b\")"):([4, 10])
("if a > 0"):([3, 8])
("x = n * 2"):([4, 9])
("xs[i + 1] = f(2, 3)"):([3, 8, 12, 19])
("int[] xs = [3, 1]"):([11, 17])
("f(g(1, 2), 3)"):([2, 9, 11, 12])
("return a + 1"):([7, 12])
("1 + 1"):([0, 5])
("else"):([])
("break"):([])
("return"):([])
("show()"):([])
(""):([])

editor_fill(int[] bel_sprites, string[] bet_titles, int[][] editor_matrix_text_list) {
  int editor_integer_field = editor_form(bet_titles, editor_matrix_text_list[2]);
  if (editor_integer_field == 1 || editor_integer_field == 4) {
    editor_range(bel_sprites, editor_matrix_text_list, editor_integer_field == 1, len(bet_titles) - 1);
  }
  if (editor_integer_field == 2) {
    editor_assign(bel_sprites, bet_titles, editor_matrix_text_list, editor_equal(bet_titles, editor_matrix_text_list[2]));
  }
} chain (int[] bel_sprites, string[] bet_titles, int[][] editor_matrix_text_list) {
  if (editor_integer_field == 3) {
    editor_call(bel_sprites, bet_titles, editor_matrix_text_list);
  }
} return void;
([], ["if", "a"], [[0, 3], [2, 4], [0, 0]]):([3, 4])
([], ["1", "+", "1"], [[0, 2, 4], [1, 3, 5], [0, 0, 0]]):([0, 5])
([], ["f", "(", "a", ")"], [[0, 1, 2, 3], [1, 2, 3, 4], [0, 0, 1, 0]]):([2, 3])
([], ["x", "=", "1"], [[0, 2, 4], [1, 3, 5], [0, 0, 0]]):([4, 5])
([], ["else"], [[0], [4], [0]]):([])
