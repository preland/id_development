// The one-line report gfx_demo prints before it paints anything, so a run
// that never gets a picture on screen still says where the framebuffer is.
gfx_demo_report(word w) {
  word fb_h_v = fb_h();
  string hexw_v = fb_base_hex();
  print("fb: " + w + "x" + fb_h_v + " at " + hexw_v);
} return void;

fb_base_hex() {
  word fb_base_v = fb_base();
  string ret_s = hexw(fb_base_v);
} return string ret_s;
