// Proof that there is a framebuffer and that it is where the adapter said.
//
// Three bands of flat colour and a white diagonal. Flat colour says the
// address and the stride are right; a diagonal says the two are right
// *together*, because a wrong stride turns a diagonal into a vertical line and
// leaves the bands looking perfect.
gfx_demo() {
  word w = fb_open(640, 480);
  print("fb: " + w + "x" + fb_h() + " at " + hexw(fb_base()));
  gfx_paint(w);
} return void;

gfx_paint(word w) {
  if(w > 0) {
    gfx_bands(w);
    gfx_diag(w);
    gfx_check(w);
  }
} return void;

gfx_bands(word w) {
  word y = 0;
  while(y < fb_h()) {
    gfx_row(w, y);
    y = y + 1;
  }
} return void;
