// A white diagonal from the top left. A wrong stride leaves the bands looking
// right and turns this into a vertical line, which is the whole reason it is
// here rather than a fourth band.
gfx_diag(word w) {
  word x = 0;
  while(x < w && x < fb_h()) {
    gfx_dot(x);
    x = x + 1;
  }
} return void;

gfx_dot(word x) {
  fb_px(x, x, 0x00ffffff);
  fb_px(x + 1, x, 0x00ffffff);
} return void;
