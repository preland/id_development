// The on-diagonal sample and the off-diagonal sample beside it -- the pair
// that differs only by the stride, which is the whole point of this test.
gfx_check_diag() {
  string diag_s = gfx_diag_str();
  print("fb: diag " + diag_s);
} return void;

gfx_diag_str() {
  string h4 = read_hex(100, 100);
  string h5 = read_hex(100, 300);
  string ret_s = h4 + " off " + h5;
} return string ret_s;
