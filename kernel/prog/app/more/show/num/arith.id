// Integer arithmetic.
//
// The first line is instructions; the second is not. `/` and `%` are calls
// into the runtime, and the negative cases are there because docs/SPEC.md 2.2
// pins the sign of both -- truncation toward zero, and a remainder that takes
// the dividend's sign -- which is a decision a division helper can get wrong
// without any of the positive cases noticing.

show_arith() {
  print("arith: sum=" + (7 + 5) + " diff=" + (7 - 5) + " prod=" + (7 * 5));
} return void;

// The unsigned readings are on the second line with a dividend of all ones,
// which is the value that tells the two divides apart: signed it is -1, and
// unsigned it is the largest word there is.
show_div() {
  print("div: " + (47 / 5) + " " + (47 % 5) + " " + ((0 - 47) / 5) + " " + ((0 - 47) % 5));
  show_udiv();
  show_word();
} return void;

// A `word` printed as text, at both ends of its range. The runtime strips the
// sign and then divides unsigned, which is the only way the most negative word
// comes out right -- negating it lands on itself, and its digits exist only as
// an unsigned magnitude.
show_word() {
  print("word: " + 0x8000000000000000 + " " + 0x7fffffffffffffff + " " + 0xffffffffffffffff);
} return void;
