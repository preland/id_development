// The 64/32 print and the 16/8 print are two functions rather than one so
// that neither exceeds the action limit -- store_report1 chains straight
// into store_line2 because store_line already spent its own budget getting
// the first pair of reads named.
store_report1(word a, word peek64_v, word peek32_v) {
  print("store: 64=" + peek64_v + " 32=" + peek32_v);
  store_line2(a);
} return void;

store_line2(word a) {
  word peek16_v = peek16(a + 8);
  word peek8_v = peek8(a + 10);
  print("store: 16=" + peek16_v + " 8=" + peek8_v);
} return void;
