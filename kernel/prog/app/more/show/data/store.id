// The flat store.
//
// Here the store is not a simulation of memory, it is the machine's memory:
// `alloc` hands out addresses above the kernel image. The reads deliberately
// do not line up with the writes -- a 32-bit read from the middle of a 64-bit
// write, a byte read where a byte was written -- because that is what shows
// the little-endian layout docs/SPEC.md 6 requires rather than just showing
// that a value written comes back.

show_store() {
  word a = alloc(16);
  fill_store(a);
  store_line(a);
} return void;

fill_store(word a) {
  poke64(a, 0x1122334455667788);
  poke16(a + 8, 0xcafe);
  poke8(a + 10, 90);
} return void;

store_line(word a) {
  print("store: 64=" + peek64(a) + " 32=" + peek32(a + 4));
  print("store: 16=" + peek16(a + 8) + " 8=" + peek8(a + 10));
} return void;
