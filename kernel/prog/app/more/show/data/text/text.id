// Strings.
//
// `"n=" + 42` is the whole point of the first line: concatenation and
// number-to-text are two runtime calls the compiler emits for one `+`, and
// neither of them exists until the runtime provides it.
//
// The second line ends on the two bridges between a string and the flat store,
// which are one crossing rather than two copies here -- a string *is* an
// address in the memory `alloc` hands out, so `mem_of_str` is the identity and
// `str_of_mem` is the only one that has to build anything.
//
// The third line is string comparison, which is the one runtime call whose
// *name* depends on the build: hosted it is libc's strcmp, freestanding it is
// the runtime's own id_strcmp, and nothing here says which.

show_str() {
  string s = "n=" + 42;
  show_str_line(s);
  show_str2(s);
} return void;

show_str_line(string s) {
  int len_v = len(s);
  string chr_v = chr(65);
  print("str: " + s + " len=" + len_v + " chr=" + chr_v);
} return void;

show_str2(string s) {
  show_str2_conv(s);
  show_str2_cmp(s);
} return void;
