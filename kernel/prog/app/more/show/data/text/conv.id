// `at=` and `int=` are formatted together before the print, and the round
// trip through the flat store is kept as its own crossing -- see text.id for
// why `str_of_mem` is the only direction that builds anything.
show_str2_conv(string s) {
  string at_int_s = conv_at_int(s);
  string mem_s = mem_round_trip(s);
  print("str: " + at_int_s + " mem=" + mem_s);
} return void;

conv_at_int(string s) {
  int charat_v = charat(s, 0);
  int to_int_v = to_int("-123");
  string ret_s = "at=" + charat_v + " int=" + to_int_v;
} return string ret_s;

mem_round_trip(string s) {
  word mem_of_str_v = mem_of_str(s);
  string ret_s = str_of_mem(mem_of_str_v, 3);
} return string ret_s;
