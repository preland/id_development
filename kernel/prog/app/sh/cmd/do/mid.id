// The middle of the chain. Each of these is one link: two names, and the rest
// of the table. See `exec.id` for why the table is shaped like this.

sh_do2(string name, string t) {
  if(name == "cd") {
    sh_cd(t);
  } else if(name == "pwd") {
    sh_pwd();
  } else {
    sh_do3(name, t);
  }
} return void;

sh_do3(string name, string t) {
  if(name == "cat") {
    sh_cat(t);
  } else if(name == "echo") {
    sh_echo(t);
  } else {
    sh_do4(name, t);
  }
} return void;

sh_do4(string name, string t) {
  if(name == "mkdir") {
    sh_mkdir(t);
  } else if(name == "touch") {
    sh_touch(t);
  } else {
    sh_do5(name, t);
  }
} return void;
