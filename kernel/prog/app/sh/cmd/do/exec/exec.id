// The command table.
//
// It is a chain of `if` on the command name, eight functions long, and there
// is no better way to write it: `id` has no function pointers, no table of
// closures and no `switch`, and `docs/DISPATCH.md` argues at length that it
// should not get the first two. The blocks hold three actions each, and an
// `if` and every chained `else` is one of them, so a function can test two
// names and pass the rest along -- which is exactly what these do.
//
// Written out, the cost of the missing feature is visible: fifteen commands
// need eight functions and four files to reach, and adding a sixteenth means
// editing the tail of the chain rather than adding a line beside the command
// it belongs to.

// One line: the command is the first word, the argument text is everything
// after the spaces that follow it. Splitting arguments any further is left to
// the commands that take more than one, because only `write` does.
sh_exec(string s) {
  int at = sp_at(s, 0);
  string cut_v = cut(s, 0, at);
  sh_exec_body(s, at, cut_v);
} return void;

// An empty line is not an unknown command. Pressing Enter at a prompt is the
// commonest thing a person does to a shell and it should say nothing at all.
sh_pick(string name, string t) {
  if(len(name) > 0) {
    sh_do1(name, t);
  }
} return void;

sh_do1(string name, string t) {
  if(name == "help") {
    sh_help();
  } else if(name == "ls") {
    sh_ls(t);
  } else {
    sh_do2(name, t);
  }
} return void;
