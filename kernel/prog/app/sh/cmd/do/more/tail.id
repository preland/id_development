// The tail of the command table, continued from `mid.id`.

sh_do5(string name, string t) {
  if(name == "write") {
    sh_write(t);
  } else if(name == "rm") {
    sh_rm(t);
  } else {
    sh_do6(name, t);
  }
} return void;

sh_do6(string name, string t) {
  if(name == "clear") {
    sh_clear();
  } else if(name == "uname") {
    sh_uname();
  } else {
    sh_do7(name, t);
  }
} return void;

sh_do7(string name, string t) {
  if(name == "mem") {
    sh_mem();
  } else if(name == "halt") {
    sh_halt();
  } else {
    sh_do8(name, t);
  }
} return void;
