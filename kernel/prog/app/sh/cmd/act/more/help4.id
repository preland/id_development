// The rest of the help text, continued from `help.id`.
sh_help4() {
  con_line("touch PATH       make an empty file");
  con_line("write PATH TEXT  put TEXT in a file, making it if need be");
  sh_help5();
} return void;

sh_help5() {
  con_line("rm PATH          remove a file or a directory");
  con_line("clear            blank the screen");
  sh_help6();
} return void;

sh_help6() {
  con_line("uname  mem       what this is, and how much store is used");
  con_line("halt   fault     stop the machine, or touch an unmapped page");
} return void;
