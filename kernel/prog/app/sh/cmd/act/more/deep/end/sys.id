// `uname`. There is no version number to read from anywhere, so this is the
// one string in the shell that has to be kept true by hand.
sh_uname() {
  con_line("id kernel -- x86_64, no libc, no operating system under it");
} return void;

// `mem`. The high-water mark of the flat store, which is also the arena every
// string and list in this shell came out of, and which only ever grows.
sh_mem() {
  word store_size_v = store_size();
  con_line("store: " + store_size_v + " bytes handed out, none reclaimed");
} return void;

// `fault`. The boot stub identity-maps the first four gigabytes and nothing
// above them, so a read at five has no page behind it. It is a command rather
// than something the kernel does on its way past, so that the fault handler
// can be demonstrated at the moment somebody asks for it -- which is the only
// way to show that it is the handler running and not the boot sequence.
sh_fault() {
  con_line("fault: reading 0x140000000, which has no page behind it");
  peek64(0x140000000);
} return void;
