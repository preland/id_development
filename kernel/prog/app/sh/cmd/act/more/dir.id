// `ls`, of the working directory when it is given nothing.
//
// Listing a file prints nothing rather than printing the file's own name,
// which is where this stops matching Unix; the node has no children and the
// walk over the parent list finds none.
sh_ls(string t) {
  int at = fs_to(t);
  if(at < 0) {
    con_line("ls: no such path: " + t);
  } else {
    ls_at(at);
  }
} return void;

// `cd`. Two functions rather than one because the two failures are separate
// questions -- does the path exist, and is it a directory -- and testing both
// in one condition would index the node lists with -1 when the answer to the
// first is no.
sh_cd(string t) {
  int at = fs_to(t);
  if(at < 0) {
    con_line("cd: no such directory: " + t);
  } else {
    sh_cd2(at, t);
  }
} return void;

sh_cd2(int at, string t) {
  if((import fs_dir)[at] == 1) {
    fs_set(at);
  } else {
    con_line("cd: not a directory: " + t);
  }
} return void;
