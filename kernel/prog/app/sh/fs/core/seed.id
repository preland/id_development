// What is in the filesystem when the machine starts, because `ls` of an empty
// root teaches nobody anything and `cat` of nothing cannot be told from `cat`
// of a file that failed to be read.
//
// The working directory is pushed here rather than in `fs_init3`, which
// declared the list: an exported list is initialised when its declaring
// function runs, and a function that both declares and fills one has spent two
// of its three actions before it has a root to make.
fs_seed() {
  push((import fs_cwd), 0);
  fs_new(0, 1, "", "");
  fs_seed2();
} return void;

// The parents are written as literal indices -- 0 is the root, and the two
// directories made here are 2 and 3 -- because `fs_path` cannot be used until
// the nodes it would look for exist. This is the only place in the shell that
// knows a node's index by counting.
fs_seed2() {
  fs_new(0, 0, "README", "a shell and an in-memory filesystem, both written in id, on a kernel with no libc under it");
  fs_new(0, 1, "bin", "");
  fs_seed3();
} return void;

fs_seed3() {
  fs_new(0, 1, "doc", "");
  fs_new(2, 0, "hello", "echo hello from a kernel with no operating system under it");
  fs_new(3, 0, "shell", "the command table is a chain of if on the name; docs/DISPATCH.md says why there is nothing better");
} return void;
