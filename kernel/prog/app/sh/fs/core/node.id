// A new node, appended to every list at once. Its index is the length of the
// lists afterwards, less one -- which is also the only way to learn it, since
// nothing here hands out identities.
//
// The four lists have to be pushed in step. Nothing checks that they are; the
// price of a record made of parallel lists is that the compiler cannot see the
// record, so a missing push is a shear that shows up as the wrong file's
// contents rather than as an error.
fs_new(int up, int dir, string name, string t) {
  push((import fs_name), name);
  push((import fs_up), up);
  fs_new2(dir, t);
} return int len((import fs_name)) - 1;

fs_new2(int dir, string t) {
  push((import fs_dir), dir);
  push((import fs_data), t);
} return void;

// A write through a `string[]` somebody else owns. `(import xs)[i] = v` is
// rejected at compile time (docs/SPEC.md 5) and there is no `idstd` in a
// freestanding build to borrow `sset` from, so the kernel carries its own --
// beside `lset` for `int[]` and `wset` for `word[]`, which are the same
// function at the other two widths and cannot be written once.
sset(string[] rows, int i, string s) {
  rows[i] = s;
} return void;
