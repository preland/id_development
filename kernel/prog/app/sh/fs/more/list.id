// Listing a directory: every node whose parent is this one, in the order they
// were made, which is also the order they were pushed.
//
// Node 0 is skipped because the root is its own parent and would otherwise
// list itself as a child of itself, forever visible in `ls /`.
ls_at(int at) {
  int i = 1;
  while(i < len((import fs_name))) {
    ls_one(i, at);
    i = i + 1;
  }
} return void;

ls_one(int i, int at) {
  if((import fs_up)[i] == at) {
    string ls_name_v = ls_name(i);
    con_line(ls_name_v);
  }
} return void;

// A trailing slash marks a directory. There are no columns and no widths to
// pad to: one name per line is what a console eighty characters wide and a
// shell with no `printf` can agree on.
ls_name(int i) {
  string s = (import fs_name)[i];
  if((import fs_dir)[i] == 1) {
    s = s + "/";
  }
} return string s;
