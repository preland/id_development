// Where the last segment of a path begins: one past the last slash, or 0 when
// there is none. Making a node needs the path split there -- everything before
// it names the directory it goes in, everything after it is its own name.
fs_last(string t) {
  int i = 0;
  int at = 0;
  while(i < len(t)) {
    at = fs_bar(t, i, at);
    i = i + 1;
  }
} return int at;

fs_bar(string t, int i, int at) {
  if(charat(t, i) == 47) {
    at = i + 1;
  }
} return int at;

// The directory a path's last segment goes in. A path with no slash in it goes
// in the working directory; otherwise the part up to and including the last
// slash is itself a path, and resolving it is the same walk as any other -- so
// `mkdir ../tmp/x` works for the same reason `cd ../tmp` does.
fs_par(string t) {
  int at = fs_here();
  if(fs_last(t) > 0) {
    at = fs_path(cut(t, 0, fs_last(t)));
  }
} return int at;
