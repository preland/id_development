// Where the segment starting at `i` ends: the next slash, or the end of the
// string.
fs_end(string s, int i) {
  while(charat(s, i) != 47 && charat(s, i) != 0 - 1) {
    i = i + 1;
  }
} return int i;

// The working directory. It is a one-cell list rather than a number because an
// exported scalar may only be assigned by the function that declared it, and
// `cd` is not that function.
fs_here() {
  int ret_i = (import fs_cwd)[0];
} return int ret_i;

fs_set(int at) {
  lset((import fs_cwd), 0, at);
} return void;
