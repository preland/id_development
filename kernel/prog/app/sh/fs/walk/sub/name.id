// The absolute path of a node, built by walking up to the root.
//
// It grows at the front, which means a new string per level -- the O(n^2) that
// `docs/TODO.md` item 10 warns about. It is left that way because a path is a
// handful of segments and the alternative, packing the segments into the flat
// store backwards, would be three functions to save nothing measurable.
fs_pwd(int at) {
  string s = "";
  while(at > 0) {
    s = "/" + (import fs_name)[at] + s;
    at = (import fs_up)[at];
  }
} return string fs_slash(s);

// The root's path is the one that does not fall out of the loop: it has no
// segments, and "" is not a path.
fs_slash(string s) {
  if(len(s) == 0) {
    s = "/";
  }
} return string s;

// A path argument, where an absent one means the working directory. This is
// what makes `ls` with nothing after it mean `ls .`.
fs_to(string t) {
  int at = fs_here();
  if(len(t) > 0) {
    at = fs_path(t);
  }
} return int at;
