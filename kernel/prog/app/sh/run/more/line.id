// One line, read a character at a time and turned into a string once.
//
// The characters accumulate in an `int[]` rather than in a `string`, because
// `s = s + chr(c)` copies the whole line on every keystroke and is therefore
// O(n^2) in this language (docs/TODO.md item 10). Eighty characters would not
// notice; the habit is what matters, and the flat store makes the one-shot
// version shorter anyway.
sh_line() {
  int[] xs = [];
  sh_read(xs);
  string ret_s = sh_str(xs);
} return string ret_s;

// Both endings of a line are accepted: the PS/2 table maps Enter to 10, and a
// terminal on the serial port sends 13. A shell that answers only one of them
// works for exactly one of its two inputs.
sh_read(int[] xs) {
  int ch = tty_wait();
  while(ch != 10 && ch != 13) {
    sh_key(xs, ch);
    ch = tty_wait();
  }
  con_ch(10);
} return void;

// Backspace arrives as 8 from the keyboard table and as 127 from a terminal,
// and both mean the same thing. Anything below a space that is not one of
// those is dropped rather than echoed, because a control character drawn from
// the font is a glyph nobody meant to type.
sh_key(int[] xs, int ch) {
  if(ch == 8 || ch == 127) {
    sh_back(xs);
  } else if(ch >= 32) {
    sh_put(xs, ch);
  }
} return void;
