// An ordinary character: remembered, and echoed so that typing is visible.
// The console has no echo of its own -- nothing here is a terminal driver.
sh_put(int[] xs, int ch) {
  push(xs, ch);
  con_ch(ch);
} return void;

// Backspace at the start of a line does nothing, rather than popping an empty
// list, which traps (docs/SPEC.md 5) and would take the kernel with it.
sh_back(int[] xs) {
  if(len(xs) > 0) {
    sh_pop(xs);
  }
} return void;

// The buffer and the screen have to lose the character together; either one
// alone is a line that does not say what it is.
sh_pop(int[] xs) {
  pop(xs);
  sh_erase();
} return void;
