// A list, built by pushing and read back by index.
//
// Six elements rather than three, because a fresh list has room for four: the
// fifth push is the one that doubles the capacity and copies the cells, and a
// list that never grew would not have tested the half of the implementation
// most likely to be wrong.

show_list() {
  int[] xs = [];
  fill(xs);
  list_line(xs);
} return void;

fill(int[] xs) {
  int i = 0;
  while(i < 6) {
    push(xs, (i + 1) * 10);
    i = i + 1;
  }
} return void;

list_line(int[] xs) {
  xs[1] = 99;
  print("list: len=" + len(xs) + " [0]=" + xs[0] + " [1]=" + xs[1] + " [5]=" + xs[5]);
  pop_line(pop(xs), xs);
} return void;
