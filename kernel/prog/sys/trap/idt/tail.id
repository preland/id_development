// The three halves cut off idt.id and more.id for the action limit: the read
// idt_fill loops over, the high dword of the offset idt_gate3 writes, and the
// descriptor idt_load points the register at.
idt_read(int i) {
  word isr_base_v = isr_base();
  word ret_w = peek64(isr_base_v + i * 8);
} return word ret_w;

idt_gate4(word a, word p) {
  word ushr_v2 = ushr(p, 32);
  poke32(a + 8, ushr_v2);
  poke32(a + 12, 0);
} return void;

idt_load_fill(word p, word a) {
  poke16(p, 0x0fff);
  poke64(p + 2, a);
} return void;
