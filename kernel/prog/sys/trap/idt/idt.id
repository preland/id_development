// The interrupt descriptor table.
//
// 256 entries of 16 bytes, of which the first 32 are the CPU's exceptions and
// the rest are left absent -- an interrupt with no descriptor is itself a
// fault, which is the honest answer until there is something to route to.
//
// A descriptor is six fields at fixed offsets, so it is written with poke
// rather than described: the language has no way to say "this record is laid
// out thus", and a comment plus four pokes is the whole of what a struct would
// have bought here.
//
//   0  offset bits 0..15        6  offset bits 16..31
//   2  code segment selector    8  offset bits 32..63
//   4  IST index, then type    12  reserved

idt_init() {
  word a = alloc(4096);
  idt_fill(a, 0);
} return word idt_load(a);

idt_fill(word a, int i) {
  while(i < 32) {
    idt_gate(a + i * 16, peek64(isr_base() + i * 8));
    i = i + 1;
  }
} return void;

// Present, ring 0, 64-bit interrupt gate (0x8E), through the code segment the
// boot stub's GDT put at offset 8 -- which is the selector the far jump into
// long mode already loaded, so anything else here would fault on the first
// interrupt rather than on the load.
idt_gate(word a, word p) {
  poke16(a, p & 0xffff);
  idt_gate2(a, p);
} return void;
