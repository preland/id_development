// 0x8e00 is the two bytes at offset 4 read little-endian: an IST index of
// zero, then 0x8e -- present, ring 0, 64-bit interrupt gate. Writing 0x9000
// here instead sets the present bit and a type of zero, which is not a gate at
// all: the page fault then raised a general protection fault, that raised a
// double fault, and the machine tripled and reset without a word.
idt_gate2(word a, word p) {
  poke16(a + 2, 8);
  poke16(a + 4, 0x8e00);
  idt_gate3(a, p);
} return void;

idt_gate3(word a, word p) {
  poke16(a + 6, ushr(p, 16) & 0xffff);
  poke32(a + 8, ushr(p, 32));
  poke32(a + 12, 0);
} return void;

// The register takes a limit and a base, not a table: ten bytes somewhere the
// instruction can read them from.
idt_load(word a) {
  word p = alloc(16);
  poke16(p, 0x0fff);
  poke64(p + 2, a);
} return word lidt_load(p);
