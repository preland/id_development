// What a fault says.
//
// Called from the stubs in kernel/boot/isr.S with the vector, the error code
// and the instruction that faulted. Everything below the entry point is
// ordinary `id`: a fault report is a string and a serial write, and there is
// no reason for it to be anything else.
//
// It powers the machine off rather than halting. A kernel with no way to
// recover has stopped either way, and stopping the machine is the ending a
// test can observe -- a halt looks exactly like a hang from outside.

kpanic(word vec, word e, word p) {
  print("");
  print("*** fault: " + trap_name(vec) + " (vector " + vec + ", error " + e + ")");
  panic2(p);
} return void;

panic2(word p) {
  print("*** at " + hexw(p));
  print("*** halted");
  poweroff();
} return void;
