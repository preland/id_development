// The two lines cut off kpanic and panic2 for the action limit: the fault
// line itself, and the halt that follows the address it faulted at.
kpanic_report(string trap_name_v, word vec, word e, word p) {
  print("*** fault: " + trap_name_v + " (vector " + vec + ", error " + e + ")");
  panic2(p);
} return void;

panic3() {
  print("*** halted");
  poweroff();
} return void;
