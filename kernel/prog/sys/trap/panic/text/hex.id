// An address, in hex. Sixteen digits always: a fault report is read next to
// other fault reports, and a column that changes width is harder to scan than
// four leading zeros.
hexw(word a) {
  string s = "0x";
  int i = 15;
  while(i >= 0) {
    s = s + nib(ushr(a, i * 4) & 15);
    i = i - 1;
  }
} return string s;

// The nibble arrives as a `word` because that is what a shift of an address
// produces, and `chr` takes an `int` -- so it narrows here rather than at each
// of the two calls.
nib(word a) {
  int n = a;
  string s = chr(48 + n);
} return string nib2(n, s);

nib2(int n, string s) {
  if(n > 9) {
    s = chr(87 + n);
  }
} return string s;
