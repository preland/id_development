// A substring, in one call rather than a loop.
//
// Building a string a character at a time costs O(n^2) in this language
// (docs/TODO.md item 10). The flat store already holds the bytes and
// str_of_mem copies a run of them into a fresh string, so a slice is a copy
// and not an accumulation.
cut(string s, int lo, int hi) {
} return string str_of_mem(mem_of_str(s) + lo, hi - lo);

// Where the next field ends: the bar, or the end of the string.
bar_at(string s, int at) {
  while(charat(s, at) != 124 && charat(s, at) != 0 - 1) {
    at = at + 1;
  }
} return int at;
