asm "x86_64-unknown-none" in32(word p) {
  "movq %[p], %%rdx"
  "xorq %%rax, %%rax"
  "inl %%dx, %%eax"
  "movq %%rax, %[ret]"
} return word ret;

asm "x86_64-unknown-none" in8(word p) {
  "movq %[p], %%rdx"
  "xorq %%rax, %%rax"
  "inb %%dx, %%al"
  "movq %%rax, %[ret]"
} return word ret;

asm "x86_64-unknown-none" out8(word p, word v) {
  "pushq %[p]"
  "pushq %[v]"
  "popq %%rax"
  "popq %%rdx"
  "outb %%al, %%dx"
  "xorq %[ret], %[ret]"
} return word ret;
