// The PS/2 keyboard, polled.
//
// Interrupts would be the usual answer and are not available yet: the IDT has
// the CPU's exceptions in it and nothing has programmed the interrupt
// controller. Polling costs a read of a status port per loop, which a kernel
// that is otherwise halting can afford, and it keeps the driver to what it is
// -- a scancode turned into a character.
//
//   kb_st  shift held
//
// Scancode set 1: a key press sends its code, a release sends the code with
// the high bit set. Only the shifts are tracked, because nothing here needs
// control or alt yet and a modifier nobody reads is state that can go wrong.

kb_init() {
  export int[] kb_st = [0];
  kb_tab_init();
} return int 0;

kb_tab_init() {
  export int[] kb_lo = [];
  export int[] kb_hi = [];
  kb_fill();
} return void;

kb_fill() {
  string kb_low_v = kb_low();
  kb_hex((import kb_lo), kb_low_v, 0);
  kb_fill_hi();
} return void;
