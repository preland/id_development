// The same hexadecimal decoding the font uses, over a caller's list rather
// than an exported one -- two tables, one function.
kb_hex(int[] xs, string s, int i) {
  while(i < len(s)) {
    push(xs, font_byte(s, i));
    i = i + 2;
  }
} return void;

// A scancode, or -1 when the controller has nothing. Bit 0 of the status port
// says whether the output buffer has a byte in it; reading the data port when
// it does not returns the last byte again, which looks exactly like a key
// repeating forever.
kb_scan() {
  int sc = 0 - 1;
  if(in8(0x64) & 1 == 1) {
    sc = in8(0x60);
  }
} return int sc;

kb_shift(int sc) {
  int ok = 0;
  if(sc == 0x2a || sc == 0x36) {
    ok = 1;
  }
} return int ok;
