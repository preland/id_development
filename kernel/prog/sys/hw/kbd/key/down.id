
kb_down(int sc) {
  int ch = 0 - 1;
  if(kb_shift(sc) == 1) {
    lset((import kb_st), 0, 1);
  } else {
    ch = kb_look(sc);
  }
} return int ch;

// A zero in the table means the key has no character -- a function key, or a
// code this layout does not use -- and is reported as nothing rather than as
// a NUL, which a string could not hold anyway.
kb_look(int sc) {
  int ch = kb_at(sc);
  int got = 0 - 1;
  if(ch != 0) {
    got = ch;
  }
} return int got;

kb_at(int sc) {
  int ch = (import kb_lo)[sc];
  if((import kb_st)[0] == 1) {
    ch = (import kb_hi)[sc];
  }
} return int ch;
