// A hexadecimal digit. Lowercase only, because the generator only writes
// lowercase and accepting more would be accepting input this never sees.
font_nib(int ch) {
  int n = ch - 48;
  if(ch >= 97) {
    n = ch - 87;
  }
} return int n;

// One row of a glyph: eight pixels, most significant bit leftmost.
font_row(int ch, int ln) {
} return int font_at(ch - 32, ln);

font_at(int g, int ln) {
  int n = 0;
  if(g >= 0 && g < 95) {
    n = (import font_px)[g * 16 + ln];
  }
} return int n;
