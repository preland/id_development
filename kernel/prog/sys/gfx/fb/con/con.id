// A text console over the framebuffer.
//
// Eighty columns and thirty rows at 8x16 in a 640x480 mode, which is the shape
// a terminal has had since terminals -- and, more usefully, the shape that
// makes a column a byte and a row a multiple of sixteen.
//
//   con_st  column, row
//
// The characters themselves are not remembered. Scrolling copies pixels rather
// than redrawing text, which is both faster and the reason there is no screen
// buffer to keep in step with what is on the screen.

con_init() {
  export word[] con_st = [];
  con_zero();
} return int 0;

con_zero() {
  push((import con_st), 0);
  push((import con_st), 0);
} return void;

con_at(int i) {
  word ret_w = (import con_st)[i];
} return word ret_w;
