// The draw-and-advance half of con_draw, cut out here because con_draw
// already spent its own budget reading the column and the row. The column it
// advances is the one already read rather than a fresh read, since nothing
// between the two moves the cursor.
con_draw_put(int ch, word con_at_v, word con_at_v2) {
  font_put(ch, con_at_v * 8, con_at_v2 * 16, 0x00d0d0d0, 0x00101018);
  wset((import con_st), 0, con_at_v + 1);
  con_wrap();
} return void;
