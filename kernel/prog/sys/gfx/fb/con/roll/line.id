con_nl() {
  wset((import con_st), 0, 0);
  wset((import con_st), 1, con_at(1) + 1);
  con_roll();
} return void;

// Past the last row, the picture moves up by one line and the bottom is
// cleared. The cursor stays on the last row, which is what makes the console
// scroll rather than run off the screen.
con_roll() {
  if(con_at(1) >= 30) {
    wset((import con_st), 1, 29);
    con_scroll();
  }
} return void;

con_str(string s) {
  int i = 0;
  while(i < len(s)) {
    con_ch(charat(s, i));
    i = i + 1;
  }
} return void;
