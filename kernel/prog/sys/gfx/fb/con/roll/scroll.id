// Scrolling, as a copy of the framebuffer up by one line of text and a clear
// of the row that is left behind.
//
// Copying pixels rather than characters is what lets the console keep no
// screen buffer at all: the picture is the only record of what was written,
// and moving it is moving the text.
con_scroll() {
  word y = 0;
  while(y + 16 < fb_h()) {
    con_copy(y);
    y = y + 1;
  }
  con_clear(fb_h() - 16);
} return void;

con_copy(word y) {
  word x = 0;
  while(x < fb_w()) {
    fb_px(x, y, peek32(fb_base() + ((y + 16) * fb_w() + x) * 4));
    x = x + 1;
  }
} return void;

con_clear(word y) {
  word dy = 0;
  while(dy < 16) {
    con_wipe(y + dy);
    dy = dy + 1;
  }
} return void;
