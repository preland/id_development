// One character. A newline moves to the next line and everything else draws
// and advances; a character that would run off the right edge wraps first,
// because a console that clips loses the end of every long line.
con_ch(int ch) {
  if(ch == 10) {
    con_nl();
  } else {
    con_draw(ch);
  }
} return void;

con_draw(int ch) {
  font_put(ch, con_at(0) * 8, con_at(1) * 16, 0x00d0d0d0, 0x00101018);
  wset((import con_st), 0, con_at(0) + 1);
  con_wrap();
} return void;

con_wrap() {
  if(con_at(0) >= 80) {
    con_nl();
  }
} return void;
