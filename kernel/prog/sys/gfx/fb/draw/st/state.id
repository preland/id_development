// A word[] cannot be written as a literal (see fb.id), so it starts empty.
fb_zero() {
  push((import fb_st), 0);
  push((import fb_st), 0);
  push((import fb_st), 0);
} return void;

fb_note(word a, word w, word h) {
  wset((import fb_st), 0, a);
  wset((import fb_st), 1, w);
  wset((import fb_st), 2, h);
} return void;

fb_base() {
} return word (import fb_st)[0];
