// Finding the display adapter, and where it put its framebuffer.
//
// The address of the framebuffer is not a constant. It is a base address
// register in the device's PCI configuration space, and which address the
// firmware assigned is the firmware's business -- a kernel that hardcodes
// 0xfd000000 works on one version of one emulator and paints over something
// else on the next.
//
// Configuration space is reached through two ports: an address is written to
// 0xcf8 and the doubleword read back from 0xcfc.

pci_read(word b, word d, word f, word off) {
  out32(0xcf8, 0x80000000 + b * 0x10000 + d * 0x800 + f * 0x100 + (off & 0xfc));
  word ret_w = in32(0xcfc);
} return word ret_w;

// The first device whose class is `display`, as a packed bus/device/function.
// Only bus zero and function zero are looked at: the emulated machine this
// runs on has one adapter and puts it there, and walking every bus is a
// feature for when there is something to find on one.
pci_find_vga() {
  word a = 0;
  word d = 0;
  a = pci_scan(d, a);
} return word a;

pci_scan(word d, word a) {
  while(d < 32) {
    a = pci_at(d, a);
    d = d + 1;
  }
} return word a;
