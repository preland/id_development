
vbe_on() {
  vbe_reg(3, 32);
  vbe_reg(4, 0x41);
} return void;

// Whether the adapter answered at all. Index 0 reads back its version, which
// is 0xb0c0 or above on anything implementing the extension; a machine without
// it reads back something else and there is no framebuffer to find.
vbe_ok() {
  int ok = 0;
  out16(0x1ce, 0);
  ok = vbe_read_ok();
} return int ok;

vbe_ok2(word val) {
  int ok = 0;
  if(val >= 0xb0c0 && val <= 0xb0c5) {
    ok = 1;
  }
} return int ok;
