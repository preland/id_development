// What has to exist before anything can be said: an interrupt table, a
// framebuffer, a decoded font and a console on top of it.
boot_gfx() {
  fb_init();
  font_init();
  boot_in();
} return void;

boot_in() {
  con_init();
  kb_init();
} return void;

banner() {
  print("id kernel: booted");
  print("hello from a language with no libc");
} return void;
