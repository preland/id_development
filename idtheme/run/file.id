// The four files idtheme writes, and the order they are named in (conf.id, it_files): the style sheet, the token
// file, the class list and the same list as a TypeScript set for idml's guard.
//
// The class list as a TypeScript module: the set idml's class guard exempts from its geometry rule.
it_classes_typescript(string[] out) {
  string[] names = [];
  it_class_names(names);
  push(out, "// generated by idtheme from the id constants of idstd (kit/ui/theme); do not edit");
} chain (string[] out) {
  push(out, "export const IDT_CLASSES: ReadonlySet<string> = new Set([");
  int typescript_name_index = 0;
  while (typescript_name_index < len(names)) {
    push(out, "  \"" + names[typescript_name_index] + "\",");
    typescript_name_index = typescript_name_index + 1;
  }
} chain (string[] out) {
  push(out, "]);");
} return void;
