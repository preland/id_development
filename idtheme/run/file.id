// File i's lines, pushed onto out: 0 the style sheet, 1 the token file, 2 the class list, 3 the class set.
it_generate(string[] out, int file_index, int[] light_table, int[] dark_table) {
  if (file_index == 0) {
    it_sheet(out, light_table, dark_table);
  }
  if (file_index == 1) {
    it_tokens(out, light_table, dark_table);
  }
  if (file_index == 2) {
    it_class_names_json(out);
  }
} chain (string[] out, int file_index, int[] light_table, int[] dark_table) {
  if (file_index == 3) {
    it_classes_typescript(out);
  }
} return void;
