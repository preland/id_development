// idtheme: write the web half of the design system from the id constants, or check that it is up to date.
//
//   idtheme write DIR [SYSTEM [APP]]   write idt.css, idt.tokens.json, idt.classes.json and idt-classes.ts into DIR
//   idtheme check DIR [SYSTEM [APP]]   exit 1 when any of them differs from what write would produce
//
// SYSTEM is a matugen file with both modes and APP an app palette; "-" skips a layer. The id constants in
// idstd's theme module are the one source: nothing here is edited by hand.
main(int argc, string[] argv) {
  int exit_status = it_go(argc, argv);
} return int exit_status;
(1, ["idtheme"]):(2)
(2, ["idtheme", "write"]):(2)

// Run the command when there is one and a directory with it, else say how to use the program.
it_go(int argc, string[] argv) {
  int exit_status = 2;
  if (argc >= 3) {
    exit_status = it_run(argc, argv);
  } else {
    it_usage();
  }
} return int exit_status;
(1, ["idtheme"]):(2) then eprints:("usage: idtheme write|check DIR [SYSTEM.json [APP.json]]\n")
given it_test_directory (3, ["idtheme", "check", (import it_scratch_directory)]):(1)

// How to use it.
it_usage() {
  eprint("usage: idtheme write|check DIR [SYSTEM.json [APP.json]]");
} return void;
