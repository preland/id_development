// How many of the four files differ from what would be written now; 0 when none does.
it_check(string dir, int[] th0, int[] th1) {
  int i = 0;
  int bad = 0;
  while (i < len((import it_files))) {
    bad = bad + it_diff(dir, i, th0, th1);
    i = i + 1;
  }
} return int bad;
