// Checking the files on disk against what would be written now.
//
// 1 when file i in dir is not what would be written now, and a line on stderr says which file and what to run;
// 0 when it is.
it_diff(string dir, int i, int[] th0, int[] th1) {
  string want = it_text(i, th0, th1);
  string have = fs_read_text(dir + "/" + (import it_files)[i]);
  int d = want != have;
} chain (string dir, int i, int[] th0, int[] th1) {
  if (d == 1) {
    eprint((import it_files)[i] + " in " + dir + " is not what idtheme writes from the current tokens; run: idtheme write " + dir);
  }
} return int d;
