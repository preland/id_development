// Checking the files on disk against what would be written now.
//
// 1 when file i in dir is not what would be written now, and a line on stderr says which file and what to run;
// 0 when it is.
it_diff(string output_directory, int file_index, int[] light_table, int[] dark_table) {
  string want = it_text(file_index, light_table, dark_table);
  string have = fs_read_text(output_directory + "/" + (import it_files)[file_index]);
  int differs = want != have;
} chain (string output_directory, int file_index, int[] light_table, int[] dark_table) {
  if (differs == 1) {
    eprint((import it_files)[file_index] + " in " + output_directory + " is not what idtheme writes from the current tokens; run: idtheme write " + output_directory);
  }
} return int differs;
