// How many of the four files differ from what would be written now; 0 when none does.
it_check(string output_directory, int[] light_table, int[] dark_table) {
  int file_index = 0;
  int bad = 0;
  while (file_index < len((import it_files))) {
    bad = bad + it_diff(output_directory, file_index, light_table, dark_table);
    file_index = file_index + 1;
  }
} return int bad;
