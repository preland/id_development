// Reading the command line and running what it asks.
//
// Argument i, or "" when there are fewer or it is "-", which means no file for a layer.
it_argument(int argc, string[] argv, int argument_index) {
  string argument_text = "";
  if (argument_index < argc && argv[argument_index] != "-") {
    argument_text = argv[argument_index];
  }
} return string argument_text;
(3, ["idtheme", "write", "d"], 2):("d")
(3, ["idtheme", "write", "d"], 3):("")
(4, ["idtheme", "write", "d", "-"], 3):("")

// Run the command argv[1] on the directory argv[2], over the themes of both modes built with the system palette
// argv[3] and the app palette argv[4] over the built-in ones. Answers 0 when it did what it was asked, 1 when a
// file was wrong or could not be written, 2 when the command was not understood.
it_run(int argc, string[] argv) {
  int[] light_table = theme_layers(0, it_argument(argc, argv, 3), it_argument(argc, argv, 4));
  int[] dark_table = theme_layers(1, it_argument(argc, argv, 3), it_argument(argc, argv, 4));
  int run_status = 2;
} chain (int argc, string[] argv) {
  if (argv[1] == "write") {
    run_status = (it_write(argv[2], light_table, dark_table) > 0);
  }
  if (argv[1] == "check") {
    run_status = (it_check(argv[2], light_table, dark_table) > 0);
  }
} return int run_status;
