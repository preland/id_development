// A check that looks at the scratch directory without knowing where the harness put it: a case's TMPDIR is its own
// directory, so only the part fs_mktemp makes up (the prefix and the six characters after it) is stable.
//
// The length of the scratch directory's own name when it starts with idtheme_, else -1.
it_t_base() {
  string it_xb = path_base((import it_xd));
  int it_len = len(it_xb);
  if (str_starts(it_xb, "idtheme_") == 0) {
    it_len = -1;
  }
} return int it_len;
