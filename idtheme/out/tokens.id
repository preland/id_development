// The whole token file, and the two small helpers its pieces share.
//
// The token file: the colours, the type styles and the spacing steps of the themes th0 (light) and th1 (dark).
it_tokens(string[] out, int[] light_table, int[] dark_table) {
  push(out, "{");
  push(out, "  \"colors\": [");
  it_token_colors(out, light_table, dark_table);
} chain (string[] out, int[] light_table, int[] dark_table) {
  push(out, "  ],");
  push(out, "  \"typography\": [");
  it_token_typography(out, light_table);
} chain (string[] out, int[] light_table, int[] dark_table) {
  push(out, "  ],");
  push(out, "  \"spacing\": [");
  it_token_spacing(out, light_table);
} chain (string[] out, int[] light_table, int[] dark_table) {
  push(out, "  ]");
  push(out, "}");
} return void;
