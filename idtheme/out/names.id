// The class names as a JSON array, one to a line, for a tool that wants the list as data.
it_class_names_json(string[] out) {
  string[] names = [];
  it_class_names(names);
  push(out, "[");
} chain (string[] out) {
  int json_name_index = 0;
  while (json_name_index < len(names)) {
    string comma_text = it_comma(json_name_index, len(names));
    push(out, "  \"" + names[json_name_index] + "\"" + comma_text);
    json_name_index = json_name_index + 1;
  }
  push(out, "]");
} return void;
