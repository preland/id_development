// The names of the classes, for the files that list them (the guard exemption idml reads).
//
// The name of every class of family f, in token order.
it_family_names(string[] out, int family_index) {
  int class_index = 0;
  while (len(theme_class_name(family_index, class_index)) > 0) {
    push(out, theme_class_name(family_index, class_index));
    class_index = class_index + 1;
  }
} return void;
