// The rule for the class of family f and token k: its selector, with the characters a selector cannot hold as they
// are escaped, and its declarations. A border's width also asks for a solid line.
it_rule(int[] theme_table, int family_index, int class_index) {
  string rule_text = "." + it_escape(theme_cname(family_index, class_index)) + " { " + it_declarations(theme_table, family_index, class_index) + string_repeat("border-style: solid; ", family_index == 3) + "}";
} return string rule_text;
