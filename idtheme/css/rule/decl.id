// Every declaration of the class, in property order.
it_declarations(int[] theme_table, int family_index, int class_index) {
  string declarations_text = "";
  int property_index = 0;
  while (property_index < 18) {
    declarations_text = declarations_text + it_declaration(theme_table, family_index, class_index, property_index);
    property_index = property_index + 1;
  }
} return string declarations_text;
