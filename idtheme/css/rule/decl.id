// A class as a style rule. The declarations are the properties the class sets (th_mask), each with the value the
// theme gives it, in the order of the style's properties.
//
// The declaration of property p of the class, "name: value; ", or "" when the class does not set p.
it_declaration(int[] theme_table, int family_index, int class_index, int property_index) {
  int on = (theme_mask(family_index) >> property_index) & 1;
  string declaration_text = "";
  if (on == 1) {
    declaration_text = (import theme_css)[property_index] + ": " + it_property_value(theme_table, family_index, class_index, property_index) + "; ";
  }
} return string declaration_text;
