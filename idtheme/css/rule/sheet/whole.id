// The whole style sheet.
//
// The lines every sheet starts a page with: the border-box sizing the layout needs, the two display classes idml's
// containers carry, and the defaults of the root, which a class or a property overrides because they are written
// with no specificity.
it_preamble(string[] out, int[] theme_table) {
  push(out, ".idt, .idt *, .idt *::before, .idt *::after { box-sizing: border-box; }");
  push(out, ".flex { display: flex; }");
  push(out, ".grid { display: grid; }");
} chain (string[] out, int[] theme_table) {
  push(out, ":where(.idt) { color: var(--isd-color-label); background-color: var(--isd-color-window); font-size: " + it_property_value(theme_table, 14, 2, 10) + "; line-height: " + it_property_value(theme_table, 14, 2, 11) + "; font-weight: " + it_property_value(theme_table, 14, 2, 12) + "; font-family: " + it_property_value(theme_table, 14, 2, 13) + "; }");
} return void;
