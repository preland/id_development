// The style sheet for the light theme th0 and the dark theme th1: the variables of the light theme on the root, of
// the dark theme on .dark and under the user's preference, of the light theme on .light (so a light window can sit
// in a dark one), the lines every page needs, then every class and every state, which come from th0 because a class
// names a role and the variables carry the mode.
it_sheet(string[] out, int[] light_table, int[] dark_table) {
  string[] none = [];
  push(out, "/* generated by idtheme from the id constants of idstd (kit/ui/theme); do not edit */");
  it_variables(out, light_table, ":root", none);
} chain (string[] out, int[] light_table, int[] dark_table) {
  it_variables(out, dark_table, ".dark", (import it_scope));
  it_variables(out, light_table, ".light", (import it_scope));
  push(out, "@media (prefers-color-scheme: dark) {");
} chain (string[] out, int[] light_table, int[] dark_table) {
  it_variables(out, dark_table, ":root:not(.light)", none);
  push(out, "}");
  it_preamble(out, light_table);
} chain (string[] out, int[] light_table, int[] dark_table) {
  it_classes(out, light_table);
  it_states(out, light_table);
} return void;
