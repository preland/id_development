// The classes under a state.
//
// The state rule of every token of colour family f while in state st.
it_sfam(string[] out, int[] th, int st, int f) {
  int k = 0;
  while (len(theme_cname(f, k)) > 0) {
    push(out, it_srule(th, st, f, k));
    k = k + 1;
  }
} return void;
