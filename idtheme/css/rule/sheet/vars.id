// A rule that defines the variables of theme th on the selector sel, the shadow colour as the three numbers a
// colour function wants, then the lines in tail, then the closing brace.
it_variables(string[] out, int[] theme_table, string selector, string[] tail) {
  push(out, selector + " {");
  it_roles(out, theme_table);
  push(out, "  --isd-shadow-rgb: " + ((theme_table[(import theme_r_scrim)] >> 16) & 255) + " " + ((theme_table[(import theme_r_scrim)] >> 8) & 255) + " " + (theme_table[(import theme_r_scrim)] & 255) + ";");
} chain (string[] out, int[] theme_table, string selector, string[] tail) {
  list_string_extend(out, tail);
  push(out, "}");
} return void;
