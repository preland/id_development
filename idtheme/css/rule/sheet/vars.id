// The variable blocks: every role of a theme as a custom property, which is how the classes reach a colour, so a
// mode, a window or an app palette is one block of variables and no class changes.
//
// One line per role of the theme: --isd-color-NAME: #rrggbb;
it_roles(string[] out, int[] theme_table) {
  int class_index = 0;
  while (class_index < (import idstd_tt_ts)[1]) {
    push(out, "  --isd-color-" + it_role(class_index) + ": " + theme_hexs(theme_table[class_index]) + ";");
    class_index = class_index + 1;
  }
} return void;
