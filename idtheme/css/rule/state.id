// The rules a state turns on, and the escape every selector needs.
//
// A class name made safe to write after a dot in a selector: the colon of a state prefix and the point of a
// step such as 1.5 each get a backslash.
it_escape(string class_name_text) {
  string colon_escaped = str_join(str_split(class_name_text, ":"), "\\:");
  string escaped_name = str_join(str_split(colon_escaped, "."), "\\.");
} return string escaped_name;
("hover:bg-label"):("hover\\:bg-label")
("p-1.5"):("p-1\\.5")
("bg-label"):("bg-label")

// The rule that applies the colour class of family f (0 background, 1 text, 2 border) and token k while an element
// is in state st (0 hover, 1 focus, 2 active, 3 disabled): the class under its state prefix, on the pseudo-class.
it_state_rule(int[] theme_table, int state_index, int family_index, int class_index) {
  string state_class_name = (import idstd_tt_spre)[state_index] + theme_cname(family_index, class_index);
  string state_rule_text = "." + it_escape(state_class_name) + (import it_pseudo)[state_index] + " { " + it_declarations(theme_table, family_index, class_index) + "}";
} return string state_rule_text;
