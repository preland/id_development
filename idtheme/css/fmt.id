// One value of a class, as a style sheet writes it.
//
// The box-shadow of row r (1 to 4) of the theme's shadow table: its offset, blur and opacity, in the scrim
// colour, which the style sheet keeps in the variable --isd-shadow-rgb; none for a row whose opacity is 0.
it_shadow(int[] th, int r) {
  int o = (import idstd_tt_vo)[6] + (r - 1) * 3;
  string s = "none";
  if (th[o + 2] > 0) {
    s = "0 " + it_px(th[o]) + " " + it_px(th[o + 1]) + " rgb(var(--isd-shadow-rgb) / " + th_alpha(th[o + 2]) + ")";
  }
} return string s;
