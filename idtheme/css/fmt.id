// Value v of kind kd, as written: 0 a colour variable of role k, 1 a length, 2 a plain number, 3 a font stack,
// 4 a shadow row, 5 a duration in milliseconds, 6 the easing curve.
it_fmt(int[] th, int kd, int v, int k) {
  string s = "" + v;
  if (kd == 0) {
    s = "var(--isd-color-" + it_role(k) + ")";
  }
  if (kd == 1) {
    s = it_px(v);
  }
} chain (int[] th, int kd, int v, int k) {
  if (kd == 3) {
    s = (import idstd_tt_fcss)[v];
  }
  if (kd == 4) {
    s = it_shadow(th, v);
  }
  if (kd == 5) {
    s = v + "ms";
  }
} chain (int[] th, int kd, int v, int k) {
  if (kd == 6) {
    s = (import idstd_tt_ease);
  }
} return string s;
