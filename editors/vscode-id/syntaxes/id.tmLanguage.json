{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "id",
  "scopeName": "source.id",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.id",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.id",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.id",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.id",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.id",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.id",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.other.import-export.id",
          "match": "\\b(export|import)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.id",
          "match": "\\b(int|float|string|void)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.id",
          "match": "\\b(print|input|read_all|len|charat|chr|to_int|push|pop|put|flush|getkey|sleep_ms|ticks)\\b(?=\\s*\\()"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.id",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.id",
          "match": "==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!]"
        }
      ]
    }
  }
}
