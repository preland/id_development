// The text of a comment row (its // already at the front, nothing else in front of it) without the //, trimmed, and cut to 60 characters.
call_graph_cut(string text_row) {
  string text_text = str_sub(text_row, 2, len(text_row) - 2);
  text_text = string_trim(text_text);
  int number_count = fixed_point_minimum(len(text_text), 60);
} chain (string text_row) {
  string text_cut = str_sub(text_text, 0, number_count);
} return string text_cut;
("//  hi  "):("hi")
("// 0123456789012345678901234567890123456789012345678901234567890123456789"):("012345678901234567890123456789012345678901234567890123456789")
