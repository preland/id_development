// Reads the comment of the function at node number_function into the session's cache if it has not been read.
call_graph_read_doc(string[][] strings_graph, string[][] strings_session, int[][][] bundle, int number_function) {
  string[] fixture_part = string_split(strings_graph[(import call_graph_string_location)][number_function], ":");
  int[] list_seen = bundle[(import call_graph_session_bundle_session)][(import call_graph_session_seen)];
  string[] fixture_doc = strings_session[(import call_graph_text_doc)];
} chain (string[][] strings_graph, string[][] strings_session, int[][][] bundle, int number_function) {
  if (list_seen[number_function] == 0) {
    fixture_doc[number_function] = call_graph_doc_of(fixture_part[0], to_int(fixture_part[1]));
    list_seen[number_function] = 1;
  }
} return void;
