// The text of a tooltip as lines: the place, the number of cases ("1 case", "2 cases") and the comment line when the cache holds one for the function.
call_graph_fill_tip(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int number_function, string[] fixture_tip) {
  string text_subject = "s";
  if (table_graph[(import call_graph_integer_cases)][number_function] == 1) {
    text_subject = "";
  }
  push(fixture_tip, strings_graph[(import call_graph_string_location)][number_function]);
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int number_function, string[] fixture_tip) {
  push(fixture_tip, table_graph[(import call_graph_integer_cases)][number_function] + " case" + text_subject);
  if (strings_session[(import call_graph_text_doc)][number_function] != "") {
    push(fixture_tip, strings_session[(import call_graph_text_doc)][number_function]);
  }
} return void;
