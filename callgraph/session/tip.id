// The lines of the tooltip for the function at node number_function: where it is (file:line), how many cases it has, and the first line of the comment above it when there is one. The comment is read from the file the first time a tooltip asks and kept (call_graph_session_seen, call_graph_text_doc), so hovering costs nothing after that. A builtin has no place and no tooltip: the list is empty.
call_graph_tip_lines(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_function) {
  string[] fixture_tip = [];
  if (strings_graph[(import call_graph_string_location)][number_function] != "") {
    call_graph_read_doc(strings_graph, strings_session, bundle, number_function);
    call_graph_fill_tip(strings_graph, table_graph, strings_session, number_function, fixture_tip);
  }
} return string[] fixture_tip;
