// 1 when two trees (graph_view_tree: node, parent, repeat, depth) are not the same tree.
call_graph_differs(int[][] table_tree_first, int[][] table_tree_next) {
  int number_same = lst_eq(table_tree_first[(import graph_view_tree_node)], table_tree_next[(import graph_view_tree_node)]) * lst_eq(table_tree_first[(import graph_view_tree_parent)], table_tree_next[(import graph_view_tree_parent)]) * lst_eq(table_tree_first[(import graph_view_tree_repeat)], table_tree_next[(import graph_view_tree_repeat)]);
  int number_diff = 1 - number_same;
} return int number_diff;
