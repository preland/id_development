// The selected box expanded or collapsed: its mark (graph_view_toggle) is flipped, the tree is built again (call_graph_tree), and only when it came out different (call_graph_differs) is it laid out again and put in the session (call_graph_apply).
call_graph_toggle(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle) {
  int number_mark = graph_view_toggle(bundle[(import call_graph_session_bundle_tree)], bundle[(import call_graph_session_bundle_session)][(import call_graph_session_overlap)], bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)][(import graph_view_state_selected)]);
  int[][] table_tree_second = call_graph_tree(strings_graph, table_graph, bundle[(import call_graph_session_bundle_session)][(import call_graph_session_cell)][(import call_graph_setting_root)], bundle[(import call_graph_session_bundle_session)][(import call_graph_session_cell)][(import call_graph_setting_depth)], bundle[(import call_graph_session_bundle_session)][(import call_graph_session_overlap)]);
  if (call_graph_differs(bundle[(import call_graph_session_bundle_tree)], table_tree_second) == 1) {
    call_graph_apply(strings_graph, strings_session, bundle, table_tree_second);
  }
} return void;
