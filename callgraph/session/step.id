// One event given to a session, in the form gfx_event gives it (kind, then a, b, c, d for ev[1] to ev[4]; gph_ev_ in conf.id). graph_view_event changes the view state; when it asks for the selected box to be expanded or collapsed the tree is rebuilt (call_graph_toggle), and when it asks for a search the text is looked for (call_graph_search). Answers 1 when the picture has to be painted again, 0 when nothing changed.
call_graph_step(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_kind, int number_primary, int number_second, int number_third, int number_fourth) {
  int number_code = graph_view_event(bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)], strings_session[(import call_graph_text_text)], bundle[(import call_graph_session_bundle_layout)], number_kind, number_primary, number_second, number_third, number_fourth);
  if (number_code / 2 % 2 == 1) {
    call_graph_toggle(strings_graph, table_graph, strings_session, bundle);
  }
  if (number_code / 4 % 2 == 1) {
    call_graph_search(strings_session, bundle);
  }
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_kind, int number_primary, int number_second, int number_third, int number_fourth) {
  int number_paint = number_code > 0;
} return int number_paint;
