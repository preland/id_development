// A new tree goes on screen: it is laid out (call_graph_lay), the tree, the layout, the labels and the bits replace the session's, and the selected box, which has a different number in the new tree, is found again by its function (call_graph_reselect) and the camera is moved to it. A box must be selected.
call_graph_apply(string[][] strings_graph, string[][] strings_session, int[][][] bundle, int[][] table_tree_second) {
  int number_was = bundle[(import call_graph_session_bundle_tree)][(import graph_view_tree_node)][bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)][(import graph_view_state_selected)]];
  string[] fixture_labels = [];
  int[] list_flags = [];
} chain (string[][] strings_graph, string[][] strings_session, int[][][] bundle, int[][] table_tree_second) {
  int[][] table_layout_second = call_graph_lay(strings_graph, table_tree_second, fixture_labels, list_flags);
  call_graph_swap(strings_session, bundle, table_tree_second, table_layout_second, fixture_labels, list_flags);
  call_graph_reselect(bundle, number_was);
} return void;
