// Selects the tree box that stands drawn out for the function at node number_was, or none when it is not in the tree, and moves the camera to it (graph_view_focus).
call_graph_reselect(int[][][] bundle, int number_was) {
  int[] list_state = bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)];
  list_state[(import graph_view_state_selected)] = call_graph_drawn(bundle[(import call_graph_session_bundle_tree)], number_was);
  int number_moved = graph_view_focus(list_state, bundle[(import call_graph_session_bundle_layout)], list_state[(import graph_view_state_selected)]);
} return void;
