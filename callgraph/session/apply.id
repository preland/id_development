// Puts a new tree, layout, labels and bits where the session keeps them.
call_graph_swap(string[][] strings_session, int[][][] bundle, int[][] table_tree_second, int[][] table_layout_second, string[] fixture_labels, int[] list_flags) {
  bundle[(import call_graph_session_bundle_tree)] = table_tree_second;
  bundle[(import call_graph_session_bundle_layout)] = table_layout_second;
  strings_session[(import call_graph_text_labels)] = fixture_labels;
} chain (string[][] strings_session, int[][][] bundle, int[][] table_tree_second, int[][] table_layout_second, string[] fixture_labels, int[] list_flags) {
  int[][] table_session = bundle[(import call_graph_session_bundle_session)];
  table_session[(import call_graph_session_flags)] = list_flags;
} return void;
