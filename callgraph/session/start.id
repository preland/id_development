// A session starts: the lists of bundle (call_graph_session_bundle_session, call_graph_session_bundle_tree, call_graph_session_bundle_layout) and of strings_session (call_graph_text_labels, call_graph_text_text, call_graph_text_doc) are pushed onto the two empty bundles it is given. The view state is graph_view_state_zero, no function is marked, the tree is that of the function at node number_root to number_depth levels and the camera is at its home position (graph_view_home) over that layout.
call_graph_start(string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, string[][] strings_session, int[][][] bundle) {
  string[] fixture_labels = [];
  int[][] table_session = call_graph_blank_session(len(strings_graph[(import call_graph_string_name)]), number_root, number_depth);
  int[][][] bundle_value = call_graph_view_bundle(strings_graph, table_graph, number_root, number_depth, table_session[(import call_graph_session_overlap)], fixture_labels, table_session[(import call_graph_session_flags)]);
} chain (string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, string[][] strings_session, int[][][] bundle) {
  push(bundle, table_session);
  push(bundle, bundle_value[0]);
  push(bundle, bundle_value[1]);
} chain (string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, string[][] strings_session, int[][][] bundle) {
  push(strings_session, fixture_labels);
  call_graph_start_text(strings_session, len(strings_graph[(import call_graph_string_name)]));
  int number_moved = graph_view_home(table_session[(import call_graph_session_state)], bundle_value[1]);
} return void;
