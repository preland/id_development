// The search typed after /: the first box on screen whose label has the text in it is selected and the camera moves to it (graph_view_focus). No match, or no text, changes nothing.
call_graph_search(string[][] strings_session, int[][][] bundle) {
  int number_hit = call_graph_match(strings_session[(import call_graph_text_labels)], bundle[(import call_graph_session_bundle_session)][(import call_graph_session_flags)], strings_session[(import call_graph_text_text)][0]);
  int[] list_state = bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)];
  if (number_hit >= 0) {
    call_graph_pick(list_state, bundle[(import call_graph_session_bundle_layout)], number_hit);
  }
} return void;
