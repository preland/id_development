// Selects box k and moves the camera to it.
call_graph_pick(int[] list_state, int[][] table_layout, int number_key) {
  list_state[(import graph_view_state_selected)] = number_key;
  int number_moved = graph_view_focus(list_state, table_layout, number_key);
} return void;
