// Empties both bundles and gives them call_graph_string_bundle_count and call_graph_integer_bundle_count empty lists.
call_graph_fill(string[][] strings_graph, int[][] table_graph) {
  int number_key = 0;
  while (len(strings_graph) > 0) {
    pop(strings_graph);
  }
  while (len(table_graph) > 0) {
    pop(table_graph);
  }
} chain (string[][] strings_graph, int[][] table_graph) {
  while (number_key < (import call_graph_string_bundle_count)) {
    push(strings_graph, []);
    number_key = number_key + 1;
  }
  number_key = 0;
  while (number_key < (import call_graph_integer_bundle_count)) {
    push(table_graph, []);
    number_key = number_key + 1;
  }
} return void;
