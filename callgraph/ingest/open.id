// Starts an empty graph: the bundles are emptied and given their lists again (call_graph_fill), then both hash tables are made, so call_graph_intern and call_graph_link can add to them. Whatever the lists held before is dropped.
call_graph_open(string[][] strings_graph, int[][] table_graph) {
  call_graph_fill(strings_graph, table_graph);
  hash_map_initialize(strings_graph[(import call_graph_string_node_key)], table_graph[(import call_graph_integer_node_value)], table_graph[(import call_graph_integer_node_used)], table_graph[(import call_graph_integer_node_count)]);
  hash_map_initialize(strings_graph[(import call_graph_string_edge_key)], table_graph[(import call_graph_integer_edge_value)], table_graph[(import call_graph_integer_edge_used)], table_graph[(import call_graph_integer_edge_count)]);
} return void;
