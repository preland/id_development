// Gives node number_identifier its place in the parallel lists: when it is the node just made (number_identifier is number_old, the count before) it gets an empty location and no cases, then a location other than "" and a case count other than -1 replace those.
call_graph_slot(string[][] strings_graph, int[][] table_graph, int number_identifier, int number_old, string text_location, int number_cases) {
  if (number_identifier == number_old) {
    push(strings_graph[(import call_graph_string_location)], "");
    push(table_graph[(import call_graph_integer_cases)], 0);
  }
  string[] fixture_location = strings_graph[(import call_graph_string_location)];
  int[] list_cases = table_graph[(import call_graph_integer_cases)];
} chain (string[][] strings_graph, int[][] table_graph, int number_identifier, int number_old, string text_location, int number_cases) {
  if (text_location != "") {
    fixture_location[number_identifier] = text_location;
  }
  if (number_cases >= 0) {
    list_cases[number_identifier] = number_cases;
  }
} return void;
