// Constants of the call graph viewer (docs: callgraph/README.md): where each list of the two graph bundles sits.

// The string lists of a loaded graph, the strings bundle: the function names in node order, the file:line of each ("" for a builtin), the keys of the name table, and the keys of the edge table.
int call_graph_string_name = 0;
int call_graph_string_location = 1;
int call_graph_string_node_key = 2;
int call_graph_string_edge_key = 3;

// The int lists of a loaded graph, the numbers bundle: the name table's values, used flags and count, the cases of each function, the edge ends, and the edge table's values, used flags and count.
int call_graph_integer_node_value = 0;
int call_graph_integer_node_used = 1;
int call_graph_integer_node_count = 2;
int call_graph_integer_cases = 3;
int call_graph_integer_from = 4;
int call_graph_integer_to = 5;
int call_graph_integer_edge_value = 6;
int call_graph_integer_edge_used = 7;
int call_graph_integer_edge_count = 8;

// How many lists each bundle holds.
int call_graph_string_bundle_count = 4;
int call_graph_integer_bundle_count = 9;

// A session of the window and of a script replay. The session bundle holds three int[][]: call_graph_session_bundle_session (the state of the session), call_graph_session_bundle_tree (the tree on screen, gph_t_ cells) and call_graph_session_bundle_layout (its layout, gph_l_ cells). The session's own lists are the view state of graph_view_event, the mark of each function (1 children shown, 2 hidden), the bits of each box, the root, depth and whether the left button is held in a script, and whether each function's comment has been read.
int call_graph_session_bundle_session = 0;
int call_graph_session_bundle_tree = 1;
int call_graph_session_bundle_layout = 2;
int call_graph_session_state = 0;
int call_graph_session_overlap = 1;
int call_graph_session_flags = 2;
int call_graph_session_cell = 3;
int call_graph_session_seen = 4;
int call_graph_setting_root = 0;
int call_graph_setting_depth = 1;
int call_graph_setting_held = 2;

// The strings of a session: the label of each box, the search text (one cell) and the first comment line of each function once read.
int call_graph_text_labels = 0;
int call_graph_text_text = 1;
int call_graph_text_doc = 2;

// The keys a script names, and their ids in gfx.h; any other one-letter name is that letter.
string[] call_graph_key_names = ["enter", "esc", "backspace", "tab", "delete", "left", "right", "up", "down", "home", "end", "pageup", "pagedown"];
int[] call_graph_key_identifiers = [1009, 1011, 1007, 1010, 1008, 1001, 1002, 1003, 1004, 1005, 1006, 1012, 1013];

// The words of a script and how many fields (the word included) each needs: wheel X Y DY, down X Y [BUTTON [CLICKS]], up X Y, move X Y, key NAME, text STR, size W H.
string[] call_graph_verbs = ["wheel", "down", "up", "move", "key", "text", "size"];
int[] call_graph_verb_need = [4, 3, 3, 3, 2, 2, 3];
string[] call_graph_mouse_verbs = ["down", "up", "move"];
