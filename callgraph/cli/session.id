// What is left to do after a script: the state as text on stdout (without the last newline, print adding its own) and the picture of it (call_graph_surface, call_graph_picture). Answers 1 when the picture could not be written, 0 otherwise.
call_graph_report(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_dump, string text_out) {
  string text_text = call_graph_state_text(strings_session, bundle);
  if (number_dump == 1) {
    string text_cut = str_sub(text_text, 0, len(text_text) - 1);
    print(text_cut);
  }
  int number_result_code = call_graph_render_session(strings_graph, table_graph, strings_session, bundle, text_out);
} return int number_result_code;
