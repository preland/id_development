// The picture of the session (call_graph_surface) written to the PPM file text_out (call_graph_picture); nothing when text_out is "". Answers 0, or 1 when the file could not be written.
call_graph_render_session(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string text_out) {
  int number_result_code = 0;
  if (text_out != "") {
    call_graph_surface(strings_graph, table_graph, strings_session, bundle);
    number_result_code = call_graph_picture(text_out);
  }
} return int number_result_code;
