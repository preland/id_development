// A script run on a session: the session starts at the root (call_graph_start), the script is replayed (call_graph_replay), and then the state is printed when number_dump is 1 and the picture is written to text_out when that is not "". Answers 0, or 1 when a line of the script could not be read or the picture could not be written.
call_graph_script_run(string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, string text_script, int number_dump, string text_out) {
  string[][] strings_session = [];
  int[][][] bundle = [];
  call_graph_start(strings_graph, table_graph, number_root, number_depth, strings_session, bundle);
} chain (string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, string text_script, int number_dump, string text_out) {
  int number_bad = call_graph_replay(strings_graph, table_graph, strings_session, bundle, text_script);
  int number_result_code = call_graph_report(strings_graph, table_graph, strings_session, bundle, number_dump, text_out);
  int number_code = (number_bad + number_result_code > 0);
} return int number_code;
