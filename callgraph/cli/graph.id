// callgraph --dump and --render: reads the graph in the file at text_path and shows what the function text_root calls to number_depth levels, as lines of text (text_out is "") or as a picture in the PPM file text_out. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
call_graph_graph_command(string text_path, string text_root, int number_depth, string text_out) {
  string text_text = fs_read_text(text_path);
  int number_result_code = 1;
  if (text_text != "") {
    number_result_code = call_graph_graph_text(text_text, text_root, number_depth, text_out);
  }
} chain (string text_path, string text_root, int number_depth, string text_out) {
  if (text_text == "") {
    eprint("callgraph: nothing could be read from the file; run `idc idstd --calls > FILE` first and check that the path exists [" + text_path + "]");
  }
} return int number_result_code;
