// Loads calls text into a graph of its own and finds the root in it, then prints its layout (call_graph_dump_lines) or writes its picture (call_graph_render_to). Answers 0, or 1 after naming the root that is not in the graph.
call_graph_graph_text(string text_text, string text_root, int number_depth, string text_out) {
  string[][] strings_graph = [];
  int[][] table_graph = [];
  call_graph_open(strings_graph, table_graph);
} chain (string text_text, string text_root, int number_depth, string text_out) {
  call_graph_load(text_text, strings_graph, table_graph);
  int number_root = call_graph_find(strings_graph, table_graph, text_root);
  int number_result_code = 1;
} chain (string text_text, string text_root, int number_depth, string text_out) {
  if (number_root >= 0) {
    number_result_code = call_graph_show(strings_graph, table_graph, number_root, number_depth, text_out);
  }
  if (number_root < 0) {
    eprint("callgraph: no function called '" + text_root + "' in the graph; give --root a name that is a function in the file");
  }
} return int number_result_code;
("a|a.id:1|b|b.id:2|call\n", "a", 1, ""):(0) then prints:("a 0 0 0\nb 0 44 1\n")
