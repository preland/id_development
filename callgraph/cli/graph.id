// Shows the picture of node number_root: as lines when text_out is "", as a PPM file otherwise.
call_graph_show(string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, string text_out) {
  int number_result_code = 0;
  if (text_out == "") {
    number_result_code = call_graph_dump_lines(strings_graph, table_graph, number_root, number_depth);
  }
  if (text_out != "") {
    number_result_code = call_graph_render_to(strings_graph, table_graph, number_root, number_depth, text_out);
  }
} return int number_result_code;
