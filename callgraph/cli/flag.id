// 1 when the word text_name is among the words of the command line from the fifth on (a flag such as --dump), 0 when it is not.
call_graph_flag(int argument_count, string[] argument_values, string text_name) {
  int number_key = 4;
  int number_has = 0;
  while (number_key < argument_count) {
    number_has = fixed_point_maximum(number_has, argument_values[number_key] == text_name);
    number_key = number_key + 1;
  }
} return int number_has;
