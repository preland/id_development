// callgraph -- a viewer for the call graph of an id program: --stats counts what `idc PATH --calls` found. It exists to be the first user of idstd's graph kit (graph_, graph_view_), so everything it draws is decided in the kit and this tree holds only the reading of the data and the command line.
main(int argument_count, string[] argument_values) {
  int number_result_code = call_graph_main(argument_count, argument_values);
} return int number_result_code;
(1, ["callgraph"]):(2) then eprints:("usage: callgraph CALLS.txt --root NAME [--depth N] | --stats CALLS.txt | --dump CALLS.txt --root NAME [--depth N] | --render CALLS.txt OUT.ppm --root NAME [--depth N] | --script S.txt CALLS.txt --root NAME [--depth N] [--dump] [--render-after OUT.ppm]\n")
(2, ["callgraph", "x"]):(2) then eprints:("usage: callgraph CALLS.txt --root NAME [--depth N] | --stats CALLS.txt | --dump CALLS.txt --root NAME [--depth N] | --render CALLS.txt OUT.ppm --root NAME [--depth N] | --script S.txt CALLS.txt --root NAME [--depth N] [--dump] [--render-after OUT.ppm]\n")
