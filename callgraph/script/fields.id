// The key a script names: its id in gfx.h (call_graph_key_names) or, for a one-character name, that character. 0 for any other name.
call_graph_key_code(string text_name) {
  int number_at = list_string_index((import call_graph_key_names), text_name);
  int number_code = 0;
  if (number_at >= 0) {
    number_code = (import call_graph_key_identifiers)[number_at];
  }
} chain (string text_name) {
  if (number_at < 0 && len(text_name) == 1) {
    number_code = character_code_at(text_name, 0);
  }
} return int number_code;
("enter"):(1009)
("esc"):(1011)
("/"):(47)
("c"):(99)
("zz"):(0)

// Field i of a script line as a number, or number_definition when the line has no such field.
call_graph_option_integer(string[] fixture_flag, int number_index, int number_definition) {
  int number_count = number_definition;
  if (number_index < len(fixture_flag)) {
    number_count = to_int(fixture_flag[number_index]);
  }
} return int number_count;
(["down", "5", "6", "3"], 3, 1):(3)
(["down", "5", "6"], 3, 1):(1)

// What a script mouse word does to the held state of the left button, kept in the third cell of the session's cell list: kind 3 (down) holds it, kind 4 (up) lets it go, a move leaves it.
call_graph_hold(int[] list_cell, int number_kind) {
  list_cell[(import call_graph_setting_held)] = (number_kind == 3) + (number_kind == 5) * list_cell[(import call_graph_setting_held)];
} return void;
([1, 2, 0], 3):([1, 2, 1], 3)
([1, 2, 1], 4):([1, 2, 0], 4)
([1, 2, 7], 3):([1, 2, 1], 3)
