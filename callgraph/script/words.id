// down X Y [BUTTON [CLICKS]], up X Y and move X Y: the left button is held from a down to the next up, and a move reports it held while it is. The button is 1 and the clicks 1 when not given.
call_graph_do_mouse(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string[] fixture_flag) {
  int number_kind = lst_str_index((import call_graph_mouse_verbs), fixture_flag[0]) + 3;
  call_graph_hold(bundle[(import call_graph_session_bundle_session)][(import call_graph_session_cell)], number_kind);
  int number_third = (number_kind == 3) * call_graph_option_integer(fixture_flag, 3, 1) + (number_kind == 4) + (number_kind == 5) * bundle[(import call_graph_session_bundle_session)][(import call_graph_session_cell)][(import call_graph_setting_held)];
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string[] fixture_flag) {
  call_graph_step(strings_graph, table_graph, strings_session, bundle, number_kind, to_int(fixture_flag[1]), to_int(fixture_flag[2]), number_third, (number_kind == 3) * call_graph_option_integer(fixture_flag, 4, 1));
} return void;
