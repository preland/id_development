// key NAME: the key goes down (a key event) and, for a printable one, its text arrives (a text event), as the window gives both.
call_graph_do_key(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string[] fixture_flag) {
  int number_code = call_graph_key_code(fixture_flag[1]);
  call_graph_step(strings_graph, table_graph, strings_session, bundle, (import graph_view_event_key), number_code, 0, 0, 0);
  if (number_code >= 32 && number_code < 127) {
    call_graph_step(strings_graph, table_graph, strings_session, bundle, (import graph_view_event_text), number_code, 0, 0, 0);
  }
} return void;
