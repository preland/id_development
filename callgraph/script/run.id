// A whole script, one line at a time (call_graph_command), on the session. A line that cannot be read is named on stderr with its number and the words a script has, and the rest still run. Answers how many lines could not be read.
call_graph_replay(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string text_script) {
  string[] fixture_rows = string_split(text_script, "\n");
  int number_count = 0;
  int number_bad = 0;
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string text_script) {
  while (number_count < len(fixture_rows)) {
    number_bad = number_bad + call_graph_line(strings_graph, table_graph, strings_session, bundle, fixture_rows[number_count], number_count + 1);
    number_count = number_count + 1;
  }
} return int number_bad;
