// Line number number_no of a script, run (call_graph_command); when it cannot be read it is named on stderr. Answers 1 for a line that could not be read, 0 otherwise.
call_graph_line(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string text_line, int number_no) {
  int number_ok = call_graph_command(strings_graph, table_graph, strings_session, bundle, text_line);
  if (number_ok == 0) {
    eprint("callgraph: script line " + number_no + ": '" + text_line + "' is not a word a script has or lacks its fields; the words are wheel X Y DY, down X Y [BUTTON [CLICKS]], up X Y, move X Y, key NAME, text STR, size W H");
  }
  int number_bad = 1 - number_ok;
} return int number_bad;
