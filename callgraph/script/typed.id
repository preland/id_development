// text STR: each character of what follows the word (the rest of the line, spaces included) as a text event.
call_graph_do_text(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string text_line) {
  int number_from = fixed_point_minimum(5, len(text_line));
  string text_chars = str_sub(text_line, number_from, len(text_line) - number_from);
  int number_key = 0;
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, string text_line) {
  while (number_key < len(text_chars)) {
    call_graph_step(strings_graph, table_graph, strings_session, bundle, (import graph_view_event_text), charat(text_chars, number_key), 0, 0, 0);
    number_key = number_key + 1;
  }
} return void;
