// The tooltip (graph_view_tip, call_graph_tip_lines) of the box under the pointer, none while a drag is going or when the pointer is on no box.
call_graph_hover(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle) {
  int[] list_state = bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)];
  int number_key = graph_view_hit(bundle[(import call_graph_session_bundle_layout)], list_state, list_state[(import graph_view_state_mouse_x)], list_state[(import graph_view_state_mouse_y)]);
  if (number_key >= 0 && list_state[(import graph_view_state_drag)] != 2) {
    call_graph_show_tip(strings_graph, table_graph, strings_session, bundle, number_key);
  }
} return void;
