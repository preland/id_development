call_graph_show_tip(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_key) {
  string[] fixture_tip = call_graph_tip_lines(strings_graph, table_graph, strings_session, bundle, bundle[(import call_graph_session_bundle_tree)][(import graph_view_tree_node)][number_key]);
