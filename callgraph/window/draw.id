call_graph_draw(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle) {
  graph_view_paint(bundle[(import call_graph_session_bundle_session)][(import call_graph_session_state)], strings_session[(import call_graph_text_text)], bundle[(import call_graph_session_bundle_layout)], strings_session[(import call_graph_text_labels)], bundle[(import call_graph_session_bundle_session)][(import call_graph_session_flags)]);
  call_graph_hover(strings_graph, table_graph, strings_session, bundle);
} return void;
