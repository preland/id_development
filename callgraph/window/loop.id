// One frame, as word's app_frame does it: the surface is fitted to the window, the waiting events are taken (call_graph_events), the picture is painted (call_graph_draw) when the first frame, a resize or an event asks for it, and it is shown. Every frame is shown, painted or not: GFX_MAX_FRAMES counts shown frames, and a window that is not drawn again keeps its last picture only if the program keeps presenting it. Answers 1 when the window was closed.
call_graph_frame(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_first) {
  int number_changed = gfx_sync();
  int number_bits = call_graph_events(strings_graph, table_graph, strings_session, bundle, number_changed);
  if (number_first + number_changed + number_bits % 2 > 0) {
    call_graph_draw(strings_graph, table_graph, strings_session, bundle);
  }
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_first) {
  int number_shown = graphics_present((import surface_pixels));
  sleep_ms(1);
  int number_quit = number_bits / 2;
} return int number_quit;
