// Frames until the window closes or number_maximum have run (a negative number_maximum is no limit): the first one paints. Answers how many ran. With no window (number_ok 0) none run.
call_graph_loop(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_ok, int number_maximum) {
  int number_count = 0;
  int number_quit = number_ok == 0;
  while (number_quit == 0 && number_count != number_maximum) {
    number_quit = call_graph_frame(strings_graph, table_graph, strings_session, bundle, number_count == 0);
    number_count = number_count + 1;
  }
} return int number_count;
