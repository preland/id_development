// The window mode: starts a session on the graph for the function at node number_root, opens a 960 by 600 window (when number_open is 1, so that a case can run the rest without one) and runs frames until it is closed. Answers 0, or 1 after naming on stderr that no window could be opened.
call_graph_win(string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, int number_open) {
  string[][] strings_session = [];
  int[][][] bundle = [];
  call_graph_start(strings_graph, table_graph, number_root, number_depth, strings_session, bundle);
} chain (string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, int number_open) {
  surface_create(960, 600);
  bitmap_font_load();
  int number_ok = number_open;
} chain (string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, int number_open) {
  if (number_open == 1) {
    number_ok = gfx_open(960, 600, "callgraph");
  }
  int number_count = call_graph_loop(strings_graph, table_graph, strings_session, bundle, number_ok, 0 - 1);
  int number_result_code = call_graph_closed(number_open, number_ok);
} return int number_result_code;
