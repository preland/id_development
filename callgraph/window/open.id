// What the window mode answers once the loop is over: the window is closed if one was opened, and a window that was wanted but not opened is named on stderr (the answer is then 1).
call_graph_closed(int number_open, int number_ok) {
  int number_gone = 0;
  if (number_open == 1) {
    number_gone = gfx_close();
  }
  if (number_open == 1 && number_ok == 0) {
    eprint("callgraph: no window could be opened; run it where a display is (DISPLAY or WAYLAND_DISPLAY), or use --script with --render-after");
  }
} chain (int number_open, int number_ok) {
  int number_result_code = number_open * (1 - number_ok);
} return int number_result_code;
