// Every event waiting, until gfx_event has none or reports the window closed (it then reports it on every call): each given to the session (call_graph_take), and a resize first when the surface was just fitted to the window (ch is gfx_sync's answer). Answers 1 for the picture to be painted again plus 2 when the window was closed.
call_graph_events(string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_changed) {
  int[] list_event = [0, 0, 0, 0, 0];
  int number_dirty = 0;
  if (number_changed == 1) {
    number_dirty = call_graph_step(strings_graph, table_graph, strings_session, bundle, (import graph_view_event_size), (import pixel_surface_width), (import pixel_surface_height), 0, 0);
  }
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_changed) {
  int number_kind = gfx_event(list_event);
  int number_quit = 0;
  while (number_kind != 0 && number_quit == 0) {
    number_quit = number_quit || number_kind == 7;
    number_dirty = fixed_point_maximum(number_dirty, call_graph_take(strings_graph, table_graph, strings_session, bundle, list_event));
    number_kind = gfx_event(list_event);
  }
} chain (string[][] strings_graph, int[][] table_graph, string[][] strings_session, int[][][] bundle, int number_changed) {
  int number_bits = number_dirty + 2 * number_quit;
} return int number_bits;
