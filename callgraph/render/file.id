// Writes the surface to the file at the path as a binary PPM (P6, 255), the picture a browser or an image viewer shows. Answers 0, or 1 after naming on stderr what could not be written and how to fix it.
call_graph_picture(string text_path) {
  int number_height = fs_open(text_path, "w");
  string text_head = "P6\n" + (import pixel_surface_width) + " " + (import pixel_surface_height) + "\n255\n";
  int number_lost = 1;
} chain (string text_path) {
  if (number_height >= 0) {
    number_lost = fs_write(number_height, exec_bytes(text_head), len(text_head)) - len(text_head);
    number_lost = number_lost + call_graph_rows(number_height);
    number_lost = number_lost + fs_close(number_height);
  }
  if (number_lost != 0) {
    eprint("callgraph: the picture could not be written; check that the folder exists and that you may write to it [" + text_path + "]");
  }
  int number_result_code = number_lost != 0;
} return int number_result_code;
