// The text on the box of tree node k (a tree from graph_view_tree): the function's name, and a * after it when the node is a repeat of one drawn out elsewhere in the tree.
call_graph_label(string[][] strings_graph, int[][] table_tree, int number_key) {
  string text_mark = "";
  if (table_tree[(import graph_view_tree_repeat)][number_key] == 1) {
    text_mark = "*";
  }
  string text_text = strings_graph[(import call_graph_string_name)][table_tree[(import graph_view_tree_node)][number_key]] + text_mark;
} return string text_text;
([["f", "g"]], [[1, 0], [-1, 0], [0, 1], [0, 1]], 0):("g")
([["f", "g"]], [[1, 0], [-1, 0], [0, 1], [0, 1]], 1):("f*")

// The labels of all the nodes of a tree, in tree order, appended to fixture_labels.
call_graph_labels(string[][] strings_graph, int[][] table_tree, string[] fixture_labels) {
  int number_key = 0;
  while (number_key < len(table_tree[(import graph_view_tree_node)])) {
    push(fixture_labels, call_graph_label(strings_graph, table_tree, number_key));
    number_key = number_key + 1;
  }
} return void;
([["f", "g"]], [[1, 0], [-1, 0], [0, 1], [0, 1]], []):([["f", "g"]], [[1, 0], [-1, 0], [0, 1], [0, 1]], ["g", "f*"])
([["f", "g"]], [[0], [-1], [0], [0]], ["x"]):([["f", "g"]], [[0], [-1], [0], [0]], ["x", "f"])
