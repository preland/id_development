// The call edges between functions, as [from, to]: every edge of the graph whose callee has a file:line, so a call of a builtin (print, push, len) is left out. A viewer that drew them would be a star of builtins round every function.
call_graph_calls(string[][] strings_graph, int[][] table_graph) {
  int[] list_flag = [];
  int[] list_tree = [];
  int number_edge = 0;
} chain (string[][] strings_graph, int[][] table_graph) {
  while (number_edge < len(table_graph[(import call_graph_integer_to)])) {
    call_graph_keep(strings_graph, table_graph, list_flag, list_tree, number_edge);
    number_edge = number_edge + 1;
  }
  int[][] table_edges = [list_flag, list_tree];
} return int[][] table_edges;
([["a", "b", "print"], ["a.id:1", "b.id:2", ""]], [[], [], [], [], [0, 0, 1], [1, 2, 2]]):([[0], [1]])
([["a"], ["a.id:1"]], [[], [], [], [], [], []]):([[], []])

// Edge e of the graph, added to the lists list_flag and list_tree when its callee is a function with a file:line.
call_graph_keep(string[][] strings_graph, int[][] table_graph, int[] list_flag, int[] list_tree, int number_edge) {
  if (strings_graph[(import call_graph_string_location)][table_graph[(import call_graph_integer_to)][number_edge]] != "") {
    graph_edge(list_flag, list_tree, table_graph[(import call_graph_integer_from)][number_edge], table_graph[(import call_graph_integer_to)][number_edge]);
  }
} return void;
