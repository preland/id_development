// The tree and its layout together, as [tree, layout]: call_graph_tree and then call_graph_lay. The window keeps the tree to find what a click or a search found, and lays out again only when the tree is different.
call_graph_view_bundle(string[][] strings_graph, int[][] table_graph, int number_root, int number_depth, int[] list_overlap, string[] fixture_labels, int[] list_flags) {
  int[][] table_tree = call_graph_tree(strings_graph, table_graph, number_root, number_depth, list_overlap);
  int[][] table_layout = call_graph_lay(strings_graph, table_tree, fixture_labels, list_flags);
  int[][][] bundle_value = [table_tree, table_layout];
} return int[][][] bundle_value;
