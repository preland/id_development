// The layout (graph_view_layout) of a tree from call_graph_tree at the width of each box's label in the 8x8 face: the labels (call_graph_labels) and the bits (graph_view_flag_repeat for a repeat) are appended to the empty lists fixture_labels and list_flags. Answers the layout.
call_graph_lay(string[][] strings_graph, int[][] table_tree, string[] fixture_labels, int[] list_flags) {
  call_graph_labels(strings_graph, table_tree, fixture_labels);
  lst_extend(list_flags, table_tree[(import graph_view_tree_repeat)]);
  int[][] table_tree_end = graph_view_tree_edges(table_tree[(import graph_view_tree_parent)]);
} chain (string[][] strings_graph, int[][] table_tree, string[] fixture_labels, int[] list_flags) {
  int[] list_width = graph_view_widths(fixture_labels);
  int[][] table_layout = graph_view_layout(len(fixture_labels), table_tree_end[0], table_tree_end[1], list_width);
} return int[][] table_layout;
