# basic.idml -- a first page for themecheck: a card with padding, a gap, a
# border, a shadow and text, a pill, a well and a plain fill, all of them
# classes of the design system.

Card:Col `bg-surface p-3 gap-2 rounded-lg border border-separator shadow-2`{}
Title:Text("Design system") `text-title-2 text-label`
Note:Text("Light and dark, accessible.") `text-body text-label-secondary`
Pill:Col `bg-accent rounded-full`{}
Well:Col `bg-surface-sunken rounded-md border border-separator-strong`{}
Plain:Col `bg-control-hover`{}

./
Col()[100,100,top-left] {
  Row()[60,100,top-left] {
    Card()[100,50,top-left] {
      Title()[30,100,top-left]{}
      Note()[70,100,top-left]{}
    }
    Col()[100,50,top-left] {
      Pill()[40,100,top-left]{}
      Well()[60,100,top-left]{}
    }
  }
  Row()[40,100,top-left] {
    Plain()[100,40,top-left]{}
    Well()[100,30,top-left]{}
    Pill()[100,30,top-left]{}
  }
}
