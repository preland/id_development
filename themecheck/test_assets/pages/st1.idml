# st1.idml -- buttons in forced states.

Hv:Button `bg-control text-label hover:bg-accent hover:text-on-accent`
Fc:Button `bg-control focus:bg-warning focus:text-on-destructive`
Dis:Button `bg-control disabled:bg-label-disabled disabled:text-label`

./
Row()[100,100,top-left] {
  Hv()[100,34,top-left]{}
  Fc()[100,33,top-left]{}
  Dis()[100,33,top-left]{}
}
