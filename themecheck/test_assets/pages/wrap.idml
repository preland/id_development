# wrap.idml -- text that wraps in boxes of three widths, a word too long for
# its box (it overflows, as on the web), and a box too short for its text.

Frame:Col `bg-surface border border-separator p-2 rounded-md`{}
Para:Text("The quick brown fox jumps over the lazy dog, again and again.")
  `text-body text-label`
Long:Text("Pneumonoultramicroscopicsilicovolcanoconiosis_and_more")
  `text-body text-label-secondary`
Fill:Col{}
Tall:Text("Four short lines of text taller than the box that holds them.")
  `text-title-3 text-label`

./
Col()[100,100,top-left] {
  Row()[60,100,top-left] {
    Frame()[100,30,top-left] {
      Para()[100,100,top-left]{}
    }
    Frame()[100,40,top-left] {
      Para()[100,100,top-left]{}
    }
    Frame()[100,30,top-left] {
      Para()[100,100,top-left]{}
    }
  }
  Row()[40,100,top-left] {
    Frame()[100,70,top-left] {
      Long()[100,100,top-left]{}
    }
    Frame()[100,30,top-left] {
      Tall()[10,100,top-left]{}
      Fill()[90,100,top-left]{}
    }
  }
}
