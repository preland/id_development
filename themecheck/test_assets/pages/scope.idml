# scope.idml -- the same three swatches in three scopes: the page's own mode,
# a subtree a class forces dark, and a subtree a class forces light; one
# swatch in each takes its fill and radius from inline values.

Box:Col `bg-surface p-2 gap-2 border border-separator rounded-md`{}
Dk:Col `dark p-2 gap-2 border border-separator rounded-md`{}
Lt:Col `light p-2 gap-2 border border-separator rounded-md`{}
Word:Text("Scoped text") `text-title-3`
Chip:Col `bg-accent rounded-sm`{}
Lit:Col `bg-accent rounded-sm` {bg: #ff8800 radius: 12}

./
Row()[100,100,top-left] {
  Box()[100,34,top-left] {
    Word()[30,100,top-left]{}
    Chip()[35,100,top-left]{}
    Lit()[35,100,top-left]{}
  }
  Dk()[100,33,top-left] {
    Word()[30,100,top-left]{}
    Chip()[35,100,top-left]{}
    Lit()[35,100,top-left]{}
  }
  Lt()[100,33,top-left] {
    Word()[30,100,top-left]{}
    Chip()[35,100,top-left]{}
    Lit()[35,100,top-left]{}
  }
}
