# showcase.idml -- a small application window drawn only from the design
# system: a title bar, a list, a card with a shadow and a dark panel in it, and
# a row of buttons, with every colour a role and every length a step.

Bar:Row `bg-surface-raised px-3 border border-separator`{}
Brand:Text("Design system") `text-headline text-label`
Pill:Col `bg-accent rounded-full`{}
Side:Col `bg-surface p-3 gap-1 border border-separator`{}
Item:Col `bg-control rounded-md`{}
Pick:Col `bg-selection rounded-md`{}
Card:Col `bg-surface-raised p-3 gap-2 rounded-lg border border-separator
  shadow-2`{}
Head:Text("Light and dark") `text-title-2 text-label`
Body:Text("Colours are roles, so one page serves every palette.")
  `text-body text-label-secondary`
Panel:Col `dark p-2 rounded-md border border-separator`{}
Go:Button("Open") `bg-accent text-on-accent rounded-md hover:bg-accent-hover`
No:Button("Close") `bg-control text-label rounded-md hover:bg-control-hover`
Del:Button("Delete") `bg-destructive text-on-destructive rounded-md`

./
Col()[100,100,top-left] {
  Bar()[10,100,top-left] {
    Brand()[100,50,top-left]{}
    Pill()[100,50,top-left]{}
  }
  Row()[80,100,top-left] {
    Side()[100,24,top-left] {
      Item()[30,100,top-left]{}
      Pick()[30,100,top-left]{}
      Item()[40,100,top-left]{}
    }
    Card()[100,76,top-left] {
      Head()[20,100,top-left]{}
      Body()[40,100,top-left]{}
      Panel()[40,100,top-left]{}
    }
  }
  Row()[10,100,top-left] {
    Go()[100,34,top-left]{}
    No()[100,33,top-left]{}
    Del()[100,33,top-left]{}
  }
}
