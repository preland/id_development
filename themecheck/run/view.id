// Argument i, or "" when there are fewer or it is "-", which skips a palette layer.
argument_or_empty(int argc, string[] argv, int argument_index) {
  string argument_text = "";
  if (argument_index < argc && argv[argument_index] != "-") {
    argument_text = argv[argument_index];
  }
} return string argument_text;
