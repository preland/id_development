// The parsed page, themed, laid out, painted and written out. The window is argv[4] by argv[5] pixels, the mode
// argv[3], the output prefix argv[6]; argv[7] and argv[8] are the system and app palettes.
page_view(int argc, string[] argv, int[] tape, string[] tape_strings) {
  int[][] themes = mode_themes_build(argument_or_empty(argc, argv, 7), argument_or_empty(argc, argv, 8));
  int[] node_records = page_node_records(tape);
  int[] state_flags = state_flags_read(argv[2] + ".states", node_records, gui_count(tape));
} chain (int argc, string[] argv, int[] tape, string[] tape_strings) {
  int[][] styles = [];
  int[] rectangles = [];
  view_paint(tape, tape_strings, themes, argv[3] == "dark", state_flags, styles, rectangles, to_int(argv[4]), to_int(argv[5]));
} chain (int argc, string[] argv, int[] tape, string[] tape_strings) {
  view_dump(argv[6], tape, tape_strings, rectangles, styles, themes, node_records);
} return int 0;
