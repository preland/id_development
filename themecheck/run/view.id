// Loading the page and viewing it.
//
// Parse argv[2] into a tape and view it; a page that does not parse is reported on stderr with its file's name and
// answers 1, as uicheck does.
page_render(int argc, string[] argv) {
  int[] tape = [];
  string[] tape_strings = [];
  gui_new(tape, tape_strings);
} chain (int argc, string[] argv) {
  int load_status = gui_load(argv[2], tape, tape_strings);
  int exit_code = 1;
  if (load_status == 0) {
    exit_code = page_view(argc, argv, tape, tape_strings);
  }
} chain (int argc, string[] argv) {
  if (load_status != 0) {
    eprint(argv[2] + ": " + gui_diag(tape, tape_strings));
  }
} return int exit_code;
