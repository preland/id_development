// Everything a view writes into the directory dir, which is made when it is not there: rects.txt, computed.txt,
// text.txt and page.ppm.
view_dump(string directory, int[] tape, string[] tape_strings, int[] rectangles, int[][] styles, int[][] themes, int[] node_records) {
  int made = fs_mkdir_p(directory);
  int rectangles_bytes_written = text_save(directory + "/rects.txt", rectangle_lines(tape, tape_strings, rectangles, node_records));
  int computed_bytes_written = text_save(directory + "/computed.txt", computed_lines(styles, themes, node_records));
} chain (string directory, int[] tape, string[] tape_strings, int[] rectangles, int[][] styles, int[][] themes, int[] node_records) {
  int text_bytes_written = text_save(directory + "/text.txt", text_line_counts(tape, tape_strings, rectangles, styles, node_records));
  int image_bytes_written = image_save(directory + "/page.ppm");
} return void;
