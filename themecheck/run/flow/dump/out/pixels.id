// The pixels of a PPM.
//
// Write the pixels from index i on, three bytes each, at ad.
tc_ppmpx(word ad, int i) {
  while (i < len((import sf_l_px))) {
    tc_poke3(ad + i * 3, (import sf_l_px)[i]);
    i = i + 1;
  }
} return void;
