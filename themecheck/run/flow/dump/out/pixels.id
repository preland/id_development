// Everything a view writes into the directory dir, which is made when it is not there: rects.txt, computed.txt,
// text.txt and page.ppm.
tc_dump(string dir, int[] t, string[] s, int[] rc, int[][] ys, int[][] tq, int[] ns) {
  int made = fs_mkdir_p(dir);
  int w1 = tc_save(dir + "/rects.txt", tc_rects(t, s, rc, ns));
  int w2 = tc_save(dir + "/computed.txt", tc_computed(ys, tq, ns));
} chain (string dir, int[] t, string[] s, int[] rc, int[][] ys, int[][] tq, int[] ns) {
  int w3 = tc_save(dir + "/text.txt", tc_texts(t, s, rc, ys, ns));
  int w4 = tc_ppm(dir + "/page.ppm");
} return void;
