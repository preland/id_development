// Three bytes at ad: the red, green and blue of colour c.
color_bytes_poke(word address, int color) {
  poke8(address, (color >> 16) & 255);
  poke8(address + 1, (color >> 8) & 255);
  poke8(address + 2, color & 255);
} return void;
