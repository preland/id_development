// Three bytes at ad: the red, green and blue of colour c.
tc_poke3(word ad, int c) {
  poke8(ad, (c >> 16) & 255);
  poke8(ad + 1, (c >> 8) & 255);
  poke8(ad + 2, c & 255);
} return void;
