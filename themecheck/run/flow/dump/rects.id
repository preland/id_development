// The line of node i, which is record rec of the tape.
node_rectangle_line(int[] tape, int[] rectangles, int record_index, int node_index) {
  string row = node_index + " " + gui_rect_get(rectangles, record_index, 0) + " " + gui_rect_get(rectangles, record_index, 1) + " " + gui_rect_get(rectangles, record_index, 2) + " " + gui_rect_get(rectangles, record_index, 3) + " " + gui_get(tape, record_index, (import gui_f_kind));
} return string row;
