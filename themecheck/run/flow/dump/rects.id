// The line of node i, which is record rec of the tape.
tc_rect1(int[] t, int[] rc, int rec, int i) {
  string row = i + " " + gui_rect_get(rc, rec, 0) + " " + gui_rect_get(rc, rec, 1) + " " + gui_rect_get(rc, rec, 2) + " " + gui_rect_get(rc, rec, 3) + " " + gui_get(t, rec, (import gui_f_kind));
} return string row;
