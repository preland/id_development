// What is written out about a view: the rectangles, the computed values, the text, the pixels. One line a node,
// the nodes numbered as page_node_records numbers them, so a web page's elements in document order line up with them.
//
// One line per node: its number, its rectangle x y w h, and its kind (1 Row, 2 Col, 3 Text, ...).
rectangle_lines(int[] tape, string[] tape_strings, int[] rectangles, int[] node_records) {
  string[] line_list = [];
  int node_index = 0;
  while (node_index < len(node_records)) {
    push(line_list, node_rectangle_line(tape, rectangles, node_records[node_index], node_index));
    node_index = node_index + 1;
  }
} chain (int[] tape, string[] tape_strings, int[] rectangles, int[] node_records) {
  string document_text = str_join(line_list, "\n") + "\n";
} return string document_text;
