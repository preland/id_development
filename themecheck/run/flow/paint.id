// Bind the themes to the page, lay it out in a w by h window, and paint it onto a fresh surface of that size, in
// mode (0 light, 1 dark). The styles are left in ys and the rectangles in rc.
tc_paint(int[] t, string[] s, int[][] tq, int mode, int[] fl, int[][] ys, int[] rc, int w, int h) {
  gui_theme(t, s, tq, mode, fl, ys);
  gui_layout(t, rc, w, h);
  sf_l_init(w, h);
} chain (int[] t, string[] s, int[][] tq, int mode, int[] fl, int[][] ys, int[] rc, int w, int h) {
  gui_font_init();
  gui_paint(t, s, rc, ys, tq);
} return void;
