// Bind the themes to the page, lay it out in a w by h window, and paint it onto a fresh surface of that size, in
// mode (0 light, 1 dark). The styles are left in ys and the rectangles in rc.
view_paint(int[] tape, string[] tape_strings, int[][] themes, int mode, int[] state_flags, int[][] styles, int[] rectangles, int window_width, int window_height) {
  gui_theme(tape, tape_strings, themes, mode, state_flags, styles);
  gui_layout(tape, rectangles, window_width, window_height);
  surface_create(window_width, window_height);
} chain (int[] tape, string[] tape_strings, int[][] themes, int mode, int[] state_flags, int[][] styles, int[] rectangles, int window_width, int window_height) {
  gui_font_state_create();
  gui_paint(tape, tape_strings, rectangles, styles, themes);
} return void;
