// One line of a states file, and the paint.
//
// Put the node a line "node mask" names in the states of its mask. A line that is not two numbers is ignored.
state_flag_apply(int[] state_flags, int[] node_records, string line) {
  string[] pair_parts = string_split(line, " ");
  if (len(pair_parts) == 2) {
    state_flags[node_records[to_int(pair_parts[0])]] = to_int(pair_parts[1]);
  }
} return void;
