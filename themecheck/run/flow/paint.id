// The page of the file at path parsed into tc_tt and tc_ts, for the cases.
tc_t_page(string path) {
  export int[] tc_tt = [];
  export string[] tc_ts = [];
  gui_new(tc_tt, tc_ts);
} chain (string path) {
  int e = gui_load(path, tc_tt, tc_ts);
} return void export tc_tt;
