// The records of the page that are nodes, in tape order, which is the order a document's elements are in: node
// number i of a states file or a dump is ns[i].
tc_nodes(int[] t) {
  int[] ns = [];
  int i = 1;
  while (i < gui_count(t)) {
    if (gui_is_node(t, i) == 1) {
      push(ns, i);
    }
    i = i + 1;
  }
} return int[] ns;
given tc_t_page ("test_assets/rows.idml") ((import tc_tt)):([5, 6, 7])
given tc_t_page ("test_assets/tiny.idml") ((import tc_tt)):([2, 3, 4, 5, 7])

// The states each record is in: one entry per record, 0 for none, filled from the lines "node mask" of the file
// at path (node as tc_nodes numbers them, mask 1 hover, 2 focus, 4 active, 8 disabled). A missing file puts
// nothing in any state.
tc_flags(string path, int[] ns, int count) {
  int[] fl = [];
  list_fill(fl, count, 0);
  string[] ls = str_split(fs_read_text(path), "\n");
} chain (string path, int[] ns, int count) {
  int i = 0;
  while (i < len(ls)) {
    tc_flag1(fl, ns, ls[i]);
    i = i + 1;
  }
} return int[] fl;
