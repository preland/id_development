// The inputs of a view: the themes, the states, and the nodes the states are named by.
//
// The theme of each mode with every layer over it: index 0 the light one, 1 the dark one. sysf and appf are the
// system palette and the app palette, "" for none.
mode_themes_build(string system_palette_path, string app_palette_path) {
  int[][] themes = [];
  int[] light_layers = theme_layers(0, system_palette_path, app_palette_path);
  int[] dark_layers = theme_layers(1, system_palette_path, app_palette_path);
} chain (string system_palette_path, string app_palette_path) {
  push(themes, light_layers);
  push(themes, dark_layers);
} return int[][] themes;
