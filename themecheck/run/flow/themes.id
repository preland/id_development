// The records of the page that are nodes, in tape order, which is the order a document's elements are in: node
// number i of a states file or a dump is ns[i].
page_node_records(int[] tape) {
  int[] node_records = [];
  int record_cursor = 1;
  while (record_cursor < gui_count(tape)) {
    if (gui_is_node(tape, record_cursor) == 1) {
      push(node_records, record_cursor);
    }
    record_cursor = record_cursor + 1;
  }
} return int[] node_records;
given page_fixture_load ("test_assets/rows.idml") ((import page_tape)):([5, 6, 7])
given page_fixture_load ("test_assets/tiny.idml") ((import page_tape)):([2, 3, 4, 5, 7])

// The states each record is in: one entry per record, 0 for none, filled from the lines "node mask" of the file
// at path (node as page_node_records numbers them, mask 1 hover, 2 focus, 4 active, 8 disabled). A missing file puts
// nothing in any state.
state_flags_read(string path, int[] node_records, int count) {
  int[] state_flags = [];
  list_fill(state_flags, count, 0);
  string[] line_list = str_split(fs_read_text(path), "\n");
} chain (string path, int[] node_records, int count) {
  int line_index = 0;
  while (line_index < len(line_list)) {
    state_flag_apply(state_flags, node_records, line_list[line_index]);
    line_index = line_index + 1;
  }
} return int[] state_flags;
