// The definition of state swatch (st, k) after its name: a Col for the states a Col can be forced into, with a
// border, carrying the state's prefix on a background, a text and a border colour, each a few roles from the last so
// that they differ; a Button for disabled, which a Col is not, whose inline border:none leaves it no border colour, so
// it carries the first two only.
state_swatch_definition(int state_index, int color_offset) {
  string state_prefix = (import idstd_tt_spre)[state_index];
  string swatch_classes = "Button `bg-control text-label`\n  `" + state_prefix + theme_cname(0, color_offset) + " " + state_prefix + theme_cname(1, (color_offset + 14) % family_token_count(0)) + "`";
  if (state_index < 3) {
    swatch_classes = "Col `bg-control text-label border`\n  `" + state_prefix + theme_cname(0, color_offset) + " " + state_prefix + theme_cname(1, (color_offset + 14) % family_token_count(0)) + "\n  " + state_prefix + theme_cname(2, (color_offset + 7) % family_token_count(0)) + "`";
  }
} return string swatch_classes;
