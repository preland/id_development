// The other two kinds of swatch, and the classes of a state swatch.
//
// Kind 3: a box swatch: a radius, a shadow, a border width or a duration with the easing, on a fill that shows it.
tg_sw3(string[] defs, string[] names, string[] kids, string[] sts, int j) {
  string cl = tg_bcl(j);
  push(defs, "B" + j + ":Col `" + cl + "`{}");
  push(names, "B" + j);
} chain (string[] defs, string[] names, string[] kids, string[] sts, int j) {
  push(kids, "");
} return void;
([], [], [], [], 0):(["B0:Col `bg-accent rounded-none`{}"], ["B0"], [""], [], 0)
([], [], [], [], 9):(["B9:Col `bg-surface-raised shadow-3`{}"], ["B9"], [""], [], 9)
([], [], [], [], 16):(["B16:Col `bg-control duration-slow ease-standard`{}"], ["B16"], [""], [], 16)

// Kind 4: a state swatch: a Col (a Button for disabled) that has a background and a text colour of its own and more for one state,
// forced into that state by the page's states file (the line is the node's number, then the state's bit).
tg_sw4(string[] defs, string[] names, string[] kids, string[] sts, int j) {
  int st = j / tg_n(0);
  int k = j % tg_n(0);
  push(defs, "S" + j + ":" + tg_scl(st, k));
} chain (string[] defs, string[] names, string[] kids, string[] sts, int j) {
  push(names, "S" + j);
  push(kids, "");
  push(sts, (2 + (j % 9) / 3 * 4 + (j % 9) % 3) + " " + (1 << st));
} return void;
([], [], [], [], 0):(["S0:Col `bg-control text-label border`\n  `hover:bg-window hover:text-accent\n  hover:border-selection`"], ["S0"], [""], ["2 1"], 0)
([], [], [], [], 28):(["S28:Col `bg-control text-label border`\n  `focus:bg-window focus:text-accent\n  focus:border-selection`"], ["S28"], [""], ["3 2"], 28)
([], [], [], [], 111):(["S111:Button `bg-control text-label`\n  `disabled:bg-scrim disabled:text-link`"], ["S111"], [""], ["6 8"], 111)

// The definition of state swatch (st, k) after its name: a Col for the states a Col can be forced into, with a
// border, carrying the state's prefix on a background, a text and a border colour, each a few roles from the last so
// that they differ; a Button for disabled, which a Col is not, whose inline border:none leaves it no border colour, so
// it carries the first two only.
tg_scl(int st, int k) {
  string pf = (import idstd_tt_spre)[st];
  string cx = "Button `bg-control text-label`\n  `" + pf + th_cname(0, k) + " " + pf + th_cname(1, (k + 14) % tg_n(0)) + "`";
  if (st < 3) {
    cx = "Col `bg-control text-label border`\n  `" + pf + th_cname(0, k) + " " + pf + th_cname(1, (k + 14) % tg_n(0)) + "\n  " + pf + th_cname(2, (k + 7) % tg_n(0)) + "`";
  }
} return string cx;
