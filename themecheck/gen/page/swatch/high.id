// The other two kinds of swatch, and the classes of a state swatch.
//
// Kind 3: a box swatch: a radius, a shadow, a border width or a duration with the easing, on a fill that shows it.
box_swatch_add(string[] definitions, string[] names, string[] kids, string[] state_lines, int swatch_index) {
  string class_names = box_swatch_classes(swatch_index);
  push(definitions, "B" + swatch_index + ":Col `" + class_names + "`{}");
  push(names, "B" + swatch_index);
} chain (string[] definitions, string[] names, string[] kids, string[] state_lines, int swatch_index) {
  push(kids, "");
} return void;
