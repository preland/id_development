// Kind 4: a state swatch: a Col (a Button for disabled) that has a background and a text colour of its own and more for one state,
// forced into that state by the page's states file (the line is the node's number, then the state's bit).
state_swatch_add(string[] definitions, string[] names, string[] kids, string[] state_lines, int swatch_index) {
  int state_index = swatch_index / family_token_count(0);
  int color_index = swatch_index % family_token_count(0);
  push(definitions, "S" + swatch_index + ":" + state_swatch_definition(state_index, color_index));
} chain (string[] definitions, string[] names, string[] kids, string[] state_lines, int swatch_index) {
  push(names, "S" + swatch_index);
  push(kids, "");
  push(state_lines, (2 + (swatch_index % 9) / 3 * 4 + (swatch_index % 9) % 3) + " " + (1 << state_index));
} return void;
