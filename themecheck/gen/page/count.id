// How many of each there are: tokens of a family, swatches of a kind, pages of a kind. Nothing here is a number a
// token could change under it.
//
// How many tokens family f has, which is how many classes it makes.
tg_n(int f) {
  int k = 0;
  while (len(theme_cname(f, k)) > 0) {
    k = k + 1;
  }
} return int k;
(0):(28)
(3):(3)
(4):(13)
(16):(7)
(19):(1)

// How many swatches pages of the given kind (0 colours, 1 spacing, 2 type, 3 boxes, 4 states) hold in all: the
// colours one each, spacing four to a step, type a style or a weight each and one that wraps, the boxes a radius,
// a shadow, a border width or a duration each, the states each role under each state.
tg_total(int kind) {
  int tot = tg_n(0);
  if (kind == 1) {
    tot = 4 * tg_n(4);
  }
  if (kind == 2) {
    tot = tg_n(14) + tg_n(15) + 1;
  }
} chain (int kind) {
  if (kind == 3) {
    tot = tg_n(16) + tg_n(17) + tg_n(3) + tg_n(18);
  }
  if (kind == 4) {
    tot = 4 * tg_n(0);
  }
} return int tot;
(0):(28)
(1):(52)
(2):(13)
(3):(17)
(4):(112)

// How many pages a kind makes, nine swatches to a page.
tg_pages(int kind) {
  int pg = (tg_total(kind) + 8) / 9;
} return int pg;
(0):(4)
(1):(6)
(2):(2)
(3):(2)
(4):(13)
