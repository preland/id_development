// The class strings of the swatches.
//
// The classes of spacing form fm (0 to 3) at step stp: the families of tg_forms, three to a form, the third being
// -1 for a form with only two.
tg_sp(int stp, int fm) {
  int[] fa = (import tg_forms);
  string cl = theme_cname(fa[3 * fm], stp) + " " + theme_cname(fa[3 * fm + 1], stp);
  if (fa[3 * fm + 2] >= 0) {
    cl = cl + " " + theme_cname(fa[3 * fm + 2], stp);
  }
} return string cl;
(0, 0):("p-0 gap-y-0")
(5, 1):("px-2.5 pt-2.5 gap-x-2.5")
(12, 2):("py-12 pr-12 gap-12")
(3, 3):("pb-1.5 pl-1.5")

// The value a spacing form takes from its parity: forms 0 and 2 take the even value, 1 and 3 the odd one. The swatch's container
// is Col or Row, and its two kids each take half of the content along the main axis.
tg_pick(int fm, string tg_even, string tg_odd) {
  string tg_v = tg_even;
  if (fm % 2 == 1) {
    tg_v = tg_odd;
  }
} return string tg_v;
(0, "Col", "Row"):("Col")
(3, "Col", "Row"):("Row")
(0, "Kid()[50,100,top-left]{}|Kid()[50,100,top-left]{}", "Kid()[100,50,top-left]{}|Kid()[100,50,top-left]{}"):("Kid()[50,100,top-left]{}|Kid()[50,100,top-left]{}")
(1, "Kid()[50,100,top-left]{}|Kid()[50,100,top-left]{}", "Kid()[100,50,top-left]{}|Kid()[100,50,top-left]{}"):("Kid()[100,50,top-left]{}|Kid()[100,50,top-left]{}")
