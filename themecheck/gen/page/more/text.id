// The text of a type swatch, its classes, and the classes of a box swatch.
//
// The words of type swatch j: a pangram, or for the last swatch a sentence that wraps in a swatch's width.
type_swatch_words(int swatch_index) {
  string swatch_words = "Sphinx of black quartz";
  if (swatch_index >= family_token_count(14) + family_token_count(15)) {
    swatch_words = "A line long enough to wrap in a swatch.";
  }
} return string swatch_words;
(0):("Sphinx of black quartz")
(12):("A line long enough to wrap in a swatch.")

// The classes of type swatch j: a style for the first swatches (colour and style), a weight on the body style for
// the next, and the plain body style for the last.
type_swatch_classes(int swatch_index) {
  int style_count = family_token_count(14);
  int weight_count = family_token_count(15);
  string swatch_classes = "text-body text-label";
} chain (int swatch_index) {
  if (swatch_index < style_count) {
    swatch_classes = "text-label " + theme_class_name(14, swatch_index);
  }
  if (swatch_index >= style_count && swatch_index < style_count + weight_count) {
    swatch_classes = swatch_classes + " " + theme_class_name(15, swatch_index - style_count);
  }
} return string swatch_classes;
(0):("text-label text-caption")
(8):("text-body text-label font-normal")
(11):("text-body text-label font-bold")
(12):("text-body text-label")

// The classes of box swatch j: a radius on an accent fill, a shadow on a raised surface, a border width with an
// accent border, or a duration with the easing on a control face.
box_swatch_classes(int swatch_index) {
  int radius_count = family_token_count(16);
  int shadow_count = family_token_count(17);
  int border_count = family_token_count(3);
} chain (int swatch_index) {
  string swatch_classes = "bg-accent " + theme_class_name(16, swatch_index % radius_count);
  if (swatch_index >= radius_count) {
    swatch_classes = "bg-surface-raised " + theme_class_name(17, (swatch_index - radius_count) % shadow_count);
  }
  if (swatch_index >= radius_count + shadow_count) {
    swatch_classes = "bg-surface border-accent " + theme_class_name(3, (swatch_index - radius_count - shadow_count) % border_count);
  }
} chain (int swatch_index) {
  if (swatch_index >= radius_count + shadow_count + border_count) {
    swatch_classes = "bg-control " + theme_class_name(18, swatch_index - radius_count - shadow_count - border_count) + " " + theme_class_name(19, 0);
  }
} return string swatch_classes;
(0):("bg-accent rounded-none")
(6):("bg-accent rounded")
(7):("bg-surface-raised shadow-1")
(10):("bg-surface-raised shadow-none")
(11):("bg-surface border-accent border-0")
(13):("bg-surface border-accent border-2")
(14):("bg-control duration-fast ease-standard")
(16):("bg-control duration-slow ease-standard")
