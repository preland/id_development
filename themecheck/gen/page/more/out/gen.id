// Writing all of them.
//
// Write the state lines to path, one to a line, unless there are none; the bytes written.
state_lines_write(string path, string[] state_lines) {
  string output_text = string_join(state_lines, "\n") + "\n";
  int bytes_written = 0;
  if (len(state_lines) > 0) {
    bytes_written = fs_save(path, mem_of_str(output_text), len(output_text));
  }
} return int bytes_written;
