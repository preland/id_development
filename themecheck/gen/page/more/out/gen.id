// Write every page of every kind into dir, which is made when it is not there, with gen.json listing them. Answers
// 0 once gen.json was written.
tg_gen(string dir) {
  int made = fs_mkdir_p(dir);
  string[] meta = [];
  int k = 0;
} chain (string dir) {
  while (k < 5) {
    tg_kind(dir, k, meta);
    k = k + 1;
  }
  string tx = "[\n" + str_join(meta, ",\n") + "\n]\n";
  int n = fs_save(dir + "/gen.json", mem_of_str(tx), len(tx));
} return int 0;
