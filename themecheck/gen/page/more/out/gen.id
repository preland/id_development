// Every page of a kind, and a line of meta for each: its name and the size of the window it is drawn in, as the
// JSON object the render check reads.
tg_kind(string dir, int kind, string[] meta) {
  int i = 0;
  while (i < tg_pages(kind)) {
    tg_page(dir, kind, i);
    push(meta, "  {\"name\": \"" + tg_name(kind, i) + "\", \"w\": " + (import tg_wh)[2 * kind] + ", \"h\": " + (import tg_wh)[2 * kind + 1] + "}");
    i = i + 1;
  }
} return void;
