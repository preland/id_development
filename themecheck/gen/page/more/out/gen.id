// Every page of a kind, and a line of meta for each: its name and the size of the window it is drawn in, as the
// JSON object the render check reads.
kind_pages_write(string directory, int kind, string[] meta) {
  int kind_page_index = 0;
  while (kind_page_index < kind_page_count(kind)) {
    page_generate(directory, kind, kind_page_index);
    push(meta, "  {\"name\": \"" + page_name(kind, kind_page_index) + "\", \"w\": " + (import tg_wh)[2 * kind] + ", \"h\": " + (import tg_wh)[2 * kind + 1] + "}");
    kind_page_index = kind_page_index + 1;
  }
} return void;
