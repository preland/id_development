// Write every page of every kind into dir, which is made when it is not there, with gen.json listing them. Answers
// 0 once gen.json was written.
pages_generate(string directory) {
  int made = fs_mkdir_path(directory);
  string[] meta = [];
  int kind_index = 0;
} chain (string directory) {
  while (kind_index < 5) {
    kind_pages_write(directory, kind_index, meta);
    kind_index = kind_index + 1;
  }
  string output_text = "[\n" + string_join(meta, ",\n") + "\n]\n";
  int bytes_written = fs_save(directory + "/gen.json", mem_of_str(output_text), len(output_text));
} return int 0;
