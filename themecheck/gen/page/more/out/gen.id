// Writing all of them.
//
// Write the state lines to path, one to a line, unless there are none; the bytes written.
tg_states(string path, string[] sts) {
  string tx = str_join(sts, "\n") + "\n";
  int n = 0;
  if (len(sts) > 0) {
    n = fs_save(path, mem_of_str(tx), len(tx));
  }
} return int n;
