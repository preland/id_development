// Fixtures for the cases of the page writers: which file of the scratch directory to measure, its size, and a run of
// the whole generator for the size cases to measure.
//
// Name the file of the scratch directory (scratch_directory) that picked_file_size measures.
picked_file_choose(string name) {
  export string picked_path = (import scratch_directory) + "/" + name;
} return void export picked_path;
given scratch_directory_make ("a.idml"):() then picked_file_tail:("a.idml")
given scratch_directory_make ("gen.json"):() then picked_file_tail:("gen.json")

// The size of the picked file in the scratch directory, or -1 when it is not there.
picked_file_size() {
  int file_exists = fs_exists((import picked_path));
  int file_size = -1;
  if(file_exists == 1) {
    file_size = len(fs_read_text((import picked_path)));
  }
} return int file_size;
given scratch_directory_make given picked_file_choose("nothing.idml") ():(-1)
given scratch_directory_make given generator_run given picked_file_choose("gen.json") ():(1190)

// A run of the whole generator into the scratch directory.
generator_run() {
  int generate_status = pages_generate((import scratch_directory));
} return void;
given scratch_directory_make given picked_file_choose("gen.json") ():() then picked_file_size:(1190)
given scratch_directory_make given picked_file_choose("colors-1.idml") ():() then picked_file_size:(1158)
