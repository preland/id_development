// Page idx of a kind: its swatches, nine at most, written to dir/NAME.idml, and for a page with states the lines
// that force them to dir/NAME.idml.states. A spacing page first defines the kid its swatches share.
tg_page(string dir, int kind, int idx) {
  string[] defs = [];
  string[] names = [];
  string[] kids = [];
} chain (string dir, int kind, int idx) {
  string[] sts = [];
  int j = 9 * idx;
  int hi = fx_min(tg_total(kind), 9 * idx + 9);
} chain (string dir, int kind, int idx) {
  if (kind == 1) {
    push(defs, "Kid:Col `bg-accent`{}");
  }
  while (j < hi) {
    tg_swatch(defs, names, kids, sts, kind, j);
    j = j + 1;
  }
  string nm = tg_name(kind, idx);
} chain (string dir, int kind, int idx) {
  int n = tg_emit(dir + "/" + nm + ".idml", "# " + nm + ".idml -- generated by themecheck gen (the class set).", defs, names, kids);
  int m = tg_states(dir + "/" + nm + ".idml.states", sts);
} return void;
