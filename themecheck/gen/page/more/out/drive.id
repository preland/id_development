// Writing the pages: one swatch, the name of a page, one page.
//
// Add swatch j of the given kind to the lists.
swatch_add(string[] definitions, string[] names, string[] kids, string[] state_lines, int kind, int swatch_index) {
  if (kind == 0) {
    color_swatch_add(definitions, names, kids, state_lines, swatch_index);
  }
  if (kind == 1) {
    spacing_swatch_add(definitions, names, kids, state_lines, swatch_index);
  }
  if (kind == 2) {
    type_swatch_add(definitions, names, kids, state_lines, swatch_index);
  }
} chain (string[] definitions, string[] names, string[] kids, string[] state_lines, int kind, int swatch_index) {
  if (kind == 3) {
    box_swatch_add(definitions, names, kids, state_lines, swatch_index);
  }
  if (kind == 4) {
    state_swatch_add(definitions, names, kids, state_lines, swatch_index);
  }
} return void;
