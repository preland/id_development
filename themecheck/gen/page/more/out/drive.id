// Writing the pages: one swatch, the name of a page, one page.
//
// Add swatch j of the given kind to the lists.
tg_swatch(string[] defs, string[] names, string[] kids, string[] sts, int kind, int j) {
  if (kind == 0) {
    tg_sw0(defs, names, kids, sts, j);
  }
  if (kind == 1) {
    tg_sw1(defs, names, kids, sts, j);
  }
  if (kind == 2) {
    tg_sw2(defs, names, kids, sts, j);
  }
} chain (string[] defs, string[] names, string[] kids, string[] sts, int kind, int j) {
  if (kind == 3) {
    tg_sw3(defs, names, kids, sts, j);
  }
  if (kind == 4) {
    tg_sw4(defs, names, kids, sts, j);
  }
} return void;
