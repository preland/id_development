// Cases that look at a scratch path without knowing where the harness put it: a case's TMPDIR is its own directory, so
// only the part fs_mktemp makes up (the prefix and the six characters after it) and the part a case appends are stable.
//
// The length of the scratch directory's own name when it starts with themecheck_, else -1.
tg_t_base() {
  string tg_xb = path_base((import tg_xd));
  int tg_len = len(tg_xb);
  if (str_starts(tg_xb, "themecheck_") == 0) {
    tg_len = -1;
  }
} return int tg_len;
given tg_t_dir ():(17)
given tg_t_dir ():(17) then tg_t_base:(17)

// The last part of the picked path in the scratch directory.
tg_t_tail() {
  string tg_tl = path_base((import tg_xn));
} return string tg_tl;
given tg_t_dir given tg_t_pick("a.idml") ():("a.idml")
given tg_t_dir given tg_t_pick("gen.json") ():("gen.json")
