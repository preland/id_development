// Cases that look at a scratch path without knowing where the harness put it: a case's TMPDIR is its own directory, so
// only the part fs_mktemp makes up (the prefix and the six characters after it) and the part a case appends are stable.
//
// The length of the scratch directory's own name when it starts with themecheck_, else -1.
scratch_base_length() {
  string scratch_base = path_base((import scratch_directory));
  int base_length = len(scratch_base);
  if (str_starts(scratch_base, "themecheck_") == 0) {
    base_length = -1;
  }
} return int base_length;
given scratch_directory_make ():(17)
given scratch_directory_make ():(17) then scratch_base_length:(17)

// The last part of the picked path in the scratch directory.
picked_file_tail() {
  string tail_name = path_base((import picked_path));
} return string tail_name;
given scratch_directory_make given picked_file_choose("a.idml") ():("a.idml")
given scratch_directory_make given picked_file_choose("gen.json") ():("gen.json")
