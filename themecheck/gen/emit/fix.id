// The fixture of the cases of the writers: a scratch directory, removed when the case's process exits.
//
// A scratch directory in scratch_directory.
scratch_directory_make() {
  export string scratch_directory = fs_mktemp("themecheck_", 1);
  int drop_status = fs_drop_exit((import scratch_directory));
} return void export scratch_directory;
