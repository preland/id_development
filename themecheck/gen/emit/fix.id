// The fixture of the cases of the writers: a scratch directory, removed when the case's process exits.
//
// A scratch directory in tg_xd.
tg_t_dir() {
  export string tg_xd = fs_mktemp("themecheck_", 1);
  int r = fs_drop_exit((import tg_xd));
} return void export tg_xd;
():() then len((import tg_xd)):(22)
