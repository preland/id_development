// A four-byte buffer in color_buffer that holds the colour 66051 (bytes 1, 2, 3), for the cases of the pixel writers: a
// writer that leaves it alone and one that overwrites it are told apart.
color_buffer_make() {
  export word color_buffer = alloc(4);
  poke8((import color_buffer), 1);
  poke8((import color_buffer) + 1, 2);
} chain () {
  poke8((import color_buffer) + 2, 3);
} return void export color_buffer;
():() then color_buffer_read:(66051)
():() then color_buffer_read:(66051) then color_buffer_read:(66051)

// The three bytes of color_buffer read as one colour.
color_buffer_read() {
  int red = peek8((import color_buffer));
  int green = peek8((import color_buffer) + 1);
  int blue = peek8((import color_buffer) + 2);
} chain () {
  int color = red * 65536 + green * 256 + blue;
} return int color;
