// Row r of rows: up to three swatches side by side, each as wide as item_width_percent says, the row as tall as it says.
swatch_row_add(string[] gl, string[] names, string[] kids, int row_index, int rows) {
  int row_item_count = fixed_point_minimum(3, len(names) - 3 * row_index);
  push(gl, "  Row()[" + item_width_percent(rows, row_index) + ",100,top-left] {");
  int row_item_index = 0;
} chain (string[] gl, string[] names, string[] kids, int row_index, int rows) {
  while (row_item_index < row_item_count) {
    item_lines_add(gl, names[3 * row_index + row_item_index], kids[3 * row_index + row_item_index], item_width_percent(row_item_count, row_item_index));
    row_item_index = row_item_index + 1;
  }
  push(gl, "  }");
} return void;
