// Every row of the swatches, as many as the swatches need at three to a row.
swatch_rows_add(string[] gl, string[] names, string[] kids) {
  int rows = (len(names) + 2) / 3;
  int row_cursor = 0;
  while (row_cursor < rows) {
    swatch_row_add(gl, names, kids, row_cursor, rows);
    row_cursor = row_cursor + 1;
  }
} return void;
