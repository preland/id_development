// Writing a generated page: the header, the variant lines, and the body of nested rows, which is the same at every
// level so that a page of any kind is laid out by the same few rules.
//
// Write the page whose variants are defs and whose swatches are names, each with its kid lines in the same place of
// kids ("" for none, kid lines joined by "|"), to path, under the header line hdr. Answers the bytes written.
page_write(string path, string header_line, string[] definitions, string[] names, string[] kids) {
  string[] gl = [header_line, "# Every swatch carries classes the render check compares.", ""];
  list_string_extend(gl, definitions);
  push(gl, "");
} chain (string path, string header_line, string[] definitions, string[] names, string[] kids) {
  push(gl, "./");
  push(gl, "Col()[100,100,top-left] {");
  swatch_rows_add(gl, names, kids);
} chain (string path, string header_line, string[] definitions, string[] names, string[] kids) {
  push(gl, "}");
  string output_text = string_join(gl, "\n") + "\n";
  int bytes_written = fs_save(path, mem_of_str(output_text), len(output_text));
} return int bytes_written;
