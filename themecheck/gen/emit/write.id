// Row r of rows: up to three swatches side by side, each as wide as tg_pct says, the row as tall as it says.
tg_row(string[] gl, string[] names, string[] kids, int r, int rows) {
  int nr = fx_min(3, len(names) - 3 * r);
  push(gl, "  Row()[" + tg_pct(rows, r) + ",100,top-left] {");
  int j = 0;
} chain (string[] gl, string[] names, string[] kids, int r, int rows) {
  while (j < nr) {
    tg_item(gl, names[3 * r + j], kids[3 * r + j], tg_pct(nr, j));
    j = j + 1;
  }
  push(gl, "  }");
} return void;
