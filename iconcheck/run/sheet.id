// Icon number k of ic_cmd in its cell: at 16 px, and beside it at 24 px, in ik_ink.
ik_cell(int ik_k) {
  int ik_id = (import ic_cmd)[ik_k];
  int ik_x = (ik_k % (import ik_cols)) * (import ik_cell_w) + 6;
  int ik_y = (ik_k / (import ik_cols)) * (import ik_cell_h) + 4;
} chain (int ik_k) {
  vec_icon(ik_id, 16, (import ik_ink), ik_x, ik_y);
  vec_icon(ik_id, 24, (import ik_ink), ik_x + 20, ik_y);
} return void;
