// How many of icon id's two sizes, 16 and 24 px, fail: 0, 1 or 2. Each is printed.
icon_pair_failures(int icon_number) {
  int small_passed = icon_report_line(icon_number, 16);
  int large_passed = icon_report_line(icon_number, 24);
  int sizes_failed = 2 - small_passed - large_passed;
} return int sizes_failed;
given vec_init() given idstd_vec_add(7, "M 0 0 L 2 0 L 2 2 L 0 2 Z") (7):(0)
given vec_init() (7):(2)

// How many (icon, size) pairs of the icons icon_numbers fail, at 16 and 24 px.
icon_all_failures(int[] icon_numbers) {
  int list_index = 0;
  int failure_total = 0;
  while (list_index < len(icon_numbers)) {
    failure_total = failure_total + icon_pair_failures(icon_numbers[list_index]);
    list_index = list_index + 1;
  }
} return int failure_total;
given icon_start_registry() ([9999]):(2)
given icon_start_registry() ([101, 102]):(0)
given vec_init() ([]):(0)

// What main does: no argument checks every icon, "sheet" writes the contact sheet, anything else is a mistake.
icon_run(int argument_count, string[] argument_values) {
  int exit_status = 2;
  if (argument_count == 1) {
    exit_status = icon_all_failures((import ic_cmd));
  }
  if (argument_count == 2 && argument_values[1] == "sheet") {
    exit_status = icon_sheet_write();
  }
} return int exit_status;
given icon_start_registry() (1, ["iconcheck"]):(0)
given icon_start_registry() (2, ["iconcheck", "sheet"]):(0)
given icon_start_registry() (2, ["iconcheck", "nope"]):(2)
