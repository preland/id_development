# autonomous-run build outputs. Anchored: an unanchored `build/` matches a
# directory of that name at ANY depth, and three of those hold source --
# compiler/parse/back/ir/build/ (the whole AST-to-SSA lowering, 60 files),
# demos/fpsmaze/game/sim/gfx/mesh/build/, and demos/idc_in_id_calc/build/.
# None of them had ever been committed, and `git clean -fdx` would have taken
# the compiler's IR builder with it.
/out/
/build/
*.ll
*.wat
*.wasm

# self-hosted driver bootstrap cache
/.idc-cache/

# direnv
/.direnv/
