# scratch output from idc/tools/flatten.py
/_tmp_idflat_*.id

# autonomous-run build outputs. Anchored: an unanchored `build/` matches a
# directory of that name at ANY depth, and several of those hold source --
# demos/fpsmaze/game/sim/gfx/mesh/build/ and demos/idc_in_id_calc/build/ among
# them. Neither had ever been committed, and `git clean -fdx` would have taken
# them with it.
/out/
/build/
*.ll
*.wat
*.wasm

# direnv
/.direnv/
