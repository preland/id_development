int vw_c_bar = 2840474;
int vw_c_bartext = 16777215;
// The sheet's shadow: its offset in pixels at 100 percent, and its coverage out of 255.
int vw_shadow_off = 4;
int vw_shadow_a = 90;
// The cells of the geometry list a page is drawn with: the sheet's left and top in pixels on the surface, the zoom in percent, and the left and top of the text area on the sheet in lu.
int vw_g_x = 0;
int vw_g_y = 1;
int vw_g_z = 2;
int vw_g_l = 3;
int vw_g_t = 4;
// The cells of the list that describes one run's look: its face, colour, highlight (-1 none), flag bits, and the ascent and descent of the face in pixels.
