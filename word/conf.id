// The height in lu (1/64 px) of the box that stands for an object, a table or a picture, in the flow, 72 px; and the gap between two sheets in the continuous document, 24 px.
int word_lay_obj = 4608;
int word_lay_gap = 1536;

// The window chrome as idml (docs/WORD.md 3.5.1, decision 7.2): the ribbon band on top, the page area beside the scrollbar, the status bar under them. Sizes that are fixed in pixels are @references that vw_dim answers in basis points of the window.
string[] vw_idml = ["Ribbon:Col `ribbon` {}", "Canvas:Col `canvas` {}", "Bar:Col `vbar` {}", "Status:Col `status` {}", "", "./", "Col()[100,100,top-left] {", "  Ribbon()[@rib_h,100,top-left]{}", "  Row()[@mid_h,100,top-left] {", "    Canvas()[100,@cv_w,top-left]{}", "    Bar()[100,@bar_w,top-left]{}", "  }", "  Status()[@st_h,100,top-left]{}", "}"];
// The names that idml asks vw_dim for, in the order vw_dims answers them.
string[] vw_names = ["rib_h", "mid_h", "cv_w", "bar_w", "st_h"];
// The fixed sizes of the chrome in pixels: the ribbon band (its tab strip and its body), the scrollbar's width, the status bar.
int vw_rib_px = 128;
int vw_bar_px = 16;
int vw_st_px = 22;
