string[] vw_obj_names = ["draw:frame", "draw:image", "text:note", "text:bookmark"];
string[] vw_obj_labels = ["Image", "Image", "Note", "Bookmark"];
// The cells of the viewer's state list: the scroll of the page area in pixels at the current zoom (x then y), the zoom in percent, and whether the picture is stale (1) because something changed since it was drawn.
int vw_s_x = 0;
int vw_s_y = 1;
int vw_s_z = 2;
int vw_s_d = 3;
// Zoom: the least and the most, the percent one notch of Ctrl+wheel or Ctrl+plus changes it by; and how far one notch of the wheel and one press of an arrow key scroll, in pixels.
