// The hyperlink the text inserted before run k should carry: the one both neighbours share, so typing inside a link stays in it and typing at either end does not.
text_link(Text t, int k) {
  int lk = -1;
  if(k > 0 && k < len(t.runs) && t.runs[k - 1].link == t.runs[k].link) {
    lk = t.runs[k].link;
  }
} return int lk;
(Text([1, 2], [Run(1, 0, 3), Run(1, 1, 3)], 0), 1):(3)
(Text([1, 2], [Run(1, 0, 3), Run(1, 1, -1)], 0), 1):(-1)
(Text([1, 2], [Run(1, 0, 3), Run(1, 1, 3)], 0), 0):(-1)
(Text([1, 2], [Run(1, 0, 3), Run(1, 1, 3)], 0), 2):(-1)

// Adds the run for n new code points at off; the code points themselves are spliced in by text_insert.
text_put(Text t, int off, int n, int cprop) {
  int k = run_cut(t, off);
  int lk = text_link(t, k);
  Run nr = Run(n, cprop, lk);
} chain (Text t, int off, int n, int cprop) {
  rs_insert(t.runs, k, nr);
  t.rev = t.rev + 1;
} return void;
(Text([1, 2, 3], [Run(3, 0, -1)], 0), 1, 2, 5):(Text([1, 2, 3], [Run(1, 0, -1), Run(2, 5, -1), Run(2, 0, -1)], 1), 1, 2, 5)
(Text([1, 2], [Run(1, 0, 3), Run(1, 0, 3)], 4), 1, 1, 0):(Text([1, 2], [Run(1, 0, 3), Run(1, 0, 3), Run(1, 0, 3)], 5), 1, 1, 0)

// Inserts cps at off with the character row cprop. Text typed next to equal properties joins that run; an empty paragraph takes cprop for its one run.
text_insert(Text t, int off, int[] cps, int cprop) {
  int n = len(cps);
  if(n > 0) {
    text_put(t, off, n, cprop);
    lst_splice(t.cps, off, off, cps);
    text_merge(t);
  }
} return void;
(Text([], [Run(0, 3, -1)], 0), 0, [104, 105], 7):(Text([104, 105], [Run(2, 7, -1)], 1), 0, [104, 105], 7)
(Text([1, 2, 3, 4], [Run(4, 0, -1)], 0), 2, [9], 0):(Text([1, 2, 9, 3, 4], [Run(5, 0, -1)], 1), 2, [9], 0)
(Text([1, 2, 3, 4], [Run(4, 0, -1)], 0), 2, [9], 5):(Text([1, 2, 9, 3, 4], [Run(2, 0, -1), Run(1, 5, -1), Run(2, 0, -1)], 1), 2, [9], 5)
(Text([1], [Run(1, 0, -1)], 0), 1, [2], 0):(Text([1, 2], [Run(2, 0, -1)], 1), 1, [2], 0)
(Text([1, 2, 3, 4], [Run(2, 0, 3), Run(2, 1, 3)], 0), 2, [9], 0):(Text([1, 2, 9, 3, 4], [Run(3, 0, 3), Run(2, 1, 3)], 1), 2, [9], 0)
(Text([1, 2], [Run(2, 0, 3)], 0), 2, [9], 0):(Text([1, 2, 9], [Run(2, 0, 3), Run(1, 0, -1)], 1), 2, [9], 0)
(Text([1, 2], [Run(2, 0, -1)], 4), 1, [], 0):(Text([1, 2], [Run(2, 0, -1)], 4), 1, [], 0)
