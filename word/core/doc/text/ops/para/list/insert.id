paras_insert(Para[] pl, int at, Para p) {
  push(pl, p);
  int i = len(pl) - 1;
  while(i > at) {
    pl[i] = pl[i - 1];
    i = i - 1;
  }
} chain (Para[] pl, int at, Para p) {
  pl[at] = p;
} return void;
