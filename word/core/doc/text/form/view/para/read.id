para_len(Para p) {
  int n = len(p.txt.cps);
} return int n;
(Para(Text([1, 2, 3], [Run(3, 0, -1)], 0), Lay([], [], -1), 0)):(3)
(Para(Text([], [Run(0, 0, -1)], 0), Lay([], [], -1), 0)):(0)

para_cp(Para p, int off) {
  int cp = p.txt.cps[off];
} return int cp;
(Para(Text([7, 8, 9], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), 1):(8)
(Para(Text([7, 8, 9], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), 2):(9)

// The index of the run holding code point off; an offset at the end gives the last run.
para_run(Para p, int off) {
  int i = run_at(p.txt, off);
} return int i;
(Para(Text([1, 2, 3], [Run(2, 0, -1), Run(1, 5, -1)], 0), Lay([], [], -1), 0), 2):(1)
(Para(Text([1, 2, 3], [Run(2, 0, -1), Run(1, 5, -1)], 0), Lay([], [], -1), 0), 1):(0)
