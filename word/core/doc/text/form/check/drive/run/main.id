// Gives the document n hyperlink targets, so runs in a script may link.
ext_add_links(Ext x, int n) {
  int i = 0;
  while(i < n) {
    push(x.links, "link" + i);
    i = i + 1;
  }
} return void;
(Ext([], [], []), 2):(Ext([], ["link0", "link1"], []), 2)
