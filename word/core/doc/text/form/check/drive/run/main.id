// 0 when every document invariant holds and the document agrees with the model, the invariant's code when one fails, and -1 when only the model disagrees.
script_verify(Doc d, Model mo) {
  int res = doc_check(d);
  if(res == 0 && model_same(d, mo) == 0) {
    res = -1;
  }
} return int res;
