// One step: pick an operation, run it on the document and the model, note it, and check both again.
script_step(Doc d, Model mo, int[] rg, int[] sx) {
  int kind = script_kind(d, mo, rg);
  script_do(d, mo, rg, kind);
  script_note(d, mo, sx, kind);
} chain (Doc d, Model mo, int[] rg, int[] sx) {
  sx[0] = script_verify(d, mo);
} return void;
