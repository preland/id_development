// The most runs any paragraph has.
max_runs(Doc d) {
  int res = 0;
  int i = 0;
  while(i < len(d.body.paras)) {
    res = fixed_point_maximum(res, len(d.body.paras[i].txt.runs));
    i = i + 1;
  }
} return int res;
