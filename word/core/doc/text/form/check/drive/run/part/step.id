// Which operation to run next, drawn from word_script_roll, except that a document of more than 12 paragraphs only joins or removes and one of more than 400 code points only deletes or joins, so it stays small.
script_kind(Doc d, Model mo, int[] rg) {
  int res = rng_below(rg, len((import word_script_roll)));
  int kind = (import word_script_roll)[res];
  if(doc_count(d) > 12) {
    kind = 6 + 2 * rng_below(rg, 2);
  }
} chain (Doc d, Model mo, int[] rg) {
  if(len(mo.cps) > 400) {
    kind = 1 + 5 * rng_below(rg, 2);
  }
} return int kind;
