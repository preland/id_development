// Turn one flag bit on, off or unset over a random range.
op_bits(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  int bits = 1 << rng_below(rg, 6);
} chain (Doc d, Model mo, int[] rg) {
  int on = rng_below(rg, 3) - 1;
  int[] sp = [0, 0];
  rng_span(rg, para_len(p), sp);
} chain (Doc d, Model mo, int[] rg) {
  int k = flat_at(d, para, sp[0]);
  model_patch(mo, d.fmt.chars, k, sp[1] - sp[0], bits, on, (import word_m_bits));
  text_apply((p.txt), (sp[0]), (sp[1]), (d.fmt.chars), bits, on, (import word_m_bits));
} return void;
