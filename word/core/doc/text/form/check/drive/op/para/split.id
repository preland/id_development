// Join paragraph para with the next one: the paragraph mark after it leaves the model.
op_join_at(Doc d, Model mo, int para) {
  int k = flat_at(d, para, para_len(d.body.paras[para]));
  model_del(mo, k, 1);
  body_join(d.body, para);
} return void;
