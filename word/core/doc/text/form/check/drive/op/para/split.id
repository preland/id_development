// Join a random paragraph with the next one, when there is a next one.
op_join(Doc d, Model mo, int[] rg) {
  int n = doc_count(d);
  if(n > 1) {
    op_join_at(d, mo, rng_below(rg, n - 1));
  }
} return void;
