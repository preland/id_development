// Split a random paragraph at a random offset.
op_split(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  int off = rng_below(rg, para_len(p) + 1);
} chain (Doc d, Model mo, int[] rg) {
  int k = flat_at(d, para, off);
  int[] sep = [-1];
  model_ins(mo, k, sep, -1, -1);
} chain (Doc d, Model mo, int[] rg) {
  body_split(d.body, para, off);
} return void;
