// A paragraph of the given letters, typed with character row cprop into an empty text, with a random paragraph row.
rand_para(int[] rg, Doc d, int[] cps, int cprop) {
  Text t = text_new(0);
  text_insert(t, 0, cps, cprop);
  int pp = rng_below(rg, tab_count(d.fmt.paras));
} chain (int[] rg, Doc d, int[] cps, int cprop) {
  Para p = para_make(t, pp);
} return Para p;
