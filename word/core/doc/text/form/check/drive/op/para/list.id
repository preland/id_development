// Insert a new random paragraph at a random index.
op_newpara(Doc d, Model mo, int[] rg) {
  int index = rng_below(rg, doc_count(d) + 1);
  int[] cps = rand_cps(rg);
  int cprop = rng_below(rg, tab_count(d.fmt.chars));
} chain (Doc d, Model mo, int[] rg) {
  Para p = rand_para(rg, d, cps, cprop);
  int k = flat_at(d, index, 0);
  int[] ins = lst_copy(cps);
} chain (Doc d, Model mo, int[] rg) {
  push(ins, -1);
  model_ins(mo, k, ins, cprop, -1);
  body_insert(d.body, index, p);
} return void;
