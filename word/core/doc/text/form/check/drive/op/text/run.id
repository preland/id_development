// Give a random range random runs: character rows, and links of -1, 0 or 1.
op_runs(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  int[] runs = [];
} chain (Doc d, Model mo, int[] rg) {
  int[] sp = [0, 0];
  rng_span(rg, para_len(p), sp);
  rand_runs(rg, sp[1] - sp[0], tab_count(d.fmt.chars), runs);
} chain (Doc d, Model mo, int[] rg) {
  int k = flat_at(d, para, sp[0]);
  model_put(mo, k, expand_runs(runs, 1), expand_runs(runs, 2));
  text_runs_set(p.txt, sp[0], sp[1], runs);
} return void;
