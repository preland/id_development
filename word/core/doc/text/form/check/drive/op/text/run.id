// Set one character field over a random range.
op_patch(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  int pick = rng_below(rg, len((import word_script_patch)) / 2) * 2;
} chain (Doc d, Model mo, int[] rg) {
  int[] sp = [0, 0];
  rng_span(rg, para_len(p), sp);
  int k = flat_at(d, para, sp[0]);
} chain (Doc d, Model mo, int[] rg) {
  int key = (import word_script_patch)[pick];
  int val = (import word_script_patch)[pick + 1];
  model_patch(mo, d.fmt.chars, k, sp[1] - sp[0], key, val, (import word_m_field));
} chain (Doc d, Model mo, int[] rg) {
  text_patch(p.txt, sp[0], sp[1], d.fmt.chars, key, val);
} return void;
