// Normalise one paragraph's runs again; the text and the properties of every code point must not change.
op_merge(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  text_merge(p.txt);
} return void;
