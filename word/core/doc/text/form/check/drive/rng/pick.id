// A random range inside a paragraph of n code points, as sp = [lo, hi]; [0, 0] when there is no text.
rng_span(int[] rg, int n, int[] sp) {
  sp[0] = 0;
  sp[1] = 0;
  if(n > 0) {
    rng_pair(rg, n, sp);
  }
} return void;
([1], 0, [7, 7]):([1], 0, [0, 0])
([1], 10, [0, 0]):([377401575], 10, [8, 9])

// One to four random lower case letters.
rand_cps(int[] rg) {
  int[] cps = [];
  int n = 1 + rng_below(rg, 4);
  int i = 0;
} chain (int[] rg) {
  while(i < n) {
    push(cps, 97 + rng_below(rg, 26));
    i = i + 1;
  }
} return int[] cps;
([3]):([106, 114, 115, 101])
([9]):([98])

// Appends a run triple of the given length with a random character row below nc and a random link of -1, 0 or 1.
run_triple(int[] rg, int nc, int piece, int[] runs) {
  push(runs, piece);
  push(runs, rng_below(rg, nc));
  push(runs, rng_below(rg, 3) - 1);
} return void;
([1], 8, 2, []):([377401575], 8, 2, [2, 6, 0])
([1], 8, 5, [9]):([377401575], 8, 5, [9, 5, 6, 0])
