// 8 when there is no paragraph, else (i + 1) * 16 plus para_check's code for the first paragraph i that breaks an invariant.
body_check(Doc d) {
  int code = 0;
  int i = 0;
  if(len(d.body.paras) == 0) {
    code = 8;
  }
} chain (Doc d) {
  while(i < len(d.body.paras) && code == 0) {
    int c1 = para_check(d, i);
    if(c1 != 0) {
      code = (i + 1) * 16 + c1;
    }
    i = i + 1;
  }
} return int code;
