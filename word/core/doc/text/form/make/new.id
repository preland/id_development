// An empty paragraph's text: one empty run that carries the character row cprop, so a caret in it has properties to type with.
text_new(int cprop) {
  int[] cps = [];
  Run ru = Run(0, cprop, -1);
  Run[] rs = [];
} chain (int cprop) {
  push(rs, ru);
  Text t = Text(cps, rs, 0);
} return Text t;
(0):(Text([], [Run(0, 0, -1)], 0))
(5):(Text([], [Run(0, 5, -1)], 0))

// A4 portrait with one inch margins and no header or footer; the lists are fresh copies, so editing them never touches the constants.
page_new() {
  int[] size = lst_copy((import word_page_size));
  int[] margin = lst_copy((import word_page_margin));
  int[] hf = [0, 0, 0];
} chain () {
  Page pg = Page(size, margin, hf);
} return Page pg;
():(Page([11906, 16838, 0], [1440, 1440, 1440, 1440], [0, 0, 0]))
():(Page([11906, 16838, 0], [1440, 1440, 1440, 1440], [0, 0, 0])) then calls lst_copy:[2]

// A document's references: the font families it starts with (the default one first), no links, no preserved parts.
ext_new(string font) {
  string[] fonts = [font];
  string[] links = [];
  Part[] parts = [];
} chain (string font) {
  Ext x = Ext(fonts, links, parts);
} return Ext x;
("serif"):(Ext(["serif"], [], []))
("Liberation Sans"):(Ext(["Liberation Sans"], [], []))
