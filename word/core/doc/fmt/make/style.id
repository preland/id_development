// Appends built-in style i, with its rows interned, to the document's styles.
fmt_style(Fmt f, int i) {
  int[] fm = [];
  fmt_rows(f, i, fm);
  int[] rel = lst_slice((import word_style_rel), i * 3, 3);
} chain (Fmt f, int i) {
  Style st = Style((import word_style_names)[i], rel, fm);
  Style[] ss = f.sty.styles;
  push(ss, st);
} return void;
