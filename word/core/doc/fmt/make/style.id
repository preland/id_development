// Interns the character row and the paragraph row of built-in style i and appends their ids to fm.
fmt_rows(Fmt f, int i, int[] fm) {
  int[] crow = lst_slice((import word_style_crow), i * (import word_c_width), (import word_c_width));
  int[] prow = lst_slice((import word_style_prow), i * (import word_p_width), (import word_p_width));
  int cid = tab_intern(f.chars, crow);
} chain (Fmt f, int i, int[] fm) {
  int pid = tab_intern(f.paras, prow);
  push(fm, cid);
  push(fm, pid);
} return void;
