// Folds one layer's flags into acc = [result, known], highest priority layer first: a bit takes its value from the first layer that specifies it.
bits_fold(int[] acc, int on, int sb) {
  int add = sb & ~acc[1];
  acc[0] = acc[0] | (on & add);
  acc[1] = acc[1] | sb;
} return void;
([0, 0], 3, 1):([1, 1], 3, 1)
([2, 2], 1, 3):([3, 3], 1, 3)
([1, 1], 0, 1):([1, 1], 0, 1)

style_fold_one(Fmt f, int sn, int[] acc) {
  int on = style_cell(f, sn, 0, (import word_c_on));
  int sb = style_cell(f, sn, 0, (import word_c_set));
  bits_fold(acc, on, sb);
} return void;
