style_fold_one(Fmt f, int sn, int fold) {
  int on = style_cell(f, sn, 0, (import word_c_on));
  int sb = style_cell(f, sn, 0, (import word_c_set));
  int nxt = bits_fold(fold, on, sb);
} return int nxt;
