style_fold(Fmt f, int sid, int fold) {
  int sn = sid;
  int n = 0;
  int kept = fold;
} chain (Fmt f, int sid, int fold) {
  while(sn >= 0 && n < (import word_style_depth)) {
    kept = style_fold_one(f, sn, kept);
    sn = f.sty.styles[sn].rel[(import word_s_parent)];
    n = n + 1;
  }
} return int kept;
