style_fold(Fmt f, int sid, int[] acc) {
  int sn = sid;
  int n = 0;
  while(sn >= 0 && n < (import word_style_depth)) {
    style_fold_one(f, sn, acc);
    sn = f.sty.styles[sn].rel[(import word_s_parent)];
    n = n + 1;
  }
} return void;
