// The effective value of a character field: the run's own row, then its character style chain, then the paragraph style chain; -1 when none of them sets it. The flag fields are merged bit by bit: "on" by style_bits and "set" is every bit.
style_eff_c(Fmt f, int pstyle, int cprop, int field) {
  int got = tab_get(f.chars, cprop, field);
  int cs = tab_get(f.chars, cprop, (import word_c_style));
  if(got == -1 && cs > 0) {
    got = style_up(f, cs, 0, field);
  }
} chain (Fmt f, int pstyle, int cprop, int field) {
  if(got == -1) {
    got = style_up(f, pstyle, 0, field);
  }
  if(field == (import word_c_on)) {
    got = style_bits(f, pstyle, cprop);
  }
  if(field == (import word_c_set)) {
    got = (import word_f_all);
  }
} return int got;
