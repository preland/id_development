// The effective value of a paragraph field: the paragraph's own row, then its style chain; -1 when none sets it.
style_eff_p(Fmt f, int pprop, int field) {
  int got = tab_get(f.paras, pprop, field);
  int sid = tab_get(f.paras, pprop, (import word_p_style));
  if(got == -1) {
    got = style_up(f, sid, 1, field);
  }
} return int got;
