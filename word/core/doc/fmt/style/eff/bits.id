// The effective flag bits of a run: its own, then its character style chain, then the paragraph style chain, each bit decided by the first layer that specifies it.
style_bits(Fmt f, int pstyle, int cprop) {
  int[] acc = [0, 0];
  int on = tab_get(f.chars, cprop, (import word_c_on));
  int sb = tab_get(f.chars, cprop, (import word_c_set));
} chain (Fmt f, int pstyle, int cprop) {
  bits_fold(acc, on, sb);
  int cs = tab_get(f.chars, cprop, (import word_c_style));
  if(cs > 0) {
    style_fold(f, cs, acc);
  }
} chain (Fmt f, int pstyle, int cprop) {
  style_fold(f, pstyle, acc);
  int res = acc[0];
} return int res;
