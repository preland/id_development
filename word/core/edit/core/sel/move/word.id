// Ctrl+Right: to the start of the next word, or from the end of a paragraph to the start of the next one.
pos_word_next(Doc d, Pos ps) {
  Para p = d.body.paras[ps.para];
  int off = para_word_next(p, ps.off);
  int n = len(d.body.paras);
} chain (Doc d, Pos ps) {
  int para = ps.para;
  if(off == ps.off && para + 1 < n) {
    para = para + 1;
    off = 0;
  }
  Pos pq = pos_new(para, off);
} return Pos pq;
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 0)):(Pos(0, 4))
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 7)):(Pos(1, 0))
given fx_setup("foo bar|baz") ((import fxd), Pos(1, 3)):(Pos(1, 3))

// Ctrl+Left: to the start of the word before, or from the start of a paragraph to the end of the previous one.
pos_word_prev(Doc d, Pos ps) {
  Para p = d.body.paras[ps.para];
  int off = para_word_prev(p, ps.off);
  int para = ps.para;
} chain (Doc d, Pos ps) {
  if(off == ps.off && para > 0) {
    para = para - 1;
    off = para_len(d.body.paras[para]);
  }
  Pos pq = pos_new(para, off);
} return Pos pq;
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 4)):(Pos(0, 0))
given fx_setup("foo bar|baz") ((import fxd), Pos(1, 0)):(Pos(0, 7))
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 0)):(Pos(0, 0))

// The position dir words from ps: -1 back, 1 forward, anything else stays.
pos_word(Doc d, Pos ps, int dir) {
  Pos pq = pos_new(ps.para, ps.off);
  if(dir < 0) {
    pq = pos_word_prev(d, ps);
  }
  if(dir > 0) {
    pq = pos_word_next(d, ps);
  }
} return Pos pq;
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 4), -1):(Pos(0, 0)) then calls pos_word_prev:[1]
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 0), 1):(Pos(0, 4)) then calls pos_word_next:[1]
given fx_setup("foo bar|baz") ((import fxd), Pos(0, 4), 0):(Pos(0, 4))
