// The class the word rule gives the code point at off (0 space, 1 word character, 2 anything else, as utf8_class says), or -1 outside the paragraph.
para_cls(Para p, int off) {
  int cl = -1;
  if(off >= 0 && off < para_len(p)) {
    cl = utf8_class(p.txt.cps[off]);
  }
} return int cl;
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 0):(1)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 3):(0)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 7):(-1)
(Para(Text([102, 46], [Run(2, 0, -1)], 0), Lay([], [], -1), 0), 1):(2)

// The end of the run of class cl that starts at off; a class below 0 is an empty run, which is what stops the loop at the end of the paragraph.
para_run_next(Para p, int off, int cl) {
  while(cl >= 0 && para_cls(p, off) == cl) {
    off = off + 1;
  }
} return int off;
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 0, 1):(3)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 3, 0):(4)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 0, -1):(0)

// The start of the run of class cl that ends at off.
para_run_prev(Para p, int off, int cl) {
  while(cl >= 0 && off > 0 && para_cls(p, off - 1) == cl) {
    off = off - 1;
  }
} return int off;
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 7, 1):(4)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 4, 0):(3)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 7, -1):(7)
