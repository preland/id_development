// Where the word a double click at off selects starts.
para_word_lo(Para p, int off) {
  int at = para_pivot(p, off);
  int cl = para_cls(p, at);
  int lo = para_run_prev(p, at, cl);
} return int lo;
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 5):(4)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 3):(0)
(Para(Text([97, 32, 32, 32, 98], [Run(5, 0, -1)], 0), Lay([], [], -1), 0), 2):(1)

// Where the word a double click at off selects ends.
para_word_hi(Para p, int off) {
  int at = para_pivot(p, off);
  int cl = para_cls(p, at);
  int hi = para_run_next(p, at, cl);
} return int hi;
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 5):(7)
(Para(Text([102, 111, 111, 32, 98, 97, 114], [Run(7, 0, -1)], 0), Lay([], [], -1), 0), 3):(3)
(Para(Text([97, 32, 32, 32, 98], [Run(5, 0, -1)], 0), Lay([], [], -1), 0), 2):(4)
