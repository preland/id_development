// A new editing state: the caret at the start of the document, empty history, and an empty fragment. It also makes the three-cell list ed_acc that sel_state samples into (a list of its own would never be freed, because the samplers are called through function values), and resets the pending typing properties and installs the paragraph-granular line and page movement, so call ed_layout_hooks after it to use real layout.
// ed_typing: The character row the next typed character takes instead of its neighbour's, or -1 when there is none pending.
ctl_new() {
  Sel sel = sel_make(0, 0, 0, 0);
  Txn[] undo = [];
  Txn[] redo = [];
} chain () {
  Hist hs = Hist(undo, redo, -1);
  Text[] txts = [];
  int[] pprops = [];
} chain () {
  Frag frag = Frag(txts, pprops, 1);
  Ctl ctl = Ctl(sel, hs, frag);
  export int[] ed_typing = [-1, 0];
} chain () {
  export int[] ed_acc = [0, 0, 0];
  ed_layout_hooks(ed_hook_para);
} return Ctl ctl;
():(Ctl(Sel(Pos(0, 0), Pos(0, 0), -1), Hist([], [], -1), Frag([], [], 1)))
():(Ctl(Sel(Pos(0, 0), Pos(0, 0), -1), Hist([], [], -1), Frag([], [], 1))) then calls ed_layout_hooks:[1]

// Sets the pending typing row (-1 clears it); any caret move, undo or edit that is not typing clears it.
typing_set(int val) {
  int[] pend = (import ed_typing);
  pend[0] = val;
} return void;
given fx_blank (3):() then (import ed_typing)[0]:(3)
given fx_blank (-1):() then (import ed_typing)[0]:(-1)
