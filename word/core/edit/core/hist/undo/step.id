// Applies a step's operations last to first and returns what each answered, in the order they were applied: that list is the step that undoes the undo.
hist_apply(Doc d, Op[] ops) {
  Op[] invs = [];
  int i = len(ops) - 1;
  while(i >= 0) {
    Op inv = op_apply(d, ops[i]);
    push(invs, inv);
    i = i - 1;
  }
} return Op[] invs;
given fx_setup("ab") ((import fxd), [Op(2, [0, 0, 1, -1, -1], [])]):([Op(1, [0, 0, 0, 1], [97, 1, 0, -1])]) then fx_show:("b")
given fx_setup("ab") ((import fxd), []):([]) then fx_show:("ab")

// Puts back the selection a step recorded: the one from before it, or the one from after it when redoing. The pending typing row is dropped too.
hist_land(Ctl ctl, Txn tx, int again) {
  Sel sel = tx.before;
  if(again == 1) {
    sel = tx.after;
  }
  sel_load(ctl.sel, sel);
} chain (Ctl ctl, Txn tx, int again) {
  typing_set(-1);
} return void;
given fx_blank ((import fxc), Txn([], Sel(Pos(0, 3), Pos(0, 3), -1), Sel(Pos(0, 1), Pos(0, 2), -1)), 1):((import fxc), Txn([], Sel(Pos(0, 3), Pos(0, 3), -1), Sel(Pos(0, 1), Pos(0, 2), -1)), 1) then fx_sel:("0:1-0:2")
