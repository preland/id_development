given fx_blank given typing_set(4) ((import fxc), Txn([], Sel(Pos(0, 3), Pos(0, 3), -1), Sel(Pos(0, 1), Pos(0, 2), -1)), 0):((import fxc), Txn([], Sel(Pos(0, 3), Pos(0, 3), -1), Sel(Pos(0, 1), Pos(0, 2), -1)), 0) then typing_get:(-1)

// Moves the top step of take to give: its operations are applied (see hist_apply) and the answers become the step that reverses it, and the selection is put back for an undo or a redo.
hist_step(Doc d, Ctl ctl, Txn[] take, Txn[] give, int again) {
  Txn tx = pop(take);
  Op[] invs = hist_apply(d, tx.ops);
  Txn rt = Txn(invs, tx.before, tx.after);
} chain (Doc d, Ctl ctl, Txn[] take, Txn[] give, int again) {
  push(give, rt);
  hist_land(ctl, tx, again);
} return void;
