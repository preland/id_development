// A primitive operation of the given kind: loc says where, dat carries what it inserts, sets or restores (the layouts are in docs/WORD.md 3.2.2, as built by the ed_inv_* helpers).
op_make(int kind, int[] loc, int[] dat) {
  Op eo = Op(kind, loc, dat);
} return Op eo;
(1, [0, 1], [5]):(Op(1, [0, 1], [5]))
(6, [], []):(Op(6, [], []))

// The operation that does nothing, which is also what a primitive that cannot apply (a join after the last paragraph) answers with as its own inverse.
ap_nop() {
  int[] none = [];
  Op eo = op_make((import ed_k_nop), none, none);
} return Op eo;
():(Op(0, [], []))
():(Op(0, [], [])) then calls op_make:[1]

// Applies one operation to the document and returns the operation that undoes it; applying that one returns an operation equal to this one in effect, which is what makes undo and redo one mechanism.
op_apply(Doc d, Op eo) {
  Op inv = ap_nop();
  int k = eo.kind;
  if(k == (import ed_k_ins)) {
    inv = ap_ins(d, eo);
  }
} chain (Doc d, Op eo) {
  if(k == (import ed_k_del)) {
    inv = ap_del(d, eo);
  }
  if(k == (import ed_k_split)) {
    inv = ap_split(d, eo);
  }
  if(k == (import ed_k_join)) {
    inv = ap_join(d, eo);
  }
} chain (Doc d, Op eo) {
  if(k == (import ed_k_runs)) {
    inv = ap_runs(d, eo);
  }
  if(k == (import ed_k_pprop)) {
    inv = ap_pprop(d, eo);
  }
  if(k == (import ed_k_inspara)) {
    inv = ap_inspara(d, eo);
  }
} chain (Doc d, Op eo) {
  if(k == (import ed_k_delpara)) {
    inv = ap_delpara(d, eo);
  }
  if(k == (import ed_k_page)) {
    inv = ap_page(d, eo);
  }
} return Op inv;
given fx_setup("ab|cd") ((import fxd), Op(0, [], [])):(Op(0, [], [])) then fx_show:("ab|cd")
