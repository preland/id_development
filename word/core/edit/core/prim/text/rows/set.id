// SET_RUNS, at = [para, lo, hi], data = run triples that cover lo..hi-1. The inverse sets the runs that were there.
ap_runs(Doc d, Op eo) {
  Para p = d.body.paras[eo.at[0]];
  int[] old = runs_span(p.txt, eo.at[1], eo.at[2]);
  text_runs_set(p.txt, eo.at[1], eo.at[2], eo.data);
} chain (Doc d, Op eo) {
  para_stale(p);
  int[] loc = lst_copy(eo.at);
  Op inv = op_make((import ed_k_runs), loc, old);
} return Op inv;
given fx_setup("abcd") ((import fxd), Op(5, [0, 1, 3], [2, 8, -1])):(Op(5, [0, 1, 3], [2, 0, -1])) then fx_show:("a*bc*d")
given fx_setup("") ((import fxd), Op(5, [0, 0, 0], [0, 8, -1])):(Op(5, [0, 0, 0], [0, 0, -1])) then fx_show:("**")
given fx_setup("a*bc*d") ((import fxd), Op(5, [0, 0, 4], [4, 0, -1])):(Op(5, [0, 0, 4], [1, 0, -1, 2, 8, -1, 1, 0, -1])) then fx_show:("abcd")

// SET_PPROP, at = [para], data = [the new paragraph row]. The inverse sets the old one.
ap_pprop(Doc d, Op eo) {
  Para p = d.body.paras[eo.at[0]];
  int[] old = [p.pprop];
  p.pprop = eo.data[0];
} chain (Doc d, Op eo) {
  para_stale(p);
  int[] loc = lst_copy(eo.at);
  Op inv = op_make((import ed_k_pprop), loc, old);
} return Op inv;
given fx_setup("ab|cd") ((import fxd), Op(6, [1], [3])):(Op(6, [1], [0])) then fx_show:("ab|{3}cd")
given fx_setup("ab") given fx_opaque(0) ((import fxd), Op(6, [0], [0])):(Op(6, [0], [9])) then fx_show:("ab")
