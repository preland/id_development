// Test fixture: a function for ed_over to call that notes its paragraph, lo and hi in acc.
fx_note(Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  push(acc, para);
  push(acc, lo);
  push(acc, hi);
} return void;
