// Test fixture: the typing, deleting and clipboard commands of the table: 0 type row[5], 1 Enter, 2 Backspace (row[5] 1 for the word), 3 Delete (likewise), 4 page break, 5 cut, 6 paste ed_t_paste.
fx_cmd_text(Doc d, Ctl ctl, int[] row) {
  if(row[0] == 0) {
    ed_type(d, ctl, row[5]);
  }
  if(row[0] == 1) {
    ed_enter(d, ctl);
  }
  if(row[0] == 2) {
    ed_back(d, ctl, row[5]);
  }
} chain (Doc d, Ctl ctl, int[] row) {
  if(row[0] == 3) {
    ed_delete(d, ctl, row[5]);
  }
  if(row[0] == 4) {
    ed_page_break(d, ctl);
  }
  if(row[0] == 5) {
    ed_cut(d, ctl);
  }
} chain (Doc d, Ctl ctl, int[] row) {
  if(row[0] == 6) {
    ed_paste(d, ctl, (import ed_t_paste));
  }
} return void;
