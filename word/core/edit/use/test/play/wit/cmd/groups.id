// Test fixture: the formatting commands of the table: 10 set character field row[5] to row[6], 11 toggle flag row[5], 12 set paragraph field row[5] to row[6], 13 style row[5], 14 clear formatting, 15 set page field row[5] to row[6].
fx_cmd_fmt(Doc d, Ctl ctl, int[] row) {
  if(row[0] == 10) {
    ed_set_char(d, ctl, row[5], row[6]);
  }
  if(row[0] == 11) {
    ed_toggle(d, ctl, row[5]);
  }
  if(row[0] == 12) {
    ed_set_para(d, ctl, row[5], row[6]);
  }
} chain (Doc d, Ctl ctl, int[] row) {
  if(row[0] == 13) {
    ed_set_style(d, ctl, row[5]);
  }
  if(row[0] == 14) {
    ed_clear_format(d, ctl);
  }
  if(row[0] == 15) {
    ed_set_page(d, ctl, row[5], row[6]);
  }
} return void;
