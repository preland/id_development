// Inserts text t with its runs at the caret in the open undo step and moves the caret after it. An empty text changes nothing.
ed_put_text(Doc d, Ctl ctl, Text t) {
  int n = len(t.cps);
  int[] runs = runs_span(t, 0, n);
  Op eo = ed_inv_ins(ctl.sel.caret.para, ctl.sel.caret.off, t.cps, runs);
} chain (Doc d, Ctl ctl, Text t) {
  if(n > 0) {
    ed_run(d, ctl, eo);
    sel_put(ctl.sel, ctl.sel.caret.para, ctl.sel.caret.off + n, 0);
  }
} return void;
