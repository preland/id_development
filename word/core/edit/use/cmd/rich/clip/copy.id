// Copy: the selection becomes the fragment ctl.clip (kept with its character and paragraph rows) and its plain text is returned for the system clipboard (gfx_clip_set). Nothing selected leaves the fragment alone and returns "". It is not an edit: no undo step, and the open one stays open.
ed_copy(Doc d, Ctl ctl) {
  Pos pa = sel_lo(ctl.sel);
  Pos pb = sel_hi(ctl.sel);
  string plain = "";
} chain (Doc d, Ctl ctl) {
  if(sel_empty(ctl.sel) == 0) {
    ctl.clip = clip_frag(d, pa, pb);
    plain = frag_plain(ctl.clip);
  }
} return string plain;
given fx_setup("ab*cd*e") given fx_at(0, 1, 0, 4) ((import fxd), (import fxc)):("bcd") then fx_clip:("b*cd*")
given fx_setup("ab|cd") given fx_at(0, 1, 1, 1) ((import fxd), (import fxc)):("b\nc") then fx_clip:("b|c")
given fx_setup("ab") given fx_at(0, 1, 0, 1) ((import fxd), (import fxc)):("") then fx_clip:("")

// Cut: copy, then remove the selection as one undo step. Returns the plain text for the system clipboard, "" (and no change) with nothing selected.
ed_cut(Doc d, Ctl ctl) {
  string plain = ed_copy(d, ctl);
  ed_erase_txn(d, ctl);
} return string plain;
given fx_setup("abcd") given fx_at(0, 1, 0, 3) ((import fxd), (import fxc)):("bc") then fx_show:("ad") then fx_clip:("bc") then fx_hist:("u1 r0 o-1 n1")
given fx_setup("abcd") ((import fxd), (import fxc)):("") then fx_show:("abcd") then fx_hist:("u0 r0 o-1 n0")

// Paste: text (the system clipboard, gfx_clip_get) replaces the selection as one undo step. When it is the plain text of ctl.clip the user pasted what was copied here, so the fragment goes in with its character and paragraph rows; anything else goes in as plain text in the typing properties. Empty text does nothing.
ed_paste(Doc d, Ctl ctl, string text) {
  if(len(text) > 0) {
    ed_paste_do(d, ctl, text);
  }
} return void;
given fx_setup("ab") ((import fxd), (import fxc), ""):((import fxd), (import fxc), "") then fx_show:("ab") then fx_hist:("u0 r0 o-1 n0")
given fx_setup("ab") ((import fxd), (import fxc), "xy"):((import fxd), (import fxc), "xy") then fx_show:("xyab") then fx_sel:("0:2-0:2")
