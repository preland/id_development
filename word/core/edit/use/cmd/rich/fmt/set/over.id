// Calls act on every paragraph the selection touches, each with the part of it that is selected. act changes the document (ops in the open undo step) or notes something in acc; it must not add or remove paragraphs, and it must not move the selection, because the two ends are read from the selection itself (a copy of each would be a list never freed, for every frame and key that asks the selection a question).
ed_over(Doc d, Ctl ctl, func(Doc, Ctl, int, int, int, int[]) return void act, int[] acc) {
  Pos pa = ctl.sel.anchor;
  Pos pb = ctl.sel.caret;
  if(pos_lt(ctl.sel.caret, ctl.sel.anchor) == 1) {
    pa = ctl.sel.caret;
    pb = ctl.sel.anchor;
  }
} chain (Doc d, Ctl ctl, func(Doc, Ctl, int, int, int, int[]) return void act, int[] acc) {
  int i = pa.para;
  while(i <= pb.para) {
    ed_over_one(d, ctl, act, acc, i, pa, pb);
    i = i + 1;
  }
} return void;
