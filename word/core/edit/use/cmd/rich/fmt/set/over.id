// An edit of the selection as one undo step: ed_over calls act (see ed_over) between the opening and the closing of the step. Nothing is recorded when act changes nothing.
ed_change(Doc d, Ctl ctl, func(Doc, Ctl, int, int, int, int[]) return void act, int[] acc) {
  txn_begin(ctl);
  ed_over(d, ctl, act, acc);
  ed_close(ctl);
} return void;
