// Gives paragraph para the paragraph row 0 (Normal, nothing set) in the open undo step, unless it has it already or is a block the model does not edit.
par_reset(Doc d, Ctl ctl, int para) {
  int[] loc = [para];
  int[] dat = [0];
  if(d.body.paras[para].pprop != 0 && ed_solid(d, para) == 0) {
    ed_run(d, ctl, op_make((import ed_k_pprop), loc, dat));
  }
} return void;
given fx_setup("ab") given fx_style(0, 3) given txn_begin((import fxc)) ((import fxd), (import fxc), 0):((import fxd), (import fxc), 0) then fx_show:("ab") then fx_hist:("u1 r0 o0 n1")
