// The movement, selection and formatting verbs of ed_play, with flds the argument split at ":": M<dir>:<unit>:<extend> moves, A selects all, S<para>:<off>:<para>:<off> selects, G<bit> toggles a flag, O<field>:<value> sets a character field, L<field>:<value> a paragraph field, Y<style> applies a style, Z clears formatting, K is a page break, H<needle>:<with> replaces all matching case.
ed_play_fmt(Doc d, Ctl ctl, int verb, string[] flds) {
  if(verb == 77) {
    ed_move(d, ctl, to_int(flds[0]), to_int(flds[1]), to_int(flds[2]));
  }
  if(verb == 65) {
    ed_select_all(d, ctl);
  }
  if(verb == 83) {
    ed_play_pick(d, ctl, flds);
  }
} chain (Doc d, Ctl ctl, int verb, string[] flds) {
  if(verb == 71) {
    ed_toggle(d, ctl, to_int(flds[0]));
  }
  if(verb == 79) {
    ed_set_char(d, ctl, to_int(flds[0]), to_int(flds[1]));
  }
  if(verb == 76) {
    ed_set_para(d, ctl, to_int(flds[0]), to_int(flds[1]));
  }
} chain (Doc d, Ctl ctl, int verb, string[] flds) {
  if(verb == 89) {
    ed_set_style(d, ctl, to_int(flds[0]));
  }
  if(verb == 90) {
    ed_clear_format(d, ctl);
  }
  if(verb == 75) {
    ed_page_break(d, ctl);
  }
} chain (Doc d, Ctl ctl, int verb, string[] flds) {
  if(verb == 72) {
    ed_play_swap(d, ctl, flds);
  }
} return void;
given fx_setup("abc") ((import fxd), (import fxc), 77, ["1", "0", "0"]):((import fxd), (import fxc), 77, ["1", "0", "0"]) then fx_sel:("0:1-0:1")
