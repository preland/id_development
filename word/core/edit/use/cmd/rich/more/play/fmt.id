// S<para>:<off>:<para>:<off>: the first position becomes the anchor and the second the caret, as a click and a drag would.
ed_play_pick(Doc d, Ctl ctl, string[] flds) {
  Pos pa = pos_new(to_int(flds[0]), to_int(flds[1]));
  Pos pb = pos_new(to_int(flds[2]), to_int(flds[3]));
  ed_place(d, ctl, pa, 0);
} chain (Doc d, Ctl ctl, string[] flds) {
  ed_place(d, ctl, pb, 1);
} return void;
given fx_setup("ab|cd") ((import fxd), (import fxc), ["0", "1", "1", "1"]):((import fxd), (import fxc), ["0", "1", "1", "1"]) then fx_sel:("0:1-1:1")
given fx_setup("ab|cd") ((import fxd), (import fxc), ["1", "2", "0", "0"]):((import fxd), (import fxc), ["1", "2", "0", "0"]) then fx_sel:("1:2-0:0")

// H<needle>:<with>: Replace All of the typable code points of the first field by the second, matching case.
ed_play_swap(Doc d, Ctl ctl, string[] flds) {
  int[] needle = cps_typable(flds[0]);
  int[] with = cps_typable(flds[1]);
  find_replace_all(d, ctl, needle, with, 1);
} return void;
given fx_setup("aBaB") ((import fxd), (import fxc), ["B", "-"]):((import fxd), (import fxc), ["B", "-"]) then fx_show:("a-a-")
