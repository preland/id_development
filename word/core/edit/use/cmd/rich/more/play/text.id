given fx_setup("foo bar") given fx_at(0, 3, 0, 3) ((import fxd), (import fxc), 66, ""):((import fxd), (import fxc), 66, "") then fx_show:("fo bar")
given fx_setup("foo bar") given fx_at(0, 3, 0, 3) ((import fxd), (import fxc), 68, ""):((import fxd), (import fxc), 68, "") then fx_show:("foobar")
given fx_setup("foo bar") given fx_at(0, 3, 0, 3) ((import fxd), (import fxc), 69, ""):((import fxd), (import fxc), 69, "") then fx_show:("foo| bar")

// The history and clipboard verbs of ed_play: U undo, R redo, C copy, X cut, V paste what was copied (through its plain text, as the system clipboard would), P paste argt as foreign text.
ed_play_hist(Doc d, Ctl ctl, int verb, string argt) {
  if(verb == 85) {
    hist_undo(d, ctl);
  }
  if(verb == 82) {
    hist_redo(d, ctl);
  }
  if(verb == 67) {
    ed_copy(d, ctl);
  }
} chain (Doc d, Ctl ctl, int verb, string argt) {
  if(verb == 88) {
    ed_cut(d, ctl);
  }
  if(verb == 86) {
    ed_paste(d, ctl, frag_plain(ctl.clip));
  }
  if(verb == 80) {
    ed_paste(d, ctl, argt);
  }
} return void;
