// The typing and deleting verbs of ed_play: T types argt, E is Enter, B Backspace, W Ctrl+Backspace, D Delete, F Ctrl+Delete.
ed_play_text(Doc d, Ctl ctl, int verb, string argt) {
  if(verb == 84) {
    ed_type_str(d, ctl, argt);
  }
  if(verb == 69) {
    ed_break(d, ctl, 0);
  }
  if(verb == 66) {
    ed_back(d, ctl, 0);
  }
} chain (Doc d, Ctl ctl, int verb, string argt) {
  if(verb == 87) {
    ed_back(d, ctl, 1);
  }
  if(verb == 68) {
    ed_delete(d, ctl, 0);
  }
  if(verb == 70) {
    ed_delete(d, ctl, 1);
  }
} return void;
given fx_setup("foo bar") given fx_at(0, 7, 0, 7) ((import fxd), (import fxc), 87, ""):((import fxd), (import fxc), 87, "") then fx_show:("foo ")
given fx_setup("foo bar") ((import fxd), (import fxc), 70, ""):((import fxd), (import fxc), 70, "") then fx_show:("bar")
