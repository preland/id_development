// Replaces the n code points of needle that sit at off in paragraph para by with, in the open undo step; the new text takes the character row of the first replaced one.
rep_one(Doc d, Ctl ctl, int para, int off, int[] needle, int[] with) {
  int cprop = para_cprop(d.body.paras[para], off);
  int[] loc = [para, off, cprop, 0];
  ed_del_in(d, ctl, para, off, len(needle));
} chain (Doc d, Ctl ctl, int para, int off, int[] needle, int[] with) {
  if(len(with) > 0) {
    ed_run(d, ctl, op_make((import ed_k_ins), loc, with));
  }
} return void;
