// Opens an undo step unless one is open already, so a command that may turn out to change nothing leaves no step (and the redo stack alone) when it does.
ed_open(Ctl ctl) {
  if(ctl.hist.open < 0) {
    txn_begin(ctl);
  }
} return void;
