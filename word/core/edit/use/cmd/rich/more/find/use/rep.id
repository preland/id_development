// Replaces every match of needle in paragraph para by with (last one first, so the offsets stay right), in the undo step opened for it, and answers how many there were.
rep_para(Doc d, Ctl ctl, int para, int[] needle, int[] with, int flags) {
  int[] ofs = find_all(d.body.paras[para], needle, flags);
  int k = len(ofs) - 1;
  if(k >= 0) {
    ed_open(ctl);
  }
} chain (Doc d, Ctl ctl, int para, int[] needle, int[] with, int flags) {
  while(k >= 0) {
    rep_one(d, ctl, para, ofs[k], needle, with);
    k = k - 1;
  }
  int n = len(ofs);
} return int n;
