// Selects the whole paragraph of ps (what a triple click does): the anchor at its start and the caret at its end.
ed_select_para(Doc d, Ctl ctl, Pos ps) {
  Pos pa = pos_new(ps.para, 0);
  ed_place(d, ctl, pa, 0);
  sel_put(ctl.sel, ps.para, para_len(d.body.paras[ps.para]), 1);
} return void;
given fx_setup("ab|cde") ((import fxd), (import fxc), Pos(1, 1)):((import fxd), (import fxc), Pos(1, 1)) then fx_sel:("1:0-1:3")
given fx_setup("ab|") ((import fxd), (import fxc), Pos(1, 0)):((import fxd), (import fxc), Pos(1, 0)) then fx_sel:("1:0-1:0")
