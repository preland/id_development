// Puts the caret at ps (cut to the document), and the anchor too unless extend is 1; this is what a mouse click does, and like any caret move it closes the open undo step and drops the pending typing row.
ed_place(Doc d, Ctl ctl, Pos ps, int extend) {
  int para = fx_clamp(ps.para, 0, len(d.body.paras) - 1);
  int off = fx_clamp(ps.off, 0, para_len(d.body.paras[para]));
  txn_end(ctl);
} chain (Doc d, Ctl ctl, Pos ps, int extend) {
  typing_set(-1);
  sel_put(ctl.sel, para, off, extend);
} return void;
given fx_setup("ab|cde") ((import fxd), (import fxc), Pos(1, 2), 0):((import fxd), (import fxc), Pos(1, 2), 0) then fx_sel:("1:2-1:2")
given fx_setup("ab|cde") ((import fxd), (import fxc), Pos(9, 9), 1):((import fxd), (import fxc), Pos(9, 9), 1) then fx_sel:("0:0-1:3")

// Selects the whole document.
ed_select_all(Doc d, Ctl ctl) {
  Pos pb = pos_edge(d, 1);
  ed_place(d, ctl, pb, 1);
  sel_put(ctl.sel, 0, 0, 0);
} chain (Doc d, Ctl ctl) {
  sel_put(ctl.sel, pb.para, pb.off, 1);
} return void;
given fx_setup("ab|cde") ((import fxd), (import fxc)):((import fxd), (import fxc)) then fx_sel:("0:0-1:3")
given fx_setup("") ((import fxd), (import fxc)):((import fxd), (import fxc)) then fx_sel:("0:0-0:0")

// Selects the word at ps by the word rule (what a double click does).
ed_select_word(Doc d, Ctl ctl, Pos ps) {
  Para p = d.body.paras[ps.para];
  int lo = para_word_lo(p, ps.off);
  int hi = para_word_hi(p, ps.off);
} chain (Doc d, Ctl ctl, Pos ps) {
  ed_place(d, ctl, pos_new(ps.para, lo), 0);
  sel_put(ctl.sel, ps.para, hi, 1);
} return void;
given fx_setup("foo bar|baz") ((import fxd), (import fxc), Pos(0, 5)):((import fxd), (import fxc), Pos(0, 5)) then fx_sel:("0:4-0:7")
given fx_setup("foo bar|baz") ((import fxd), (import fxc), Pos(1, 1)):((import fxd), (import fxc), Pos(1, 1)) then fx_sel:("1:0-1:3")
