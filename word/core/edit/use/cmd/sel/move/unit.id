// The position dir units from ps, for the units that need no layout: character, word, paragraph and document. Any other unit stays where it is.
pos_unit(Doc d, Pos ps, int dir, int unit) {
  Pos pq = pos_new(ps.para, ps.off);
  if(unit == (import ed_u_char)) {
    pq = pos_char(d, ps, dir);
  }
  if(unit == (import ed_u_word)) {
    pq = pos_word(d, ps, dir);
  }
} chain (Doc d, Pos ps, int dir, int unit) {
  if(unit == (import ed_u_para)) {
    pq = pos_para(d, ps, dir);
  }
  if(unit == (import ed_u_doc)) {
    pq = pos_edge(d, dir);
  }
} return Pos pq;
