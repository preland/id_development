// The end of the selection a plain Left or Right arrow collapses to: the earlier end for dir -1, the later end otherwise.
sel_edge(Sel sel, int dir) {
  Pos pq = sel_hi(sel);
  if(dir < 0) {
    pq = sel_lo(sel);
  }
} return Pos pq;
(Sel(Pos(1, 2), Pos(0, 1), -1), -1):(Pos(0, 1))
(Sel(Pos(1, 2), Pos(0, 1), -1), 1):(Pos(1, 2))

// Moves the caret of ctl dir units without layout (see pos_unit). Unless extend is 1 the anchor follows, except that Left or Right over a selection only collapse it to its near end.
ed_move_pos(Doc d, Ctl ctl, int dir, int unit, int extend) {
  Pos pq = pos_unit(d, ctl.sel.caret, dir, unit);
  if(extend == 0 && unit == (import ed_u_char) && sel_empty(ctl.sel) == 0) {
    pq = sel_edge(ctl.sel, dir);
  }
  sel_put(ctl.sel, pq.para, pq.off, extend);
} return void;
