// Backspace: removes the selection when there is one, else a code point, or with word 1 (Ctrl+Backspace) back to the start of the word. It is one undo step, and does nothing at the very start of the document.
ed_back(Doc d, Ctl ctl, int word) {
  if(sel_empty(ctl.sel) == 0) {
    ed_erase_txn(d, ctl);
  } else {
    ed_back_one(d, ctl, word);
  }
} return void;
