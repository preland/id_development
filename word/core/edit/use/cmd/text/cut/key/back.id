// Backspace at a bare caret: removes the code points ed_key_n counts as one undo step, or at the start of a paragraph joins it to the one before, which keeps its own row.
ed_back_one(Doc d, Ctl ctl, int word) {
  int para = ctl.sel.caret.para;
  int off = ctl.sel.caret.off;
  int n = ed_key_n(d, para, off, word, -1);
} chain (Doc d, Ctl ctl, int word) {
  if(n > 0) {
    ed_del_txn(d, ctl, para, off - n, n);
  }
  if(n == 0 && para > 0) {
    ed_join_txn(d, ctl, para - 1);
  }
} return void;
