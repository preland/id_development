// Delete at a bare caret: removes the code points ed_key_n counts as one undo step, or at the end of a paragraph joins the next one to it.
ed_fwd_one(Doc d, Ctl ctl, int word) {
  int para = ctl.sel.caret.para;
  int off = ctl.sel.caret.off;
  int n = ed_key_n(d, para, off, word, 1);
} chain (Doc d, Ctl ctl, int word) {
  if(n > 0) {
    ed_del_txn(d, ctl, para, off, n);
  }
  if(n == 0 && para + 1 < len(d.body.paras)) {
    ed_join_txn(d, ctl, para);
  }
} return void;
