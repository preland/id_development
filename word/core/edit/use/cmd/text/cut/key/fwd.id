// Delete: removes the selection when there is one, else a code point, or with word 1 (Ctrl+Delete) on to the start of the next word. It is one undo step, and does nothing at the very end of the document.
ed_delete(Doc d, Ctl ctl, int word) {
  if(sel_empty(ctl.sel) == 0) {
    ed_erase_txn(d, ctl);
  } else {
    ed_fwd_one(d, ctl, word);
  }
} return void;
