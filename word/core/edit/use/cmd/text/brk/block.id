// Splits the paragraph at the caret in the open undo step with row pn for the new paragraph, and puts the caret at its start.
ed_split_row(Doc d, Ctl ctl, int pn) {
  int[] loc = [ctl.sel.caret.para, ctl.sel.caret.off];
  int[] dat = [pn, -1, -1, -1, -1];
  ed_run(d, ctl, op_make((import ed_k_split), loc, dat));
} chain (Doc d, Ctl ctl, int pn) {
  sel_put(ctl.sel, ctl.sel.caret.para + 1, 0, 0);
} return void;
