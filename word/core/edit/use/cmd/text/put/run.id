// Inserts the code points cps at the caret in the character row ed_cprop gives, and moves the caret after them; the pending typing row is used up. The step must already be open.
ed_put_cps(Doc d, Ctl ctl, int[] cps) {
  int cprop = ed_cprop(d, ctl);
  int[] loc = [ctl.sel.caret.para, ctl.sel.caret.off, cprop, 0];
  ed_run(d, ctl, op_make((import ed_k_ins), loc, cps));
} chain (Doc d, Ctl ctl, int[] cps) {
  sel_put(ctl.sel, ctl.sel.caret.para, ctl.sel.caret.off + len(cps), 0);
  typing_set(-1);
} return void;
