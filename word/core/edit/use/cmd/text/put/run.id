// Opens a new undo step and removes the selection in it, so that what is typed or pasted next replaces the selection and undoes with it.
ed_begin_over(Doc d, Ctl ctl) {
  txn_begin(ctl);
  ed_erase(d, ctl);
} return void;
given fx_setup("abc") given fx_at(0, 1, 0, 2) ((import fxd), (import fxc)):((import fxd), (import fxc)) then fx_show:("ac") then fx_hist:("u1 r0 o0 n1") then fx_sel:("0:1-0:1")
