// The largest ascent (which 0) or descent (which 1) over the runs that overlap code points lo..hi-1 of paragraph i; the run holding lo always counts, so an empty paragraph measures its one run.
lp_maxm(View v, int i, int lo, int hi, int which) {
  Para p = v.doc.body.paras[i];
  int ri = para_run(p, lo);
  int m = lp_rm(v, i, ri, which);
} chain (View v, int i, int lo, int hi, int which) {
  int rb = lp_rend(p, ri);
  while(rb < hi) {
    ri = ri + 1;
    m = fx_max(m, lp_rm(v, i, ri, which));
    rb = rb + p.txt.runs[ri].len;
  }
} return int m;
