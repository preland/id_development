// How far a run's baseline is raised, in lu, positive up: a superscript (bit 16) rises word_lay_sup percent of the run's nominal pixel size, a subscript (bit 32) drops word_lay_sub percent, anything else stays on the line. Drawing reads this too, so the glyphs sit where layout measured them.
// By hand at 12 pt (16 px = 1024 lu): 1024 * 33 / 100 = 337 up; a 24 pt run (2048 lu) lifts 675.
face_lift(Doc d, int pstyle, int cprop) {
  int bits = style_eff_c(d.fmt, pstyle, cprop, (import word_c_on));
  int hp = style_eff_c(d.fmt, pstyle, cprop, (import word_c_size));
  int lu = face_px(hp, 0, (import word_lay_zoom)) * 64;
} chain (Doc d, int pstyle, int cprop) {
  int lift = 0;
  if((bits & 16) != 0) {
    lift = lu * (import word_lay_sup) / 100;
  }
  if((bits & 32) != 0) {
    lift = 0 - lu * (import word_lay_sub) / 100;
  }
} return int lift;
