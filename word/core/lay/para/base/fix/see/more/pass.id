// Test helper: lays out paragraph 0 of the view n times in a row at 3500 lu, which is how a case sees that a pass refills its lists in place: after one pass or a thousand the lines, the pen and the height are the same, and the work grows with n only.
lp_t_passes(View v, int n) {
  int j = 0;
  while(j < n) {
    lay_para(v, 0, 3500);
    j = j + 1;
  }
} return void;
given lp_t_font given lp_t_ins(0, "BBBB EEEE") ((import lp_t_v), 1):((import lp_t_v), 1) then lp_t_l0:([0, 5, 0, 960, 192, 2732, 5, 9, 1152, 960, 192, 2732]) then lp_t_p0:([0, 683, 1366, 2049, 2732, 0, 683, 1366, 2049, 2732]) then lp_t_h0:(2816) [time:O(n), mem:O(1)]
