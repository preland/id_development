// Test setup: scans the line of paragraph 0 of the test view that starts at lo with its pen at x0 and room for avail lu, leaving the pen filled and the answer thrown away.
lp_t_scan(int lo, int x0, int avail) {
  lp_scan((import lp_t_v), 0, lo, x0, avail);
} return void;
