// Test setup: the handle of the committed Liberation Sans Regular at px pixels, remembered in the cache for font 0, regular style.
lp_t_seed(Face fa, int px) {
  int fh = gui_face_file("../editor/test_assets/LiberationSans-Regular.ttf", px, 0);
  face_add(fa, fh, 0, px, 0);
} return void;
given gui_font_init (Face([], [], 100), 16):(Face([0], [0, 16, 0], 100), 16)
given gui_font_init (Face([], [], 100), 9):(Face([0], [0, 9, 0], 100), 9)

// Test setup: the exported face cache gets six marker handles that name no real font, so a case can tell which key face_for looked up: 10 for font 0 at 16 px regular, 11 bold, 12 italic, 13 for 32 px regular, 14 for 37 px (the Title style's 28 pt) and 15 for 21 px bold (Heading 1's 16 pt).
lp_t_marks() {
  Face fa = (import lp_t_f);
  face_add(fa, 10, 0, 16, 0);
  face_add(fa, 11, 0, 16, 1);
} chain () {
  face_add(fa, 12, 0, 16, 2);
  face_add(fa, 13, 0, 32, 0);
  face_add(fa, 14, 0, 37, 0);
} chain () {
  face_add(fa, 15, 0, 21, 1);
} return void;
