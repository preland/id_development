// Fills lbl, emptied first, with the label of list item lid at level lvl of paragraph i: a bullet is its one code point; a number is lay_number written in the level's format followed by a full stop. Nothing is written for an unknown list or level.
lp_lfill(View v, int i, int[] lbl, int lid, int lvl) {
  int kind = lp_lrow(v, lid, lvl, (import word_l_kind));
  int lf = lp_lrow(v, lid, lvl, (import word_l_fmt));
  if(kind == 0 && lf > 0) {
    push(lbl, lf);
  }
} chain (View v, int i, int[] lbl, int lid, int lvl) {
  if(kind == 1) {
    lp_num(lbl, lay_number(v, i), lf);
    push(lbl, (import word_cp_dot));
  }
} return void;
