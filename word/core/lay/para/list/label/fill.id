// Fills lbl, emptied first, with the label of paragraph i, nothing for a paragraph that is not a list item. The label is drawn in the face of the paragraph's first run, starting at lay_label_x.
lay_label(View v, int i, int[] lbl) {
  lp_clear(lbl);
  lp_lfill(v, i, lbl, lp_list(v, i), lp_prop(v, i, (import word_p_level)));
} return void;
