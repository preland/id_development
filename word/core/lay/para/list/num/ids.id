// The list definition id paragraph i belongs to, 0 for none.
lp_list(View v, int i) {
  int lid = lp_prop(v, i, (import word_p_list));
} return int lid;
given lp_t_new ((import lp_t_v), 0):(0)
given lp_t_new given lp_t_row(0, 9, 2) ((import lp_t_v), 0):(2)

// What paragraph j, met while counting backwards for an item of list lid at level lvl, does to the count: 1 it is an item of the same list and level and counts, 2 it is an item of the same list at a shallower level and so ends the count, 0 anything else (another list, no list, a deeper item).
lp_nd(View v, int j, int lid, int lvl) {
  int lj = lp_list(v, j);
  int vj = lp_prop(v, j, (import word_p_level));
  int res = 0;
} chain (View v, int j, int lid, int lvl) {
  if(lj == lid) {
    res = (vj == lvl) + 2 * (vj < lvl);
  }
} return int res;
given lp_t_new given lp_t_row(0, 9, 2) ((import lp_t_v), 0, 2, 0):(1)
given lp_t_new given lp_t_row(0, 9, 2) ((import lp_t_v), 0, 2, 1):(2)
given lp_t_new given lp_t_row(0, 9, 2) given lp_t_row(0, 10, 1) ((import lp_t_v), 0, 2, 0):(0)
