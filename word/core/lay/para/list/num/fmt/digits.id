// Appends the decimal digits of n to lbl as code points; a negative n is written as 0.
lp_dec(int[] lbl, int n) {
  if(n > 9) {
    lp_dec(lbl, n / 10);
  }
  push(lbl, 48 + fx_max(n, 0) % 10);
} return void;
([], 7):([55])
([], 120):([49, 50, 48])
([], -3):([48])

// Appends n in bijective base 26 (1 is a, 26 is z, 27 is aa, 28 is ab) to lbl, with base 97 for lower case and 65 for upper case.
lp_alpha(int[] lbl, int n, int base) {
  if(n > 26) {
    lp_alpha(lbl, (n - 1) / 26, base);
  }
  push(lbl, base + (n - 1) % 26);
} return void;
([], 1, 97):([97])
([], 26, 97):([122])
([], 27, 97):([97, 97])
([], 53, 65):([66, 65])
