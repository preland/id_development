// The offset where run ri ends, the sum of the lengths of runs 0..ri.
lp_rend(Para p, int ri) {
  int j = 0;
  int e = 0;
  while(j <= ri) {
    e = e + p.txt.runs[j].len;
    j = j + 1;
  }
} return int e;
(Para(Text([1, 2, 3, 4, 5], [Run(2, 0, -1), Run(3, 1, -1)], 0), Lay([], [], -1), 0), 0):(2)
(Para(Text([1, 2, 3, 4, 5], [Run(2, 0, -1), Run(3, 1, -1)], 0), Lay([], [], -1), 0), 1):(5)

// Places the code points k..re-1 of run ri of paragraph i until the run ends or the line starting at lo no longer fits; the pen is filled up to the returned offset, which is re when the whole run was placed.
// By hand at 16 px, B and E are 683 and a space 285 (no kerning among them): "BBBB EEEE" has pen 0, 683, 1366, 2049, 2732 after four Bs, 3017 after the space and 3700 after the first E; in 3500 lu that E does not fit and is placed all the same, so the scan stops at offset 6. In 9999 lu every code point fits and the run ends at 9 with 5749 after the last E.
lp_run(View v, int i, int ri, int k, int re, int lo, int avail) {
  Para p = v.doc.body.paras[i];
  int fh = lp_rface(v, i, ri);
  while(k < re && lp_fit(p, lo, k, avail) == 1) {
    lp_step(p, fh, k);
    k = k + 1;
  }
} return int k;
given lp_t_font given lp_t_ins(0, "BBBB EEEE") given lp_t_pen0(0) ((import lp_t_v), 0, 0, 0, 9, 0, 3500):(6) then lp_t_p0:([0, 683, 1366, 2049, 2732, 3017, 3700])
given lp_t_font given lp_t_ins(0, "BBBB EEEE") given lp_t_pen0(0) ((import lp_t_v), 0, 0, 0, 9, 0, 9999):(9) then lp_t_p0:([0, 683, 1366, 2049, 2732, 3017, 3700, 4383, 5066, 5749])
