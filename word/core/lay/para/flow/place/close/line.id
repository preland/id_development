// Appends the six ints of one line to lines.
lp_rec(int[] lines, int lo, int hi, int y, int asc, int desc, int w) {
  push(lines, lo);
  push(lines, hi);
  push(lines, y);
} chain (int[] lines, int lo, int hi, int y, int asc, int desc, int w) {
  push(lines, asc);
  push(lines, desc);
  push(lines, w);
} return void;
([], 0, 5, 7, 896, 192, 2732):([0, 5, 7, 896, 192, 2732], 0, 5, 7, 896, 192, 2732)
([9, 9], 1, 2, 3, 4, 5, 6):([9, 9, 1, 2, 3, 4, 5, 6], 1, 2, 3, 4, 5, 6)

// Finishes the line lo..hi-1 of paragraph i, which lp_scan has measured: aligns it, measures its ascent and descent over the runs it holds, applies the line spacing, appends its record at the paragraph's running height lay.h and grows lay.h by the line's height.
// By hand at 16 px (ascent 15 px = 960 lu with the line gap, descent 3 px = 192): the line "BBBB " has height 1152 and used width 2732, and at 150 percent (1728 - 192 = 1536 above the descent) it starts at the running height 1000 and the paragraph grows to 1000 + 1728 = 2728. With one E at 24 pt (32 px: ascent 30 px = 1920, descent 7 px = 448) the line takes those, width 683 + 1366 = 2049, height 2368.
lp_close(View v, int i, int lo, int hi, int avail) {
  Para p = v.doc.body.paras[i];
  int we = lp_wend(p, lo, hi);
  int w = p.lay.pen[we] - p.lay.pen[lo];
} chain (View v, int i, int lo, int hi, int avail) {
  int wf = lp_align(v, i, lo, hi, avail, w);
  int asc = lp_maxm(v, i, lo, hi, 0);
  int desc = lp_maxm(v, i, lo, hi, 1);
} chain (View v, int i, int lo, int hi, int avail) {
  int top = lp_lead(asc, desc, style_eff_p(v.doc.fmt, p.pprop, (import word_p_line)));
  lp_rec(p.lay.lines, lo, hi, p.lay.h, top, desc, wf);
  p.lay.h = p.lay.h + top + desc;
} return void;
