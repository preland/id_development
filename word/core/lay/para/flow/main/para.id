// The space before (field word_p_before) or after (word_p_after) paragraph i in lu; unset is 0.
// By hand: the Normal style leaves 120 twips after, 120 * 64 / 15 = 512 lu, and nothing before; 240 twips set on the paragraph are 1024.
lp_space(View v, int i, int field) {
  Para p = v.doc.body.paras[i];
  int tw = style_eff_p(v.doc.fmt, p.pprop, field);
  int lu = lp_lu(fx_max(tw, 0));
} return int lu;
