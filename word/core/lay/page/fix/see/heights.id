// Test check: the height of every paragraph of the test document, comma separated.
lg_t_hs() {
  Doc lgd = (import lp_t_d);
  int[] lgxs = [];
  int lgi = 0;
} chain () {
  while(lgi < len(lgd.body.paras)) {
    push(lgxs, lgd.body.paras[lgi].lay.h);
    lgi = lgi + 1;
  }
  string lgz = dump_ints(lgxs);
} return string lgz;
given lp_t_new ():("-1,")
given lp_t_new given lp_t_paras(2) ():("-1,-1,")

// Test check: 1 when paragraph 0 of the test document asks for a page break, from its paragraph row.
lg_t_brkof() {
  int lgb = lg_t_prop((import word_p_brk));
} return int lgb;
given lp_t_new ():(0)
given lp_t_new given lg_t_brk(0) ():(1)
