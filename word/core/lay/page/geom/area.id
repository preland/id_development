// One margin of the page in lu: side 0 top, 1 right, 2 bottom, 3 left.
// By hand: the default margin is one inch, 1440 twips, 96 px, 6144 lu; 150 twips are 640.
lay_margin(Doc lgd, int lgk) {
  int lgm = lp_lu(lgd.body.page.margin[lgk]);
} return int lgm;
given lp_t_new ((import lp_t_d), 0):(6144)
given lp_t_new given lg_t_page(1500, 3000, 150, 300, 450, 600) ((import lp_t_d), 2):(1920)
given lp_t_new given lg_t_page(1500, 3000, 150, 300, 450, 600) ((import lp_t_d), 3):(2560)

// The size of the text area in lu along axis lgax, 0 the width a paragraph is laid out in and 1 the height a page holds: the sheet less the margins on both sides of that axis (right and left for the width, top and bottom for the height).
// By hand: 1500 twips less 300 on the right and 600 on the left leave 600 twips, 2560 lu; 3000 less 150 and 450 leave 2400 twips, 10240 lu.
lay_area(Doc lgd, int lgax) {
  int lgw = lay_sheet(lgd, lgax);
  int lgr = lay_margin(lgd, 1 - lgax);
  int lgl = lay_margin(lgd, 3 - lgax);
} chain (Doc lgd, int lgax) {
  int lga = lgw - lgr - lgl;
} return int lga;
