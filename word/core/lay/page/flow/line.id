// 1 when line lgj of paragraph lgi, placed with the paragraph's top at lgb on a page whose text area is lga lu high, would end below the bottom of the page.
lay_over(View lgv, int lgi, int lgj, int lgb) {
  int lga = lay_area(lgv.doc, 1);
  int lgy = lgv.doc.body.paras[lgi].lay.lines[lgj * (import word_ln_stride) + (import word_ln_y)];
  int lgh = lay_line_h(lgv, lgi, lgj);
} chain (View lgv, int lgi, int lgj, int lgb) {
  int lgo = lgb + lgy + lgh > lga;
} return int lgo;
