// The height in lu that line lgj of paragraph lgi takes on the page: the ascent and the descent of the line, or the whole box for an object.
// By hand: a 16 px line is 960 + 192 = 1152 lu; an object is word_lay_obj, 4608.
lay_line_h(View lgv, int lgi, int lgj) {
  int[] lgln = lgv.doc.body.paras[lgi].lay.lines;
  int lgb = lay_obj_h(lgv.doc, lgi);
  int lgh = lgln[lgj * (import word_ln_stride) + (import word_ln_asc)] + lgln[lgj * (import word_ln_stride) + (import word_ln_desc)];
} chain (View lgv, int lgi, int lgj) {
  if(lgb > 0) {
    lgh = lgb;
  }
} return int lgh;
