// Places line lgj of paragraph lgi on the walk lgs ([y, used, base], see lay_place): a line that would end below the page, on a page that already holds a line, opens the next page and goes to its top (the paragraph's own top moves up so that the line sits at y 0). The first line also records where the paragraph is.
lay_line(View lgv, int lgi, int lgj, int[] lgs) {
  int lgy = lgv.doc.body.paras[lgi].lay.lines[lgj * (import word_ln_stride) + (import word_ln_y)];
  int lgc = lay_over(lgv, lgi, lgj, lgs[2]) * lgs[1];
  if(lgc == 1) {
    lay_page_open(lgv, lgi, lgj);
    lset(lgs, 2, 0 - lgy);
  }
} chain (View lgv, int lgi, int lgj, int[] lgs) {
  lay_top(lgv, lgi, lgj, lgs);
  lset(lgs, 1, 1);
} return void;
