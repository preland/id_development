// Places the lines of paragraph lgi one by one, from line lgf on: a page that starts in the middle of a paragraph resumes there.
lay_lines(View lgv, int lgi, int lgf, int[] lgs) {
  int lgn = len(lgv.doc.body.paras[lgi].lay.lines) / (import word_ln_stride);
  int lgj = lgf;
  while(lgj < lgn) {
    lay_line(lgv, lgi, lgj, lgs);
    lgj = lgj + 1;
  }
} return void;
