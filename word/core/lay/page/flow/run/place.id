// A paragraph whose row says break before starts a new page, unless the page is empty already.
lay_brk(View lgv, int lgi, int[] lgs) {
  Para lgpa = lgv.doc.body.paras[lgi];
  int lgb = style_eff_p(lgv.doc.fmt, lgpa.pprop, (import word_p_brk));
  if(lgb == 1 && lgs[1] == 1) {
    lay_page_open(lgv, lgi, 0);
    lset(lgs, 0, 0);
    lset(lgs, 1, 0);
  }
} return void;
