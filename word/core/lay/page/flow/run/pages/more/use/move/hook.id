// Does the move lhdir of unit lhunit from the caret of lhs into lho: a page for the page unit, a line up or down for dir 1 and -1, the end or the start of the line for dir 2 and -2. lhg is the x of the page the caret aims for, lhs.goal the one that was kept.
// By hand: unit 4 with dir 1 is a page down; unit 2 with dir 1 a line down, with dir 2 the end of the line, with dir -2 its start.
lay_dispatch(View lhv, Sel lhs, int lhdir, int lhunit, int lhg, Pos lho) {
  if(lhunit == (import ed_u_page)) {
    lay_page_move(lhv, lhs.caret, lhdir, lhg, lho);
  }
  if(lhunit == (import ed_u_line) && fx_abs(lhdir) == 1) {
    lay_move_line(lhv, lhs.caret, lhdir, lhs.goal, lho);
  }
  if(lhunit == (import ed_u_line) && lhdir == 2) {
    lay_line_end(lhv, lhs.caret, lho);
  }
} chain (View lhv, Sel lhs, int lhdir, int lhunit, int lhg, Pos lho) {
  if(lhunit == (import ed_u_line) && lhdir == -2) {
    lay_line_start(lhv, lhs.caret, lho);
  }
} return void;
