// The function ed_move calls for the line and page units once lay_hook_install has run: it moves the caret of lhs by one line (unit line, dir 1 and -1), to the end or the start of its line (dir 2 and -2) or by one page (unit page), the anchor staying, and keeps the x the caret aims for in lhs.goal across the vertical moves, which a horizontal one forgets (sel_put).
// By hand in "BBB", "A", "BBB": a line down from offset 2 of paragraph 0, x 2560 + 1366 = 3926, is offset 1 of paragraph 1 with the goal 3926 kept; the end of the line from offset 6 of "BBB EEE BBB" is 7 and the goal is unset.
lay_hook(Doc lhdc, Sel lhs, int lhdir, int lhunit) {
  View lhv = (import lay_hv);
  Pos lho = pos_new(lhs.caret.para, lhs.caret.off);
  int lhg = lay_goal(lhv, lhs.caret, lhs.goal) + lay_margin(lhv.doc, 3);
} chain (Doc lhdc, Sel lhs, int lhdir, int lhunit) {
  lay_dispatch(lhv, lhs, lhdir, lhunit, lhg, lho);
  sel_put(lhs, lho.para, lho.off, 1);
  int lhu = fx_abs(lhdir) == 1;
} chain (Doc lhdc, Sel lhs, int lhdir, int lhunit) {
  if(lhu == 1) {
    lhs.goal = lhg;
  }
} return void;
