// Installs the layout of view lhv as the one the line and page moves of ed_move use (ed_layout_hooks): lay_hook finds the view again through the export lay_hv, because a function value carries no view of its own.
// By hand: afterwards a page down in an empty new document ends at the end of the view's document, offset 11 of "BBB EEE BBB", and not at the start of the new one as the paragraph hook of ed_hook_para would.
lay_hook_install(View lhv) {
  export View lay_hv = lhv;
  ed_layout_hooks(lay_hook);
} return void;
