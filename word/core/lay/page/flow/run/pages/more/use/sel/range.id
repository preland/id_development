// Records in lhr, [from, to, mark], what of line lhj of paragraph lhi the selection from lhsa to lhsb covers: the offsets from and to (to not above from when none of the line is covered) and mark 1 when the selection goes on past the paragraph, so that the line holds the paragraph mark in it, which is the end of its last line. The paragraph must lie between the two ends.
// By hand in "BBB EEE BBB" in lines of 4, 4 and 3, the selection 1 to 6 covers offsets 1 to 4 of line 0, 4 to 6 of line 1 and nothing of line 2 (8 to 6); from 1 of "BBB" to 1 of the next paragraph, the whole of the last line of the first and the mark.
lay_range(Para lhpa, int lhi, int lhj, Pos lhsa, Pos lhsb, int[] lhr) {
  int lhn = len(lhpa.txt.cps);
  int lhf = lhsa.off * (lhi == lhsa.para);
  int lht = lhn + (lhsb.off - lhn) * (lhi == lhsb.para);
} chain (Para lhpa, int lhi, int lhj, Pos lhsa, Pos lhsb, int[] lhr) {
  int lhlo = lhpa.lay.lines[lhj * (import word_ln_stride) + (import word_ln_lo)];
  int lhhi = lhpa.lay.lines[lhj * (import word_ln_stride) + (import word_ln_hi)];
  lset(lhr, 0, fixed_point_maximum(lhlo, lhf));
} chain (Para lhpa, int lhi, int lhj, Pos lhsa, Pos lhsb, int[] lhr) {
  int lhm = (lhi < lhsb.para) * (lhhi == lhn);
  lset(lhr, 1, fixed_point_minimum(lhhi, lht));
  lset(lhr, 2, lhm);
} return void;
