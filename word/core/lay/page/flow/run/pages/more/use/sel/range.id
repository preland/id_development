// The x, in lu from the left edge of the text area, where a selection that ends at offset lhb of line lhj stops: the pen of that offset, except at the end of a line that is followed by another, where the pen of the offset is the start of the next line and the line's own end, its start plus its used width, is meant.
// By hand: in "BBB EEE BBB" the end of line 0 (offset 4) is 0 + 2049, the used width of the line, not 0 which is the pen of the start of line 1; offset 2 is its pen 1366; the end of the text, offset 11, is its pen 2049.
lay_xend(Para lhpa, int lhj, int lhb) {
  int lhlo = lhpa.lay.lines[lhj * (import word_ln_stride) + (import word_ln_lo)];
  int lhhi = lhpa.lay.lines[lhj * (import word_ln_stride) + (import word_ln_hi)];
  int lhx = lhpa.lay.pen[lhb];
} chain (Para lhpa, int lhj, int lhb) {
  if(lhb == lhhi && lhhi < len(lhpa.txt.cps)) {
    lhx = lhpa.lay.pen[lhlo] + lhpa.lay.lines[lhj * (import word_ln_stride) + (import word_ln_w)];
  }
} return int lhx;
