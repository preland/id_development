given lg_t_text("BBB EEE BBB") ((import lp_t_v), 0, 2560, 90000, Pos(9, 9)):((import lp_t_v), 0, 2560, 90000, Pos(0, 8))
given lg_t_text("BBB EEE BBB") ((import lp_t_v), 7, 2560, 640, Pos(9, 9)):((import lp_t_v), 7, 2560, 640, Pos(0, 0))
given lg_t_paged(8) ((import lp_t_v), 1, 3243, 700, Pos(9, 9)):((import lp_t_v), 1, 3243, 700, Pos(6, 1))

// Puts in lho the position one page up (lhdir -1) or down (1) from lhq at x lhg of the page, the same height on that page; past the first or the last page it is the start or the end of the document.
// By hand: with 6 one-line paragraphs to a page and 8 in all, a page down from paragraph 0 is paragraph 6 at the same height, a page up from paragraph 6 at x 3243 is offset 1 of paragraph 0, and a page down from page 1 is the end of the document, offset 1 of paragraph 7.
lay_page_move(View lhv, Pos lhq, int lhdir, int lhg, Pos lho) {
  int[] lhc = [0, 0, 0, 0];
  lay_caret(lhv, lhq, lhc);
  int lhk = lhc[0] + lhdir;
} chain (View lhv, Pos lhq, int lhdir, int lhg, Pos lho) {
  if(lhk >= 0 && lhk < lhv.pages.count) {
    lay_hit(lhv, lhk, lhg, lhc[2], lho);
  } else {
    Pos lhz = pos_edge(lhv.doc, lhdir);
    lho.para = lhz.para;
    lho.off = lhz.off;
  }
} return void;
given lg_t_paged(8) ((import lp_t_v), Pos(0, 0), 1, 2560, Pos(9, 9)):((import lp_t_v), Pos(0, 0), 1, 2560, Pos(6, 0))
