// Records in lhr, [paragraph, line, found], the line of paragraph lhi that holds height lhy of page lhk, or its last line on the page when lhy is below them; found stays 0 until one is found. Only the lines that are on the page are looked at.
// By hand: in "BBB EEE BBB" height 1900 is on line 1; 9000 is below all of them, so line 2 without found; on page 1 of 28 letters in lines of 3 height 700 is above line 8, the first one there.
lay_pick_para(View lhv, int lhk, int lhi, int lhy, int[] lhr) {
  int[] lhw = [0, 0];
  lay_span(lhv, lhk, lhi, lhw);
  int lhj = lhw[0];
} chain (View lhv, int lhk, int lhi, int lhy, int[] lhr) {
  while(lhj < lhw[1] && lhr[2] == 0) {
    lay_visit(lhv, lhi, lhj, lhy, lhr);
    lhj = lhj + 1;
  }
} return void;
given lg_t_text("BBB EEE BBB") ((import lp_t_v), 0, 0, 1900, [0, 0, 0]):((import lp_t_v), 0, 0, 1900, [0, 1, 1])
given lg_t_text("BBB EEE BBB") ((import lp_t_v), 0, 0, 9000, [0, 0, 0]):((import lp_t_v), 0, 0, 9000, [0, 2, 0])
given lg_t_text("AAAAAAAAAAAAAAAAAAAAAAAAAAAA") ((import lp_t_v), 1, 0, 700, [0, 0, 0]):((import lp_t_v), 1, 0, 700, [0, 8, 1])

// The position under a point of page lhk, lhx and lhy in lu from the corner of the page: the nearest line by height (the first or the last of the page for a point above or below the text), then the nearest offset on it by the pen. A page that does not exist is the nearest one that does. Writes the answer into lho. Uses only the pagination and the pens, no font, and lay_caret of the result is on the same line.
// By hand in "BBB EEE BBB" (left margin 2560, lines 1152 from 640): 3260 across and 1892 down is on line 1 (1792 to 2944), 700 right of its start, nearest the offset 5; far right on line 0 is offset 3, below everything at the left is the start of line 2, offset 8.
lay_hit(View lhv, int lhk, int lhx, int lhy, Pos lho) {
  int lhg = fx_max(fx_min(lhk, lhv.pages.count - 1), 0);
  int[] lhr = [0, 0, 0];
  lay_pick(lhv, lhg, lhy, lhr);
} chain (View lhv, int lhk, int lhx, int lhy, Pos lho) {
  lho.para = lhr[0];
  lho.off = lay_off_at(lhv, lhr[0], lhr[1], lhx - lay_margin(lhv.doc, 3));
} return void;
given lg_t_text("BBB EEE BBB") ((import lp_t_v), 0, 3260, 1892, Pos(9, 9)):((import lp_t_v), 0, 3260, 1892, Pos(0, 5))
