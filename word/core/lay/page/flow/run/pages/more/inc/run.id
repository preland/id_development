// The last page whose first paragraph comes before paragraph lwf, which is where a walk that has to redo lwf starts again; 0 when no page does or none is known.
// By hand: with pages starting at paragraphs 0 and 6, paragraph 7 is redone from page 1 and paragraph 6, which starts page 1 itself, from page 0, because what comes before it may have changed.
lay_page_before(View lwv, int lwf) {
  int lwk = 0;
  int lwj = 0;
  while(lwj < lwv.pages.count) {
    if(lwv.pages.starts[2 * lwj] < lwf) {
      lwk = lwj;
    }
    lwj = lwj + 1;
  }
} return int lwk;
given lg_t_paged(8) ((import lp_t_v), 7):(1)
given lg_t_paged(8) ((import lp_t_v), 6):(0)
given lp_t_new ((import lp_t_v), 3):(0)

// Keeps the first lwn pages and forgets the rest, the sentinel too; a view that has no pages yet gets its first one.
// By hand: after paginating 8 paragraphs the pages are 0, 6 and the sentinel 8; keeping one leaves [0, 0].
lay_keep(View lwv, int lwn) {
  if(len(lwv.pages.starts) < 2 * lwn) {
    lay_pages_reset(lwv);
  } else {
    lwv.pages.count = lwn;
  }
  while(len(lwv.pages.starts) > 2 * lwn) {
    pop(lwv.pages.starts);
  }
} return void;
given lg_t_paged(8) ((import lp_t_v), 1):() then lg_t_starts:("0,0,") then lg_t_count:(1)
