// Paginates again from the page before paragraph lwf and answers how many paragraphs it placed. Paragraphs from lwf to lwl are the ones that changed: once a page starts at the same paragraph and line as it did, past lwl, with the paragraph count the same, everything after it is as it was, so the walk keeps the old pages and the old tops from there and stops. Every paragraph must have been laid out already.
// By hand: 100 one-line paragraphs, 6 to a page, with paragraph 50 changed: the page before it starts at 48, the page after it at 54 is where it was, so paragraphs 48 to 54 are walked, 7 of 100.
lay_walk(View lwv, int lwf, int lwl) {
  int[] lwo = lst_copy(lwv.pages.starts);
  int lwk = lay_page_before(lwv, lwf);
  int[] lws = [0, 0, 0];
} chain (View lwv, int lwf, int lwl) {
  lay_resume(lwv, lwk, lws);
  int lwp = lwv.pages.starts[2 * lwk];
  lay_tops(lwv, lwo, lwp);
} chain (View lwv, int lwf, int lwl) {
  int lwi = lwp + 1;
  int lwn = len(lwv.doc.body.paras);
  int lwx = lay_stable(lwv, lwo, lwl);
} chain (View lwv, int lwf, int lwl) {
  while(lwi < lwn && lwx == 0) {
    lay_place(lwv, lwi, lws);
    lwx = lay_stable(lwv, lwo, lwl);
    lwi = lwi + 1;
  }
  lay_finish(lwv, lwo, lwx);
  int lwd = lwi - lwp;
} return int lwd;
given lg_t_paged(100) given lg_t_edit(50, "x") given lay_all((import lp_t_v)) ((import lp_t_v), 50, 50):(7) then lg_t_count:(17)
given lg_t_paged(8) ((import lp_t_v), 3, 8):(8) then lg_t_starts:("0,0,6,0,8,0,") then lg_t_tops:("640,2304,3968,5632,7296,8960,14976,16640,")
