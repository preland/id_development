// A page starts at paragraph lgi, line lgj: its start is kept in starts (two cells, the paragraph then the line) and the page is counted.
lay_page_open(View lgv, int lgi, int lgj) {
  push(lgv.pages.starts, lgi);
  push(lgv.pages.starts, lgj);
  lgv.pages.count = lgv.pages.count + 1;
} return void;
given lp_t_new ((import lp_t_v), 3, 2):() then (import lp_t_v).pages.starts:([3, 2]) then (import lp_t_v).pages.count:(1)
given lp_t_new given lay_page_open((import lp_t_v), 0, 0) ((import lp_t_v), 5, 1):() then (import lp_t_v).pages.starts:([0, 0, 5, 1]) then (import lp_t_v).pages.count:(2)


// Forgets the pages and opens the first one, at the first line of the first paragraph.
lay_pages_reset(View lgv) {
  lp_clear(lgv.pages.starts);
  lp_clear(lgv.pages.tops);
  lgv.pages.count = 0;
} chain (View lgv) {
  lay_page_open(lgv, 0, 0);
} return void;
given lp_t_new given lay_page_open((import lp_t_v), 4, 4) ((import lp_t_v)):() then (import lp_t_v).pages.starts:([0, 0]) then (import lp_t_v).pages.count:(1)
