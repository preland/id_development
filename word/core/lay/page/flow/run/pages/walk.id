// The first line of a paragraph records where the paragraph's top is in the continuous document: pages one sheet and one gap apart, the top margin down to the text area, then the paragraph's own top on its page.
lay_top(View lgv, int lgi, int lgj, int[] lgs) {
  int lgp = lgv.pages.count - 1;
  int lgm = lay_margin(lgv.doc, 0);
  int lgt = lgp * (lay_sheet(lgv.doc, 1) + (import word_lay_gap)) + lgm + lgs[2];
} chain (View lgv, int lgi, int lgj, int[] lgs) {
  if(lgj == 0) {
    lset(lgv.pages.tops, lgi, lgt);
  }
} return void;
