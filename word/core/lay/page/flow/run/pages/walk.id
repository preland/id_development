// Paginates the document: pages are filled with paragraphs in order, a paragraph is split between pages at a line, and a paragraph that asks for a break starts a page. Every paragraph must have been laid out (lay_all). starts then holds the start of every page, and one more entry (the paragraph count, line 0) that ends the last; tops holds each paragraph's top in the continuous document. From is the paragraph the change began at, kept for the incremental pass that B3b adds; this one always walks everything.
lay_paginate(View lgv, int lgfrom) {
  lay_pages_reset(lgv);
  int[] lgs = [0, 0, 0];
  int lgi = 0;
} chain (View lgv, int lgfrom) {
  while(lgi < len(lgv.doc.body.paras)) {
    lay_place(lgv, lgi, lgs);
    lgi = lgi + 1;
  }
  lay_pages_close(lgv);
} return void;
