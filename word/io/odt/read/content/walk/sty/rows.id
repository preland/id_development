// A text:span starts: the character row in force becomes the row of the span's text style laid over the row that was in force (ost_row for the name, ost_merge for the layering), so the text inside takes it. A span with no style, or one the document does not define, changes nothing.
orc_span_in(Cx cx) {
  int[] rstk = cx.cs.look.rstk;
  int under = lst_last(rstk);
  string sname = xr_attr(cx.rd, "text:style-name");
} chain (Cx cx) {
  int over = ost_row(cx.cs.look.osty, "t:", sname);
  int merged = ost_merge(cx.d, under, over);
  push(rstk, merged);
} return void;
given orc_t_open("<r><office:automatic-styles><style:style style:name='T1' style:family='text'><style:text-properties fo:font-weight='bold'/></style:style></office:automatic-styles><text:span text:style-name='T1'/></r>") given orc_t_steps(7) ((import orc_tc)):() then orc_t_rows:("0,1,")
given orc_t_open("<r><text:span text:style-name='Nope'/></r>") given orc_t_steps(2) ((import orc_tc)):() then orc_t_rows:("0,0,")

// A text:span ends: its row comes off the stack, and the paragraph's own row at the bottom never does.
orc_span_out(Cx cx) {
  int[] rstk = cx.cs.look.rstk;
  if(len(rstk) > 1) {
    pop(rstk);
  }
} return void;
given orc_t_open("<r><text:span text:style-name='Nope'></text:span></r>") given orc_t_steps(2) given orc_span_in((import orc_tc)) given orc_t_steps(1) ((import orc_tc)):() then orc_t_rows:("0,")
given orc_t_open("<a/>") ((import orc_tc)):() then orc_t_rows:("0,")

// Test fixture: the on onv of the character rows in force in orc_tc, bottom first, as dump_ints writes them.
orc_t_rows() {
  Cx cx = (import orc_tc);
  int[] onv = [];
  int i = 0;
} chain () {
  while(i < len(cx.cs.look.rstk)) {
    push(onv, tab_get(cx.d.fmt.chars, cx.cs.look.rstk[i], (import word_c_on)));
    i = i + 1;
  }
  string text = dump_ints(onv);
} return string text;
given orc_t_open("<a/>") ():("0,")
given orc_t_open("<a/>") given orc_span_in((import orc_tc)) ():("0,0,")
