// Reads the head of content.xml up to the start of office:text, noting where each automatic style is (what the names mean is the lookup of ost_load). Answers the event the head stopped at: 1 or 4 for the office:text element, 0 or -1 when the document ended or broke first.
orc_styles(Cx cx) {
  int ev = orc_next(cx);
  while(ev > 0 && orc_at_body(cx, ev) == 0) {
    orc_a_ev(cx, ev);
    ev = orc_next(cx);
  }
} return int ev;
given orc_t_open("<r><office:automatic-styles><style:style style:name='P1' style:family='paragraph'/></office:automatic-styles><office:text><text:p/></office:text></r>") ((import orc_tc)):(1) then orc_t_names:("auto:P1:28,aend:P1:83,")
given orc_t_open("<r><style:style style:name='P1' style:family='paragraph'/></r>") ((import orc_tc)):(0) then orc_t_names:("")
given orc_t_open("<r><office:text/></r>") ((import orc_tc)):(4)

// 1 when the event is the office:text start or empty tag, where the body begins.
orc_at_body(Cx cx, int ev) {
  int at = (ev == 1 || ev == 4) && xr_get((cx.rd), (import xr_k_name)) == "office:text";
} return int at;
given orc_t_open("<office:text/>") given orc_t_steps(1) ((import orc_tc), 4):(1)
given orc_t_open("<office:text><a/></office:text>") given orc_t_steps(2) ((import orc_tc), 4):(0)
given orc_t_open("<office:text></office:text>") given orc_t_steps(2) ((import orc_tc), 2):(0)
