// An end tag of a direct child of office:automatic-styles: when an entry is waiting for its end, the end is the offset hi.
orc_a_close(Cx cx, int hi) {
  int k = cx.cs.slots[(import orc_s_aopen)];
  if(k > 0) {
    lset(cx.cs.lstyles.vals, k - 1, hi);
    lset(cx.cs.slots, (import orc_s_aopen), 0);
  }
} return void;
given orc_t_open("<a/>") given orc_a_push((import orc_tc), "T1", 5, 0) ((import orc_tc), 40):() then orc_t_names:("auto:T1:5,aend:T1:40,") then (import orc_tc).cs.slots:([0, 0, 0, 0, 0, 0, 0, 0])
