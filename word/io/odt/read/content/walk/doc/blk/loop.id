// Reads the body of office:text, which the head stopped at (at 1 is a start tag with a body to read; an empty element has none), one event at a time until its end tag.
orc_body(Cx cx, int at) {
  int ev = 0;
  if(at == 1) {
    ev = orc_next(cx);
  }
  while(ev > 0 && cx.cs.slots[(import orc_s_done)] == 0) {
    orc_block_ev(cx, ev);
    ev = orc_next(cx);
  }
} return void;
given orc_t_open("<r><office:text><text:p>a</text:p></office:text><text:p>z</text:p></r>") given orc_t_pop given orc_t_steps(2) ((import orc_tc), 1):() then orc_t_show:("P0 97, 1:0:-1, {0,0,0,0,0} |  | ")
given orc_t_open("<r><office:text/><text:p>z</text:p></r>") given orc_t_pop given orc_t_steps(2) ((import orc_tc), 4):() then orc_t_show:(" |  | ")

// One event between blocks: an end tag may close a list or the body, a start or empty tag opens a block, and text here (white space between the tags) is nothing.
orc_block_ev(Cx cx, int ev) {
  if(ev == 2) {
    orc_end(cx);
  }
  if(ev == 1 || ev == 4) {
    orc_start(cx, ev);
  }
} return void;
given orc_t_open("<text:p>a</text:p>") given orc_t_pop given orc_t_steps(1) ((import orc_tc), 1):() then orc_t_show:("P0 97, 1:0:-1, {0,0,0,0,0} |  | ")
given orc_t_open("<r> </r>") given orc_t_pop given orc_t_steps(2) ((import orc_tc), 3):() then orc_t_show:(" |  | ")
given orc_t_open("<text:list></text:list>") given orc_t_steps(1) given orc_list_open((import orc_tc)) given orc_t_steps(1) ((import orc_tc), 2):() then orc_t_slots:("0,0,0,0,11,0,0,0,")
given orc_t_open("<text:p/>") given orc_t_pop given orc_t_steps(1) ((import orc_tc), 4):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | ")

// A block starts. Paragraphs and headings are read into the model, a list only changes the counters the paragraphs inside it read, a list item wrapper is stepped through, a declaration of the body is kept apart, and anything else is kept untouched as an opaque block.
orc_start(Cx cx, int ev) {
  string name = xr_get((cx.rd), (import xr_k_name));
  int kind = orc_kind(name);
  if(kind == 0) {
    orc_para(cx, ev);
  }
} chain (Cx cx, int ev) {
  if(kind == 1 && ev == 1) {
    orc_list_open(cx);
  }
  if(kind == 3) {
    int idx = orc_raw(cx, ev);
  }
  if(kind == 4) {
    orc_block(cx, ev, name);
  }
} return void;
given orc_t_open("<text:h text:outline-level='1'>A</text:h>") given orc_t_pop given orc_t_steps(1) ((import orc_tc), 1):() then orc_t_show:("P9 65, 1:0:-1, {3,0,0,0,0} |  | ")
