// Keeps the automatic style that entry k of the table names as the part "auto:NAME", marks the entry as kept, and then keeps the automatic styles that style leans on in turn (its list style, its parent).
orc_take(Cx cx, string sname, int k) {
  int[] vs = cx.cs.lstyles.vals;
  int[] bytes = lst_slice(cx.rd.src, vs[k], vs[k + 1] - vs[k]);
  Part pt = Part((import orc_k_auto) + sname, bytes, (import orc_part_raw));
} chain (Cx cx, string sname, int k) {
  lset(vs, k, 0 - 1);
  push(cx.d.ext.parts, pt);
  orc_autos(cx, bytes);
} return void;
