// A style name an element gave: when it is an automatic style noted in the head and not yet kept, it is kept (a name no automatic style has, such as a style of styles.xml, or an empty name, is none of this reader's business).
orc_ref(Cx cx, string sname) {
  int k = lst_str_index(cx.cs.lstyles.keys, (import orc_k_auto) + sname);
  int fresh = sname != "" && k >= 0 && cx.cs.lstyles.vals[k] >= 0;
  if(fresh == 1) {
    orc_take(cx, sname, k);
  }
} return void;
given orc_t_open("<style:style style:name='S1'/>") given orc_a_push((import orc_tc), "S1", 0, 30) ((import orc_tc), "S1"):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | auto:S1:0:<style:style style:name='S1'/>,")
given orc_t_open("<style:style style:name='S1'/>") given orc_a_push((import orc_tc), "S1", 0, 30) given orc_ref((import orc_tc), "S1") ((import orc_tc), "S1"):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | auto:S1:0:<style:style style:name='S1'/>,")
