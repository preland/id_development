// An end tag between blocks: the end of a list takes one level off, the end of office:text ends the body.
orc_end(Cx cx) {
  string name = xr_get((cx.rd), (import xr_k_name));
  if(name == "text:list") {
    orc_list_end(cx);
  }
  if(name == "office:text") {
    lset(cx.cs.slots, (import orc_s_done), 1);
  }
} return void;
given orc_t_open("<office:text></office:text>") given orc_t_steps(2) ((import orc_tc)):() then (import orc_tc).cs.slots:([0, 0, 0, 0, 13, 1, 0, 0])
given orc_t_open("<a></a>") given orc_t_steps(2) ((import orc_tc)):() then (import orc_tc).cs.slots:([0, 0, 0, 0, 3, 0, 0, 0])
given orc_t_open("<text:list></text:list>") given orc_t_steps(1) given orc_list_open((import orc_tc)) given orc_t_steps(1) ((import orc_tc)):() then (import orc_tc).cs.slots:([0, 0, 0, 0, 11, 0, 0, 0])

// A text:list opens: one level deeper, and when it names a list style that one is the list its paragraphs belong to. A nested list that names none keeps the list around it.
orc_list_open(Cx cx) {
  int lvl = cx.cs.slots[(import orc_s_lvl)] + 1;
  int id = ost_list(cx.cs.look.osty, xr_attr(cx.rd, "text:style-name"));
  lset(cx.cs.slots, (import orc_s_lvl), lvl);
} chain (Cx cx) {
  if(id > 0) {
    lset(cx.cs.slots, (import orc_s_list), id);
  }
} return void;
given orc_t_open("<r><office:automatic-styles><text:list-style style:name='L1'><text:list-level-style-number text:level='1'/></text:list-style></office:automatic-styles><office:body><office:text><text:list text:style-name='L1'>") given orc_t_head given orc_t_steps(1) ((import orc_tc)):() then (import orc_tc).cs.slots:([1, 3, 0, 0, 177, 0, 0, 0])
given orc_t_open("<r><office:automatic-styles><text:list-style style:name='L1'><text:list-level-style-bullet text:level='1'/></text:list-style></office:automatic-styles><office:body><office:text><text:list text:style-name='L1'><text:list-item><text:list>") given orc_t_head given orc_t_steps(1) given orc_list_open((import orc_tc)) given orc_t_steps(2) ((import orc_tc)):() then (import orc_tc).cs.slots:([2, 3, 0, 0, 225, 0, 0, 0])
given orc_t_open("<text:list text:style-name='Nope'>") given orc_t_steps(1) ((import orc_tc)):() then (import orc_tc).cs.slots:([1, 0, 0, 0, 0, 0, 0, 0])

// A text:list ends: one level up, and outside every list there is no list.
orc_list_end(Cx cx) {
  int lvl = cx.cs.slots[(import orc_s_lvl)] - 1;
  lset(cx.cs.slots, (import orc_s_lvl), lvl);
  if(lvl == 0) {
    lset(cx.cs.slots, (import orc_s_list), 0);
  }
} return void;
given orc_t_open("<a/>") given orc_t_set(0, 2) given orc_t_set(1, 1) ((import orc_tc)):() then (import orc_tc).cs.slots:([1, 1, 0, 0, 0, 0, 0, 0])
given orc_t_open("<a/>") given orc_t_set(0, 1) given orc_t_set(1, 1) ((import orc_tc)):() then (import orc_tc).cs.slots:([0, 0, 0, 0, 0, 0, 0, 0])
