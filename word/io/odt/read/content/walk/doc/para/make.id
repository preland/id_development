// The paragraph row of the paragraph element that has just started: its style (a heading with none takes Heading 1 to 3 by its outline level), then the list and level it sits in.
orc_pprop(Cx cx) {
  string sname = xr_attr(cx.rd, "text:style-name");
  int lvl = to_int(xr_attr(cx.rd, "text:outline-level"));
  int rw = orc_pstyle(cx, sname, lvl);
} chain (Cx cx) {
  int pp = orc_plist(cx, rw);
} return int pp;
