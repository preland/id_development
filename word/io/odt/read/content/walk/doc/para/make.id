// A paragraph starts with no hyperlink around its text, with a space as the last character, so the white space that opens it is dropped, and with the character row its style's own text properties amount to (none: row 0, Normal's).
orc_reset(Cx cx) {
  lset(cx.cs.slots, (import orc_s_space), 1);
  lset(cx.cs.slots, (import orc_s_link), 0);
  string sname = xr_attr(cx.rd, "text:style-name");
} chain (Cx cx) {
  int ov = ost_over(cx.cs.look.osty, sname);
  int[] rstk = cx.cs.look.rstk;
  int top = len(rstk);
} chain (Cx cx) {
  int[] row0 = [fx_max(ov, 0)];
  lst_splice(rstk, 0, top, row0);
} return void;
