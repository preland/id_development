// A text:p or text:h that has just started becomes a paragraph of the body: its paragraph row from the element's attributes, then its text up to the matching end tag (an empty element has none).
orc_para(Cx cx, int ev) {
  Text t = text_new(0);
  int pp = orc_pprop(cx);
  orc_reset(cx);
} chain (Cx cx, int ev) {
  if(ev == 1) {
    orc_inline(cx, t, xr_depth(cx.rd));
  }
  Para p = para_make(t, pp);
  push(cx.d.body.paras, p);
} return void;
