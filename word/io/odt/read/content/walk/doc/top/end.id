// 0 when the read went well; the XML fault when the reader met one (its message, which carries the byte offset, is kept for odt_error); else the missing-body code when the head ended without an office:text start tag (at is the event the head stopped at).
orc_status(Cx cx, int at) {
  string err = xr_get((cx.rd), (import xr_k_error));
  int code = 0;
  if(at <= 0 && err == "") {
    code = (import orc_e_body);
  }
} chain (Cx cx, int at) {
  if(err != "") {
    code = (import orc_e_xml);
    orc_why(err);
  }
} return int code;
