// A document always has a paragraph to hold the caret: when the body gave none (an empty office:text, or only declarations), one empty paragraph is added.
orc_finish(Cx cx) {
  Para[] pl = cx.d.body.paras;
  Text t = text_new(0);
  Para np = para_make(t, 0);
} chain (Cx cx) {
  if(len(pl) == 0) {
    push(pl, np);
  }
} return void;
