// Reads the styles and then content.xml of a sound archive into the document: ost_load for what the style names mean, then the XML reader over the body, the read, and its code. A bad CRC on the way surfaces as the zip code.
orc_parse(Zip z, Doc d) {
  int ci = zr_find(z, "content.xml");
  int[] xs = zr_read(z, ci);
  OdtSty osty = ost_new();
} chain (Zip z, Doc d) {
  int code = orc_sty(z, d, xs, osty);
  XmlR rd = xr_open(xs);
  Cx cx = orc_new(d, rd, osty);
} chain (Zip z, Doc d) {
  if(code == 0) {
    code = orc_content(cx);
  }
  if(zr_ok(z) == 0) {
    code = (import orc_e_zip);
    orc_why(zr_why(z));
  }
} return int code;
