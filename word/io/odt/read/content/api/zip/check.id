// 0 when the archive can be read as an ODT: the zip is sound, it has a content.xml, and its mimetype entry, if it has one, says text document. Otherwise the code of the first thing wrong (the reason is kept for odt_error).
orc_zip_code(Zip z) {
  int code = 0;
  int mi = zr_find(z, "mimetype");
  int ci = zr_find(z, "content.xml");
} chain (Zip z) {
  if(zr_ok(z) == 0) {
    code = (import orc_e_zip);
    orc_why(zr_why(z));
  }
  if(code == 0 && ci < 0) {
    code = (import orc_e_nocontent);
  }
  if(code == 0 && mi >= 0) {
    code = orc_mime(z, mi);
  }
} return int code;
