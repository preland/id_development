// 0 when the mimetype entry (entry mi) is exactly the text document type; otherwise the mimetype code, with the entry's size kept as the reason.
orc_mime(Zip z, int mi) {
  int[] xs = zr_read(z, mi);
  int code = 0;
  if(orc_same(xs, (import orc_mimetype)) == 0) {
    code = (import orc_e_mime);
    orc_why("the mimetype entry is " + len(xs) + " bytes and does not read " + (import orc_mimetype));
  }
} return int code;
