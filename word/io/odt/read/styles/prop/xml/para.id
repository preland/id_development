// Reads every attribute ost_pattr lists off the current element into a paragraph row; a value that does not read leaves its field as it was.
ost_ptext(int[] os_lprow, XmlR os_r) {
  int os_ik = 0;
  while(os_ik < len((import ost_pattr))) {
    string os_sv = xr_attr(os_r, (import ost_pattr)[os_ik]);
    ost_pset(os_lprow, os_ik, os_sv);
    os_ik = os_ik + 1;
  }
} return void;
