// Test fixtures: a reader over a string kept in an export, so a case can `given` it, step it and hand it to the function under test.
ost_t_open(string os_ss) {
  int[] os_lsrc = exec_bytes(os_ss);
  export XmlR ost_t_r = xr_open(os_lsrc);
} return void;
("<a/>"):() then ost_t_name:("")
("<a><b/></a>"):() then ost_t_name:("")

ost_t_steps(int os_in) {
  xr_skip((import ost_t_r), os_in);
} return void;
given ost_t_open("<a/>") (1):() then ost_t_name:("a")
given ost_t_open("<a/>") (0):() then ost_t_name:("")

ost_t_name() {
  XmlR os_r = (import ost_t_r);
  string os_sname = xr_name(os_r);
} return string os_sname;
given ost_t_open("<ab/>") given ost_t_steps(1) ():("ab")
given ost_t_open("<a><b/></a>") given ost_t_steps(2) ():("b")
