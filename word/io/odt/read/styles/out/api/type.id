// What the content reader asks the styles reader: three parallel lists, one entry per name. A key is "p:" (paragraph), "t:" (text) or "l:" (list) followed by the style's name in the file; its id is the paragraph row, the character row or the list definition the name stands for, and over is the character row a paragraph style's own text properties amount to (-1 when it has none, and for the other two kinds).
struct OdtSty {
  string[] keys;
  int[] ids;
  int[] over;
}
