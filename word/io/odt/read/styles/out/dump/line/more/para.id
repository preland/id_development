// The paragraph record of a dump, without its runs: "para N style=NAME align= left= right= first= before= after= line= brk= level= list=", or "para N opaque" for an opaque block.
ndump_phead(Doc os_d, Para os_p, int os_i) {
  int os_ipstyle = fx_max(tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_style)), 0);
  string os_sstyle = str_quote(os_d.fmt.sty.styles[os_ipstyle].name);
  string os_sout = "para " + os_i + " opaque";
} chain (Doc os_d, Para os_p, int os_i) {
  string os_sa = "para " + os_i + " style=" + os_sstyle + " align=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_align)));
  string os_sb = ndump_pbox(os_d, os_p) + " line=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_line)));
  int os_ilevel = tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_level));
} chain (Doc os_d, Para os_p, int os_i) {
  string os_sc = " brk=" + tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_brk)) + " level=" + os_ilevel;
  string os_sl = " list=" + ndump_list(os_d.fmt, tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_list)), os_ilevel);
  if(tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_kind)) == 0) {
    os_sout = os_sa + " " + os_sb + os_sc + os_sl;
  }
} return string os_sout;
