// The box fields of a paragraph record, resolved through its style: "left= right= first= before= after=" in twips, "-" for unset.
ndump_pbox(Doc os_d, Para os_p) {
  string os_sa = "left=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_left))) + " right=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_right)));
  string os_sb = "first=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_first))) + " before=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_before)));
  string os_sout = os_sa + " " + os_sb + " after=" + ndump_num(style_eff_p(os_d.fmt, os_p.pprop, (import word_p_after)));
} return string os_sout;
