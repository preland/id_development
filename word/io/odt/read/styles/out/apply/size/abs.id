// The size, in half-points, text of record os_i has: its own when absolute, a percentage of what its parent chain gives when relative (24 when nothing does), what the chain gives when it sets none; the default paragraph style's size ends a chain, -1 when nothing sets one. os_id is the depth walked, bounded so a cycle ends.
ost_abs(StyBag os_b, int os_i, int os_id) {
  int os_isz = os_b.crows[os_i][(import word_c_size)];
  int os_ip = ost_par(os_b, os_i);
  int os_ibase = ost_dsize(os_b);
} chain (StyBag os_b, int os_i, int os_id) {
  if(os_ip >= 0 && os_id < (import word_style_depth)) {
    os_ibase = ost_abs(os_b, os_ip, os_id + 1);
  }
  int os_iref = os_ibase;
  if(os_ibase < 0) {
    os_iref = 24;
  }
} chain (StyBag os_b, int os_i, int os_id) {
  if(os_isz <= (import ost_pct_base)) {
    os_ibase = (os_iref * ((import ost_pct_base) - os_isz) + 50) / 100;
  }
  if(os_isz >= 0) {
    os_ibase = os_isz;
  }
} return int os_ibase;
