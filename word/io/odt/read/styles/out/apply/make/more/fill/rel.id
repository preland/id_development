// The style index of the named style that record os_i names in its string at os_ik (its parent or its next style), -1 when it names none or names one the bag does not define.
ost_link(StyBag os_b, int[] os_lidx, int os_i, int os_ik) {
  string os_sname = os_b.strings[os_i * (import ost_s_width) + os_ik];
  string os_sfam = os_b.strings[os_i * (import ost_s_width) + (import ost_s_fam)];
  int os_ir = ost_rec_find(os_b, os_sname, os_sfam, "n");
} chain (StyBag os_b, int[] os_lidx, int os_i, int os_ik) {
  int os_ires = 0 - 1;
  if(os_ir >= 0 && os_sname != "") {
    os_ires = os_lidx[os_ir];
  }
} return int os_ires;
