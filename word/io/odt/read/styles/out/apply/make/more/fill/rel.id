// Sets the parent and next style of the model style os_idx from record os_i: a paragraph style with no parent sits on Normal (0), a style with no next style is its own next.
ost_rel_set(Fmt os_f, StyBag os_b, int[] os_lidx, int os_i) {
  int os_idx = os_lidx[os_i];
  int os_ipar = ost_link(os_b, os_lidx, os_i, (import ost_s_parent));
  int os_inext = ost_link(os_b, os_lidx, os_i, (import ost_s_next));
} chain (Fmt os_f, StyBag os_b, int[] os_lidx, int os_i) {
  int[] os_lrel = os_f.sty.styles[os_idx].rel;
  if(os_ipar < 0 && os_lrel[(import word_s_family)] == 0) {
    os_ipar = 0;
  }
  if(os_inext < 0) {
    os_inext = os_idx;
  }
} chain (Fmt os_f, StyBag os_b, int[] os_lidx, int os_i) {
  os_lrel[(import word_s_parent)] = os_ipar;
  os_lrel[(import word_s_next)] = os_inext;
} return void;
