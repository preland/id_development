// The model style a record stands for: for a named style its index (found, or appended), -1 for any other kind of record.
ost_reg_one(Fmt os_f, StyBag os_b, int os_i) {
  string os_skind = os_b.strings[os_i * (import ost_s_width) + (import ost_s_kind)];
  int os_ifam = os_b.strings[os_i * (import ost_s_width) + (import ost_s_fam)] == "t";
  int os_idx = 0 - 1;
} chain (Fmt os_f, StyBag os_b, int os_i) {
  string os_swire = os_b.strings[os_i * (import ost_s_width) + (import ost_s_name)];
  string os_sdisp = os_b.strings[os_i * (import ost_s_width) + (import ost_s_disp)];
  if(os_skind == "n") {
    os_idx = ost_sty_need(os_f, ost_mname(os_swire, os_sdisp), os_ifam);
  }
} return int os_idx;
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([Style("Normal", [0, -1, 0], [0, 0])], [], 0)), StyBag(["Standard", "", "", "", "", "", "p", "n"], [[]], [[]]), 0):(0)
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([Style("Normal", [0, -1, 0], [0, 0])], [], 0)), StyBag(["Text_20_body", "", "", "", "", "", "p", "n"], [[]], [[]]), 0):(1)
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([Style("Normal", [0, -1, 0], [0, 0])], [], 0)), StyBag(["P1", "", "", "", "", "", "p", "a"], [[]], [[]]), 0):(-1)

// The model style index of every record of the bag, in order: styles the document names are found among the model's or appended; every other record gets -1.
ost_reg(Fmt os_f, StyBag os_b) {
  int[] os_lidx = [];
  int i = 0;
  while(i < ost_bag_n(os_b)) {
    push(os_lidx, ost_reg_one(os_f, os_b, i));
    i = i + 1;
  }
} return int[] os_lidx;
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([Style("Normal", [0, -1, 0], [0, 0])], [], 0)), StyBag(["Standard", "", "", "", "", "", "p", "n", "Foo", "", "", "", "", "", "p", "n", "P1", "", "", "", "", "", "p", "a"], [[], [], []], [[], [], []])):([0, 1, -1])
