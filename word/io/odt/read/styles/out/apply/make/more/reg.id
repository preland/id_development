// The index of the model style called os_sname in family os_ifam, appended with no properties and no parent when the document does not have it yet.
ost_sty_need(Fmt os_f, string os_sname, int os_ifam) {
  int os_idx = ost_sty_find(os_f, os_sname, os_ifam);
  int[] os_lrel = [os_ifam, 0 - 1, 0 - 1];
  int[] os_lfm = [0, 0];
} chain (Fmt os_f, string os_sname, int os_ifam) {
  Style os_st = Style(os_sname, os_lrel, os_lfm);
  if(os_idx < 0) {
    push(os_f.sty.styles, os_st);
    os_idx = len(os_f.sty.styles) - 1;
  }
} return int os_idx;
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([Style("A", [0, -1, 0], [0, 0])], [], 0)), "A", 0):(0)
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([Style("A", [0, -1, 0], [0, 0])], [], 0)), "A", 1):(1)
