// Rebuilds Normal from the document's default paragraph style and its "Standard" style, the first with the second laid over it; the built-in Normal is left alone when the document defines neither.
ost_fill_normal(Doc os_d, StyBag os_b, string[] os_lface) {
  int os_ij = ost_rec_find(os_b, "", "p", "d");
  int os_is = ost_rec_find(os_b, (import word_style_wire)[0], "p", "n");
  int[][] os_lrows = [lst_copy((import ost_cdef)), lst_copy((import ost_pdef))];
} chain (Doc os_d, StyBag os_b, string[] os_lface) {
  if(os_ij >= 0) {
    ost_norm_over(os_d, os_b, os_lface, os_ij, os_lrows);
  }
  if(os_is >= 0) {
    ost_norm_over(os_d, os_b, os_lface, os_is, os_lrows);
  }
  if(os_ij >= 0 || os_is >= 0) {
    ost_norm_set(os_d, os_lrows);
  }
} return void;
