// Lays record os_i over the rows os_lc and os_lp being built for Normal: the record's rows merged on top of them.
ost_norm_over(Doc os_d, StyBag os_b, string[] os_lface, int os_i, int[][] os_lrows) {
  int[] os_lc = ost_rowc(os_d, os_b, os_lface, os_i, 0);
  int[] os_lp = ost_rowp(os_d.fmt, os_b, os_i, 0 - 1);
  os_lrows[0] = ost_cmerge(os_lrows[0], os_lc);
} chain (Doc os_d, StyBag os_b, string[] os_lface, int os_i, int[][] os_lrows) {
  os_lrows[1] = ost_pmerge(os_lrows[1], os_lp);
} return void;
