// Stores the character row and paragraph row being built for Normal, interned, as Normal's own.
ost_norm_set(Doc os_d, int[][] os_lrows) {
  int[] os_lfm = os_d.fmt.sty.styles[0].fmt;
  os_lfm[(import word_s_cprop)] = tab_intern(os_d.fmt.chars, os_lrows[0]);
  os_lfm[(import word_s_pprop)] = tab_intern(os_d.fmt.paras, os_lrows[1]);
} return void;
