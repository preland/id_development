// The id of the list definition called os_sname (searched from the end), 0 for none.
ost_list_id(Fmt os_f, string os_sname) {
  int os_il = 0;
  int i = len(os_f.sty.lists) - 1;
  while(i > 0 && os_il == 0) {
    if(os_f.sty.lists[i].name == os_sname) {
      os_il = i;
    }
    i = i - 1;
  }
} return int os_il;
