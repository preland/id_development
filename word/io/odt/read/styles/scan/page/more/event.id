// What one event of a styles document adds to the table: a page layout starts a layout with the default ints, its properties fill the last layout, a master page records its name and its layout's. Answers 1 to go on and 0 once the body begins.
ost_pg_event(PgTab os_pg, XmlR os_r, int os_iev) {
  string os_sname = xr_name(os_r);
  int os_igo = 1;
  if(os_sname == "style:page-layout" && os_iev != 2) {
    ost_pg_start(os_pg, os_r);
  }
} chain (PgTab os_pg, XmlR os_r, int os_iev) {
  if(os_sname == "style:page-layout-properties" && os_iev != 2 && len(os_pg.vals) > 0) {
    ost_pg_props(os_pg, os_r);
  }
  if(os_sname == "style:master-page" && os_iev != 2) {
    ost_pg_master(os_pg, os_r);
  }
  if(os_sname == "office:body") {
    os_igo = 0;
  }
} return int os_igo;
