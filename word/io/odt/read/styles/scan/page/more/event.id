// Sets a layout's orientation (its third int) from style:print-orientation, or from the shape of the page when the attribute is absent.
ost_pg_orient(int[] os_lpg, XmlR os_r) {
  string os_so = xr_attr(os_r, "style:print-orientation");
  int os_il = os_lpg[0] > os_lpg[1];
  if(os_so != "") {
    os_il = os_so == "landscape";
  }
} chain (int[] os_lpg, XmlR os_r) {
  os_lpg[2] = os_il;
} return void;
