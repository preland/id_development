// Reads the page-layout-properties element the reader is at into the last layout of the table.
ost_pg_props(PgTab os_pg, XmlR os_r) {
  int os_in = len(os_pg.vals) - 1;
  int[] os_lpg = os_pg.vals[os_in];
  ost_pg_dims(os_lpg, os_r);
} chain (PgTab os_pg, XmlR os_r) {
  ost_pg_orient(os_lpg, os_r);
} return void;
