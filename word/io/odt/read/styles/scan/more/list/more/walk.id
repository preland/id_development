// Reads every list style of a styles or content document into the document's lists, up to the body.
ost_lists(Fmt os_f, XmlR os_r) {
  int os_iev = xr_next(os_r);
  int os_igo = 1;
  while(os_iev > 0 && os_igo == 1) {
    os_igo = ost_lists_one(os_f, os_r, os_iev);
    os_iev = xr_next(os_r);
  }
} return void;
