// Reads one event of a styles or content document: a list style is read into the document, and the body ends the reading. Answers 1 to go on, 0 to stop.
ost_lists_one(Fmt os_f, XmlR os_r, int os_iev) {
  string os_sname = xr_name(os_r);
  int os_igo = 1;
  if(os_sname == "text:list-style" && os_iev != 2) {
    ost_list_read(os_f, os_r, os_iev);
  }
} chain (Fmt os_f, XmlR os_r, int os_iev) {
  if(os_sname == "office:body") {
    os_igo = 0;
  }
} return int os_igo;
