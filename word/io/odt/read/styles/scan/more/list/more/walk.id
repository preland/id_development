// Reads the list style the reader is at, called by its style:name, into a new list definition: three levels (kind, format or bullet, start, indents) started from the round-bullet defaults and overwritten by what the style says.
ost_list_read(Fmt os_f, XmlR os_r, int os_iev) {
  string os_sname = xr_attr(os_r, "style:name");
  int[] os_llv = lst_copy((import word_list_bullet));
  int os_idepth = xr_depth(os_r);
} chain (Fmt os_f, XmlR os_r, int os_iev) {
  int os_icur = 0 - 1;
  int os_ie = 0;
  if(os_iev == 1) {
    os_ie = xr_next(os_r);
  }
} chain (Fmt os_f, XmlR os_r, int os_iev) {
  int os_imore = xr_inside(os_r, os_ie, os_idepth);
  while(os_imore == 1) {
    os_icur = ost_lvl_event(os_llv, os_r, os_ie, os_icur);
    os_ie = xr_next(os_r);
    os_imore = xr_inside(os_r, os_ie, os_idepth);
  }
  ost_list_add(os_f, os_sname, os_llv);
} return void;
