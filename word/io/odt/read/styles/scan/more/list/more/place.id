// The level a style:list-level-style-* element describes as 0 to 2, or -1 for a level the model does not keep (it keeps three).
ost_level_of(XmlR os_r) {
  int os_ilevel = to_int(xr_attr(os_r, "text:level")) - 1;
  if(os_ilevel < 0 || os_ilevel > 2) {
    os_ilevel = 0 - 1;
  }
} return int os_ilevel;
