// Appends a record's eight strings and an empty row of each kind.
ost_bag_push(StyBag os_b, string[] os_lrec) {
  lst_str_extend(os_b.strings, os_lrec);
  push(os_b.crows, lst_copy((import ost_cdef)));
  push(os_b.prows, lst_copy((import ost_pdef)));
} return void;
