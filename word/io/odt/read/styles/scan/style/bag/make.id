// An empty bag.
ost_bag_new() {
  string[] os_lss = [];
  int[][] os_lcr = [];
  int[][] os_lpr = [];
} chain () {
  StyBag os_b = StyBag(os_lss, os_lcr, os_lpr);
} return StyBag os_b;
