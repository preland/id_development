// Reads a whole styles or content document into the bag: every style:style (named, or automatic inside office:automatic-styles) and the default paragraph style, up to the body.
ost_scan(StyBag os_b, XmlR os_r) {
  int os_iev = xr_next(os_r);
  int os_iauto = 0;
  while(os_iev > 0 && os_iauto >= 0) {
    os_iauto = ost_scan_one(os_b, os_r, os_iev, os_iauto);
    os_iev = xr_next(os_r);
  }
} return void;
