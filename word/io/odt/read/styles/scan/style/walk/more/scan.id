// What one event of a styles document changes: whether the reader is inside office:automatic-styles (1 or 0, -1 once the body has begun and nothing more is wanted), and a record when the event starts a style:style or the default paragraph style.
ost_scan_one(StyBag os_b, XmlR os_r, int os_iev, int os_iauto) {
  string os_sname = xr_get(os_r, (import xr_k_name));
  int os_inext = os_iauto;
  string os_skind = ost_kind(os_iauto);
} chain (StyBag os_b, XmlR os_r, int os_iev, int os_iauto) {
  if(os_sname == "style:style") {
    ost_rec_read(os_b, os_r, os_iev, os_skind);
  }
  if(os_sname == "office:automatic-styles") {
    os_inext = os_iev == 1;
  }
  if(os_sname == "office:body") {
    os_inext = 0 - 1;
  }
} chain (StyBag os_b, XmlR os_r, int os_iev, int os_iauto) {
  if(os_sname == "style:default-style" && xr_attr(os_r, "style:family") == "paragraph") {
    ost_rec_read(os_b, os_r, os_iev, "d");
  }
} return int os_inext;
