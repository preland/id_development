// Adds the three files this writer makes besides the manifest: content.xml as the caller built it, then styles.xml and meta.xml, all stored.
odp_core(ZipW pkz, Doc pkd, int[] pkc) {
  zw_add(pkz, "content.xml", pkc, 0);
  XmlW pkw = odp_doc();
  odp_styles(pkw, pkd);
} chain (ZipW pkz, Doc pkd, int[] pkc) {
  odp_put(pkz, "styles.xml", pkw);
  pkw = odp_doc();
  odp_meta(pkw, (import odp_generator));
} chain (ZipW pkz, Doc pkd, int[] pkc) {
  odp_put(pkz, "meta.xml", pkw);
} return void;
