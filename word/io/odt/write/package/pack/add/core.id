// Adds a finished XML part as a stored entry; when the writer holds no document, because an element was left open, the archive records the failure instead.
odp_put(ZipW pkz, string pkname, XmlW pkw) {
  int[] pkby = xw_done(pkw);
  if(len(pkby) > 0) {
    zw_add(pkz, pkname, pkby, 0);
  }
  if(len(pkby) == 0) {
    odp_fail(pkz, pkname, xw_error(pkw));
  }
} return void;
