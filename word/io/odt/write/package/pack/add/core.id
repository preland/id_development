// Records that a part could not be written on the archive itself, as a refused entry would be, so that zw_ok is 0 and zw_finish gives []; the first failure is kept.
odp_fail(ZipW pkz, string pkname, string pkwhy) {
  string[] pkerr = pkz.names;
  if(len(pkerr[0]) == 0) {
    pkerr[0] = "odt: " + pkname + " could not be written (" + pkwhy + "); this is a fault in the ODT writer, so report it with the document that caused it";
  }
} return void;
given odp_t_new ((import odp_t_z), "a.xml", "why"):() then (import odp_t_z).names:(["odt: a.xml could not be written (why); this is a fault in the ODT writer, so report it with the document that caused it"])
