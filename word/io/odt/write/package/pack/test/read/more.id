// Test fixture (internal): how many entries of the exported archive its own manifest leaves out.
odp_t_listed() {
  Zip pkzr = zr_open(zw_finish((import odp_t_z)));
  int pkat = zr_find(pkzr, "META-INF/manifest.xml");
  string pkmf = exec_text(zr_read(pkzr, pkat));
} chain () {
  int pkn = odp_t_unlisted(pkzr, pkmf);
} return int pkn;
