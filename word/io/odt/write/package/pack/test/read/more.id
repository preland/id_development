// Test fixture (internal): 1 when entry pki of the archive is one the manifest should list and its text has no manifest:full-path for it, otherwise 0.
odp_t_miss(Zip pkzr, int pki, string pkmf) {
  string pknm = zr_name(pkzr, pki);
  int pkq = 0;
  if(pknm != "mimetype" && pknm != "META-INF/manifest.xml" && str_find(pkmf, "manifest:full-path=\"" + pknm + "\"") < 0) {
    pkq = 1;
  }
} return int pkq;
