// Test fixture (internal): a path for a scratch file, from fs_mktemp so that two builds never share it; the file exists and is empty.
odw_t_path() {
  export string odw_tp = fs_mktemp("odw_odt_", 0);
} return void;
():() then odw_t_gone:(0)
():() then odw_t_bytes:([])

// Test fixture (internal): removes the scratch file; 0 when it was there.
odw_t_gone() {
  int pkq = fs_remove((import odw_tp));
} return int pkq;
given odw_t_path ():(0)
given odw_t_path given odw_t_put ():(0)

// Test fixture (internal): the bytes of the scratch file, one per cell; [] when it is missing or empty.
odw_t_bytes() {
  int pkn = fs_size((import odw_tp));
  int pkfh = fs_open((import odw_tp), "r");
  int[] pkby = [];
} chain () {
  if(pkn > 0 && pkfh >= 0) {
    lst_fill(pkby, pkn, 0);
    pkn = fs_read(pkfh, pkby, pkn);
  }
  pkn = fs_close(pkfh);
} return int[] pkby;
given odw_t_path given odw_t_put ():([97])
given odw_t_path ():([])
