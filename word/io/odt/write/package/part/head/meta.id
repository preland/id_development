// The text of meta.xml: the document-meta root and the name of the program that wrote the file.
odp_meta(XmlW pkw, string pkgen) {
  odp_root(pkw, "office:document-meta");
  xw_start(pkw, "office:meta");
  odp_gen(pkw, pkgen);
} chain (XmlW pkw, string pkgen) {
  xw_end(pkw);
  xw_end(pkw);
} return void;
given odp_t_new ((import odp_t_w), "word"):() then odp_t_ends:("<r><office:document-meta xmlns:office=\"u|\" office:version=\"1.3\"><office:meta><meta:generator>word</meta:generator></office:meta></office:document-meta>|1857")
given odp_t_new ((import odp_t_w), "a&b"):() then odp_t_ends:("<r><office:document-meta xmlns:office=\"u|ffice:version=\"1.3\"><office:meta><meta:generator>a&amp;b</meta:generator></office:meta></office:document-meta>|1860")

// The meta:generator element naming the program that wrote the file.
odp_gen(XmlW pkw, string pkgen) {
  xw_start(pkw, "meta:generator");
  xw_text(pkw, pkgen);
  xw_end(pkw);
} return void;
given odp_t_new ((import odp_t_w), "word"):() then (import odp_t_w).out:([60, 114, 62, 60, 109, 101, 116, 97, 58, 103, 101, 110, 101, 114, 97, 116, 111, 114, 62, 119, 111, 114, 100, 60, 47, 109, 101, 116, 97, 58, 103, 101, 110, 101, 114, 97, 116, 111, 114, 62])
given odp_t_new ((import odp_t_w), "a<b"):() then (import odp_t_w).out:([60, 114, 62, 60, 109, 101, 116, 97, 58, 103, 101, 110, 101, 114, 97, 116, 111, 114, 62, 97, 38, 108, 116, 59, 98, 60, 47, 109, 101, 116, 97, 58, 103, 101, 110, 101, 114, 97, 116, 111, 114, 62])

// Test fixture (internal): odp_t_cut of what has been written to the exported writer so far.
odp_t_ends() {
  XmlW pkw = (import odp_t_w);
  string pkr = exec_text(pkw.out);
  string pkend = odp_t_cut(pkr);
} return string pkend;
given odp_t_new ():("<r")
given odp_t_new given xw_attr((import odp_t_w), "a", "b") ():("<r a=\"b\"")
