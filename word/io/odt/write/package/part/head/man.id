// One file-entry for each name, with the media type at the same position.
odp_entries(XmlW pkw, string[] pknames, string[] pktypes) {
  int pki = 0;
  while(pki < len(pknames)) {
    odp_entry(pkw, pknames[pki], pktypes[pki], "");
    pki = pki + 1;
  }
} return void;
