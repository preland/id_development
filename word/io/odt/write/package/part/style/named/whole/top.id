// The text of styles.xml: the font declarations, the named styles, the page layout and the Standard master page.
odp_styles(XmlW pkw, Doc pkd) {
  odp_root(pkw, "office:document-styles");
  oc_faces(pkw, pkd);
  odp_ostyles(pkw, pkd);
} chain (XmlW pkw, Doc pkd) {
  odp_auto(pkw, pkd.body.page);
  odp_master(pkw);
  xw_end(pkw);
} return void;
