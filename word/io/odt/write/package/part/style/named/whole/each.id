// The office:styles element: the named styles. The list styles are in content.xml, which names them.
odp_ostyles(XmlW pkw, Doc pkd) {
  xw_start(pkw, "office:styles");
  odp_each(pkw, pkd);
  xw_end(pkw);
} return void;
