// Every named style of the document, in order.
odp_each(XmlW pkw, Doc pkd) {
  int pki = 0;
  while(pki < len(pkd.fmt.sty.styles)) {
    odp_style(pkw, pkd, pki);
    pki = pki + 1;
  }
} return void;
