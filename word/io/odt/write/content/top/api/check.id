// What is wrong with paragraph i for writing, as a message that names the fix, or "" when nothing is.
oc_check_para(Doc oc_d, int oc_i) {
  string oc_why = "";
  int oc_at = oc_bad_cp(oc_d.body.paras[oc_i].txt, oc_d.ext);
  int oc_bb = oc_bad_block(oc_d, oc_i);
} chain (Doc oc_d, int oc_i) {
  if(oc_bb == 1) {
    oc_why = "paragraph " + oc_i + " is an opaque block (kind 1) whose first code point names no verbatim part; make that code point word_o_marker plus the index of a Part of kind 0 in ext.parts, or make the paragraph a text paragraph";
  } else if(oc_at >= 0) {
    oc_why = "paragraph " + oc_i + " has an object marker at offset " + oc_at + " that names no verbatim part; store the object's XML as a Part of kind 0 at index (code point - word_o_marker) of ext.parts, or remove the code point";
  }
} return string oc_why;
