// Whether the document can be written as content.xml: the message of the first paragraph that cannot be, or "" when all can. A document that fails must not be saved, since saving it would drop or garble a block.
odt_content_check(Doc oc_d) {
  string oc_why = "";
  int oc_i = 0;
  while(oc_i < len(oc_d.body.paras) && len(oc_why) == 0) {
    oc_why = oc_check_para(oc_d, oc_i);
    oc_i = oc_i + 1;
  }
} return string oc_why;
