// The offset of the first code point of a text that stands for an object but names no verbatim part of the document, or -1.
oc_bad_cp(Text oc_tx, Ext oc_ex) {
  int oc_i = 0;
  int oc_at = 0 - 1;
  while(oc_i < len(oc_tx.cps) && oc_at < 0) {
    if(oc_tx.cps[oc_i] >= (import word_o_marker) && oc_part_ok(oc_ex, oc_tx.cps[oc_i] - (import word_o_marker)) == 0) {
      oc_at = oc_i;
    }
    oc_i = oc_i + 1;
  }
} return int oc_at;
