// The list style of definition i, written only when the definition has levels.
oc_lone(XmlW oc_w, Doc oc_d, int oc_i) {
  if(len(oc_d.fmt.sty.lists[oc_i].levels) > 0) {
    oc_lstyle(oc_w, oc_d, oc_i);
  }
} return void;
