// A list style for every definition that has levels; index 0 is the "no list" placeholder and is skipped.
oc_lists(XmlW oc_w, Doc oc_d) {
  int oc_i = 1;
  while(oc_i < len(oc_d.fmt.sty.lists)) {
    oc_lone(oc_w, oc_d, oc_i);
    oc_i = oc_i + 1;
  }
} return void;
