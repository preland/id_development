// The automatic list style L<li> of list definition li: its levels inside a text:list-style.
oc_lstyle(XmlW oc_w, Doc oc_d, int oc_li) {
  xw_start(oc_w, "text:list-style");
  xw_attr(oc_w, "style:name", "WL" + oc_li);
  oc_lvs(oc_w, oc_d.fmt.sty.lists[oc_li].levels);
} chain (XmlW oc_w, Doc oc_d, int oc_li) {
  xw_end(oc_w);
} return void;
