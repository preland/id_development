// The indentation of level k: the label sits at the left indent minus the hanging indent, the text at the left indent.
oc_lv_props(XmlW oc_w, int[] oc_lvl, int oc_k) {
  int oc_lf = oc_lvl[oc_k * (import word_l_stride) + (import word_l_left)];
  int oc_hg = oc_lvl[oc_k * (import word_l_stride) + (import word_l_hang)];
  int oc_ng = 0 - oc_hg;
} chain (XmlW oc_w, int[] oc_lvl, int oc_k) {
  xw_start(oc_w, "style:list-level-properties");
  xw_attr(oc_w, "text:list-level-position-and-space-mode", "label-alignment");
  xw_start(oc_w, "style:list-level-label-alignment");
} chain (XmlW oc_w, int[] oc_lvl, int oc_k) {
  xw_attr(oc_w, "text:label-followed-by", "listtab");
  oc_a_len(oc_w, "text:list-tab-stop-position", oc_lf);
  oc_a_len(oc_w, "fo:text-indent", oc_ng);
} chain (XmlW oc_w, int[] oc_lvl, int oc_k) {
  oc_a_len(oc_w, "fo:margin-left", oc_lf);
  xw_end(oc_w);
  xw_end(oc_w);
} return void;
