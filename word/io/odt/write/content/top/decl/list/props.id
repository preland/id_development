// Every level of a list definition, in order.
oc_lvs(XmlW oc_w, int[] oc_lvl) {
  int oc_k = 0;
  while(oc_k < len(oc_lvl) / (import word_l_stride)) {
    oc_lvone(oc_w, oc_lvl, oc_k);
    oc_k = oc_k + 1;
  }
} return void;
