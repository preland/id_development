// The numbering attributes of a numbered level: the suffix, the format (decimal, letters or roman numerals) and, unless it is 1, the number to start from.
oc_lv_num(XmlW oc_w, int oc_ft, int oc_sv) {
  xw_attr(oc_w, "style:num-suffix", ".");
  xw_attr(oc_w, "style:num-format", (import odt_num_format)[oc_ft]);
  if(oc_sv != 1) {
    xw_attr(oc_w, "text:start-value", "" + oc_sv);
  }
} return void;
given oc_t_w(0) ((import oc_fw), 0, 1):() then (import oc_fw).out:([60, 114, 32, 115, 116, 121, 108, 101, 58, 110, 117, 109, 45, 115, 117, 102, 102, 105, 120, 61, 34, 46, 34, 32, 115, 116, 121, 108, 101, 58, 110, 117, 109, 45, 102, 111, 114, 109, 97, 116, 61, 34, 49, 34])
given oc_t_w(0) ((import oc_fw), 3, 4):() then (import oc_fw).out:([60, 114, 32, 115, 116, 121, 108, 101, 58, 110, 117, 109, 45, 115, 117, 102, 102, 105, 120, 61, 34, 46, 34, 32, 115, 116, 121, 108, 101, 58, 110, 117, 109, 45, 102, 111, 114, 109, 97, 116, 61, 34, 105, 34, 32, 116, 101, 120, 116, 58, 115, 116, 97, 114, 116, 45, 118, 97, 108, 117, 101, 61, 34, 52, 34])

// Opens the level style of level k: a bullet with its character, or a number with its format and start.
oc_lv_open(XmlW oc_w, int[] oc_lvl, int oc_k) {
  int oc_kd = oc_lvl[oc_k * (import word_l_stride) + (import word_l_kind)];
  int oc_ft = oc_lvl[oc_k * (import word_l_stride) + (import word_l_fmt)];
  xw_start(oc_w, (import odt_lv_el)[oc_kd]);
} chain (XmlW oc_w, int[] oc_lvl, int oc_k) {
  xw_attr(oc_w, "text:level", "" + (oc_k + 1));
  if(oc_kd == 0) {
    xw_attr(oc_w, "text:bullet-char", utf8_str(oc_ft));
  } else {
    oc_lv_num(oc_w, oc_ft, oc_lvl[oc_k * (import word_l_stride) + (import word_l_start)]);
  }
} return void;
