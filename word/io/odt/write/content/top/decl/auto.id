// The office:automatic-styles element: the paragraph and character styles the rows in use call for, the list styles and the verbatim styles of preserved blocks.
oc_asty(XmlW oc_w, Doc oc_d) {
  xw_start(oc_w, "office:automatic-styles");
  oc_autos(oc_w, oc_d);
  oc_lists(oc_w, oc_d);
} chain (XmlW oc_w, Doc oc_d) {
  oc_aparts(oc_w, oc_d);
  xw_end(oc_w);
} return void;
