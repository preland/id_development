// The whole content.xml element tree: declaration, document element with its namespaces, font declarations, automatic styles and body.
oc_root(XmlW oc_w, Doc oc_d) {
  xw_decl(oc_w);
  xw_start(oc_w, "office:document-content");
  oc_ns(oc_w);
} chain (XmlW oc_w, Doc oc_d) {
  xw_attr(oc_w, "office:version", "1.3");
  oc_faces(oc_w, oc_d);
  oc_asty(oc_w, oc_d);
} chain (XmlW oc_w, Doc oc_d) {
  oc_obody(oc_w, oc_d);
  xw_end(oc_w);
} return void;
