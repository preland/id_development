// The namespace declarations of the document element, every prefix the file and the verbatim blocks in it may use.
oc_ns(XmlW oc_w) {
  int oc_i = 0;
  while(oc_i < len((import odt_ns_name))) {
    xw_attr(oc_w, "xmlns:" + (import odt_ns_name)[oc_i], (import odt_ns_uri)[oc_i]);
    oc_i = oc_i + 1;
  }
} return void;
