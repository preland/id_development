// Every paragraph in order, then whatever lists are still open.
oc_body(XmlW oc_w, Doc oc_d) {
  int[] oc_ls = [0, 0];
  int oc_i = 0;
  while(oc_i < len(oc_d.body.paras)) {
    oc_item(oc_w, oc_d, oc_i, oc_ls);
    oc_i = oc_i + 1;
  }
} chain (XmlW oc_w, Doc oc_d) {
  oc_close_to(oc_w, oc_ls, 0);
