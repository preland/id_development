// The office:body element with its office:text and the paragraphs in it.
oc_obody(XmlW oc_w, Doc oc_d) {
  xw_start(oc_w, "office:body");
  xw_start(oc_w, "office:text");
  oc_body(oc_w, oc_d);
} chain (XmlW oc_w, Doc oc_d) {
  xw_end(oc_w);
  xw_end(oc_w);
} return void;
