// The outline level of a heading style, 0 for any other style: the number after "Heading_20_" in its file name.
oc_level(Doc oc_d, int oc_sid) {
  string oc_wr = oc_wire(oc_d, oc_sid);
  int oc_lv = 0;
  if(str_starts(oc_wr, "Heading_20_") == 1) {
    string oc_dg = str_slice(oc_wr, 11, len(oc_wr) - 11);
    oc_lv = to_int(oc_dg);
  }
} return int oc_lv;
