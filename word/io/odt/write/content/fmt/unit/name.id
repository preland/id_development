// The style-name a paragraph's element carries: its automatic style P<row> when the row sets paragraph properties, else its named style, else nothing.
oc_pname(Doc oc_d, int oc_pid) {
  string oc_nm = "";
  int oc_pl = oc_plain_p(oc_d.fmt.paras, oc_pid);
  int oc_sid = tab_get(oc_d.fmt.paras, oc_pid, (import word_p_style));
} chain (Doc oc_d, int oc_pid) {
  if(oc_pl == 0) {
    oc_nm = "WP" + oc_pid;
  } else if(oc_sid > 0) {
    oc_nm = oc_wire(oc_d, oc_sid);
  }
} return string oc_nm;
