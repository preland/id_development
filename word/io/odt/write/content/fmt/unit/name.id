// The name a style has in the file: the ODT name of a built-in style ("Standard" for Normal), otherwise its name with each space written as _20_ as ODF does.
oc_wire(Doc oc_d, int oc_sid) {
  string oc_nm = oc_d.fmt.sty.styles[oc_sid].name;
  string[] oc_parts = str_split(oc_nm, " ");
  string oc_wr = str_join(oc_parts, "_20_");
} chain (Doc oc_d, int oc_sid) {
  int oc_k = lst_str_index((import word_style_names), oc_nm);
  if(oc_k >= 0) {
    oc_wr = (import word_style_wire)[oc_k];
  }
} return string oc_wr;
