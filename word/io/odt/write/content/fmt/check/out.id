// Test fixture: a writer kept in oc_fw, empty when k is negative, else with the root r open and then k more: 1 opens a child p, k above 1 opens k - 1 nested text:list and text:list-item pairs.
oc_t_w(int oc_k) {
  export XmlW oc_fw = xw_new();
  if(oc_k >= 0) {
    xw_start(oc_fw, "r");
    oc_t_nest(oc_fw, oc_k);
  }
} return void;
(0):() then oc_t_out:("<r")
(-1):() then oc_t_out:("")
(3):() then oc_t_out:("<r><text:list><text:list-item><text:list><text:list-item")

// Test fixture: opens what oc_t_w describes for k below the root.
oc_t_nest(XmlW oc_w, int oc_k) {
  if(oc_k == 1) {
    xw_start(oc_w, "p");
  }
  while(oc_k > 1) {
    xw_start(oc_w, "text:list");
    xw_start(oc_w, "text:list-item");
    oc_k = oc_k - 1;
  }
} return void;
given oc_t_w(0) ((import oc_fw), 2):() then oc_t_out:("<r><text:list><text:list-item")
given oc_t_w(0) ((import oc_fw), 1):() then oc_t_out:("<r><p")

// Test fixture: everything oc_fw has written so far.
oc_t_out() {
  int[] oc_bs = (import oc_fw).out;
  string oc_s = exec_text(oc_bs);
} return string oc_s;
given oc_t_w(0) ():("<r")
given oc_t_w(1) ():("<r><p")
