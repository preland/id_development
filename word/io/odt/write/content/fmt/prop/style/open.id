// The automatic style T<cid> of character row cid: its character style as the parent, then the row's text properties.
oc_cstyle(XmlW oc_w, Doc oc_d, int oc_cid) {
  int oc_sid = tab_get(oc_d.fmt.chars, oc_cid, (import word_c_style));
  string oc_par = "";
  if(oc_sid > 0) {
    oc_par = oc_wire(oc_d, oc_sid);
  }
} chain (XmlW oc_w, Doc oc_d, int oc_cid) {
  oc_style(oc_w, "WT" + oc_cid, "text", oc_par);
  oc_cprops(oc_w, oc_d, oc_cid);
  xw_end(oc_w);
} return void;
