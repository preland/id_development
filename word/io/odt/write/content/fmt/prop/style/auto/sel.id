// The automatic style of paragraph row i, written when the row is marked used and sets something.
oc_pauto(XmlW oc_w, Doc oc_d, int[] oc_pm, int oc_i) {
  int oc_pl = oc_plain_p(oc_d.fmt.paras, oc_i);
  if(oc_pm[oc_i] == 1 && oc_pl == 0) {
    oc_pstyle(oc_w, oc_d, oc_i);
  }
} return void;
