// Marks every paragraph row and character row the document uses.
oc_marks(Doc oc_d, int[] oc_pm, int[] oc_cm) {
  int oc_i = 0;
  while(oc_i < len(oc_d.body.paras)) {
    oc_mark_para(oc_d.body.paras[oc_i], oc_pm, oc_cm);
    oc_i = oc_i + 1;
  }
} return void;
