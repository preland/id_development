// The automatic style of character row i, written when the row is marked used and sets something.
oc_cauto(XmlW oc_w, Doc oc_d, int[] oc_cm, int oc_i) {
  int oc_pl = oc_plain_c(oc_d.fmt.chars, oc_i);
  if(oc_cm[oc_i] == 1 && oc_pl == 0) {
    oc_cstyle(oc_w, oc_d, oc_i);
  }
} return void;
