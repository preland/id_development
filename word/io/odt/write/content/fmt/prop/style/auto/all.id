// The automatic style of every marked character row.
oc_call(XmlW oc_w, Doc oc_d, int[] oc_cm) {
  int oc_i = 0;
  while(oc_i < len(oc_cm)) {
    oc_cauto(oc_w, oc_d, oc_cm, oc_i);
    oc_i = oc_i + 1;
  }
} return void;
