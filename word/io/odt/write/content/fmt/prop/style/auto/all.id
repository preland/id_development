// The automatic style of every marked paragraph row.
oc_pall(XmlW oc_w, Doc oc_d, int[] oc_pm) {
  int oc_i = 0;
  while(oc_i < len(oc_pm)) {
    oc_pauto(oc_w, oc_d, oc_pm, oc_i);
    oc_i = oc_i + 1;
  }
} return void;
