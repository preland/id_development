// The automatic styles of a document: one P<n> per paragraph row and one T<n> per character row that some paragraph or run uses and that sets something.
oc_autos(XmlW oc_w, Doc oc_d) {
  int[] oc_pm = oc_zeros(oc_d.fmt.paras);
  int[] oc_cm = oc_zeros(oc_d.fmt.chars);
  oc_marks(oc_d, oc_pm, oc_cm);
} chain (XmlW oc_w, Doc oc_d) {
  oc_pall(oc_w, oc_d, oc_pm);
  oc_call(oc_w, oc_d, oc_cm);
} return void;
