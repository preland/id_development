// The font size attribute, written only when the size is set.
oc_a_size(XmlW oc_w, int oc_h) {
  if(oc_h != -1) {
    string oc_v = oc_pt(oc_h);
    xw_attr(oc_w, "fo:font-size", oc_v);
  }
} return void;
