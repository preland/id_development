// The style:paragraph-properties element of paragraph row pid: alignment, indents, spacing, line height and page break.
oc_pprops(XmlW oc_w, Doc oc_d, int oc_pid) {
  int[] oc_rw = tab_row(oc_d.fmt.paras, oc_pid);
  xw_start(oc_w, "style:paragraph-properties");
  oc_a_align(oc_w, oc_rw[(import word_p_align)]);
} chain (XmlW oc_w, Doc oc_d, int oc_pid) {
  oc_a_len(oc_w, "fo:margin-left", oc_rw[(import word_p_left)]);
  oc_a_len(oc_w, "fo:margin-right", oc_rw[(import word_p_right)]);
  oc_a_len(oc_w, "fo:text-indent", oc_rw[(import word_p_first)]);
} chain (XmlW oc_w, Doc oc_d, int oc_pid) {
  oc_a_len(oc_w, "fo:margin-top", oc_rw[(import word_p_before)]);
  oc_a_len(oc_w, "fo:margin-bottom", oc_rw[(import word_p_after)]);
  oc_a_line(oc_w, oc_rw[(import word_p_line)]);
} chain (XmlW oc_w, Doc oc_d, int oc_pid) {
  oc_a_brk(oc_w, oc_rw[(import word_p_brk)]);
  xw_end(oc_w);
} return void;
