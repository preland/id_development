// Writes the next piece of text starting at i, either the plain stretch up to the next special code point or that one code point, and answers where the next piece starts.
oc_chunk(XmlW oc_w, Text oc_tx, Ext oc_ex, int oc_i, int oc_hi) {
  int oc_j = oc_plain_end(oc_tx.cps, oc_i, oc_hi);
  if(oc_j > oc_i) {
    xw_text(oc_w, text_str(oc_tx, oc_i, oc_j));
  } else {
    oc_j = oc_special(oc_w, oc_tx.cps, oc_ex, oc_i, oc_hi);
  }
} return int oc_j;
