// The first index from i, before hi, that is not plain text; hi when everything up to it is.
oc_plain_end(int[] oc_cps, int oc_i, int oc_hi) {
  while(oc_i < oc_hi && oc_cls(oc_cps, oc_i) < 2) {
    oc_i = oc_i + 1;
  }
} return int oc_i;
