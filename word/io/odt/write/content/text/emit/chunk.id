// The code points lo up to hi of a text as XML content: plain stretches as text, the rest as text:s, text:tab, text:line-break or an inline object.
oc_text(XmlW oc_w, Text oc_tx, Ext oc_ex, int oc_lo, int oc_hi) {
  while(oc_lo < oc_hi) {
    oc_lo = oc_chunk(oc_w, oc_tx, oc_ex, oc_lo, oc_hi);
  }
} return void;
