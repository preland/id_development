// The target of hyperlink idx, or nothing for an index that names no link.
oc_href(Ext oc_ex, int oc_ix) {
  string oc_hr = "";
  if(oc_ix >= 0 && oc_ix < len(oc_ex.links)) {
    oc_hr = oc_ex.links[oc_ix];
  }
} return string oc_hr;
(Ext([], ["x", "y"], []), 1):("y")
(Ext([], ["x", "y"], []), 2):("")
(Ext([], ["x", "y"], []), -1):("")

// Opens a text:a for hyperlink idx.
oc_a_open(XmlW oc_w, Doc oc_d, int oc_ix) {
  xw_start(oc_w, "text:a");
  xw_attr(oc_w, "xlink:type", "simple");
  xw_attr(oc_w, "xlink:href", oc_href(oc_d.ext, oc_ix));
} return void;
