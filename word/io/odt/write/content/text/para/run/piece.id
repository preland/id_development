// Writes the run at offset off as the hyperlink state in st says (st[0] is the offset of the next run, st[1] the hyperlink open now), then moves the state on.
oc_piece(XmlW oc_w, Doc oc_d, Text oc_tx, Run oc_ru, int[] oc_st) {
  oc_st[1] = oc_link(oc_w, oc_d, oc_st[1], oc_ru.link);
  oc_run(oc_w, oc_d, oc_tx, oc_st[0], oc_ru);
  oc_st[0] = oc_st[0] + oc_ru.len;
} return void;
