// An opaque paragraph: the verbatim XML of the part its first code point names.
oc_block(XmlW oc_w, Doc oc_d, int oc_i) {
  int oc_ix = oc_first(oc_d, oc_i);
  oc_raw(oc_w, oc_d.ext, oc_ix);
} return void;
