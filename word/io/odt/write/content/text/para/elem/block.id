// The index into ext.parts that paragraph i's first code point names, or -1 when it has none.
oc_first(Doc oc_d, int oc_i) {
  int[] oc_cps = oc_d.body.paras[oc_i].txt.cps;
  int oc_ix = 0 - 1;
  if(len(oc_cps) > 0) {
    oc_ix = oc_cps[0] - (import word_o_marker);
  }
} return int oc_ix;
