// 1 when paragraph i is an opaque block (kind 1) whose first code point does not name a verbatim part, so writing it would drop the block.
oc_bad_block(Doc oc_d, int oc_i) {
  int oc_bad = 0;
  int oc_kd = oc_pcell(oc_d, oc_i, (import word_p_kind));
  int oc_ok = oc_part_ok(oc_d.ext, oc_first(oc_d, oc_i));
} chain (Doc oc_d, int oc_i) {
  oc_bad = (oc_kd == 1) * (1 - oc_ok);
} return int oc_bad;
