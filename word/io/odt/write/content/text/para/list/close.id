// Ends list items and their lists, innermost first, until only to levels are open; ls[0] counts the open levels.
oc_close_to(XmlW oc_w, int[] oc_ls, int oc_to) {
  while(oc_ls[0] > oc_to) {
    xw_end(oc_w);
    xw_end(oc_w);
    oc_ls[0] = oc_ls[0] - 1;
  }
} return void;
