// One row of the surface as the bytes of a binary PPM: red, green and blue of each pixel, left to right.
cli_row(int wai_y) {
  int[] wal_r = [];
  int wai_x = 0;
  while(wai_x < (import sf_l_w)) {
    int wai_c = (import sf_l_px)[sf_l_idx(wai_x, wai_y)];
    lst_extend(wal_r, [wai_c / 65536 % 256, wai_c / 256 % 256, wai_c % 256]);
    wai_x = wai_x + 1;
  }
} return int[] wal_r;
