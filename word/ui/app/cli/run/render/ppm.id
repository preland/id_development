// Writes every row of the surface to the open file wai_h, top to bottom. Answers how many bytes did not get there, 0 when all did.
cli_rows(int wai_h) {
  int wai_y = 0;
  int wai_lost = 0;
  while(wai_y < (import sf_l_h)) {
    int[] wal_r = cli_row(wai_y);
    wai_lost = wai_lost + len(wal_r) - fs_write(wai_h, wal_r, len(wal_r));
    wai_y = wai_y + 1;
  }
} return int wai_lost;
