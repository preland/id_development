// Plays the lines wat_l of a script one after another (wa_play) on the application waa and prints what each of them printed.
cli_play(App waa, string[] wat_l) {
  int wai_k = 0;
  while(wai_k < len(wat_l)) {
    put(wa_play(waa, wat_l[wai_k]));
    wai_k = wai_k + 1;
  }
} return void;
given wa_t_app ((import wa_app), ["t", "Tx", "t"]):() then prints:("Untitled - Word\nUntitled* - Word\n")
given wa_t_app ((import wa_app), []):() then prints:("")

// word --script FILE [IN.odt [OUT.odt]]: replays the script FILE (cli_play) on a document, which is IN.odt when given and a new one otherwise, in an application that has no window, and saves the document to OUT.odt when given. A script is one line per event; see wa_play for the verbs. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_script(string was_file, string was_in, string was_out) {
  int wai_have = fs_exists(was_file);
  string was_text = "";
  int wai_rc = wai_have == 0;
} chain (string was_file, string was_in, string was_out) {
  if(wai_have == 1) {
    was_text = fs_read_text(was_file);
  }
  App waa = app_new();
  int wai_c = 0;
} chain (string was_file, string was_in, string was_out) {
  if(len(was_in) > 0) {
    wai_c = app_open(waa, was_in);
  }
  if(wai_have == 1 && wai_c == 0) {
    cli_play(waa, str_split(was_text, "\n"));
  }
  if(wai_have == 1 && wai_c == 0 && len(was_out) > 0) {
    wai_c = app_save(waa, was_out);
  }
} chain (string was_file, string was_in, string was_out) {
  if(wai_have == 0) {
    eprint("script: the file could not be read; check that the path exists and that you may read it [" + was_file + "]");
  }
  if(wai_c != 0) {
    eprint(odt_error(wai_c));
    wai_rc = 1;
  }
} return int wai_rc;
