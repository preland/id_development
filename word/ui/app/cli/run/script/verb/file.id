// Saves the document to the file at the path for a script (app_save); with no path it saves where the document is, or shows the Save As picker. Answers why the file could not be written, and a line feed, or "" when it was.
wa_store(App waa, string was_path) {
  string was_o = "";
  int wai_c = 0;
  if(len(was_path) == 0) {
    cmd_run(waa, (import cmd_save));
  }
} chain (App waa, string was_path) {
  if(len(was_path) > 0) {
    wai_c = app_save(waa, was_path);
  }
  if(wai_c != 0) {
    was_o = odt_error(wai_c) + "\n";
  }
} return string was_o;
