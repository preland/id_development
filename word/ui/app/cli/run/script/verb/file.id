// Opens the file at the path for a script, as a user's Open does (wa_took); with no path it shows the Open picker. Answers why the file could not be read, and a line feed, or "" when it was.
wa_load(App waa, string was_path) {
  string was_o = "";
  int wai_c = 0;
  if(len(was_path) == 0) {
    cmd_run(waa, (import cmd_open));
  }
} chain (App waa, string was_path) {
  if(len(was_path) > 0) {
    wai_c = app_open(waa, was_path);
  }
  if(wai_c != 0) {
    was_o = odt_error(wai_c) + "\n";
  }
} return string was_o;
