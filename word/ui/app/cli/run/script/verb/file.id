// Asks the window to close, as its close button does, and answers what came of it: "close" and a line feed when the app is closing, else the name of the dialog that opened (unsaved) and a line feed.
wa_leave(App waa) {
  int[] wal_e = [7, 0, 0, 0, 0];
  int wai_q = app_on(waa, 7, wal_e);
  string was_o = (import wa_d_names)[(import wa_st)[(import wa_s_dlg)]] + "\n";
} chain (App waa) {
  if(wai_q == 1) {
    was_o = "close\n";
  }
} return string was_o;
