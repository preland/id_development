// word --roundtrip IN.odt OUT.odt: loads the document and saves it again, so that a program can compare what came out with what went in. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_round(string inpath, string outpath) {
  Doc d = doc_new();
  int code = odt_load(inpath, d);
  int rc = code != 0;
} chain (string inpath, string outpath) {
  if(code == 0) {
    code = odt_save(outpath, d);
    rc = code != 0;
  }
  if(code != 0) {
    eprint(odt_error(code));
  }
} return int rc;
given orc_t_zip("<r><office:text><text:p>Hi</text:p></office:text></r>", "") given orc_t_save given odw_t_path ((import orc_tp), (import odw_tp)):(0) then cli_t_size:("size 12636") then odw_t_gone:("gone 0") then orc_t_gone:(0)
("/nonexistent/none.odt", "/nonexistent/out.odt"):(1) then eprints:("ODT: the file could not be read; check that the path exists and that you may read it [/nonexistent/none.odt]\n")

