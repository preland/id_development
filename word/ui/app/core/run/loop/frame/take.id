// The picture is made again, in a surface that the window changed the size of: everything that depends on the size is fitted, and the dialog that is open is put in the middle again.
wa_resize(App waa) {
  vw_fit_all(waa.ui.view);
  if((import wa_st)[(import wa_s_dlg)] != (import wa_d_none)) {
    wa_dlg_place();
  }
} return void;
