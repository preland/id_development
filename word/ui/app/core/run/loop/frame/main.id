// Opens the window (when wai_open is 1, so that a case can run everything else without one), starts the app on the file at the path (a new document when the path is empty; a file that cannot be read is told in a dialog and a new document stands), puts the title on the window and runs frames until the app closes. Answers 0.
app_main(string was_path, int wai_open) {
  int wai_ok = wai_open;
  if(wai_open == 1) {
    wai_ok = gfx_open((import wa_w), (import wa_h), (import wa_untitled));
  }
  App waa = app_new();
} chain (string was_path, int wai_open) {
  int wai_c = 0;
  if(len(was_path) > 0) {
    wai_c = app_open(waa, was_path);
  }
  if(wai_c != 0) {
    wa_oops(waa, wai_c);
  }
} chain (string was_path, int wai_open) {
  wa_note(waa);
  int wai_n = wa_loop(waa, wai_ok * wai_open, 0 - 1);
  int wai_s = gfx_close();
} return int 0;
