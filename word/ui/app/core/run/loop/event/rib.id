// An event for the ribbon first: a mouse event, the wheel or a key goes to it, the picture is stale when it asks to be painted again, its command is run (cmd_run_arg), and 1 is answered when the ribbon took the event, so that nothing else sees it (a press in its band, or any event while one of its menus is open).
wa_rib(App waa, int wai_kind, int[] wal_ev) {
  int wai_for = wai_kind == 1 || wai_kind == 2 || wai_kind == 3 || wai_kind == 4 || wai_kind == 5 || wai_kind == 8;
  int wai_b = 0;
  if(wai_for == 1) {
    wai_b = rib_event(waa.ui.rib, wai_kind, wal_ev);
  }
} chain (App waa, int wai_kind, int[] wal_ev) {
  if((wai_b & 1) != 0) {
    lset((import vw_st), (import vw_s_d), 1);
  }
  if((wai_b & 2) != 0) {
    cmd_run_arg(waa, rib_cmd(waa.ui.rib), rib_arg(waa.ui.rib));
  }
  int wai_took = (wai_b & 8) != 0;
} return int wai_took;
