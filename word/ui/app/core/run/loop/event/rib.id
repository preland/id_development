// What a key does: the command the key table has for it when it is one the app does itself and can do now (a Tab is a list command only in a list), else, for Page Up and Page Down, a screenful (wa_plain), else what the canvas does with it (zoom, caret movement, typing).
wa_key(App waa, int wai_key, int wai_mods) {
  int wai_cmd = key_cmd(wai_mods, wai_key);
  int wai_own = lst_index_of((import wa_own_cmd), wai_cmd) >= 0 && wa_gate(waa, wai_cmd) == 0;
  if(wai_own == 1) {
    cmd_run(waa, wai_cmd);
  }
} chain (App waa, int wai_key, int wai_mods) {
  if(wai_own == 0) {
    wa_plain(waa, wai_key, wai_mods);
  }
} return void;
