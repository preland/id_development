// The zoom the command wai_cmd asks for when the zoom is wai_z now: a step in or out, 100, or fit to the width; any other command asks for the zoom it has.
wa_scale(App waa, int wai_cmd, int wai_z) {
  int wai_n = wai_z;
  if(wai_cmd == (import cmd_zoom_in)) {
    wai_n = wai_z + (import vw_zoom_step);
  }
  if(wai_cmd == (import cmd_zoom_out)) {
    wai_n = wai_z - (import vw_zoom_step);
  }
} chain (App waa, int wai_cmd, int wai_z) {
