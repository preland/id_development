// The zoom that makes the page fit the width of the page area, in percent: the page area's width over the sheet and a gap on each side, all at 100 percent. The least and the most the viewer allows are its business (vw_zoom).
wa_fit(App waa) {
  int wai_w = vw_px(lay_sheet(waa.doc, 0), 100);
  int wai_g = vw_px((import word_lay_gap), 100);
  int wai_z = vw_box("canvas", 2) * 100 / (wai_w + 2 * wai_g);
} return int wai_z;
