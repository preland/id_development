// The zoom commands: zoom in, zoom out, 100 percent and fit to the width set the viewer's zoom, which keeps the part of the document in view. Any other command is left alone.
wa_zoom(App waa, int wai_cmd) {
  int wai_z = (import vw_st)[(import vw_s_z)];
  int wai_n = wa_scale(waa, wai_cmd, wai_z);
  if(wai_n != wai_z) {
    vw_zoom(waa.ui.view, wai_n, vw_box("canvas", 3));
  }
} return void;
