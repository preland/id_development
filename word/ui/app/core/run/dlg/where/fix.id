// Test check: 1 when the open dialog is in the middle of the window, to a pixel in each direction.
wa_t_mid() {
  int[] wal_r = (import wa_dg).rects;
  int wai_x = fx_abs((import sf_l_w) - 2 * wal_r[0] - wal_r[2]) <= 1;
  int wai_y = fx_abs((import sf_l_h) - 2 * wal_r[1] - wal_r[3]) <= 1;
} chain () {
  int wai_m = wai_x == 1 && wai_y == 1;
} return int wai_m;
given wa_t_app given wa_open("T", ["hi"], ["OK"], 4) ():(1)
given wa_t_app given wa_open("T", ["hi"], ["OK"], 4) given sf_l_init(800, 600) ():(0)
