// Does an action that may lose the document's changes, after asking about them: it waits as wai_act (wa_a_new, wa_a_open or wa_a_close) while the unsaved-changes dialog is open, and happens at once when nothing is unsaved.
wa_ask(App waa, int wai_act) {
  wa_dirty(waa);
  lset((import wa_st), (import wa_s_ask), wai_act);
  if(waa.ui.shell.dirty == 1) {
    wa_confirm(waa);
  }
} chain (App waa, int wai_act) {
  if(waa.ui.shell.dirty == 0) {
    wa_go(waa);
  }
} return void;
