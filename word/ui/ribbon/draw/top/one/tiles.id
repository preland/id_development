// Writes style number rbi_k of the gallery's preview in its own face (bold for a heading, italic for the subtitle) on the line rbi_k of the gallery at rbl_box, in colour rbi_col.
rbd_tile(int[] rbl_box, int rbi_k, int rbi_col) {
  int rbi_f = rbd_ui_f((import rbd_style_f)[rbi_k]);
  string rbs_t = (import rbd_styles)[rbi_k];
  gui_text_draw(rbi_f, rbl_box[0] + 8, rbl_box[1] + 4 + rbi_k * 20, rbs_t, rbi_col);
} return void;
