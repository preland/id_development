// Paints the preview of the styles gallery in the field rbg: the first three styles, each in its own face, cut to the field and leaving room at the right for the sign of a menu.
rbd_tiles(GuiToggle rbg, int rbi_col) {
  int[] rbl_v = rbg.btn.v;
  int rbi_k = 0;
  sf_l_clip(rbl_v[0] + 1, rbl_v[1] + 1, rbl_v[2] - 16, rbl_v[3] - 2);
} chain (GuiToggle rbg, int rbi_col) {
  while(rbi_k < 3) {
    rbd_tile(rbl_v, rbi_k, rbi_col);
    rbi_k = rbi_k + 1;
  }
  sf_l_unclip();
} return void;
