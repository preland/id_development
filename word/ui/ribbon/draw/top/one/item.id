// Paints the control at index rbi_i of the ribbon rib whose widgets are rbl_ws: its body (a toggle shows its state), what is inside it, and the sign or the arrow strip outside it. A combo box paints itself (rbd_combos) and has nothing here.
rbd_item(Ribbon rib, GuiToggle[] rbl_ws, int rbi_i) {
  GuiToggle rbg = rbl_ws[rbi_i];
  int rbi_row = rib.items[rbi_i];
  int rbi_shape = rbd_shape(rbi_row);
} chain (Ribbon rib, GuiToggle[] rbl_ws, int rbi_i) {
  if(rbi_shape != 6) {
    gui_tgl_draw(rbg);
    rbd_inside(rbg, rbi_row, rbi_shape);
    rbd_outside(rib, rbi_i, rbi_row, rbi_shape);
  }
} return void;
