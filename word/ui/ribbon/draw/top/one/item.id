// Paints what a control shows outside its body: the sign of a menu or the arrow strip of the control at index rbi_i of the ribbon, and the bar of a colour button.
rbd_outside(Ribbon rib, int rbi_i, int rbi_row, int rbi_shape) {
  int[] rbl_r = rib.rects;
  int rbi_q = rbi_i * 4;
  int rbi_hot = rbd_hot(rbi_i);
} chain (Ribbon rib, int rbi_i, int rbi_row, int rbi_shape) {
  rbd_sign(rbl_r[rbi_q], rbl_r[rbi_q + 1], rbl_r[rbi_q + 2], rbl_r[rbi_q + 3], rbi_shape, rbi_hot);
  rbd_bar(rbl_r[rbi_q], rbl_r[rbi_q + 1], rbl_r[rbi_q + 2], rbl_r[rbi_q + 3], rbi_row);
} return void;
