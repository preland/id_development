// Paints what a control shows inside its body rbg of item row rbi_row and look rbi_shape: its icon and, for a large control, its name; or, for a field, its name at the left; or the preview of the gallery.
rbd_inside(GuiToggle rbg, int rbi_row, int rbi_shape) {
  int[] rbl_v = rbg.btn.v;
  int rbi_ink = rbd_ink(rbg);
  if(rbi_shape < 3) {
    rbd_icon(rbi_row, rbl_v[0], rbl_v[1], rbl_v[2], rbl_v[3], rbi_ink);
  }
} chain (GuiToggle rbg, int rbi_row, int rbi_shape) {
  if(rbi_shape == 3) {
    rbd_field(rbg, rbi_row, rbi_ink);
  }
  if(rbi_shape == 4) {
    rbd_tiles(rbg, rbi_ink);
  }
} return void;
