// The mark that goes with a letter icon of width rbi_w at x rbi_x over the baseline rbi_b, in colour rbi_col: a line under a U, a line through an S, nothing for any other letter.
rbd_marks(int rbi_cp, int rbi_x, int rbi_w, int rbi_b, int rbi_col) {
  if(rbi_cp == 85) {
    d2_l_rect(rbi_x, rbi_b + 2, rbi_w, 1, rbi_col);
  }
  if(rbi_cp == 83) {
    d2_l_rect(rbi_x, rbi_b - 4, rbi_w, 1, rbi_col);
  }
} return void;
