// Writes a letter icon: the code point rbi_cp centred on (rbi_cx, rbi_cy) in the ribbon's face in colour rbi_col, bold for a B and italic for an I, with a line under a U and through an S, as Word draws them. Anything that is not a printable ASCII letter draws nothing.
rbd_letter(int rbi_cp, int rbi_cx, int rbi_cy, int rbi_col) {
  int rbi_f = rbd_ui_f((rbi_cp == 66) + 2 * (rbi_cp == 73));
  int rbi_w = gui_cp_adv(rbi_f, rbi_cp, 0) / 64;
  int rbi_b = rbi_cy + (gui_font_ascent(rbi_f) - gui_font_descent(rbi_f)) / 2;
} chain (int rbi_cp, int rbi_cx, int rbi_cy, int rbi_col) {
  if(rbi_cp > 32 && rbi_cp < 127) {
    gui_cp_draw(rbi_f, (rbi_cx - rbi_w / 2) * 64, rbi_b, rbi_cp, rbi_col);
    rbd_marks(rbi_cp, rbi_cx - rbi_w / 2, rbi_w, rbi_b, rbi_col);
  }
} return void;
