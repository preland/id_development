// The faces the ribbon's own text is set in, as font handles kept in the export rbd_ui: regular, bold and italic.
rbd_ui_set(int rbi_r, int rbi_b, int rbi_i) {
  export int[] rbd_ui = [rbi_r, rbi_b, rbi_i];
} return void;
(3, 4, 5):() then rbd_t_ui0:(3)
(1, 2, -1):() then rbd_t_ui0:(1)

// The font handle of the ribbon's own text: 0 regular, 1 bold, 2 italic; -1 until rbd_ui_set has been called.
rbd_ui_f(int rbi_k) {
  int rbi_fh = (import rbd_ui)[rbi_k];
} return int rbi_fh;
given rbd_ui_set(5, 6, 7) (1):(6)
given rbd_ui_set(5, 6, 7) (2):(7)

// Test check: the regular face of the ribbon's own text.
rbd_t_ui0() {
  int rbi_fh = rbd_ui_f(0);
} return int rbi_fh;
given rbd_ui_set(8, 9, 10) ():(8)
given rbd_ui_set(2, 2, 2) ():(2)
