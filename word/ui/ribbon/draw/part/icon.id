// Writes the name of a large button (one rbi_big says is large) centred along its bottom in colour rbi_col, cut to the button when it is wider than it. A small button has no room for one.
rbd_big(int rbi_row, int rbi_x, int rbi_y, int rbi_w, int rbi_h, int rbi_big, int rbi_col) {
  string rbs_t = (import rb_label)[rbi_row];
  int rbi_f = rbd_ui_f(0);
  int rbi_tw = gui_text_width(rbi_f, rbs_t);
} chain (int rbi_row, int rbi_x, int rbi_y, int rbi_w, int rbi_h, int rbi_big, int rbi_col) {
  if(rbi_big == 1) {
    sf_l_clip(rbi_x + 1, rbi_y + 1, rbi_w - 2, rbi_h - 2);
    gui_text_draw(rbi_f, rbi_x + (rbi_w - rbi_tw) / 2, rbi_y + rbi_h - gui_font_line(rbi_f) - 3, rbs_t, rbi_col);
    sf_l_unclip();
  }
} return void;
