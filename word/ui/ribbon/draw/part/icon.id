// Paints the icon of item row rbi_row inside the button rectangle (rbi_x, rbi_y, rbi_w, rbi_h) in colour rbi_col: a vector icon where the ribbon has one for the command, 24 px high near the top of a large button and 16 px centred in a small one, else the letter the model names; a large button also carries its name at the bottom.
rbd_icon(int rbi_row, int rbi_x, int rbi_y, int rbi_w, int rbi_h, int rbi_col) {
  int rbi_ic = (import rb_icon)[rbi_row];
  int rbi_big = rbi_h >= 48;
  int rbi_px = 16 + 8 * rbi_big;
} chain (int rbi_row, int rbi_x, int rbi_y, int rbi_w, int rbi_h, int rbi_col) {
  int rbi_ix = rbi_x + (rbi_w - rbi_px) / 2;
  int rbi_iy = rbi_y + 4 * rbi_big + (rbi_h - rbi_px) / 2 * (1 - rbi_big);
  int rbi_vec = lst_index_of((import ic_cmd), rbi_ic) >= 0;
} chain (int rbi_row, int rbi_x, int rbi_y, int rbi_w, int rbi_h, int rbi_col) {
  if(rbi_vec == 1) {
    vec_icon(rbi_ic, rbi_px, rbi_col, rbi_ix, rbi_iy);
  }
  if(rbi_vec == 0) {
    rbd_letter(rbi_ic, rbi_x + rbi_w / 2, rbi_y + rbi_h / 2, rbi_col);
  }
  rbd_big(rbi_row, rbi_x, rbi_y, rbi_w, rbi_h, rbi_big, rbi_col);
} return void;
