// Writes the name of item row rbi_row at the left of its field rbg in colour rbi_col, cut to the field so a long name never marks what is beside it, and leaving room at the right for the sign of a menu.
rbd_field(GuiToggle rbg, int rbi_row, int rbi_col) {
  int[] rbl_v = rbg.btn.v;
  int rbi_f = rbd_ui_f(0);
  sf_l_clip(rbl_v[0] + 1, rbl_v[1] + 1, rbl_v[2] - 16, rbl_v[3] - 2);
} chain (GuiToggle rbg, int rbi_row, int rbi_col) {
  string rbs_t = rbd_caption(rbi_row);
  gui_text_draw(rbi_f, rbl_v[0] + 6, rbl_v[1] + (rbl_v[3] - gui_font_line(rbi_f)) / 2, rbs_t, rbi_col);
  sf_l_unclip();
} return void;
