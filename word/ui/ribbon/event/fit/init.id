// The lists the ribbon keeps its open menu in, as exports: the menus, galleries and colour grids that are open (none or one of them), the name the last choice had, the labels and the answers of the open menu, and the rectangle of the control that opened it; and its combo boxes: the combo boxes themselves, the control each stands in the open tab at (-1 when its tab is not open) the one that has the keyboard (-1 for none) and the installed font families, which are looked up when the first is needed.
rbe_pops() {
  export GuiMenu[] rbd_menu = [];
  export GuiGallery[] rbd_gal = [];
  export string[] rbd_nm = [""];
} chain () {
  export string[] rbd_pl = [];
  export int[] rbd_pa = [];
  export int[] rbd_an = [0, 0, 0, 0];
} chain () {
  export GuiColors[] rbd_cg = [];
  export GuiCombo[] rbd_cb = [];
  export int[] rbd_cx = [];
} chain () {
  export int[] rbd_fo = [-1];
  export string[] rbd_fm = [];
} return void;
