// The tooltip, as an export: one for the whole ribbon, in the regular face, so that there is one at a time.
rbe_tip_new() {
  export GuiTip[] rbd_tip = [];
  int rbi_f = rbd_ui_f(0);
  GuiTip rbp = gui_tip_new(rbi_f);
} chain () {
  push((import rbd_tip), rbp);
} return void;
