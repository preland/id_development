// The lists the ribbon keeps its state in, as exports: the state list (rbd_s0 at the start), the colours the colour buttons apply (rbd_col0) and the rectangles of the five tabs.
rbe_state() {
  export int[] rbd_s = [];
  export int[] rbd_col = [];
  export int[] rbd_tr = [];
} chain () {
  lst_extend((import rbd_s), (import rbd_s0));
  lst_extend((import rbd_col), (import rbd_col0));
  lst_fill((import rbd_tr), 20, 0);
} return void;
