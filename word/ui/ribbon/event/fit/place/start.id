  int rbi_by = rbi_y + (import rbd_qat_px) + (import rbd_tab_px);
  rib_place(rib, rbi_x + 4, rbi_by, rbi_w - 8, rbi_y + rbi_h - rbi_by);
} chain (Ribbon rib, int rbi_x, int rbi_y, int rbi_w, int rbi_h) {
  rib_place((import rbd_q), rbi_x + 4, rbi_y, rbi_w - 8, (import rbd_qat_px));
  rbe_tabs(rbi_x, rbi_y + (import rbd_qat_px));
  rbe_widgets(rib, (import rbd_ws));
} chain (Ribbon rib, int rbi_x, int rbi_y, int rbi_w, int rbi_h) {
  rbe_widgets((import rbd_q), (import rbd_qs));
  rbe_shut();
  rbe_cb_place(rib);
} return void;
