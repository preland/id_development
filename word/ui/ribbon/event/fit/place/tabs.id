// Puts the five tabs side by side on the tab strip whose top is rbi_y, the first a margin in from the left edge rbi_x.
rbe_tabs(int rbi_x, int rbi_y) {
  int rbi_k = 0;
  int rbi_cx = rbi_x + 4;
  while(rbi_k < len((import rbd_tabs))) {
    rbi_cx = rbi_cx + rbe_tab(rbi_k, rbi_cx, rbi_y);
    rbi_k = rbi_k + 1;
  }
} return void;
