  lset(rbl_s, (import rbd_s_bx), rbi_x);
  lset(rbl_s, (import rbd_s_by), rbi_y);
} chain (int rbi_x, int rbi_y, int rbi_w, int rbi_h) {
  lset(rbl_s, (import rbd_s_bw), rbi_w);
  lset(rbl_s, (import rbd_s_bh), rbi_h);
} return void;
