  int rbi_w = gui_text_width(rbd_ui_f(1), (import rbd_tabs)[rbi_k]) + 2 * (import rbd_tab_pad);
  int rbi_q = rbi_k * 4;
} chain (int rbi_k, int rbi_cx, int rbi_y) {
  lset(rbl_t, rbi_q, rbi_cx);
  lset(rbl_t, rbi_q + 1, rbi_y);
  lset(rbl_t, rbi_q + 2, rbi_w);
} chain (int rbi_k, int rbi_cx, int rbi_y) {
