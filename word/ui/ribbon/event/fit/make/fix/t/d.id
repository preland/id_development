// Test check: the command, the argument and the name the last event gave, comma separated.
rbd_t_cmd() {
  int[] rbl_s = (import rbd_s);
  string rbs_z = rbl_s[(import rbd_s_cmd)] + "," + rbl_s[(import rbd_s_arg)] + "," + (import rbd_nm)[0];
} return string rbs_z;
given rbe_state given rbe_pops ():("0,0,")
given rbe_state given rbe_pops given rbe_emit(301, 5, "x") ():("301,5,x")

// Test check: whether the tooltip is on show, and its text, comma separated.
rbd_t_tv() {
  GuiTip rbp = (import rbd_tip)[0];
  string rbs_z = gui_tip_vis(rbp) + "," + rbp.text;
} return string rbs_z;
given rbd_ui_set(1, 1, 1) given rbe_tip_new ():("0,")
given rbd_ui_set(1, 1, 1) given rbe_tip_new given rbd_t_clock(1000) given rbd_t_show("a") given rbd_t_clock(1600) ():("1,a")
