// Test check: 1 when the tooltip text rbs_t is empty, or when the row has a shortcut (the key code rbi_code is not 0) that the text does not hold; 0 for a tooltip that is as it should be.
rbd_t_tipbad(string rbs_t, int rbi_code) {
  int rbi_none = len(rbs_t) == 0;
  int rbi_lack = rbi_code != 0 && str_find(rbs_t, key_text(rbi_code)) < 0;
  int rbi_bad = rbi_none || rbi_lack;
} return int rbi_bad;
("Bold (Ctrl+B) - Make the selected text bold.", 8290):(0)
("Bold - Make the selected text bold.", 8290):(1)
("", 0):(1)
("Font - Choose the font family.", 0):(0)

// Test check: 1 when the tooltip of control rbi_i of the ribbon rbr is empty or lacks the shortcut of its row.
rbd_t_rowbad(Ribbon rbr, int rbi_i) {
  string rbs_t = rbe_tip_text(rbr, rbi_i);
  int rbi_bad = rbd_t_tipbad(rbs_t, (import rb_key)[rbr.items[rbi_i]]);
} return int rbi_bad;
(Ribbon([14], [], [0]), 0):(0)
(Ribbon([10], [], [0]), 0):(0)
