// Test setup: a tap on the control at index rbi_i of the open tab, rbi_dx pixels right of the middle of its rectangle: a press and a release there, the ribbon in rbd_t_r getting both.
rbd_t_tap(int rbi_i, int rbi_dx) {
  Ribbon rbr = (import rbd_t_r);
  int rbi_q = rbi_i * 4;
  int rbi_x = rbr.rects[rbi_q] + rbr.rects[rbi_q + 2] / 2 + rbi_dx;
} chain (int rbi_i, int rbi_dx) {
  int rbi_y = rbr.rects[rbi_q + 1] + rbr.rects[rbi_q + 3] / 2;
  rbd_t_ev(3, rbi_x, rbi_y);
  rbd_t_ev(4, rbi_x, rbi_y);
} return void;
