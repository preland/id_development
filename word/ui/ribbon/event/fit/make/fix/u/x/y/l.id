// Test check: how many of the tooltips of the controls of tab rbi_tab are empty or lack their shortcut. Taken from a ribbon built for the tab, not placed.
rbd_t_tabbad(int rbi_tab) {
  Ribbon rbr = rib_build(rbi_tab);
  int rbi_bad = 0;
  int rbi_i = 0;
} chain (int rbi_tab) {
  while(rbi_i < len(rbr.items)) {
    rbi_bad = rbi_bad + rbd_t_rowbad(rbr, rbi_i);
    rbi_i = rbi_i + 1;
  }
} return int rbi_bad;
(1):(0)
(5):(0)

// Test check: how many of the tooltips of every tab, up to tab rbi_last, are empty or lack their shortcut.
rbd_t_allbad(int rbi_last) {
  int rbi_bad = 0;
  int rbi_t = 0;
  while(rbi_t <= rbi_last) {
    rbi_bad = rbi_bad + rbd_t_tabbad(rbi_t);
    rbi_t = rbi_t + 1;
  }
} return int rbi_bad;
(5):(0)
(0):(0)
