// Makes a widget for every control of the ribbon rib, in the order of its controls, replacing those in rbl_ws.
rbe_widgets(Ribbon rib, GuiToggle[] rbl_ws) {
  int rbi_i = 0;
  while(len(rbl_ws) > 0) {
    pop(rbl_ws);
  }
  while(rbi_i < len(rib.items)) {
    rbe_make(rib, rbl_ws, rbi_i);
    rbi_i = rbi_i + 1;
  }
} return void;
