// Opens A5c's colour grid for the colour button of command rbi_cmd under the control whose rectangle is rbl_a: Word's theme grid and the standard colours, and above them the bar that says automatic for the font colour and no colour for the highlight. It is kept in the list of open grids.
rbe_colours(int rbi_cmd, int[] rbl_a) {
  string rbs_l = "Automatic";
  if(rbi_cmd == (import cmd_highlight)) {
    rbs_l = "No Color";
  }
  GuiColors rbk = gui_colors_new(gui_colors_word((import idstd_pc_office)), rbs_l, rbd_ui_f(0));
} chain (int rbi_cmd, int[] rbl_a) {
  gui_colors_place(rbk, rbl_a[0], rbl_a[1], rbl_a[2], rbl_a[3], (import sf_l_w), (import sf_l_h));
  push((import rbd_cg), rbk);
} return void;
given lp_t_font given rbd_t_up(1024) (311, [10, 10, 40, 20]):() then rbd_t_cp:("1,10,30,212,184,Automatic")
given lp_t_font given rbd_t_up(1024) (312, [900, 10, 40, 20]):() then rbd_t_cp:("1,728,30,212,184,No Color")

// Writes down the colour the open grid just chose where a menu keeps the answer of its choice, so that the grid is picked like any other: the colour is the one answer and its name is its #rrggbb, or the label of the bar for the automatic colour.
rbe_note_colour() {
  GuiColors rbk = (import rbd_cg)[0];
  int rbi_v = gui_colors_value(rbk);
  string rbs_n = rbk.label;
} chain () {
  lst_splice((import rbd_pa), 0, len((import rbd_pa)), [rbi_v]);
  if(rbi_v >= 0) {
    rbs_n = oc_hex(rbi_v);
  }
  lst_str_splice((import rbd_pl), 0, len((import rbd_pl)), [rbs_n]);
} return void;
given lp_t_font given rbd_t_up(1024) given rbd_t_open(311) given rbd_t_swatch(5) ():() then rbd_t_pa:("15564081,#ed7d31")
given lp_t_font given rbd_t_up(1024) given rbd_t_open(312) given rbd_t_swatch(70) ():() then rbd_t_pa:("-1,No Color")
