// The names of the commands of tab rbi_tab as menu labels, in the order of the tab.
rbe_tab_labels(int rbi_tab) {
  int[] rbl_w = rib_rows(rbi_tab);
  string[] rbt_l = [];
  int rbi_k = 0;
} chain (int rbi_tab) {
  while(rbi_k < len(rbl_w)) {
    push(rbt_l, (import rb_label)[rbl_w[rbi_k]]);
    rbi_k = rbi_k + 1;
  }
} return string[] rbt_l;
