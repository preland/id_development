// Closes the menu, the gallery or the colour grid that is open, if one is: the lists that hold it are emptied and the state says nothing is open.
rbe_close() {
  int[] rbl_s = (import rbd_s);
  while(len((import rbd_menu)) > 0) {
    pop((import rbd_menu));
  }
  while(len((import rbd_gal)) > 0) {
    pop((import rbd_gal));
  }
} chain () {
  while(len((import rbd_cg)) > 0) {
    pop((import rbd_cg));
  }
  lset(rbl_s, (import rbd_s_pop), -1);
  lset(rbl_s, (import rbd_s_pk), 0);
} return void;
