// The labels from rbi_lo on, rbi_n of them, in the table of menu labels.
rbe_slice_s(int rbi_lo, int rbi_n) {
  string[] rbt_l = [];
  int rbi_k = 0;
  while(rbi_k < rbi_n) {
    push(rbt_l, (import rbd_plab)[rbi_lo + rbi_k]);
    rbi_k = rbi_k + 1;
  }
} return string[] rbt_l;
