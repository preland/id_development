// The labels of the menu of command rbi_cmd: the installed font families that were looked up (rbd_fm) for the font family, the styles for the styles gallery, the names of the File tab for command 0 (the File tab's own menu), else the rows of the menu tables.
rbe_labels(int rbi_cmd) {
  string[] rbt_l = [];
  int rbi_k = lst_index_of((import rbd_pcmd), rbi_cmd);
  if(rbi_k >= 0) {
    rbt_l = rbe_slice_s((import rbd_plo)[rbi_k], (import rbd_pn)[rbi_k]);
  }
} chain (int rbi_cmd) {
  if(rbi_cmd == (import cmd_font_family)) {
    rbt_l = (import rbd_fm);
  }
  if(rbi_cmd == (import cmd_style)) {
    rbt_l = (import rbd_styles);
  }
  if(rbi_cmd == 0) {
    rbt_l = rbe_tab_labels((import rib_tab_file));
  }
} return string[] rbt_l;
