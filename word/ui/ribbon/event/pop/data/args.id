// The commands of tab rbi_tab, in the order of the tab: what the File menu answers with.
rbe_tab_cmds(int rbi_tab) {
  int[] rbl_w = rib_rows(rbi_tab);
  int[] rbl_c = [];
  int rbi_k = 0;
} chain (int rbi_tab) {
  while(rbi_k < len(rbl_w)) {
    push(rbl_c, (import rb_cmd)[rbl_w[rbi_k]]);
    rbi_k = rbi_k + 1;
  }
} return int[] rbl_c;
