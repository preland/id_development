// Writes down the answer of an event: the command, its argument and the name of what was chosen, for rib_cmd, rib_arg and rib_name to give back.
rbe_emit(int rbi_cmd, int rbi_arg, string rbs_name) {
  int[] rbl_s = (import rbd_s);
  string[] rbt_n = (import rbd_nm);
  lset(rbl_s, (import rbd_s_cmd), rbi_cmd);
} chain (int rbi_cmd, int rbi_arg, string rbs_name) {
  lset(rbl_s, (import rbd_s_arg), rbi_arg);
  rbt_n[0] = rbs_name;
} return void;
