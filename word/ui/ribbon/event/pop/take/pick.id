// Remembers the colour rbi_arg for the colour button of command rbi_cmd, which applies it when its body is pressed; any other command has none to remember.
rbe_remember(int rbi_cmd, int rbi_arg) {
  int rbi_k = lst_index_of((import rbd_col_cmd), rbi_cmd);
  if(rbi_k >= 0) {
    lset((import rbd_col), rbi_k, rbi_arg);
  }
} return void;
