// An event for the open menu or gallery: the widget decides what it means, and the answer is rbe_ret's. A choice is taken and every end of the menu closes it.
rbe_pop_event(int rbi_kind, int[] rbl_ev) {
  int rbi_b = rbe_route(rbi_kind, rbl_ev);
  int rbi_on = gui_wid_hit((import rbd_an), rbl_ev[1], rbl_ev[2]);
  int rbi_r = rbe_ret(rbi_b, rbi_kind, rbi_on);
} chain (int rbi_kind, int[] rbl_ev) {
  if((rbi_b & 2) != 0) {
    rbe_pick();
  }
  if((rbi_b & 6) != 0) {
    rbe_close();
  }
} return int rbi_r;
