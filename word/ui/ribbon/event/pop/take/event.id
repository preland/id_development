// Takes what the open menu or gallery has hot as the choice made: its command is the one the menu was opened for (for the File tab's menu, command 0, the choice is itself a command), its argument and its name are the choice's, and a colour choice is remembered for the colour button.
rbe_pick() {
  int[] rbl_s = (import rbd_s);
  int rbi_k = rbe_hot();
  int rbi_cmd = rbl_s[(import rbd_s_pcmd)];
} chain () {
  int rbi_arg = (import rbd_pa)[rbi_k];
  string rbs_n = (import rbd_pl)[rbi_k];
  if(rbi_cmd == 0) {
    rbi_cmd = rbi_arg;
    rbi_arg = 0;
  }
} chain () {
  rbe_emit(rbi_cmd, rbi_arg, rbs_n);
  rbe_remember(rbi_cmd, rbi_arg);
} return void;
