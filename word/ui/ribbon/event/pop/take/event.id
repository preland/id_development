// What an event did to the open menu or gallery, as the widget's own bits: 1 draw again, 2 a choice was made, 4 dismissed; 0 when nothing is open.
rbe_route(int rbi_kind, int[] rbl_ev) {
  int rbi_pk = (import rbd_s)[(import rbd_s_pk)];
  int rbi_b = 0;
  if(rbi_pk == 1) {
    rbi_b = gui_menu_event((import rbd_menu)[0], rbi_kind, rbl_ev);
  }
} chain (int rbi_kind, int[] rbl_ev) {
  if(rbi_pk == 2) {
    rbi_b = gui_gallery_event((import rbd_gal)[0], rbi_kind, rbl_ev);
  }
  if(rbi_pk == 3) {
    rbi_b = gui_colors_event((import rbd_cg)[0], rbi_kind, rbl_ev);
  }
  if((rbi_b & 2) != 0 && rbi_pk == 3) {
    rbe_note_colour();
  }
} return int rbi_b;
