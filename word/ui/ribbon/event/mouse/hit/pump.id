// Notes in the state list that the control at index rbi_i of the ribbon rbi_src (0 the body, 1 the quick-access strip) was activated, when the widget's bits rbi_b say it was.
rbe_note(int rbi_src, int rbi_i, int rbi_b) {
  int[] rbl_s = (import rbd_s);
  if((rbi_b & 2) != 0) {
    lset(rbl_s, (import rbd_s_src), rbi_src);
    lset(rbl_s, (import rbd_s_act), rbi_i);
  }
} return void;
