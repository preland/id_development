// Gives the event to every widget in rbl_ws, the ribbon rbi_src's, and answers the bits of all of them together.
rbe_pump(GuiToggle[] rbl_ws, int rbi_src, int rbi_kind, int[] rbl_ev) {
  int rbi_k = 0;
  int rbi_b = 0;
  while(rbi_k < len(rbl_ws)) {
    rbi_b = rbi_b | rbe_hit_one(rbl_ws, rbi_src, rbi_k, rbi_kind, rbl_ev);
    rbi_k = rbi_k + 1;
  }
} return int rbi_b;
