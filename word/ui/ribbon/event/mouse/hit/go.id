// A press on tab rbi_t of the tab strip: the File tab opens its menu of commands under it, any other tab takes the place of the open one in the ribbon rib.
rbe_tab_press(Ribbon rib, int rbi_t) {
  int[] rbl_a = lst_slice((import rbd_tr), 0, 4);
  if(rbi_t == 0) {
    rbe_open(0, 2, 0, rbl_a);
  }
  if(rbi_t > 0) {
    rib_show(rib, rbi_t);
  }
} return void;
