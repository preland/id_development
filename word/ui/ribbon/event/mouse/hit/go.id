// A press at the point of the event rbl_ev: on a tab it opens it, on the arrow strip of a split button it opens that button's menu, anywhere else it goes to the widgets. Answers the bits of the event, 1 when the press did something to the picture.
rbe_press(Ribbon rib, int[] rbl_ev) {
  int rbi_t = rbe_at((import rbd_tr), 5, rbl_ev[1], rbl_ev[2]);
  int rbi_a = rbe_arrow_at(rib, rbl_ev[1], rbl_ev[2]);
  int rbi_b = 1;
} chain (Ribbon rib, int[] rbl_ev) {
  if(rbi_t >= 0) {
    rbe_tab_press(rib, rbi_t);
  }
  if(rbi_a >= 0) {
    rbe_open_at(rib, 0, rbi_a, (import rb_cmd)[rib.items[rbi_a]]);
  }
  if(rbi_t < 0 && rbi_a < 0) {
    rbi_b = rbe_pumps(3, rbl_ev);
  }
} return int rbi_b;
