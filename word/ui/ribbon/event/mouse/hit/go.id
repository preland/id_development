// What the activated control does, the one the state list names (its ribbon and its index): a button, a toggle, a wide button, a split button's body or a colour button's body gives its command (a colour button with the colour it remembers); a control that opens a menu opens it.
rbe_act(Ribbon rib) {
  int[] rbl_s = (import rbd_s);
  Ribbon rbr = rbe_rib(rib, rbl_s[(import rbd_s_src)]);
  int rbi_row = rbr.items[rbl_s[(import rbd_s_act)]];
} chain (Ribbon rib) {
  int rbi_menu = (import rbd_k_menu)[(import rb_kind)[rbi_row]];
  int rbi_cmd = (import rb_cmd)[rbi_row];
  if(rbi_menu == 1) {
    rbe_open_at(rbr, rbl_s[(import rbd_s_src)], rbl_s[(import rbd_s_act)], rbi_cmd);
  }
} chain (Ribbon rib) {
  if(rbi_menu == 0) {
    rbe_emit(rbi_cmd, rbe_arg_of(rbi_row), "");
  }
} return void;
