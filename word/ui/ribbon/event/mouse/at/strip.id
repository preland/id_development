// The control index rbi_i of the ribbon rib when the point at x rbi_x, which is inside it, is on its arrow strip, which only a split button has, at the right end of its rectangle; -1 when it is not.
rbe_strip(Ribbon rib, int rbi_i, int rbi_x) {
  int rbi_right = rib.rects[rbi_i * 4] + rib.rects[rbi_i * 4 + 2];
  int rbi_on = (rbd_shape(rib.items[rbi_i]) == 2) * (rbi_x >= rbi_right - (import rbd_arrow_px));
  int rbi_a = rbi_on * (rbi_i + 1) - 1;
} return int rbi_a;
