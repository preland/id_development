// Starts an event with no answer: the command and the argument, the activated control and the name of the last choice are cleared.
rbe_clear() {
  int[] rbl_s = (import rbd_s);
  string[] rbt_n = (import rbd_nm);
  lset(rbl_s, (import rbd_s_cmd), 0);
} chain () {
  lset(rbl_s, (import rbd_s_arg), 0);
  lset(rbl_s, (import rbd_s_act), -1);
  rbt_n[0] = "";
} return void;
