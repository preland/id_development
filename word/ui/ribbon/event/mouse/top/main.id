// What the ribbon does with the event of kind rbi_kind, fields rbl_ev, that no combo box took: a menu that is open takes it first; otherwise a mouse event goes to the tabs and the controls, and a key or a press takes the tooltip away. Answers the bits rib_event does.
rbe_rest(Ribbon rib, int rbi_kind, int[] rbl_ev) {
  int rbi_pk = (import rbd_s)[(import rbd_s_pk)];
  int rbi_b = 0;
  if(rbi_pk != 0) {
    rbi_b = rbe_pop_event(rbi_kind, rbl_ev);
  }
} chain (Ribbon rib, int rbi_kind, int[] rbl_ev) {
  int rbi_t = gui_tip_event((import rbd_tip)[0], rbi_kind, rbl_ev);
  int rbi_ms = rbi_kind >= 3 && rbi_kind <= 5;
  if((rbi_b & 8) == 0 && rbi_ms == 1) {
    rbi_b = rbi_b | rbe_mouse(rib, rbi_kind, rbl_ev);
  }
} chain (Ribbon rib, int rbi_kind, int[] rbl_ev) {
  rbi_b = rbi_b | rbi_t;
} return int rbi_b;
