// Paints the page area: the desk, then every sheet that shows in it, cut to the area (cv_area, over the whole of it). The rectangle of the area is the chrome's, the scroll and the zoom are the viewer's state.
vw_canvas(View vwv) {
  int vwi_y = vw_box("canvas", 1);
  int[] vwl_r = [0, 0, 0, 0, 0, 0];
  cv_rows(vwi_y, vwi_y + vw_box("canvas", 3), vwl_r);
} chain (View vwv) {
  cv_area(vwv, vwl_r);
} return void;
