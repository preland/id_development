// Paints the page area: the desk, then every sheet that shows in it, cut to the area. The rectangle of the area is the chrome's, the scroll and the zoom are the viewer's state.
vw_canvas(View vwv) {
  int[] vwl_r = [vw_box("canvas", 0), vw_box("canvas", 1), vw_box("canvas", 2), vw_box("canvas", 3)];
  sf_l_clip(vwl_r[0], vwl_r[1], vwl_r[2], vwl_r[3]);
  d2_l_rect(vwl_r[0], vwl_r[1], vwl_r[2], vwl_r[3], (import vw_c_desk));
} chain (View vwv) {
  vw_pages(vwv, vwl_r);
  sf_l_unclip();
} return void;
