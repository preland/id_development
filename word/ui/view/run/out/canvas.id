// Paints every page from the first, each when it shows in the page area vwl_r (x, y, width, height).
vw_pages(View vwv, int[] vwl_r) {
  int vwi_k = 0;
  int vwi_n = lay_page_count(vwv);
  while(vwi_k < vwi_n) {
    vw_pk(vwv, vwi_k, vwl_r);
    vwi_k = vwi_k + 1;
  }
} return void;
