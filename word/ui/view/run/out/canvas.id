// Paints page vwi_k when its sheet shows in the page area vwl_r: where it lies is the page's top in the document less the scroll, centred across the area.
vw_pk(View vwv, int vwi_k, int[] vwl_r) {
  int[] vwl_st = (import vw_st);
  int vwi_z = vwl_st[(import vw_s_z)];
  int vwi_ph = vw_px(lay_sheet(vwv.doc, 1), vwi_z);
} chain (View vwv, int vwi_k, int[] vwl_r) {
  int vwi_top = vwl_r[1] + vw_top(vwv, vwi_k, vwi_z) - vwl_st[(import vw_s_y)];
  int vwi_v = vw_vis(vwi_top, vwi_ph, vwl_r[1], vwl_r[3]);
  if(vwi_v == 1) {
    vw_show(vwv, vwi_k, vwl_r, vwi_top);
  }
} return void;
