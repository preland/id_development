// The page the viewer shows, counted from 0: the one under the middle of the page area, which is vwi_ch pixels tall and scrolled to vwi_y at zoom vwi_z. It is the last page that starts at or above that line.
// By hand: with 300 px of page area the middle is 150 px down at no scroll, above the second page's top at 248, so page 0; scrolled 172 it is 322, past it, so page 1.
vw_cur(View vwv, int vwi_z, int vwi_y, int vwi_ch) {
  int vwi_mid = vwi_y + vwi_ch / 2;
  int vwi_k = 0;
  int vwi_n = lay_page_count(vwv);
} chain (View vwv, int vwi_z, int vwi_y, int vwi_ch) {
  while(vwi_k + 1 < vwi_n && vw_top(vwv, vwi_k + 1, vwi_z) <= vwi_mid) {
    vwi_k = vwi_k + 1;
  }
} return int vwi_k;
given vw_t_two () ((import lp_t_v), 100, 0, 300):(0)
given vw_t_two () ((import lp_t_v), 100, 172, 300):(1)
given vw_t_two () ((import lp_t_v), 200, 100, 300):(0)

// What the status bar says: the page shown out of the pages there are, the words in the document and the zoom, for a page area vwi_ch pixels tall. The sentence is built when one of the four numbers in it differs from the numbers the kept one was built from (vw_stk), and the kept one (vw_stt) is answered otherwise, so a frame that changes none of them builds no string.
vw_status_text(View vwv, int vwi_ch) {
  int[] vwl_st = (import vw_st);
  int vwi_k = vw_cur(vwv, vwl_st[(import vw_s_z)], vwl_st[(import vw_s_y)], vwi_ch);
  int vwi_w = count_words(vwv.doc);
} chain (View vwv, int vwi_ch) {
  int vwi_n = lay_page_count(vwv);
  int vwi_k1 = vwi_k * 65536 + vwi_n;
  int vwi_k2 = vwi_w * 4096 + vwl_st[(import vw_s_z)];
} chain (View vwv, int vwi_ch) {
  int[] vwl_kc = (import vw_stk);
  string[] vwl_sc = (import vw_stt);
  if(vwl_kc[0] != vwi_k1 || vwl_kc[1] != vwi_k2) {
    vw_stat_keep(vwl_kc, vwl_sc, vwi_k1, vwi_k2, "Page " + (vwi_k + 1) + " of " + vwi_n + "    " + vwi_w + " words    " + vwl_st[(import vw_s_z)] + "%");
  }
} chain (View vwv, int vwi_ch) {
  string vws_t = (import vw_stt)[0];
} return string vws_t;
given vw_t_two given vw_state_new ((import lp_t_v), 300):("Page 1 of 2    8 words    100%")
given vw_t_two given vw_t_at_y(300, 150) ((import lp_t_v), 300):("Page 2 of 2    8 words    150%")
given vw_t_two given vw_state_new given vw_t_up(400, 300) given rbd_ui_set(1, 1, 1) given vw_status((import lp_t_v)) given vw_zoom((import lp_t_v), 150, 300) ((import lp_t_v), 300):("Page 1 of 2    8 words    150%")

// Keeps the sentence vws_t of the status bar and the two numbers vwi_k1 and vwi_k2 it was built from, in the lists the status text reads them from.
vw_stat_keep(int[] vwl_kc, string[] vwl_sc, int vwi_k1, int vwi_k2, string vws_t) {
  vwl_kc[0] = vwi_k1;
  vwl_kc[1] = vwi_k2;
  vwl_sc[0] = vws_t;
} return void;
([0, 0], [""], 5, 6, "x"):([5, 6], ["x"])
([1, 2], ["a", "b"], 7, 8, "y"):([7, 8], ["y", "b"])
