// Breaks the text vws_s into lines no wider than vwi_w pixels in font vwi_f, at its spaces; a word wider than a line has a line of its own.
vw_wrap(int vwi_f, string vws_s, int vwi_w) {
  string[] vwl_words = str_split(vws_s, " ");
  string[] vwl_lines = [];
  string vws_cur = "";
} chain (int vwi_f, string vws_s, int vwi_w) {
  int vwi_k = 0;
  while(vwi_k < len(vwl_words)) {
    vws_cur = vw_fill(vwl_lines, vwi_f, vws_cur, vwl_words[vwi_k], vwi_w);
    vwi_k = vwi_k + 1;
  }
  push(vwl_lines, vws_cur);
} return string[] vwl_lines;
given lp_t_font (1, "AAA BBB", 1000):(["AAA BBB"])
given lp_t_font (1, "AAA BBB", 1):(["AAA", "BBB"])
given lp_t_font (1, "AAA", 1):(["AAA"])

// Adds the word vws_w to the line vws_cur: when the line then still fits vwi_w pixels it is the line, else the line is finished (kept in vwl_lines) and the word starts the next. Answers the line to go on with.
vw_fill(string[] vwl_lines, int vwi_f, string vws_cur, string vws_w, int vwi_w) {
  string vws_try = vws_cur + " " + vws_w;
  int vwi_fit = len(vws_cur) == 0 || gui_text_width(vwi_f, vws_try) <= vwi_w;
  string vws_next = vws_w;
} chain (string[] vwl_lines, int vwi_f, string vws_cur, string vws_w, int vwi_w) {
  if(vwi_fit == 1 && len(vws_cur) > 0) {
    vws_next = vws_try;
  }
  if(vwi_fit == 0) {
    push(vwl_lines, vws_cur);
  }
} return string vws_next;
given lp_t_font ([], 1, "", "AAA", 100):("AAA")
given lp_t_font ([], 1, "AAA", "BBB", 1):("BBB")
given lp_t_font ([], 1, "AAA", "BBB", 1000):("AAA BBB")

// Paints a card in the page area (x, y, width, height) that says why there is no document: a white card with a border, centred, a title in bold in dark red and the message wrapped below it.
vw_card(string vws_m, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  int vwi_cw = fx_min(vwi_w - 40, 520);
  int vwi_f = (import rbd_ui)[0];
  string[] vwl_lines = vw_wrap(vwi_f, vws_m, vwi_cw - 32);
} chain (string vws_m, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  int vwi_ch = len(vwl_lines) * gui_font_line(vwi_f) + 64;
  int vwi_cx = vwi_x + (vwi_w - vwi_cw) / 2;
  int vwi_cy = vwi_y + (vwi_h - vwi_ch) / 2;
} chain (string vws_m, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  d2_l_rect(vwi_cx, vwi_cy, vwi_cw, vwi_ch, (import vw_c_edge));
  d2_l_rect(vwi_cx + 1, vwi_cy + 1, vwi_cw - 2, vwi_ch - 2, (import vw_c_sheet));
  gui_text_draw((import rbd_ui)[1], vwi_cx + 16, vwi_cy + 14, "This document cannot be opened", (import vw_c_red));
} chain (string vws_m, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  vw_card_lines(vwl_lines, vwi_cx + 16, vwi_cy + 44);
} return void;
