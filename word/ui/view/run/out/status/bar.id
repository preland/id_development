// Writes the status text at x, vertically centred in a band vwi_h pixels tall whose top is vwi_y, in the bar's text colour.
vw_say(View vwv, int vwi_x, int vwi_y, int vwi_h) {
  string vws_t = vw_status_text(vwv, vw_box("canvas", 3));
  int vwi_f = vw_ui_f(0);
  int vwi_ty = vwi_y + (vwi_h - gui_font_line(vwi_f)) / 2;
} chain (View vwv, int vwi_x, int vwi_y, int vwi_h) {
  gui_text_draw(vwi_f, vwi_x, vwi_ty, vws_t, (import vw_c_bartext));
} return void;
