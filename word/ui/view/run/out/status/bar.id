// Paints the status bar: its band in the bar colour over its rectangle from the chrome, the status text in the viewer's own face at the left.
vw_status(View vwv) {
  int vwi_x = vw_box("status", 0);
  int vwi_y = vw_box("status", 1);
  int vwi_w = vw_box("status", 2);
} chain (View vwv) {
  int vwi_h = vw_box("status", 3);
  d2_l_rect(vwi_x, vwi_y, vwi_w, vwi_h, (import vw_c_bar));
  vw_say(vwv, vwi_x + 10, vwi_y, vwi_h);
} return void;
