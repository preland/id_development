// Writes the lines of a card one under another from (vwi_x, vwi_y), in the viewer's own face in the dark icon colour.
vw_card_lines(string[] vwl_lines, int vwi_x, int vwi_y) {
  int vwi_f = vw_ui_f(0);
  int vwi_lh = gui_font_line(vwi_f);
  int vwi_k = 0;
} chain (string[] vwl_lines, int vwi_x, int vwi_y) {
  while(vwi_k < len(vwl_lines)) {
    gui_text_draw(vwi_f, vwi_x, vwi_y + vwi_k * vwi_lh, vwl_lines[vwi_k], (import vw_c_icon));
    vwi_k = vwi_k + 1;
  }
} return void;
