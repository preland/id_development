// Starts a command that may change the document or the selection: the layout is kept (cv_keep) to see afterwards what moved, and the paragraphs of the selection as it is now are asked to be repainted.
cv_begin(View cvv) {
  cv_keep(cvv, (import vw_tp));
  cv_sel_dirty(cvv);
} return void;
