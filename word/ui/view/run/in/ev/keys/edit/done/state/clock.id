// The time now in milliseconds that the caret blinks by: the clock a case froze, else ticks().
cv_now() {
  int cvi_c = (import vw_ed)[(import cv_e_clk)];
  int cvi_t = ticks();
  if(cvi_c >= 0) {
    cvi_t = cvi_c;
  }
} return int cvi_t;
