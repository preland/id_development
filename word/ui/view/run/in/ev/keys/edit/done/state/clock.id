// 1 when the caret is drawn now: it is in the first half of a blink period, counted from the last time it became solid, so it is on for cv_blink milliseconds and off for as many.
cv_on() {
  int cvi_a = cv_now() - (import vw_ed)[(import cv_e_t0)];
  int cvi_o = cvi_a % (2 * (import cv_blink)) < (import cv_blink);
} return int cvi_o;
