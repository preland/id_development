// Once a frame: when the caret has gone into the other half of its blink the line it is on is asked to be repainted, and a drag that rests outside the page area is followed.
cv_tick(View cvv) {
  int cvi_p = cv_on();
  int[] cvl_e = (import vw_ed);
  int cvi_c = cvi_p != cvl_e[(import cv_e_ph)];
} chain (View cvv) {
  if(cvi_c == 1) {
    lset(cvl_e, (import cv_e_ph), cvi_p);
    cv_caret_dirty(cvv);
  }
  cv_pull(cvv);
} return void;
