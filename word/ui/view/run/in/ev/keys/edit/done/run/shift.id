// Asks for what the stale paragraphs cvl_r cover to be repainted: from the top of the first, down to the bottom of the last when nothing below them moved (cvi_s 0) and as far as the end of the page area when it did (1). When the last paragraph of the document is among them it may have been taller before, which vw_tp kept as the end of the document, and what it was is repainted too.
cv_stripe(View cvv, int[] cvl_r, int cvi_s) {
  int cvi_y = cvv.pages.tops[cvl_r[0]];
  int cvi_e = cv_end_y(cvv, cvl_r[1]);
  if(cvi_s == 1) {
    cvi_e = cvi_y + (import cv_far);
  }
} chain (View cvv, int[] cvl_r, int cvi_s) {
  int[] cvl_tp = (import vw_tp);
  int cvi_l = cvl_r[1] + 1 == len(cvv.pages.tops);
  if(cvi_l == 1) {
    cvi_e = fixed_point_maximum(cvi_e, cvl_tp[len(cvl_tp) - 1]);
  }
} chain (View cvv, int[] cvl_r, int cvi_s) {
  cv_band(cvv, cvi_y, cvi_e);
} return void;
