// Asks for the repainting that an edit that left the stale paragraphs cvl_r (and had cvi_np pages) needs: the whole picture when cv_shift says so, else the paragraphs and what is below them if that moved.
cv_dirty(View cvv, int[] cvl_r, int cvi_np) {
  int cvi_s = cv_shift(cvv, cvl_r, cvi_np);
  if(cvi_s == 2) {
    lset((import vw_st), (import vw_s_d), 1);
  }
  if(cvi_s < 2 && cvl_r[0] >= 0) {
    cv_stripe(cvv, cvl_r, cvi_s);
  }
} return void;
