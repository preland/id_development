// Widens the range cvl_r of stale paragraphs to include paragraph cvi_k when it is stale.
cv_touch(View cvv, int[] cvl_r, int cvi_k) {
  int cvi_s = cvv.doc.body.paras[cvi_k].lay.h == 0 - 1;
  if(cvi_s == 1 && cvl_r[0] < 0) {
    lset(cvl_r, 0, cvi_k);
  }
  if(cvi_s == 1) {
    lset(cvl_r, 1, cvi_k);
  }
} return void;
