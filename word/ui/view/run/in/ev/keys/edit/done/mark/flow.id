// The first and the last paragraph that an edit marked stale, as [first, last], or [-1, -1] when none is.
cv_stale(View cvv) {
  int[] cvl_r = [0 - 1, 0 - 1];
  int cvi_k = 0;
  int cvi_n = len(cvv.doc.body.paras);
} chain (View cvv) {
  while(cvi_k < cvi_n) {
    cv_touch(cvv, cvl_r, cvi_k);
    cvi_k = cvi_k + 1;
  }
} return int[] cvl_r;
