// The alignment buttons: the command that is in the table cv_al_cmd gives the paragraphs of the selection the alignment at its position (0 left, 1 centre, 2 right, 3 justify).
cv_align(View cvv, Ctl cvc, int cvi_cmd) {
  int cvi_k = lst_index_of((import cv_al_cmd), cvi_cmd);
  if(cvi_k >= 0) {
    ed_set_para(cvv.doc, cvc, (import word_p_align), cvi_k);
  }
} return void;
