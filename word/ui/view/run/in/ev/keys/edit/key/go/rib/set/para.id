// The paragraph field that the command cvi_cmd sets to the argument cvi_arg, by the table cv_pc_cmd: the line spacing in percent, the left and right indent and the space before and after in twips; in every paragraph the selection touches. Any other command is left alone.
cv_para(View cvv, Ctl cvc, int cvi_cmd, int cvi_arg) {
  int cvi_k = lst_index_of((import cv_pc_cmd), cvi_cmd);
  if(cvi_k >= 0) {
    ed_set_para(cvv.doc, cvc, (import cv_pc_fld)[cvi_k], cvi_arg);
  }
} return void;
