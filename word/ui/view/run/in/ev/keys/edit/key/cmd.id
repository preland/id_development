// Runs the command cvi_cmd (the ids of the ribbon table, word/conf.id) that the canvas itself can do: undo and redo, the clipboard commands, select all, bold, italic, underline, strikethrough and the page break. Any other command is the shell's and is left alone here.
cv_cmd(View cvv, int cvi_cmd) {
  Ctl cvc = (import vw_ctl);
  cv_hist(cvv, cvc, cvi_cmd);
  cv_clip(cvv, cvc, cvi_cmd);
} chain (View cvv, int cvi_cmd) {
  cv_fmt(cvv, cvc, cvi_cmd);
  if(cvi_cmd == (import cmd_select_all)) {
    ed_select_all(cvv.doc, cvc);
  }
} return void;
