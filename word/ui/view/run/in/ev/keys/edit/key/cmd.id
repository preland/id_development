// Undoes (cmd_undo) or redoes (cmd_redo) the last change of the document, which puts the selection back as it was.
cv_hist(View cvv, Ctl cvc, int cvi_cmd) {
  int cvi_r = 0;
  if(cvi_cmd == (import cmd_undo)) {
    cvi_r = hist_undo(cvv.doc, cvc);
  }
  if(cvi_cmd == (import cmd_redo)) {
    cvi_r = hist_redo(cvv.doc, cvc);
  }
} return void;
