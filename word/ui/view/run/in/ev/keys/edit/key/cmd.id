// Cut (cmd_cut), copy (cmd_copy) and paste (cmd_paste): the selection goes to the controller's fragment and its text to the system clipboard (an empty selection leaves the clipboard alone), and paste puts what the clipboard holds in place of the selection; an empty clipboard changes nothing.
cv_clip(View cvv, Ctl cvc, int cvi_cmd) {
  string cvs_t = "";
  if(cvi_cmd == (import cmd_cut)) {
    cvs_t = ed_cut(cvv.doc, cvc);
  }
  if(cvi_cmd == (import cmd_copy)) {
    cvs_t = ed_copy(cvv.doc, cvc);
  }
} chain (View cvv, Ctl cvc, int cvi_cmd) {
  int cvi_s = len(cvs_t) > 0 && gfx_clip_set(cvs_t) == 1;
  if(cvi_cmd == (import cmd_paste)) {
    ed_paste(cvv.doc, cvc, gfx_clip_get());
  }
} return void;
