given cv_t_ed("AB AB AB") ((import lp_t_v), 97, 0):() then cv_t_sel:("0:0-0:0")

// Moves the caret as movement key number cvi_i (the key less 1001) says, with Ctrl when cvi_c is 1 and extending the selection when cvi_e is 1. A key that is no movement (dir 0 in the tables) does nothing.
cv_step(View cvv, int cvi_i, int cvi_c, int cvi_e) {
  Ctl cvc = (import vw_ctl);
  int[] cvl_d = (import cv_k_dir);
  int[] cvl_u = (import cv_k_unit);
} chain (View cvv, int cvi_i, int cvi_c, int cvi_e) {
  if(cvi_c == 1) {
    cvl_d = (import cv_k_cdir);
    cvl_u = (import cv_k_cunit);
  }
  if(cvl_d[cvi_i] != 0) {
    ed_move(cvv.doc, cvc, cvl_d[cvi_i], cvl_u[cvi_i], cvi_e);
  }
} return void;
