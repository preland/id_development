// What the key cvi_key (1001 to 1013) with the modifiers cvi_mods does to the caret when it is a movement key: the caret moves by the direction and unit the key tables give (with Ctrl, the Ctrl ones), and with Shift the selection grows instead of collapsing. Any other key leaves everything as it is.
cv_nav(View cvv, int cvi_key, int cvi_mods) {
  int cvi_i = cvi_key - 1001;
  int cvi_c = (cvi_mods & 2) != 0;
  int cvi_e = (cvi_mods & 1) != 0;
} chain (View cvv, int cvi_key, int cvi_mods) {
  if(cvi_i >= 0 && cvi_i < 13) {
    cv_step(cvv, cvi_i, cvi_c, cvi_e);
  }
} return void;
given cv_t_ed("AB AB AB") given ed_move((import lp_t_d), (import vw_ctl), 1, 5, 0) ((import lp_t_v), 1001, 0):() then cv_t_sel:("0:7-0:7")
