// What a key cvi_key with the modifiers cvi_mods does when the table has no command for it (cvi_cmd is 0) and no Alt or Super is held: it moves the caret, or it is Backspace, Delete, Enter or Tab and changes the text.
cv_edit(View cvv, int cvi_key, int cvi_mods, int cvi_cmd) {
  int cvi_c = (cvi_mods & 2) != 0;
  int cvi_p = cvi_cmd == 0 && (cvi_mods & 12) == 0;
  if(cvi_p == 1) {
    cv_nav(cvv, cvi_key, cvi_mods);
    cv_chg(cvv, cvi_key, cvi_c);
  }
} return void;
