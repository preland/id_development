// How many pixels a drag whose pointer is at row cvi_my scrolls the page area in a frame, when the area starts at row cvi_cy and is cvi_ch tall: down (positive) below it and up above it, a quarter of the distance and at least cv_pull_px pixels; 0 while the pointer is inside it.
cv_out(int cvi_my, int cvi_cy, int cvi_ch) {
  int cvi_o = 0;
  if(cvi_my < cvi_cy) {
    cvi_o = 0 - ((cvi_cy - cvi_my) / 4 + (import cv_pull_px));
  }
  if(cvi_my >= cvi_cy + cvi_ch) {
    cvi_o = (cvi_my - cvi_cy - cvi_ch) / 4 + (import cv_pull_px);
  }
} return int cvi_o;
