// Does a key as one command: the command the table gives (a Tab with no modifier is typed, not the table's list command), then the caret movement or the text change the key is.
cv_do(View cvv, int cvi_key, int cvi_mods, int cvi_cmd) {
  int cvi_c = cvi_cmd;
  if(cvi_key == 1010 && cvi_mods == 0) {
    cvi_c = 0;
  }
  cv_cmd(cvv, cvi_c);
} chain (View cvv, int cvi_key, int cvi_mods, int cvi_cmd) {
  cv_edit(cvv, cvi_key, cvi_mods, cvi_c);
} return void;
