// A key (an event of kind 1: key id cvi_key, modifiers cvi_mods): when the ribbon's key table has a command for it, or it is a navigation or editing key (Escape is not), it is done as one command.
cv_key(View cvv, int cvi_key, int cvi_mods) {
  int cvi_cmd = key_cmd(cvi_mods, cvi_key);
  int cvi_go = cvi_cmd != 0 || (cvi_key > 1000 && cvi_key != 1011);
  if(cvi_go == 1) {
    cv_begin(cvv);
    cv_do(cvv, cvi_key, cvi_mods, cvi_cmd);
    cv_end(cvv);
  }
} return void;
