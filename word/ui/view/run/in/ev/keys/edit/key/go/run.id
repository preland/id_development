// Types the code point cvi_cp at the caret (replacing the selection) when no Ctrl or Alt is held, as one command: the picture is asked to change where it did and the caret is brought into view.
cv_text(View cvv, int cvi_cp, int cvi_mods) {
  Ctl cvc = (import vw_ctl);
  int cvi_ok = (cvi_mods & 6) == 0 && cvi_cp >= 32;
  if(cvi_ok == 1) {
    cv_begin(cvv);
    ed_type(cvv.doc, cvc, cvi_cp);
    cv_end(cvv);
  }
} return void;
