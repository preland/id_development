// Asks for the paragraphs cvi_p0 to cvi_p1 to be repainted, from the top of the first to the bottom of the last, in whole rows of the page area.
cv_para_band(View cvv, int cvi_p0, int cvi_p1) {
  int cvi_t = cvv.pages.tops[cvi_p0];
  int cvi_e = cv_end_y(cvv, cvi_p1);
  cv_band(cvv, cvi_t, cvi_e);
} return void;
