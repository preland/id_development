// Asks for the line the caret is on to be repainted: the rows of its line, for a caret that blinks.
cv_caret_dirty(View cvv) {
  int[] cvl_o = cv_where(cvv);
  int cvi_y = cvl_o[0] * (lay_sheet(cvv.doc, 1) + (import word_lay_gap)) + cvl_o[2];
  cv_band(cvv, cvi_y, cvi_y + cvl_o[3]);
} return void;
