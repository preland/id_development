// The scroll or the zoom a key makes: without Ctrl the navigation keys move the page area (vwi_ch pixels tall), with Ctrl plus and equals zoom in, minus zooms out and 0 resets the zoom.
vw_nav(View vwv, int vwi_key, int vwi_ctl, int vwi_ch) {
  int[] vwl_st = (import vw_st);
  int vwi_z = vwl_st[(import vw_s_z)];
  if(vwi_ctl == 0) {
    vw_scroll(vwv, vw_step(vwi_key, vwi_ch), vwi_ch);
  }
} chain (View vwv, int vwi_key, int vwi_ctl, int vwi_ch) {
  if(vwi_ctl == 1) {
    vw_zoom(vwv, vw_zstep(vwi_key, vwi_z), vwi_ch);
  }
} return void;
