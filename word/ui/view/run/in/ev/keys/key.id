// What a key does: 1 when it asks to quit (Escape), else with Ctrl it zooms (plus and minus by 10 percent, 0 back to 100) and it is the canvas's whatever it is: the command the key table has for it, a caret movement, a change of the text (cv_key). The page area is vwi_ch pixels tall.
vw_key(View vwv, int vwi_key, int vwi_mods, int vwi_ch) {
  int vwi_ctl = (vwi_mods & 2) != 0;
  int vwi_q = vwi_ctl == 0 && vwi_key == 1011;
  vw_nav(vwv, vwi_key, vwi_ctl, vwi_ch);
} chain (View vwv, int vwi_key, int vwi_mods, int vwi_ch) {
  cv_key(vwv, vwi_key, vwi_mods);
} return int vwi_q;
