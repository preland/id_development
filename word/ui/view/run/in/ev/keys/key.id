// What a key does: 1 when it asks to quit (Esc, or q without Ctrl), else it scrolls (Page Up and Down by a screenful less 40 pixels, the arrows by 40, Home and End to the ends of the document) or, with Ctrl, zooms (plus and minus by 10 percent, 0 back to 100). The page area is vwi_ch pixels tall.
vw_key(View vwv, int vwi_key, int vwi_mods, int vwi_ch) {
  int vwi_ctl = (vwi_mods & 2) != 0;
  int vwi_q = vwi_ctl == 0 && (vwi_key == 1011 || vwi_key == 113);
  vw_nav(vwv, vwi_key, vwi_ctl, vwi_ch);
} return int vwi_q;
