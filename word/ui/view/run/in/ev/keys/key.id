// The zoom a key makes: with Ctrl, plus and equals zoom in, minus zooms out and 0 resets the zoom; any other key, or any key without Ctrl, leaves it as it is, and the page area (vwi_ch pixels tall) keeps what it shows.
vw_nav(View vwv, int vwi_key, int vwi_ctl, int vwi_ch) {
  int[] vwl_st = (import vw_st);
  int vwi_z = vwl_st[(import vw_s_z)];
  int vwi_n = vw_zstep(vwi_key, vwi_z);
} chain (View vwv, int vwi_key, int vwi_ctl, int vwi_ch) {
  if(vwi_ctl == 1 && vwi_n != vwi_z) {
    vw_zoom(vwv, vwi_n, vwi_ch);
  }
} return void;
