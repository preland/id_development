// A mouse event of kind vwi_kind (3 press, 4 release, 5 move) goes to the scrollbar, which follows a drag or an arrow or a press in its track; what it moved becomes the viewer's scroll.
vw_mouse(int vwi_kind, int[] vwl_ev) {
  int vwi_bits = gui_scroll_event((import vw_sb), vwi_kind, vwl_ev);
  if((vwi_bits & 2) != 0) {
    vw_bar_take();
  }
} return void;
