// A mouse event of kind vwi_kind (3 press, 4 release, 5 move) goes to the page area when it is a press in it or part of a drag that began there (cv_mouse), and otherwise to the scrollbar, which follows a drag or an arrow or a press in its track; what the scrollbar moved becomes the viewer's scroll.
vw_mouse(View vwv, int vwi_kind, int[] vwl_ev) {
  int vwi_c = cv_mouse(vwv, vwi_kind, vwl_ev);
  int vwi_bits = 0;
  if(vwi_c == 0) {
    vwi_bits = gui_scroll_event((import vw_sb), vwi_kind, vwl_ev);
  }
} chain (View vwv, int vwi_kind, int[] vwl_ev) {
  if((vwi_bits & 2) != 0) {
    vw_bar_take();
  }
} return void;
