// Moves the page area by whole notches: vwi_nx sideways and vwi_ny down, each vw_wheel_px pixels.
vw_pan(View vwv, int vwi_nx, int vwi_ny, int vwi_ch, int vwi_cw) {
  vw_scroll(vwv, vwi_ny * (import vw_wheel_px), vwi_ch);
  vw_scroll_x(vwv, vwi_nx * (import vw_wheel_px), vwi_cw);
} return void;
