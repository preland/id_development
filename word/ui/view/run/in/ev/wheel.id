// Scrolls the sheets sideways by vwi_dx pixels (right positive) when they are wider than the page area (vwi_cw pixels wide), never before the left edge or past the right one; the picture is stale when that moved them.
vw_scroll_x(View vwv, int vwi_dx, int vwi_cw) {
  int[] vwl_st = (import vw_st);
  int vwi_z = vwl_st[(import vw_s_z)];
  int vwi_w = vw_px(lay_sheet(vwv.doc, 0), vwi_z);
} chain (View vwv, int vwi_dx, int vwi_cw) {
  int vwi_g = vw_px((import word_lay_gap), vwi_z);
  int vwi_m = fx_max(vwi_w + 2 * vwi_g - vwi_cw, 0);
  int vwi_x = fx_clamp(vwl_st[(import vw_s_x)] + vwi_dx, 0, vwi_m);
} chain (View vwv, int vwi_dx, int vwi_cw) {
  if(vwi_x != vwl_st[(import vw_s_x)]) {
    lset(vwl_st, (import vw_s_x), vwi_x);
    lset(vwl_st, (import vw_s_d), 1);
  }
} return void;
