// What a turn of the wheel does, for a page area vwi_ch tall and vwi_cw wide: with Ctrl it zooms by a step a notch (away from you zooms in), with Shift it scrolls sideways, else it scrolls the page area by vw_wheel_px a notch, down positive (vwi_dx is the sideways notches, vwi_dy the vertical ones).
vw_wheel(View vwv, int vwi_dx, int vwi_dy, int vwi_mods, int vwi_ch, int vwi_cw) {
  int[] vwl_st = (import vw_st);
  int vwi_z = vwl_st[(import vw_s_z)];
  int vwi_sh = (vwi_mods & 1) != 0;
} chain (View vwv, int vwi_dx, int vwi_dy, int vwi_mods, int vwi_ch, int vwi_cw) {
  if((vwi_mods & 2) != 0) {
    vw_zoom(vwv, vwi_z - vwi_dy * (import vw_zoom_step), vwi_ch);
  } else {
    vw_pan(vwv, vwi_dx + vwi_dy * vwi_sh, vwi_dy * (1 - vwi_sh), vwi_ch, vwi_cw);
  }
} return void;
