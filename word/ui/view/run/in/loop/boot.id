// Starts the viewer on the document at the path in a surface vwi_w by vwi_h: the faces for its own text (regular, bold, italic), the surface, the chrome, the state, the document, the ribbon and the scrollbar, everything fitted to the surface. Answers odt_load's code, 0 when the document opened.
vw_boot(string vws_path, int vwi_w, int vwi_h, int vwi_r, int vwi_b, int vwi_i) {
  rbd_ui_set(vwi_r, vwi_b, vwi_i);
  sf_l_init(vwi_w, vwi_h);
  string vws_diag = vw_make();
} chain (string vws_path, int vwi_w, int vwi_h, int vwi_r, int vwi_b, int vwi_i) {
  vw_state_new();
  int vwi_code = vw_open(vws_path);
  vw_rib_make();
} chain (string vws_path, int vwi_w, int vwi_h, int vwi_r, int vwi_b, int vwi_i) {
  vw_bar_new();
  vw_fit_all((import vw_v));
} return int vwi_code;
