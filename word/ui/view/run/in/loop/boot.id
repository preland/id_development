// Test setup: the viewer started on the document at the path in a surface w by h, with the font file's regular, bold and italic faces for its own text so the picture does not depend on the machine's fonts.
vw_t_boot(string vws_path, int vwi_w, int vwi_h) {
  gui_font_init();
  int vwi_r = gui_face_file("../editor/test_assets/LiberationSans-Regular.ttf", 13, 0);
  int vwi_b = gui_face_file("../editor/test_assets/LiberationSans-Regular.ttf", 13, 1);
} chain (string vws_path, int vwi_w, int vwi_h) {
  int vwi_i = gui_face_file("../editor/test_assets/LiberationSans-Regular.ttf", 13, 2);
  int vwi_code = vw_boot(vws_path, vwi_w, vwi_h, vwi_r, vwi_b, vwi_i);
} return void;
