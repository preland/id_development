// Runs frames until the window asks to close or vwi_max frames have been run (a negative vwi_max is no limit), and answers how many ran. A window that never opened (vwi_ok 0) runs none.
vw_loop(int vwi_ok, int vwi_max) {
  int vwi_n = 0;
  int vwi_q = vwi_ok == 0;
  while(vwi_q == 0 && vwi_n != vwi_max) {
    vwi_q = vw_tick((import vw_v));
    vwi_n = vwi_n + 1;
  }
} return int vwi_n;
