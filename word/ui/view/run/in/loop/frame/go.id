// Shows the document at the path in a window until the window is closed: the window (opened only when vwi_open is 1, so that a case can run everything else without one), the faces the viewer sets its own text in (the machine's sans-serif), the viewer started on the document, the window's title, the frames. Answers 0.
vw_main(string vws_path, int vwi_open) {
  gui_font_init();
  int vwi_ok = vwi_open;
  int vwi_r = gui_face("sans-serif", 13, 0);
} chain (string vws_path, int vwi_open) {
  if(vwi_open == 1) {
    vwi_ok = gfx_open(1180, 780, "Word");
  }
  int vwi_b = gui_face("sans-serif", 13, 1);
  int vwi_i = gui_face("sans-serif", 13, 2);
} chain (string vws_path, int vwi_open) {
  int vwi_code = vw_boot(vws_path, 1180, 780, vwi_r, vwi_b, vwi_i);
  int vwi_t = gfx_title(vw_title(vws_path));
  int vwi_n = vw_loop(vwi_ok * vwi_open, 0 - 1);
} chain (string vws_path, int vwi_open) {
  int vwi_s = gfx_close();
} return int 0;
