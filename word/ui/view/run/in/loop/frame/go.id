// The title of the window for the document at the path: its file name, then the program.
vw_title(string vws_path) {
  int vwi_at = len(vws_path) - 1;
  while(vwi_at >= 0 && charat(vws_path, vwi_at) != 47) {
    vwi_at = vwi_at - 1;
  }
  string vws_t = str_slice(vws_path, vwi_at + 1, len(vws_path) - vwi_at - 1) + " - Word";
} return string vws_t;
