// Takes every event the window has waiting, one at a time, and answers 1 as soon as one asks to quit (the rest stay waiting), else 0.
vw_events(View vwv) {
  int[] vwl_ev = [0, 0, 0, 0, 0];
  int vwi_kind = gfx_event(vwl_ev);
  int vwi_q = 0;
} chain (View vwv) {
  while(vwi_kind != 0 && vwi_q == 0) {
    vwi_q = vw_on(vwv, vwi_kind, vwl_ev);
    vwi_kind = gfx_event(vwl_ev);
  }
} return int vwi_q;
