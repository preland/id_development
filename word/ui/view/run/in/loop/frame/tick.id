// One frame: the surface is fitted to the window, the waiting events are taken, and the picture painted when it is stale and nobody asked to quit. Answers 1 when the window should close.
vw_tick(View vwv) {
  int vwi_ch = gfx_sync();
  if(vwi_ch == 1) {
    vw_fit_all(vwv);
  }
  int vwi_q = vw_events(vwv);
} chain (View vwv) {
  vw_paint(vwv, vwi_q);
  sleep_ms(1);
} return int vwi_q;
