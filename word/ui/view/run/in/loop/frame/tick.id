// One event of the window, of kind vwi_kind with the fields vwl_ev: answers 1 when it asks to quit (the window closing, or the key that quits). A key is the keyboard's business, a wheel notch scrolls or zooms, the mouse goes to the scrollbar, and a resize makes the picture stale (the surface is fitted at the start of the next frame).
vw_on(View vwv, int vwi_kind, int[] vwl_ev) {
  int vwi_ch = vw_box("canvas", 3);
  int vwi_q = vwi_kind == 7;
  if(vwi_kind == 1) {
    vwi_q = vw_key(vwv, vwl_ev[1], vwl_ev[2], vwi_ch);
  }
} chain (View vwv, int vwi_kind, int[] vwl_ev) {
  if(vwi_kind == 8) {
    vw_wheel(vwv, vwl_ev[1], vwl_ev[2], gfx_mods(), vwi_ch, vw_box("canvas", 2));
  }
  if(vwi_kind >= 3 && vwi_kind <= 5) {
    vw_mouse(vwi_kind, vwl_ev);
  }
  if(vwi_kind == 6) {
    lset((import vw_st), (import vw_s_d), 1);
  }
} return int vwi_q;
