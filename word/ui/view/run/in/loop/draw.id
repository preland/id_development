// Paints the card with the message that took a document's place, in the middle of the page area; nothing when the viewer has a document.
vw_note() {
  string vws_m = (import vw_msg)[0];
  int vwi_x = vw_box("canvas", 0);
  int vwi_y = vw_box("canvas", 1);
} chain () {
  if(len(vws_m) > 0) {
    vw_card(vws_m, vwi_x, vwi_y, vw_box("canvas", 2), vw_box("canvas", 3));
  }
} return void;
