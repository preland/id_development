// Paints the whole window: the scrollbar is first brought to where the viewer stands (a key or the wheel moved it), then the page area, the scrollbar, the status bar and the ribbon, and a card that says why there is no document when there is none to show.
vw_draw_all(View vwv) {
  vw_bar_fit(vwv);
  vw_canvas(vwv);
  gui_scroll_draw((import vw_sb));
} chain (View vwv) {
  vw_status(vwv);
  rib_draw((import vw_rb));
  vw_note();
} return void;
