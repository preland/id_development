// The part of the rows cvi_y to cvi_y + cvi_h - 1 that lies in the band of rows cvi_c0 to cvi_c1 - 1, as [first row, how many], with none (how many 0) when they do not meet.
cv_span(int cvi_y, int cvi_h, int cvi_c0, int cvi_c1) {
  int cvi_a = fx_max(cvi_y, cvi_c0);
  int cvi_b = fx_min(cvi_y + cvi_h, cvi_c1);
  int[] cvl_s = [cvi_a, fx_max(cvi_b - cvi_a, 0)];
} return int[] cvl_s;
(10, 20, 0, 100):([10, 20])
