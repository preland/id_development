// A sheet of paper at (x, y), w by h pixels, over the desk: its shadow first, offset down and right and blended over what is there, then the white sheet.
vw_sheet(int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  int vwi_o = (import vw_shadow_off);
  d2_l_arect(vwi_x + vwi_o, vwi_y + vwi_o, vwi_w, vwi_h, 0, (import vw_shadow_a));
  d2_l_rect(vwi_x, vwi_y, vwi_w, vwi_h, (import vw_c_sheet));
} return void;
