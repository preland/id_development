// Test setup: remembers the pixel (x, y) that vw_t_px reads.
vw_t_at(int vwi_x, int vwi_y) {
  export int[] vw_t_pt = [vwi_x, vwi_y];
} return void;
(3, 4):() then vw_t_pt_dump:("3,4,")
(0, 0):() then vw_t_pt_dump:("0,0,")

// Test check: the remembered pixel as vw_t_at stored it.
vw_t_pt_dump() {
  string vws_z = dump_ints((import vw_t_pt));
} return string vws_z;
given vw_t_at(1, 2) ():("1,2,")
given vw_t_at(9, 0) ():("9,0,")

// Test check: the colour of the remembered pixel on the list surface.
vw_t_px() {
  int[] vwl_p = (import vw_t_pt);
  int vwi_c = lget((import sf_l_px), sf_l_idx(vwl_p[0], vwl_p[1]));
} return int vwi_c;
given sf_l_init(4, 4) given d2_l_rect(0, 0, 4, 4, 7) given vw_t_at(1, 1) ():(7)
given sf_l_init(4, 4) given vw_t_at(2, 2) ():(0)
