// Fills the ink of the look list vwl_q for run vwi_ri of paragraph vwi_p: its colour (black when nothing sets one, the link colour inside a hyperlink), its highlight (-1 for none) and its flag bits (a hyperlink is underlined).
vw_ink(View vwv, int vwi_p, int vwi_ri, int[] vwl_q) {
  Para vwp = vwv.doc.body.paras[vwi_p];
  int vwi_ps = tab_get(vwv.doc.fmt.paras, vwp.pprop, (import word_p_style));
  int vwi_cr = vwp.txt.runs[vwi_ri].cprop;
} chain (View vwv, int vwi_p, int vwi_ri, int[] vwl_q) {
  int vwi_col = style_eff_c(vwv.doc.fmt, vwi_ps, vwi_cr, (import word_c_color));
  int vwi_hl = style_eff_c(vwv.doc.fmt, vwi_ps, vwi_cr, (import word_c_hl));
  int vwi_bits = style_eff_c(vwv.doc.fmt, vwi_ps, vwi_cr, (import word_c_on));
} chain (View vwv, int vwi_p, int vwi_ri, int[] vwl_q) {
  if(vwi_col < 0) {
    vwi_col = 0;
  }
  if(vwp.txt.runs[vwi_ri].link >= 0) {
    vwi_col = (import vw_c_link);
    vwi_bits = vwi_bits | 4;
  }
  lset(vwl_q, (import vw_q_col), vwi_col);
} chain (View vwv, int vwi_p, int vwi_ri, int[] vwl_q) {
  lset(vwl_q, (import vw_q_hl), vwi_hl);
  lset(vwl_q, (import vw_q_bits), vwi_bits);
} return void;
