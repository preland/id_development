// Fills the face and the metrics of the look list vwl_q for run vwi_ri of paragraph vwi_p at zoom vwi_z percent: the face (the face cache's, at that zoom) and its ascent and descent in pixels.
vw_look(View vwv, int vwi_p, int vwi_ri, int vwi_z, int[] vwl_q) {
  Para vwp = vwv.doc.body.paras[vwi_p];
  int vwi_ps = tab_get(vwv.doc.fmt.paras, vwp.pprop, (import word_p_style));
  int vwi_fh = face_for(vwv.faces, vwv.doc, vwi_ps, vwp.txt.runs[vwi_ri].cprop, vwi_z);
} chain (View vwv, int vwi_p, int vwi_ri, int vwi_z, int[] vwl_q) {
  int vwi_a = gui_font_ascent(vwi_fh);
  int vwi_d = gui_font_descent(vwi_fh);
  lset(vwl_q, (import vw_q_fh), vwi_fh);
} chain (View vwv, int vwi_p, int vwi_ri, int vwi_z, int[] vwl_q) {
  lset(vwl_q, (import vw_q_asc), vwi_a);
  lset(vwl_q, (import vw_q_desc), vwi_d);
} return void;
