// Draws one code point if it has a glyph: its pen position (lu from the left of the text area) is placed on the page at the page's zoom, in 64ths of a pixel, and the glyph is drawn there on the baseline vwi_base in the look's face and colour.
vw_glyph(int[] vwl_g, int[] vwl_q, int vwi_cp, int vwi_pen, int vwi_base) {
  int vwi_ok = vw_ok(vwi_cp);
  int vwi_x = vwl_g[(import vw_g_x)] * 64 + vw_x64(vwl_g[(import vw_g_l)] + vwi_pen, vwl_g[(import vw_g_z)]);
  if(vwi_ok == 1) {
    gui_cp_draw(vwl_q[(import vw_q_fh)], vwi_x, vwi_base, vwi_cp, vwl_q[(import vw_q_col)]);
  }
} return void;
