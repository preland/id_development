// Test check: how many pixels of one row, from vwi_x0 to vwi_x1 - 1 at vwi_y, are not the colour vwi_bg on the list surface.
vw_t_row(int vwi_x0, int vwi_x1, int vwi_y, int vwi_bg) {
  int vwi_n = 0;
  int vwi_x = vwi_x0;
  while(vwi_x < vwi_x1) {
    vwi_n = vwi_n + (lget((import sf_l_px), sf_l_idx(vwi_x, vwi_y)) != vwi_bg);
    vwi_x = vwi_x + 1;
  }
} return int vwi_n;
