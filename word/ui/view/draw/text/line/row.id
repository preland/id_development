// The baseline of line vwi_j of paragraph vwi_p in pixels on the surface, when the paragraph's own top is vwi_base lu down the page: the margin, the paragraph's top, the line's y and its ascent down the sheet, at the page's zoom.
// By hand: a 16 px line has its baseline 14 px (896 lu) below its top; on a sheet at y 16 that is 30, and a paragraph 1600 lu (25 px) further down puts it at 55.
vw_bline(View vwv, int vwi_p, int[] vwl_g, int vwi_base, int vwi_j) {
  int[] vwl_ln = vwv.doc.body.paras[vwi_p].lay.lines;
  int vwi_o = vwi_j * (import word_ln_stride);
  int vwi_d = vwl_g[(import vw_g_t)] + vwi_base + vwl_ln[vwi_o + (import word_ln_y)] + vwl_ln[vwi_o + (import word_ln_asc)];
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_base, int vwi_j) {
  int vwi_b = vwl_g[(import vw_g_y)] + vw_px(vwi_d, vwl_g[(import vw_g_z)]);
} return int vwi_b;
