// Paints the runs of line vwi_j of paragraph vwi_p on the baseline vwi_b, run by run while they start before the end of the line.
vw_runs(View vwv, int vwi_p, int[] vwl_g, int vwi_j, int vwi_b) {
  Para vwp = vwv.doc.body.paras[vwi_p];
  int vwi_hi = vwp.lay.lines[vwi_j * (import word_ln_stride) + (import word_ln_hi)];
  int vwi_ri = 0;
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_j, int vwi_b) {
  int vwi_rs = 0;
  while(vwi_ri < len(vwp.txt.runs) && vwi_rs < vwi_hi) {
    vwi_rs = vw_run(vwv, vwi_p, vwl_g, vwi_j, vwi_ri, vwi_rs, vwi_b);
    vwi_ri = vwi_ri + 1;
  }
} return void;
