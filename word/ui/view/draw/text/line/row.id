given lp_t_font given lp_t_ins(0, "A") given lay_all((import lp_t_v)) ((import lp_t_v), 0, [0, 16, 100, 0, 0], 1600, 0):(55)

// Paints line vwi_j of paragraph vwi_p, whose own top is vwi_base lu down the page, on the baseline vw_bline gives it.
vw_line(View vwv, int vwi_p, int[] vwl_g, int vwi_base, int vwi_j) {
  int vwi_b = vw_bline(vwv, vwi_p, vwl_g, vwi_base, vwi_j);
  vw_runs(vwv, vwi_p, vwl_g, vwi_j, vwi_b);
} return void;
