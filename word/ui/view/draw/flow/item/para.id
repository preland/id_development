// Draws lines vwi_jf to vwi_jt - 1 of paragraph vwi_p, one after the other.
vw_lines(View vwv, int vwi_p, int[] vwl_g, int vwi_base, int vwi_jf, int vwi_jt) {
  int vwi_j = vwi_jf;
  while(vwi_j < vwi_jt) {
    vw_line(vwv, vwi_p, vwl_g, vwi_base, vwi_j);
    vwi_j = vwi_j + 1;
  }
} return void;
