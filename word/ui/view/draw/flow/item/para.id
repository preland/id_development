// Draws lines vwi_jf to vwi_jt - 1 of paragraph vwi_p, whose own top is vwi_base lu down the page: an object as its box (when its one line is on this page), a list item's label before its first line, then the lines.
vw_para(View vwv, int vwi_p, int[] vwl_g, int vwi_base, int vwi_jf, int vwi_jt) {
  int vwi_o = lay_is_obj(vwv.doc, vwi_p);
  if(vwi_o == 1 && vwi_jf == 0) {
    vw_obj(vwv, vwi_p, vwl_g, vwi_base);
  }
  if(vwi_o == 0 && vwi_jf == 0) {
    vw_label(vwv, vwi_p, vwl_g, vwi_base);
  }
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_base, int vwi_jf, int vwi_jt) {
  if(vwi_o == 0) {
    vw_lines(vwv, vwi_p, vwl_g, vwi_base, vwi_jf, vwi_jt);
  }
} return void;
