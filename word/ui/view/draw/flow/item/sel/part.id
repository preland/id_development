// Paints the part of the picture that the band of rows asked for (vw_ed) needs and no more: the page area in the band, and the status bar, whose page and word count an edit changes. The band is then empty again.
cv_part(View cvv) {
  int[] cvl_e = (import vw_ed);
  int[] cvl_r = [0, 0, 0, 0, 0, 0];
  cv_rows(cvl_e[(import cv_e_y0)], cvl_e[(import cv_e_y1)], cvl_r);
} chain (View cvv) {
  cv_area(cvv, cvl_r);
  vw_status(cvv);
  lset(cvl_e, (import cv_e_y0), 0 - 1);
} chain (View cvv) {
  lset(cvl_e, (import cv_e_y1), 0 - 1);
} return void;
