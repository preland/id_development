// Makes cvl_r the area list of the page area for a repaint of rows cvi_y0 to cvi_y1 - 1 of the surface: the page area's rectangle from the chrome, and the band cut to lie inside it (nothing, with its two rows equal, when they miss it). The caller makes the six-cell list, so that it is its own and is freed with it.
cv_rows(int cvi_y0, int cvi_y1, int[] cvl_r) {
  int cvi_cy = vw_box("canvas", 1);
  int cvi_ch = vw_box("canvas", 3);
  int cvi_a = fx_clamp(cvi_y0, cvi_cy, cvi_cy + cvi_ch);
} chain (int cvi_y0, int cvi_y1, int[] cvl_r) {
  int cvi_b = fx_clamp(cvi_y1, cvi_a, cvi_cy + cvi_ch);
  lset(cvl_r, 0, vw_box("canvas", 0));
  lset(cvl_r, 1, cvi_cy);
} chain (int cvi_y0, int cvi_y1, int[] cvl_r) {
  lset(cvl_r, 2, vw_box("canvas", 2));
  lset(cvl_r, 3, cvi_ch);
  lset(cvl_r, 4, cvi_a);
} chain (int cvi_y0, int cvi_y1, int[] cvl_r) {
  lset(cvl_r, 5, cvi_b);
} return void;
