// Paints the caret of the controller if it is on page cvi_k (whose geometry is cvl_g) and in the solid half of its blink.
cv_caret_page(View cvv, int cvi_k, int[] cvl_g) {
  int[] cvl_o = [0, 0, 0, 0];
  cv_where(cvv, cvl_o);
  if(cvl_o[0] == cvi_k && cv_on() == 1) {
    cv_bar(cvl_o, cvl_g);
  }
} return void;
