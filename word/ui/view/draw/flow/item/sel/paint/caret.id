// Paints what lies over the text of page cvi_k, whose geometry is cvl_g: the selection, then the caret.
cv_over(View cvv, int cvi_k, int[] cvl_g) {
  cv_sel_page(cvv, cvi_k, cvl_g);
  cv_caret_page(cvv, cvi_k, cvl_g);
} return void;
