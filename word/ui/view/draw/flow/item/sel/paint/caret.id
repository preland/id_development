// Paints the caret as a bar one pixel wide and as tall as its line, at the pixel the pen of its code point is on, the page's geometry cvl_g and the caret's [page, x, y, height] cvl_o in lu from the top left of the sheet.
cv_bar(int[] cvl_o, int[] cvl_g) {
  int cvi_z = cvl_g[(import vw_g_z)];
  int cvi_x = cvl_g[(import vw_g_x)] + vw_px(cvl_o[1], cvi_z);
  int cvi_y = cvl_g[(import vw_g_y)] + vw_px(cvl_o[2], cvi_z);
} chain (int[] cvl_o, int[] cvl_g) {
  int cvi_h = fixed_point_maximum(vw_px(cvl_o[3], cvi_z), 1);
  d2_l_rect(cvi_x, cvi_y, 1, cvi_h, (import cv_c_caret));
} return void;
given sf_l_init(40, 40) given d2_l_rect(0, 0, 40, 40, 16777215) given vw_t_at(10, 25) ([0, 640, 1280, 1088], [0, 0, 100, 0, 0]):() then vw_t_px:(0)
