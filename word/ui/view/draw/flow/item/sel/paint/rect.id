// Paints the selection of the controller on page cvi_k, whose geometry is cvl_g: a rectangle for each line of the page that it covers, as the layout's lay_sel_rects gives them.
cv_sel_page(View cvv, int cvi_k, int[] cvl_g) {
  Ctl cvc = (import vw_ctl);
  int[] cvl_o = [];
  int cvi_n = lay_sel_rects(cvv, cvc.sel, cvi_k, cvl_o);
} chain (View cvv, int cvi_k, int[] cvl_g) {
  cv_rects(cvl_o, cvi_n, cvl_g);
} return void;
