// Paints rectangle cvi_k of the flat list cvl_o ([x, y, width, height] each in lu from the top left of the sheet) on the page whose geometry is cvl_g, in the selection's colour with its coverage, so that the text under it shows through. The corners are rounded to pixels as the text is, and it is at least one pixel in each direction.
cv_rect(int[] cvl_o, int cvi_k, int[] cvl_g) {
  int cvi_z = cvl_g[(import vw_g_z)];
  int cvi_x = cvl_g[(import vw_g_x)] + vw_px(cvl_o[4 * cvi_k], cvi_z);
  int cvi_y = cvl_g[(import vw_g_y)] + vw_px(cvl_o[4 * cvi_k + 1], cvi_z);
} chain (int[] cvl_o, int cvi_k, int[] cvl_g) {
  int cvi_r = cvl_g[(import vw_g_x)] + vw_px(cvl_o[4 * cvi_k] + cvl_o[4 * cvi_k + 2], cvi_z);
  int cvi_b = cvl_g[(import vw_g_y)] + vw_px(cvl_o[4 * cvi_k + 1] + cvl_o[4 * cvi_k + 3], cvi_z);
  int cvi_w = fixed_point_maximum(cvi_r - cvi_x, 1);
} chain (int[] cvl_o, int cvi_k, int[] cvl_g) {
  d2_l_arect(cvi_x, cvi_y, cvi_w, fixed_point_maximum(cvi_b - cvi_y, 1), (import cv_c_sel), (import cv_sel_a));
} return void;
