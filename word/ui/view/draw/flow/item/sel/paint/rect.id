// Paints the rectangles cvl_o holds (cvi_n of them) one after another on the page whose geometry is cvl_g.
cv_rects(int[] cvl_o, int cvi_n, int[] cvl_g) {
  int cvi_k = 0;
  while(cvi_k < cvi_n) {
    cv_rect(cvl_o, cvi_k, cvl_g);
    cvi_k = cvi_k + 1;
  }
} return void;
