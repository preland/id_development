// Test setup: the test document holds one part, an element of the given name, that the marker of paragraph 0 stands for.
vw_t_part(string vws_n) {
  Doc vwd = (import lp_t_d);
  Part vwpt = Part(vws_n, [60, 120, 47, 62], 0);
  push(vwd.ext.parts, vwpt);
} return void;
given lp_t_new ("a"):() then vw_t_np:(1)
