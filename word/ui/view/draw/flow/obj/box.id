// Writes the label of object paragraph vwi_p centred in the box at (vwi_x, vwi_y), vwi_w by vwi_h, in the viewer's own face.
vw_tag(Doc vwd, int vwi_p, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  string vws_l = vw_obj_label(vwd, vwi_p);
  int vwi_f = (import rbd_ui)[0];
  int vwi_tw = gui_text_width(vwi_f, vws_l);
} chain (Doc vwd, int vwi_p, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  int vwi_th = gui_font_line(vwi_f);
  gui_text_draw(vwi_f, vwi_x + (vwi_w - vwi_tw) / 2, vwi_y + (vwi_h - vwi_th) / 2, vws_l, (import vw_c_label));
} return void;
