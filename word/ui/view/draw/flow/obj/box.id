// Draws the box that stands for object paragraph vwi_p, whose own top is vwi_base lu down the page: the width of the text area and word_lay_obj high, edged and filled, and the object's label centred in it.
vw_obj(View vwv, int vwi_p, int[] vwl_g, int vwi_base) {
  int vwi_z = vwl_g[(import vw_g_z)];
  int vwi_x = vwl_g[(import vw_g_x)] + vw_px(vwl_g[(import vw_g_l)], vwi_z);
  int vwi_y = vwl_g[(import vw_g_y)] + vw_px(vwl_g[(import vw_g_t)] + vwi_base + vwv.doc.body.paras[vwi_p].lay.lines[(import word_ln_y)], vwi_z);
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_base) {
  int vwi_w = vw_px(lay_area(vwv.doc, 0), vwi_z);
  int vwi_h = vw_px(lay_obj_h(vwv.doc, vwi_p), vwi_z);
  d2_l_rect(vwi_x, vwi_y, vwi_w, vwi_h, (import vw_c_edge));
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_base) {
  d2_l_rect(vwi_x + 1, vwi_y + 1, vwi_w - 2, vwi_h - 2, (import vw_c_obj));
  vw_tag(vwv.doc, vwi_p, vwi_x, vwi_y, vwi_w, vwi_h);
} return void;
