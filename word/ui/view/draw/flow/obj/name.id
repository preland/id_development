// What an object is called in its box, from the element that holds it (vw_obj_names): "Image" for a picture frame, "Object" for any element it does not know.
vw_part_label(string vws_n) {
  int vwi_k = lst_str_index((import vw_obj_names), vws_n);
  string vws_l = "Object";
  if(vwi_k >= 0) {
    vws_l = (import vw_obj_labels)[vwi_k];
  }
} return string vws_l;
("draw:frame"):("Image")
("text:note"):("Note")
("table:table"):("Object")

// The label of an object paragraph: for a block it is the label the reader wrote after the marker without its brackets ("[Table]" is "Table"), for a picture on a line of its own the label of the part its marker stands for.
vw_obj_label(Doc vwd, int vwi_p) {
  int[] vwl_c = vwd.body.paras[vwi_p].txt.cps;
  int vwi_i = vwl_c[0] - (import word_o_marker);
  string vws_l = vw_cps_text(vwl_c, 1);
} chain (Doc vwd, int vwi_p) {
  if(len(vwl_c) == 1 && vwi_i < len(vwd.ext.parts)) {
    vws_l = vw_part_label(vwd.ext.parts[vwi_i].name);
  }
  if(len(vws_l) > 2 && charat(vws_l, 0) == 91) {
    vws_l = str_slice(vws_l, 1, len(vws_l) - 2);
  }
} return string vws_l;
given lp_t_new given lg_t_mark(0) given lp_t_ins(0, "[Table]") ((import lp_t_d), 0):("Table")
given lp_t_new given lg_t_mark(0) given vw_t_part("draw:frame") ((import lp_t_d), 0):("Image")
given lp_t_new given lg_t_mark(0) given vw_t_part("x") ((import lp_t_d), 0):("Object")

// The code points of a list from index vwi_from on, as a string: the text of an object paragraph after its marker.
vw_cps_text(int[] vwl_c, int vwi_from) {
  string vws_t = "";
  int vwi_k = vwi_from;
  while(vwi_k < len(vwl_c)) {
    vws_t = vws_t + utf8_str(vwl_c[vwi_k]);
    vwi_k = vwi_k + 1;
  }
} return string vws_t;
([983040, 65, 66], 1):("AB")
([65, 233], 0):("Aé")
