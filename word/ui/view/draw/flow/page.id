// Draws page vwi_k of the view on the sheet whose geometry is vwl_g: the paragraphs that start on the page and the ones that go on over it, the lines of each that Pages put there.
vw_page(View vwv, int vwi_k, int[] vwl_g) {
  int vwi_p = vwv.pages.starts[2 * vwi_k];
  int vwi_p1 = vwv.pages.starts[2 * vwi_k + 2];
  int vwi_l1 = vwv.pages.starts[2 * vwi_k + 3];
} chain (View vwv, int vwi_k, int[] vwl_g) {
  int vwi_e = vwi_p1 + (vwi_l1 > 0);
  while(vwi_p < vwi_e && vwi_p < len(vwv.doc.body.paras)) {
    vw_pone(vwv, vwi_k, vwi_p, vwl_g);
    vwi_p = vwi_p + 1;
  }
} return void;
