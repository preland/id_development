// Draws the lines of paragraph vwi_p that belong on page vwi_k: from the line the page starts at when the paragraph carries on from the page before, to the line the next page starts at when the paragraph goes on after it, else all of them.
vw_pone(View vwv, int vwi_k, int vwi_p, int[] vwl_g) {
  int vwi_jf = 0;
  int vwi_jt = len(vwv.doc.body.paras[vwi_p].lay.lines) / (import word_ln_stride);
  if(vwi_p == vwv.pages.starts[2 * vwi_k]) {
    vwi_jf = vwv.pages.starts[2 * vwi_k + 1];
  }
} chain (View vwv, int vwi_k, int vwi_p, int[] vwl_g) {
  if(vwi_p == vwv.pages.starts[2 * vwi_k + 2]) {
    vwi_jt = vwv.pages.starts[2 * vwi_k + 3];
  }
  int vwi_b = vw_base(vwv, vwi_k, vwi_p);
  vw_para(vwv, vwi_p, vwl_g, vwi_b, vwi_jf, vwi_jt);
} return void;
