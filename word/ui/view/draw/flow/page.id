} chain (View vwv, int vwi_k, int vwi_p) {
  if(vwi_p == vwi_st && vwi_s > 0) {
    vwi_b = 0 - vwv.doc.body.paras[vwi_p].lay.lines[vwi_s * (import word_ln_stride) + (import word_ln_y)];
  }
} return int vwi_b;
