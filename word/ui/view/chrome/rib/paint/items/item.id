// Paints every item of the ribbon, one after the other.
vw_rib_items() {
  int vwi_i = 0;
  while(vwi_i < len((import vw_rb).items)) {
    vw_rib_item(vwi_i);
    vwi_i = vwi_i + 1;
  }
} return void;
