// Paints item vwi_i (row vwi_row of the ribbon tables) as a button that cannot be used: the A5a button in its disabled look, its icon, and under the icon the name of a large button.
vw_rib_press(int vwi_i, int vwi_row) {
  GuiButton vwbt = (import vw_bt)[vwi_i];
  gui_btn_draw(vwbt);
  vw_rib_icon(vwi_row, vwbt.v[0], vwbt.v[1], vwbt.v[2], vwbt.v[3]);
} return void;
