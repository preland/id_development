// Paints item vwi_i of the ribbon: a combo box or a gallery as a field with its label, any other control as a disabled button with its icon.
vw_rib_item(int vwi_i) {
  int vwi_row = (import vw_rb).items[vwi_i];
  int vwi_kind = (import rb_kind)[vwi_row];
  int vwi_fld = vwi_kind == (import kind_combo) || vwi_kind == (import kind_gallery);
} chain (int vwi_i) {
  if(vwi_fld == 1) {
    vw_rib_field(vwi_i, vwi_row);
  }
  if(vwi_fld == 0) {
    vw_rib_press(vwi_i, vwi_row);
  }
} return void;
