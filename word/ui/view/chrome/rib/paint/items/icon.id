// Writes a letter icon: the code point vwi_cp centred on (vwi_cx, vwi_cy) in the viewer's face, bold for a B and italic for an I, with a line under a U, through an S and a red bar under an A, as Word draws them. Anything that is not a printable ASCII letter draws nothing.
vw_letter(int vwi_cp, int vwi_cx, int vwi_cy) {
  int vwi_f = vw_ui_f((vwi_cp == 66) + 2 * (vwi_cp == 73));
  int vwi_w = gui_cp_adv(vwi_f, vwi_cp, 0) / 64;
  int vwi_b = vwi_cy + (gui_font_ascent(vwi_f) - gui_font_descent(vwi_f)) / 2;
} chain (int vwi_cp, int vwi_cx, int vwi_cy) {
  if(vwi_cp > 32 && vwi_cp < 127) {
    gui_cp_draw(vwi_f, (vwi_cx - vwi_w / 2) * 64, vwi_b, vwi_cp, (import vw_c_icon));
    vw_marks_under(vwi_cp, vwi_cx - vwi_w / 2, vwi_w, vwi_b);
  }
} return void;
