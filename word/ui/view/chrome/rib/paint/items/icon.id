// Writes the name of a large button (one vwi_big says is large) centred along its bottom, in the dimmed colour. A small button has no room for one.
vw_big(int vwi_row, int vwi_x, int vwi_y, int vwi_w, int vwi_h, int vwi_big) {
  string vws_t = (import rb_label)[vwi_row];
  int vwi_f = vw_ui_f(0);
  int vwi_tw = gui_text_width(vwi_f, vws_t);
} chain (int vwi_row, int vwi_x, int vwi_y, int vwi_w, int vwi_h, int vwi_big) {
  if(vwi_big == 1) {
    gui_text_draw(vwi_f, vwi_x + (vwi_w - vwi_tw) / 2, vwi_y + vwi_h - gui_font_line(vwi_f) - 3, vws_t, (import vw_c_dim));
  }
} return void;
