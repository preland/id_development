// Paints the icon of item row vwi_row inside the button rectangle (vwi_x, vwi_y, vwi_w, vwi_h): a vector icon where the ribbon has one for the command, 24 px high centred near the top of a large button and 16 px centred in a small one, else the letter the model names; a large button also carries its name at the bottom.
vw_rib_icon(int vwi_row, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  int vwi_ic = (import rb_icon)[vwi_row];
  int vwi_big = vwi_h >= 48;
  int vwi_px = 16 + 8 * vwi_big;
} chain (int vwi_row, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  int vwi_ix = vwi_x + (vwi_w - vwi_px) / 2;
  int vwi_iy = vwi_y + 4 * vwi_big + (vwi_h - vwi_px) / 2 * (1 - vwi_big);
  int vwi_vec = lst_index_of((import ic_cmd), vwi_ic) >= 0;
} chain (int vwi_row, int vwi_x, int vwi_y, int vwi_w, int vwi_h) {
  if(vwi_vec == 1) {
    vec_icon(vwi_ic, vwi_px, (import vw_c_icon), vwi_ix, vwi_iy);
  }
  if(vwi_vec == 0) {
    vw_letter(vwi_ic, vwi_x + vwi_w / 2, vwi_y + vwi_h / 2);
  }
  vw_big(vwi_row, vwi_x, vwi_y, vwi_w, vwi_h, vwi_big);
} return void;
