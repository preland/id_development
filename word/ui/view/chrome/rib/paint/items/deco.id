// The mark that goes with a letter icon of width vwi_w at x vwi_x over the baseline vwi_b: a line under a U, a line through an S, a red bar under an A, nothing for any other letter.
vw_marks_under(int vwi_cp, int vwi_x, int vwi_w, int vwi_b) {
  if(vwi_cp == 85) {
    d2_l_rect(vwi_x, vwi_b + 2, vwi_w, 1, (import vw_c_icon));
  }
  if(vwi_cp == 83) {
    d2_l_rect(vwi_x, vwi_b - 4, vwi_w, 1, (import vw_c_icon));
  }
  if(vwi_cp == 65) {
    d2_l_rect(vwi_x, vwi_b + 3, vwi_w, 3, (import vw_c_red));
  }
} return void;
