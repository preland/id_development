// Paints the lines between the ribbon's groups and the names under them: the groups come after the items in the ribbon's rectangles, as x, y, width and height each.
vw_rib_groups() {
  int vwi_n = len((import vw_rb).rects) / 4 - len((import vw_rb).items);
  int vwi_g = 0;
  while(vwi_g < vwi_n) {
    vw_rib_group(vwi_g);
    vwi_g = vwi_g + 1;
  }
} return void;
