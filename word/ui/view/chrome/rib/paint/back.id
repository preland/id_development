// Writes the tab names along the tab strip whose top left is (vwi_x, vwi_y), one after the other.
vw_rib_tabs(int vwi_x, int vwi_y) {
  int vwi_k = 0;
  while(vwi_k < len((import vw_tabs))) {
    vw_rib_tab(vwi_k, vwi_x + 8 + vwi_k * 60, vwi_y);
    vwi_k = vwi_k + 1;
  }
} return void;
