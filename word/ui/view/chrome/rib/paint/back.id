// Writes tab number vwi_k at the strip position vwi_x (56 px wide) and vwi_y: its name centred, the open tab (Home) in bold with a line of the accent colour under it, the others in the dimmed colour.
vw_rib_tab(int vwi_k, int vwi_x, int vwi_y) {
  string vws_t = (import vw_tabs)[vwi_k];
  int vwi_open = vwi_k == 1;
  int vwi_f = vw_ui_f(vwi_open);
} chain (int vwi_k, int vwi_x, int vwi_y) {
  int vwi_tw = gui_text_width(vwi_f, vws_t);
  int vwi_ty = vwi_y + ((import vw_tab_px) - gui_font_line(vwi_f)) / 2;
  int vwi_c = (import vw_c_icon) + (1 - vwi_open) * ((import vw_c_dim) - (import vw_c_icon));
} chain (int vwi_k, int vwi_x, int vwi_y) {
  gui_text_draw(vwi_f, vwi_x + (56 - vwi_tw) / 2, vwi_ty, vws_t, vwi_c);
  if(vwi_open == 1) {
    d2_l_rect(vwi_x, vwi_y + (import vw_tab_px) - 3, 56, 3, (import vw_c_bar));
  }
} return void;
