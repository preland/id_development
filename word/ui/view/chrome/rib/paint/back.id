// Paints the ribbon band: its body colour over the rectangle the chrome gave it, the tab strip along its top in white, a line along its bottom, and the tabs on the strip.
vw_rib_back(int[] vwl_r) {
  d2_l_rect(vwl_r[0], vwl_r[1], vwl_r[2], vwl_r[3], (import vw_c_rib));
  d2_l_rect(vwl_r[0], vwl_r[1], vwl_r[2], (import vw_tab_px), (import vw_c_tabs));
  d2_l_rect(vwl_r[0], vwl_r[1] + vwl_r[3] - 1, vwl_r[2], 1, (import vw_c_sep));
} chain (int[] vwl_r) {
  vw_rib_tabs(vwl_r[0], vwl_r[1]);
} return void;
