// The ribbon band's rectangle from the chrome as a list: x, y, width, height.
vw_rib_rect() {
  int[] vwl_r = [vw_box("ribbon", 0), vw_box("ribbon", 1), vw_box("ribbon", 2), vw_box("ribbon", 3)];
} return int[] vwl_r;
