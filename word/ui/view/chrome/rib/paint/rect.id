// The group the ribbon item that starts at or after x (a group's left edge) belongs to, as its id in rb_group: the first item whose left is not left of x is the first item of that group, because the items come group by group.
vw_rib_gid(int vwi_x) {
  int[] vwl_r = (import vw_rb).rects;
  int vwi_i = 0;
  while(vwl_r[vwi_i * 4] < vwi_x) {
    vwi_i = vwi_i + 1;
  }
} chain (int vwi_x) {
  int vwi_g = (import rb_group)[(import vw_rb).items[vwi_i]];
} return int vwi_g;
