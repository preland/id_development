// Paints item vwi_i (row vwi_row of the ribbon tables) as a field: a white box with a border and the item's name at the left, in the dimmed colour of a control that cannot be used.
vw_rib_field(int vwi_i, int vwi_row) {
  int[] vwl_r = (import vw_rb).rects;
  int vwi_q = vwi_i * 4;
  int vwi_f = vw_ui_f(0);
} chain (int vwi_i, int vwi_row) {
  d2_l_rect(vwl_r[vwi_q], vwl_r[vwi_q + 1], vwl_r[vwi_q + 2], vwl_r[vwi_q + 3], (import vw_c_edge));
  d2_l_rect(vwl_r[vwi_q] + 1, vwl_r[vwi_q + 1] + 1, vwl_r[vwi_q + 2] - 2, vwl_r[vwi_q + 3] - 2, (import vw_c_field));
  sf_l_clip(vwl_r[vwi_q] + 1, vwl_r[vwi_q + 1] + 1, vwl_r[vwi_q + 2] - 2, vwl_r[vwi_q + 3] - 2);
} chain (int vwi_i, int vwi_row) {
  gui_text_draw(vwi_f, vwl_r[vwi_q] + 6, vwl_r[vwi_q + 1] + (vwl_r[vwi_q + 3] - gui_font_line(vwi_f)) / 2, (import rb_label)[vwi_row], (import vw_c_dim));
  sf_l_unclip();
} return void;
