// Once a frame: the tooltip's check, and what the selection looks like (vw_rib_look); the picture is stale when a tooltip has come on show or gone, or the ribbon was told something.
vw_rib_tick() {
  int vwi_t = rib_tick((import vw_rb));
  int vwi_l = vw_rib_look();
  if(vwi_t == 1 || vwi_l == 1) {
    lset((import vw_st), (import vw_s_d), 1);
  }
} return void;
