// Test check: the rectangle of the first item of the ribbon preview as x,y,w,h.
vw_t_rect() {
  int[] vwl_r = (import vw_rb).rects;
  string vws_z = vwl_r[0] + "," + vwl_r[1] + "," + vwl_r[2] + "," + vwl_r[3];
} return string vws_z;
given vw_t_up(800, 600) given vw_rib_make given vw_rib_fit ():("12,32,52,74")
given vw_t_up(1000, 600) given vw_rib_make given vw_rib_fit ():("12,32,52,74")

// Test check: the rectangle of the last button of the ribbon preview as x,y,w,h.
vw_t_lastrect() {
  GuiButton vwbt = (import vw_bt)[len((import vw_bt)) - 1];
  string vws_z = vwbt.v[0] + "," + vwbt.v[1] + "," + vwbt.v[2] + "," + vwbt.v[3];
} return string vws_z;
given vw_t_up(800, 600) given vw_rib_make given vw_rib_fit ():("724,80,64,24")
given vw_t_up(800, 600) given vw_rib_make given vw_rib_fit given vw_rib_btn(0) ():("12,32,52,74")
