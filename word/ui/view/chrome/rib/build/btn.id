// Makes the disabled button for item vwi_i of the ribbon, at the rectangle the item was placed at, with the item's icon and command and no label (the ribbon preview writes its own), and keeps it after the others in vw_bt.
vw_rib_btn(int vwi_i) {
  Ribbon vwrb = (import vw_rb);
  int vwi_row = vwrb.items[vwi_i];
  int vwi_q = vwi_i * 4;
} chain (int vwi_i) {
  GuiButton vwbt = gui_btn_new("", (import rb_icon)[vwi_row], (import rb_cmd)[vwi_row]);
  gui_btn_place(vwbt, vwrb.rects[vwi_q], vwrb.rects[vwi_q + 1], vwrb.rects[vwi_q + 2], vwrb.rects[vwi_q + 3]);
  gui_btn_enable(vwbt, 0);
} chain (int vwi_i) {
  push((import vw_bt), vwbt);
} return void;
