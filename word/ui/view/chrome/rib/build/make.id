// Puts the ribbon's items in the ribbon band the chrome gave it (below the tab strip, a margin in from the sides) and makes a disabled button for each at the place it got.
vw_rib_fit() {
  int[] vwl_r = vw_rib_rect();
  rib_place((import vw_rb), vwl_r[0] + 4, vwl_r[1] + (import vw_tab_px), vwl_r[2] - 8, vwl_r[3] - (import vw_tab_px));
  vw_rib_btns();
} return void;
