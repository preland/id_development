// The ribbon's Home tab for the preview: the model B7a builds for it, kept in the export vw_rb, an empty list of the buttons that stand for its items (vw_bt), and the vector icons registered once.
vw_rib_make() {
  export Ribbon vw_rb = rib_build((import rib_tab_home));
  export GuiButton[] vw_bt = [];
  vec_init();
} chain () {
  vec_load((import ic_cmd), (import ic_path));
} return void;
