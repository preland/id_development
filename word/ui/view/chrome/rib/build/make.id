// Makes one disabled button for every item of the ribbon, each at the rectangle the item got, replacing the old ones.
vw_rib_btns() {
  GuiButton[] vwl_bt = (import vw_bt);
  int vwi_i = 0;
  while(len(vwl_bt) > 0) {
    pop(vwl_bt);
  }
} chain () {
  while(vwi_i < len((import vw_rb).items)) {
    vw_rib_btn(vwi_i);
    vwi_i = vwi_i + 1;
  }
} return void;
