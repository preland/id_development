// Paints the whole ribbon preview: the band with its tab strip and tabs, the items, the lines and names of the groups.
vw_rib_draw() {
  int[] vwl_r = vw_rib_rect();
  vw_rib_back(vwl_r);
  vw_rib_items();
} chain () {
  vw_rib_groups();
} return void;
