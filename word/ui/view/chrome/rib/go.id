// What the viewer does for a command of the ribbon with its argument and name: the three zoom commands zoom the page area (vwi_arg and vws_name are not used by any of them), every other command is the canvas's, which does it to the document if it is one it does (cv_rib) and otherwise leaves everything as it is.
vw_cmd(View vwv, int vwi_cmd, int vwi_arg, string vws_name) {
  int vwi_z = (import vw_st)[(import vw_s_z)];
  int vwi_ch = vw_box("canvas", 3);
  if(vwi_cmd == (import cmd_zoom_in)) {
    vw_zoom(vwv, vwi_z + (import vw_zoom_step), vwi_ch);
  }
} chain (View vwv, int vwi_cmd, int vwi_arg, string vws_name) {
  if(vwi_cmd == (import cmd_zoom_out)) {
    vw_zoom(vwv, vwi_z - (import vw_zoom_step), vwi_ch);
  }
  if(vwi_cmd == (import cmd_zoom_100)) {
    vw_zoom(vwv, 100, vwi_ch);
  }
  cv_rib(vwv, vwi_cmd, vwi_arg, vws_name);
} return void;
