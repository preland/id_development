// One event of the window for the ribbon first: a mouse event, the wheel or a key goes to it, and the picture is stale when it asks to be painted again, its command is run, and answers 1 when the ribbon took the event, so that nothing else sees it (a press in its band, or any event while one of its menus is open).
vw_rib_event(View vwv, int vwi_kind, int[] vwl_ev) {
  int vwi_for = vwi_kind == 1 || vwi_kind == 2 || vwi_kind == 3 || vwi_kind == 4 || vwi_kind == 5 || vwi_kind == 8;
  int vwi_b = 0;
  if(vwi_for == 1) {
    vwi_b = rib_event((import vw_rb), vwi_kind, vwl_ev);
  }
} chain (View vwv, int vwi_kind, int[] vwl_ev) {
  if((vwi_b & 1) != 0) {
    lset((import vw_st), (import vw_s_d), 1);
  }
  if((vwi_b & 2) != 0) {
    vw_cmd(vwv, rib_cmd((import vw_rb)), rib_arg((import vw_rb)), rib_name((import vw_rb)));
  }
  int vwi_took = (vwi_b & 8) != 0;
} return int vwi_took;
