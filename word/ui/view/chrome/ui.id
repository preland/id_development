// The faces the viewer's own text is set in, as font handles kept in the export vw_ui: regular, bold and italic.
vw_ui_set(int vwi_r, int vwi_b, int vwi_i) {
  export int[] vw_ui = [vwi_r, vwi_b, vwi_i];
} return void;
(3, 4, 5):() then vw_t_ui0:(3)
(1, 2, -1):() then vw_t_ui0:(1)

// The font handle of the viewer's own text: 0 regular, 1 bold, 2 italic; -1 until vw_ui_set has been called.
vw_ui_f(int vwi_k) {
  int vwi_fh = (import vw_ui)[vwi_k];
} return int vwi_fh;
given vw_ui_set(5, 6, 7) (1):(6)
given vw_ui_set(5, 6, 7) (2):(7)

// Test check: the regular face of the viewer's own text.
vw_t_ui0() {
  int vwi_fh = vw_ui_f(0);
} return int vwi_fh;
given vw_ui_set(8, 9, 10) ():(8)
given vw_ui_set(2, 2, 2) ():(2)
