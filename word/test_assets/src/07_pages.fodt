<style:master-page style:name="Letter" style:page-layout-name="pl"/>
<style:master-page style:name="Wide" style:page-layout-name="pw"/>
</office:master-styles>
<office:body><office:text>
<text:p>A4 portrait, 21 by 29.7 cm, margins 2 cm.</text:p>
<text:p text:style-name="PL">US Letter portrait, 8.5 by 11 in, margins 2 cm.</text:p>
<text:p text:style-name="PW">A4 landscape, 29.7 by 21 cm, margins 2 cm.</text:p>
</office:text></office:body></office:document>
