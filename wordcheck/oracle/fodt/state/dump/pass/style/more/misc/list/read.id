// Reads a list style from its start event through its end into the store: its entry, then every level element and the label alignment or properties inside them.
ofd_list_read(OfdSty owst, XmlR owr, int owev) {
  int owid = xr_depth(owr);
  ofd_list_open(owst, owr);
  int owi = len(owst.keys) - 1;
} chain (OfdSty owst, XmlR owr, int owev) {
  int owe = 0;
  int owcur = 0;
  if(owev == 1) {
    owe = xr_next(owr);
  }
} chain (OfdSty owst, XmlR owr, int owev) {
  int owmore = xr_inside(owr, owe, owid);
  while(owmore == 1) {
    owcur = ofd_lvl_event(owst, owi, owr, owe, owcur);
    owe = xr_next(owr);
    owmore = xr_inside(owr, owe, owid);
  }
} return void;
