// What one event inside a list style does to the entry owi, given the level owcur that the last level element chose: a level element starts the level it names (0 when the dump follows no such level), any other element applies to the current level. Answers the new current level.
ofd_lvl_event(OfdSty owst, int owi, XmlR owr, int owev, int owcur) {
  int owhead = owev != 2 && str_starts(xr_get(owr, (import xr_k_name)), "text:list-level-style-") == 1;
  int owl = owcur;
  if(owhead == 1) {
    owl = ofd_level(owr);
  }
} chain (OfdSty owst, int owi, XmlR owr, int owev, int owcur) {
  if(owhead == 1 && owl > 0) {
    ofd_lvl_head(owst, owi, owr, owl);
  }
  if(owhead == 0 && owl > 0 && owev != 2) {
    ofd_lvl_kid(owst, owi, owr, owl);
  }
} return int owl;
