// Adds the entry of the list style the reader is at ("l:" and its name), with the built-in levels in its bag; answers the entry.
ofd_list_open(OfdSty owst, XmlR owr) {
  string[] owlp = owst.props;
  ofd_add(owst, "l:" + xr_attr(owr, "style:name"), "", "", "");
  owlp[len(owlp) - 1] = (import ow_lvdef);
} return void;
