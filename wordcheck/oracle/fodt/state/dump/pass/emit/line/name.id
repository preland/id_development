// The name the dump gives a named style key: "Normal" for LibreOffice's "Standard" and for the default style, else its display name, else the name with each _20_ (an encoded space) read as a space.
ofd_sname(OfdSty owst, string owk) {
  int owlen = fixed_point_maximum(len(owk) - 2, 0);
  string owname = str_sub(owk, 2, owlen);
  string owdisp = ofd_own(owst, owk, "d");
} chain (OfdSty owst, string owk) {
  string owout = str_join(str_split(owname, "_20_"), " ");
  if(owdisp != "") {
    owout = owdisp;
  }
  if(owname == "Standard" || owname == "") {
    owout = "Normal";
  }
} return string owout;
(OfdSty(["p:Heading_20_1"], [""], ["", "", ""]), "p:Heading_20_1"):("Heading 1")
(OfdSty(["p:Text_20_body"], ["|d=Text body"], ["", "", ""]), "p:Text_20_body"):("Text body")
(OfdSty(["p:Standard"], [""], ["", "", ""]), "p:Standard"):("Normal")
(OfdSty(["p:"], [""], ["", "", ""]), "p:"):("Normal")
(OfdSty([], [], []), ""):("Normal")

// The named style a paragraph sits on: its own when it is a named style, the style it names as its parent when it is automatic (the default style when it names none).
ofd_named(OfdSty owst, string owpk) {
  string owk = owpk;
  if(ofd_own(owst, owpk, "a") == "1") {
    owk = ofd_up(owst, owpk);
  }
} return string owk;
(OfdSty(["p:P1", "p:Standard"], ["|a=1", ""], ["p:Standard", "", "", "", "", ""]), "p:P1"):("p:Standard")
(OfdSty(["p:Standard"], [""], ["", "", ""]), "p:Standard"):("p:Standard")
(OfdSty(["p:P1"], ["|a=1"], ["", "", ""]), "p:P1"):("p:")

// The meta string at slot owpart (1 the list style name, 2 the master page name) that entry owk's own meta says, "" when the entry is unknown or has none. Bound with bind(ofd_meta, PART) to walk a style chain.
ofd_meta(int owpart, OfdSty owst, string owk) {
  int owi = ofd_idx(owst, owk);
  string owm = "";
  if(owi >= 0) {
    owm = owst.meta[owi * 3 + owpart];
  }
} return string owm;
(1, OfdSty(["p:A"], [""], ["", "L1", ""]), "p:A"):("L1")
(1, OfdSty(["p:A"], [""], ["", "L1", ""]), "p:Z"):("")
(2, OfdSty(["p:A"], [""], ["", "", "Wide"]), "p:A"):("Wide")
(2, OfdSty(["p:A"], [""], ["", "", "Wide"]), "p:Z"):("")

