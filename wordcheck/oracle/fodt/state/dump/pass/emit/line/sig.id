// The font family of a run as a dump prints it: the first span style (innermost, the last of the list, outward) to name one through its chain, else the paragraph style's, in quotes; "-" when none does.
ofd_font(OfdSty owst, string[] owspans, string owpk) {
  string owfam = "";
  int owi = len(owspans) - 1;
  string owout = "-";
} chain (OfdSty owst, string[] owspans, string owpk) {
  while(owi >= 0 && owfam == "") {
    owfam = ofd_walk(owst, owspans[owi], ofd_fam1);
    owi = owi - 1;
  }
  if(owfam == "") {
    owfam = ofd_walk(owst, owpk, ofd_fam1);
  }
  if(owfam != "") {
    owout = str_quote(owfam);
  }
} return string owout;
(OfdSty(["t:T", "p:P", "p:"], ["|t.fo:font-family=A", "", "|t.fo:font-family=B"], ["", "", "", "", "", "", "", "", ""]), ["t:T"], "p:P"):("\"A\"")
(OfdSty(["t:T", "p:P", "p:"], ["", "", "|t.fo:font-family=B"], ["", "", "", "", "", "", "", "", ""]), ["t:T"], "p:P"):("\"B\"")
(OfdSty(["p:P"], [""], ["", "", ""]), [], "p:P"):("-")

// What a dump prints of a run's properties: the flags, size, colour, highlight, link and font, as the fields of a run record without its text. owlink is the run's hyperlink target, "" for none.
ofd_sig(OfdSty owst, string[] owspans, string owpk, string owlink) {
  string owbits = ofd_bits(owst, owspans, owpk);
  int owhp = ofd_rsize(owst, owspans, owpk);
  string owcol = ofd_color(ofd_rget(owst, owspans, owpk, "t.fo:color"));
} chain (OfdSty owst, string[] owspans, string owpk, string owlink) {
  string owhl = ofd_color(ofd_rget(owst, owspans, owpk, "t.fo:background-color"));
  string owlk = "-";
  if(owlink != "") {
    owlk = str_quote(owlink);
  }
} chain (OfdSty owst, string[] owspans, string owpk, string owlink) {
  string owfont = ofd_font(owst, owspans, owpk);
  string owsize = "-";
  if(owhp >= 0) {
    owsize = "" + owhp;
  }
} chain (OfdSty owst, string[] owspans, string owpk, string owlink) {
  string owout = owbits + " size=" + owsize + " color=" + owcol + " hl=" + owhl + " link=" + owlk + " font=" + owfont;
} return string owout;
(OfdSty(["t:T", "p:", "f:F"], ["|t.fo:font-weight=bold|t.fo:color=#FF0000", "|t.fo:font-size=12pt|t.style:font-name=F", "|fam=Liberation Serif"], ["", "", "", "", "", "", "", "", ""]), ["t:T"], "p:", ""):("b=1 i=0 u=0 s=0 sup=0 sub=0 size=24 color=#ff0000 hl=- link=- font=\"Liberation Serif\"")
(OfdSty(["p:"], [""], ["", "", ""]), [], "p:", "http://x"):("b=0 i=0 u=0 s=0 sup=0 sub=0 size=- color=- hl=- link=\"http://x\" font=-")
