// A paragraph box property of a style as a dump prints it: its length in twips, "-" when no style in its chain sets it or it does not read; a length of exactly -1 twip prints as 0, because the model's -1 means unset.
ofd_pn(OfdSty owst, string owpk, string own) {
  int owtw = ofd_tw(ofd_get(owst, owpk, own));
  string owout = "-";
  if(owtw != (import ow_bad)) {
    owout = "" + owtw;
  }
} chain (OfdSty owst, string owpk, string own) {
  if(owtw == 0 - 1) {
    owout = "0";
  }
} return string owout;
(OfdSty(["p:A"], ["|p.fo:margin-left=0.25in"], ["", "", ""]), "p:A", "p.fo:margin-left"):("360")
(OfdSty(["p:A"], ["|p.fo:margin-left=-0.25in"], ["", "", ""]), "p:A", "p.fo:margin-left"):("-360")
(OfdSty(["p:A"], [""], ["", "", ""]), "p:A", "p.fo:margin-left"):("-")
(OfdSty(["p:A"], ["|p.fo:margin-left=-1pt"], ["", "", ""]), "p:A", "p.fo:margin-left"):("-20")

// A fo:text-align value as a dump prints it: start or left 0, center 1, end or right 2, justify 3, "-" for anything else.
ofd_align(string owv) {
  string owout = "-";
  if(owv == "start" || owv == "left") {
    owout = "0";
  }
  if(owv == "center") {
    owout = "1";
  }
} chain (string owv) {
  if(owv == "end" || owv == "right") {
    owout = "2";
  }
  if(owv == "justify") {
    owout = "3";
  }
} return string owout;
("start"):("0")
("center"):("1")
("right"):("2")
("justify"):("3")
("both"):("-")

// A line height as a dump prints it: its percentage, "-" for anything else (a length is not a proportion).
ofd_pline(string owv) {
  string owout = "-";
  if(ofd_unit(owv) == "%" && ofd_unit(owv) != "") {
    owout = "" + to_int(owv);
  }
} return string owout;
("115%"):("115")
("0.5cm"):("-")
(""):("-")
