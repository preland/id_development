// What the body pass has gathered so far: st holds the counters (skip depth, list depth, in a paragraph, paragraphs so far), ss the strings (the current paragraph's style key, its list style name, its hyperlink, the dump text so far, the first paragraph's style key) and sg the merged runs of the current paragraph as pairs of printed properties and text.
struct OfdAcc {
  int[] st;
  string[] ss;
  string[] sg;
}
