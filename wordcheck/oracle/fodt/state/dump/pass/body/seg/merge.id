// An empty accumulator: no skipping, no list, no paragraph, and the five strings empty.
ofd_acc_new() {
  int[] owlcnt = [0 - 1, 0, 0, 0];
  string[] owlss = ["", "", "", "", ""];
  string[] owlsg = [];
} chain () {
  OfdAcc owacc = OfdAcc(owlcnt, owlss, owlsg);
} return OfdAcc owacc;
():(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], []))
given ofd_t_open("<a/>") ():(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], []))

// Adds a piece of text with its printed properties to the current paragraph's merged runs: a piece with the properties of the last one extends it, any other starts a new run.
ofd_seg(OfdAcc owacc, string owsig, string owtext) {
  int owi = len(owacc.sg) - 2;
  string[] owlsg = owacc.sg;
  int owsame = owi >= 0 && owlsg[owi] == owsig;
} chain (OfdAcc owacc, string owsig, string owtext) {
  if(owsame == 1) {
    owlsg[owi + 1] = owlsg[owi + 1] + owtext;
  }
  if(owsame == 0) {
    list_string_extend(owlsg, [owsig, owtext]);
  }
} return void;
(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], []), "a", "x"):(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["a", "x"]), "a", "x")
(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["a", "x"]), "a", "y"):(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["a", "xy"]), "a", "y")
(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["a", "x"]), "b", "y"):(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["a", "x", "b", "y"]), "b", "y")

// The run records of the current paragraph, each on a line of its own after a line feed: "run" and the printed properties, then the text in quotes.
ofd_runs(OfdAcc owacc) {
  string owout = "";
  int owi = 0;
  while(owi < len(owacc.sg)) {
    owout = owout + "\nrun " + owacc.sg[owi] + " text=" + str_quote(owacc.sg[owi + 1]);
    owi = owi + 2;
  }
} return string owout;
(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["b=0", "hi", "b=1", "!"])):("\nrun b=0 text=\"hi\"\nrun b=1 text=\"!\"")
(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], [])):("")
