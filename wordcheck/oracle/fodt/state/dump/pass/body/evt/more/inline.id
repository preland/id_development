// Adds text to the current paragraph with the properties its span styles (innermost last) and its paragraph style give it, and the hyperlink it is inside, if any.
ofd_text(OfdSty owst, OfdAcc owacc, string[] owspans, string owtext) {
  string owsig = ofd_sig(owst, owspans, owacc.ss[0], owacc.ss[2]);
  ofd_seg(owacc, owsig, owtext);
} return void;
(OfdSty(["p:Standard", "p:"], ["", "|t.fo:font-weight=bold"], ["", "", "", "", "", ""]), OfdAcc([-1, 0, 1, 0], ["p:Standard", "", "", "", ""], []), [], "hi"):(OfdSty(["p:Standard", "p:"], ["", "|t.fo:font-weight=bold"], ["", "", "", "", "", ""]), OfdAcc([-1, 0, 1, 0], ["p:Standard", "", "", "", ""], ["b=1 i=0 u=0 s=0 sup=0 sub=0 size=- color=- hl=- link=- font=-", "hi"]), [], "hi")
