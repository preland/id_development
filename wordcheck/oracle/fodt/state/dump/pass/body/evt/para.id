// Empties a list of strings.
ofd_clr(string[] owlx) {
  while(len(owlx) > 0) {
    pop(owlx);
  }
} return void;
(["a", "b"]):([])
([]):([])

// Starts a paragraph or heading: its style key, no runs yet, no span styles, and, for the first paragraph, its style key kept for finding the page.
ofd_pstart(OfdAcc owacc, XmlR owr, string[] owspans) {
  string[] owlss = owacc.ss;
  owlss[0] = "p:" + xr_attr(owr, "text:style-name");
  ofd_clr(owacc.sg);
} chain (OfdAcc owacc, XmlR owr, string[] owspans) {
  ofd_clr(owspans);
  owacc.st[2] = 1;
  if(owacc.st[3] == 0) {
    owlss[4] = owlss[0];
  }
} return void;
given ofd_t_open("<text:p text:style-name=\"P1\"/>") given xr_skip((import ofd_t_r), 1) (OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], ["a", "b"]), (import ofd_t_r), ["t:T"]):(OfdAcc([-1, 0, 1, 0], ["p:P1", "", "", "", "p:P1"], []), (import ofd_t_r), [])
given ofd_t_open("<text:h text:style-name=\"H\"/>") given xr_skip((import ofd_t_r), 1) (OfdAcc([-1, 0, 0, 2], ["", "", "", "", "p:P1"], []), (import ofd_t_r), []):(OfdAcc([-1, 0, 1, 2], ["p:H", "", "", "", "p:P1"], []), (import ofd_t_r), [])

// The list style a paragraph sits in: inside a text:list the outermost list's style name, outside one the list style its paragraph style gives; "" for none.
ofd_plist(OfdSty owst, OfdAcc owacc) {
  string owlist = ofd_walk(owst, owacc.ss[0], ofd_listof);
  if(owacc.st[1] > 0) {
    owlist = owacc.ss[1];
  }
} return string owlist;
(OfdSty(["p:A"], [""], ["", "L1", ""]), OfdAcc([-1, 0, 0, 0], ["p:A", "", "", "", ""], [])):("L1")
(OfdSty(["p:A"], [""], ["", "L1", ""]), OfdAcc([-1, 2, 1, 0], ["p:A", "L2", "", "", ""], [])):("L2")
