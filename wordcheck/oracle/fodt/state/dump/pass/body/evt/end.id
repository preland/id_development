// The list level of a paragraph: inside a text:list its nesting depth less one, at most 2; outside one, 0.
ofd_plevel(OfdAcc owacc) {
  int owlevel = 0;
  if(owacc.st[1] > 0) {
    owlevel = fx_min(owacc.st[1] - 1, 2);
  }
} return int owlevel;
(OfdAcc([-1, 0, 0, 0], ["", "", "", "", ""], [])):(0)
(OfdAcc([-1, 2, 1, 0], ["", "", "", "", ""], [])):(1)
(OfdAcc([-1, 5, 1, 0], ["", "", "", "", ""], [])):(2)

// Ends a paragraph: its records, the head and the runs, are added to the dump text, the paragraph count goes up and the accumulator is no longer in a paragraph.
ofd_pend(OfdSty owst, OfdAcc owacc) {
  string owlist = ofd_plist(owst, owacc);
  string owsh = ofd_phead(owst, owacc.ss[0], owlist, ofd_plevel(owacc), owacc.st[3]);
  string[] owlss = owacc.ss;
} chain (OfdSty owst, OfdAcc owacc) {
  owlss[3] = owlss[3] + "\n" + owsh + ofd_runs(owacc);
  owacc.st[3] = owacc.st[3] + 1;
  owacc.st[2] = 0;
} return void;
