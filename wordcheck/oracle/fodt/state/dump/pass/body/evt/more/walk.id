// What one event of the document body does, outside any skipped subtree: text goes into the paragraph it is in, a paragraph or heading starts or ends one, a span or a link or a list changes what the text is in, a space, tab, line break or frame adds its character, and a table outside a paragraph becomes an opaque block.
ofd_live(OfdSty owst, XmlR owr, int owev, OfdAcc owacc, string[] owspans) {
  string owname = xr_name(owr);
  if(owev == 3 && owacc.st[2] == 1) {
    ofd_text(owst, owacc, owspans, xr_text(owr));
  }
  if(owname == "text:p" || owname == "text:h") {
    ofd_pdisp(owst, owacc, owr, owev, owspans);
  }
} chain (OfdSty owst, XmlR owr, int owev, OfdAcc owacc, string[] owspans) {
  if(owname == "text:span") {
    ofd_span(owspans, owr, owev);
  }
  if(owname == "text:a") {
    ofd_link(owacc, owr, owev);
  }
  if(owname == "text:list") {
    ofd_list(owacc, owr, owev);
  }
} chain (OfdSty owst, XmlR owr, int owev, OfdAcc owacc, string[] owspans) {
  if((owname == "text:s" || owname == "text:tab" || owname == "text:line-break") && owev != 2) {
    ofd_special(owst, owacc, owr, owspans);
  }
  if(owname == "draw:frame" && owev != 2) {
    ofd_frame(owst, owacc, owr, owev, owspans);
  }
  if(str_starts(owname, "table:") == 1 && owacc.st[2] == 0 && owev != 2) {
    ofd_opaque(owacc, owr, owev);
  }
} return void;
