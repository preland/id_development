// A paragraph or heading event: its start (or an empty one) begins the paragraph, its end (or an empty one) finishes it.
ofd_pdisp(OfdSty owst, OfdAcc owacc, XmlR owr, int owev, string[] owspans) {
  if(owev == 1 || owev == 4) {
    ofd_pstart(owacc, owr, owspans);
  }
  if(owev == 2 || owev == 4) {
    ofd_pend(owst, owacc);
  }
} return void;
