// A text:list's effect on the nesting: the depth goes up when it starts and down when it ends, and the outermost one's style name is kept while it is open.
ofd_list(OfdAcc owacc, XmlR owr, int owev) {
  string[] owlss = owacc.ss;
  if(owev == 1) {
    owacc.st[1] = owacc.st[1] + 1;
  }
  if(owev == 1 && owacc.st[1] == 1) {
    owlss[1] = xr_attr(owr, "text:style-name");
  }
} chain (OfdAcc owacc, XmlR owr, int owev) {
  if(owev == 2) {
    owacc.st[1] = owacc.st[1] - 1;
  }
} return void;
