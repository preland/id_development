// The size in half-points text has: the first of the spans (innermost, the last of the list, outward) to set one, else the paragraph style's; -1 when none does.
ofd_rsize(OfdSty owst, string[] owspans, string owpk) {
  float owpts = ofd_pts(owst, owpk, 0);
  int owi = len(owspans) - 1;
  float owfq = 0.0 - 1.0;
} chain (OfdSty owst, string[] owspans, string owpk) {
  while(owi >= 0 && owfq < 0.0) {
    owfq = ofd_pts(owst, owspans[owi], 0);
    owi = owi - 1;
  }
  if(owfq >= 0.0) {
    owpts = owfq;
  }
  int owhp = ofd_hp(owpts);
} return int owhp;
