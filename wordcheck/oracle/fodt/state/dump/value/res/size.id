// The size in points a style gives text: its own font-size (a percentage is taken of what the style it inherits from gives, 12 points when that gives none), else what it inherits; -1.0 when nothing in the chain sets one.
ofd_pts(OfdSty owst, string owk, int owid) {
  string own = ofd_own(owst, owk, "t.fo:font-size");
  string owup = ofd_up(owst, owk);
  float owbase = 0.0 - 1.0;
} chain (OfdSty owst, string owk, int owid) {
  if(owup != "" && owid < 24) {
    owbase = ofd_pts(owst, owup, owid + 1);
  }
  float owpts = owbase;
  int owtw = ofd_tw(own);
} chain (OfdSty owst, string owk, int owid) {
  float owref = 12.0;
  if(owbase >= 0.0) {
    owref = owbase;
  }
  if(own != "" && owtw != (import ow_bad)) {
    owpts = owtw / 20.0;
  }
} chain (OfdSty owst, string owk, int owid) {
  if(ofd_unit(own) == "%") {
    owpts = owref * str_to_float(own) / 100.0;
  }
} return float owpts;
