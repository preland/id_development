// The value of name in a bag of "|name=value" pairs, "" when it is not there.
ofd_val(string owb, string own) {
  string owneedle = "|" + own + "=";
  int owi = str_find(owb, owneedle);
  string owv = "";
} chain (string owb, string own) {
  int owa = owi + len(owneedle);
  if(owi >= 0) {
    string owtail = str_sub(owb, owa, len(owb) - owa);
    string[] owparts = str_split(owtail, "|");
    owv = owparts[0];
  }
} return string owv;
("|t.fo:color=#ff0000|p.fo:margin-left=1in", "t.fo:color"):("#ff0000")
("|t.fo:color=#ff0000|p.fo:margin-left=1in", "p.fo:margin-left"):("1in")
("|t.fo:color-x=1", "t.fo:color"):("")
("", "a"):("")

// The bag with name set to value: an earlier pair of that name is dropped first.
ofd_set(string owb, string own, string owv) {
  string[] owparts = str_split(owb, "|");
  string owout = "";
  int owi = 1;
} chain (string owb, string own, string owv) {
  while(owi < len(owparts)) {
    owout = owout + ofd_keep(owparts[owi], own);
    owi = owi + 1;
  }
  owout = owout + "|" + own + "=" + owv;
} return string owout;
("|a=1|b=2", "a", "9"):("|b=2|a=9")
("", "a", "9"):("|a=9")

// "|pair" when the pair ("name=value") is not the one for name, else "": what a bag keeps of a pair when name is set again.
ofd_keep(string owpair, string own) {
  string owout = "|" + owpair;
  if(str_starts(owpair, own + "=") == 1) {
    owout = "";
  }
} return string owout;
("a=1", "b"):("|a=1")
("b=2", "b"):("")
("bb=2", "b"):("|bb=2")
