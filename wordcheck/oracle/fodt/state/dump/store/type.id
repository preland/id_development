// Everything the dump oracle learns from a fodt document's style sections, as three parallel lists with one entry per thing: keys ("p:Name" and "t:Name" for paragraph and text styles, "p:" for the default paragraph style, "f:Name" for a font face, "l:Name" for a list style, "g:Name" for a page layout, "m:Name" for a master page), props (a bag of "|name=value" pairs) and meta (three strings per entry: parent key, list style name, master page or layout name).
struct OfdSty {
  string[] keys;
  string[] props;
  string[] meta;
}
