// An empty store.
ofd_new() {
  string[] owkeys = [];
  string[] owprops = [];
  string[] owmeta = [];
} chain () {
  OfdSty owst = OfdSty(owkeys, owprops, owmeta);
} return OfdSty owst;
():(OfdSty([], [], []))
given ofd_t_open("<a/>") ():(OfdSty([], [], []))

// The entry of a key, -1 when it is not there; a later entry of the same key wins.
ofd_idx(OfdSty owst, string owk) {
  int owi = len(owst.keys) - 1;
  int owfound = 0 - 1;
  while(owi >= 0 && owfound < 0) {
    if(owst.keys[owi] == owk) {
      owfound = owi;
    }
    owi = owi - 1;
  }
} return int owfound;
(OfdSty(["a", "b", "a"], ["", "", ""], ["", "", "", "", "", "", "", "", ""]), "a"):(2)
(OfdSty(["a"], [""], ["", "", ""]), "z"):(-1)

// Adds an entry with no properties and the three meta strings.
ofd_add(OfdSty owst, string owk, string owparent, string owlist, string owmaster) {
  push(owst.keys, owk);
  push(owst.props, "");
  lst_str_extend(owst.meta, [owparent, owlist, owmaster]);
} return void;
(OfdSty([], [], []), "p:A", "p:B", "L", "M"):(OfdSty(["p:A"], [""], ["p:B", "L", "M"]), "p:A", "p:B", "L", "M")
(OfdSty(["x"], ["y"], ["1", "2", "3"]), "p:", "", "", ""):(OfdSty(["x", "p:"], ["y", ""], ["1", "2", "3", "", "", ""]), "p:", "", "", "")
