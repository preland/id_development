// 1 when the mode is one of the word binary's CLI modes (docs/WORD.md 4.9).
wlane_known(string wmode, string[] modes) {
  int i = 0;
  int known = 0;
  while (i < len(modes)) {
    known = known + (modes[i] == wmode);
    i = i + 1;
  }
} return int known;
("--dump", ["--text", "--dump"]):(1)
("--render", ["--text", "--dump"]):(0)

// A lane that needs the word binary. The binary does not exist yet, so a known mode is reported unavailable and never as a pass; an unknown mode fails.
wlane_run(string wmode) {
  int code = (import lane_fail);
  if (wlane_known(wmode, (import word_modes)) == 1) {
    code = (import lane_unavailable);
  }
} return int code;
("--text"):(2)
("--roundtrip"):(2)
("--bogus"):(0)

// How many of the word-binary lanes did not pass.
wlane_open(string[] modes) {
  int i = 0;
  int open = 0;
  while (i < len(modes)) {
    open = open + (wlane_run(modes[i]) != (import lane_ok));
    i = i + 1;
  }
} return int open;
(["--text", "--dump"]):(2)
([]):(0)
