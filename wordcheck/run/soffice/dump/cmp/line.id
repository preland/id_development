// How two lines of a dump differ, one report line per field: "CONTEXT KEY: ours=VALUE theirs=VALUE" for every token that differs (a value is the token's text after its "="), or a single "CONTEXT: records differ" line when they have different words or a different number of tokens; "" when they are equal.
ofd_diffline(string owla, string owlb, string owctx) {
  string[] owta = ofd_tokens(owla);
  string[] owtb = ofd_tokens(owlb);
  string owout = "";
} chain (string owla, string owlb, string owctx) {
  if(owla != owlb) {
    owout = owctx + ": records differ: ours=" + owla + " theirs=" + owlb;
  }
  if(owla != owlb && len(owta) == len(owtb) && len(owta) > 0) {
    owout = ofd_fields(owta, owtb, owctx);
  }
} return string owout;
("para 1 style=\"A\" x=1", "para 1 style=\"A\" x=1", "p1"):("")
("run b=1 size=24", "run b=0 size=24", "p1 r0"):("p1 r0 b: ours=1 theirs=0")
("run b=1", "run b=1 c=2", "p0 r0"):("p0 r0: records differ: ours=run b=1 theirs=run b=1 c=2")
("para 0 x=1 y=2", "para 0 x=3 y=4", "p0"):("p0 x: ours=1 theirs=3\np0 y: ours=2 theirs=4")

// The report lines for every token that differs between two token lists of equal length, joined by line feeds.
ofd_fields(string[] owta, string[] owtb, string owctx) {
  string[] owlout = [];
  int owi = 0;
  while(owi < len(owta)) {
    ofd_field(owlout, owta[owi], owtb[owi], owctx);
    owi = owi + 1;
  }
} chain (string[] owta, string[] owtb, string owctx) {
  string owout = str_join(owlout, "\n");
} return string owout;
(["a=1", "b=2"], ["a=1", "b=3"], "c"):("c b: ours=2 theirs=3")
(["a=1"], ["a=1"], "c"):("")

// Adds the report line for one pair of tokens when they differ: the key (the token's text up to its "=", all of it for a token with none) and the two values.
ofd_field(string[] owlout, string owx, string owy, string owctx) {
  int owik = str_find(owx, "=");
  string owkey = owx;
  if(owik >= 0) {
    owkey = str_slice(owx, 0, owik);
  }
} chain (string[] owlout, string owx, string owy, string owctx) {
  if(owx != owy) {
    push(owlout, owctx + " " + owkey + ": ours=" + ofd_after(owx) + " theirs=" + ofd_after(owy));
  }
} return void;
([], "a=1", "a=2", "c"):(["c a: ours=1 theirs=2"], "a=1", "a=2", "c")
(["x"], "a=1", "a=1", "c"):(["x"], "a=1", "a=1", "c")
