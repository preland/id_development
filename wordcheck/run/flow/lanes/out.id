// Where soffice leaves the lane's output for a fixture: the out directory under root, the fixture's stem, the lane's name as the extension.
lane_out(string root, string stem, int lane) {
  string[] names = (import lane_names);
  string path = root + "/" + (import out_sub) + "/" + stem + "." + names[lane];
} return string path;
("/r", "03_x", 0):("/r/out/03_x.txt")
("/r", "03_x", 2):("/r/out/03_x.pdf")

// Runs soffice (or the stand-in bin) for one lane on one source; the exit status.
lane_soff(string bin, string root, int lane, string src) {
  string[] filters = (import lane_filters);
  string cmd = soff_argv(bin, root, filters[lane], src);
  int code = soff_exec(cmd, (import soffice_ms), root);
} return int code;
("true", "/tmp/wordcheck_none", 0, "x.odt"):(0)
("false", "/tmp/wordcheck_none", 1, "x.odt"):(1)

// The txt lane: 1 when soffice exits 0 and its txt output has text after normalising.
lane_txt(string bin, string root, string src, string stem) {
  int code = lane_soff(bin, root, (import r_txt), src);
  string txt = otxt_norm_file(lane_out(root, stem, (import r_txt)));
  int ok = code == 0 && len(txt) > 0;
} return int ok;
("true", "../word/test_assets/oracle", "x.odt", "07_pages"):(1)
("false", "../word/test_assets/oracle", "x.odt", "07_pages"):(0)
("true", "../word/test_assets/oracle", "x.odt", "none"):(0)
