// The ASSETS argument when there is one, the default corpus directory otherwise.
cli_assets(int argc, string[] argv) {
  string dir = (import assets_dir);
  if (argc == 3) {
    dir = argv[2];
  }
} return string dir;
(2, ["wordcheck", "1"]):("word/test_assets")
(3, ["wordcheck", "1", "x/y"]):("x/y")

// Carries out a mode: runs one fixture, lists them, counts them, or says how to ask. The exit status.
cli_go(int mode, string[] argv, string assets) {
  int code = 0;
  string odt_dir = assets + "/" + (import odt_sub);
  if (mode == (import mode_usage)) {
    eprint((import usage_text));
    code = (import exit_usage);
  }
} chain (int mode, string[] argv, string assets) {
  if (mode == (import mode_run)) {
    code = check_run((import soffice_bin), to_int(argv[1]), assets);
  }
  if (mode == (import mode_list)) {
    fixt_list(odt_dir);
  }
  if (mode == (import mode_count)) {
    int total = fixt_count(odt_dir);
    print(total);
  }
} return int code;
(0, ["wordcheck"], "../word/test_assets"):(2) then eprints:("usage: wordcheck N [ASSETS] | wordcheck --list [ASSETS] | wordcheck --count [ASSETS]  (N is a fixture index from --list; ASSETS defaults to word/test_assets)\n")
(2, ["wordcheck", "--list"], "../word/test_assets"):(0) then prints:("1 01_plain\n2 02_headings\n3 03_inline\n4 04_colours\n5 05_lists\n6 06_pagebreak\n7 07_pages\n8 08_long\n9 09_unicode\n10 10_empty\n11 11_table\n12 12_image\n")
(3, ["wordcheck", "--count"], "../word/test_assets"):(0) then prints:("12\n")
(1, ["wordcheck", "99"], "../word/test_assets"):(2) then eprints:("wordcheck: no fixture 99 in ../word/test_assets/odt; list the fixtures with: wordcheck --list\n")

// Entry point: wordcheck N [ASSETS], wordcheck --list [ASSETS], wordcheck --count [ASSETS].
main(int argc, string[] argv) {
  int mode = cli_mode(argc, argv);
  string assets = cli_assets(argc, argv);
  int code = cli_go(mode, argv, assets);
} return int code;
(1, ["wordcheck"]):(2) then eprints:("usage: wordcheck N [ASSETS] | wordcheck --list [ASSETS] | wordcheck --count [ASSETS]  (N is a fixture index from --list; ASSETS defaults to word/test_assets)\n")
(2, ["wordcheck", "--bogus"]):(2) then eprints:("usage: wordcheck N [ASSETS] | wordcheck --list [ASSETS] | wordcheck --count [ASSETS]  (N is a fixture index from --list; ASSETS defaults to word/test_assets)\n")
