// Constants of the oracle driver. The three soffice lanes and the four lanes that need the word binary (docs/WORD.md 4.9).
string soffice_bin = "soffice";
int soffice_ms = 15000;
string assets_dir = "word/test_assets";
string odt_sub = "odt";
string out_sub = "out";
string prof_sub = "prof";
string tmp_prefix = "wordcheck_";

// Lane names, and the soffice --convert-to filter that produces each one's output; the output's extension is the lane name.
string[] lane_names = ["txt", "fodt", "pdf"];
string[] lane_filters = ["txt:Text", "fodt", "pdf"];

// What each fixture is meant to lay out as, in fixture order: the page count LibreOffice must report.
int[] expect_pages = [1, 1, 1, 1, 1, 3, 3, 20, 1, 1, 1, 1];

// The CLI modes of the word binary the driver will call once it exists, in the order docs/WORD.md 4.9 lists them.
string[] word_modes = ["--text", "--dump", "--roundtrip", "--pages"];
string no_word = "word binary not available";

// Where the driver's modes sit in the answer of cli_mode.
int mode_usage = 0;
int mode_run = 1;
int mode_list = 2;
int mode_count = 3;

// A lane's verdict.
int lane_ok = 1;
int lane_fail = 0;
int lane_unavailable = 2;

// Exit statuses: every soffice lane passed but the word-binary lanes did not run, a lane failed, a bad command line.
int exit_unavailable = 3;
int exit_failed = 1;
int exit_usage = 2;

// The slots of a fixture's result list.
int r_txt = 0;
int r_fodt = 1;
int r_pdf = 2;
int r_pages = 3;
int r_cross = 4;

string usage_text = "usage: wordcheck N [ASSETS] | wordcheck --list [ASSETS] | wordcheck --count [ASSETS]  (N is a fixture index from --list; ASSETS defaults to word/test_assets)";

// The slots of the fodt walker's state: inside the body, and how deep in lists, tables and frames the current line is.
int s_body = 0;
int s_list = 1;
int s_table = 2;
int s_frame = 3;
int st_len = 4;
