// Where a fault was, and the attributes of the current element.

// The byte offset the first error was noticed at, or -1 if there was none.
// A message with no position is not a report, it is a complaint.
xml_at() {
} return int (import xml_st)[5];

// The value of an attribute by name, or "" when the element does not have it.
// An absent attribute and an empty one are not distinguished, because no ODT
// attribute this reads means anything by being present and empty.
xml_attr(string name) {
  int i = xml_find(name);
  string out = "";
  if(i >= 0) {
    out = (import xml_ats)[i];
  }
} return string out;

// Where an attribute's value sits in the flat name/value list, or -1.
//
// The last match wins, which is what a linear scan that never stops early
// gives; `id` has no break, and a duplicate attribute is malformed XML anyway.
// The bound is i + 1 rather than i because a fault can leave a name in the
// list with no value behind it, and a list read past its end aborts.
xml_find(string name) {
  int i = 0;
  int at = -1;
  while(i + 1 < len((import xml_ats))) {
    at = xml_pick2((import xml_ats)[i], i + 1, name, at);
    i = i + 2;
  }
} return int at;
