// What the event just returned by xml_next was.

// The kind of the current event: 0 end of input, 1 start, 2 end, 3 empty,
// 4 text, 5 error.
xml_kind() {
  int ret_i = (import xml_st)[1];
} return int ret_i;

// The element name of a start, end or empty element, namespace prefix and all.
//
// `text:p` is the name; the prefix is not resolved to the URI its declaration
// binds it to. ODT fixes its own prefixes in the file it ships -- office:,
// style:, text:, fo: -- so resolution would buy nothing here, and doing it
// properly means tracking a scoped binding per element, which is a bigger
// feature than a document model needs.
xml_name() {
  string ret_s = (import xml_strs)[0];
} return string ret_s;

// The first malformed-input message, or "" if the document is well formed so
// far. Only the first is kept: everything after a fault is a guess.
xml_err() {
  string ret_s = (import xml_strs)[1];
} return string ret_s;
