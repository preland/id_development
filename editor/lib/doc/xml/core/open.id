// The XML pull parser: the state every other file in xml/ reads and writes.
//
// This is a cursor, not a DOM. A block here may perform three actions and may
// nest two deep, which is enough to advance a position and say what was just
// passed, and nowhere near enough to build and own a tree of nodes. The caller
// asks for the next event and looks at it before asking for another; nothing
// is retained.
//
// Five exported lists hold everything:
//
//   xml_mem   the input, copied into the flat store (see core/read/read.id)
//   xml_strs  0 the current element name, 1 the error message
//   xml_ats   the current element's attributes, name then value, flat
//   xml_els   the elements that are open, so an end tag can be checked
//   xml_st    0 the read position          3 the text end, exclusive
//             1 the current event kind     4 1 when the text is CDATA
//             2 the text start             5 where the first error was
//                                         6 the length of the input
//
// An event kind is: 0 end of input, 1 start element, 2 end element, 3 empty
// element, 4 text, 5 error. They are plain integers rather than functions
// returning constants because a zero-action function returning a bare literal
// takes that literal away from every other function in the program.

// Begin a scan. Calling this again restarts on a new document, which is what
// odt_parse does, so nothing here may accumulate across calls.
xml_open(string s) {
  export string[] xml_strs = ["", ""];
  export int[] xml_st = [0, 0, 0, 0, 0, -1, len(s)];
  xml_begin(s);
} return void;

// A fresh attribute list per element. `pop` in a loop is the only way to empty
// a list in `id`, and re-running the export is both shorter and O(1); it is
// also why xml_ats is declared here rather than in xml_open.
xml_clear() {
  export string[] xml_ats = [];
} return void;

// The input goes into the flat store, and the element stack and the attribute
// list start empty. Split from xml_open because a block performs three actions
// and two exports plus a call is already three.
xml_begin(string s) {
  export word[] xml_mem = [mem_of_str(s)];
  export string[] xml_els = [];
  xml_clear();
} return void;
