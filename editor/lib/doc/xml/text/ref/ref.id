// Entity references.

// The '&' at row[0] starts a reference that has to end at a ';' inside this
// text node.
xml_ent(int[] row, int hi, word a) {
  int at = xml_semi(row[0], hi);
  if(at < 0) {
    xml_stop(row, "unterminated entity reference");
  } else {
    xml_ent2(row, at, a);
  }
} return void;

// The ';' that closes the reference, or -1. A ';' past the end of this text
// node belongs to some later part of the document and does not count.
xml_semi(int i, int hi) {
  int at = xml_scan(i, hi, 59);
  if(at == hi) {
    at = -1;
  }
} return int at;

// The name between '&' and ';', resolved to the character it stands for.
xml_ent2(int[] row, int at, word a) {
  string t = xml_cut(row[0] + 1, at - row[0] - 1);
  int v = xml_cp(t);
  xml_ent3(row, at, a, v);
} return void;
