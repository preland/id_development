// Numeric character references, `&#NN;` and `&#xHH;`.

// t still carries its leading '#'.
xml_num(string t) {
  int v = -1;
  if(charat(t, 1) == 120 || charat(t, 1) == 88) {
    v = xml_val(t, 2, 16);
  } else {
    v = xml_val(t, 1, 10);
  }
} return int v;

// The digits of t from i, in base b, or -1 if any byte is not a digit of that
// base or there are none.
//
// One function for both spellings: two loops differing only in the literal 10
// or 16 would be two functions with the same logic, which is a compile error
// and, here, also the right complaint.
xml_val(string t, int i, int b) {
  int[] row = [0, 1];
  int j = xml_val_run(t, i, b, row);
  int ret_i = xml_valv(row, j - i);
} return int ret_i;

// The value of byte c as a digit in base b, or -1.
xml_dv(int c, int b) {
  int v = xml_hv(c);
  int m = -1;
  if(v >= 0 && v < b) {
    m = v;
  }
} return int m;
