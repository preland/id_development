// Accumulating a number, and reading one hex digit.

// row is [value so far, still valid]. The ceiling matters: `id` integers wrap
// silently at 32 bits, so `&#x11111111111;` would otherwise accumulate into
// some arbitrary code point instead of being refused.
xml_digit(int[] row, int v, int b) {
  if(v < 0 || row[0] > 1114111) {
    lset(row, 1, 0);
  } else {
    lset(row, 0, row[0] * b + v);
  }
} return void;

// The accumulated value, or -1 if a digit was bad or there were none at all.
xml_valv(int[] row, int n) {
  int v = -1;
  if(row[1] == 1 && n > 0) {
    v = row[0];
  }
} return int v;

// The value of a hexadecimal digit byte, or -1. idstd's chr_hex goes the other
// way -- value to byte -- so this is not a duplicate of it.
xml_hv(int c) {
  int v = -1;
  if(chr_is_digit(c) == 1) {
    v = c - 48;
  } else {
    v = xml_hv2(chr_lower(c));
  }
} return int v;
