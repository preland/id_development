// The loop xml_val drives: j starts at i and runs while t still has digits.
xml_val_run(string t, int i, int b, int[] row) {
  int j = i;
  while(charat(t, j) >= 0) {
    xml_val_step(t, j, b, row);
    j = j + 1;
  }
} return int j;

// One digit of the loop above: read, valued in base b, folded into row.
xml_val_step(string t, int j, int b, int[] row) {
  int charat_v = charat(t, j);
  int xml_dv_v = xml_dv(charat_v, b);
  xml_digit(row, xml_dv_v, b);
} return void;
