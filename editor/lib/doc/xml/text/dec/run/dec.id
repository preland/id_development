// Expanding entities, through the flat store.

// The decoded form of [lo, hi).
//
// Bytes are poked into one allocation and made into a string once. Appending
// with `+` per character is the single most expensive thing an `id` program
// can do -- quadratic in time and in retained memory, and nothing is ever
// freed -- and a paragraph of body text is exactly the size at which that
// starts to matter.
//
// One allocation of the source length is always enough, because decoding never
// grows the text: the shortest character reference is `&#N;`, four bytes for
// one byte out, and the four-byte UTF-8 sequences need `&#65536;`, eight bytes
// for four.
xml_dec2(int lo, int hi) {
  word a = alloc(hi - lo + 1);
  int[] row = xml_dec_run(lo, hi, a);
  string ret_s = str_of_mem(a, row[1]);
} return string ret_s;

// row starts at lo having written nothing, then runs to hi.
xml_dec_run(int lo, int hi, word a) {
  int[] row = [lo, 0];
  xml_dec3(row, hi, a);
} return int[] row;

// row is the two-slot cursor: 0 is the read offset into the input, 1 is the
// count of bytes written. It is a list because the loop body advances both and
// still has to be one action.
xml_dec3(int[] row, int hi, word a) {
  while(row[0] < hi) {
    xml_dec4(row, hi, a);
  }
} return void;
