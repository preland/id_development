// The last two continuation bytes, which the three- and four-byte forms share.
// Shared rather than repeated: two functions with one body are a compile error
// in this language, so a near-duplicate is not a style question here.

xml_tail(int[] row, word a, int v) {
  xml_emit(row, a, 128 + (v / 64) % 64);
  xml_emit(row, a, 128 + v % 64);
} return void;
