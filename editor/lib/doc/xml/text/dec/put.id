// Writing decoded bytes, and giving up on a bad one.

// One byte that stood for itself: written, and one byte of input consumed.
xml_put(int[] row, word a, int c) {
  xml_emit(row, a, c);
  lset(row, 0, row[0] + 1);
} return void;

// One byte out. The read cursor is untouched, because a character reference
// produces up to four bytes from one run of input and the two cursors move
// independently.
xml_emit(int[] row, word a, int c) {
  poke8(a + row[1], c);
  lset(row, 1, row[1] + 1);
} return void;

// Abandon the decode: report, and drive the read cursor past any possible end
// so the loop finishes. There is no break, and the alternative -- passing the
// bad reference through as literal text -- would be this parser inventing
// content the document does not contain.
xml_stop(int[] row, string msg) {
  xml_fail(msg, row[0]);
  lset(row, 0, xml_len());
} return void;
