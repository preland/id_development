// Names, and the '>' that ends a tag.

// The end of the name token starting at i.
xml_ntok(int i) {
  while(xml_isname_at(i) == 1) {
    i = i + 1;
  }
} return int i;

// Whether a byte can be inside an element or attribute name.
//
// This is deliberately permissive: anything that is not whitespace, a
// delimiter or end of input. XML's real Name production is a set of Unicode
// categories, and enforcing it would reject nothing an ODT contains while
// costing a table this module has no use for. The colon is a name byte, which
// is what keeps `text:p` one name -- see xml_name for why the prefix is kept.
xml_isname(int c) {
  int ok = 1;
  if(c <= 32 || c == 47 || c == 62 || c == 61 || c == 60 || c == 34 || c == 39) {
    ok = 0;
  }
} return int ok;

// After the attributes: '/>' is an empty element, '>' a start element, and
// anything else is a tag that never closed.
xml_endtag(int j) {
  int k = 5;
  if(xml_ch(j) == 47) {
    k = xml_need(j + 1, 62, 3, "expected '>' after '/' in an empty element");
  } else {
    int xml_need_v = xml_need(j, 62, 1, "expected '>' or an attribute");
    k = xml_push(xml_need_v);
  }
} return int k;
