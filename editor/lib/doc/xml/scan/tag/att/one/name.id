// The name half of xml_attr1: the token, sliced and pushed, before the value
// is even looked at.
xml_attr_name(int i) {
  int j = xml_ntok(i);
  string xml_cut_v = xml_cut(i, j - i);
  push((import xml_ats), xml_cut_v);
} return int j;

// The value half: past the whitespace the name left behind, then whatever
// xml_aval makes of what follows.
xml_attr2(int j, int i) {
  int xml_ws_v = xml_ws(j);
  int ret_i = xml_aval(xml_ws_v, i);
} return int ret_i;
