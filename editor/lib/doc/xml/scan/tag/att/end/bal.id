// Element balance: every end tag names the element that is actually open.
//
// Without this, `<office:text><text:p>hello</office:text>` parses cleanly and a
// document model built from it lays out a paragraph that the file does not
// contain. A stack of names is the whole check, and it is also what makes "the
// file stops in the middle of itself" detectable at all.

// Remember an element that just opened. Empty elements are not pushed: they
// close where they open.
xml_push(int k) {
  if(k == 1) {
    push((import xml_els), xml_name());
  }
} return int k;

// The name in the end tag against the innermost element still open.
xml_shut2(int i) {
  int k = 2;
  if(len((import xml_els)) == 0 || (import xml_els)[len((import xml_els)) - 1] != xml_name()) {
    k = xml_fail("end tag does not match the element that is open", i);
  } else {
    pop((import xml_els));
  }
} return int k;

// End of input. An element still open here is a truncated document, and saying
// so is the difference between "this is the whole file" and "this is as much of
// it as parsed". The guard on xml_err is because a fault earlier in the file
// leaves the stack full by construction, and that is not a second fault.
xml_eof() {
  if(len((import xml_els)) > 0 && xml_err() == "") {
    xml_fail("element is still open at the end of the input", xml_len());
  }
} return int 0;
