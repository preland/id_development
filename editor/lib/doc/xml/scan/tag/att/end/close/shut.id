// The rest of xml_close3, once the name is already cut and stored: the '>'
// is required and only then is the name checked against what is open.
xml_close4(int j, int i) {
  int xml_ws_v = xml_ws(j);
  int xml_need_v = xml_need(xml_ws_v, 62, 2, "expected '>' to close an end tag");
  int ret_i = xml_shut(xml_need_v, i);
} return int ret_i;
