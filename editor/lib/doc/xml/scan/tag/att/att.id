// The attribute list of one tag.

// Attributes until something that is not a name, then the closing delimiter.
//
// There is no break, so a fault inside an attribute has to end the loop by
// returning a position at the end of the input, where charat answers -1 and
// xml_isname says no. The second report xml_endtag then makes is discarded,
// because xml_fail keeps only the first.
xml_attrs(int i) {
  int j = xml_ws(i);
  while(xml_isname(xml_ch(j)) == 1) {
    j = xml_attr1(j);
  }
} return int xml_endtag(j);

// One name="value" pair, pushed onto the flat list as name then value.
xml_attr1(int i) {
  int j = xml_ntok(i);
  push((import xml_ats), xml_cut(i, j - i));
} return int xml_aval(xml_ws(j), i);

// The '=' between a name and its value. `i` is the start of the attribute and
// is where the diagnostic points, because that is the thing a reader can find.
xml_aval(int j, int i) {
  int hi = xml_len();
  if(xml_ch(j) == 61) {
    hi = xml_aval2(xml_ws(j + 1), i);
  } else {
    xml_fail("expected '=' after an attribute name", i);
  }
} return int hi;
