// Start and empty elements.

// i is the first byte of the name, just past '<'.
xml_tag(int i) {
  int j = xml_ntok(i);
} return int xml_tag2(i, j);

// A '<' with nothing name-shaped after it is not markup this parser will
// guess at: '<' is not legal as data in XML, so the document is wrong.
xml_tag2(int i, int j) {
  int k = 5;
  if(j == i) {
    k = xml_fail("expected an element name after '<'", i);
  } else {
    k = xml_tag3(i, j);
  }
} return int k;

// The name is sliced once, here, and the attribute list is emptied before the
// attributes are read into it.
xml_tag3(int i, int j) {
  sset((import xml_strs), 0, xml_cut(i, j - i));
  xml_clear();
} return int xml_attrs(j);
