// Searching the input.
//
// idstd's str_findat is the wrong tool on a document-sized string, and not by
// a little. It calls str_eqat at every position, str_eqat alternates charat
// between the haystack and the needle, and the runtime memoises the length of
// only the *last* string it was asked about -- so every position pays a full
// strlen of the whole input. Measured here: a 3.5 MB content.xml took 47
// seconds through str_findat and under two through these three functions.
//
// The rule these keep is: scan with charat over one string, and only compare
// against a second string at a position that already matched its first byte.

// The first index at or after i holding byte c, or the end of the input.
xml_upto(int i, int c) {
  while(xml_ch(i) != c && xml_ch(i) >= 0) {
    i = i + 1;
  }
} return int i;

// The first index at or after i where the string t occurs, or -1.
xml_seek(int i, string t) {
  int c = charat(t, 0);
  int j = xml_upto(i, c);
  while(xml_ch(j) >= 0 && xml_eqat(j, t) == 0) {
    j = xml_upto(j + 1, c);
  }
} return int xml_seek2(j);

// The loop above stops on a match or on the end of the input, and only the end
// of the input means "not found".
xml_seek2(int j) {
  int at = j;
  if(xml_ch(j) < 0) {
    at = -1;
  }
} return int at;
