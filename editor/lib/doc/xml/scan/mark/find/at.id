// The loop xml_seek drives: c is t's first byte, already known to the caller,
// so a candidate is only re-checked in full once it has matched that byte.
xml_find_from(int i, string t, int c) {
  int j = xml_upto(i, c);
  while(xml_ch(j) >= 0 && xml_eqat(j, t) == 0) {
    j = xml_upto(j + 1, c);
  }
} return int j;
