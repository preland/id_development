// Finding the end of a DOCTYPE.

// The '>' that closes it. A DOCTYPE may carry an internal subset in brackets,
// and that subset may contain '>' of its own, so a bracket opening before the
// first '>' means the search has to start again after the matching ']'.
xml_dt_end(int i) {
  int j = xml_seek(i, ">");
  int hi = xml_seek(i, "[");
  if(hi >= 0 && hi < j) {
    j = xml_dt_sub(hi + 1);
  }
} return int j;

// Past the internal subset: its ']', then the '>' after it. Answers -1 if
// either is missing, which xml_skip turns into the unterminated report.
xml_dt_sub(int i) {
  int j = xml_seek(i, "]");
  int hi = -1;
  if(j >= 0) {
    hi = xml_seek(j, ">");
  }
} return int hi;
