// Constructs that end at a fixed terminator and are passed over.

// Resume past a terminator found at j, or report that it was never there.
// Answers -1, which xml_next reads as "not an event, ask again". `i` is where
// the construct began and is what the diagnostic points at, because that is
// the position a reader can find in an editor.
xml_skip(int i, int j, int n, string msg) {
  int k = -1;
  if(j < 0) {
    k = xml_fail(msg, i);
  } else {
    lset((import xml_st), 0, j + n);
  }
} return int k;

// After '<!': a comment, or one of the two constructs xml_bang2 sorts out.
xml_bang(int i) {
  int k = 0;
  if(xml_eqat(i, "--") == 1) {
    k = xml_skip(i, xml_seek(i, "-->"), 3, "unterminated comment");
  } else {
    k = xml_bang2(i);
  }
} return int k;

// CDATA is text and is reported; a DOCTYPE is not.
xml_bang2(int i) {
  int k = 0;
  if(xml_eqat(i, "[CDATA[") == 1) {
    k = xml_cdata(i + 7);
  } else {
    k = xml_doctype(i);
  }
} return int k;
