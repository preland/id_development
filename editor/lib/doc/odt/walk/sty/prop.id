// The style table.

// A style:style opens a row. The defaults are what an absent property means:
// no font named, no size given, neither bold nor italic.
odt_style() {
  string xml_attr_v = xml_attr("style:name");
  push((import odt_keys), xml_attr_v);
  odt_style2();
} return void;

odt_style2() {
  push((import odt_fonts), "");
  push((import odt_nums), 0);
  push((import odt_flags), 0);
} return void;

// style:text-properties fills in the row that style:style most recently
// opened. The guard is for a text-properties element outside any style, which
// is not valid ODT but is a file this could be handed.
odt_props() {
  int i = len((import odt_keys)) - 1;
  if(i >= 0) {
    odt_props2(i);
  }
} return void;
