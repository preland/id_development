// Finishing a run, and the style table's rows.

// The pending pieces become one run, if there are any. No pieces means no run,
// which is how an empty paragraph ends up owning none.
odt_flush() {
  if(len((import odt_parts)) > 0) {
    odt_emit();
  }
} return void;

// The pieces are joined once.
//
// A run is usually one piece and could be taken as it stands, but text:s and
// text:tab break one into several, and `out = out + t` per piece is the
// quadratic shape docs/TODO.md item 10 warns about. str_join measures first and
// then writes the whole answer into one allocation, so a run costs one copy of
// itself however many pieces it arrived in.
odt_emit() {
  push((import odt_txts), str_join((import odt_parts), ""));
  push((import odt_stys), odt_top());
  odt_clear();
} return void;

// A fresh piece list. Re-running the export is O(1) where emptying a list means
// popping it one element at a time, and it is why odt_parts is declared here
// rather than beside the other exports.
odt_clear() {
  export string[] odt_parts = [];
} return void;
