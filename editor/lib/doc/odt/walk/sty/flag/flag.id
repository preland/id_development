// Reading one style's properties.

// Each property keeps what the row already had when the attribute is absent,
// so a style split over more than one text-properties element accumulates
// rather than being reset by the second.
odt_props2(int i) {
  odt_props_font(i);
  odt_props_size(i);
  odt_props_flags(i);
} return void;

// s if it says anything, otherwise t.
odt_or(string s, string t) {
  string out = t;
  if(s != "") {
    out = s;
  }
} return string out;

// fo:font-size is written with its unit, "12pt", and to_int reads the leading
// integer and stops. Only points are modelled: a size in another unit comes
// back as its bare number, which is wrong, and is recorded here as a known
// limitation rather than hidden behind a silent zero.
odt_pt(string s, int n) {
  int m = n;
  if(s != "") {
    m = to_int(s);
  }
} return int m;
