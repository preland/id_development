// Text arriving, and elements opening.

// A text event.
//
// The check comes before xml_text() rather than after it, and that is the
// whole reason the parser reports text as offsets: between paragraphs a
// content.xml is mostly the indentation of its own markup, and this is where
// not copying it pays.
odt_char() {
  if((import odt_st)[0] == 1) {
    string xml_text_v = xml_text();
    push((import odt_parts), xml_text_v);
  }
} return void;

// Text made by an element rather than by bytes -- a run of spaces, a tab. Same
// guard, and separate from odt_char because the string is already in hand.
odt_add(string s) {
  if((import odt_st)[0] == 1) {
    push((import odt_parts), s);
  }
} return void;

// A start or an empty element. The style stack moves first, because whether a
// run ends here is the same question as whether the style in force changes.
odt_open(int k) {
  odt_stack(k);
  odt_elem(k);
} return void;
