// The style in force.

// This element's own text:style-name, or the one it inherits.
odt_style_now() {
  string t = xml_attr("text:style-name");
  if(t == "") {
    t = odt_top();
  }
} return string t;

// The innermost style name, or "" outside every element that named one.
odt_top() {
  string t = "";
  if(len((import odt_stk)) > 0) {
    t = (import odt_stk)[len((import odt_stk)) - 1];
  }
} return string t;

// The guard is for an end tag with no matching start, which the XML scanner
// does not check: popping an empty list aborts the process.
odt_pop() {
  if(len((import odt_stk)) > 0) {
    pop((import odt_stk));
  }
} return void;
