// The two flags, unpacked, and the paragraph count.

odt_bold(string key) {
  int i = odt_key(key);
  int ok = 0;
  if(i >= 0) {
    ok = (import odt_flags)[i] % 2;
  }
} return int ok;

odt_italic(string key) {
  int i = odt_key(key);
  int ok = 0;
  if(i >= 0) {
    ok = (import odt_flags)[i] / 2;
  }
} return int ok;

// How many paragraphs the document has, empty ones included.
odt_paras() {
} return int len((import odt_plo));
