// Where a fault was, and the first of the state declarations.
//
// The exports are spread over five functions because a block performs three
// actions and a declaration is one of them. They run in a chain from odt_init
// so that odt_parse's first action initialises all of them: an export does not
// exist until its declaring function has run, and reading one before that is
// reading uninitialised memory.

// The byte offset in content.xml the first fault was noticed at, or -1.
odt_at() {
} return int xml_at();

odt_init() {
  export string[] odt_txts = [];
  export string[] odt_stys = [];
  odt_init2();
} return void;

odt_init2() {
  export int[] odt_plo = [];
  export int[] odt_phi = [];
  odt_init3();
} return void;
