// The OpenDocument content model: paragraphs, runs of styled text, and the
// automatic styles they name.
//
// This walks an ODT's content.xml with the xml_ pull parser and fills a set of
// parallel exported lists, which is what `id` has instead of a struct:
//
//   odt_plo[i]  odt_phi[i]   paragraph i owns runs [plo, phi)
//   odt_txts[r] odt_stys[r]  run r: its text, and the style it names
//   odt_keys[k]              a style name from <office:automatic-styles>
//   odt_fonts[k]             its style:font-name, "" when it does not set one
//   odt_nums[k]              its fo:font-size in points, 0 when it does not
//   odt_flags[k]             bit 0 bold, bit 1 italic
//
// Read them through odt_paras / odt_runs_of / odt_run_at / odt_run_text /
// odt_run_style and odt_font / odt_size / odt_bold / odt_italic; the lists
// themselves are the representation, not the interface.
//
// An empty <text:p/> is a paragraph with zero runs and it is kept, because a
// blank line in a document is content.

// Parse a content.xml. Everything from a previous call is discarded.
odt_parse(string s) {
  odt_init();
  xml_open(s);
  odt_walk();
} return void;

// One pass over the document. There is no second pass and no tree: every
// question this model answers is answered by the time the input ends.
odt_walk() {
  int k = xml_next();
  while(k != 0) {
    odt_ev(k);
    k = xml_next();
  }
} return void;

// One event. Kind 5 is a fault, which needs nothing done here: the parser has
// already recorded it and driven the input to its end, so the loop stops on
// its own and odt_err() reports it.
odt_ev(int k) {
  if(k == 1 || k == 3) {
    odt_open(k);
  } else if(k == 2) {
    odt_shut();
  } else if(k == 4) {
    odt_char();
  }
} return void;
