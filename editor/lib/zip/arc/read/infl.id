// Method 8 is DEFLATE, and those two are the whole of what an OpenDocument
// or an OOXML file uses. The rest of the method numbers -- bzip2, LZMA, zstd
// -- are reported rather than guessed at, because an editor that shows a
// document decompressed with the wrong algorithm is worse than one that stops.
zip_infl(int[] xs, int at, int i) {
  int[] buf = [];
  if ((import zip_meth)[i] == 8) {
    buf = inf_inflate(xs, at);
  } else {
    inf_fail("zip: unsupported compression method " + (import zip_meth)[i]);
  }
} return int[] buf;
