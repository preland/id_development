// Extracting one entry.

// The local file header repeats the name, and may carry a *different* extra
// field from the central directory's copy of it -- so the two lengths that say
// where the data starts have to be read from the local header, not from the
// entry this reader already parsed. Trusting the central directory's lengths
// is the classic ZIP reader bug and it reads a few bytes into the data.
zip_read(int[] xs, int i) {
  int at = (import zip_off)[i];
  int n = 30 + rd_le16(xs, at + 26) + rd_le16(xs, at + 28);
  int[] ret_li = zip_read2(xs, at, n, i);
} return int[] ret_li;

// The signature is checked only once the local header's own size is known,
// so the read that follows starts exactly where the data begins.
zip_read2(int[] xs, int at, int n, int i) {
  int zip_u32_v = zip_u32(xs, at);
  zip_sig(zip_u32_v, 67324752);
  int[] ret_li = zip_data(xs, at + n, i);
} return int[] ret_li;

// Method 0 is stored: the entry is its own compressed size of bytes.
zip_data(int[] xs, int at, int i) {
  int[] buf = [];
  if ((import zip_meth)[i] == 0) {
    buf = zip_slice(xs, at, (import zip_csz)[i]);
  } else {
    buf = zip_infl(xs, at, i);
  }
} return int[] buf;
