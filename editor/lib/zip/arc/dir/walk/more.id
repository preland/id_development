// The rest of zip_load, once the buffer's length is already known.
zip_load2(int h, int[] xs, int len_v) {
  int n = fs_read(h, xs, len_v);
  int len_v2 = len(xs);
  zip_grab(h, n, len_v2);
} return void;

// The rest of zip_dir, once the record is found and the tables are cleared.
zip_dir2(int[] xs, int at) {
  int rd_le16_v = rd_le16(xs, at + 10);
  int zip_u32_v = zip_u32(xs, at + 16);
  zip_walk(xs, rd_le16_v, zip_u32_v);
} return void;
