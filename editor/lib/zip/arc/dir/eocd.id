// Finding the end-of-central-directory record.

// Backwards from the last position it could occupy, because the record ends
// with a comment of up to 65535 bytes and there is no other way to find it.
// buf is [where to look, what was found]: a pair, because the loop condition
// needs both and there is no `break` to leave on a hit.
zip_eocd(int[] xs) {
  int[] buf = [len(xs) - 22, -1];
  while (buf[0] >= 0 && buf[1] < 0) {
    zip_scan(xs, buf);
  }
  zip_need(buf[1]);
} return int buf[1];

// 101010256 is 0x06054b50, the signature little-endian as it sits in the
// file. The signature alone is not enough -- an entry, or the archive comment
// itself, may contain those four bytes -- so the record's own comment length
// has to account for exactly the rest of the file as well.
zip_scan(int[] xs, int[] buf) {
  if (zip_u32(xs, buf[0]) == 101010256 && rd_le16(xs, buf[0] + 20) == len(xs) - buf[0] - 22) {
    lset(buf, 1, buf[0]);
  }
  lset(buf, 0, buf[0] - 1);
} return void;

// No record means the file is not a ZIP, whatever its extension says.
zip_need(int at) {
  if (at < 0) {
    inf_fail("zip: no end-of-central-directory record");
  }
} return void;
