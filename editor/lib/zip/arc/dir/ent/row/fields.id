// The name and the method, the two columns zip_row fills before zip_row2
// fills the rest.

zip_row_name(int[] xs, int at) {
  int rd_le16_v = rd_le16(xs, at + 28);
  string zip_name_v = zip_name(xs, at + 46, rd_le16_v);
  push((import zip_names), zip_name_v);
} return void;

zip_row_meth(int[] xs, int at) {
  int rd_le16_v2 = rd_le16(xs, at + 10);
  push((import zip_meth), rd_le16_v2);
} return void;
