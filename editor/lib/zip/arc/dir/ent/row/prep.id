// The three checks and reads zip_ent makes before it can call zip_step:
// the signature, then the three field lengths that add up to the fixed part
// plus the name, the extra field and the comment.

zip_ent_prep(int[] xs, int at) {
  int zip_u32_v = zip_u32(xs, at);
  zip_sig(zip_u32_v, 33639248);
  int ret_i = zip_entlen(xs, at);
} return int ret_i;

zip_entlen(int[] xs, int at) {
  int rd_le16_v = rd_le16(xs, at + 28);
  int rd_le16_v2 = rd_le16(xs, at + 30);
  int ret_i = zip_entlen2(xs, at, rd_le16_v, rd_le16_v2);
} return int ret_i;

zip_entlen2(int[] xs, int at, int rd_le16_v, int rd_le16_v2) {
  int rd_le16_v3 = rd_le16(xs, at + 32);
  int ret_i = 46 + rd_le16_v + rd_le16_v2 + rd_le16_v3;
} return int ret_i;
