// The remaining three columns, the name, and the 32-bit read this module
// wants that byte/le.id cannot give it.

// Compressed size at 20, uncompressed size at 24, local header offset at 42.
zip_row2(int[] xs, int at) {
  push((import zip_csz), zip_u32(xs, at + 20));
  push((import zip_usz), zip_u32(xs, at + 24));
  push((import zip_off), zip_u32(xs, at + 42));
} return void;

// An entry name is bytes in the archive and a `string` to everyone who looks
// one up, so it is converted once here rather than compared byte by byte at
// every lookup. A name with a NUL in it would be truncated by the C string it
// becomes; ZIP does not permit one.
zip_name(int[] xs, int at, int n) {
  string s = "";
  int i = 0;
  while (i < n) {
    s = s + chr(xs[at + i]);
    i = i + 1;
  }
} return string s;

// rd_le32 returns a `word`, which is right for a CRC and wrong for an offset:
// every use here is an index into a list, and a list index is an `int`. There
// is no narrowing conversion in the language, so this is the same four bytes
// read as an `int` -- which caps an archive this reader will open at two
// gigabytes, and says so rather than returning a negative index later.
zip_u32(int[] xs, int at) {
} return int rd_le16(xs, at) + rd_le16(xs, at + 2) * 65536;
