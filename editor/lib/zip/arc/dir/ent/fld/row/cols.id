// The three columns zip_row2 fills, one field each so that each stays its
// own action.

zip_row_csz(int[] xs, int at) {
  int zip_u32_v = zip_u32(xs, at + 20);
  push((import zip_csz), zip_u32_v);
} return void;

zip_row_usz(int[] xs, int at) {
  int zip_u32_v2 = zip_u32(xs, at + 24);
  push((import zip_usz), zip_u32_v2);
} return void;

zip_row_off(int[] xs, int at) {
  int zip_u32_v3 = zip_u32(xs, at + 42);
  push((import zip_off), zip_u32_v3);
} return void;
