// DEFLATE decompression -- RFC 1951, which is what ZIP's method 8 stores.
//
// A .odt is a ZIP and every interesting entry in one is deflated, so this is
// the first thing an editor written in `id` needs and the reason lib/zip
// exists at all. There is no zlib wrapper here and none is wanted: ZIP holds
// the raw stream, so `at` is the offset of the first block header.
//
// The whole decoder is one pass over a bit position. `id` has no structs and
// no early return, so the three things a pass needs -- the input, where it is
// in it, and what has come out -- are exported lists, and everything else is
// a parameter. Only one inflate can be in flight at a time; nothing in an
// editor wants two.

// The output is a fresh list per call, so the caller keeps whatever the last
// call produced even after the next one starts.
inf_inflate(int[] src, int at) {
  inf_init(src, at);
  inf_tabs();
  inf_run();
} return int[] (import inf_out);

// inf_bp is a one-cell list rather than an exported int because only the
// declaring function may assign an exported scalar, and the bit position is
// written by every read. It counts *bits*, not bytes: DEFLATE codes are not
// byte-aligned and a byte offset would have to carry a shift beside it.
inf_init(int[] src, int at) {
  export int[] inf_in = src;
  export int[] inf_bp = [at * 8];
  export int[] inf_out = [];
} return void;

// Blocks until the one whose BFINAL bit is set. The flag is a list because
// the loop condition has to see what the body wrote, and there is no `break`.
inf_run() {
  int[] xs = [0];
  while (xs[0] == 0) {
    inf_block(xs);
  }
} return void;
