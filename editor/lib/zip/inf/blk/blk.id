// A block header: one BFINAL bit, then two bits of type.

// The two reads are separate statements because both move the bit position
// and the order they happen in is the format.
inf_block(int[] xs) {
  lset(xs, 0, inf_bits(1));
  inf_kind(inf_bits(2));
} return void;

// Split in two only because an `if` with three `else` clauses is four actions
// and the limit is three.
inf_kind(int n) {
  if (n == 0) {
    inf_stored();
  } else {
    inf_comp(n);
  }
} return void;

// Type 3 is reserved by RFC 1951 and means the stream is not DEFLATE, or is
// not aligned where the caller thought it was.
inf_comp(int n) {
  if (n == 1) {
    inf_fixed();
  } else if (n == 2) {
    inf_dynamic();
  } else {
    inf_fail("deflate: reserved block type 3");
  }
} return void;
