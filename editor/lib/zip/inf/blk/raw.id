// Stored blocks -- BTYPE 00, the bytes as they were -- and how this module
// gives up.

// A stored block restarts on a byte boundary, so the bit position is rounded
// up to the next multiple of eight before LEN is read. Rounding is written
// out rather than given a name because a name for it would be used once.
inf_stored() {
  lset((import inf_bp), 0, ((import inf_bp)[0] + 7) / 8 * 8);
  inf_raw(inf_bits(16));
} return void;

// NLEN follows LEN and is its one's complement -- a check the format makes
// available and this reader skips, because a wrong LEN shows up immediately
// as an index past the end of the input.
inf_raw(int n) {
  int i = 0;
  inf_bits(16);
  while (i < n) {
    inf_emit(inf_bits(8));
    i = i + 1;
  }
} return void;

// There are no exceptions and no early return, so a malformed archive cannot
// be reported upwards: it would have to be threaded through every frame as a
// flag, and every caller would have to gate on it. Saying what is wrong and
// aborting is the honest alternative -- an editor that opened a broken file
// and showed an empty document would be worse than one that stopped. The pop
// of an empty list is what does the aborting: it is `id`'s trap, so this
// exits 1 with a line on stderr as well as the line above on stdout.
inf_fail(string s) {
  int[] xs = [];
  print("id: " + s);
  pop(xs);
} return void;
