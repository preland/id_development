// Dynamic Huffman blocks -- BTYPE 10, where the stream carries its own code
// tables, themselves Huffman-coded.

// Three counts, then a tree to read the code lengths with, then the lengths,
// then the two real trees. xs is [HLIT, HDIST, HCLEN] after inf_hdr.
inf_dynamic() {
  int[] xs = [0, 0, 0];
  inf_hdr(xs);
  inf_dyn(xs);
} return void;

// The three header fields, as separate statements: each one consumes bits, so
// putting them in a list literal would leave the order to the code generator.
// The constants are the biases RFC 1951 section 3.2.7 gives -- there are
// always at least 257 literal codes, one distance code and four code-length
// codes, so those are not transmitted.
inf_hdr(int[] xs) {
  lset(xs, 0, inf_bits(5) + 257);
  lset(xs, 1, inf_bits(5) + 1);
  lset(xs, 2, inf_bits(4) + 4);
} return void;

// The literal and distance lengths arrive as one run, split afterwards, which
// is what the format does: a repeat code may straddle the boundary between
// the two alphabets.
inf_dyn(int[] xs) {
  int[][] rows = inf_tree(inf_clens(xs[2]));
  int[] buf = inf_lens(rows[0], rows[1], xs[0] + xs[1]);
  inf_split(buf, xs[0], xs[1]);
} return void;
