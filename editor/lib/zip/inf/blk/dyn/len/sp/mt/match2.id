// The rest of inf_match, once the length is already read: the distance code
// is decoded with the same Huffman reader the length used, and only then
// does the code become a distance.
inf_match2(int inf_decode_v, int k) {
  int inf_dist_v = inf_dist(inf_decode_v);
  inf_back(inf_dist_v, k);
} return void;
