// The code-length alphabet: nineteen three-bit numbers, in an order that is
// not 0..18.

// Only the first HCLEN of them are transmitted; the rest are zero, which is
// why the list is filled before it is written into rather than pushed to.
inf_clens(int n) {
  int[] xs = [];
  lst_fill(xs, 19, 0);
  inf_clen_loop(xs, n);
} return int[] xs;

// The permutation of RFC 1951 section 3.2.7. It puts the lengths most likely
// to be zero last, so that a stream can stop transmitting early -- which is
// the entire reason the order exists and the reason HCLEN can be as low as 4.
inf_clen_loop(int[] xs, int n) {
  int[] row = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15];
  int i = 0;
  while (i < n) {
    inf_clen_one(xs, row, i);
    i = i + 1;
  }
} return void;

// The i'th value read belongs to symbol row[i], not to symbol i.
inf_clen_one(int[] xs, int[] row, int i) {
  int inf_bits_v = inf_bits(3);
  lset(xs, row[i], inf_bits_v);
} return void;
