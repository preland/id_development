// Reading HLIT + HDIST code lengths through the code-length tree.

// The loop counts what has been produced rather than how many symbols have
// been read, because one repeat code produces up to 138 lengths.
inf_lens(int[] tab, int[] row, int n) {
  int[] xs = [];
  while (len(xs) < n) {
    inf_lens_one(tab, row, xs);
  }
} return int[] xs;

// Symbols 0-15 are a length each; 16, 17 and 18 are runs.
inf_lens_one(int[] tab, int[] row, int[] xs) {
  int v = inf_decode(tab, row);
  if (v < 16) {
    push(xs, v);
  } else {
    inf_rep(xs, v);
  }
} return void;

// 16 repeats the previous length 3-6 times, 17 writes 3-10 zeros and 18
// writes 11-138. Only 16 looks backwards, and it aborts on an empty list --
// a stream that starts with a repeat has nothing to repeat and is corrupt.
inf_rep(int[] xs, int v) {
  if (v == 16) {
    lst_fill(xs, inf_bits(2) + 3, lst_last(xs));
  } else if (v == 17) {
    lst_fill(xs, inf_bits(3) + 3, 0);
  } else {
    lst_fill(xs, inf_bits(7) + 11, 0);
  }
} return void;
