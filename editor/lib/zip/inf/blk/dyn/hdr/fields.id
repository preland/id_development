// The three header fields, one statement pair each. The constants are the
// biases RFC 1951 section 3.2.7 gives -- there are always at least 257
// literal codes, one distance code and four code-length codes, so those are
// not transmitted.

inf_hdr_lit(int[] xs) {
  int inf_bits_v = inf_bits(5);
  lset(xs, 0, inf_bits_v + 257);
} return void;

inf_hdr_dist(int[] xs) {
  int inf_bits_v2 = inf_bits(5);
  lset(xs, 1, inf_bits_v2 + 1);
} return void;

inf_hdr_clen(int[] xs) {
  int inf_bits_v3 = inf_bits(4);
  lset(xs, 2, inf_bits_v3 + 4);
} return void;
