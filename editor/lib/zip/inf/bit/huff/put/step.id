// One pass of the canonical decode: take a bit, and either the code in hand
// is one of this length or it is a prefix of a longer one.

// The count is fetched as an argument rather than a local so that it is read
// after the bit has been taken; the two statements of a body are ordered,
// the operands of one expression are not.
inf_dec_step(int[] xs, int[] tab, int[] row) {
  lset(xs, 0, xs[0] + inf_bit());
  inf_dec_pick(xs, row, tab[xs[3]]);
} return void;

// Codes of this length occupy the n consecutive values from `first`. If the
// code in hand is one of them, its offset from `first` is its offset from
// `index` in the symbol list -- which is the whole trick, and why no tree is
// ever built.
inf_dec_pick(int[] xs, int[] row, int n) {
  if (xs[0] - xs[1] < n) {
    lset(xs, 4, row[xs[2] + xs[0] - xs[1]]);
  } else {
    inf_dec_next(xs, n);
  }
} return void;

// On to codes one bit longer: skip this length's symbols, and shift both the
// first code and the code in hand up to make room for the next bit.
inf_dec_next(int[] xs, int n) {
  lset(xs, 2, xs[2] + n);
  lset(xs, 1, (xs[1] + n) * 2);
  lset(xs, 0, xs[0] * 2);
} return void;
