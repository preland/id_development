// The two counting passes the canonical construction needs.

// How many symbols have a code of each length. Cell 0 collects the symbols
// with no code at all; inf_decode starts at length 1 and never reads it.
inf_count(int[] xs, int[] tab) {
  int i = 0;
  while (i < len(xs)) {
    inf_bump(tab, xs[i]);
    i = i + 1;
  }
} return void;

// A counter in a list, which is a function because `tab[v] = tab[v] + 1` on
// a list the caller owns is the one write `id` spells with a call.
inf_bump(int[] tab, int v) {
  lset(tab, v, tab[v] + 1);
} return void;

// Where each length's symbols begin in the symbol list: the running sum of
// the counts. buf[1] is 0 because the shortest code is one bit, and buf[0]
// exists only so that the length is also the index.
inf_starts(int[] tab) {
  int[] buf = [0, 0];
  int i = 1;
  while (i < 15) {
    push(buf, buf[i] + tab[i]);
    i = i + 1;
  }
} return int[] buf;
