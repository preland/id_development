// TrueType parsing, from the file's own bytes.
//
// A font begins with an offset table -- a version tag, a table count, and
// three binary-search hints nothing here uses -- followed by one 16-byte
// record per table giving a four-character tag and where in the file that
// table starts and how long it is. Everything below begins with
// tt_table(name).
//
// The whole file is held as an int[] of bytes, one byte per cell, for the
// reason editor/NAMES.md gives: a font contains NUL and a `string` may not.
// tt_load keeps a reference to it in `ttbuf`, so the readers underneath are
// not handed the buffer through every call -- a list is a reference, so this
// costs nothing and copies nothing.
//
// Public: tt_load(xs) -> 1 when the font was accepted, tt_table(name) -> a
// table's byte offset in the file, or -1.
//
// NOTHING ELSE IN THIS MODULE MAY BE CALLED UNTIL tt_load HAS RETURNED 1.
// The metrics and the chosen cmap subtable are exported lists, and an export
// does not exist until the function that declares it has run (docs/SPEC.md
// 8) -- a refused font leaves them undeclared, and reading one then is
// reading memory nobody wrote. A refusal is a printed line and a 0, never a
// trap, because the editor above this is handed whatever font a document
// names.
tt_load(int[] xs) {
  int ok = tt_begin(xs);
  if(ok == 1) {
    int rd_be16_v = rd_be16(xs, 4);
    tt_recs(xs, rd_be16_v);
    ok = tt_ready();
  }
} return int ok;

// The empty directory has to exist before the version is even looked at,
// because a caller that gets 0 back may still call tt_table and must get -1
// rather than a read of a list that was never declared.
tt_begin(int[] xs) {
  tt_tabs();
  export int[] ttbuf = xs;
  int ok = tt_begin_check(xs);
} return int ok;

// The tables this parser cannot do without. Passing the version check is not
// enough: NotoColorEmoji is version 0x00010000 with CBDT/CBLC bitmaps, no
// `glyf` and no `loca`, and without this it would trap on the first tt_loca
// with an index of -1 -- a clean abort, but one that says nothing about why.
tt_ready() {
  int ok = tt_table("glyf") >= 0 && tt_table("loca") >= 0 && tt_table("head") >= 0 && tt_table("hhea") >= 0 && tt_table("maxp") >= 0 && tt_table("hmtx") >= 0;
  if(ok == 1) {
    tt_metrics();
    tt_cmap();
  } else {
    print("tt_load: this font has no glyf outlines -- a bitmap font (CBDT/CBLC, sbix, EBDT) has pictures where the contours would be, and is not this parser's format");
  }
} return int ok;
