// The component's own points are appended first with no offset, then this
// component's 2x2 is applied to exactly those points, and only then the
// offset. That order is the format's: a TrueType offset is added after the
// scale unless SCALED_COMPONENT_OFFSET is set, which no font in practice
// sets.
//
// tt_glyf recurses back into this file for a component that is itself
// composite. row is a local list, so each level has its own.
tt_place(int[] row, int x, int y) {
  int b = len((import ttpx));
  tt_glyf(row[2], 0, 0);
  tt_after(row, b, x, y);
} return void;

tt_after(int[] row, int b, int x, int y) {
  tt_xform(row, b);
  tt_shift(b, x + row[3], y + row[4]);
} return void;

// Dividing an F2Dot14 product back out, rounded half away from zero rather
// than truncated -- `id`'s `/` truncates toward zero (docs/SPEC.md 2.2), and
// truncating here would pull every transformed point toward the origin by up
// to a font unit.
//
// Rounding is not a taste call: a font stores its own bounding box for every
// glyph, computed by whoever built it, and over the composites in FreeSerif
// that carry a real 2x2 the stored box agrees with a rounded outline 440
// times out of 776 and with a truncated one 364. The residue is the vendor
// computing a box this parser does not, and is not reachable by any rounding.
tt_fix(int v) {
  int r = v + 8192;
  if(v < 0) {
    r = v - 8192;
  }
  int ret_i = r / 16384;
} return int ret_i;
