// WE_HAVE_A_SCALE is bit 3, WE_HAVE_AN_X_AND_Y_SCALE bit 6, WE_HAVE_A_TWO_BY_TWO
// bit 7. They are exclusive in every font that is not corrupt, and the split
// across two functions is the 3-action limit rather than anything about the
// format: `if` and each chained `else` cost one each, so a declaration plus a
// three-way choice is four.
tt_snum(int k) {
  int n = 0;
  if((k & 8) > 0) {
    n = 1;
  } else {
    n = tt_snum2(k);
  }
} return int n;

tt_snum2(int k) {
  int n = 0;
  if((k & 64) > 0) {
    n = 2;
  } else if((k & 128) > 0) {
    n = 4;
  }
} return int n;

tt_sput4(int[] row) {
  lset(row, 6, rd_i16((import ttbuf), row[0] + 2));
  lset(row, 7, rd_i16((import ttbuf), row[0] + 4));
} return void;
