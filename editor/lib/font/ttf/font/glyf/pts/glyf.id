tt_any() {
} return int len((import ttends)) > 0;

// One glyph appended to the point lists, translated by (x, y). A composite's
// components come back through here with their own offsets, which is why the
// translation is a parameter rather than something the caller applies after.
//
// An empty glyph -- a space -- has loca[g] == loca[g + 1] and no bytes at
// all. Reading its header anyway would read the NEXT glyph's, so the length
// is checked before the offset is used for anything.
tt_glyf(int g, int x, int y) {
  int n = tt_loca(g + 1) - tt_loca(g);
  if(n > 0) {
    tt_body(tt_table("glyf") + tt_loca(g), x, y);
  }
} return void;

// numberOfContours is the first field of a glyph and is negative for a
// composite. Zero is legal and means a glyph with a bounding box and nothing
// in it, which is neither branch.
tt_body(int at, int x, int y) {
  int n = rd_i16((import ttbuf), at);
  if(n < 0) {
    tt_comp(at + 10, x, y);
  }
  if(n > 0) {
    tt_simple(at + 10, n, x, y);
  }
} return void;
