// The contour ends, each pushed with the number of points already recorded
// added in, so that a composite's second component continues one point list
// rather than starting a second numbering. The return is the address just
// past the hinting program, where the flags begin.
tt_ends(int at, int n) {
  int b = len((import ttpx));
  int i = 0;
  while(i < n) {
    i = tt_end1(at, b, i);
  }
} return int at + n * 2 + 2 + rd_be16((import ttbuf), at + n * 2);

tt_end1(int at, int b, int i) {
  push((import ttends), b + rd_be16((import ttbuf), at + i * 2));
} return int i + 1;

// How many points the contours just pushed cover: the last contour's end,
// which is counted from the start of the whole point list, minus the points
// that were already in it.
tt_npts() {
  int n = (import ttends)[len((import ttends)) - 1];
} return int n + 1 - len((import ttpx));
