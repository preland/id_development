tt_pts(int[] tab, int[] row, int x, int y) {
  tt_flags(tab, row, tt_npts());
  tt_coords(tab, row, (import ttpx), 2, x);
  tt_more(tab, row, y);
} return void;

// The y run reads on from where the x run stopped, so the two calls cannot be
// reordered and the second cannot start until the first has finished.
tt_more(int[] tab, int[] row, int y) {
  tt_coords(tab, row, (import ttpy), 4, y);
  tt_oncurve(tab);
} return void;

tt_oncurve(int[] tab) {
  int i = 0;
  while(i < len(tab)) {
    i = tt_on1(tab, i);
  }
} return void;
