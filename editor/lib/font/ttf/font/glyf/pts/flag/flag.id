// Flags are run-length encoded: bit 3 says the next byte is a count of how
// many MORE points repeat this same flag. They are expanded into one flag per
// point here because the x run and the y run each need to walk them, and a
// second decode would be a second place to be wrong.
tt_flags(int[] tab, int[] row, int n) {
  while(len(tab) < n) {
    tt_flag1(tab, row);
  }
} return void;

tt_flag1(int[] tab, int[] row) {
  int b = (import ttbuf)[row[0]];
  push(tab, b);
  tt_rep(tab, row, b);
} return void;
