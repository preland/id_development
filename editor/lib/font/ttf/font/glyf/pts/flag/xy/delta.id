// One delta. Bit k (2 for x, 4 for y) says it is a single unsigned byte; bit
// k * 8 (16 for x, 32 for y) is then that byte's sign. Without bit k, the
// same bit k * 8 means something else entirely -- that the coordinate repeats
// and there are no bytes for it at all -- which is the trap in this format
// and the reason the two cases are separate functions.
tt_delta(int b, int k, int[] row) {
  int r = 0;
  if((b & k) > 0) {
    r = tt_dshort(b, k, row);
  } else {
    r = tt_dlong(b, k, row);
  }
} return int r;

tt_dshort(int b, int k, int[] row) {
  int r = (import ttbuf)[row[0]];
  lset(row, 0, row[0] + 1);
  if((b & (k * 8)) == 0) {
    r = 0 - r;
  }
} return int r;

tt_dlong(int b, int k, int[] row) {
  int r = 0;
  if((b & (k * 8)) == 0) {
    r = rd_i16((import ttbuf), row[0]);
    lset(row, 0, row[0] + 2);
  }
} return int r;
