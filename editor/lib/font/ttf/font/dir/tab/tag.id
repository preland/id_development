// A table tag is four ASCII bytes. It becomes a `string` because that is what
// the call site wants to write -- tt_table("glyf") -- and four tag bytes are
// never NUL, so the limit in docs/SPEC.md 4 does not bite here.
tt_tag(int[] xs, int at) {
  string s = chr(xs[at]) + chr(xs[at + 1]);
  string ret_s = s + chr(xs[at + 2]) + chr(xs[at + 3]);
} return string ret_s;

// A 32-bit field as an int. rd_be32 returns a `word`, correctly -- a full
// 32-bit value does not fit an int -- but every offset in a font small enough
// to have been read into a list is far under 2^31, and carrying a word out of
// here would widen every offset expression in the module with it.
tt_u32(int[] xs, int at) {
  int ret_i = rd_be16(xs, at) * 65536 + rd_be16(xs, at + 2);
} return int ret_i;

// The only two version tags with a `glyf` table behind them: 0x00010000, and
// the Apple spelling 'true'. 'OTTO' is a real font too, but its outlines are
// Type 2 charstrings in a `CFF ` table -- a different curve format with a
// different interpreter -- so it is refused by name here rather than
// discovered later as a missing table.
tt_check(word a) {
  int ok = 0;
  if(a == 65536 || a == 1953658213) {
    ok = 1;
  }
  if(a == 1330926671) {
    print("tt_load: this is an OTTO/CFF font -- its outlines are Type 2 charstrings, not glyf contours, and are out of scope");
  }
} return int ok;
