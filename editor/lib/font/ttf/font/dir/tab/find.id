// The byte offset of a table, or -1. Linear over a few dozen records; the
// sorted-order binary search the format invites would save nothing measurable
// and add one more place to be wrong.
tt_table(string name) {
  int[] xs = [0 - 1];
  tt_tfind(xs, name);
} return int xs[0];

// The search runs to the end of the directory rather than stopping at the
// hit, because `id` has no break and no early return: the loop's exit lives
// in its condition, and the answer is carried out in a one-cell list.
tt_tfind(int[] xs, string name) {
  int i = 0;
  while(i < len((import ttnames))) {
    i = tt_tone(xs, name, i);
  }
} return void;

tt_tone(int[] xs, string name, int i) {
  if((import ttnames)[i] == name) {
    lset(xs, 0, (import ttoff)[i]);
  }
} return int i + 1;
