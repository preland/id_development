tt_cmone_rank(int[] xs, int at, int i) {
  int rd_be16_v = rd_be16(xs, at + 4 + i * 8);
  int rd_be16_v2 = rd_be16(xs, at + 6 + i * 8);
  int k = tt_cmrank(rd_be16_v, rd_be16_v2);
} return int k;

tt_cmone_put(int[] tab, int[] xs, int at, int i, int k) {
  if(k > tab[2]) {
    int tt_u32_v = tt_u32(xs, at + 8 + i * 8);
    tt_cmput(tab, k, at + tt_u32_v);
  }
} return void;
