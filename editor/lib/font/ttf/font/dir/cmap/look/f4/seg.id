// idDelta is added modulo 2^16, and a zero read out of a glyph array stays
// zero rather than picking the delta up -- that is the format's way of
// punching a hole in the middle of a segment.
tt_g4put(int[] tab, int at, int c, int i) {
  int v = tt_g4raw(at, c, i);
  if(v > 0) {
    int tt_g4arr_v = tt_g4arr(at, 2, i);
    lset(tab, 0, (v + tt_g4arr_v) % 65536);
  }
} return void;

// idRangeOffset is a byte offset counted from the address of the
// idRangeOffset entry itself, not from the start of the subtable -- which is
// why the entry's own address has to be rebuilt to follow it. Zero means
// there is no glyph array and the code point is its own index.
tt_g4raw(int at, int c, int i) {
  int r = tt_g4arr(at, 3, i);
  int v = c;
  if(r > 0) {
    int tt_g4at_v = tt_g4at(at, 3, i);
    int tt_g4arr_v = tt_g4arr(at, 1, i);
    v = rd_be16((import ttbuf), tt_g4at_v + r + (c - tt_g4arr_v) * 2);
  }
} return int v;
