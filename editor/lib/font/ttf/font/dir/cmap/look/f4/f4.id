// Format 4: four parallel arrays over a list of code point segments, plus one
// indirection. A segment either adds a constant to the code point or points
// into a glyph array that follows it.
//
// Format 4 covers the BMP only, so a code point above U+FFFF is absent by
// construction -- and asking anyway would run the segment scan off the end of
// endCode, whose last entry is the 0xFFFF that terminates it.
tt_g4(int c) {
  int[] tab = [0, 0];
  if(c < 65536) {
    tt_g4seg(tab, (import ttcm)[0], c);
    tt_g4get(tab, (import ttcm)[0], c);
  }
} return int tab[0];

// The first segment whose endCode is not below c. The scan terminates on the
// 0xFFFF sentinel every format 4 subtable ends with, which is why it needs no
// bound of its own.
tt_g4seg(int[] tab, int at, int c) {
  int i = 0;
  while(tt_g4arr(at, 0, i) < c) {
    i = i + 1;
  }
  lset(tab, 1, i);
} return void;

// A segment covers c only if its startCode is also below it; the gaps between
// segments are what makes that test necessary rather than implied.
tt_g4get(int[] tab, int at, int c) {
  if(tt_g4arr(at, 1, tab[1]) <= c) {
    tt_g4put(tab, at, c, tab[1]);
  }
} return void;
