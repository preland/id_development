// The numbers a renderer needs before it can place anything, gathered from
// `head`, `hhea` and `maxp` into one list because seven exported scalars
// would be seven functions to declare them: an export is initialised by the
// function that declares it, and a block declares at most three things.
//
// ttmet, by index:
//   0  unitsPerEm        the em square these coordinates are in
//   1  indexToLocFormat  0 = 16-bit `loca` entries, 1 = 32-bit
//   2  numberOfHMetrics  how many real entries `hmtx` has
//   3  ascender          font units above the baseline
//   4  descender         font units below it, negative
//   5  lineGap           extra leading between lines
//   6  numGlyphs
//
// Read them through tt_upem, tt_nglyph, tt_ascent, tt_descent and tt_gap;
// the two the parser itself uses are indexed directly.
tt_metrics() {
  export int[] ttmet = [];
  tt_met1(ttmet, (import ttbuf));
  tt_met2(ttmet, (import ttbuf));
} return void;

// indexToLocFormat is signed in the file and is 0 or 1 in every font that
// works, so a negative value here would be a corrupt `head` rather than a
// format this reader does not know.
tt_met1(int[] tab, int[] xs) {
  tt_met1a(tab, xs);
  tt_met1b(tab, xs);
  tt_met1c(tab, xs);
} return void;

tt_met2(int[] tab, int[] xs) {
  tt_met2a(tab, xs);
  tt_met2b(tab, xs);
  tt_met3(tab, xs);
} return void;
