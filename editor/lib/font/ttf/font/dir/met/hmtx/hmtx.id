
tt_met3(int[] tab, int[] xs) {
  tt_met3a(tab, xs);
  tt_met3b(tab, xs);
} return void;

// The advance width of a glyph, in font units. `hmtx` stores a
// (advance, lsb) pair for the first numberOfHMetrics glyphs and only a left
// side bearing for the rest -- monospace tails, where every remaining glyph
// shares the last advance -- so an index past the end folds back onto it
// rather than reading into the bearing array.
tt_advance(int g) {
  int i = tt_advance_i(g);
  int tt_table_v = tt_table("hmtx");
  int ret_i = rd_be16((import ttbuf), tt_table_v + i * 4);
} return int ret_i;

tt_advance_i(int g) {
  int i = g;
  if(i >= (import ttmet)[2]) {
    i = (import ttmet)[2] - 1;
  }
} return int i;
