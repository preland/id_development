// The five metrics a caller reads by name. They are separate functions rather
// than one tt_met(i) because an index at the call site is a comment waiting
// to go stale, and because `id` has no constants to name the index with.
tt_upem() {
} return int (import ttmet)[0];

tt_nglyph() {
} return int (import ttmet)[6];

tt_ascent() {
} return int (import ttmet)[3];
