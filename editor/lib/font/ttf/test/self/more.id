tt_selftest_go(int ok) {
  print("load " + ok);
  if(ok == 1) {
    tt_report();
  }
} return void;

tt_bytes_alloc(string path) {
  int[] xs = [];
  int fs_size_v = fs_size(path);
  lst_fill(xs, fs_size_v, 0);
} return int[] xs;

tt_bytes_go(string path, int[] xs) {
  int fs_open_v = fs_open(path, "r");
  tt_slurp(fs_open_v, xs);
} return void;
