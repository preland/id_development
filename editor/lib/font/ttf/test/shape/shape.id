// 'o' has a hole, 'A' has a hole and a diagonal, 'i' is two separate
// contours, and 'e' acute is a composite -- so the four between them cover
// every branch in the outline reader that a Latin font can reach.
//
// The bounding box is what catches a sign or a delta error at once: a single
// wrong delta moves every point after it, and a wrong sign bit mirrors the
// glyph, and both show up in the box even though neither shows up in the
// point count.
tt_shapes() {
  int[] xs = [111, 65, 105, 233];
  int i = 0;
  while(i < len(xs)) {
    i = tt_shape1(xs, i);
  }
} return void;

tt_shape1(int[] xs, int i) {
  int g = tt_glyph(xs[i]);
  int ok = tt_outline(g);
  print("out " + xs[i] + " g " + g + " any " + ok + " nc " + len((import ttends)) + " np " + len((import ttpx)) + " bbox " + lst_min((import ttpx)) + " " + lst_min((import ttpy)) + " " + lst_max((import ttpx)) + " " + lst_max((import ttpy)) + " ends " + tt_endstr() + " on " + tt_onstr());
} return int i + 1;
