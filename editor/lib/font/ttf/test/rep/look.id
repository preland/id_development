// 'A', 'g', '0', a space, CYRILLIC CAPITAL ZHE and an EN DASH: two of them
// exercise the second and third digit of a format 4 segment search, the space
// is the glyph with an advance and no outline, and the last two are outside
// Latin-1 entirely.
tt_lookups() {
  int[] xs = [65, 103, 48, 32, 1046, 8211];
  int i = 0;
  while(i < len(xs)) {
    i = tt_look1(xs, i);
  }
} return void;

tt_look1(int[] xs, int i) {
  int g = tt_glyph(xs[i]);
  print("cp " + xs[i] + " g " + g + " adv " + tt_advance(g));
} return int i + 1;
