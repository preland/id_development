tt_swpg(int[] tab) {
  lset(tab, 1, tab[1] + len((import ttends)));
  lset(tab, 2, tab[2] + len((import ttpx)));
  tt_swph(tab);
} return void;

tt_swph(int[] tab) {
  int i = 0;
  while(i < len((import ttpx))) {
    i = tt_swp2(tab, i);
  }
} return void;

tt_swp2(int[] tab, int i) {
  lset(tab, 0, (tab[0] * 31 + (import ttpx)[i] + 1000003) % 1000003);
  lset(tab, 0, (tab[0] * 31 + (import ttpy)[i] + 1000003) % 1000003);
  lset(tab, 0, (tab[0] * 31 + (import ttpon)[i] + 1000003) % 1000003);
} return int i + 1;
