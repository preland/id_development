// Every glyph's advance, including the tail past numberOfHMetrics where they
// all share the last entry -- fifteen glyphs in DejaVuSans, and no letter
// among them, so nothing that spells a word goes near the case.
tt_asweep() {
  int[] tab = [0, 0];
  while(tab[1] < tt_nglyph()) {
    tt_asw1(tab);
  }
  int ret_i = tab[0];
} return int ret_i;

tt_asw1(int[] tab) {
  int tt_advance_v = tt_advance(tab[1]);
  lset(tab, 0, (tab[0] * 31 + tt_advance_v) % 1000003);
  lset(tab, 1, tab[1] + 1);
} return void;
