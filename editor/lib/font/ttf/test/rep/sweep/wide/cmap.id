tt_more2() {
  print("more " + tt_csweep() + " " + tt_asweep());
} return void;

// Every third code point from U+0000 to U+2FFFF, folded into one hash. The
// outline sweep says nothing at all about `cmap` -- it walks glyph ids and
// never asks which character produced one -- and a handful of letters says
// almost as little: nineteen of LiberationSans's ninety-four format 4
// segments reach their glyphs through the idRangeOffset indirection, and not
// one letter of the Latin alphabet is in any of them.
//
// Every third rather than every one because a format 4 lookup scans the
// segment array from the front, and the whole of this file has to stay well
// inside the minute a test is allowed.
tt_csweep() {
  int[] tab = [0, 0];
  while(tab[1] < 196608) {
    tt_csw1(tab);
  }
} return int tab[0];

tt_csw1(int[] tab) {
  lset(tab, 0, (tab[0] * 31 + tt_glyph(tab[1])) % 1000003);
  lset(tab, 1, tab[1] + 3);
} return void;
