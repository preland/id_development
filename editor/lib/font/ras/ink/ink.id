// The edge list and the coverage bitmap, and the two stages that fill them.
//
// An edge is a straight segment of the flattened outline, held as four
// parallel lists in device coordinates (1/64 pixel, y downwards, the pen
// origin at x = 0 and the baseline at y = 0):
//
//   rasx0[i] rasy0[i]   where the segment starts
//   rasx1[i] rasy1[i]   where it ends
//
// The direction is not stored: a scanline reads it back from the sign of
// rasy1 - rasy0, which is exactly what the nonzero winding rule counts.
// Horizontal segments are kept even though they can never be crossed,
// because the bitmap's bounding box is taken from these lists and dropping
// them could lose a corner.
//
// The lists are NOT translated into bitmap coordinates. Doing that would
// need a second pass over every point; the fill subtracts the origin once
// per crossing instead.
ras_edge0() {
  export int[] rasx0 = [];
  export int[] rasy0 = [];
  ras_edge1();
} return void;

// rascov is the bitmap itself: ras_w() * ras_h() bytes, row major, 0..255.
// It is declared beside the edges rather than where it is sized, because a
// glyph with no contour never reaches the sizing step and ras_cov still has
// to have something to fail against cleanly.
ras_edge1() {
  export int[] rasx1 = [];
  export int[] rasy1 = [];
  export int[] rascov = [];
} return void;

// Flatten, measure, fill. The measure and the fill are inside the test
// because lst_min traps on an empty list, and an outline whose every contour
// is a single point produces no edge at all -- a real thing in a font, and
// not an error: it leaves a 0 by 0 bitmap, which is what ras_scale reports
// by returning 0.
ras_ink() {
  ras_flat();
  if(len((import rasx0)) > 0) {
    ras_box();
    ras_fill();
  }
} return void;
