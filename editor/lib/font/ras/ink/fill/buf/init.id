// tab has one cell per 1/64 pixel column plus one for crossings that fall
// off the right-hand end -- see ras_add.
ras_rows_tab(int[] tab) {
  int ras_w_v = ras_w();
  lst_fill(tab, ras_w_v * 64 + 1, 0);
} return void;

ras_rows_row(int[] row) {
  int ras_w_v2 = ras_w();
  lst_fill(row, ras_w_v2, 0);
} return void;
