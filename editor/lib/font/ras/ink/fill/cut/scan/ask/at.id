// The left bearing in whole pixels: the bitmap's left edge, measured from
// the pen. Negative for a glyph that leans back over what precedes it.
ras_bx() {
} return int (import rasmet)[4];

// How many of the bitmap's rows stand above the baseline. The top row of the
// bitmap is drawn at baseline - ras_by(), so a glyph that descends has
// ras_by() smaller than ras_h().
ras_by() {
} return int (import rasmet)[5];

// Floor division by 64, which is not what `id`'s division does: C truncates
// towards zero, so -65/64 is -1 where the pixel containing -65 sixty-fourths
// is -2. Every coordinate above the baseline is negative, so getting this
// wrong shortens the bitmap by a row on exactly the glyphs that need it.
ras_flr(int v) {
  int n = v / 64;
  if(v < 0 && n * 64 != v) {
    n = n - 1;
  }
} return int n;
