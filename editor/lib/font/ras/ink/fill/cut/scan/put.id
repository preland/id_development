// One column of the sample line, and the cell of tab behind it zeroed on the
// way past. Zeroing here rather than in a pass of its own is not a saving of
// time so much as the only cheap way to empty the list at all: `id` has no
// clear, and re-declaring tab would rebind a name three call levels above
// (docs/FRICTION.md 13).
ras_hit(int[] tab, int[] row, int[] buf) {
  lset(tab, buf[0], 0);
  if(buf[1] != 0) {
    lset(row, buf[0] / 64, row[buf[0] / 64] + 1);
  }
} return void;

// The row's accumulators become coverage, and are zeroed for the next row
// for the same reason.
ras_put(int r, int[] row) {
  int x = 0;
  while(x < ras_w()) {
    x = ras_put1(r, x, row);
  }
} return void;

// 4 samples of 64 columns is a full pixel at 256, so the scale to 0..255 is
// a multiply and a shift with nothing lost and nothing unreachable.
ras_put1(int r, int x, int[] row) {
  lset((import rascov), r * ras_w() + x, row[x] * 255 / 256);
  lset(row, x, 0);
} return int x + 1;
