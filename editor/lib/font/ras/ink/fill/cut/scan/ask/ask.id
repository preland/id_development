// What a renderer asks the rasteriser after ras_scale.
//
// These live six directories down from the module root because every
// directory on the way holds three entries and this is where the third one
// landed, which is docs/FRICTION.md 5 exactly: depth that says nothing.
ras_w() {
  int ret_i = (import rasmet)[2];
} return int ret_i;

ras_h() {
  int ret_i = (import rasmet)[3];
} return int ret_i;

// Coverage of one pixel, 0 for untouched and 255 for wholly inside. x runs
// 0..ras_w()-1 left to right and y runs 0..ras_h()-1 downwards from the top
// of the bitmap. Calling this after ras_scale returned 0 is a trap, and
// deliberately: an empty bitmap has no pixel to be wrong about.
ras_cov(int x, int y) {
  int ret_i = (import rascov)[y * ras_w() + x];
} return int ret_i;
