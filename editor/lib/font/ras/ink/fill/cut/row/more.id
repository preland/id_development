// Row r is done: its accumulators become coverage, and the caller's cursor
// advances to the next one.
ras_rast_out(int r, int[] row) {
  ras_put(r, row);
  int ret_i = r + 1;
} return int ret_i;

ras_samp_cuts(int r, int j, int[] tab) {
  int ras_by_v = ras_by();
  ras_cuts((r - ras_by_v) * 64 + j * 16 + 8, tab);
} return void;

ras_samp_scan(int[] tab, int[] row) {
  int ras_w_v = ras_w();
  ras_scan(tab, row, ras_w_v * 64);
} return void;
