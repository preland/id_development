// The bitmap's size and where it sits relative to the pen.
//
// The box is taken from the flattened edges rather than from the font's own
// bounding box, for two reasons: the font's box is in font units and would
// have to be rounded outwards twice, and a composite glyph's stored box is
// allowed to be wrong -- several fonts ship one that is simply the first
// component's.
//
// Only the START of each edge is measured. Every contour is closed, so the
// starts and the ends are the same set of points; measuring both would read
// twice as much to get the same four numbers.
ras_box() {
  ras_xspan(ras_flr(lst_min((import rasx0))), 0 - ras_flr(0 - lst_max((import rasx0))));
  ras_yspan(ras_flr(lst_min((import rasy0))), 0 - ras_flr(0 - lst_max((import rasy0))));
  lst_fill((import rascov), ras_w() * ras_h(), 0);
} return void;

// The horizontal span, rounded outwards: lo is the pixel column the leftmost
// point falls in, hi is one past the rightmost, so the bitmap covers every
// pixel any part of the glyph touches and no more.
ras_xspan(int lo, int hi) {
  lset((import rasmet), 2, hi - lo);
  lset((import rasmet), 4, lo);
} return void;

// The vertical span. lo is negative for anything above the baseline, and the
// number a caller wants is how far above the baseline the bitmap starts, so
// it is stored negated.
ras_yspan(int lo, int hi) {
  lset((import rasmet), 3, hi - lo);
  lset((import rasmet), 5, 0 - lo);
} return void;
