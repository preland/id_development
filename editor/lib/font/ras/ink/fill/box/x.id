// The horizontal span, rounded outwards: lo is the pixel column the leftmost
// point falls in, hi is one past the rightmost, so the bitmap covers every
// pixel any part of the glyph touches and no more.
ras_box_x() {
  int lo = ras_box_xlo();
  ras_box_xhi(lo);
} return void;

ras_box_xlo() {
  int lst_min_v = lst_min((import rasx0));
  int ras_flr_v = ras_flr(lst_min_v);
  lset((import rasmet), 4, ras_flr_v);
} return int ras_flr_v;

// hi is the ceiling of the rightmost point: the negated floor of the
// negated value, since ras_flr only rounds towards negative infinity. lo is
// taken as a parameter rather than re-read from rasmet so that ras_box_xlo
// need only run once.
ras_box_xhi(int lo) {
  int lst_max_v = lst_max((import rasx0));
  int ras_flr_v2 = ras_flr(0 - lst_max_v);
  lset((import rasmet), 2, 0 - ras_flr_v2 - lo);
} return void;
