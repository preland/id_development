// The vertical span. lo is negative for anything above the baseline, and the
// number a caller wants is how far above the baseline the bitmap starts, so
// it is stored negated.
ras_box_y() {
  int lo = ras_box_ylo();
  ras_box_yhi(lo);
} return void;

ras_box_ylo() {
  int lst_min_v2 = lst_min((import rasy0));
  int ras_flr_v3 = ras_flr(lst_min_v2);
  lset((import rasmet), 5, 0 - ras_flr_v3);
} return int ras_flr_v3;

ras_box_yhi(int lo) {
  int lst_max_v2 = lst_max((import rasy0));
  int ras_flr_v4 = ras_flr(0 - lst_max_v2);
  lset((import rasmet), 3, 0 - ras_flr_v4 - lo);
} return void;
