// Where a contour starts, which is the part of TrueType flattening that is
// most often wrong.
//
// A contour is a closed run of quadratic segments whose on-curve points the
// file does not always give. Two consecutive off-curve points imply an
// on-curve point at their midpoint, and a contour may begin off-curve -- so
// the pen's first position is not always a point of the font at all. There
// are three cases and this file is all three:
//
//   the first point is on-curve   start there, and walk the rest
//   it is not, but the last is    start at the LAST point, and walk from the
//                                 first through the second to last -- the
//                                 contour is closed, so that is the same
//                                 ring rotated
//   neither is on-curve           start at the midpoint of the last and the
//                                 first, and walk the whole ring
//
// The third case also covers a contour with NO on-curve point anywhere -- a
// circle drawn out of nothing but control points, which is rare and real.
// It needs no test of its own: if neither end is on-curve then the midpoint
// rule is the right start whether or not something in the middle is.
//
// buf, the pen:
//   0  i         the next point of the contour to consume
//   1  at        one past the last point to consume
//   2  3         where the pen is now, device 1/64 pixel
//   4  5         the control point waiting to be used
//   6  has       1 when 4 and 5 hold one
//   7  8         where the contour started, to close back onto
//   9  10        where the current curve started, which 2 and 3 leave behind
//                as the curve is stepped along
ras_open(int[] buf, int lo, int hi) {
  lst_fill(buf, 11, 0);
  if((import ttpon)[lo] == 1) {
    ras_at(buf, lo, lo + 1, hi + 1);
  } else {
    ras_open2(buf, lo, hi);
  }
} return void;

ras_open2(int[] buf, int lo, int hi) {
  if((import ttpon)[hi] == 1) {
    ras_at(buf, hi, lo, hi);
  } else {
    ras_mid(buf, lo, hi);
  }
} return void;

// Start on the font's own point m, and consume [i, at).
ras_at(int[] buf, int m, int i, int at) {
  ras_from(buf, ras_dx(m), ras_dy(m));
  lset(buf, 0, i);
  lset(buf, 1, at);
} return void;
