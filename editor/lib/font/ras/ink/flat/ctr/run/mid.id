// The pen's start position for ras_mid: the midpoint of the contour's last
// point and its first, taken in device units per ctr/run/run.id's comment.
ras_mid_from(int[] buf, int lo, int hi) {
  int x = ras_mid_x(lo, hi);
  int y = ras_mid_y(lo, hi);
  ras_from(buf, x, y);
} return void;

ras_mid_x(int lo, int hi) {
  int ras_dx_v = ras_dx(lo);
  int ras_dx_v2 = ras_dx(hi);
  int x = (ras_dx_v + ras_dx_v2) / 2;
} return int x;

ras_mid_y(int lo, int hi) {
  int ras_dy_v = ras_dy(lo);
  int ras_dy_v2 = ras_dy(hi);
  int y = (ras_dy_v + ras_dy_v2) / 2;
} return int y;
