// A quadratic Bezier from where the pen is, through the waiting control
// point, to (x, y), as a run of straight edges.
//
// The step count is chosen from the curve's own size rather than fixed, and
// it costs one addition per curve to do so: a glyph at 8 pixels and the same
// glyph at 200 want very different numbers of segments, and a constant that
// is right for one wastes an order of magnitude on the other or is visibly
// faceted.
ras_quad(int[] buf, int x, int y) {
  ras_hold(buf);
  ras_arc(buf, x, y, ras_nseg(buf, x, y));
} return void;

// Where the curve began. The pen walks along the curve as the steps are
// emitted, so cells 2 and 3 stop being the start after the first one, and
// every later step still needs it.
ras_hold(int[] buf) {
  lset(buf, 9, buf[2]);
  lset(buf, 10, buf[3]);
} return void;

// Step n lands exactly on (x, y) -- with j = n the two ends of the
// interpolation are the endpoint times n squared over n squared -- so the
// curve joins whatever follows it with no gap for a scanline to leak
// through.
ras_arc(int[] buf, int x, int y, int n) {
  int j = 1;
  while(j <= n) {
    j = ras_step(buf, x, y, j, n);
  }
} return void;
