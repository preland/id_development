// One step of the curve. The two coordinates are independent, so the order
// the arguments are evaluated in cannot matter -- worth saying because
// docs/SPEC.md leaves that order unspecified (docs/FRICTION.md 10).
ras_step(int[] buf, int x, int y, int j, int n) {
  ras_line(buf, ras_bez(buf[9], buf[4], x, j, n), ras_bez(buf[10], buf[5], y, j, n));
} return int j + 1;

// The quadratic itself, at t = j/n, with the division done once at the end
// so that the whole thing stays in integers: (n-j)^2 b + 2 (n-j) j c + j^2 v,
// over n^2. n is capped at 32 by ras_nseg, so n^2 is 1024 and a coordinate
// of 20000 sixty-fourths -- a 300 pixel glyph -- leaves the product an order
// of magnitude short of overflowing.
ras_bez(int b, int c, int v, int j, int n) {
  int m = n - j;
} return int (m * m * b + 2 * m * j * c + j * j * v) / (n * n);

// One segment per two pixels of control polygon. The distance a quadratic
// strays from its chord over one of n equal pieces is |p0 - 2c + p1| / 8n^2,
// and |p0 - 2c + p1| is at most the polygon length L, so at n = L/2 the
// error is 1/2L of a pixel -- under a sixteenth of a pixel for any curve
// long enough to have been split at all, and smaller the bigger the glyph
// gets. The polygon is measured with
// absolute values rather than a square root because it only has to be
// roughly proportional to the arc, and fx_hyp would cost more than the
// segments it saves.
ras_nseg(int[] buf, int x, int y) {
  int n = fx_abs(buf[4] - buf[2]) + fx_abs(buf[5] - buf[3]) + fx_abs(x - buf[4]) + fx_abs(y - buf[5]);
} return int fx_clamp(n / 128 + 1, 1, 32);
