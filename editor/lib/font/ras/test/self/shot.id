// One glyph at one size: the placement on a `dim` line, then the whole
// bitmap, one `cov` line per row. The bitmap is printed rather than
// summarised because a total that matches can still be the wrong shape, and
// because a reference that disagrees should be readable about where.
ras_shot(string[] argv, int i) {
  int ok = ras_shot_scale(argv, i);
  ras_shot_dim(argv, i, ok);
  int ret_i = ras_shot_dump(argv, i);
} return int ret_i;

ras_shot_scale(string[] argv, int i) {
  int g = ras_shot_glyph(argv, i);
  int px = to_int(argv[i + 1]);
  int ok = ras_scale(g, px);
} return int ok;

ras_shot_glyph(string[] argv, int i) {
  int to_int_v = to_int(argv[i]);
  int ret_i = tt_glyph(to_int_v);
} return int ret_i;
