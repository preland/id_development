// ras_selftest -- the rasteriser's answers, printed so that a reference
// implementation can be asked the same questions and the two diffed. It
// lives in the module for the reason tt_selftest gives: a shell script has
// no way to call an `id` function, so the smallest thing that can exercise
// ras_scale is a program.
//
// argv[1] is a font file, and every pair after it is a code point and a
// pixel size. tests/editor_ras.sh passes the same pairs to its own
// rasteriser and compares line for line.
ras_selftest(string[] argv) {
  int ok = tt_load(tt_bytes(argv[1]));
  print("load " + ok);
  if(ok == 1) {
    ras_report(argv);
  }
} return void;

ras_report(string[] argv) {
  int i = 2;
  while(i + 1 < len(argv)) {
    i = ras_shot(argv, i);
  }
} return void;

// One glyph at one size: the placement on a `dim` line, then the whole
// bitmap, one `cov` line per row. The bitmap is printed rather than
// summarised because a total that matches can still be the wrong shape, and
// because a reference that disagrees should be readable about where.
ras_shot(string[] argv, int i) {
  int ok = ras_scale(tt_glyph(to_int(argv[i])), to_int(argv[i + 1]));
  print("dim " + argv[i] + " " + argv[i + 1] + " " + ras_w() + " " + ras_h() + " " + ras_bx() + " " + ras_by() + " " + ok);
  ras_dump(argv[i], argv[i + 1]);
} return int i + 2;
