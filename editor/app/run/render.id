// Lay the document out against the page width, draw it, and either write the
// image a test reads or list what was laid out.
ed_render(int argc, string[] argv) {
  ed_out_init();
  lay_doc(600);
  ed_page_out(argc, argv);
} return void;

ed_page_out(int argc, string[] argv) {
  ed_draw(640, 480);
  ed_show();
  ed_save(argc, argv);
} return void;
