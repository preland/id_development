
ed_grow_row() {
  int n = ed_w() * 3;
  int i = len((import ed_line));
  while(i < n) {
    push((import ed_line), 0);
    i = i + 1;
  }
} return void;

ed_fill(int y, int x) {
  while(x < ed_w()) {
    int ed_w_v = ed_w();
    ed_rgb(x, y, (import ed_fb)[y * ed_w_v + x]);
    x = x + 1;
  }
} return void;

ed_rgb(int x, int y, int v) {
  lset((import ed_line), x * 3, v / 65536 & 255);
  lset((import ed_line), x * 3 + 1, v / 256 & 255);
  lset((import ed_line), x * 3 + 2, v & 255);
} return void;
