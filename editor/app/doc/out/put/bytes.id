ed_bytes(int[] buf, string s, int i) {
  while(i < len(s)) {
    push(buf, charat(s, i));
    i = i + 1;
  }
  fs_write(ed_fd(), buf, len(buf));
} return void;

// The handle, in a cell, because ed_puts already spends its three actions on
// the buffer and cannot also carry it.
ed_fd() {
} return int (import ed_out)[0];

ed_fd_set(int fd) {
  lset((import ed_out), 0, fd);
} return void;
