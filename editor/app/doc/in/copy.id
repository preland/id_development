
ed_poke(int[] xs, word a, int i) {
  while(i < len(xs)) {
    poke8(a + i, xs[i]);
    i = i + 1;
  }
} return void;

// The font file, read whole. The same shape as the archive: a font is binary
// and stays in an int[].
ed_read(string path) {
  int[] xs = zip_bytes(path);
} return int[] xs;

// What a run should be drawn in: its style's point size, or twelve when the
// style says nothing. A document that names no size is not a document with a
// zero-point one.
ed_pt(string key) {
  int n = odt_size(key);
  if(n <= 0) {
    n = 12;
  }
} return int n;
