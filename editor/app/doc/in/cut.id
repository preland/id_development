// A substring.
//
// Through the flat store rather than a loop of `+`, for the reason
// docs/FRICTION.md 9 gives: appending a character at a time is quadratic. The
// round trip copies the whole string once, which is the wrong shape for a long
// one and exactly right for clipping a line of a listing.
ed_cut(string s, int lo, int hi) {
  word mem_of_str_v = mem_of_str(s);
  string ret_s = str_of_mem(mem_of_str_v + lo, hi - lo);
} return string ret_s;

// The write side of the same round trip: bytes poked into a fresh block,
// then read back as the string they spell. Split out of ed_str so that
// function's own three actions stay under the limit.
ed_str_out(int[] xs, word a, int n) {
  ed_poke(xs, a, 0);
  string ret_s = str_of_mem(a, n);
} return string ret_s;
