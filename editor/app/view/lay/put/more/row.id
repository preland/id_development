// The rest of a glyph's row: its vertical position, its size, and its
// style flags, each into the table that carries it. Split out of lay_row
// so that function's own actions stay under the limit.
lay_row2(int g, int r) {
  push((import lay_y), (import lay_pen)[1]);
  int lay_pt_v = lay_pt(r);
  lay_row3(r, lay_pt_v);
} return void;

lay_row3(int r, int lay_pt_v) {
  push((import lay_px), lay_pt_v);
  int lay_flag_v = lay_flag(r);
  push((import lay_st), lay_flag_v);
} return void;
