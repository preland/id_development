// A glyph at the pen, and the pen moved past it. A space is emitted like
// anything else -- it has an advance and no ink, and the rasteriser will find
// no contours in it -- because dropping it here would lose the place a line
// may break.
lay_emit(int g, int r, int c) {
  lay_row(g, r);
  lay_emit_out(g, r);
} return void;

// The advance ed_place needs found, and the pen moved past it. Split out of
// lay_emit so that function's own actions stay under the limit.
lay_emit_out(int g, int r) {
  int lay_pt_v = lay_pt(r);
  int lay_adv_v = lay_adv(g, lay_pt_v);
  lset((import lay_pen), 0, (import lay_pen)[0] + lay_adv_v);
} return void;

lay_row(int g, int r) {
  push((import lay_g), g);
  push((import lay_x), (import lay_pen)[0]);
  lay_row2(g, r);
} return void;
