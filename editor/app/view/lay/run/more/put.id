// The byte width of the character just read, so lay_char can step past it.
// Split out of lay_char so that function's own actions stay under the
// limit.
lay_char_out(string s, int at) {
  int charat_v = charat(s, at);
  int ret_i = at + utf_len(charat_v);
} return int ret_i;

// The advance found, the line wrapped if it runs past the page, and the
// glyph emitted. Split out of lay_put so that function's own actions stay
// under the limit.
lay_put_out(int w, int g, int r, int c, int lay_pt_v) {
  int lay_adv_v = lay_adv(g, lay_pt_v);
  lay_wrap(w, lay_adv_v);
  lay_emit(g, r, c);
} return void;
