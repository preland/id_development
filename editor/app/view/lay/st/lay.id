// Laying a document out: where every glyph goes.
//
// Nothing here draws. It walks the paragraphs, asks the font how wide each
// glyph is, breaks lines against a page width, and records a position per
// glyph -- so that the rasteriser and the framebuffer are a separate concern
// and a wrong line break is visible without rendering anything.
//
//   lay_g   the glyph id
//   lay_x   pen x, in 64ths of a pixel
//   lay_y   the baseline, in whole pixels
//   lay_px  the size it is drawn at, in pixels per em
//   lay_st  bit 0 bold, bit 1 italic
//
// The pen is in 64ths because a glyph advance is a fraction of a pixel and
// rounding each one to a whole pixel accumulates: over a line of sixty
// characters that is several characters of drift.

lay_init() {
  export int[] lay_g = [];
  export int[] lay_x = [];
  lay_init2();
} return int 0;

lay_init2() {
  export int[] lay_y = [];
  export int[] lay_px = [];
  lay_init3();
} return void;

lay_init3() {
  export int[] lay_st = [];
  export int[] lay_pen = [0, 0];
} return void;
