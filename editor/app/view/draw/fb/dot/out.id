// The pixel at a resolved position, and its bold echo if the run asks for
// one. Split out of ed_place so that function's own actions stay under the
// limit.
ed_place_out(int i, int at, int y, int v) {
  int ras_by_v = ras_by();
  ed_over(at, (import lay_y)[i] - ras_by_v + y, v);
  ed_bold(i, at, y, v);
} return void;
