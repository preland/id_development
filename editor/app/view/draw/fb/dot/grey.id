// Coverage to colour. Black text on white paper, so full coverage is 0 and
// none is white; the three channels are equal because nothing here is
// subpixel-positioned.
ed_grey(int v) {
  int n = 255 - v;
} return int n * 65536 + n * 256 + n;

// The colour already there, so a glyph drawn over another darkens rather than
// replacing -- which is what bold needs, being the same glyph drawn twice a
// pixel apart.
ed_at(int x, int y) {
  int v = 16777215;
  if(x >= 0 && x < ed_w() && y >= 0 && y < ed_h()) {
    v = (import ed_fb)[y * ed_w() + x];
  }
} return int v;

// The darker of what is there and what is being drawn, as coverage.
ed_over(int x, int y, int v) {
  int n = 255 - (ed_at(x, y) & 255);
  ed_dark(x, y, n, v);
} return void;
