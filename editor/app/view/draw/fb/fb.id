// The page, as pixels.
//
// One int per pixel, 0xRRGGBB, row-major -- which is the framebuffer the
// graphics backend takes and, with a header in front of it, an image file. So
// the same drawing code serves a window and a test, and the thing a test looks
// at is the thing a person would have looked at.
//
//   ed_fb   the pixels
//   ed_dim  width, height

ed_page(int w, int h) {
  export int[] ed_fb = [];
  export int[] ed_dim = [];
  ed_dims(w, h);
} return int 0;

ed_dims(int w, int h) {
  push((import ed_dim), w);
  push((import ed_dim), h);
  ed_white(w * h, 0);
} return void;

// Paper. A page that starts black and is written on in black is a page that
// looks like it failed.
ed_white(int n, int i) {
  while(i < n) {
    push((import ed_fb), 16777215);
    i = i + 1;
  }
} return void;
