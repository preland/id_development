// The code point, from however many bytes it took. The leading byte keeps
// 7, 5, 4 or 3 of its bits depending on the length, and every continuation
// byte adds six more.
utf_val(string s, int at, int n) {
  int c = charat(s, at) & utf_mask(n);
} return int utf_more(s, at + 1, at + n, c);

utf_mask(int n) {
  int c = 127;
  if(n > 1) {
    c = 63 / utf_pow(n - 1);
  }
} return int c;

utf_pow(int n) {
  int c = 1;
  while(n > 0) {
    c = c * 2;
    n = n - 1;
  }
} return int c;
