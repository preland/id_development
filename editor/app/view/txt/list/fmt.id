// One run's line of the listing, built up over three calls because the
// print it ends in takes more values than a block may compute at once.
// Split out of ed_run, in two stages, so each function's own actions stay
// under the limit.
ed_run_out(string key, int r, string ed_face_v) {
  int ed_pt_v = ed_pt(key);
  string odt_font_v = odt_font(key);
  ed_run_out2(r, ed_face_v, ed_pt_v, odt_font_v);
} return void;

ed_run_out2(int r, string ed_face_v, int ed_pt_v, string odt_font_v) {
  string odt_run_text_v = odt_run_text(r);
  string ed_clip_v = ed_clip(odt_run_text_v);
  print("    " + ed_face_v + " " + ed_pt_v + "pt " + odt_font_v + ": " + ed_clip_v);
} return void;
