// The document editor.
//
//   editor DOC.odt FONT.ttf [--ppm OUT]
//
// It reads an OpenDocument file -- a ZIP holding XML -- lays its paragraphs
// out against a real font's metrics, and draws the glyphs from that font's own
// outlines. Every one of those is `id`: the inflater, the parser, the font
// reader and the rasteriser (editor/lib/), over the two things the language
// cannot reach on its own, files and a window.
//
// With --ppm it renders one page to an image and exits, which is how it is
// tested; without, it opens a window.

main(int argc, string[] argv) {
  ed_start(argc, argv);
} return int 0;

ed_start(int argc, string[] argv) {
  if(argc < 3) {
    print("usage: editor DOC.odt FONT.ttf [--ppm OUT]");
  } else {
    ed_go(argc, argv);
  }
} return void;

ed_go(int argc, string[] argv) {
  ed_load(argv[1]);
  tt_load(ed_read(argv[2]));
  ed_show();
} return void;
