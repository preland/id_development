// Recording: open a capture stream, read the frames, write the WAV.

// Records rc_secs seconds into rc_out on rc_bk. Answers 2 for a length outside 1 to 60 seconds, otherwise what rc_open answers.
rc_rec(string rc_out, int rc_secs, string rc_bk) {
  int rc_rc = 2;
  if ((rc_secs >= 1) && (rc_secs <= 60)) {
    rc_rc = rc_open(rc_out, rc_secs, rc_bk);
  }
} return int rc_rc;
("x.wav", 0, "null"):(2)
given fs_temp_text ("x") ((import fs_temp_path), 1, "null"):(0) then prints:("rec: 48000 of 48000 frames, 48000 Hz, 2 ch, s16\nrec: backend null, ring 48000 frames, quantum 48000 frames\nrec: 0 xruns, 0 frames lost, peak 0 of 32767\n") then idstd_aud_t_fsz:(48011)

// Opens the capture stream (a null one gets a ring as big as the recording, because only rc_take lets its device run) and records on it. Answers 1 with a line on standard error when the stream will not open.
rc_open(string rc_out, int rc_secs, string rc_bk) {
  int rc_frames = 48000 * rc_secs;
  int rc_ring = (rc_bk == "null") * rc_frames;
  int rc_h = aud_open(rc_bk, "id-rec", (import aud_dir_capt), 48000, 2, 0, rc_ring);
} chain (string rc_out, int rc_secs, string rc_bk) {
  int rc_rc = 1;
  if (rc_h >= 0) {
    rc_rc = rc_take(rc_h, rc_out, rc_frames);
  }
  if (rc_h < 0) {
    eprint("rec: " + aud_error());
  }
} return int rc_rc;
("x.wav", 1, "bogus"):(1) then eprints:("rec: backend must be \"null\", \"pw\" or \"\" (the default: pw, or null when ID_AUDIO=null)\n")
given fs_temp_text ("x") ((import fs_temp_path), 2, "null"):(0) then idstd_aud_t_fsz:(96011)

// Reads rc_frames frames from the open stream rc_h, writes them to rc_out, reports and closes. Answers 0 when every frame arrived and the file was written.
rc_take(int rc_h, string rc_out, int rc_frames) {
  word rc_buf = alloc(rc_frames * 4 + 8);
  int rc_pm = aud_run_null(rc_h, rc_frames);
  int rc_n = aud_move_all(rc_h, rc_buf, rc_frames, 3000);
} chain (int rc_h, string rc_out, int rc_frames) {
  int rc_sz = wav_save(rc_out, 0, 2, 48000, rc_buf, rc_n);
  rc_report(rc_h, rc_buf, rc_n, rc_frames);
  int rc_cl = aud_close(rc_h);
} chain (int rc_h, string rc_out, int rc_frames) {
  if (rc_sz < 0) {
    eprint("rec: cannot write " + rc_out + ": check that its directory exists and is writable");
  }
  int rc_ok = (rc_n == rc_frames) && (rc_sz >= 0);
  int rc_rc = 1 - rc_ok;
} return int rc_rc;
