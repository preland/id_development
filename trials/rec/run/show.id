// The largest absolute value among the first rc_ns int16 samples at rc_buf: 0 means silence.
rc_peak(word rc_buf, int rc_ns) {
  int rc_i = 0;
  int rc_pk = 0;
  while (rc_i < rc_ns) {
    rc_pk = rc_step(rc_buf, rc_i, rc_pk);
    rc_i = rc_i + 1;
  }
} return int rc_pk;
