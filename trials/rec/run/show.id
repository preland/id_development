// What a rec run prints, and the loudest sample.

// Prints the three lines a run ends with: how many of the asked-for frames came, the stream (backend, ring, quantum), and the counters with the peak of what was recorded.
rc_report(int rc_h, word rc_buf, int rc_n, int rc_frames) {
  string[] rc_bes = ["null", "pw"];
  int rc_ri = audio_info(rc_h, (import audio_i_ring));
  int rc_q = audio_info(rc_h, (import audio_i_quantum));
} chain (int rc_h, word rc_buf, int rc_n, int rc_frames) {
  int rc_be = audio_info(rc_h, (import audio_i_back));
  int rc_xr = audio_xruns(rc_h);
  int rc_lo = audio_info(rc_h, (import audio_i_lost));
} chain (int rc_h, word rc_buf, int rc_n, int rc_frames) {
  print("rec: " + rc_n + " of " + rc_frames + " frames, 48000 Hz, 2 ch, s16");
  print("rec: backend " + rc_bes[rc_be] + ", ring " + rc_ri + " frames, quantum " + rc_q + " frames");
  int rc_pk = rc_peak(rc_buf, rc_n * 2);
} chain (int rc_h, word rc_buf, int rc_n, int rc_frames) {
  print("rec: " + rc_xr + " xruns, " + rc_lo + " frames lost, peak " + rc_pk + " of 32767");
} return void;
