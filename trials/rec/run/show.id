// The larger of rc_pk and the absolute value of sample rc_i at rc_buf.
rc_step(word rc_buf, int rc_i, int rc_pk) {
  int rc_s = aud_s16_at(rc_buf, rc_i);
  int rc_a = fixed_point_absolute(rc_s);
  int rc_m = fixed_point_maximum(rc_pk, rc_a);
} return int rc_m;
