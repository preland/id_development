gc_show(int h, string host, string path, int ms) {
  string req = gc_request(host, path);
  int sent = sock_put(h, req, ms);
  string all = gc_slurp(h, ms);
} chain (int h, string host, string path, int ms) {
  print(all);
  sock_close(h);
  int rc = (len(all) == 0);
} return int rc;
(-1, "h", "/", 10):(1) then prints:("\n")
given gc_served ((import idstd_sock_fixture_cl), "h", "/", 100):(0) then prints:("hi\n") then idstd_sock_fixture_done:(0)

gc_slurp(int h, int ms) {
  word ad = alloc(4096);
  string all = "";
  int n = 1;
} chain (int h, int ms) {
  while(n > 0) {
    n = sock_recv_mem(h, ad, 4096, ms);
    all = all + str_of_mem(ad, n * (n > 0));
  }
} return string all;
(-1, 10):("")
given gc_served ((import idstd_sock_fixture_cl), 100):("hi") then idstd_sock_fixture_done:(1)

gc_request(string host, string path) {
  string req = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
} return string req;
("h", "/"):("GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n")
