// Decompression of a gzip file into a file.

// Decompresses the gzip file gz_fa into the file gz_fb. Answers the bytes written, -1 when a file will not open, or the negative gz_inflate gives for bad input.
gz_inflate_file(string gz_fa, string gz_fb) {
  word[] gz_sb = [0];
  word[] gz_db = [0];
  int gz_n = fs_load(gz_fa, gz_sb);
} chain (string gz_fa, string gz_fb) {
  int gz_r = gz_n;
  if (gz_n >= 0) {
    gz_r = gz_inflate(gz_sb[0], gz_n, gz_db);
  }
  if (gz_r >= 0) {
    gz_r = fs_save(gz_fb, gz_db[0], gz_r);
  }
} return int gz_r;
