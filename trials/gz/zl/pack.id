// The gzip format over buffers in the flat store, see zl.h. Each answers a
// byte count, or a negative: zlib's own code, -100 when dst was too small, -101
// when the input ended inside a member.

native zl_bound(int n, int level) return int;

native zl_gzip(word src, int n, word dst, int cap, int level) return int;

native zl_gunzip(word src, int n, word dst, int cap) return int;
