// How the zlib natives declared beside this file are linked: one C source
// over the system's zlib, found by -lz (docs/INTEROP.md, "Calling C from id").

string name = "zl";
string c_header = "zl.h";

string[] c_linux_sources = ["zl.c"];
string[] c_linux_cflags = [];
string[] c_linux_link = ["-lz"];
string[] c_darwin_sources = ["zl.c"];
string[] c_darwin_cflags = [];
string[] c_darwin_link = ["-lz"];
