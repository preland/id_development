// How the zlib natives declared beside this file are linked: one C source
// over the system's zlib, whose flags pkg-config supplies (docs/BACKENDS.md,
// "backend.id"; docs/INTEROP.md, "Calling C from id").

string name = "zl";
string c_header = "zl.h";

string[] c_linux_sources = ["zl.c"];
string[] c_linux_pkg = ["zlib"];
string[] c_darwin_sources = ["zl.c"];
string[] c_darwin_pkg = ["zlib"];
