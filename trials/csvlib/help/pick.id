// Helpers for the facade in the project's root. They live below it, so the
// library does not export them.

// Column `cs_col` of every row that has one.
cl_pick(string[][] csv_table, int csv_column) {
  string[] csv_output = [];
  int csv_index = 0;
  int csv_count = len(csv_table);
} chain (string[][] csv_table, int csv_column) {
  while (csv_index < csv_count) {
    cl_push(csv_table[csv_index], csv_column, csv_output);
    csv_index = csv_index + 1;
  }
} return string[] csv_output;
([["a", "b"], ["c"], ["d", "e"]], 1):(["b", "e"])
([], 0):([])

// Push cs_row[cs_col] onto cs_out when the row is long enough.
cl_push(string[] csv_fields_in_row, int csv_column, string[] csv_output) {
  if (len(csv_fields_in_row) > csv_column) {
    push(csv_output, csv_fields_in_row[csv_column]);
  }
} return void;
(["a", "b"], 1, []):(["a", "b"], 1, ["b"])
(["a"], 1, ["z"]):(["a"], 1, ["z"])

// The sum of the entries that are numbers.
cl_total(string[] csv_values) {
  float csv_total = 0.0;
  int csv_index = 0;
  int csv_count = len(csv_values);
} chain (string[] csv_values) {
  while (csv_index < csv_count) {
    csv_total = csv_total + cl_numval(csv_values[csv_index]);
    csv_index = csv_index + 1;
  }
} return float csv_total;
(["1", "x", "2.5"]):(3.5)
([]):(0.0)
