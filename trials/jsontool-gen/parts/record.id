gen_wide(int n) {
  put("{");
  int i = 0;
  while (i < n) {
    put("\"k" + (i * 7919) % n + "\":" + i + ",");
    i = i + 1;
  }
} chain (int n) {
  put("\"end\":0}");
} return void;
