gen_rec(int i) {
  string head = "{\"id\":" + i + ",\"name\":\"user" + i + "\",\"score\":" + i + ".25,";
  string tags = "\"tags\":[\"a\",\"caf\\u00e9\",1.5e3,-0.25,true,null,false],";
  string tail = "\"nested\":{\"k\":[1,2,3],\"s\":\"line\\nbreak \\ud83d\\ude00 x\"}}";
} chain (int i) {
  string all = head + tags + tail;
} return string all;
