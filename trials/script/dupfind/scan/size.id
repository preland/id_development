df_cands(string[] files, int[] sizes) {
  string[] keys = [];
  int[] vals = [];
  int[] used = [];
} chain (string[] files, int[] sizes) {
  int[] cnt = [];
  hash_map_initialize(keys, vals, used, cnt);
  df_count(sizes, keys, vals, used, cnt);
} chain (string[] files, int[] sizes) {
  string[] cands = df_twice(files, sizes, keys, vals, used);
} return string[] cands;
