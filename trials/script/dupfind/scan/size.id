// Two files can only be equal if they are the same size, and a size is a stat
// where a hash is a read of the whole file, so only files that share a size with
// another are hashed.

df_sizes(string dir, string[] files) {
  int[] sizes = [];
  int i = 0;
  while (i < len(files)) {
    string full = path_join(dir, files[i]);
    push(sizes, fs_size(full));
    i = i + 1;
  }
} return int[] sizes;
