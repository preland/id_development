df_count(int[] sizes, string[] keys, int[] vals, int[] used, int[] cnt) {
  int i = 0;
  while (i < len(sizes)) {
    hash_map_bump(keys, vals, used, cnt, "" + sizes[i]);
    i = i + 1;
  }
} return void;
