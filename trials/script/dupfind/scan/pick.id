df_twice(string[] files, int[] sizes, string[] keys, int[] vals, int[] used) {
  string[] cands = [];
  int i = 0;
  while (i < len(files)) {
    string k = "" + sizes[i];
    if (sizes[i] >= 0 && hmap_get(keys, vals, used, k, 0) >= 2) {
      push(cands, files[i]);
    }
    i = i + 1;
  }
} return string[] cands;
