df_each(string dir, string[][] groups, int[] ord) {
  int i = 0;
  while (i < len(ord)) {
    string[] g = groups[ord[i]];
    if (len(g) >= 2) {
      df_print(dir, g);
    }
    i = i + 1;
  }
} return void;
