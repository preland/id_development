// Group the candidate files by content hash: groups[g] is the paths sharing a
// hash, in path order, and the hash table maps a hash to its group number.

df_groups(string dir, string[] cands) {
  string[][] groups = [];
  string[] keys = [];
  int[] vals = [];
} chain (string dir, string[] cands) {
  int[] used = [];
  int[] cnt = [];
  hash_map_initialize(keys, vals, used, cnt);
} chain (string dir, string[] cands) {
  df_fill(dir, cands, groups, keys, vals, used, cnt);
} return string[][] groups;
