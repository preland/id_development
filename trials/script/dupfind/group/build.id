df_fill(string dir, string[] cands, string[][] groups, string[] keys, int[] vals, int[] used, int[] cnt) {
  int i = 0;
  while (i < len(cands)) {
    df_one(dir, cands[i], groups, keys, vals, used, cnt);
    i = i + 1;
  }
} return void;
