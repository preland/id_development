df_one(string dir, string path, string[][] groups, string[] keys, int[] vals, int[] used, int[] cnt) {
  string full = path_join(dir, path);
  string h = sha256_hash(fs_read_bytes(full));
  df_place(path, h, groups, keys, vals, used, cnt);
} return void;
