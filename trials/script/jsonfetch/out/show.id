jf_show(int n, string[] names, int[] scores, int[] tags) {
  print("users: " + n);
  print("total score: " + lst_sum(scores));
  jf_rows(names, scores, tags, ord_desc(scores));
} return void;
(1, ["a"], [5], [2]):(1, ["a"], [5], [2]) then prints:("users: 1\ntotal score: 5\n1. a 5 (2 tags)\n")
(0, [], [], []):(0, [], [], []) then prints:("users: 0\ntotal score: 0\n")

jf_rows(string[] names, int[] scores, int[] tags, int[] ord) {
  int i = 0;
  while (i < len(ord)) {
    print((i + 1) + ". " + names[ord[i]] + " " + scores[ord[i]] + " (" + tags[ord[i]] + " tags)");
    i = i + 1;
  }
} return void;
(["a", "b"], [1, 2], [0, 1], [1, 0]):(["a", "b"], [1, 2], [0, 1], [1, 0]) then prints:("1. b 2 (1 tags)\n2. a 1 (0 tags)\n")
([], [], [], []):([], [], [], [])
