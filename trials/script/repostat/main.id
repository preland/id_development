main(int argc, string[] argv) {
  int rc = 2;
  if (argc == 2) {
    rc = rs_run(argv[1]);
  } else {
    eprint("usage: repostat REPO");
  }
} return int rc;
(1, ["repostat"]):(2) then eprints:("usage: repostat REPO\n")
(2, ["repostat", "/no/such/repo_rs"]):(1) then eprints:("repostat: git log failed in /no/such/repo_rs (status 128); is it a git repository?\n")

rs_run(string repo) {
  int[] code = [0];
  string text = exec_out(string_join_around_middle("git\n-C\n", repo, "\nlog\n--date=short\n--pretty=format:%an%x09%ad%x09%s\n"), code);
  int rc = 1;
} chain (string repo) {
  if (code[0] == 0) {
    rc = rs_report(repo, text);
  } else {
    eprint("repostat: git log failed in " + repo + " (status " + code[0] + "); is it a git repository?");
  }
} return int rc;
