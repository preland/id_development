rs_files(string repo) {
  int[] code = [0];
  string text = exec_out("ls\n-l\n--time-style=+%F\n" + repo + "\n", code);
  string[] names = [];
} chain (string repo) {
  int[] sizes = [];
  rs_ls(text, names, sizes);
  print("files: " + len(names) + " (" + list_sum(sizes) + " bytes)");
} chain (string repo) {
  rs_big(names, sizes);
} return void;
