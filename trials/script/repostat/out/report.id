rs_report(string repo, string text) {
  string[][] rows = rs_rows(text);
  print("commits: " + len(rows));
  rs_authors(rows);
} chain (string repo, string text) {
  rs_span(rows);
  rs_longest(rows);
  rs_files(repo);
} return int 0;
