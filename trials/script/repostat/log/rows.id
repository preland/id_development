rs_rows(string text) {
  string[][] rows = [];
  string[] lines = str_lines(text);
  int i = 0;
} chain (string text) {
  while (i < len(lines)) {
    rs_row(rows, lines[i]);
    i = i + 1;
  }
} return string[][] rows;
("Al\t2026-01-02\tinit\nBo\t2026-02-03\tfix\n"):([["Al", "2026-01-02", "init"], ["Bo", "2026-02-03", "fix"]])
("garbage\nAl\t2026-01-02\tinit"):([["Al", "2026-01-02", "init"]])
(""):([])

rs_row(string[][] rows, string line) {
  string[] f = str_split(line, "\t");
  if (len(f) >= 3) {
    push(rows, f);
  }
} return void;
([], "a\tb\tc"):([["a", "b", "c"]], "a\tb\tc")
([], "a\tb"):([], "a\tb")

rs_col(string[][] rows, int c) {
  string[] out = [];
  int i = 0;
  while (i < len(rows)) {
    string[] r = rows[i];
    push(out, r[c]);
    i = i + 1;
  }
} return string[] out;
([["a", "b", "c"], ["d", "e", "f"]], 1):(["b", "e"])
([], 0):([])
