rs_span(string[][] rows) {
  string[] dates = rs_col(rows, 1);
  int[] ord = order_strings(dates);
  int last = len(ord) - 1;
} chain (string[][] rows) {
  if (last >= 0) {
    print("first: " + dates[ord[0]]);
    print("last: " + dates[ord[last]]);
  }
} return void;
([["a", "2026-02-03", "s"], ["b", "2026-01-02", "s"], ["c", "2026-03-04", "s"]]):([["a", "2026-02-03", "s"], ["b", "2026-01-02", "s"], ["c", "2026-03-04", "s"]]) then prints:("first: 2026-01-02\nlast: 2026-03-04\n")
([]):([])

rs_longest(string[][] rows) {
  string[] subjects = rs_col(rows, 2);
  int best = rs_widest(subjects);
  if (best >= 0) {
    print("longest subject: " + subjects[best]);
  }
} return void;
([["a", "d", "short"], ["b", "d", "a longer one"], ["c", "d", "also longer1"]]):([["a", "d", "short"], ["b", "d", "a longer one"], ["c", "d", "also longer1"]]) then prints:("longest subject: a longer one\n")
([]):([])

rs_widest(string[] subjects) {
  int best = 0 - 1;
  int i = 0;
  while (i < len(subjects)) {
    if (best < 0 || len(subjects[i]) > len(subjects[best])) {
      best = i;
    }
    i = i + 1;
  }
} return int best;
(["ab", "abc", "abd"]):(1)
([]):(-1)
