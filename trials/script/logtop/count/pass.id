// Count how often each key occurs over the lines, and answer the keys sorted with
// their counts alongside. key is the extractor (path or status); "" means the
// line has no such field and is not counted.

lt_pass(string[] lines, func(string) return string key, string[] ks, int[] vs) {
  string[] keys = [];
  int[] vals = [];
  int[] used = [];
} chain (string[] lines, func(string) return string key, string[] ks, int[] vs) {
  int[] cnt = [];
  hmap_init(keys, vals, used, cnt);
  lt_feed(lines, key, keys, vals, used, cnt);
} chain (string[] lines, func(string) return string key, string[] ks, int[] vs) {
  hmap_items(keys, vals, used, ks, vs);
} return void;
(["a \"GET /x HTTP/1.1\" 200", "a \"GET /y HTTP/1.1\" 200", "a \"GET /x HTTP/1.1\" 404"], lt_path, [], []):(["a \"GET /x HTTP/1.1\" 200", "a \"GET /y HTTP/1.1\" 200", "a \"GET /x HTTP/1.1\" 404"], lt_path, ["/x", "/y"], [2, 1])
(["a \"GET /x HTTP/1.1\" 200", "a \"GET /y HTTP/1.1\" 200", "a \"GET /x HTTP/1.1\" 404"], lt_status, [], []):(["a \"GET /x HTTP/1.1\" 200", "a \"GET /y HTTP/1.1\" 200", "a \"GET /x HTTP/1.1\" 404"], lt_status, ["200", "404"], [2, 1])

lt_feed(string[] lines, func(string) return string key, string[] keys, int[] vals, int[] used, int[] cnt) {
  int i = 0;
  while (i < len(lines)) {
    string k = key(lines[i]);
    if (k != "") {
      hmap_bump(keys, vals, used, cnt, k);
    }
    i = i + 1;
  }
} return void;
