lt_t_tab() {
  export string[] lt_tk = [];
  export int[] lt_tv = [];
  export int[] lt_tu = [];
} chain () {
  export int[] lt_tc = [];
  hmap_init((import lt_tk), (import lt_tv), (import lt_tu), (import lt_tc));
} return void;
():() then lt_t_count:(0)
():() then lt_t_hits:(0)

lt_t_count() {
  int n = hmap_count((import lt_tc));
} return int n;
given lt_t_tab ():(0)
given lt_t_tab given hmap_bump((import lt_tk), (import lt_tv), (import lt_tu), (import lt_tc), "/x") ():(1)

lt_t_hits() {
  int n = hmap_get((import lt_tk), (import lt_tv), (import lt_tu), "/x", 0);
} return int n;
given lt_t_tab ():(0)
given lt_t_tab given hmap_bump((import lt_tk), (import lt_tv), (import lt_tu), (import lt_tc), "/x") ():(1)
