lt_status(string line) {
  int b = lt_close(line);
  string s = "";
  if (b >= 0) {
    s = str_sub(line, b + 2, 3);
  }
} chain (string line) {
  int code = to_int(s);
  if (("" + code) != s) {
    s = "";
  }
} return string s;
("x \"GET / HTTP/1.1\" 200 5"):("200")
("x \"GET / HTTP/1.1\" 404 5"):("404")
("x \"GET / HTTP/1.1\" -  5"):("")
("garbage"):("")
