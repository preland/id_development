lines_from_files(string[] option_values, string[] rest) {
  int[] printed_counter = [0];
  int exit_code = 0;
  if (len(rest) == 0) {
    lines_from_text(read_all(), option_values, printed_counter);
  }
} chain (string[] option_values, string[] rest) {
  if (len(rest) > 0) {
    exit_code = lines_from_each_file(rest, option_values, printed_counter);
  }
} return int exit_code;
stdin "x\ny\n" (["0", "0", "", "0"], []):(0) then prints:("x\ny\n")
given fs_temp_text("p\nq\n") (["0", "0", "", "0"], [(import fs_temp_path)]):(0) then prints:("p\nq\n")

lines_from_each_file(string[] rest, string[] option_values, int[] printed_counter) {
  int exit_code = 0;
  int file_index = 0;
  while (file_index < len(rest)) {
    exit_code = exit_code + lines_from_one_file(rest[file_index], option_values, printed_counter);
    file_index = file_index + 1;
  }
} return int exit_code;
given fs_temp_text("a\n") ([(import fs_temp_path), "/no/such/file_ln"], ["0", "0", "", "0"], [0]):(1) then prints:("a\n") then eprints:("lines: cannot read /no/such/file_ln\n")
([], [], [0]):(0)

lines_from_one_file(string path, string[] option_values, int[] printed_counter) {
  int exit_code = 0;
  if (fs_exists(path) == 1) {
    lines_from_text(fs_read_text(path), option_values, printed_counter);
  } else {
    eprint("lines: cannot read " + path);
    exit_code = 1;
  }
} return int exit_code;
given fs_temp_text("z\n") ((import fs_temp_path), ["0", "0", "", "0"], [0]):(0) then prints:("z\n")
("/no/such/file_ln", [], [0]):(1) then eprints:("lines: cannot read /no/such/file_ln\n")
