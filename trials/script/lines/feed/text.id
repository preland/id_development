ln_feed(string text, string[] vals, int[] st) {
  string[] lines = string_lines(text);
  int i = 0;
  while (i < len(lines)) {
    ln_emit(vals, st, lines[i]);
    i = i + 1;
  }
} return void;
("a\nb\n", ["0", "0", "", "0"], [0]):("a\nb\n", ["0", "0", "", "0"], [2]) then prints:("a\nb\n")
("", ["0", "0", "", "0"], [0]):("", ["0", "0", "", "0"], [0])

ln_emit(string[] vals, int[] st, string line) {
  int skip = (vals[(import ln_v_skip)] == "1") * (line == "");
  int most = to_int(vals[(import ln_v_max)]);
  int stop = (most > 0) * (st[0] >= most);
} chain (string[] vals, int[] st, string line) {
  if (skip == 0 && stop == 0) {
    st[0] = st[0] + 1;
    print(ln_line(vals, st[0], line));
  }
} return void;
(["0", "0", "", "0"], [0], "x"):(["0", "0", "", "0"], [1], "x") then prints:("x\n")
(["0", "0", "", "1"], [0], ""):(["0", "0", "", "1"], [0], "")
(["0", "1", "", "0"], [1], "x"):(["0", "1", "", "0"], [1], "x")
(["1", "0", "", "0"], [4], "x"):(["1", "0", "", "0"], [5], "x") then prints:("5: x\n")

ln_line(string[] vals, int n, string line) {
  string prefix = vals[(import ln_v_prefix)];
  string num = "";
  if (vals[(import ln_v_number)] == "1") {
    num = n + ": ";
  }
} chain (string[] vals, int n, string line) {
  string out = prefix + num + line;
} return string out;
(["1", "0", "> ", "0"], 3, "x"):("> 3: x")
(["0", "0", "", "0"], 3, "x"):("x")
