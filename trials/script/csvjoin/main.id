main(int argc, string[] argv) {
  int rc = 2;
  if (argc == 3) {
    rc = cj_run(argv[1], argv[2]);
  } else {
    eprint("usage: csvjoin CUSTOMERS.csv ORDERS.csv");
  }
} return int rc;
