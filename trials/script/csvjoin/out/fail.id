join_report_diagnostics(string[] diag) {
  int i = 0;
  while (i < len(diag)) {
    eprint("csvjoin: " + diag[i]);
    i = i + 1;
  }
  int rc = len(diag) > 0;
} return int rc;
([]):(0)
(["cannot read: no such file or directory"]):(1) then eprints:("csvjoin: cannot read: no such file or directory\n")

join_format_money(int cents) {
  int c = cents % 100;
  string lead = "";
  if (c < 10) {
    lead = "0";
  }
} chain (int cents) {
  string s = (cents / 100) + "." + lead + c;
} return string s;
(250):("2.50")
(7):("0.07")
(1999):("19.99")
