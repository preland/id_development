// Two readings of the stream the fixtures opened.

// The ring size of the stream in pl_t_h, in frames.
pl_t_ring() {
  int pl_th = (import pl_t_h);
  int pl_tr = audio_info(pl_th, (import audio_i_ring));
} return int pl_tr;
given pl_t_stream (800) ():(800)
given pl_t_stream (16) ():(16)

// The frames waiting in the ring of the stream in pl_t_h: its size less the room left.
pl_t_queued() {
  int pl_th = (import pl_t_h);
  int pl_tg = audio_info(pl_th, (import audio_i_ring)) - audio_avail(pl_th);
} return int pl_tg;
given pl_t_stream (800) ():(0)
given pl_t_stream (800) given pl_t_write ((import pl_t_h), 800) ():(800)
