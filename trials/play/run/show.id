// Writes SECONDS seconds of a mono 48000 Hz 16-bit sine of pl_hz hertz at pl_milli thousandths of full scale to the WAV file pl_out and says how big it is. Answers 0, or 1 with a line on standard error when the file will not open.
pl_tone(string pl_out, int pl_hz, int pl_milli, int pl_secs) {
  int pl_frames = 48000 * pl_secs;
  word pl_buf = alloc(pl_frames * 2 + 8);
  int pl_amp = pl_milli * 32767 / 1000;
} chain (string pl_out, int pl_hz, int pl_milli, int pl_secs) {
  int pl_made = aud_sine_s16(pl_buf, pl_frames, 1, pl_hz, 48000, pl_amp);
  int pl_size = wav_save(pl_out, 0, 1, 48000, pl_buf, pl_frames);
  int pl_rc = 1;
} chain (string pl_out, int pl_hz, int pl_milli, int pl_secs) {
  if (pl_size >= 0) {
    print("wrote " + pl_size + " bytes: " + pl_frames + " frames of " + pl_hz + " Hz, " + pl_milli + "/1000 of full scale, 48000 Hz mono 16-bit");
    pl_rc = 0;
  }
  if (pl_size < 0) {
    eprint("play: cannot write " + pl_out + ": check that its directory exists and is writable");
  }
} return int pl_rc;
