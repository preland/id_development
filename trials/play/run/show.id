// What a play run prints, and the tone writer.

// Prints the three lines a run ends with: the file, the stream (backend, ring, quantum, and pl_dl, the delay sampled during the run) and the counters (frames moved, xruns, frames lost).
pl_report(int pl_h, int[] pl_info, int pl_dl) {
  string[] pl_fmts = ["s16", "f32"];
  string[] pl_bes = ["null", "pw"];
  print("play: " + pl_info[6] + " frames, " + pl_info[3] + " Hz, " + pl_info[2] + " ch, " + pl_fmts[pl_info[1]]);
} chain (int pl_h, int[] pl_info, int pl_dl) {
  int pl_ri = aud_info(pl_h, (import aud_i_ring));
  int pl_q = aud_info(pl_h, (import aud_i_quantum));
  int pl_be = aud_info(pl_h, (import aud_i_back));
} chain (int pl_h, int[] pl_info, int pl_dl) {
  print("play: backend " + pl_bes[pl_be] + ", ring " + pl_ri + " frames, quantum " + pl_q + " frames, delay " + pl_dl + " frames");
  int pl_mv = aud_moved(pl_h);
  int pl_xr = aud_xruns(pl_h);
} chain (int pl_h, int[] pl_info, int pl_dl) {
  int pl_lo = aud_info(pl_h, (import aud_i_lost));
  print("play: moved " + pl_mv + " frames, " + pl_xr + " xruns, " + pl_lo + " frames lost");
} return void;
