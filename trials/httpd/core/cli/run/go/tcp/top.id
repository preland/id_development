server_tcp_up(int listener, string host, string[] options, int rounds) {
  int exit_status = 1;
  if(listener >= 0) {
    exit_status = server_tcp_run(listener, host, options[1], rounds);
  }
  if(listener < 0) {
    server_tcp_fail(host, options[0]);
  }
} return int exit_status;
given server_fixture_listener ((import fixture_listener), "127.0.0.1", ["0", "/tmp", "", ""], 0):(0) then server_fixture_close_sockets:(0)
(-1, "999.1.1.1", ["5", "/tmp", "", "999.1.1.1"], 0):(1) then eprints:("httpd: cannot listen on 999.1.1.1:5 (error 0); --host must be a numeric address such as 127.0.0.1 or 0.0.0.0, and --port a free port\n")

server_tcp_go(string[] options, int rounds) {
  string host = server_host_address(options);
  int listener = sock_tcp_listen(host, to_int(options[0]), (import server_backlog));
  int exit_status = server_tcp_up(listener, host, options, rounds);
} return int exit_status;
(["0", "/tmp", "", ""], 0):(0)
(["5", "/tmp", "", "999.1.1.1"], 0):(1) then eprints:("httpd: cannot listen on 999.1.1.1:5 (error 99); --host must be a numeric address such as 127.0.0.1 or 0.0.0.0, and --port a free port\n")

server_mode(string[] options) {
  int exit_status = 0;
  if(len(options[0]) == 0) {
    exit_status = server_serve_standard_streams(options);
  }
  if(len(options[0]) > 0) {
    exit_status = server_tcp_go(options, -1);
  }
} return int exit_status;
