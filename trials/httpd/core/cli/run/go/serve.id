server_banner(string[] options) {
  string banner_text = "httpd: serving " + options[1] + " over stdin/stdout (inetd style; give --port N to listen)";
} return string banner_text;
(["", "/srv", "", ""]):("httpd: serving /srv over stdin/stdout (inetd style; give --port N to listen)")
(["", "/", "", ""]):("httpd: serving / over stdin/stdout (inetd style; give --port N to listen)")

server_serve_standard_streams(string[] options) {
  string banner_text = server_banner(options);
  eprint(banner_text);
  word connection_buffer = alloc(70000);
} chain (string[] options) {
  string root = options[1];
  func(string[], string[]) return int request_handler = bind(server_handle, root);
  int served = http_serve_conn(-1, connection_buffer, request_handler, http_options(1), "-");
} return int served;
stdin "" (["", "/tmp", "", ""]):(0) then eprints:("httpd: serving /tmp over stdin/stdout (inetd style; give --port N to listen)\n")
stdin "" (["", "/", "", ""]):(0) then eprints:("httpd: serving / over stdin/stdout (inetd style; give --port N to listen)\n")

server_run(string[] options, string message) {
  int exit_status = 2;
  if(len(message) > 0) {
    server_usage(message);
  }
  if(len(message) == 0) {
    exit_status = server_mode(options);
  }
} return int exit_status;
(["", "", "", ""], "bad"):(2) then eprints:("httpd: bad\nusage: httpd [--port N] [--host ADDR] --root DIR\n")
stdin "" (["", "/tmp", "", ""], ""):(0)
