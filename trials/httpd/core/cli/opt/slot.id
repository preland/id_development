server_option_slot(string flag) {
  int slot = -1;
  if(flag == "--port") {
    slot = 0;
  }
  if(flag == "--root") {
    slot = 1;
  }
} chain (string flag) {
  if(flag == "--host") {
    slot = 3;
  }
} return int slot;
("--port"):(0)
("--root"):(1)
("--host"):(3)
("--x"):(-1)

server_argument_at(string[] argument_values, int argument_index) {
  string argument_text = "";
  if(argument_index < len(argument_values)) {
    argument_text = argument_values[argument_index];
  }
} return string argument_text;
(["a", "b"], 1):("b")
(["a", "b"], 2):("")

server_option_store(string[] options, int slot, string option_value, string flag) {
  if(slot >= 0 && len(option_value) > 0) {
    options[slot] = option_value;
  }
  if(slot >= 0 && len(option_value) == 0 && len(options[2]) == 0) {
    options[2] = flag + " needs a value";
  }
  if(slot < 0 && len(options[2]) == 0) {
    options[2] = "unknown argument: " + flag;
  }
} return void;
(["", "", "", ""], 0, "80", "--port"):(["80", "", "", ""], 0, "80", "--port")
(["", "", "", ""], 1, "", "--root"):(["", "", "--root needs a value", ""], 1, "", "--root")
(["", "", "", ""], -1, "z", "--zap"):(["", "", "unknown argument: --zap", ""], -1, "z", "--zap")
(["", "", "", ""], 3, "0.0.0.0", "--host"):(["", "", "", "0.0.0.0"], 3, "0.0.0.0", "--host")
(["", "", "first", ""], -1, "z", "--zap"):(["", "", "first", ""], -1, "z", "--zap")
