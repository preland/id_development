hd_arg_step(string[] av, string[] opts, int i) {
  string sa = av[i];
  int k = hd_opt_slot(sa);
  string val = hd_arg_at(av, i + 1);
} chain (string[] av, string[] opts, int i) {
  hd_opt_put(opts, k, val, sa);
  int nx = i + 2;
  if(k < 0) {
    nx = i + 1;
  }
} return int nx;
(["p", "--port", "80"], ["", "", "", ""], 1):(3)
(["p", "--zap", "80"], ["", "", "", ""], 1):(2)

hd_args(string[] av) {
  string[] opts = ["", "", "", ""];
  int i = 1;
  while(i < len(av)) {
    i = hd_arg_step(av, opts, i);
  }
} return string[] opts;
(["p", "--port", "80", "--root", "/tmp"]):(["80", "/tmp", "", ""])
(["p"]):(["", "", "", ""])
(["p", "--root"]):(["", "", "--root needs a value", ""])
(["p", "--host", "0.0.0.0", "--port", "0"]):(["0", "", "", "0.0.0.0"])
(["p", "bogus", "--port", "1"]):(["1", "", "unknown argument: bogus", ""])

hd_port_ok(string p) {
  int ok = 0;
  if(hd_digits(p) == 1 && len(p) < 6) {
    int n = to_int(p);
    if(n >= 0 && n < 65536) {
      ok = 1;
    }
  }
} return int ok;
("8080"):(1)
("0"):(1)
("-1"):(0)
("65536"):(0)
("65535"):(1)
("80a"):(0)
(""):(0)
