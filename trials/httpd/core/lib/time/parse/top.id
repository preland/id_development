// hd_date_parse: the exact inverse of hd_date_fmt. Only IMF-fixdate is
// accepted; the two obsolete formats RFC 9110 lets a recipient read are
// rejected on purpose, because a static file server only compares this value
// with dates it produced itself, and refusing is the safe answer to a
// malformed conditional header.
// hd_date_rt exists to pin the inverse property with a case, since a case's
// arguments must be literals and cannot call hd_date_fmt themselves.

hd_date_total(string d_s) {
  int d_days = hd_date_dayn(d_s);
  int d_sod = hd_date_sod(d_s);
  int d_r = hd_date_join(d_s, d_days, d_sod);
} return int d_r;
