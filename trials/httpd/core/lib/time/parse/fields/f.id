// Field extraction from the fixed layout "Sun, 06 Nov 1994 08:49:37 GMT":
// weekday 0, day 5, month 8, year 12, hour 17, minute 20, second 23. Each
// returns -1 for anything it cannot vouch for.

hd_date_sod(string d_s) {
  int d_v = hd_date_sodv(hd_date_num(d_s, 17, 2), hd_date_num(d_s, 20, 2), hd_date_num(d_s, 23, 2));
} return int d_v;
("Sun, 06 Nov 1994 08:49:37 GMT"):(31777)
("Sun, 06 Nov 1994 0x:49:37 GMT"):(-1)
("Sun, 06 Nov 1994 24:00:00 GMT"):(-1)
("Sun, 06 Nov 1994 23:59:59 GMT"):(86399)

hd_date_daysv(int d_y, int d_m, int d_d) {
  int d_r = 0 - 1;
  if(d_y >= 1970 && hd_date_dayok(d_y, d_m, d_d) == 1) {
    d_r = hd_date_days(d_y, d_m, d_d);
  }
} return int d_r;
(1994, 11, 6):(9075)
(1969, 12, 31):(-1)
(2019, 2, 29):(-1)
(2024, 2, 29):(19782)
(1970, 1, 1):(0)

hd_date_dayn(string d_s) {
  string d_key = str_slice(d_s, 8, 3);
  int d_r = hd_date_daysv(hd_date_num(d_s, 12, 4), hd_date_tbl("JanFebMarAprMayJunJulAugSepOctNovDec", d_key) + 1, hd_date_num(d_s, 5, 2));
} return int d_r;
("Sun, 06 Nov 1994 08:49:37 GMT"):(9075)
("Sun, 06 nov 1994 08:49:37 GMT"):(-1)
("Sun, 31 Apr 2023 08:49:37 GMT"):(-1)
("Thu, 29 Feb 2024 00:00:00 GMT"):(19782)
("Sun, 0x Nov 1994 08:49:37 GMT"):(-1)
("Sun, 06 Nov 19x4 08:49:37 GMT"):(-1)
