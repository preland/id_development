// Cross-field rules: the weekday must be the real one, and the instant must fit
// a 32-bit int. The range test is on (days, seconds-of-day) rather than on the
// product, because days * 86400 overflows int for any year past 2038 and a
// wrapped value would pass a "<= 2147483647" test.

hd_date_wdok(string d_s, int d_days) {
  int d_ok = 0;
  if(hd_date_tbl("SunMonTueWedThuFriSat", str_slice(d_s, 0, 3)) == (d_days + 4) % 7) {
    d_ok = 1;
  }
} return int d_ok;
("Sun, 06 Nov 1994 08:49:37 GMT", 9075):(1)
("Mon, 06 Nov 1994 08:49:37 GMT", 9075):(0)
("Foo, 06 Nov 1994 08:49:37 GMT", 9075):(0)
("Thu, 01 Jan 1970 00:00:00 GMT", 0):(1)

hd_date_inrange(int d_days, int d_sod) {
  int d_ok = 0;
  if(d_days < 24855 || (d_days == 24855 && d_sod <= 11647)) {
    d_ok = 1;
  }
} return int d_ok;
(24855, 11647):(1)
(24855, 11648):(0)
(24856, 0):(0)
(0, 0):(1)

hd_date_join(string d_s, int d_days, int d_sod) {
  int d_r = 0 - 1;
  if(d_days >= 0 && d_sod >= 0 && hd_date_inrange(d_days, d_sod) == 1 && hd_date_wdok(d_s, d_days) == 1) {
    d_r = d_days * 86400 + d_sod;
  }
} return int d_r;
("Sun, 06 Nov 1994 08:49:37 GMT", 9075, 31777):(784111777)
("Sun, 06 Nov 1994 08:49:37 GMT", -1, 31777):(-1)
("Sun, 06 Nov 1994 08:49:37 GMT", 9075, -1):(-1)
("Sun, 06 Nov 1994 08:49:37 GMT", 24856, 0):(-1)
("Mon, 06 Nov 1994 08:49:37 GMT", 9075, 31777):(-1)
