// Reading fixed-width fields out of an IMF-fixdate. Digits are checked before
// they are converted because to_int accepts a leading sign and stops at the
// first non-digit, which would let "6x" and "+6" through as 6.

hd_date_digits(string d_s, int d_pos, int d_n) {
  int d_i = 0;
  while(d_i < d_n && chr_is_digit(charat(d_s, d_pos + d_i)) == 1) {
    d_i = d_i + 1;
  }
} return int d_i;
("Sun, 06", 5, 2):(2)
("Sun, 0x", 5, 2):(1)
("ab", 0, 2):(0)
("12", 0, 4):(2)

hd_date_num(string d_s, int d_pos, int d_n) {
  int d_v = 0 - 1;
  if(hd_date_digits(d_s, d_pos, d_n) == d_n) {
    d_v = to_int(str_slice(d_s, d_pos, d_n));
  }
} return int d_v;
("Sun, 06", 5, 2):(6)
("Sun, 0x", 5, 2):(-1)
("1994", 0, 4):(1994)
("x994", 0, 4):(-1)
("+6", 0, 2):(-1)
("12", 0, 4):(-1)

hd_date_tbl(string d_tbl, string d_key) {
  int d_r = 0 - 1;
  int d_p = str_find(d_tbl, d_key);
  if(d_p >= 0 && d_p % 3 == 0 && len(d_key) == 3) {
    d_r = d_p / 3;
  }
} return int d_r;
("JanFebMar", "Feb"):(1)
("JanFebMar", "Jan"):(0)
("JanFebMar", "anF"):(-1)
("JanFebMar", "Xyz"):(-1)
("JanFebMar", "feb"):(-1)
("JanFebMar", "Ja"):(-1)
("JanFebMar", ""):(-1)
