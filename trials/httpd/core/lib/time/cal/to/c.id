// Entry point of the days-to-date direction: a day count since 1970-01-01 in,
// YYYYMMDD out. 719468 shifts the epoch to 0000-03-01, where eras begin.

hd_date_pack(int d_era, int d_doe) {
  int d_doy = hd_date_doy(d_doe);
  int d_yoe = hd_date_yoe(d_doe);
  int d_r = hd_date_pack2(d_yoe, d_era, d_doy, (5 * d_doy + 2) / 153);
} return int d_r;
(4, 135080):(19700101)
(4, 144155):(19941106)

hd_date_ymd(int d_days) {
  int d_z = d_days + 719468;
  int d_r = hd_date_pack(d_z / 146097, d_z % 146097);
} return int d_r;
