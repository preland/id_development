// The date-to-days direction, part two, and the calendar's length rules. Every
// validity decision in the parser goes through hd_date_leap / hd_date_mdays so
// there is one answer to "how long is this month".

hd_date_leap(int d_y) {
  int d_ok = 0;
  if(d_y % 4 == 0 && (d_y % 100 != 0 || d_y % 400 == 0)) {
    d_ok = 1;
  }
} return int d_ok;
(2000):(1)
(1900):(0)
(2100):(0)
(2024):(1)
(2023):(0)

hd_date_mdays(int d_y, int d_m) {
  int d_n = 30 + (d_m + d_m / 8) % 2;
  if(d_m == 2) {
    d_n = 28 + hd_date_leap(d_y);
  }
} return int d_n;
(2024, 2):(29)
(2023, 2):(28)
(2000, 2):(29)
(1900, 2):(28)
(2023, 1):(31)
(2023, 3):(31)
(2023, 4):(30)
(2023, 7):(31)
(2023, 8):(31)
(2023, 9):(30)
(2023, 10):(31)
(2023, 11):(30)
(2023, 12):(31)

hd_date_days(int d_y, int d_m, int d_d) {
  int d_yy = hd_date_yadj(d_y, d_m);
  int d_doy = hd_date_doym(d_m, d_d);
  int d_r = (d_yy / 400) * 146097 + (d_yy % 400) * 365 + (d_yy % 400) / 4 - (d_yy % 400) / 100 + d_doy - 719468;
} return int d_r;
(1970, 1, 1):(0)
(1994, 11, 6):(9075)
(2024, 2, 29):(19782)
(2038, 1, 19):(24855)
(2000, 3, 1):(11017)
