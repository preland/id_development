hd_t_norm(string txt) {
  int k = str_find(txt, "Last-Modified: ");
  while(k >= 0) {
    txt = hd_t_lm1(txt, k);
    k = str_findat(txt, "Last-Modified: ", k + 16);
  }
} return string txt;
("a"):("a")
