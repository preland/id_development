hd_t_slurp(string path) {
  int n = fs_size(path);
  word ad = alloc(n + 1);
  int h = fs_open(path, "r");
} chain (string path) {
  int g = fs_read_mem(h, ad, n);
  fs_close(h);
  string tx = str_of_mem(ad, n);
} return string tx;
