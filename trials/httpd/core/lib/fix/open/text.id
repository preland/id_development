hd_t_lm1(string txt, int k) {
  string sa = str_slice(txt, 0, k + 15);
  int r = len(txt) - k - 44;
  string sb = str_slice(txt, k + 44, r);
} chain (string txt, int k) {
  string z = sa + "X" + sb;
} return string z;
