hd_t_wire(string p, string q, string src) {
  export string hd_t_outp = p;
  int ho = fs_open(p, "a");
  int hi = fs_open(src, "r");
} chain (string p, string q, string src) {
  export int hd_t_ho = ho;
  word bf = alloc((import hd_chunk));
  export word[] hd_t_io = [hi, ho, bf];
} chain (string p, string q, string src) {
  export string[] hd_t_cn = ["", p, "-"];
  export string hd_t_inp = q;
  export int hd_t_hin = hi;
} return void;
("/dev/null", "", "/dev/null"):() then hd_t_head:("")
("/dev/null", "", "/dev/stdin"):() then hd_t_head:("")

hd_t_open() {
  hd_t_mem();
  string p = fs_mktemp("hdt", 0);
  hd_t_wire(p, "", "/dev/stdin");
} return void;
():() then hd_t_out:("")
():() then hd_t_head:("") then hd_t_out:("")

hd_t_opennul() {
  hd_t_mem();
  string p = fs_mktemp("hdt", 0);
  string q = fs_mktemp("hdt", 0);
} chain () {
  int h = fs_open(q, "w");
  int w = fs_write_mem(h, (import hd_t_ad), 4);
  fs_close(h);
} chain () {
  hd_t_wire(p, q, q);
} return void;
():() then hd_t_out:("")
():() then hd_t_head:("") then hd_t_out:("")
