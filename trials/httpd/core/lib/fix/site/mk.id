server_fixture_site() {
  string root = fs_mktemp("hdt", 1);
  fs_drop_exit(root);
  export string fixture_root = root;
} chain () {
  export string fixture_root_slash = root + "/";
  export string fixture_file_path = root + "/a.txt";
  export string fixture_index_directory = root + "/idx/";
} chain () {
  server_fixture_populate_site(root);
} return void;
():() then server_fixture_discard_site:(1)
():() then server_fixture_file_size_text:("asize 6") then server_fixture_discard_site:(1)

server_fixture_write_file(string path, string file_text) {
  int file_handle = fs_open(path, "w");
  word memory_address = mem_of_str(file_text);
  int byte_count = len(file_text);
} chain (string path, string file_text) {
  int bytes_written = fs_write_mem(file_handle, memory_address, byte_count);
  fs_close(file_handle);
} return int bytes_written;
("/dev/null", "abc"):(3)
("/dev/null", ""):(0)

server_fixture_populate_site(string root) {
  server_fixture_write_file(root + "/a.txt", "hello\n");
  server_fixture_write_file(root + "/sp ace.txt", "sp\n");
  fs_mkdir(root + "/sub");
} chain (string root) {
  fs_mkdir(root + "/idx");
  server_fixture_write_file(root + "/idx/index.html", "<p>idx</p>\n");
} return void;
("/nonexistent-hd-x"):("/nonexistent-hd-x")
("/nonexistent-hd-y/z"):("/nonexistent-hd-y/z")
