hd_t_site() {
  string root = fs_mktemp("hdt", 1);
  export string hd_t_root = root;
  export string hd_t_dir = root + "/";
} chain () {
  export string hd_t_apath = root + "/a.txt";
  export string[] hd_t_fout = ["", hd_t_apath];
  hd_t_fill(root);
} return void;
():() then hd_t_drop:(1)
():() then hd_t_asize:(6) then hd_t_drop:(1)

hd_t_put(string path, string txt) {
  int h = fs_open(path, "w");
  word ad = mem_of_str(txt);
  int n = len(txt);
} chain (string path, string txt) {
  int w = fs_write_mem(h, ad, n);
  fs_close(h);
} return int w;
("/dev/null", "abc"):(3)
("/dev/null", ""):(0)

hd_t_fill(string root) {
  hd_t_put(root + "/a.txt", "hello\n");
  hd_t_put(root + "/sp ace.txt", "sp\n");
  fs_mkdir(root + "/sub");
} chain (string root) {
  fs_mkdir(root + "/idx");
  hd_t_put(root + "/idx/index.html", "<p>idx</p>\n");
} return void;
("/nonexistent-hd-x"):("/nonexistent-hd-x")
("/nonexistent-hd-y/z"):("/nonexistent-hd-y/z")
