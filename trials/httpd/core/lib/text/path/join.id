// The two helpers hd_norm needs that would not fit beside it in one file.

// Pops one segment; 0 when there is nothing to pop, i.e. the path climbs
// above the root.
hd_norm_up(string[] t_st) {
  int t_ok = 0;
  if(len(t_st) > 0) {
    string t_x = pop(t_st);
    t_ok = 1;
  }
} return int t_ok;
([]):(0)
(["a"]):(1)

// Rebuilds the path from the surviving segments; the trailing slash is the
// original's, and never doubled onto the bare root.
hd_norm_join(string t_s, string[] t_st) {
  string t_j = str_join(t_st, "/");
  string t_o = "/" + t_j;
  if(len(t_j) > 0 && str_ends(t_s, "/") == 1) {
    t_o = t_o + "/";
  }
} return string t_o;
("/a/", ["a"]):("/a/")
("/a", ["a"]):("/a")
("/", []):("/")
("/x/y/", ["x", "y"]):("/x/y/")
("/../", []):("/")
