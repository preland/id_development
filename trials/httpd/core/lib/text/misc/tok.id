// RFC 9110 token characters (method names, header field names) and ASCII digit
// strings (Content-Length, ports, Range offsets).

hd_tchar(int t_c) {
  int t_r = chr_is_alnum(t_c);
  int t_k = 0 - 1;
  if(t_c > 32 && t_c < 127) {
    t_k = str_find("!#$%&'*+-.^_`|~", chr(t_c));
  }
} chain (int t_c) {
  if(t_k >= 0) {
    t_r = 1;
  }
} return int t_r;
(97):(1)
(57):(1)
(33):(1)
(126):(1)
(96):(1)
(124):(1)
(58):(0)
(32):(0)
(34):(0)
(40):(0)
(47):(0)
(127):(0)
(200):(0)
(-1):(0)
(13):(0)

hd_digits(string t_s) {
  int t_n = len(t_s);
  int t_i = hd_digit_end(t_s);
  int t_r = 0;
} chain (string t_s) {
  if(t_n > 0 && t_i == t_n) {
    t_r = 1;
  }
} return int t_r;
("0"):(1)
("1234567890"):(1)
(""):(0)
("12a"):(0)
("-1"):(0)
(" 1"):(0)
("1.5"):(0)

// Index of the first non-digit byte, or the length if all are digits.
hd_digit_end(string t_s) {
  int t_i = 0;
  while(charat(t_s, t_i) >= 0 && chr_is_digit(charat(t_s, t_i)) == 1) {
    t_i = t_i + 1;
  }
} return int t_i;
("123ab"):(3)
("abc"):(0)
("99"):(2)
(""):(0)
