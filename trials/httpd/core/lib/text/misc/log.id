// Log-line sanitising. Anything a client controls (target, headers) is written
// with control bytes, quotes, backslashes and non-ASCII as \xHH so one request
// can never forge or split a log line.

hd_log_clean(string t_s) {
  string t_o = "";
  int t_i = 0;
  t_o = hd_log_run(t_s, t_i, t_o);
} return string t_o;
(""):("")
("GET /a b"):("GET /a b")
("a\r\nb"):("a\\x0d\\x0ab")
("say \"hi\"\\"):("say \\x22hi\\x22\\x5c")
("€"):("\\xe2\\x82\\xac")
("\x7f~"):("\\x7f~")

hd_log_run(string t_s, int t_i, string t_o) {
  while(charat(t_s, t_i) >= 0) {
    string t_p = str_slice(t_s, t_i, 1);
    t_o = t_o + hd_log_one(t_p);
    t_i = t_i + 1;
  }
} return string t_o;
("a\n", 0, ""):("a\\x0a")
("a\n", 1, "Z"):("Z\\x0a")
("a\n", 2, "Z"):("Z")

hd_log_one(string t_p) {
  int t_c = charat(t_p, 0);
  string t_o = t_p;
  if(t_c < 32 || t_c > 126 || t_c == 34 || t_c == 92) {
    t_o = "\\x" + hd_hex2(t_c);
  }
} return string t_o;
("a"):("a")
(" "):(" ")
("~"):("~")
("\n"):("\\x0a")
("\x1f"):("\\x1f")
("\x7f"):("\\x7f")
("\""):("\\x22")
("\\"):("\\x5c")
