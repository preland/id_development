// Hex-digit plumbing behind percent decoding. Kept apart from ok.id so the
// validity rule and the digit arithmetic are each a page long.

// The byte named by two hex digits at i and i+1, or -1 if either is not hex.
hd_pct_hex2(string t_s, int t_i) {
  int t_h = hd_hexval(charat(t_s, t_i));
  int t_l = hd_hexval(charat(t_s, t_i + 1));
  if(t_h < 0 || t_l < 0) {
    int t_bad = 0 - 1;
    return t_bad;
  }
} chain (string t_s, int t_i) {
  int t_r = t_h * 16 + t_l;
} return int t_r;
("41", 0):(65)
("xx4a", 2):(74)
("fF", 0):(255)
("4", 0):(-1)
("g1", 0):(-1)
("1g", 0):(-1)
("", 0):(-1)

// 0..15 for a hex digit of either case, -1 for anything else including -1.
hd_hexval(int t_c) {
  int t_l = chr_lower(t_c);
  int t_r = 0 - 1;
  if(t_c >= 48 && t_c <= 57) {
    t_r = t_c - 48;
  }
} chain (int t_c) {
  if(t_l >= 97 && t_l <= 102) {
    t_r = t_l - 87;
  }
} return int t_r;
(48):(0)
(57):(9)
(65):(10)
(102):(15)
(70):(15)
(71):(-1)
(103):(-1)
(47):(-1)
(58):(-1)
(96):(-1)
(-1):(-1)

// -1 for bytes an escape or a raw byte may not denote (controls and DEL).
hd_pct_ctl(int t_b) {
  int t_r = t_b;
  if(t_b < 32 || t_b == 127) {
    t_r = 0 - 1;
  }
} return int t_r;
(65):(65)
(31):(-1)
(32):(32)
(126):(126)
(127):(-1)
(200):(200)
(-1):(-1)
