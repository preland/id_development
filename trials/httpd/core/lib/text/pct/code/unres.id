// The unreserved set for hd_pct_encode, and the two-digit hex used by both the
// encoder and the log escaper.

hd_pct_unres(int t_c) {
  int t_r = chr_is_alnum(t_c);
  if(t_c == 45 || t_c == 46 || t_c == 47 || t_c == 95 || t_c == 126) {
    t_r = 1;
  }
} return int t_r;
(97):(1)
(48):(1)
(45):(1)
(47):(1)
(126):(1)
(46):(1)
(95):(1)
(32):(0)
(37):(0)
(63):(0)
(200):(0)
(-1):(0)

// Exactly two lowercase hex digits for a byte 0..255.
hd_hex2(int t_c) {
  string t_f = fmt_hex(t_c);
  string t_x = str_slice(t_f, 6, 2);
} return string t_x;
(0):("00")
(10):("0a")
(255):("ff")
(171):("ab")
