hd_before(string s, string sep) {
  int k = str_find(s, sep);
  string rs = s;
  if(k >= 0) {
    rs = str_slice(s, 0, k);
  }
} return string rs;
("a?b", "?"):("a")
("ab", "?"):("ab")
("?b", "?"):("")

hd_after_sep(string s, string sep) {
  int k = str_find(s, sep);
  string rs = "";
  if(k >= 0) {
    int a = k + len(sep);
    rs = str_slice(s, a, len(s) - a);
  }
} return string rs;
("a?b=1", "?"):("b=1")
("ab", "?"):("")
("a\rs\nB", "\rs\n"):("B")
("a?", "?"):("")

hd_origin(string tg) {
  if(str_starts(tg, "/") == 1) {
    return tg;
  }
  string og = "";
  if(str_starts(tg, "http://") == 1) {
    og = hd_strip_auth(tg);
  }
} return string og;
("/a/b?x"):("/a/b?x")
("http://h.example/p?q"):("/p?q")
("http://h.example"):("/")
("a/b"):("")
("*"):("")
