hd_path_val(string pth) {
  string nrm = hd_norm(hd_pct_decode(pth));
} return string nrm;
("/a%20b/../c"):("/c")
("/x//y/"):("/x/y/")

hd_rq_path(string[] rq, string pth, string qry) {
  string nrm = hd_path_val(pth);
  rq[3] = nrm;
  rq[4] = qry;
} return void;
(["", "", "", "", "", "", "", ""], "/a%20b", "q=1"):(["", "", "", "/a b", "q=1", "", "", ""], "/a%20b", "q=1")
(["m", "t", "v", "old", "old", "c", "b", "l"], "/", ""):(["m", "t", "v", "/", "", "c", "b", "l"], "/", "")

hd_path_set(string og, string[] rq) {
  string o1 = hd_before(og, "#");
  string pth = hd_before(o1, "?");
  string qry = hd_after_sep(o1, "?");
} chain (string og, string[] rq) {
  int st = hd_path_st(pth, qry);
  if(st == 0) {
    hd_rq_path(rq, pth, qry);
  }
} return int st;
("/a?x=1#frag", ["", "", "", "", "", "", "", ""]):(0)
("/../a?x=1", ["", "", "", "", "", "", "", ""]):(403)
("/a%zz", ["", "", "", "", "", "", "", ""]):(400)

