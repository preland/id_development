hd_strip_auth(string tg) {
  int k = str_findat(tg, "/", 7);
  string og = "/";
  if(k > 0) {
    og = str_slice(tg, k, len(tg) - k);
  }
} return string og;
("http://h/a/b"):("/a/b")
("http://h"):("/")
("http://h:80/"):("/")

hd_norm_st(string pth) {
  string nrm = hd_norm(hd_pct_decode(pth));
  int st = 403;
  if(len(nrm) > 0) {
    st = 0;
  }
} return int st;
("/a/../b"):(0)
("/../etc/passwd"):(403)
("/%2e%2e/x"):(403)
("/a%2fb/"):(0)

hd_path_st(string pth, string qry) {
  int ok = hd_pct_ok(pth) & hd_value_ok(qry, 0);
  int st = 400;
  if(ok == 1) {
    st = hd_norm_st(pth);
  }
} return int st;
("/a", ""):(0)
("/a%zz", ""):(400)
("/a", "x\ny"):(400)
("/a%00", ""):(400)
("/../a", ""):(403)
