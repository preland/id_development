hd_hdrs_ok(string blk) {
  int ok = 1;
  if(len(blk) > 0) {
    ok = hd_hdrs_scan(blk);
  }
} return int ok;
("Host: a\r\nAccept: b"):(1)
("Host a"):(0)
(""):(1)

hd_hdrs_scan(string blk) {
  string[] ls = str_split(blk, "\r\n");
  int ok = hd_hdrs_loop(ls, 0);
} return int ok;
("A: 1\r\nB: 2"):(1)
("A: 1\r\n\r\nB: 2"):(0)

hd_hdrs_loop(string[] ls, int i) {
  int ok = 1;
  int n = len(ls);
  while(i < n && ok == 1) {
    ok = hd_line_ok(ls[i]);
    i = i + 1;
  }
} return int ok;
(["A: 1", "B: 2"], 0):(1)
(["A: 1", "bad"], 0):(0)
(["bad", "A: 1"], 1):(1)
