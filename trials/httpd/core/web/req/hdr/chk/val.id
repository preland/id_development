hd_value_ok(string line, int i) {
  int ok = 1;
  while(charat(line, i) >= 0 && ok == 1) {
    ok = hd_vchar(charat(line, i));
    i = i + 1;
  }
} return int ok;
("a: b\tc", 3):(1)
("a: b\nc", 3):(0)
("a: caf\xc3\xa9", 3):(1)
("a: b", 9):(1)

hd_vchar(int c) {
  int r = 0;
  if(c == 9 || (c >= 32 && c != 127)) {
    r = 1;
  }
} return int r;
(9):(1)
(10):(0)
(127):(0)
(200):(1)
