hd_hdr_count(string blk, string name) {
  string[] ls = str_split(blk, "\r\n");
  int n = 0;
  int i = hd_hdr_find(ls, name, 0);
} chain (string blk, string name) {
  while(i >= 0) {
    n = n + 1;
    i = hd_hdr_find(ls, name, i + 1);
  }
} return int n;
("A: 1\r\nB: 2\r\na: 3", "a"):(2)
("A: 1", "b"):(0)
("", "a"):(0)
