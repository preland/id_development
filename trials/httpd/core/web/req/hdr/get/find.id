hd_hdr_pick(string[] ls, string name, int k) {
  string nm = hd_hdr_name(ls[k]);
  int r = -1;
  if(nm == name) {
    r = k;
  }
} return int r;
(["Host: a", "X: b"], "x", 1):(1)
(["Host: a", "X: b"], "x", 0):(-1)

hd_hdr_find(string[] ls, string name, int k) {
  int r = -1;
  int n = len(ls);
  while(k < n && r < 0) {
    r = hd_hdr_pick(ls, name, k);
    k = k + 1;
  }
} return int r;
(["Host: a", "X: b", "x: c"], "x", 0):(1)
(["Host: a", "X: b", "x: c"], "x", 2):(2)
(["Host: a"], "x", 0):(-1)

hd_hdr_get(string blk, string name) {
  string[] ls = str_split(blk, "\r\n");
  int i = hd_hdr_find(ls, name, 0);
  string v = hd_hdr_at(ls, i);
} return string v;
("Host: a\r\nX: b", "x"):("b")
("Host: a\r\nX: b", "y"):("")
("", "host"):("")
("X: first\r\nX: second", "x"):("first")

