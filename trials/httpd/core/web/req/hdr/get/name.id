hd_hdr_name(string line) {
  int c = str_find(line, ":");
  string nm = "";
  if(c > 0) {
    string raw = str_slice(line, 0, c);
    nm = str_lower(raw);
  }
} return string nm;
("Host: x"):("host")
("no colon"):("")
(": empty"):("")
("CONTENT-Length:5"):("content-length")

hd_hdr_val(string line) {
  string raw = hd_after_sep(line, ":");
  string v = str_trim(raw);
} return string v;
("Host:   example.com  "):("example.com")
("No colon here"):("")
("A: b: c"):("b: c")

hd_hdr_at(string[] ls, int i) {
  string v = "";
  if(i >= 0) {
    v = hd_hdr_val(ls[i]);
  }
} return string v;
(["A: 1", "B: 2"], 1):("2")
(["A: 1"], -1):("")
