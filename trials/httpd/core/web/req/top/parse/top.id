hd_parse_rest(string blk, string[] rq) {
  int st = 400;
  if(hd_hdrs_ok(blk) == 1) {
    st = hd_parse_hdrs(blk, rq);
  }
} return int st;
("Host: h", ["GET", "/a", "HTTP/1.1", "", "", "", "", ""]):(0)
("Host h", ["GET", "/a", "HTTP/1.1", "", "", "", "", ""]):(400)

hd_parse(string head, string[] rq) {
  string line = hd_before(head, "\r\n");
  string blk = hd_after_sep(head, "\r\n");
  int st = hd_reqline(line, rq);
} chain (string head, string[] rq) {
  rq[6] = blk;
  rq[7] = line;
  if(st == 0) {
    st = hd_parse_rest(blk, rq);
  }
} return int st;
("GET /a?b=1 HTTP/1.1\r\nHost: h\r\nConnection: close", ["", "", "", "", "", "", "", ""]):(0)
("GET /a HTTP/1.1\r\nAccept: x", ["", "", "", "", "", "", "", ""]):(400)
("GET /../a HTTP/1.1\r\nHost: h", ["", "", "", "", "", "", "", ""]):(403)
("BAD", ["", "", "", "", "", "", "", ""]):(400)
("GET /a HTTP/1.0", ["", "", "", "", "", "", "", ""]):(0)
