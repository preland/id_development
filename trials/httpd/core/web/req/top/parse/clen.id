hd_clen_big(string v, int mx) {
  int n = to_int(v);
  int st = 0;
  if(n > mx) {
    st = 413;
  }
} return int st;
("100", 100):(0)
("101", 100):(413)
("0", 0):(0)

hd_clen_val(string v, string[] rq) {
  int st = 400;
  if(hd_digits(v) == 1 && len(v) < 10) {
    rq[5] = v;
    st = hd_clen_big(v, (import hd_max_body));
  }
} return int st;
("12", ["", "", "", "", "", "", "", ""]):(0)
("-1", ["", "", "", "", "", "", "", ""]):(400)
("12x", ["", "", "", "", "", "", "", ""]):(400)
("", ["", "", "", "", "", "", "", ""]):(400)
("99999999999", ["", "", "", "", "", "", "", ""]):(400)
("2000000", ["", "", "", "", "", "", "", ""]):(413)

hd_clen_ck(string v, int n, string[] rq) {
  int st = 0;
  if(n > 1) {
    st = 400;
  }
  if(n == 1) {
    st = hd_clen_val(v, rq);
  }
} return int st;
("", 0, ["", "", "", "", "", "", "", ""]):(0)
("5", 1, ["", "", "", "", "", "", "", ""]):(0)
("5", 2, ["", "", "", "", "", "", "", ""]):(400)
("x", 1, ["", "", "", "", "", "", "", ""]):(400)
