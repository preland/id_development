hd_host_te(string[] rq, string host, string te) {
  int st = 0;
  if((rq[2] == "HTTP/1.1" && host == "") || te != "") {
    st = 400;
  }
} return int st;
(["GET", "/", "HTTP/1.1"], "h", ""):(0)
(["GET", "/", "HTTP/1.1"], "", ""):(400)
(["GET", "/", "HTTP/1.0"], "", ""):(0)
(["GET", "/", "HTTP/1.1"], "h", "chunked"):(400)

hd_parse_clen(string blk, string[] rq) {
  string v = hd_hdr_get(blk, "content-length");
  int n = hd_hdr_count(blk, "content-length");
  int st = hd_clen_ck(v, n, rq);
} return int st;
("Content-Length: 5", ["", "", "", "", "", "", "", ""]):(0)
("Content-Length: 5\r\nContent-Length: 5", ["", "", "", "", "", "", "", ""]):(400)
("Host: x", ["", "", "", "", "", "", "", ""]):(0)
("Content-Length: 9999999", ["", "", "", "", "", "", "", ""]):(413)

hd_parse_hdrs(string blk, string[] rq) {
  string host = hd_hdr_get(blk, "host");
  string te = hd_hdr_get(blk, "transfer-encoding");
  int st = hd_host_te(rq, host, te);
} chain (string blk, string[] rq) {
  if(st == 0) {
    st = hd_parse_clen(blk, rq);
  }
  if(st == 0) {
    st = hd_uri_path(rq[1], rq);
  }
} return int st;
("Host: h", ["GET", "/a", "HTTP/1.1", "", "", "", "", ""]):(0)
("Accept: x", ["GET", "/a", "HTTP/1.1", "", "", "", "", ""]):(400)
("Host: h\r\nContent-Length: 3", ["GET", "/../a", "HTTP/1.1", "", "", "", "", ""]):(403)
("Host: h\r\nTransfer-Encoding: chunked", ["GET", "/a", "HTTP/1.1", "", "", "", "", ""]):(400)
