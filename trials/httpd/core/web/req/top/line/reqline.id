hd_sfill(string[] xs, int n) {
  int i = 0;
  while(i < n) {
    push(xs, "");
    i = i + 1;
  }
} return void;
([], 2):(["", ""], 2)
(["a"], 0):(["a"], 0)

hd_rq_init(string[] rq) {
  hd_sfill(rq, 8);
} return void;
