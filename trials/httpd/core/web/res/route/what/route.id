hd_by_kind(string fp, int kd, string[] rq, int keep, int left, string[] out, int[] mt) {
  string head = "";
  if(kd == 1) {
    head = hd_file(fp, rq, keep, left, out, mt);
  }
  if(kd == 2) {
    head = hd_dir(fp, rq, keep, left, out, mt);
  }
} chain (string fp, int kd, string[] rq, int keep, int left, string[] out, int[] mt) {
  if(kd > 2) {
    head = hd_fail(kd, "", keep, left, out, mt);
  }
} return string head;
("/nonexistent-hd-x", 404, ["GET", "/", "HTTP/1.1", "/", "", "", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: close\r\n\r\n")
("/tmp", 2, ["GET", "/tmp", "HTTP/1.1", "/tmp", "", "", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 301 Moved Permanently\r\nServer: httpd-id/1.0\r\nLocation: /tmp/\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 121\r\nConnection: close\r\n\r\n")
("/nonexistent-hd-x", 1, ["GET", "/", "HTTP/1.1", "/", "", "", ""], 0, 1, ["x", "y"], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: close\r\n\r\n") then calls hd_file:[1]

hd_route(string root, string[] rq, int keep, int left, string[] out, int[] mt) {
  string fp = root + rq[3];
  int kd = hd_kind(fp);
  string head = hd_by_kind(fp, kd, rq, keep, left, out, mt);
} return string head;
("/nonexistent-hd-root", ["GET", "/x", "HTTP/1.1", "/x", "", "", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: close\r\n\r\n")
("/nonexistent-hd-root", ["GET", "/y/z", "HTTP/1.1", "/y/z", "", "", ""], 1, 9, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: keep-alive\r\nKeep-Alive: max=8\r\n\r\n")
