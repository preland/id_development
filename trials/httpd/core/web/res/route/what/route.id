server_dispatch_kind(string full_path, string normalized_path, int entry_kind, string[] request, string[] response) {
  int status_code = entry_kind;
  if(entry_kind == 1) {
    status_code = server_file(full_path, request, response);
  }
  if(entry_kind == 2) {
    status_code = server_directory(full_path, normalized_path, request, response);
  }
} return int status_code;
given server_fixture_response ("/nonexistent-hd-x", "/", 404, ["GET", "/", "HTTP/1.1", "/", "", "", "GET / HTTP/1.1", "", "", "0"], (import fixture_response)):(404)
given server_fixture_response ("/tmp", "/tmp", 2, ["GET", "/tmp", "HTTP/1.1", "/tmp", "", "", "GET /tmp HTTP/1.1", "", "", "0"], (import fixture_response)):(301)
given server_fixture_response ("/nonexistent-hd-x", "/", 1, ["GET", "/", "HTTP/1.1", "/", "", "", "GET / HTTP/1.1", "", "", "0"], (import fixture_response)):(404) then calls server_file:[1]

server_route(string root, string normalized_path, string[] request, string[] response) {
  string full_path = root + normalized_path;
  int entry_kind = server_path_kind(full_path);
  int status_code = server_dispatch_kind(full_path, normalized_path, entry_kind, request, response);
} return int status_code;
