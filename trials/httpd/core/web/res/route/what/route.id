hd_by_kind(string fp, string np, int kd, string[] rq, string[] rs) {
  int c = kd;
  if(kd == 1) {
    c = hd_file(fp, rq, rs);
  }
  if(kd == 2) {
    c = hd_dir(fp, np, rq, rs);
  }
} return int c;
given hd_t_rsnew ("/nonexistent-hd-x", "/", 404, ["GET", "/", "HTTP/1.1", "/", "", "", "GET / HTTP/1.1", "", "", "0"], (import hd_t_rs)):(404)
given hd_t_rsnew ("/tmp", "/tmp", 2, ["GET", "/tmp", "HTTP/1.1", "/tmp", "", "", "GET /tmp HTTP/1.1", "", "", "0"], (import hd_t_rs)):(301)
given hd_t_rsnew ("/nonexistent-hd-x", "/", 1, ["GET", "/", "HTTP/1.1", "/", "", "", "GET / HTTP/1.1", "", "", "0"], (import hd_t_rs)):(404) then calls hd_file:[1]

hd_route(string root, string np, string[] rq, string[] rs) {
  string fp = root + np;
  int kd = hd_kind(fp);
  int c = hd_by_kind(fp, np, kd, rq, rs);
} return int c;
