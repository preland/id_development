hd_fresh(string[] rq, int mtm) {
  word ts = date_http_read(http_hdr_get(rq[(import http_q_headers)], "if-modified-since"));
  int f = 0;
  if(ts >= 0 && mtm >= 0 && mtm <= ts) {
    f = 1;
  }
} return int f;
