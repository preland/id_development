server_not_modified(string[] request, int modified_time) {
  word since_time = date_http_read(http_header_get(request[(import http_q_headers)], "if-modified-since"));
  int fresh_result = 0;
  if(since_time >= 0 && modified_time >= 0 && modified_time <= since_time) {
    fresh_result = 1;
  }
} return int fresh_result;
