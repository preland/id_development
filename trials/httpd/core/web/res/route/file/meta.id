hd_fresh(string[] rq, int mtm) {
  int ts = hd_date_parse(hd_hdr_get(rq[6], "if-modified-since"));
  int f = 0;
  if(ts >= 0 && mtm >= 0 && mtm <= ts) {
    f = 1;
  }
} return int f;
