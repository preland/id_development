hd_file(string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  int code = hd_probe(fp);
  string head = "";
  if(code != 0) {
    head = hd_fail(code, "", keep, left, out, mt);
  }
} chain (string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  if(code == 0) {
    head = hd_ok(fp, rq, keep, left, out, mt);
  }
} return string head;
("/nonexistent-hd-x", ["GET", "/", "HTTP/1.1", "", "", "", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: close\r\n\r\n")
("/nonexistent-hd-y/z", ["GET", "/", "HTTP/1.1", "", "", "", ""], 1, 5, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: keep-alive\r\nKeep-Alive: max=4\r\n\r\n")
