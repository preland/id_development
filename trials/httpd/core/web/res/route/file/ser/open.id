server_open_status(int file_handle) {
  int status_code = 0;
  if(file_handle < 0) {
    status_code = server_error_status(fs_error());
  }
  if(file_handle >= 0) {
    fs_close(file_handle);
  }
} return int status_code;
(-1):(500)
(999):(0)
given server_fixture_missing_file_error (-1):(404)

server_probe_file(string full_path) {
  int file_handle = fs_open(full_path, "r");
  int status_code = server_open_status(file_handle);
} return int status_code;
("/dev/null"):(0)
("/nonexistent-hd-x"):(404)
