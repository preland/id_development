hd_open_code(int h) {
  int c = 0;
  if(h < 0) {
    c = hd_err_code(fs_error());
  }
  if(h >= 0) {
    fs_close(h);
  }
} return int c;
(-1):(500)
(999):(0)
given hd_t_enoent (-1):(404)

hd_probe(string fp) {
  int h = fs_open(fp, "r");
  int c = hd_open_code(h);
} return int c;
("/dev/null"):(0)
("/nonexistent-hd-x"):(404)
