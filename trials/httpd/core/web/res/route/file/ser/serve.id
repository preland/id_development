hd_ok(string fp, string[] rq, string[] rs) {
  int sz = fs_size(fp);
  int mtm = fs_mtime(fp);
  int fresh = hd_fresh(rq, mtm);
} chain (string fp, string[] rq, string[] rs) {
  int code = hd_pick(sz, fresh);
  int c = hd_reply(code, fp, mtm, rs);
} return int c;
