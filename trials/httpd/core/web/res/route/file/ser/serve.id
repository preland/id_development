hd_ok(string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  int sz = fs_size(fp);
  int mtm = fs_mtime(fp);
  int fresh = hd_fresh(rq, mtm);
} chain (string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  int code = hd_pick(sz, fresh);
  string head = hd_reply(code, fp, sz, mtm, keep, left, out, mt);
} return string head;
