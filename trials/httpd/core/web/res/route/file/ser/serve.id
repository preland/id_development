hd_reply(int code, string fp, int sz, int mtm, int keep, int left, string[] out, int[] mt) {
  string head = "";
  if(code == 500) {
    head = hd_fail(500, "", keep, left, out, mt);
  }
  if(code == 304) {
    head = hd_notmod(mtm, keep, left, out, mt);
  }
} chain (int code, string fp, int sz, int mtm, int keep, int left, string[] out, int[] mt) {
  if(code == 200) {
    head = hd_full(fp, sz, mtm, keep, left, out, mt);
  }
} return string head;
