server_reply(int code, string full_path, int modified_time, string[] response) {
  int status_code = code;
  if(code == 304) {
    status_code = server_reply_not_modified(modified_time, response);
  }
  if(code == 200) {
    status_code = server_reply_full(full_path, modified_time, response);
  }
} return int status_code;
