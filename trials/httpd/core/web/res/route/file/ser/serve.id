server_file_ok(string full_path, string[] request, string[] response) {
  int file_size = fs_size(full_path);
  int modified_time = fs_mtime(full_path);
  int fresh = server_not_modified(request, modified_time);
} chain (string full_path, string[] request, string[] response) {
  int code = server_pick_status(file_size, fresh);
  int status_code = server_reply(code, full_path, modified_time, response);
} return int status_code;
