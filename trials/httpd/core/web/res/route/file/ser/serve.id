hd_reply(int code, string fp, int mtm, string[] rs) {
  int c = code;
  if(code == 304) {
    c = hd_notmod(mtm, rs);
  }
  if(code == 200) {
    c = hd_full(fp, mtm, rs);
  }
} return int c;
