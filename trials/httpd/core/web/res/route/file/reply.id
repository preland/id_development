hd_full(string fp, int sz, int mtm, int keep, int left, string[] out, int[] mt) {
  string lm = hd_lm_line(mtm);
  string ct = hd_ct_line(fp);
  hd_out_set(out, "", fp);
} chain (string fp, int sz, int mtm, int keep, int left, string[] out, int[] mt) {
  hd_mt_set(mt, 200, keep, sz);
  string ex = ct + lm;
  string head = hd_head(200, keep, left, ex, sz);
} return string head;
