hd_notmod(int mtm, int keep, int left, string[] out, int[] mt) {
  string lm = hd_lm_line(mtm);
  hd_out_set(out, "", "");
  hd_mt_set(mt, 304, keep, 0);
} chain (int mtm, int keep, int left, string[] out, int[] mt) {
  string head = hd_head(304, keep, left, lm, -1);
} return string head;
