server_index(string full_path, string normalized_path, string[] request, string[] response) {
  string index_path = full_path + "index.html";
  int entry_kind = server_path_kind(index_path);
  int status_code = 0;
} chain (string full_path, string normalized_path, string[] request, string[] response) {
  if(entry_kind == 1) {
    status_code = server_file(index_path, request, response);
  }
  if(entry_kind != 1) {
    status_code = server_listing(full_path, normalized_path, response);
  }
} return int status_code;
