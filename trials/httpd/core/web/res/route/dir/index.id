hd_index(string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  string ix = fp + "index.html";
  int kd = hd_kind(ix);
  string head = "";
} chain (string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  if(kd == 1) {
    head = hd_file(ix, rq, keep, left, out, mt);
  }
  if(kd != 1) {
    head = hd_list(fp, rq, keep, left, out, mt);
  }
} return string head;
("/nonexistent-hd-x/", ["GET", "/", "HTTP/1.1", "/", "", "", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: close\r\n\r\n")
given hd_t_site ((import hd_t_dir), ["GET", "/", "HTTP/1.1", "/", "", "", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 200 OK\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 279\r\nConnection: close\r\n\r\n") then hd_t_drop:(1)
