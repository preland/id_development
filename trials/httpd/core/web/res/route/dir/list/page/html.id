server_item_add(string name, string[] list_items) {
  if(len(name) > 0) {
    string encoded_name = url_encode_keep(name, "/");
    string escaped_name = http_escape_markup(name);
    push(list_items, "<li><a href=\"" + encoded_name + "\">" + escaped_name + "</a></li>\n");
  }
} return void;
("a b.txt", []):("a b.txt", ["<li><a href=\"a%20b.txt\">a b.txt</a></li>\n"])
("<x>/", ["p"]):("<x>/", ["p", "<li><a href=\"%3Cx%3E/\">&lt;x&gt;/</a></li>\n"])
("", ["p"]):("", ["p"])

server_items_add_all(string[] name_list, string[] list_items, int item_index) {
  while(item_index < len(name_list)) {
    server_item_add(name_list[item_index], list_items);
    item_index = item_index + 1;
  }
} return void;
(["a", "b"], [], 0):(["a", "b"], ["<li><a href=\"a\">a</a></li>\n", "<li><a href=\"b\">b</a></li>\n"], 0)
(["a", "b"], [], 1):(["a", "b"], ["<li><a href=\"b\">b</a></li>\n"], 1)

server_parent_link_add(string page_path, string[] list_items) {
  if(page_path != "/") {
    push(list_items, "<li><a href=\"../\">../</a></li>\n");
  }
} return void;
("/", []):("/", [])
("/a/", []):("/a/", ["<li><a href=\"../\">../</a></li>\n"])
