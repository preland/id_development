hd_list_ok(string fp, int need, string[] rq, int keep, int left, string[] out, int[] mt) {
  string txt = hd_dirtext(fp, need);
  string pg = hd_page_list(rq[3], txt);
  string head = hd_body(200, "", pg, keep, left, out, mt);
} return string head;
("/nonexistent-hd-x", 0, ["GET", "/", "HTTP/1.1", "/"], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 200 OK\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 131\r\nConnection: close\r\n\r\n")
