hd_list(string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  int need = hd_need(fp);
  int code = hd_need_code(need, (import hd_max_list));
  string head = "";
} chain (string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  if(code != 0) {
    head = hd_fail(code, "", keep, left, out, mt);
  }
  if(code == 0) {
    head = hd_list_ok(fp, need, rq, keep, left, out, mt);
  }
} return string head;
