given hd_t_site ((import hd_t_dir), ["GET", "/", "HTTP/1.1", "/"], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 200 OK\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 279\r\nConnection: close\r\n\r\n") then hd_t_drop:(1)
