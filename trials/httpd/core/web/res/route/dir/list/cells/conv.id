server_poke_cells(int[] cell_values, word memory_address, int cell_count) {
  int cell_index = 0;
  while(cell_index < cell_count) {
    poke8(memory_address + cell_index, cell_values[cell_index]);
    cell_index = cell_index + 1;
  }
} return void;
