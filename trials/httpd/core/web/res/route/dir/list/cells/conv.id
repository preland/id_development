server_cells_decode(int[] cell_values, int cell_count) {
  word memory_address = alloc(cell_count + 1);
  server_poke_cells(cell_values, memory_address, cell_count);
  string cells_text = str_of_mem(memory_address, cell_count);
} return string cells_text;
