hd_dir(string fp, string np, string[] rq, string[] rs) {
  int slash = str_ends(fp, "/");
  int c = 0;
  if(slash == 0) {
    c = hd_redirect(np, rq, rs);
  }
} chain (string fp, string np, string[] rq, string[] rs) {
  if(slash == 1) {
    c = hd_index(fp, np, rq, rs);
