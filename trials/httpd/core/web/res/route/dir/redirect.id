hd_query_sfx(string q) {
  string rs = "";
  if(len(q) > 0) {
    rs = "?" + q;
  }
} return string rs;
("a=1"):("?a=1")
(""):("")

hd_redirect(string[] rq, int keep, int left, string[] out, int[] mt) {
  string loc = hd_pct_encode(rq[3]);
  string q = hd_query_sfx(rq[4]);
  string head = hd_fail(301, "Location: " + loc + "/" + q + "\r\n", keep, left, out, mt);
} return string head;
(["GET", "/a b", "HTTP/1.1", "/a b", "x=1"], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 301 Moved Permanently\r\nServer: httpd-id/1.0\r\nLocation: /a%20b/?x=1\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 121\r\nConnection: close\r\n\r\n")
(["GET", "/d", "HTTP/1.1", "/d", ""], 1, 2, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 301 Moved Permanently\r\nServer: httpd-id/1.0\r\nLocation: /d/\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 121\r\nConnection: keep-alive\r\nKeep-Alive: max=1\r\n\r\n")

hd_dir(string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  int slash = str_ends(fp, "/");
  string head = "";
  if(slash == 0) {
    head = hd_redirect(rq, keep, left, out, mt);
  }
} chain (string fp, string[] rq, int keep, int left, string[] out, int[] mt) {
  if(slash == 1) {
    head = hd_index(fp, rq, keep, left, out, mt);
  }
} return string head;
("/tmp", ["GET", "/tmp", "HTTP/1.1", "/tmp", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 301 Moved Permanently\r\nServer: httpd-id/1.0\r\nLocation: /tmp/\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 121\r\nConnection: close\r\n\r\n")
given hd_t_site ((import hd_t_dir), ["GET", "/", "HTTP/1.1", "/", ""], 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 200 OK\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 279\r\nConnection: close\r\n\r\n") then hd_t_drop:(1)
