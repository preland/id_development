server_redirect(string normalized_path, string[] request, string[] response) {
  string location = url_encode_keep(normalized_path, "/");
  string query_text = server_query_suffix(request[(import http_q_query)]);
  response[(import http_s_headers)] = "Location: " + location + "/" + query_text + "\r\n";
} chain (string normalized_path, string[] request, string[] response) {
  int status_code = 301;
} return int status_code;
