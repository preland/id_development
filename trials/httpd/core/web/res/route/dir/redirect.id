server_directory(string full_path, string normalized_path, string[] request, string[] response) {
  int slash = string_ends_with(full_path, "/");
  int status_code = 0;
  if(slash == 0) {
    status_code = server_redirect(normalized_path, request, response);
  }
} chain (string full_path, string normalized_path, string[] request, string[] response) {
  if(slash == 1) {
    status_code = server_index(full_path, normalized_path, request, response);
  }
} return int status_code;
