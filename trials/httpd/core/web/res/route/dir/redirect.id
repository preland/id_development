hd_redirect(string np, string[] rq, string[] rs) {
  string loc = url_encode_path(np);
  string q = hd_query_sfx(rq[(import http_q_query)]);
  rs[(import http_s_headers)] = "Location: " + loc + "/" + q + "\r\n";
} chain (string np, string[] rq, string[] rs) {
  int c = 301;
} return int c;
