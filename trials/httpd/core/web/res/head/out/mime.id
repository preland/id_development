hd_mime(string fp) {
  int k = lst_str_index((import hd_mime_ext), hd_ext(fp));
  string mty = "application/octet-stream";
  if(k >= 0) {
    mty = (import hd_mime_type)[k];
  }
} return string mty;
("/x/index.html"):("text/html; charset=utf-8")
("/x/PIC.PNG"):("image/png")
("/x/noext"):("application/octet-stream")
("/x/a.tar.gz"):("application/gzip")
