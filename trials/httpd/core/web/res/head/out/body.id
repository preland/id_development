hd_out_set(string[] out, string body, string fp) {
  out[0] = body;
  out[1] = fp;
} return void;
(["", ""], "b", "/f"):(["b", "/f"], "b", "/f")
(["x", "y"], "", ""):(["", ""], "", "")

hd_mt_set(int[] mt, int code, int keep, int n) {
  mt[0] = code;
  mt[1] = keep;
  mt[2] = n;
} return void;
([0, 0, 0, 7], 200, 1, 42):([200, 1, 42, 7], 200, 1, 42)
([1, 1, 1, 1], 404, 0, 0):([404, 0, 0, 1], 404, 0, 0)

hd_bodyless(string[] rq, int code) {
  int b = 0;
  if(rq[0] == "HEAD" || code == 304) {
    b = 1;
  }
} return int b;
(["HEAD"], 200):(1)
(["GET"], 304):(1)
(["GET"], 200):(0)
