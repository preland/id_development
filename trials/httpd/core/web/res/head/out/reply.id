hd_body(int code, string ex, string body, int keep, int left, string[] out, int[] mt) {
  hd_out_set(out, body, "");
  int n = len(body);
  hd_mt_set(mt, code, keep, n);
} chain (int code, string ex, string body, int keep, int left, string[] out, int[] mt) {
  string ex2 = ex + "Content-Type: text/html; charset=utf-8\r\n";
  string head = hd_head(code, keep, left, ex2, n);
} return string head;
(404, "", "nope", 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 4\r\nConnection: close\r\n\r\n") then calls hd_out_set:(["nope", ""], "nope", "") then calls hd_mt_set:([404, 0, 4, 0], 404, 0, 4)
