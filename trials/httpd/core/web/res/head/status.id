hd_reason(int code) {
  int k = lst_index_of((import hd_codes), code);
  string rs = "Unknown";
  if(k >= 0) {
    rs = (import hd_reasons)[k];
  }
} return string rs;
(404):("Not Found")
(200):("OK")
(414):("URI Too Long")
(999):("Unknown")

hd_status_line(int code) {
  string rs = hd_reason(code);
  string l = "HTTP/1.1 " + code + " " + rs + "\r\n";
} return string l;
(200):("HTTP/1.1 200 OK\r\n")
(405):("HTTP/1.1 405 Method Not Allowed\r\n")

hd_clen_line(int clen) {
  string l = "";
  if(clen >= 0) {
    l = "Content-Length: " + clen + "\r\n";
  }
} return string l;
(12):("Content-Length: 12\r\n")
(0):("Content-Length: 0\r\n")
(-1):("")
