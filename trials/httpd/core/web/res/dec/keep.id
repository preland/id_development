hd_ver_keep(string v, int cl, int ka) {
  int w = 0;
  if(v == "HTTP/1.1" && cl < 0) {
    w = 1;
  }
  if(v == "HTTP/1.0" && ka >= 0 && cl < 0) {
    w = 1;
  }
} return int w;
("HTTP/1.1", -1, -1):(1)
("HTTP/1.1", 0, -1):(0)
("HTTP/1.0", -1, -1):(0)
("HTTP/1.0", -1, 0):(1)
("HTTP/1.0", 0, 0):(0)

hd_wants_keep(string[] rq) {
  string cv = str_lower(hd_hdr_get(rq[6], "connection"));
  int cl = str_find(cv, "close");
  int ka = str_find(cv, "keep-alive");
} chain (string[] rq) {
  int w = hd_ver_keep(rq[2], cl, ka);
} return int w;
(["GET", "/", "HTTP/1.1", "", "", "", "Host: h"]):(1)
(["GET", "/", "HTTP/1.1", "", "", "", "Host: h\r\nConnection: Close"]):(0)
(["GET", "/", "HTTP/1.0", "", "", "", "Connection: Keep-Alive"]):(1)
(["GET", "/", "HTTP/1.0", "", "", "", ""]):(0)

hd_can_keep(int st, int left) {
  int k = 1;
  if(st == 400 || st == 413 || st == 414 || left <= 1) {
    k = 0;
  }
} return int k;
(0, 5):(1)
(403, 2):(1)
(400, 5):(0)
(413, 5):(0)
(414, 5):(0)
(0, 1):(0)
