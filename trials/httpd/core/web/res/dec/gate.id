hd_keep(string[] rq, int st, int left) {
  int a = hd_wants_keep(rq);
  int b = hd_can_keep(st, left);
  int keep = a & b;
} return int keep;
(["GET", "/", "HTTP/1.1", "", "", "", "Host: h"], 0, 5):(1)
(["GET", "/", "HTTP/1.1", "", "", "", "Host: h"], 400, 5):(0)
(["GET", "/", "HTTP/1.1", "", "", "", "Host: h"], 0, 1):(0)

hd_method_ok(string mth) {
  int ok = 0;
  if(mth == "GET" || mth == "HEAD") {
    ok = 1;
  }
} return int ok;
("GET"):(1)
("HEAD"):(1)
("POST"):(0)
("get"):(0)

hd_gate(string[] rq, int st) {
  int c = st;
  if(st == 0 && hd_method_ok(rq[0]) == 0) {
    c = 405;
  }
} return int c;
(["GET"], 0):(0)
(["DELETE"], 0):(405)
(["DELETE"], 400):(400)
(["HEAD"], 403):(403)
