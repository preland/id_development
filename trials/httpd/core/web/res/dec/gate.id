hd_method_ok(string mth) {
  int ok = 0;
  if(mth == "GET" || mth == "HEAD") {
    ok = 1;
  }
} return int ok;
("GET"):(1)
("HEAD"):(1)
("POST"):(0)
("get"):(0)

hd_gate(string[] rq, string[] rs) {
  int c = 0;
  if(hd_method_ok(rq[(import http_q_method)]) == 0) {
    rs[(import http_s_headers)] = "Allow: GET, HEAD\r\n";
    c = 405;
  }
} return int c;
given hd_t_rsnew (["GET", "/", "HTTP/1.1", "/", "", "", "GET / HTTP/1.1", "", "", "0"], (import hd_t_rs)):(0) then (import hd_t_rs)[(import http_s_headers)]:("")
given hd_t_rsnew (["DELETE", "/", "HTTP/1.1", "/", "", "", "DELETE / HTTP/1.1", "", "", "0"], (import hd_t_rs)):(405) then (import hd_t_rs)[(import http_s_headers)]:("Allow: GET, HEAD\r\n")
given hd_t_rsnew (["HEAD", "/x", "HTTP/1.1", "/x", "", "", "HEAD /x HTTP/1.1", "", "", "0"], (import hd_t_rs)):(0)
given hd_t_rsnew (["POST", "/x", "HTTP/1.1", "/x", "", "", "POST /x HTTP/1.1", "", "", "0"], (import hd_t_rs)):(405)
