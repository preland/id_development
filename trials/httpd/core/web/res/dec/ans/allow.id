hd_allow(int c) {
  string ex = "";
  if(c == 405) {
    ex = "Allow: GET, HEAD\r\n";
  }
} return string ex;
(405):("Allow: GET, HEAD\r\n")
(404):("")

hd_answer(string root, string[] rq, int c, int keep, int left, string[] out, int[] mt) {
  string head = "";
  string ex = hd_allow(c);
  if(c != 0) {
    head = hd_fail(c, ex, keep, left, out, mt);
  }
} chain (string root, string[] rq, int c, int keep, int left, string[] out, int[] mt) {
  if(c == 0) {
    head = hd_route(root, rq, keep, left, out, mt);
  }
} return string head;
("/nonexistent-hd-root", ["GET", "/", "HTTP/1.1", "/", "", "", ""], 405, 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 405 Method Not Allowed\r\nServer: httpd-id/1.0\r\nAllow: GET, HEAD\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 123\r\nConnection: close\r\n\r\n")
("/nonexistent-hd-root", ["GET", "/x", "HTTP/1.1", "/x", "", "", ""], 0, 0, 1, ["", ""], [0, 0, 0, 0]):("HTTP/1.1 404 Not Found\r\nServer: httpd-id/1.0\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 105\r\nConnection: close\r\n\r\n")
