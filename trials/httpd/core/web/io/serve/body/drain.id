hd_drain(word[] io, int n) {
  int hi = io[0];
  int m = fx_min(n, (import hd_chunk));
  int g = hd_rd(hi, io[2], m);
} chain (word[] io, int n) {
  int r = n - g;
  if(g <= 0) {
    r = -1;
  }
} return int r;
given hd_t_open stdin "abcdef" ((import hd_t_io), 4):(0) then hd_t_out:("")
given hd_t_open stdin "ab" ((import hd_t_io), 4):(2) then hd_t_out:("")
given hd_t_open stdin "" ((import hd_t_io), 4):(-1) then hd_t_out:("")

hd_skip(word[] io, int n) {
  while(n > 0) {
    n = hd_drain(io, n);
  }
  int ok = 0;
  if(n == 0) {
    ok = 1;
  }
} return int ok;
given hd_t_open stdin "abcde" ((import hd_t_io), 5):(1) then hd_t_out:("")
given hd_t_open stdin "abc" ((import hd_t_io), 5):(0) then hd_t_out:("")
given hd_t_open stdin "" ((import hd_t_io), 0):(1) then hd_t_out:("")

hd_body_skip(word[] io, string[] rq) {
  int n = to_int(rq[5]);
  int ok = hd_skip(io, n);
} return int ok;
