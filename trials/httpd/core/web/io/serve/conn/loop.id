hd_serve(word[] io, string[] cn, string root, int mx) {
  int left = mx;
  int go = 2;
  while(go == 2 && left > 0) {
    go = hd_conn_step(io, cn, root, left);
    left = left - hd_counted(go);
  }
} chain (word[] io, string[] cn, string root, int mx) {
  int served = mx - left;
} return int served;
