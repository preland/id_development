hd_log_line(string pr, string[] rq, int[] mt) {
  string q = hd_log_req(rq);
  int b = hd_log_bytes(mt);
  int code = mt[0];
} chain (string pr, string[] rq, int[] mt) {
  string l = pr + " - - [-] \"" + q + "\" " + code + " " + b;
} return string l;
("-", ["", "", "", "", "", "", "", "GET /a HTTP/1.1"], [200, 1, 42, 0]):("- - - [-] \"GET /a HTTP/1.1\" 200 42")
("10.0.0.7", ["", "", "", "", "", "", "", ""], [400, 0, 98, 1]):("10.0.0.7 - - [-] \"-\" 400 0")

hd_log(string pr, string[] rq, int[] mt) {
  string l = hd_log_line(pr, rq, mt);
  eprint(l);
} return void;
("-", ["", "", "", "", "", "", "", "GET / HTTP/1.1"], [200, 1, 5, 0]):("-", ["", "", "", "", "", "", "", "GET / HTTP/1.1"], [200, 1, 5, 0]) then eprints:("- - - [-] \"GET / HTTP/1.1\" 200 5\n")
("192.168.1.2", ["", "", "", "", "", "", "", ""], [404, 0, 9, 1]):("192.168.1.2", ["", "", "", "", "", "", "", ""], [404, 0, 9, 1]) then eprints:("192.168.1.2 - - [-] \"-\" 404 0\n")
