hd_put(word[] io, string s) {
  int n = len(s);
  word ad = mem_of_str(s);
  int ho = io[1];
} chain (word[] io, string s) {
  int w = hd_write_n(ho, ad, n);
  int ok = 0;
  if(w == n) {
    ok = 1;
  }
} return int ok;
