hd_pump(word[] io, int h) {
  int t = 0;
  int n = hd_pump1(io, h);
  while(n > 0) {
    t = t + n;
    n = hd_pump1(io, h);
  }
} return int t;
given hd_t_open stdin "hello" ((import hd_t_io), (import hd_t_hin)):(5) then hd_t_out:("hello")
given hd_t_open stdin "" ((import hd_t_io), (import hd_t_hin)):(0) then hd_t_out:("")

hd_stream(word[] io, string fp, int want) {
  int h = fs_open(fp, "r");
  int t = hd_pump(io, h);
  int ok = 0;
} chain (word[] io, string fp, int want) {
  if(t == want) {
    ok = 1;
  }
  fs_close(h);
} return int ok;
given hd_t_env ((import hd_t_io), (import hd_t_apath), 6):(1) then hd_t_out:("hello\n") then hd_t_drop:(1)
given hd_t_env ((import hd_t_io), (import hd_t_apath), 7):(0) then hd_t_out:("hello\n") then hd_t_drop:(1)

hd_file_out(word[] io, string fp, int want) {
  int ok = 1;
  if(len(fp) > 0) {
    ok = hd_stream(io, fp, want);
  }
} return int ok;
