hd_body_out(word[] io, string[] out, int[] mt) {
  int a = hd_put(io, out[0]);
  int b = hd_file_out(io, out[1], mt[2]);
  int ok = a & b;
} return int ok;
given hd_t_env ((import hd_t_io), ["<b>", ""], [200, 0, 3, 0]):(1) then hd_t_out:("<b>") then hd_t_drop:(1)
given hd_t_env ((import hd_t_io), (import hd_t_fout), [200, 0, 6, 0]):(1) then hd_t_out:("hello\n") then hd_t_drop:(1)

hd_send_body(word[] io, string[] out, int[] mt) {
  int ok = 1;
  if(mt[3] == 0) {
    ok = hd_body_out(io, out, mt);
  }
} return int ok;
given hd_t_open ((import hd_t_io), ["<b>", ""], [200, 0, 3, 0]):(1) then hd_t_out:("<b>")
given hd_t_open ((import hd_t_io), ["<b>", ""], [200, 0, 3, 1]):(1) then hd_t_out:("")

hd_send(word[] io, string head, string[] out, int[] mt) {
  int a = hd_put(io, head);
  int b = hd_send_body(io, out, mt);
  int ok = a & b;
} return int ok;
given hd_t_open ((import hd_t_io), "H\r\n\r\n", ["<b>", ""], [200, 0, 3, 0]):(1) then hd_t_out:("H\r\n\r\n<b>")
given hd_t_open ((import hd_t_io), "H\r\n\r\n", ["<b>", ""], [200, 0, 3, 1]):(1) then hd_t_out:("H\r\n\r\n")
