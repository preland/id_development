hd_byte_st(word[] io, int pos, int b, int mx, int lim) {
  int st = -1;
  if(b < 0) {
    st = hd_eof_st(pos);
    return st;
  }
  if(b == 0) {
    st = 400;
    return st;
  }
} chain (word[] io, int pos, int b, int mx, int lim) {
  int end = hd_at_end(io[2], pos);
  if(end == 1) {
    st = 1;
    return st;
  }
  if(pos + 1 > mx) {
    st = hd_long_st(io, pos + 1, lim);
  }
} return int st;
