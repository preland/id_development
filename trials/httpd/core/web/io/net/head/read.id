hd_read_head(word[] io, string[] cn, int mx, int lim) {
  int pos = 0;
  int st = -1;
  while(st < 0) {
    st = hd_head_step(io, pos, mx, lim);
    pos = pos + 1;
  }
} chain (word[] io, string[] cn, int mx, int lim) {
  hd_head_set(io, cn, pos, st);
} return int st;
