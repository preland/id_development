hd_rd(int h, word ad, int n) {
  int g = 0;
  if(h > -2) {
    g = fs_read_mem(h, ad, n);
  }
  if(h <= -2) {
    g = sock_recv_mem(-2 - h, ad, n, (import hd_net_ms));
  }
} return int g;
