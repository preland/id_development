hd_wr(int h, word ad, int n) {
  int w = 0;
  if(h > -2) {
    w = fs_write_mem(h, ad, n);
  }
  if(h <= -2) {
    w = hd_sock_send(-2 - h, ad, n);
  }
} return int w;
