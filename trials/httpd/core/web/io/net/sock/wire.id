hd_sock_send(int sk, word ad, int n) {
  int t = 0;
  int k = 1;
  while(t < n && k > 0) {
    k = sock_send_mem(sk, ad + t, n - t, (import hd_net_ms));
    t = t + (k > 0) * k;
  }
} chain (int sk, word ad, int n) {
  int r = -1;
  if(t == n) {
    r = n;
  }
} return int r;
