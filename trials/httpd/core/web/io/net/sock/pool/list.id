hd_drop(int[] skc, int[] skl, int i) {
  int n = len(skc) - 1;
  skc[i] = skc[n];
  skl[i] = skl[n];
} chain (int[] skc, int[] skl, int i) {
  pop(skc);
  pop(skl);
} return void;
([5, 6, 7], [1, 2, 3], 0):([7, 6], [3, 2], 0)
([5, 6, 7], [1, 2, 3], 2):([5, 6], [1, 2], 2)

hd_poll_set(int ln, int[] skc) {
  int[] skh = [ln];
  int i = 0;
  while(i < len(skc)) {
    push(skh, skc[i]);
    i = i + 1;
  }
} return int[] skh;
(9, []):([9])
(9, [4, 5]):([9, 4, 5])

hd_room(int[] skc, int[] skl, int mx) {
  if(len(skc) >= mx) {
    sock_close(skc[0]);
    hd_drop(skc, skl, 0);
  }
} return void;
([5, 6], [1, 2], 2):([6], [2], 2)
([5], [1], 2):([5], [1], 2)
