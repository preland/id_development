out_table(string[] header, string[][] rows, int[] options) {
  if (options[(import o_nohdr)] == 0 && len(header) > 0) {
    csv_write_print(header, options[(import o_delim)]);
  }
  csv_write_rows(rows, options[(import o_delim)]);
} return void;
(["a", "b"], [["1", "2"]], [44, 0, 0, 0, 0]):(["a", "b"], [["1", "2"]], [44, 0, 0, 0, 0]) then prints:("a,b\n1,2\n")
(["a", "b"], [["1", "2"]], [59, 0, 0, 1, 0]):(["a", "b"], [["1", "2"]], [59, 0, 0, 1, 0]) then prints:("1;2\n")
([], [], [44, 0, 0, 0, 0]):([], [], [44, 0, 0, 0, 0]) then prints:("")
