rows_shift(string[][] rows) {
  int index = 1;
  while (index < len(rows)) {
    rows[index - 1] = rows[index];
    index = index + 1;
  }
  pop(rows);
} return void;
([["a"], ["b"], ["c"]]):([["b"], ["c"]])
([["only"]]):([])

integers_shift(int[] lines) {
  int index = 1;
  while (index < len(lines)) {
    lines[index - 1] = lines[index];
    index = index + 1;
  }
  pop(lines);
} return void;
([1, 2, 3]):([2, 3])
([9]):([])

row_copy(string[] from, string[] to) {
  int index = 0;
  while (index < len(from)) {
    push(to, from[index]);
    index = index + 1;
  }
} return void;
(["a", "b"], []):(["a", "b"], ["a", "b"])
([], ["x"]):([], ["x"])
