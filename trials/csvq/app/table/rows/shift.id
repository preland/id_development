rows_shift(string[][] rows) {
  int i = 1;
  while (i < len(rows)) {
    rows[i - 1] = rows[i];
    i = i + 1;
  }
  pop(rows);
} return void;
([["a"], ["b"], ["c"]]):([["b"], ["c"]])
([["only"]]):([])

ints_shift(int[] lines) {
  int i = 1;
  while (i < len(lines)) {
    lines[i - 1] = lines[i];
    i = i + 1;
  }
  pop(lines);
} return void;
([1, 2, 3]):([2, 3])
([9]):([])

row_copy(string[] from, string[] to) {
  int i = 0;
  while (i < len(from)) {
    push(to, from[i]);
    i = i + 1;
  }
} return void;
(["a", "b"], []):(["a", "b"], ["a", "b"])
([], ["x"]):([], ["x"])
