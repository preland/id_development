table_names(string[] header, int column_count) {
  int index = 1;
  while (index <= column_count) {
    push(header, "" + index);
    index = index + 1;
  }
} return void;
([], 3):(["1", "2", "3"])
([], 0):([])

table_take(string[] header, string[][] rows, int[] lines) {
  row_copy(rows[0], header);
  rows_shift(rows);
  integers_shift(lines);
} return void;
([], [["a", "b"], ["1", "2"]], [1, 2]):(["a", "b"], [["1", "2"]], [2])
([], [["h"]], [1]):(["h"], [], [])

table_split(int[] options, string[] header, string[][] rows, int[] lines) {
  if (len(rows) > 0 && options[(import o_nohdr)] == 0) {
    table_take(header, rows, lines);
  } else {
    if (len(rows) > 0) {
      table_names(header, len(rows[0]));
    }
  }
} return void;
([44, 0, 0, 0, 0], [], [["a", "b"], ["1", "2"]], [1, 2]):([44, 0, 0, 0, 0], ["a", "b"], [["1", "2"]], [2])
([44, 0, 0, 1, 0], [], [["x", "y", "z"]], [1]):([44, 0, 0, 1, 0], ["1", "2", "3"], [["x", "y", "z"]], [1])
([44, 0, 0, 0, 0], [], [], []):([44, 0, 0, 0, 0], [], [], [])
