(0.0000000000000001, 1.0, 1.0):(0.0000000000000001)
(1.0, 2.0, 3.0):(0.0)

statistics_sum(float[] accumulator, float float_value) {
  float updated_sum = accumulator[(import a_sum)] + float_value;
  accumulator[(import a_comp)] = accumulator[(import a_comp)] + statistics_lost_bits(accumulator[(import a_sum)], float_value, updated_sum);
  accumulator[(import a_sum)] = updated_sum;
} return void;
