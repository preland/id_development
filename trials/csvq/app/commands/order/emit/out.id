sort_rows(string[][] rows, int[] order) {
  string[][] sorted = [];
  int index = 0;
  while (index < len(order)) {
    push(sorted, rows[order[index]]);
    index = index + 1;
  }
} return string[][] sorted;
([["a"], ["b"], ["c"]], [2, 0, 1]):([["c"], ["a"], ["b"]])
([["a"]], []):([])

sort_print(string[] header, string[][] rows, int[] order, int[] options) {
  string[][] sorted = sort_rows(rows, order);
  out_table(header, sorted, options);
} return void;
(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 0, 0]):(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 0, 0]) then prints:("k\nb\na\n")
(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 1, 0]):(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 1, 0]) then prints:("b\na\n")

sort_order(int row_total, string[] text_keys, float[] number_keys, int[] options) {
  int direction = 1 - 2 * options[(import o_desc)];
  func(int, int) return int comes_after = bind(sort_text_after, text_keys, direction);
  if (options[(import o_num)] == 1) {
    comes_after = bind(sort_number_after, number_keys, direction);
  }
} chain (int row_total, string[] text_keys, float[] number_keys, int[] options) {
  int[] order = order_by(row_total, comes_after);
} return int[] order;
(3, ["b", "c", "a"], [], [44, 0, 0, 0, 0]):([2, 0, 1])
(3, ["b", "c", "a"], [], [44, 1, 0, 0, 0]):([1, 0, 2])
(3, [], [2.0, 10.0, 1.0], [44, 0, 1, 0, 0]):([2, 0, 1])
(3, [], [2.0, 10.0, 1.0], [44, 1, 1, 0, 0]):([1, 0, 2])
