sort_text_after(string[] text_keys, int direction, int left_index, int right_index) {
  int comparison = string_compare(text_keys[left_index], text_keys[right_index]);
  int after = comparison * direction > 0;
} return int after;
(["a", "b"], 1, 0, 1):(0)
(["b", "a"], 1, 0, 1):(1)
(["a", "b"], -1, 0, 1):(1)
(["x", "x"], -1, 0, 1):(0)

sort_number_after(float[] number_keys, int direction, int first_index, int second_index) {
  int comparison = number_compare(number_keys[first_index], number_keys[second_index]);
  int after = comparison * direction > 0;
} return int after;
([1.5, 2.5], 1, 0, 1):(0)
([1.5, 2.5], 1, 1, 0):(1)
([1.5, 2.5], -1, 0, 1):(1)
([2.0, 2.0], 1, 0, 1):(0)
