cli_cmdchk(string[] args, int[] o, string[] diag) {
  int at = lst_str_index((import cmd_names), args[0]);
  if (at < 0) {
    push(diag, "unknown command '" + args[0] + "'; the commands are: " + str_join((import cmd_names), ", "));
  } else {
    cli_arity(at, args, diag);
    cli_flags(args, o, diag);
  }
} return void;
(["frobnicate"], [44, 0, 0, 0, 0], []):(["frobnicate"], [44, 0, 0, 0, 0], ["unknown command 'frobnicate'; the commands are: select, filter, sort, count, head, stats, gen"])
(["count"], [44, 0, 0, 0, 0], []):(["count"], [44, 0, 0, 0, 0], [])
(["head"], [44, 0, 0, 0, 0], []):(["head"], [44, 0, 0, 0, 0], ["head needs N"])

cli_check(string[] args, int[] o, string[] diag) {
  if (len(args) > 0 && len(diag) == 0) {
    cli_cmdchk(args, o, diag);
  }
} return void;
