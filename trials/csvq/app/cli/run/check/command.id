(["head"], [44, 0, 0, 0, 0], []):(["head"], [44, 0, 0, 0, 0], ["head needs N"])

cli_check(string[] arguments, int[] options, string[] diag) {
  if (len(arguments) > 0 && len(diag) == 0) {
    cli_command_check(arguments, options, diag);
  }
} return void;
