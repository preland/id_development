command_run(string name, string[] header, string[][] rows, int[] lines, int[] options, string[] arguments, string[] diag) {
  if (name == "select") {
    command_select(header, rows, lines, options, arguments, diag);
  }
  if (name == "filter") {
    command_filter(header, rows, lines, options, arguments, diag);
  }
  if (name == "sort") {
    command_sort(header, rows, lines, options, arguments, diag);
  }
} chain (string name, string[] header, string[][] rows, int[] lines, int[] options, string[] arguments, string[] diag) {
  if (name == "count") {
    command_count(header, rows, lines, options, arguments, diag);
  }
  if (name == "head") {
    command_head(header, rows, lines, options, arguments, diag);
  }
  if (name == "stats") {
    command_stats(header, rows, lines, options, arguments, diag);
  }
} return void;
("select", ["a", "b"], [["1", "2"]], [2], [44, 0, 0, 0, 0], ["select", "b"], []):("select", ["a", "b"], [["1", "2"]], [2], [44, 0, 0, 0, 0], ["select", "b"], []) then prints:("b\n2\n")
("filter", ["a"], [["1"], ["2"]], [2, 3], [44, 0, 0, 0, 0], ["filter", "a", "==", "2"], []):("filter", ["a"], [["1"], ["2"]], [2, 3], [44, 0, 0, 0, 0], ["filter", "a", "==", "2"], []) then prints:("a\n2\n")
("sort", ["a"], [["2"], ["1"]], [2, 3], [44, 0, 0, 0, 0], ["sort", "a"], []):("sort", ["a"], [["2"], ["1"]], [2, 3], [44, 0, 0, 0, 0], ["sort", "a"], []) then prints:("a\n1\n2\n")
("count", ["a"], [["2"], ["1"]], [2, 3], [44, 0, 0, 0, 0], ["count"], []):("count", ["a"], [["2"], ["1"]], [2, 3], [44, 0, 0, 0, 0], ["count"], []) then prints:("2\n")
("head", ["a"], [["2"], ["1"]], [2, 3], [44, 0, 0, 0, 0], ["head", "1"], []):("head", ["a"], [["2"], ["1"]], [2, 3], [44, 0, 0, 0, 0], ["head", "1"], []) then prints:("a\n2\n")
("stats", ["a"], [["2"], ["4"]], [2, 3], [44, 0, 0, 0, 0], ["stats", "a"], []):("stats", ["a"], [["2"], ["4"]], [2, 3], [44, 0, 0, 0, 0], ["stats", "a"], []) then prints:("count,min,max,mean,sum\n2,2,4,3,6\n")

cli_path(string[] arguments) {
  int at = list_string_index((import cmd_names), arguments[0]);
  string path = "-";
  if (len(arguments) > 1 + (import cmd_need)[at]) {
    path = arguments[1 + (import cmd_need)[at]];
  }
} return string path;
(["count"]):("-")
(["count", "f.csv"]):("f.csv")
(["select", "a"]):("-")
(["select", "a", "f.csv"]):("f.csv")
(["filter", "a", "==", "1", "g.csv"]):("g.csv")

