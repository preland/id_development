cli_use(string[] arguments, int[] options, string[] diag) {
  int exit_status = 2;
  if (len(diag) == 0 && len(arguments) > 0) {
    exit_status = cli_go(arguments, options, diag);
  } else {
    cli_usage(diag);
  }
} return int exit_status;
