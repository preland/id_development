cli_argument(string[] argv, int[] scan_state, int[] options, string[] arguments, string[] diag) {
  string argument = argv[scan_state[0]];
  int argument_kind = cli_kind(argument, scan_state[1]);
  cli_apply(argument_kind, argument, argv, scan_state, options, arguments, diag);
} return void;
