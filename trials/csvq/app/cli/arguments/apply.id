cli_apply(int option_kind, string argument, string[] argv, int[] scan_state, int[] options, string[] arguments, string[] diag) {
  if (option_kind == 0) {
    push(arguments, argument);
    scan_state[0] = scan_state[0] + 1;
  }
  if (option_kind == 1) {
    options[(import flag_slots)[list_string_index((import flag_names), argument)]] = 1;
    scan_state[0] = scan_state[0] + 1;
  }
  if (option_kind == 2) {
    cli_value(argv, scan_state, options, diag);
  }
} chain (int option_kind, string argument, string[] argv, int[] scan_state, int[] options, string[] arguments, string[] diag) {
  if (option_kind == 3) {
    string delimiter_name = str_sub(argument, 12, len(argument) - 12);
    cli_delimiter(delimiter_name, options, diag);
    scan_state[0] = scan_state[0] + 1;
  }
  if (option_kind == 4) {
    push(diag, "unknown option '" + argument + "'; an argument that starts with '-' must come after '--'");
    scan_state[0] = scan_state[0] + 1;
  }
  if (option_kind == 5) {
    scan_state[1] = 1;
    scan_state[0] = scan_state[0] + 1;
  }
} return void;
