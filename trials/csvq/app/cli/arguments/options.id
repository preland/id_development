cli_value(string[] argv, int[] scan_state, int[] options, string[] diag) {
  if (scan_state[0] + 1 < len(argv)) {
    cli_delimiter(argv[scan_state[0] + 1], options, diag);
    scan_state[0] = scan_state[0] + 2;
  } else {
    push(diag, "option '" + argv[scan_state[0]] + "' needs a value");
    scan_state[0] = scan_state[0] + 1;
  }
} return void;
