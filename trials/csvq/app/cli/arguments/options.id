cli_scan(string[] argv, int[] options, string[] arguments, string[] diag) {
  int[] scan_state = [1, 0];
  while (scan_state[0] < len(argv) && len(diag) == 0) {
    cli_argument(argv, scan_state, options, arguments, diag);
  }
} return void;
