  if (character_code < 0 || character_code == (import ch_quote) || character_code == (import ch_nl) || character_code == (import ch_cr)) {
    push(diag, "the delimiter must be one byte other than a quote or a newline, or one of: tab, comma, semicolon, pipe, space; got '" + delimiter_name + "'");
  } else {
