cli_option_kind(string argument) {
  int argument_kind = 4;
  if (argument == "--") {
    argument_kind = 5;
  }
  if (list_string_index((import flag_names), argument) >= 0) {
    argument_kind = 1;
  }
} chain (string argument) {
  if (argument == "-d" || argument == "--delimiter") {
    argument_kind = 2;
  }
  if (string_starts_with(argument, "--delimiter=") == 1) {
    argument_kind = 3;
  }
} return int argument_kind;
("--"):(5)
("--desc"):(1)
("-h"):(1)
("-d"):(2)
("--delimiter"):(2)
("--delimiter=;"):(3)
("--bogus"):(4)
("-5"):(4)

cli_kind(string argument, int after_dashes) {
  int argument_kind = 0;
  if (after_dashes == 0 && len(argument) > 1 && character_code_at(argument, 0) == (import ch_minus)) {
    argument_kind = cli_option_kind(argument);
  }
} return int argument_kind;
("select", 0):(0)
("-", 0):(0)
("", 0):(0)
("--desc", 0):(1)
("--desc", 1):(0)
("-x", 0):(4)

cli_delimiter_code(string delimiter_name) {
  int delimiter_code = -1;
  if (list_string_index((import delim_names), delimiter_name) >= 0) {
    delimiter_code = (import delim_codes)[list_string_index((import delim_names), delimiter_name)];
  } else {
    if (len(delimiter_name) == 1) {
      delimiter_code = character_code_at(delimiter_name, 0);
    }
  }
} return int delimiter_code;
("tab"):(9)
("\\t"):(9)
("semicolon"):(59)
(";"):(59)
("|"):(124)
(""):(-1)
("ab"):(-1)
