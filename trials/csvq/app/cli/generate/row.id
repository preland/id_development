generate_score(int[] generator_state) {
  int whole = generate_next(generator_state) % 101;
  int cents = generate_next(generator_state) % 100;
  string score_text = whole + "." + format_integer_zero_padded(cents, 2);
} return string score_text;
([1]):("72.58")
([0]):("0.68")

generate_row(int[] generator_state, int index) {
  string[] row = ["" + index];
  push(row, generate_pick((import gen_names), generator_state));
  push(row, generate_pick((import gen_depts), generator_state));
} chain (int[] generator_state, int index) {
  push(row, "" + (18 + generate_next(generator_state) % 63));
  push(row, generate_score(generator_state));
  push(row, generate_pick((import gen_notes), generator_state));
} return string[] row;
