generate_next(int[] generator_state) {
  generator_state[0] = generator_state[0] * 1103515245 + 12345;
  int random_value = ushr(generator_state[0], 16) & 32767;
} return int random_value;
([1]):(16838)
([0]):(0)
([2]):(908)

generate_pick(string[] choices, int[] generator_state) {
  int at = generate_next(generator_state) % len(choices);
  string picked = choices[at];
} return string picked;
(["a", "b", "c"], [1]):("c")
(["a", "b", "c"], [0]):("a")
