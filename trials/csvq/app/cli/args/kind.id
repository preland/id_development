cli_opt(string arg) {
  int k = 4;
  if (arg == "--") {
    k = 5;
  }
  if (lst_str_index((import flag_names), arg) >= 0) {
    k = 1;
  }
} chain (string arg) {
  if (arg == "-d" || arg == "--delimiter") {
    k = 2;
  }
  if (str_starts(arg, "--delimiter=") == 1) {
    k = 3;
  }
} return int k;
("--"):(5)
("--desc"):(1)
("-h"):(1)
("-d"):(2)
("--delimiter"):(2)
("--delimiter=;"):(3)
("--bogus"):(4)
("-5"):(4)

cli_kind(string arg, int dd) {
  int k = 0;
  if (dd == 0 && len(arg) > 1 && charat(arg, 0) == (import ch_minus)) {
    k = cli_opt(arg);
  }
} return int k;
("select", 0):(0)
("-", 0):(0)
("", 0):(0)
("--desc", 0):(1)
("--desc", 1):(0)
("-x", 0):(4)

cli_dcode(string dv) {
  int c = -1;
  if (lst_str_index((import delim_names), dv) >= 0) {
    c = (import delim_codes)[lst_str_index((import delim_names), dv)];
  } else {
    if (len(dv) == 1) {
      c = charat(dv, 0);
    }
  }
} return int c;
("tab"):(9)
("\\t"):(9)
("semicolon"):(59)
(";"):(59)
("|"):(124)
(""):(-1)
("ab"):(-1)
