(5, "--", ["csvq", "--"], [1, 0], [44, 0, 0, 0, 0], [], []):(5, "--", ["csvq", "--"], [2, 1], [44, 0, 0, 0, 0], [], [])

cli_arg(string[] argv, int[] st, int[] o, string[] args, string[] diag) {
  string arg = argv[st[0]];
  int k = cli_kind(arg, st[1]);
  cli_apply(k, arg, argv, st, o, args, diag);
} return void;
