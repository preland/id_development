cli_apply(int k, string arg, string[] argv, int[] st, int[] o, string[] args, string[] diag) {
  if (k == 0) {
    push(args, arg);
    st[0] = st[0] + 1;
  }
  if (k == 1) {
    o[(import flag_slots)[list_string_index((import flag_names), arg)]] = 1;
    st[0] = st[0] + 1;
  }
  if (k == 2) {
    cli_value(argv, st, o, diag);
  }
} chain (int k, string arg, string[] argv, int[] st, int[] o, string[] args, string[] diag) {
  if (k == 3) {
    string dv = str_sub(arg, 12, len(arg) - 12);
    cli_delim(dv, o, diag);
    st[0] = st[0] + 1;
  }
  if (k == 4) {
    push(diag, "unknown option '" + arg + "'; an argument that starts with '-' must come after '--'");
    st[0] = st[0] + 1;
  }
  if (k == 5) {
    st[1] = 1;
    st[0] = st[0] + 1;
  }
} return void;
