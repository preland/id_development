cli_delim(string dv, int[] o, string[] diag) {
  int c = cli_dcode(dv);
  if (c < 0 || c == (import ch_quote) || c == (import ch_nl) || c == (import ch_cr)) {
    push(diag, "the delimiter must be one byte other than a quote or a newline, or one of: tab, comma, semicolon, pipe, space; got '" + dv + "'");
  } else {
    o[(import o_delim)] = c;
  }
} return void;
