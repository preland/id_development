cli_value(string[] argv, int[] st, int[] o, string[] diag) {
  if (st[0] + 1 < len(argv)) {
    cli_delim(argv[st[0] + 1], o, diag);
    st[0] = st[0] + 2;
  } else {
    push(diag, "option '" + argv[st[0]] + "' needs a value");
    st[0] = st[0] + 1;
  }
} return void;
