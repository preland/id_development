gen_score(int[] gs) {
  int whole = gen_next(gs) % 101;
  int cents = gen_next(gs) % 100;
  string t = whole + "." + gen_two(cents);
} return string t;
([1]):("72.58")
([0]):("0.68")

gen_row(int[] gs, int i) {
  string[] row = ["" + i];
  push(row, gen_pick((import gen_names), gs));
  push(row, gen_pick((import gen_depts), gs));
} chain (int[] gs, int i) {
  push(row, "" + (18 + gen_next(gs) % 63));
  push(row, gen_score(gs));
  push(row, gen_pick((import gen_notes), gs));
} return string[] row;
