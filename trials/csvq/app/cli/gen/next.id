gen_two(int n) {
  string t = "" + n;
  if (n < 10) {
    t = "0" + t;
  }
} return string t;
(5):("05")
(42):("42")
(0):("00")

gen_pick(string[] xs, int[] gs) {
  int at = gen_next(gs) % len(xs);
  string t = xs[at];
} return string t;
(["a", "b", "c"], [1]):("c")
(["a", "b", "c"], [0]):("a")
