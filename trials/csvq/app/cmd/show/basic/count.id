cmd_count(string[] hdr, string[][] rows, int[] lines, int[] o, string[] args, string[] diag) {
  print(len(rows));
} return void;
(["a"], [["1"], ["2"], ["3"]], [2, 3, 4], [44, 0, 0, 0, 0], ["count"], []):(["a"], [["1"], ["2"], ["3"]], [2, 3, 4], [44, 0, 0, 0, 0], ["count"], []) then prints:("3\n")
(["a"], [], [], [44, 0, 0, 0, 0], ["count"], []):(["a"], [], [], [44, 0, 0, 0, 0], ["count"], []) then prints:("0\n")

row_take(string[][] rows, int n, string[][] keep) {
  int i = 0;
  while (i < n && i < len(rows)) {
    push(keep, rows[i]);
    i = i + 1;
  }
} return void;
([["a"], ["b"], ["c"]], 2, []):([["a"], ["b"], ["c"]], 2, [["a"], ["b"]])
([["a"]], 5, []):([["a"]], 5, [["a"]])
([["a"]], 0, []):([["a"]], 0, [])

cmd_head(string[] hdr, string[][] rows, int[] lines, int[] o, string[] args, string[] diag) {
  int n = col_uint(args[1]);
  if (n < 0) {
    push(diag, "head needs a non-negative integer, got '" + args[1] + "'");
  } else {
    string[][] keep = [];
    row_take(rows, n, keep);
    out_table(hdr, keep, o);
  }
} return void;
(["a"], [["1"], ["2"], ["3"]], [2, 3, 4], [44, 0, 0, 0, 0], ["head", "2"], []):(["a"], [["1"], ["2"], ["3"]], [2, 3, 4], [44, 0, 0, 0, 0], ["head", "2"], []) then prints:("a\n1\n2\n")
(["a"], [["1"]], [2], [44, 0, 0, 0, 0], ["head", "x"], []):(["a"], [["1"]], [2], [44, 0, 0, 0, 0], ["head", "x"], ["head needs a non-negative integer, got 'x'"])
(["a"], [["1"]], [2], [44, 0, 0, 0, 0], ["head", "0"], []):(["a"], [["1"]], [2], [44, 0, 0, 0, 0], ["head", "0"], []) then prints:("a\n")
