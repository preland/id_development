sta_sum(float[] acc, float fx) {
  float ft = acc[(import a_sum)] + fx;
  acc[(import a_comp)] = acc[(import a_comp)] + sta_lost(acc[(import a_sum)], fx, ft);
  acc[(import a_sum)] = ft;
} return void;
