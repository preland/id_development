sta_abs(float fx) {
  float fy = fx;
  if (fx < 0.0) {
    fy = 0.0 - fx;
  }
} return float fy;
(-2.5):(2.5)
(3.0):(3.0)
(0.0):(0.0)

sta_lost(float fa, float fb, float ft) {
  float fl = (fb - ft) + fa;
  if (sta_abs(fa) >= sta_abs(fb)) {
    fl = (fa - ft) + fb;
  }
  if (flt_isfinite(ft) == 0) {
    fl = 0.0;
  }
} return float fl;
