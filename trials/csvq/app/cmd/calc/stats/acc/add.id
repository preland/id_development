sta_fill(float[] acc, string[] row) {
  float ft = acc[(import a_sum)] + acc[(import a_comp)];
  row[0] = num_fmt(acc[(import a_cnt)]);
  row[1] = num_fmt(acc[(import a_min)]);
} chain (float[] acc, string[] row) {
  row[2] = num_fmt(acc[(import a_max)]);
  row[3] = num_fmt(ft / acc[(import a_cnt)]);
  row[4] = num_fmt(ft);
} return void;
