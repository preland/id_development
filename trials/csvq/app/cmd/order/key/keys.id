srt_num(string cell, int ln, string name, float[] nk, string[] diag) {
  if (num_ok(cell) == 1) {
    push(nk, num_val(cell));
  } else {
    push(diag, "line " + ln + ": '" + cell + "' in column '" + name + "' is not a number (needed by --numeric)");
  }
} return void;
("2.5", 3, "age", [], []):("2.5", 3, "age", [2.5], [])
("abc", 7, "age", [], []):("abc", 7, "age", [], ["line 7: 'abc' in column 'age' is not a number (needed by --numeric)"])

srt_key(string cell, int ln, string name, int num, string[] sk, float[] nk, string[] diag) {
  if (num == 0) {
    push(sk, cell);
  } else {
    srt_num(cell, ln, name, nk, diag);
  }
} return void;
("x", 2, "c", 0, [], [], []):("x", 2, "c", 0, ["x"], [], [])
("4", 2, "c", 1, [], [], []):("4", 2, "c", 1, [], [4.0], [])
("q", 5, "c", 1, [], [], []):("q", 5, "c", 1, [], [], ["line 5: 'q' in column 'c' is not a number (needed by --numeric)"])

srt_keys(string[][] rows, int[] lines, string[] hdr, int col, int[] o, string[] sk, float[] nk, string[] diag) {
  int i = 0;
  while (i < len(rows) && len(diag) == 0) {
    srt_key(rows[i][col], lines[i], hdr[col], o[(import o_num)], sk, nk, diag);
    i = i + 1;
  }
} return void;
([["a", "9"], ["b", "10"]], [2, 3], ["k", "v"], 1, [44, 0, 0, 0, 0], [], [], []):([["a", "9"], ["b", "10"]], [2, 3], ["k", "v"], 1, [44, 0, 0, 0, 0], ["9", "10"], [], [])
([["a", "9"], ["b", "10"]], [2, 3], ["k", "v"], 1, [44, 0, 1, 0, 0], [], [], []):([["a", "9"], ["b", "10"]], [2, 3], ["k", "v"], 1, [44, 0, 1, 0, 0], [], [9.0, 10.0], [])
([["a", "9"], ["b", "x"], ["c", "y"]], [2, 3, 4], ["k", "v"], 1, [44, 0, 1, 0, 0], [], [], []):([["a", "9"], ["b", "x"], ["c", "y"]], [2, 3, 4], ["k", "v"], 1, [44, 0, 1, 0, 0], [], [9.0], ["line 3: 'x' in column 'v' is not a number (needed by --numeric)"])
