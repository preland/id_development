srt_gtext(string[] sk, int dir, int a, int b) {
  int sg = string_compare(sk[a], sk[b]);
  int after = sg * dir > 0;
} return int after;
(["a", "b"], 1, 0, 1):(0)
(["b", "a"], 1, 0, 1):(1)
(["a", "b"], -1, 0, 1):(1)
(["x", "x"], -1, 0, 1):(0)

srt_gnum(float[] nk, int dir, int a, int b) {
  int sg = num_cmp(nk[a], nk[b]);
  int after = sg * dir > 0;
} return int after;
([1.5, 2.5], 1, 0, 1):(0)
([1.5, 2.5], 1, 1, 0):(1)
([1.5, 2.5], -1, 0, 1):(1)
([2.0, 2.0], 1, 0, 1):(0)
