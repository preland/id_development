srt_ctext(string[] sk, float[] nk, int a, int b) {
  int sg = str_cmp(sk[a], sk[b]);
} return int sg;
(["a", "b"], [], 0, 1):(-1)
(["b", "a"], [], 0, 1):(1)
(["x", "x"], [], 0, 1):(0)

srt_cnum(string[] sk, float[] nk, int a, int b) {
  int sg = num_cmp(nk[a], nk[b]);
} return int sg;
([], [1.5, 2.5], 0, 1):(-1)
([], [1.5, 2.5], 1, 0):(1)
([], [2.0, 2.0], 0, 1):(0)

srt_iota(int n) {
  int[] order = [];
  int i = 0;
  while (i < n) {
    push(order, i);
    i = i + 1;
  }
} return int[] order;
(3):([0, 1, 2])
(0):([])
