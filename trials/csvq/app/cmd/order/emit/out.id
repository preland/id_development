srt_rows(string[][] rows, int[] order) {
  string[][] sorted = [];
  int i = 0;
  while (i < len(order)) {
    push(sorted, rows[order[i]]);
    i = i + 1;
  }
} return string[][] sorted;
([["a"], ["b"], ["c"]], [2, 0, 1]):([["c"], ["a"], ["b"]])
([["a"]], []):([])

srt_out(string[] hdr, string[][] rows, int[] order, int[] o) {
  string[][] sorted = srt_rows(rows, order);
  out_table(hdr, sorted, o);
} return void;
(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 0, 0]):(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 0, 0]) then prints:("k\nb\na\n")
(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 1, 0]):(["k"], [["a"], ["b"]], [1, 0], [44, 0, 0, 1, 0]) then prints:("b\na\n")

srt_do(int[] order, string[] sk, float[] nk, int[] o) {
  int dir = 1 - 2 * o[(import o_desc)];
  if (o[(import o_num)] == 1) {
    srt_run(order, sk, nk, srt_cnum, dir);
  } else {
    srt_run(order, sk, nk, srt_ctext, dir);
  }
} return void;
([0, 1, 2], ["b", "c", "a"], [], [44, 0, 0, 0, 0]):([2, 0, 1])
([0, 1, 2], ["b", "c", "a"], [], [44, 1, 0, 0, 0]):([1, 0, 2])
([0, 1, 2], [], [2.0, 10.0, 1.0], [44, 0, 1, 0, 0]):([2, 0, 1])
([0, 1, 2], [], [2.0, 10.0, 1.0], [44, 1, 1, 0, 0]):([1, 0, 2])
