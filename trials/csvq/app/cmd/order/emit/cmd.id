srt_emit(string[] hdr, string[][] rows, int[] o, string[] sk, float[] nk) {
  int[] order = srt_iota(len(rows));
  srt_do(order, sk, nk, o);
  srt_out(hdr, rows, order, o);
} return void;
(["k"], [["b"], ["a"]], [44, 0, 0, 0, 0], ["b", "a"], []):(["k"], [["b"], ["a"]], [44, 0, 0, 0, 0], ["b", "a"], []) then prints:("k\na\nb\n")
(["k"], [["b"], ["a"]], [44, 1, 0, 0, 0], ["b", "a"], []):(["k"], [["b"], ["a"]], [44, 1, 0, 0, 0], ["b", "a"], []) then prints:("k\nb\na\n")

srt_all(string[] hdr, string[][] rows, int[] lines, int[] o, int col, string[] diag) {
  string[] sk = [];
  float[] nk = [];
  srt_keys(rows, lines, hdr, col, o, sk, nk, diag);
} chain (string[] hdr, string[][] rows, int[] lines, int[] o, int col, string[] diag) {
  if (len(diag) == 0) {
    srt_emit(hdr, rows, o, sk, nk);
  }
} return void;
(["k", "v"], [["a", "2"], ["b", "10"]], [2, 3], [44, 0, 1, 0, 0], 1, []):(["k", "v"], [["a", "2"], ["b", "10"]], [2, 3], [44, 0, 1, 0, 0], 1, []) then prints:("k,v\na,2\nb,10\n")
(["k", "v"], [["a", "2"], ["b", "10"]], [2, 3], [44, 0, 0, 0, 0], 1, []):(["k", "v"], [["a", "2"], ["b", "10"]], [2, 3], [44, 0, 0, 0, 0], 1, []) then prints:("k,v\nb,10\na,2\n")
(["k", "v"], [["a", "2"], ["b", "x"]], [2, 3], [44, 0, 1, 0, 0], 1, []):(["k", "v"], [["a", "2"], ["b", "x"]], [2, 3], [44, 0, 1, 0, 0], 1, ["line 3: 'x' in column 'v' is not a number (needed by --numeric)"]) then prints:("")

cmd_sort(string[] hdr, string[][] rows, int[] lines, int[] o, string[] args, string[] diag) {
  int[] idx = [];
  col_pick(hdr, args[1], idx, diag);
  if (len(diag) == 0) {
    srt_all(hdr, rows, lines, o, idx[0], diag);
  }
} return void;
(["k", "v"], [["b", "1"], ["a", "2"]], [2, 3], [44, 0, 0, 0, 0], ["sort", "k"], []):(["k", "v"], [["b", "1"], ["a", "2"]], [2, 3], [44, 0, 0, 0, 0], ["sort", "k"], []) then prints:("k,v\na,2\nb,1\n")
