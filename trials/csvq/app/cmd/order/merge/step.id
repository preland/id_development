srt_left(int[] order, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int[] sp) {
  int i = sp[(import sp_i)];
  int j = sp[(import sp_j)];
  int left = i < sp[(import sp_mid)] && (j >= sp[(import sp_hi)] || cmp(sk, nk, order[i], order[j]) * sp[(import sp_dir)] <= 0);
} return int left;
([0, 1], ["b", "a"], [], srt_ctext, [0, 1, 2, 1, 0, 1, 0]):(0)
([0, 1], ["a", "b"], [], srt_ctext, [0, 1, 2, 1, 0, 1, 0]):(1)
([0, 1], ["a", "b"], [], srt_ctext, [0, 1, 2, -1, 0, 1, 0]):(0)
([0, 1], ["x", "x"], [], srt_ctext, [0, 1, 2, -1, 0, 1, 0]):(1)
([0, 1], [], [3.0, 3.0], srt_cnum, [0, 1, 2, 1, 1, 1, 0]):(0)
([0, 1], [], [3.0, 1.0], srt_cnum, [0, 1, 2, 1, 0, 2, 0]):(1)

srt_take(int[] order, int[] tmp, int[] sp, int slot) {
  tmp[sp[(import sp_k)]] = order[sp[slot]];
  sp[slot] = sp[slot] + 1;
  sp[(import sp_k)] = sp[(import sp_k)] + 1;
} return void;
([10, 20], [0, 0], [0, 1, 2, 1, 0, 1, 0], 4):([10, 20], [10, 0], [0, 1, 2, 1, 1, 1, 1])
([10, 20], [0, 0], [0, 1, 2, 1, 0, 1, 0], 5):([10, 20], [20, 0], [0, 1, 2, 1, 0, 2, 1])

srt_step(int[] order, int[] tmp, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int[] sp) {
  int left = srt_left(order, sk, nk, cmp, sp);
  if (left == 1) {
    srt_take(order, tmp, sp, (import sp_i));
  } else {
    srt_take(order, tmp, sp, (import sp_j));
  }
} return void;
([1, 0], [9, 9], ["b", "a"], [], srt_ctext, [0, 1, 2, 1, 0, 1, 0]):([1, 0], [1, 9], ["b", "a"], [], srt_ctext, [0, 1, 2, 1, 1, 1, 1])
([0, 1], [9, 9], ["b", "a"], [], srt_ctext, [0, 1, 2, 1, 0, 1, 0]):([0, 1], [1, 9], ["b", "a"], [], srt_ctext, [0, 1, 2, 1, 0, 2, 1])
