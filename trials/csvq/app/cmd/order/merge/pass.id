srt_merge(int[] order, int[] tmp, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int[] sp) {
  sp[(import sp_i)] = sp[(import sp_lo)];
  sp[(import sp_j)] = sp[(import sp_mid)];
  sp[(import sp_k)] = sp[(import sp_lo)];
} chain (int[] order, int[] tmp, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int[] sp) {
  while (sp[(import sp_k)] < sp[(import sp_hi)]) {
    srt_step(order, tmp, sk, nk, cmp, sp);
  }
} return void;
([0, 1, 2, 3], [9, 9, 9, 9], ["c", "a", "b", "d"], [], srt_ctext, [0, 1, 2, 1, 0, 0, 0]):([0, 1, 2, 3], [1, 0, 9, 9], ["c", "a", "b", "d"], [], srt_ctext, [0, 1, 2, 1, 1, 2, 2])
([0, 1, 2, 3], [9, 9, 9, 9], ["a", "b", "c", "d"], [], srt_ctext, [0, 2, 4, 1, 0, 0, 0]):([0, 1, 2, 3], [0, 1, 2, 3])
([2, 3], [9, 9], [], [5.0, 5.0, 2.0, 1.0], srt_cnum, [0, 1, 2, -1, 0, 0, 0]):([2, 3], [2, 3])

srt_span(int[] sp, int n, int width) {
  sp[(import sp_mid)] = fx_min(sp[(import sp_lo)] + width, n);
  sp[(import sp_hi)] = fx_min(sp[(import sp_lo)] + width * 2, n);
} return void;
([0, 0, 0, 1, 0, 0, 0], 5, 2):([0, 2, 4, 1, 0, 0, 0], 5, 2)
([4, 0, 0, 1, 0, 0, 0], 5, 2):([4, 5, 5, 1, 0, 0, 0], 5, 2)

srt_pass(int[] order, int[] tmp, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int[] sp, int width) {
  sp[(import sp_lo)] = 0;
  while (sp[(import sp_lo)] < len(order)) {
    srt_span(sp, len(order), width);
    srt_merge(order, tmp, sk, nk, cmp, sp);
    sp[(import sp_lo)] = sp[(import sp_lo)] + width * 2;
  }
  srt_copy(tmp, order);
} return void;
([0, 1, 2, 3], [0, 0, 0, 0], ["d", "c", "b", "a"], [], srt_ctext, [0, 0, 0, 1, 0, 0, 0], 1):([1, 0, 3, 2], [1, 0, 3, 2])
([1, 0, 3, 2], [0, 0, 0, 0], ["d", "c", "b", "a"], [], srt_ctext, [0, 0, 0, 1, 0, 0, 0], 2):([3, 2, 1, 0], [3, 2, 1, 0])
([0, 1, 2], [0, 0, 0], [], [3.0, 2.0, 1.0], srt_cnum, [0, 0, 0, 1, 0, 0, 0], 4):([0, 1, 2], [0, 1, 2])
