srt_copy(int[] tmp, int[] order) {
  int i = 0;
  while (i < len(tmp)) {
    order[i] = tmp[i];
    i = i + 1;
  }
} return void;
([3, 4], [0, 0]):([3, 4], [3, 4])
([], []):([], [])

srt_run(int[] order, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int dir) {
  int[] tmp = lst_copy(order);
  int[] sp = [0, 0, 0, dir, 0, 0, 0];
  int width = 1;
} chain (int[] order, string[] sk, float[] nk, func(string[], float[], int, int) return int cmp, int dir) {
  while (width < len(order)) {
    srt_pass(order, tmp, sk, nk, cmp, sp, width);
    width = width * 2;
  }
} return void;
([0, 1, 2], ["b", "c", "a"], [], srt_ctext, 1):([2, 0, 1])
([0, 1, 2], ["b", "c", "a"], [], srt_ctext, -1):([1, 0, 2])
([0, 1, 2], ["x", "x", "x"], [], srt_ctext, -1):([0, 1, 2])
([0, 1, 2, 3, 4], [], [3.0, 1.0, 2.0, 1.0, 3.0], srt_cnum, 1):([1, 3, 2, 0, 4])
([], [], [], srt_cnum, 1):([])
