number_digits_value(string number_text, int digit_index) {
  int exponent_value = 0;
  while (character_is_digit(character_code_at(number_text, digit_index)) == 1) {
    exponent_value = exponent_value * 10 + character_code_at(number_text, digit_index) - (import ch_zero);
    if (exponent_value > 1000) {
      exponent_value = 1000;
    }
    digit_index = digit_index + 1;
  }
} return int exponent_value;
("123", 0):(123)
("5x", 0):(5)
("99999", 0):(1000)
("x", 0):(0)

number_fraction_digits(string number_text) {
  int dot_index = string_find(number_text, ".");
  int fd = 0;
  if (dot_index >= 0) {
    fd = number_digits(number_text, dot_index + 1) - dot_index - 1;
  }
} return int fd;
("12.345"):(3)
("12"):(0)
("1.5e3"):(1)
(".5"):(1)
("5."):(0)

number_compare(float first_float, float second_float) {
  int comparison = (first_float > second_float) - (first_float < second_float);
} return int comparison;
(1.5, 2.5):(-1)
(2.5, 2.5):(0)
(3.0, 2.5):(1)
(-1.0, -2.0):(1)
