number_value(string number_text) {
  word[] mantissa_words = [0, 0];
  number_mantissa_value(number_text, mantissa_words);
  int decimal_exponent = number_exponent(number_text) - number_fraction_digits(number_text) + mantissa_words[1];
} chain (string number_text) {
  float mantissa = mantissa_words[0];
  float signed_value = number_scale(mantissa, decimal_exponent);
  if (character_code_at(number_text, 0) == (import ch_minus)) {
    signed_value = 0.0 - signed_value;
  }
} return float signed_value;
