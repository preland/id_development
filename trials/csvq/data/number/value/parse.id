number_mantissa_value(string number_text, word[] mantissa_words) {
  int index = 0;
  while (number_stop(character_code_at(number_text, index)) == 0) {
    number_step(mantissa_words, character_code_at(number_text, index));
    index = index + 1;
  }
} return void;
