number_step(word[] mantissa_words, int character_code) {
  if (character_is_digit(character_code) == 1 && mantissa_words[0] < 100000000000000000) {
    mantissa_words[0] = mantissa_words[0] * 10 + (character_code - (import ch_zero));
  } else {
    if (character_is_digit(character_code) == 1) {
      mantissa_words[1] = mantissa_words[1] + 1;
    }
  }
} return void;
([0, 0], 55):([7, 0], 55)
([12, 0], 51):([123, 0], 51)
([5, 0], 46):([5, 0], 46)
([5, 0], -1):([5, 0], -1)
