number_power_ten(int exponent) {
  float power = 1.0;
  int index = 0;
  while (index < exponent) {
    power = power * 10.0;
    index = index + 1;
  }
} return float power;
(0):(1.0)
(3):(1000.0)
(15):(1000000000000000.0)
(22):(10000000000000000000000.0)

number_shift(float mantissa, int shift_step) {
  float scaled = mantissa;
  if (shift_step >= 0) {
    scaled = mantissa * number_power_ten(shift_step);
  } else {
    scaled = mantissa / number_power_ten(0 - shift_step);
  }
} return float scaled;
(125.0, -1):(12.5)
(3.0, 2):(300.0)
(7.0, 0):(7.0)
(1.0, -3):(0.001)

number_scale(float mantissa, int remaining_exponent) {
  float scaled = mantissa;
  while (remaining_exponent != 0) {
    scaled = number_shift(scaled, fixed_point_clamp(remaining_exponent, -22, 22));
    remaining_exponent = remaining_exponent - fixed_point_clamp(remaining_exponent, -22, 22);
  }
} return float scaled;
(1.0, 30):(1000000000000000000000000000000.0)
(125.0, -1):(12.5)
(5.0, 0):(5.0)
(1000000000000000000000000000000.0, -30):(1.0)
