number_exponent_up(float float_value) {
  float power = 10.0;
  int exponent_ten = 0;
  while (power <= float_value) {
    power = power * 10.0;
    exponent_ten = exponent_ten + 1;
  }
} return int exponent_ten;
(1.0):(0)
(9.5):(0)
(10.0):(1)
(12345.0):(4)
(1000000000000000.0):(15)

number_exponent_down(float float_value) {
  float power = 1.0;
  int exponent_ten = 0;
  while (power > float_value) {
    power = power / 10.0;
    exponent_ten = exponent_ten - 1;
  }
} return int exponent_ten;
(0.5):(-1)
(0.1):(-1)
(0.05):(-2)
(0.001):(-3)

number_exponent_ten(float float_value) {
  int exponent_ten = 0;
  if (float_value >= 1.0) {
    exponent_ten = number_exponent_up(float_value);
  } else {
    exponent_ten = number_exponent_down(float_value);
  }
} return int exponent_ten;
(123.0):(2)
(0.0123):(-2)
(1.0):(0)
(0.9):(-1)
