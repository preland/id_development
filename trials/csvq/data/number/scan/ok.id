number_ok(string number_text) {
  int mantissa_end = number_mantissa_end(number_text);
  int exponent_end = number_exponent_end(number_text, mantissa_end);
  int ok = exponent_end >= 0 && character_code_at(number_text, exponent_end) < 0;
} return int ok;
("42"):(1)
("-3.5"):(1)
("+.5e-3"):(1)
("1e5"):(1)
("5."):(1)
(""):(0)
("abc"):(0)
("1e"):(0)
("1.2.3"):(0)
("12 "):(0)
("."):(0)
("--1"):(0)

number_stop(int character_code) {
  int stop = character_code < 0 || character_code == (import ch_e) || character_code == (import ch_ecap);
} return int stop;
(-1):(1)
(101):(1)
(69):(1)
(53):(0)

number_exponent_start(string number_text) {
  int index = 0;
  while (number_stop(character_code_at(number_text, index)) == 0) {
    index = index + 1;
  }
} return int index;
("12e5"):(2)
("125"):(3)
("1.5E-3"):(3)
