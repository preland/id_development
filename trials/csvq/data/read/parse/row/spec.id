csv_first(string spec, int d, string[] row, string[] diag) {
  word base = mem_of_str(spec);
  int[] st = [0, 1, -1, 0];
  csv_record(base, d, st, row, diag);
} return void;
("a,b", 44, [], []):("a,b", 44, ["a", "b"], [])
("\"x,y\",z", 44, [], []):("\"x,y\",z", 44, ["x,y", "z"], [])
("", 44, [], []):("", 44, [""], [])
("\"a", 44, [], []):("\"a", 44, ["a"], ["line 1: quoted field is never closed (missing closing quote)"])
