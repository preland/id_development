csv_keep(int[] st, string[][] rows, int[] lines, string[] row, int ln, string[] diag) {
  if (st[(import s_wid)] < 0) {
    st[(import s_wid)] = len(row);
  }
  if (len(row) == st[(import s_wid)]) {
    push(rows, row);
    push(lines, ln);
  } else {
    push(diag, "line " + ln + ": expected " + st[(import s_wid)] + " fields like the first row, but found " + len(row));
  }
} return void;
([0, 1, -1, 0], [], [], ["a", "b"], 1, []):([0, 1, 2, 0], [["a", "b"]], [1], ["a", "b"], 1, [])
([0, 3, 2, 0], [["x", "y"]], [1], ["c"], 3, []):([0, 3, 2, 0], [["x", "y"]], [1], ["c"], 3, ["line 3: expected 2 fields like the first row, but found 1"])

csv_row(word base, int d, int[] st, string[][] rows, int[] lines, string[] diag) {
  string[] row = [];
  int ln = st[(import s_line)];
  csv_record(base, d, st, row, diag);
} chain (word base, int d, int[] st, string[][] rows, int[] lines, string[] diag) {
  if (len(diag) == 0) {
    csv_keep(st, rows, lines, row, ln, diag);
  }
} return void;
