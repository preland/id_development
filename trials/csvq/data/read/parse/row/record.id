csv_keep(int[] scan_state, string[][] rows, int[] lines, string[] row, int line_number, string[] diag) {
  if (scan_state[(import s_wid)] < 0) {
    scan_state[(import s_wid)] = len(row);
  }
  if (len(row) == scan_state[(import s_wid)]) {
    push(rows, row);
    push(lines, line_number);
  } else {
    push(diag, "line " + line_number + ": expected " + scan_state[(import s_wid)] + " fields like the first row, but found " + len(row));
  }
} return void;
