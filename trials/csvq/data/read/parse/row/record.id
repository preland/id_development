csv_record(word base, int d, int[] st, string[] row, string[] diag) {
  st[(import s_more)] = 1;
  while (st[(import s_more)] == 1 && len(diag) == 0) {
    csv_take(base, d, st, row, diag);
    csv_sep(base, d, st, diag);
  }
} return void;
