  if (character_code > 0) {
    scan_state[(import s_pos)] = scan_state[(import s_pos)] + 1;
    scan_state[(import s_line)] = scan_state[(import s_line)] + 1;
  }
  if (character_code == (import ch_cr) && peek8(base + scan_state[(import s_pos)]) == (import ch_nl)) {
    scan_state[(import s_pos)] = scan_state[(import s_pos)] + 1;
  }
} return void;
