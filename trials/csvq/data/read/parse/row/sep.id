csv_end(word base, int[] st, string[] diag) {
  int c = peek8(base + st[(import s_pos)]);
  if (c == 0 || c == (import ch_nl) || c == (import ch_cr)) {
    csv_eol(base, st);
  } else {
    push(diag, "line " + st[(import s_line)] + ": unexpected character after a closing quote (expected the delimiter or the end of the line)");
  }
} return void;
