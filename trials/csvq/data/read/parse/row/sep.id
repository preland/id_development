csv_sep(word base, int d, int[] st, string[] diag) {
  st[(import s_more)] = 0;
  if (peek8(base + st[(import s_pos)]) == d) {
    st[(import s_pos)] = st[(import s_pos)] + 1;
    st[(import s_more)] = 1;
  } else {
    csv_end(base, st, diag);
  }
} return void;
