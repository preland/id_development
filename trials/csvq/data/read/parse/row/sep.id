csv_eol(word base, int[] st) {
  int c = peek8(base + st[(import s_pos)]);
  if (c > 0) {
    st[(import s_pos)] = st[(import s_pos)] + 1;
    st[(import s_line)] = st[(import s_line)] + 1;
  }
  if (c == (import ch_cr) && peek8(base + st[(import s_pos)]) == (import ch_nl)) {
    st[(import s_pos)] = st[(import s_pos)] + 1;
  }
} return void;
