csv_quoted(word base, int[] scan_state, string[] row, string[] diag) {
  int line_number = scan_state[(import s_line)];
  int index = scan_state[(import s_pos)] + 1;
  int end_index = csv_quote_scan(base, index);
} chain (word base, int[] scan_state, string[] row, string[] diag) {
  push(row, csv_quote_copy(base, index, end_index));
  scan_state[(import s_line)] = scan_state[(import s_line)] + csv_newline_count(base, index, end_index);
  scan_state[(import s_pos)] = end_index + 1;
} chain (word base, int[] scan_state, string[] row, string[] diag) {
  if (peek8(base + end_index) == 0) {
    push(diag, "line " + line_number + ": quoted field is never closed (missing closing quote)");
  }
} return void;
