csv_quote_fill(word base, int index, int end_index, word buffer) {
  int copied_length = 0;
  while (index < end_index) {
    poke8(buffer + copied_length, peek8(base + index));
    copied_length = copied_length + 1;
    index = index + 1 + csv_doubled_quote(base, index);
  }
} return int copied_length;
