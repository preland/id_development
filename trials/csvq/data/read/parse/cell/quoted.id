given csv_sample_buffers ((import sample_quoted), 5, 5, (import scratch_buffer)):(0)

csv_quote_copy(word base, int index, int end_index) {
  word buffer = alloc(end_index - index + 1);
  int row_total = csv_quote_fill(base, index, end_index, buffer);
  string field_text = str_of_mem(buffer, row_total);
} return string field_text;
