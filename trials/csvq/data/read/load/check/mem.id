inp_t_mem() {
  export word nb = alloc(4);
  poke8(nb, 97);
  poke8(nb + 2, 98);
} return void;
():() then inp_t_first:("first 97")
():() then inp_t_third:(98)

inp_t_first() {
  string b_t = "first " + (peek8((import nb)));
} return string b_t;
given inp_t_mem ():("first 97")
():() then traps:("uninitialised export")

inp_t_third() {
  int b = peek8((import nb) + 2);
} return int b;
given inp_t_mem ():(98)
():() then traps:("uninitialised export")
