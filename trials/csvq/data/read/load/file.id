inp_file(string path, int d, string[][] rows, int[] lines, string[] diag) {
  int h = fs_open(path, "r");
  if (h < 0) {
    inp_fail(fs_error(), diag);
  } else {
    inp_slurp(path, h, d, rows, lines, diag);
  }
} return void;
