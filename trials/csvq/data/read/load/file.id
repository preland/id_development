inp_slurp(string path, int h, int d, string[][] rows, int[] lines, string[] diag) {
  int size = fs_size(path);
  word ad = alloc(size + 1);
  int got = fs_read_mem(h, ad, size);
} chain (string path, int h, int d, string[][] rows, int[] lines, string[] diag) {
  fs_close(h);
  if (got >= 0 && got == size) {
    inp_text(ad, size, d, rows, lines, diag);
  } else {
    inp_fail(fs_error(), diag);
  }
} return void;
