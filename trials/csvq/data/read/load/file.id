input_slurp(string path, int file_handle, int delimiter, string[][] rows, int[] lines, string[] diag) {
  int size = fs_size(path);
  word buffer = alloc(size + 1);
  int got = fs_read_mem(file_handle, buffer, size);
} chain (string path, int file_handle, int delimiter, string[][] rows, int[] lines, string[] diag) {
  fs_close(file_handle);
  if (got >= 0 && got == size) {
    input_text(buffer, size, delimiter, rows, lines, diag);
  } else {
    input_fail(fs_error(), diag);
  }
} return void;
