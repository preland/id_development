input_text(word buffer, int row_total, int delimiter, string[][] rows, int[] lines, string[] diag) {
  int at = input_nul_offset(buffer, row_total);
  if (at >= 0) {
    push(diag, "input contains a NUL byte at offset " + at + ", which csvq cannot process");
  } else {
    csv_parse(buffer, delimiter, rows, lines, diag);
  }
} return void;
