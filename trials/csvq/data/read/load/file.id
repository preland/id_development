inp_text(word ad, int n, int d, string[][] rows, int[] lines, string[] diag) {
  int at = inp_nul(ad, n);
  if (at >= 0) {
    push(diag, "input contains a NUL byte at offset " + at + ", which csvq cannot process");
  } else {
    csv_parse(ad, d, rows, lines, diag);
  }
} return void;
