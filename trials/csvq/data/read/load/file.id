input_file(string path, int delimiter, string[][] rows, int[] lines, string[] diag) {
  int file_handle = fs_open(path, "r");
  if (file_handle < 0) {
    input_fail(fs_error(), diag);
  } else {
    input_slurp(path, file_handle, delimiter, rows, lines, diag);
  }
} return void;
