inp_stdin(int d, string[][] rows, int[] lines, string[] diag) {
  word ad = mem_of_str(read_all());
  csv_parse(ad, d, rows, lines, diag);
} return void;
stdin "a,b\n1,2\n" (44, [], [], []):(44, [["a", "b"], ["1", "2"]], [1, 2], [])
stdin "" (44, [], [], []):(44, [], [], [])

inp_load(string path, int d, string[][] rows, int[] lines, string[] diag) {
  if (path == "-") {
    inp_stdin(d, rows, lines, diag);
  } else {
    inp_file(path, d, rows, lines, diag);
  }
} return void;
stdin "x\n" ("-", 44, [], [], []):("-", 44, [["x"]], [1], [])
("/nonexistent/csvq-none", 44, [], [], []):("/nonexistent/csvq-none", 44, [], [], ["cannot read: no such file or directory"])
