input_standard_input(int delimiter, string[][] rows, int[] lines, string[] diag) {
  word buffer = mem_of_str(read_all());
  csv_parse(buffer, delimiter, rows, lines, diag);
} return void;
stdin "a,b\n1,2\n" (44, [], [], []):(44, [["a", "b"], ["1", "2"]], [1, 2], [])
stdin "" (44, [], [], []):(44, [], [], [])

input_load(string path, int delimiter, string[][] rows, int[] lines, string[] diag) {
  if (path == "-") {
    input_standard_input(delimiter, rows, lines, diag);
  } else {
    input_file(path, delimiter, rows, lines, diag);
  }
} return void;
stdin "x\n" ("-", 44, [], [], []):("-", 44, [["x"]], [1], [])
("/nonexistent/csvq-none", 44, [], [], []):("/nonexistent/csvq-none", 44, [], [], ["cannot read: no such file or directory"])
