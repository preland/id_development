num_afmt(float fx) {
  string rs = "inf";
  if (flt_isfinite(fx) == 1) {
    rs = num_fin(fx);
  }
} return string rs;
(2.5):("2.5")
(1024.0):("1024")

num_sfmt(float fx) {
  string rs = "0";
  if (fx > 0.0) {
    rs = num_afmt(fx);
  } else {
    if (fx < 0.0) {
      rs = "-" + num_afmt(0.0 - fx);
    }
  }
} return string rs;
(0.0):("0")
(-2.5):("-2.5")
(7.0):("7")

num_fmt(float fx) {
  string rs = "nan";
  if (fx == fx) {
    rs = num_sfmt(fx);
  }
} return string rs;
(1.5):("1.5")
(-100.0):("-100")
(0.30000000000000004):("0.3")
