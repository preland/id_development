num_t_ratio(float fa, float fb) {
  string rs = num_fmt(fa / fb);
} return string rs;
(0.0, 0.0):("nan")
(1.0, 0.0):("inf")
(-1.0, 0.0):("-inf")
(1.0, 3.0):("0.333333333333333")

num_whole(float fx) {
  int ok = 0;
  if (fx < 1000000000000000000.0) {
    word wv = fx;
    float fb = wv;
    ok = fb == fx;
  }
} return int ok;
(5.0):(1)
(2.5):(0)
(1000000000000000000.0):(0)
(123456789012345678.0):(1)
(0.5):(0)

num_fin(float fx) {
  string rs = "";
  if (num_whole(fx) == 1) {
    word wv = fx;
    rs = "" + wv;
  } else {
    rs = num_body(fx);
  }
} return string rs;
(12.0):("12")
(10000000000000000.0):("10000000000000000")
(0.5):("0.5")
(1000000000000000000000.0):("1e+21")
