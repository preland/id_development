num_up(float fx) {
  float p = 10.0;
  int e = 0;
  while (p <= fx) {
    p = p * 10.0;
    e = e + 1;
  }
} return int e;
(1.0):(0)
(9.5):(0)
(10.0):(1)
(12345.0):(4)
(1000000000000000.0):(15)

num_down(float fx) {
  float p = 1.0;
  int e = 0;
  while (p > fx) {
    p = p / 10.0;
    e = e - 1;
  }
} return int e;
(0.5):(-1)
(0.1):(-1)
(0.05):(-2)
(0.001):(-3)

num_e10(float fx) {
  int e = 0;
  if (fx >= 1.0) {
    e = num_up(fx);
  } else {
    e = num_down(fx);
  }
} return int e;
(123.0):(2)
(0.0123):(-2)
(1.0):(0)
(0.9):(-1)
