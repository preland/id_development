num_scaled(float fx, int e) {
  float fs = num_scale(fx, 14 - e);
  word wv = fs + 0.5;
} return word wv;
(12345.0, 4):(123450000000000)
(0.5, -1):(500000000000000)
(1.5, 0):(150000000000000)

num_e15(float fx) {
  int e = num_e10(fx);
  word wv = num_scaled(fx, e);
  e = e + (wv >= 1000000000000000) - (wv < 100000000000000);
} return int e;
(12345.0):(4)
(0.001):(-3)
(999999999999999.9):(15)
(1.0):(0)

num_ztrim(string ds) {
  int k = len(ds);
  while (k > 1 && charat(ds, k - 1) == (import ch_zero)) {
    k = k - 1;
  }
  string t = str_sub(ds, 0, k);
} return string t;
("123000"):("123")
("100000000000000"):("1")
("0"):("0")
("105"):("105")
