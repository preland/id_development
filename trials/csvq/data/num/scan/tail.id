num_mant(string s) {
  int a = num_sign(s, 0);
  int b = num_digits(s, a);
  int c = num_dot(s, b);
} chain (string s) {
  int r = c;
  if (b == a && c <= b + 1) {
    r = -1;
  }
} return int r;
("12.5e3"):(4)
("-.5"):(3)
("."):(-1)
("+"):(-1)
("5."):(2)
(""):(-1)

num_edigits(string s, int i) {
  int b = num_digits(s, num_sign(s, i));
  int r = b;
  if (b == num_sign(s, i)) {
    r = -1;
  }
} return int r;
("5", 0):(1)
("-12x", 0):(3)
("e", 1):(-1)
("+", 0):(-1)

num_exp(string s, int i) {
  int r = i;
  if (i >= 0 && (charat(s, i) == (import ch_e) || charat(s, i) == (import ch_ecap))) {
    r = num_edigits(s, i + 1);
  }
} return int r;
("1e5", 1):(3)
("1E-5", 1):(4)
("1e", 1):(-1)
("15", 2):(2)
("15", -1):(-1)
