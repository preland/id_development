num_sign(string s, int i) {
  int j = i;
  if (character_code_at(s, i) == (import ch_minus) || character_code_at(s, i) == (import ch_plus)) {
    j = i + 1;
  }
} return int j;
("-5", 0):(1)
("+5", 0):(1)
("5", 0):(0)
("1e-5", 2):(3)
("", 0):(0)

num_digits(string s, int i) {
  while (character_is_digit(character_code_at(s, i)) == 1) {
    i = i + 1;
  }
} return int i;
("123abc", 0):(3)
("abc", 0):(0)
("12", 1):(2)
("", 0):(0)

num_dot(string s, int b) {
  int c = b;
  if (character_code_at(s, b) == (import ch_dot)) {
    c = num_digits(s, b + 1);
  }
} return int c;
("1.25", 1):(4)
("12", 1):(1)
("1.", 1):(2)
("1.5e3", 1):(3)
