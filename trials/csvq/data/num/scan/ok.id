num_ok(string s) {
  int m = num_mant(s);
  int x = num_exp(s, m);
  int ok = x >= 0 && character_code_at(s, x) < 0;
} return int ok;
("42"):(1)
("-3.5"):(1)
("+.5e-3"):(1)
("1e5"):(1)
("5."):(1)
(""):(0)
("abc"):(0)
("1e"):(0)
("1.2.3"):(0)
("12 "):(0)
("."):(0)
("--1"):(0)

num_stop(int c) {
  int stop = c < 0 || c == (import ch_e) || c == (import ch_ecap);
} return int stop;
(-1):(1)
(101):(1)
(69):(1)
(53):(0)

num_estop(string s) {
  int i = 0;
  while (num_stop(character_code_at(s, i)) == 0) {
    i = i + 1;
  }
} return int i;
("12e5"):(2)
("125"):(3)
("1.5E-3"):(3)
