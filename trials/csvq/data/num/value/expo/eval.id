num_eidx(string s) {
  int i = num_estop(s);
  int r = -1;
  if (character_code_at(s, i) >= 0) {
    r = i;
  }
} return int r;
("12e5"):(2)
("125"):(-1)
("1.5E-3"):(3)

num_eval(string s, int i) {
  int j = num_sign(s, i);
  int v = num_run10(s, j);
  if (character_code_at(s, i) == (import ch_minus)) {
    v = 0 - v;
  }
} return int v;
("e-12", 1):(-12)
("e+7", 1):(7)
("e5", 1):(5)
("e99999999999", 1):(1000)

num_ex(string s) {
  int e = num_eidx(s);
  int v = 0;
  if (e >= 0) {
    v = num_eval(s, e + 1);
  }
} return int v;
("1e3"):(3)
("1.5E-3"):(-3)
("15"):(0)
