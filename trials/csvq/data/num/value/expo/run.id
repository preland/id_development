num_run10(string s, int j) {
  int v = 0;
  while (chr_is_digit(character_code_at(s, j)) == 1) {
    v = v * 10 + character_code_at(s, j) - (import ch_zero);
    if (v > 1000) {
      v = 1000;
    }
    j = j + 1;
  }
} return int v;
("123", 0):(123)
("5x", 0):(5)
("99999", 0):(1000)
("x", 0):(0)

num_fd(string s) {
  int d = str_find(s, ".");
  int fd = 0;
  if (d >= 0) {
    fd = num_digits(s, d + 1) - d - 1;
  }
} return int fd;
("12.345"):(3)
("12"):(0)
("1.5e3"):(1)
(".5"):(1)
("5."):(0)

num_cmp(float fa, float fb) {
  int sg = (fa > fb) - (fa < fb);
} return int sg;
(1.5, 2.5):(-1)
(2.5, 2.5):(0)
(3.0, 2.5):(1)
(-1.0, -2.0):(1)
