num_pow10(int k) {
  float p = 1.0;
  int i = 0;
  while (i < k) {
    p = p * 10.0;
    i = i + 1;
  }
} return float p;
(0):(1.0)
(3):(1000.0)
(15):(1000000000000000.0)
(22):(10000000000000000000000.0)

num_shift(float fm, int c) {
  float fr = fm;
  if (c >= 0) {
    fr = fm * num_pow10(c);
  } else {
    fr = fm / num_pow10(0 - c);
  }
} return float fr;
(125.0, -1):(12.5)
(3.0, 2):(300.0)
(7.0, 0):(7.0)
(1.0, -3):(0.001)

num_scale(float fm, int k) {
  float fr = fm;
  while (k != 0) {
    fr = num_shift(fr, fixed_point_clamp(k, -22, 22));
    k = k - fixed_point_clamp(k, -22, 22);
  }
} return float fr;
(1.0, 30):(1000000000000000000000000000000.0)
(125.0, -1):(12.5)
(5.0, 0):(5.0)
(1000000000000000000000000000000.0, -30):(1.0)
