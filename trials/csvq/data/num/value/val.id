num_step(word[] mw, int c) {
  if (character_is_digit(c) == 1 && mw[0] < 100000000000000000) {
    mw[0] = mw[0] * 10 + (c - (import ch_zero));
  } else {
    if (character_is_digit(c) == 1) {
      mw[1] = mw[1] + 1;
    }
  }
} return void;
([0, 0], 55):([7, 0], 55)
([12, 0], 51):([123, 0], 51)
([5, 0], 46):([5, 0], 46)
([5, 0], -1):([5, 0], -1)
([100000000000000000, 0], 55):([100000000000000000, 1], 55)

num_mv(string s, word[] mw) {
  int i = 0;
  while (num_stop(character_code_at(s, i)) == 0) {
    num_step(mw, character_code_at(s, i));
    i = i + 1;
  }
} return void;
("12.5", [0, 0]):("12.5", [125, 0])
("-3e9", [0, 0]):("-3e9", [3, 0])
("007", [0, 0]):("007", [7, 0])
(".5", [0, 0]):(".5", [5, 0])
("123456789012345678901", [0, 0]):("123456789012345678901", [123456789012345678, 3])

num_val(string s) {
  word[] mw = [0, 0];
  num_mv(s, mw);
  int k = num_ex(s) - num_fd(s) + mw[1];
} chain (string s) {
  float fm = mw[0];
  float fv = num_scale(fm, k);
  if (character_code_at(s, 0) == (import ch_minus)) {
    fv = 0.0 - fv;
  }
} return float fv;
