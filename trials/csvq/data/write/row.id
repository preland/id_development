wr_field(string f, int d, int one) {
  string g = f;
  if (wr_needs(f, d) == 1 || (one == 1 && f == "")) {
    g = wr_quote(f);
  }
} return string g;
("plain", 44, 0):("plain")
("a,b", 44, 0):("\"a,b\"")
("", 44, 0):("")
("", 44, 1):("\"\"")
("a;b", 59, 0):("\"a;b\"")

wr_fields(string[] row, int d, string[] parts) {
  int i = 0;
  int one = len(row) == 1;
  while (i < len(row)) {
    push(parts, wr_field(row[i], d, one));
    i = i + 1;
  }
} return void;
(["a", "b,c"], 44, []):(["a", "b,c"], 44, ["a", "\"b,c\""])
([""], 44, ["x"]):([""], 44, ["x", "\"\""])
(["", ""], 44, []):(["", ""], 44, ["", ""])

wr_row(string[] row, int d) {
  string[] parts = [];
  wr_fields(row, d, parts);
  string line = string_join(parts, chr(d));
} return string line;
(["a", "b,c", "d"], 44):("a,\"b,c\",d")
(["x", "y"], 59):("x;y")
([""], 44):("\"\"")
(["", ""], 44):(",")
