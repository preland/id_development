csv_write_print(string[] row, int delimiter) {
  string line = csv_write_row(row, delimiter);
  print(line);
} return void;
(["a", "b"], 44):(["a", "b"], 44) then prints:("a,b\n")
(["x y", "q\"r"], 44):(["x y", "q\"r"], 44) then prints:("x y,\"q\"\"r\"\n")

csv_write_rows(string[][] rows, int delimiter) {
  int index = 0;
  while (index < len(rows)) {
    csv_write_print(rows[index], delimiter);
    index = index + 1;
  }
} return void;
([["a", "b"], ["c,d", "e"]], 44):([["a", "b"], ["c,d", "e"]], 44) then prints:("a,b\n\"c,d\",e\n")
([], 44):([], 44) then prints:("")
