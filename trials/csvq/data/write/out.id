wr_print(string[] row, int d) {
  string line = wr_row(row, d);
  print(line);
} return void;
(["a", "b"], 44):(["a", "b"], 44) then prints:("a,b\n")
(["x y", "q\"r"], 44):(["x y", "q\"r"], 44) then prints:("x y,\"q\"\"r\"\n")

wr_rows(string[][] rows, int d) {
  int i = 0;
  while (i < len(rows)) {
    wr_print(rows[i], d);
    i = i + 1;
  }
} return void;
([["a", "b"], ["c,d", "e"]], 44):([["a", "b"], ["c,d", "e"]], 44) then prints:("a,b\n\"c,d\",e\n")
([], 44):([], 44) then prints:("")
