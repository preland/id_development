wr_special(int c, int d) {
  int hit = c == d || c == (import ch_quote) || c == (import ch_nl) || c == (import ch_cr);
} return int hit;
(44, 44):(1)
(34, 44):(1)
(10, 44):(1)
(13, 44):(1)
(97, 44):(0)
(44, 59):(0)
(59, 59):(1)

wr_needs(string f, int d) {
  int i = 0;
  int hit = 0;
  while (charat(f, i) >= 0 && hit == 0) {
    hit = wr_special(charat(f, i), d);
    i = i + 1;
  }
} return int hit;
("plain", 44):(0)
("a,b", 44):(1)
("say \"hi\"", 44):(1)
("two\nlines", 44):(1)
("a;b", 44):(0)
("", 44):(0)

wr_quote(string f) {
  string[] parts = str_split(f, "\"");
  string body = str_join(parts, "\"\"");
  string q = "\"" + body + "\"";
} return string q;
("a,b"):("\"a,b\"")
("say \"hi\""):("\"say \"\"hi\"\"\"")
(""):("\"\"")
("\""):("\"\"\"\"")
