csv_write_special(int character_code, int delimiter) {
  int hit = character_code == delimiter || character_code == (import ch_quote) || character_code == (import ch_nl) || character_code == (import ch_cr);
} return int hit;
(44, 44):(1)
(34, 44):(1)
(10, 44):(1)
(13, 44):(1)
(97, 44):(0)
(44, 59):(0)
(59, 59):(1)

csv_write_needs_quote(string field_text, int delimiter) {
  int index = 0;
  int hit = 0;
  while (character_code_at(field_text, index) >= 0 && hit == 0) {
    hit = csv_write_special(character_code_at(field_text, index), delimiter);
    index = index + 1;
  }
} return int hit;
("plain", 44):(0)
("a,b", 44):(1)
("say \"hi\"", 44):(1)
("two\nlines", 44):(1)
("a;b", 44):(0)
("", 44):(0)

csv_write_quote(string field_text) {
  string[] parts = string_split(field_text, "\"");
  string body = string_join(parts, "\"\"");
  string quoted = "\"" + body + "\"";
} return string quoted;
("a,b"):("\"a,b\"")
("say \"hi\""):("\"say \"\"hi\"\"\"")
(""):("\"\"")
("\""):("\"\"\"\"")
