// Reads from an open handle into the store until n bytes are in or the file gives no more; how many arrived.
read_fill(int file_handle, word address, int bytes_wanted) {
  int byte_position = 0;
  int step = 1;
  while(byte_position < bytes_wanted && step > 0) {
    step = fs_read_mem(file_handle, address + byte_position, bytes_wanted - byte_position);
    if(step > 0) {
      byte_position = byte_position + step;
    }
  }
} return int byte_position;
