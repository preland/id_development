// Reads the first size bytes of the file at path into the store at ad. The count read, or -1 if the file will not open.
log_read(string path, word address, int size) {
  int file_handle = fs_open(path, "r");
  int have = 0 - 1;
  if(file_handle >= 0) {
    have = read_fill(file_handle, address, size);
    int shut = fs_close(file_handle);
  }
} return int have;
