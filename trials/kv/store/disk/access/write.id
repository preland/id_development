// Closes a handle that has been written to; a failure to flush turns the count into -1.
log_shut(int file_handle, int sent) {
  int shut = fs_close(file_handle);
  int kept = sent;
  if(shut < 0) {
    kept = 0 - 1;
  }
} return int kept;
