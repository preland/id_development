// Opens path in the given mode ("w" truncates, "a" appends), writes n bytes from ad, closes. n on success, -1 on any failure.
log_write(string path, string mode, word address, int length_to_write) {
  int file_handle = fs_open(path, mode);
  int sent = 0 - 1;
  if(file_handle >= 0) {
    sent = write_all(file_handle, address, length_to_write);
    sent = log_shut(file_handle, sent);
  }
} chain (string path, string mode, word address, int length_to_write) {
  if(sent != length_to_write) {
    sent = 0 - 1;
  }
} return int sent;
