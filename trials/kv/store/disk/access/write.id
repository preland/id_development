// Writes n bytes at ad to an open handle, retrying short writes; how many went out.
write_all(int file_handle, word address, int bytes_to_write) {
  int byte_position = 0;
  int step = 1;
  while(byte_position < bytes_to_write && step > 0) {
    step = fs_write_mem(file_handle, address + byte_position, bytes_to_write - byte_position);
    if(step > 0) {
      byte_position = byte_position + step;
    }
  }
} return int byte_position;
