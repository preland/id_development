// Reads from an open handle into the store until n bytes are in or the file gives no more; how many arrived.
read_fill(int h, word ad, int n) {
  int pos = 0;
  int step = 1;
  while(pos < n && step > 0) {
    step = fs_read_mem(h, ad + pos, n - pos);
    if(step > 0) {
      pos = pos + step;
    }
  }
} return int pos;
