// Reads the first size bytes of the file at path into the store at ad. The count read, or -1 if the file will not open.
log_read(string path, word ad, int size) {
  int h = fs_open(path, "r");
  int have = 0 - 1;
  if(h >= 0) {
    have = read_fill(h, ad, size);
    int shut = fs_close(h);
  }
} return int have;
