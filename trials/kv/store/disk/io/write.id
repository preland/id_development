// Writes n bytes at ad to an open handle, retrying short writes; how many went out.
write_all(int h, word ad, int n) {
  int pos = 0;
  int step = 1;
  while(pos < n && step > 0) {
    step = fs_write_mem(h, ad + pos, n - pos);
    if(step > 0) {
      pos = pos + step;
    }
  }
} return int pos;
