// Opens path in the given mode ("w" truncates, "a" appends), writes n bytes from ad, closes. n on success, -1 on any failure.
log_write(string path, string mode, word ad, int n) {
  int h = fs_open(path, mode);
  int sent = 0 - 1;
  if(h >= 0) {
    sent = write_all(h, ad, n);
    sent = log_shut(h, sent);
  }
} chain (string path, string mode, word ad, int n) {
  if(sent != n) {
    sent = 0 - 1;
  }
} return int sent;
