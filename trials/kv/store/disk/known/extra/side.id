// The files the log code leaves beside a log: what it saved of a bad tail, and the scratch names for a repair and a compaction.
// Removes all three, and answers how many were there.
file_t_clean(string path) {
  int zbad = fs_remove(path + ".bad");
  int zfix = fs_remove(path + ".repair");
  int zcmp = fs_remove(path + ".compact");
} chain (string path) {
  int present = 3 + zbad + zfix + zcmp;
} return int present;
given file_t_extra ((import file_t_path)):(2) then file_t_done:(0)
given file_t_empty ((import file_t_path)):(0) then file_t_done:(0)

// A scratch file with a .bad and a .compact beside it.
file_t_extra() {
  file_t_empty();
  int a = fs_open((import file_t_path) + ".bad", "w");
  int b = fs_open((import file_t_path) + ".compact", "w");
} chain () {
  int c = fs_close(a);
  int d = fs_close(b);
} return void;
():() then file_t_size:("size 0") then file_t_bad:(0) then file_t_done:(0)
():() then file_t_size:("size 0") then file_t_done:(0)

// The size of the .bad file beside the scratch file, or -1.
file_t_bad() {
  int size = fs_size((import file_t_path) + ".bad");
} return int size;
given file_t_extra ():(0) then file_t_done:(0)
given file_t_empty ():(-1) then file_t_done:(0)
