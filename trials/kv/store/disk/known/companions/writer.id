// Opens the empty scratch file for writing and keeps the handle; the memory block is all ones.
scratch_open_for_write() {
  scratch_empty();
  buffer_fill((import memory_block_address), 64, 1);
  export int scratch_writer_handle = fs_open((import scratch_path), "w");
} return void;
