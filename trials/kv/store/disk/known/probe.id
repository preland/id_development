// The scratch file's size in bytes.
scratch_size_text() {
  string size_label = "size " + (fs_size((import scratch_path)));
} return string size_label;
given scratch_empty ():("size 0") then scratch_remove:(0)
given scratch_ten_bytes ():("size 10") then scratch_remove:(0)

// The sum of the scratch file's bytes, read with the fs natives directly.
scratch_byte_total() {
  word address = alloc(256);
  int file_handle = fs_open((import scratch_path), "r");
  int grabbed = fs_read_mem(file_handle, address, 256);
} chain () {
  int shut = fs_close(file_handle);
  int sum = memory_byte_sum(address, grabbed);
} return int sum;
given scratch_empty ():(0) then scratch_remove:(0)
given scratch_ten_bytes ():(525) then scratch_remove:(0)

// Removes the scratch file and whatever the log code left beside it; 0 when the scratch file is gone.
scratch_remove() {
  int gone = fs_remove((import scratch_path));
  int aside = scratch_remove_leftovers((import scratch_path));
  int left = fs_exists((import scratch_path));
} return int left;
given scratch_empty ():(0)
given scratch_ten_bytes ():(0)
given scratch_with_leftovers ():(0)
