// Fixtures: a whole log in the flat store -- the magic, a put of "ab", a put of "cd", a delete of "ab" -- 57 bytes, built with rec_make.
// The lists are the empty store from db_t_lists.
log_image_build() {
  store_empty_lists();
  export word log_image_address = alloc(128);
  export word log_value_source = alloc(8);
} chain () {
  string_copy_to_memory("xyz", 0, 3, log_value_source);
  string_copy_to_memory((import log_magic), 0, (import log_hdr), log_image_address);
  record_make(log_image_address + 8, 1, "ab", log_value_source, 3);
} chain () {
  record_make(log_image_address + 26, 1, "cd", log_value_source, 1);
  record_make(log_image_address + 42, 2, "ab", log_value_source, 0);
} return void;
():() then log_image_byte_sum:(2951)
():() then store_state_text:("0/0/0")

// The same image with one value byte of the second record changed, so its checksum is wrong.
log_image_bad_checksum() {
  log_image_build();
  poke8((import log_image_address) + 41, 121);
} return void;
():() then log_image_byte_sum:(2952)
():() then store_state_text:("0/0/0")

// The same image with its first byte changed, so it no longer starts with the magic.
log_image_bad_magic() {
  log_image_build();
  poke8((import log_image_address), 88);
} return void;
():() then log_image_byte_sum:(2966)
():() then store_state_text:("0/0/0")
