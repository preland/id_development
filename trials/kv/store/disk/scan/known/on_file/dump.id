// Writes the first n bytes of the image over the scratch file.
log_image_dump(int image_length) {
  int file_handle = fs_open((import scratch_path), "w");
  int wrote = fs_write_mem(file_handle, (import log_image_address), image_length);
  int shut = fs_close(file_handle);
} return void;
