// Fixtures: the image written to a scratch file, whole, with its last five bytes cut off, and cut to its first three.
// Written with the fs natives directly, so the code that reads logs is not what builds its own input.
log_image_on_file() {
  log_image_build();
  scratch_empty();
} return void;
