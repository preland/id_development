// The 52 byte torn file with a .bad already beside it holding three bytes, so a second repair has something to append to.
log_torn_with_bad() {
  log_counters_claim(42, 52);
  int file_handle = fs_open((import scratch_path) + ".bad", "w");
  int wrote = fs_write(file_handle, [1, 2, 3], 3);
} chain () {
  int shut = fs_close(file_handle);
} return void;
():() then scratch_leftover_size(".bad"):(3) then scratch_remove:(0)
():() then scratch_size_text:("size 52") then store_file_counters_text:("42/52/0") then scratch_remove:(0)

// A log holding only its header: the file has 8 bytes and the counters know it.
log_header_only() {
  log_image_on_file();
  log_begin((import scratch_path), (import store_counters));
} return void;
():() then store_file_counters_text:("8/8/0") then scratch_size_text:("size 8") then scratch_remove:(0)
():() then scratch_byte_total:(577) then scratch_remove:(0)
