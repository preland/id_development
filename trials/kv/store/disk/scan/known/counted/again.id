// Loads the scratch file into a store of its own, and says what it found as "live/dead/recs/status".
log_t_again() {
  string[] keys = [];
  int[] vals = [];
  int[] used = [];
} chain () {
  int[] st = [];
  word[] ea = [];
  db_new(keys, vals, used, st);
} chain () {
  int code = db_load((import file_t_path), keys, vals, used, st, ea);
  string state = st[(import st_live)] + "/" + st[(import st_dead)] + "/" + st[(import st_recs)] + "/" + code;
} return string state;
given log_t_file ():("1/33/3/0") then file_t_done:(0)
given log_t_torn ():("2/0/2/1") then file_t_done:(0)
