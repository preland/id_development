// Replays an image held in the store: 0 or 1 as load_scan says, or 2 if it does not start with the magic and so is not a kv log at all.
load_image(string[] keys, int[] vals, int[] used, int[] st, word[] ea, word ad, int size) {
  int head = head_ok(ad, size);
  int code = 2;
  if(head >= 0) {
    code = load_scan(keys, vals, used, st, ea, ad, size, head);
  }
} return int code;
