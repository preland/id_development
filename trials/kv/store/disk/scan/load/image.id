// Replays an image held in the store: 0 or 1 as load_scan says, or 2 if it does not start with the magic and so is not a kv log at all.
load_image(string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, word address, int size) {
  int head = head_ok(address, size);
  int code = 2;
  if(head >= 0) {
    code = load_scan(keys, entry_numbers, used, counters, entry_records, address, size, head);
  }
} return int code;
