// Replays a log image, and records how much of it was sound in the counters: st_size the sound bytes, st_file the bytes there were, st_why what stopped the replay. 0 if all of it was sound, 1 if a damaged tail was left out.
// head is head_ok's answer for the image: 0 to scan it, 1 for a start too short to hold records.
load_scan(string[] keys, int[] vals, int[] used, int[] st, word[] ea, word ad, int size, int head) {
  int good = 0;
  if(head == 0) {
    good = scan_all(keys, vals, used, st, ea, ad, size);
  }
  int cause = 0;
} chain (string[] keys, int[] vals, int[] used, int[] st, word[] ea, word ad, int size, int head) {
  if(good < size) {
    cause = rec_check(ad + good, size - good);
  }
  st[(import st_size)] = good;
  st[(import st_file)] = size;
} chain (string[] keys, int[] vals, int[] used, int[] st, word[] ea, word ad, int size, int head) {
  st[(import st_why)] = cause;
  int code = good < size;
} return int code;
