// Reads size bytes of the file at path and replays them. 3 if the file could not be read whole, otherwise load_image's answer.
load_file(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, int size) {
  word ad = alloc(size);
  int have = log_read(path, ad, size);
  int code = 3;
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, int size) {
  if(have == size) {
    code = load_image(keys, vals, used, st, ea, ad, size);
  }
} return int code;
