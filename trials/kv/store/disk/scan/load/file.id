(57, 1):(1)

// Opens the store's log: replays the file at path into the lists. An absent or empty file is an empty store, and is left alone. 0 clean, 1 a damaged tail was left out, 2 not a kv log, 3 the file could not be read.
database_load(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records) {
  int size = fs_size(path);
  int verdict = size_state(size, fs_exists(path));
  int code = verdict;
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records) {
  if(verdict == 1) {
    code = load_file(path, keys, entry_numbers, used, counters, entry_records, size);
  }
} return int code;
