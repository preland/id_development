// Reads size bytes of the file at path and replays them. 3 if the file could not be read whole, otherwise load_image's answer.
load_file(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, int size) {
  word address = alloc(size);
  int have = log_read(path, address, size);
  int code = 3;
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, int size) {
  if(have == size) {
    code = load_image(keys, entry_numbers, used, counters, entry_records, address, size);
  }
} return int code;
