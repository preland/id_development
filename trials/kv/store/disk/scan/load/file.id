// What fs_size and fs_exists together say about a log file: 0 nothing to load (absent, or empty), 1 something to load, 3 there but of a size that cannot be known -- fs_size gives -1 for a file over two gibibytes, and treating that as absent would let the next put truncate it.
size_state(int size, int exists) {
  int verdict = 0;
  if(size > 0) {
    verdict = 1;
  } else if(size < 0 && exists == 1) {
    verdict = 3;
  }
} return int verdict;
(0, 1):(0)
(-1, 0):(0)
(-1, 1):(3)
(57, 1):(1)

// Opens the store's log: replays the file at path into the lists. An absent or empty file is an empty store, and is left alone. 0 clean, 1 a damaged tail was left out, 2 not a kv log, 3 the file could not be read.
db_load(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea) {
  int size = fs_size(path);
  int verdict = size_state(size, fs_exists(path));
  int code = verdict;
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea) {
  if(verdict == 1) {
    code = load_file(path, keys, vals, used, st, ea, size);
  }
} return int code;
