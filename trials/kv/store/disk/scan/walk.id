// Checks the record at pos in an image of size bytes and, if it is sound, replays it. Its size, or the negative code rec_check gave.
scan_step(string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, word address, int byte_position, int size) {
  int step_result = record_check(address + byte_position, size - byte_position);
  if(step_result > 0) {
    apply_record(keys, entry_numbers, used, counters, entry_records, address + byte_position);
  }
} return int step_result;
