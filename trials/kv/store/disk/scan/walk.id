// Replays every sound record of the image, in order, up to the first one that is not. Where the sound part ends.
scan_all(string[] keys, int[] vals, int[] used, int[] st, word[] ea, word ad, int size) {
  int pos = (import log_hdr);
  int n = 1;
  while(pos < size && n > 0) {
    n = scan_step(keys, vals, used, st, ea, ad, pos, size);
    if(n > 0) {
      pos = pos + n;
    }
  }
} return int pos;
