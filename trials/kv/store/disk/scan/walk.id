// Checks the record at pos in an image of size bytes and, if it is sound, replays it. Its size, or the negative code rec_check gave.
scan_step(string[] keys, int[] vals, int[] used, int[] st, word[] ea, word ad, int pos, int size) {
  int n = rec_check(ad + pos, size - pos);
  if(n > 0) {
    apply_rec(keys, vals, used, st, ea, ad + pos);
  }
} return int n;
