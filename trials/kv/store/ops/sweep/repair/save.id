// Writes the sound bytes to tmp, or a bare header if there are none.
repair_fresh(string tmp, word ad, int good) {
  int made = 0 - 1;
  if(good > 0) {
    made = log_write(tmp, "w", ad, good);
  } else {
    made = log_start(tmp);
  }
} return int made;
