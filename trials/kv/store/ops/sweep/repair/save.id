// Builds the repaired log beside the original as path.repair -- the sound bytes, or a bare header if there were none -- and renames it into place. The new size, or -1 with the original untouched.
repair_write(string path, word ad, int good) {
  string tmp = path + ".repair";
  int made = repair_fresh(tmp, ad, good);
  int size = swap_in(tmp, path, made);
} return int size;
