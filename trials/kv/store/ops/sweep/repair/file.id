// Drops a damaged tail: saves it, rewrites the sound part, and resets the counters to match. The new size, or -1 with the file untouched.
// good is the sound length the counters hold, held to what the file has left in case something else shrank it.
repair_swap(string path, word ad, int[] st, int total) {
  int good = fx_min(st[(import st_size)], total);
  int saved = repair_save(path, ad, good, total);
  int size = 0 - 1;
} chain (string path, word ad, int[] st, int total) {
  if(saved >= 0) {
    size = repair_write(path, ad, good);
  }
  if(size >= 0) {
    st_settle(st, size);
  }
  if(saved > 0 && size >= 0) {
    eprint(repair_msg(path));
  }
} return int size;
