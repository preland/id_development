// Reads the whole file, then repairs it from what was read.
repair_file(string path, int[] st, int total) {
  word ad = alloc(total);
  int have = log_read(path, ad, total);
  int code = 0 - 1;
} chain (string path, int[] st, int total) {
  if(have == total) {
    code = repair_swap(path, ad, st, total);
  }
} return int code;
