// Writes one whole record to an open handle. Its length, or -1 if it did not all go out.
emit_rec(int h, word rec) {
  int n = rec_len(rec);
  int sent = write_all(h, rec, n);
  if(sent != n) {
    sent = 0 - 1;
  }
} return int sent;
