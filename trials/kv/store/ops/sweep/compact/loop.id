// A whole compacted log on an open handle: the magic, the live records, then the close. The bytes written, or -1.
compact_write(int h, string[] keys, int[] vals, int[] used, word[] ea) {
  int head = write_head(h);
  int body = compact_loop(h, keys, vals, used, ea);
  int total = log_shut(h, tally(head, body));
} return int total;
