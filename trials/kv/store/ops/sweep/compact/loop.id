// Writes every live record, in the order they were first written, to an open handle. The total bytes, or -1.
compact_loop(int h, string[] keys, int[] vals, int[] used, word[] ea) {
  int total = 0;
  int e = 0;
  while(e < len(ea) && total >= 0) {
    int sent = compact_one(h, keys, vals, used, ea, e);
    total = tally(total, sent);
    e = e + 1;
  }
} return int total;
