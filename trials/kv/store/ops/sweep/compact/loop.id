// The record of entry e if it is live, otherwise nothing: the bytes written, 0 for a garbage entry, -1 on a failed write.
compact_one(int h, string[] keys, int[] vals, int[] used, word[] ea, int e) {
  int live = live_at(keys, vals, used, ea, e);
  int sent = 0;
  if(live == 1) {
    sent = emit_rec(h, ea[e]);
  }
} return int sent;
