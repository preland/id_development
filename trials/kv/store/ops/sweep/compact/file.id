// Counts a compaction: the log is exactly the live records, so nothing is garbage and every record is a live key.
compact_count(int[] st, int total) {
  st_settle(st, total);
  st[(import st_dead)] = 0;
  st[(import st_recs)] = st[(import st_live)];
} return void;
