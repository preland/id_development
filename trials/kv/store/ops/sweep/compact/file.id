// Writes the compacted log to path.compact and renames it over path. The new size, or -1 with the log untouched.
compact_file(string path, string[] keys, int[] vals, int[] used, word[] ea) {
  string tmp = path + ".compact";
  int h = fs_open(tmp, "w");
  int total = 0 - 1;
} chain (string path, string[] keys, int[] vals, int[] used, word[] ea) {
  if(h >= 0) {
    total = compact_write(h, keys, vals, used, ea);
  }
  total = swap_in(tmp, path, total);
} return int total;
