// Rewrites the log so it holds only what is live. The new size, or -1 if the log could not be made ready or rewritten; the counters follow.
db_compact(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea) {
  int ready = db_ready(path, st);
  int total = 0 - 1;
  if(ready >= 0) {
    total = compact_file(path, keys, vals, used, ea);
  }
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea) {
  if(total >= 0) {
    compact_count(st, total);
  }
} return int total;
