// Adds the key in table slot i to picked if the slot holds a live key that starts with prefix. With these two keys, "ab" is in slot 2 and "cd" in slot 3.
pick_one(string[] keys, int[] vals, int[] used, string prefix, string[] picked, int i) {
  if(used[i] == 1 && vals[i] >= 0 && str_starts(keys[i], prefix) == 1) {
    push(picked, keys[i]);
  }
} return void;
