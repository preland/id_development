// Where the live record for key is in the flat store, or 0 if the key is absent or deleted.
db_rec(string[] keys, int[] vals, int[] used, word[] ea, string key) {
  int e = hash_map_get(keys, vals, used, key, (import no_entry));
  word rec = 0;
  if(e >= 0) {
    rec = ea[e];
  }
} return word rec;
