// Adds every live key that starts with prefix to picked, in table order.
keys_pick(string[] keys, int[] vals, int[] used, string prefix, string[] picked) {
  int i = 0;
  while(i < len(keys)) {
    pick_one(keys, vals, used, prefix, picked, i);
    i = i + 1;
  }
} return void;
