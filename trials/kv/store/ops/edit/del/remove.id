// Builds the record for a delete and appends it; the index is updated only if the whole record reached the log.
del_store(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  int n = rec_size(len(key), 0);
  word rec = alloc(n);
  rec_make(rec, (import rec_del), key, 0, 0);
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  int sent = log_append(path, st, rec, n);
  int code = 3;
  if(sent == n) {
    apply_del(keys, vals, used, st, ea, rec);
    code = 0;
  }
} return int code;
