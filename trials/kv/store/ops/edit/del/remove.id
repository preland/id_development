// Writes a delete of key to the log and, once it is there, to the index. 0 deleted, 1 there was no such key (nothing is written), 3 the log could not be written, 5 the log has no room for the record.
db_del(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  int old = hmap_get(keys, vals, used, key, (import no_entry));
  int code = 1;
  if(old >= 0) {
    code = put_fit(st, len(key), 0);
  }
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  if(old >= 0 && code == 0) {
    code = del_store(path, keys, vals, used, st, ea, key);
  }
} return int code;
