// Whether a record may be written for a key of klen bytes and a value of vlen: 0 if so, 1 for a key that is empty or over rec_max_key, 2 for a value that is negative or over rec_max_val.
put_check(int klen, int vlen) {
  int code = 0;
  if(klen < 1 || klen > (import rec_max_key)) {
    code = 1;
  } else if(vlen < 0 || vlen > (import rec_max_val)) {
    code = 2;
  }
} return int code;
(2, 3):(0)
(0, 3):(1)
(65536, 3):(1)
(65535, 0):(0)
(1, -1):(2)
(1, 1073741825):(2)
(1, 1073741824):(0)

// Whether a record for a key of klen bytes and a value of vlen still fits in a log that may not pass log_max bytes: 0 if so, 5 if not.
put_fit(int[] st, int klen, int vlen) {
  word held = st[(import st_size)];
  word after = held + rec_size(klen, vlen);
  int code = 0;
} chain (int[] st, int klen, int vlen) {
  if(after > (import log_max)) {
    code = 5;
  }
} return int code;
([0, 0, 0, 100, 0, 100, 0], 2, 3):(0)
([0, 0, 0, 2147483629, 0, 2147483629, 0], 2, 3):(0)
([0, 0, 0, 2147483630, 0, 2147483630, 0], 2, 3):(5)
