// Writes a put of key to the log and, once it is there, to the index. vlen bytes at src are the value. 0 done, 1 the key is not allowed, 2 the value is too large, 3 the log could not be written, 5 the log has no room for the record.
db_put(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key, word src, int vlen) {
  int code = put_check(len(key), vlen);
  if(code == 0) {
    code = put_fit(st, len(key), vlen);
  }
  if(code == 0) {
    code = put_store(path, keys, vals, used, st, ea, key, src, vlen);
  }
} return int code;
