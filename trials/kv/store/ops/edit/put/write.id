// Builds the record for a put and appends it; the index is updated only if the whole record reached the log.
put_store(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key, word src, int vlen) {
  int n = rec_size(len(key), vlen);
  word rec = alloc(n);
  rec_make(rec, (import rec_put), key, src, vlen);
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key, word src, int vlen) {
  int sent = log_append(path, st, rec, n);
  int code = 3;
  if(sent == n) {
    apply_put(keys, vals, used, st, ea, rec);
    code = 0;
  }
} return int code;
