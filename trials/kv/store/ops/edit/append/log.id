// Appends n bytes at rec to the log at path, first making the log fit for it. n bytes on success, -1 on failure; the counters follow the file.
log_append(string path, int[] st, word rec, int n) {
  int ready = db_ready(path, st);
  int sent = 0 - 1;
  if(ready >= 0) {
    sent = log_write(path, "a", rec, n);
    st_wrote(st, sent, n);
  }
} return int sent;
