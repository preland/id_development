// Makes the log fit for an append: a damaged tail is repaired away, a missing or empty file gets its header. 0 or more if it is ready, -1 if it could not be made so.
database_ready(string path, int[] counters) {
  int code = 0;
  if(counters_dirty(counters) == 1) {
    code = log_repair(path, counters);
  } else {
    code = ready_head(path, counters);
  }
} return int code;
