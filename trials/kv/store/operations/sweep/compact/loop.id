// A whole compacted log on an open handle: the magic, the live records, then the close. The bytes written, or -1.
compact_write(int file_handle, string[] keys, int[] entry_numbers, int[] used, word[] entry_records) {
  int head = write_head(file_handle);
  int body = compact_loop(file_handle, keys, entry_numbers, used, entry_records);
  int total = log_shut(file_handle, tally(head, body));
} return int total;
