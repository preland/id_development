// The record of entry e if it is live, otherwise nothing: the bytes written, 0 for a garbage entry, -1 on a failed write.
compact_one(int file_handle, string[] keys, int[] entry_numbers, int[] used, word[] entry_records, int entry_index) {
  int live = live_at(keys, entry_numbers, used, entry_records, entry_index);
  int sent = 0;
  if(live == 1) {
    sent = emit_record(file_handle, entry_records[entry_index]);
  }
} return int sent;
