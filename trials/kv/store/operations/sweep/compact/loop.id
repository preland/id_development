// Writes every live record, in the order they were first written, to an open handle. The total bytes, or -1.
compact_loop(int file_handle, string[] keys, int[] entry_numbers, int[] used, word[] entry_records) {
  int total = 0;
  int entry_index = 0;
  while(entry_index < len(entry_records) && total >= 0) {
    int sent = compact_one(file_handle, keys, entry_numbers, used, entry_records, entry_index);
    total = tally(total, sent);
    entry_index = entry_index + 1;
  }
} return int total;
