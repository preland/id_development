// Writes one whole record to an open handle. Its length, or -1 if it did not all go out.
emit_record(int file_handle, word record) {
  int emitted_length = record_length(record);
  int sent = write_all(file_handle, record, emitted_length);
  if(sent != emitted_length) {
    sent = 0 - 1;
  }
} return int sent;
