// Counts a compaction: the log is exactly the live records, so nothing is garbage and every record is a live key.
compact_count(int[] counters, int total) {
  counters_settle(counters, total);
  counters[(import st_dead)] = 0;
  counters[(import st_recs)] = counters[(import st_live)];
} return void;
