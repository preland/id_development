// Rewrites the log so it holds only what is live. The new size, or -1 if the log could not be made ready or rewritten; the counters follow.
database_compact(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records) {
  int ready = database_ready(path, counters);
  int total = 0 - 1;
  if(ready >= 0) {
    total = compact_file(path, keys, entry_numbers, used, entry_records);
  }
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records) {
  if(total >= 0) {
    compact_count(counters, total);
  }
} return int total;
