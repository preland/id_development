// Writes the compacted log to path.compact and renames it over path. The new size, or -1 with the log untouched.
compact_file(string path, string[] keys, int[] entry_numbers, int[] used, word[] entry_records) {
  string temporary_path = path + ".compact";
  int file_handle = fs_open(temporary_path, "w");
  int total = 0 - 1;
} chain (string path, string[] keys, int[] entry_numbers, int[] used, word[] entry_records) {
  if(file_handle >= 0) {
    total = compact_write(file_handle, keys, entry_numbers, used, entry_records);
  }
  total = swap_in(temporary_path, path, total);
} return int total;
