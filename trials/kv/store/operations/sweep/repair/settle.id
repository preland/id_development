// Renames the scratch file tmp over path if the size it was built to is a real one, and always removes tmp. size itself, or -1 if the rename failed or size was already -1.
swap_in(string temporary_path, string path, int size) {
  int moved = 0 - 1;
  if(size >= 0) {
    moved = fs_rename(temporary_path, path);
  }
  int gone = fs_remove(temporary_path);
} chain (string temporary_path, string path, int size) {
  if(moved != 0) {
    size = 0 - 1;
  }
} return int size;
