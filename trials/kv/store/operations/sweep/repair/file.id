// Repairs the log at path: everything after the sound bytes the counters hold is set aside in path.bad and dropped. The new size, or -1.
log_repair(string path, int[] counters) {
  int total = fs_size(path);
  int code = 0 - 1;
  if(total >= 0) {
    code = repair_file(path, counters, total);
  }
} return int code;
