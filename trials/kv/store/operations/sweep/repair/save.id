// Keeps the bytes of a damaged tail, good..total of the image at ad, by appending them to path.bad -- unless nothing was ever sound (good is 0), when they were only the start of a header. The bytes kept, 0 if none were, or -1.
repair_save(string path, word address, int good, int total) {
  int saved = 0;
  if(good > 0) {
    saved = log_write(path + ".bad", "a", address + good, total - good);
  }
} return int saved;
