// Writes the sound bytes to tmp, or a bare header if there are none.
repair_fresh(string temporary_path, word address, int good) {
  int made = 0 - 1;
  if(good > 0) {
    made = log_write(temporary_path, "w", address, good);
  } else {
    made = log_start(temporary_path);
  }
} return int made;
