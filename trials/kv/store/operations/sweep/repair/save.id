// Builds the repaired log beside the original as path.repair -- the sound bytes, or a bare header if there were none -- and renames it into place. The new size, or -1 with the original untouched.
repair_write(string path, word address, int good) {
  string temporary_path = path + ".repair";
  int made = repair_fresh(temporary_path, address, good);
  int size = swap_in(temporary_path, path, made);
} return int size;
