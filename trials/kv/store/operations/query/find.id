// Adds the key in table slot i to picked if the slot holds a live key that starts with prefix. With these two keys, "ab" is in slot 2 and "cd" in slot 3.
pick_one(string[] keys, int[] entry_numbers, int[] used, string prefix, string[] picked, int index) {
  if(used[index] == 1 && entry_numbers[index] >= 0 && string_starts_with(keys[index], prefix) == 1) {
    push(picked, keys[index]);
  }
} return void;
