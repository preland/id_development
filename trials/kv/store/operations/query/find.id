// Adds every live key that starts with prefix to picked, in table order.
keys_pick(string[] keys, int[] entry_numbers, int[] used, string prefix, string[] picked) {
  int index = 0;
  while(index < len(keys)) {
    pick_one(keys, entry_numbers, used, prefix, picked, index);
    index = index + 1;
  }
} return void;
