// Writes a put of key to the log and, once it is there, to the index. vlen bytes at src are the value. 0 done, 1 the key is not allowed, 2 the value is too large, 3 the log could not be written, 5 the log has no room for the record.
database_put(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key, word source, int value_length) {
  int code = put_check(len(key), value_length);
  if(code == 0) {
    code = put_fit(counters, len(key), value_length);
  }
  if(code == 0) {
    code = put_store(path, keys, entry_numbers, used, counters, entry_records, key, source, value_length);
  }
} return int code;
