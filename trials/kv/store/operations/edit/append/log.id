// Appends n bytes at rec to the log at path, first making the log fit for it. n bytes on success, -1 on failure; the counters follow the file.
log_append(string path, int[] counters, word record, int append_length) {
  int ready = database_ready(path, counters);
  int sent = 0 - 1;
  if(ready >= 0) {
    sent = log_write(path, "a", record, append_length);
    counters_wrote(counters, sent, append_length);
  }
} return int sent;
