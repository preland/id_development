// Counts an append: if all n bytes went out the sound part and the file both grew, if not the file is marked as holding something the counters do not know of, so the next append repairs it first.
counters_wrote(int[] counters, int sent, int expected_length) {
  if(sent == expected_length) {
    counters_add(counters, (import st_size), expected_length);
    counters_add(counters, (import st_file), expected_length);
  } else {
    counters_add(counters, (import st_file), 1);
  }
} return void;
