// Writes a delete of key to the log and, once it is there, to the index. 0 deleted, 1 there was no such key (nothing is written), 3 the log could not be written, 5 the log has no room for the record.
database_delete(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  int old = hash_map_get(keys, entry_numbers, used, key, (import no_entry));
  int code = 1;
  if(old >= 0) {
    code = put_fit(counters, len(key), 0);
  }
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  if(old >= 0 && code == 0) {
    code = delete_store(path, keys, entry_numbers, used, counters, entry_records, key);
  }
} return int code;
