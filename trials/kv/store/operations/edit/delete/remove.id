// Builds the record for a delete and appends it; the index is updated only if the whole record reached the log.
delete_store(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  int tombstone_size = record_size(len(key), 0);
  word record = alloc(tombstone_size);
  record_make(record, (import rec_del), key, 0, 0);
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  int sent = log_append(path, counters, record, tombstone_size);
  int code = 3;
  if(sent == tombstone_size) {
    apply_delete(keys, entry_numbers, used, counters, entry_records, record);
    code = 0;
  }
} return int code;
