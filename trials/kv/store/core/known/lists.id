// Fixtures for the store: an empty one in five exported lists, and the same with records built in the flat store.
db_t_lists() {
  export string[] db_t_keys = [];
  export int[] db_t_vals = [];
  export int[] db_t_used = [];
} chain () {
  export int[] db_t_st = [];
  export word[] db_t_ea = [];
  db_new(db_t_keys, db_t_vals, db_t_used, db_t_st);
} return void;
():() then db_t_state:("0/0/0")
():() then db_t_where:("-1,-1")

// Three records made with rec_make: a put of "ab" (18 bytes), a put of "cd" (16 bytes), and a delete of "ab" (15 bytes).
db_t_recs() {
  db_t_lists();
  export word db_t_a = alloc(128);
  export word db_t_b = (import db_t_a) + 32;
} chain () {
  export word db_t_t = (import db_t_a) + 64;
  export word db_t_src = (import db_t_a) + 96;
  str_blit("xyz", 0, 3, db_t_src);
} chain () {
  rec_make(db_t_a, 1, "ab", db_t_src, 3);
  rec_make(db_t_b, 1, "cd", db_t_src, 1);
  rec_make(db_t_t, 2, "ab", db_t_src, 0);
} return void;
():() then db_t_state:("0/0/0")
():() then db_t_where:("-1,-1")

// The two puts applied, in that order: "ab" is entry 0 and "cd" entry 1.
db_t_puts() {
  db_t_recs();
  apply_put((import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_st), (import db_t_ea), (import db_t_a));
  apply_put((import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_st), (import db_t_ea), (import db_t_b));
} return void;
():() then db_t_state:("2/0/2")
():() then db_t_where:("0,1")
