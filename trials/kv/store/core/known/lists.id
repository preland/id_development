// Fixtures for the store: an empty one in five exported lists, and the same with records built in the flat store.
store_empty_lists() {
  export string[] store_keys = [];
  export int[] store_entry_numbers = [];
  export int[] store_slot_flags = [];
} chain () {
  export int[] store_counters = [];
  export word[] store_entry_records = [];
  database_new(store_keys, store_entry_numbers, store_slot_flags, store_counters);
} return void;
():() then store_state_text:("0/0/0")
():() then store_entries_text:("-1,-1")

// Three records made with rec_make: a put of "ab" (18 bytes), a put of "cd" (16 bytes), and a delete of "ab" (15 bytes).
store_three_records() {
  store_empty_lists();
  export word store_first_put_record = alloc(128);
  export word store_second_put_record = (import store_first_put_record) + 32;
} chain () {
  export word store_first_delete_record = (import store_first_put_record) + 64;
  export word store_value_source = (import store_first_put_record) + 96;
  string_copy_to_memory("xyz", 0, 3, store_value_source);
} chain () {
  record_make(store_first_put_record, 1, "ab", store_value_source, 3);
  record_make(store_second_put_record, 1, "cd", store_value_source, 1);
  record_make(store_first_delete_record, 2, "ab", store_value_source, 0);
} return void;
():() then store_state_text:("0/0/0")
():() then store_entries_text:("-1,-1")

// The two puts applied, in that order: "ab" is entry 0 and "cd" entry 1.
store_two_puts() {
  store_three_records();
  apply_put((import store_keys), (import store_entry_numbers), (import store_slot_flags), (import store_counters), (import store_entry_records), (import store_first_put_record));
  apply_put((import store_keys), (import store_entry_numbers), (import store_slot_flags), (import store_counters), (import store_entry_records), (import store_second_put_record));
} return void;
():() then store_state_text:("2/0/2")
():() then store_entries_text:("0,1")
