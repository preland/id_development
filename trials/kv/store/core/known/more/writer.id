// Fixtures: the store with two puts applied (or three, the third overwriting the first), beside an empty scratch file open for writing.
db_t_writer() {
  db_t_puts();
  file_t_wopen();
} return void;
():() then db_t_state:("2/0/2") then file_t_wsize:(0) then file_t_done:(0)
():() then db_t_where:("0,1") then file_t_wsize:(0) then file_t_done:(0)

db_t_wover() {
  db_t_over();
  file_t_wopen();
} return void;
():() then db_t_state:("2/18/3") then file_t_wsize:(0) then file_t_done:(0)
():() then db_t_where:("2,1") then file_t_wsize:(0) then file_t_done:(0)

// The store with two puts and the scratch file open, but the record of "ab" rebuilt around the four bytes 0, 255, 10 and 0: a NUL, a byte that is not text, a newline, a NUL.
db_t_binw() {
  db_t_writer();
  mem_load((import db_t_src), [0, 255, 10, 0]);
  rec_make((import db_t_a), 1, "ab", (import db_t_src), 4);
} return void;
():() then db_t_state:("2/0/2") then file_t_wsize:(0) then file_t_done:(0)
():() then db_t_where:("0,1") then file_t_wsize:(0) then file_t_done:(0)
