// The empty store with the three file counters set to 9, 11 and -3.
db_t_marked() {
  db_t_lists();
  st_add((import db_t_st), (import st_size), 9);
  st_add((import db_t_st), (import st_file), 11);
} chain () {
  st_add((import db_t_st), (import st_why), 0 - 3);
} return void;
():() then db_t_meta:("9/11/-3")
():() then db_t_state:("0/0/0")

// The two puts, then a third put of the same key as the first: entries 0 and 2 are both "ab", and only 2 is live.
db_t_over() {
  db_t_puts();
  apply_put((import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_st), (import db_t_ea), (import db_t_a));
} return void;
():() then db_t_state:("2/18/3")
():() then db_t_where:("2,1")

// The two puts, then the delete of "ab": "ab" keeps its table slot but points at no entry.
db_t_gone() {
  db_t_puts();
  apply_del((import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_st), (import db_t_ea), (import db_t_t));
} return void;
():() then db_t_state:("1/33/3")
():() then db_t_where:("-1,1")
