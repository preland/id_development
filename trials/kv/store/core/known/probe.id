// The counters as "live/dead/recs".
db_t_state() {
  string state = (import db_t_st)[(import st_live)] + "/" + (import db_t_st)[(import st_dead)] + "/" + (import db_t_st)[(import st_recs)];
} return string state;
given db_t_lists ():("0/0/0")
given db_t_puts ():("2/0/2")

// The entry numbers "ab" and "cd" resolve to, as "ab,cd".
db_t_where() {
  int ab = hash_map_get((import db_t_keys), (import db_t_vals), (import db_t_used), "ab", (import no_entry));
  int cd = hash_map_get((import db_t_keys), (import db_t_vals), (import db_t_used), "cd", (import no_entry));
  string where = ab + "," + cd;
} return string where;
given db_t_lists ():("-1,-1")
given db_t_puts ():("0,1")

// The counters that describe the log file, as "size/file/why".
db_t_meta() {
  string meta = (import db_t_st)[(import st_size)] + "/" + (import db_t_st)[(import st_file)] + "/" + (import db_t_st)[(import st_why)];
} return string meta;
given db_t_lists ():("0/0/0")
given db_t_marked ():("9/11/-3")
