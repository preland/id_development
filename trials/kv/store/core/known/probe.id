// The counters as "live/dead/recs".
store_state_text() {
  string state = (import store_counters)[(import st_live)] + "/" + (import store_counters)[(import st_dead)] + "/" + (import store_counters)[(import st_recs)];
} return string state;
given store_empty_lists ():("0/0/0")
given store_two_puts ():("2/0/2")

// The entry numbers "ab" and "cd" resolve to, as "ab,cd".
store_entries_text() {
  int first_entry = hash_map_get((import store_keys), (import store_entry_numbers), (import store_slot_flags), "ab", (import no_entry));
  int second_entry = hash_map_get((import store_keys), (import store_entry_numbers), (import store_slot_flags), "cd", (import no_entry));
  string where = first_entry + "," + second_entry;
} return string where;
given store_empty_lists ():("-1,-1")
given store_two_puts ():("0,1")

// The counters that describe the log file, as "size/file/why".
store_file_counters_text() {
  string meta = (import store_counters)[(import st_size)] + "/" + (import store_counters)[(import st_file)] + "/" + (import store_counters)[(import st_why)];
} return string meta;
given store_empty_lists ():("0/0/0")
given store_marked_counters ():("9/11/-3")
