// Replays one record of either kind.
apply_rec(string[] keys, int[] vals, int[] used, int[] st, word[] ea, word rec) {
  int kind = rec_kind(rec);
  if(kind == (import rec_put)) {
    apply_put(keys, vals, used, st, ea, rec);
  } else {
    apply_del(keys, vals, used, st, ea, rec);
  }
} return void;
