// Counts a delete: the tombstone is garbage at once, and so is the record it kills, if there was one (entry old).
count_delete(int[] counters, word[] entry_records, int old, word record) {
  int gone = record_length(record);
  if(old >= 0) {
    word previous_record = entry_records[old];
    gone = gone + record_length(previous_record);
    counters_add(counters, (import st_live), 0 - 1);
  }
  counters_add(counters, (import st_dead), gone);
} return void;
