// Counts a put: the record it replaces (entry old, or none) becomes garbage, or a new key goes live.
count_put(int[] counters, word[] entry_records, int old) {
  if(old >= 0) {
    word previous_record = entry_records[old];
    int gone = record_length(previous_record);
    counters_add(counters, (import st_dead), gone);
  } else {
    counters_add(counters, (import st_live), 1);
  }
} return void;
given store_three_records ((import store_counters), (import store_entry_records), -1):() then store_state_text:("1/0/0")
given store_two_puts ((import store_counters), (import store_entry_records), 0):() then store_state_text:("2/18/2")

// Replays one put record into the store: the key now points at a new entry that holds the record's address.
apply_put(string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, word record) {
  string key = record_key(record);
  int old = hash_map_get(keys, entry_numbers, used, key, (import no_entry));
  count_put(counters, entry_records, old);
} chain (string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, word record) {
  hash_map_put(keys, entry_numbers, used, counters, key, len(entry_records));
  push(entry_records, record);
  counters_add(counters, (import st_recs), 1);
} return void;
