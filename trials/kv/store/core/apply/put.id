// Counts a put: the record it replaces (entry old, or none) becomes garbage, or a new key goes live.
stat_put(int[] st, word[] ea, int old) {
  if(old >= 0) {
    word prev = ea[old];
    int gone = rec_len(prev);
    st_add(st, (import st_dead), gone);
  } else {
    st_add(st, (import st_live), 1);
  }
} return void;
given db_t_recs ((import db_t_st), (import db_t_ea), -1):() then db_t_state:("1/0/0")
given db_t_puts ((import db_t_st), (import db_t_ea), 0):() then db_t_state:("2/18/2")

// Replays one put record into the store: the key now points at a new entry that holds the record's address.
apply_put(string[] keys, int[] vals, int[] used, int[] st, word[] ea, word rec) {
  string key = rec_key(rec);
  int old = hash_map_get(keys, vals, used, key, (import no_entry));
  stat_put(st, ea, old);
} chain (string[] keys, int[] vals, int[] used, int[] st, word[] ea, word rec) {
  hash_map_put(keys, vals, used, st, key, len(ea));
  push(ea, rec);
  st_add(st, (import st_recs), 1);
} return void;
