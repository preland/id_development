// Prints each string on a line of its own.
list_print(string[] strs) {
  int i = 0;
  while(i < len(strs)) {
    print(strs[i]);
    i = i + 1;
  }
} return void;
(["a", "b"]):(["a", "b"]) then prints:("a\nb\n")
([]):([]) then prints:("")

// kv DB list [PREFIX]: the live keys that start with PREFIX (all of them without one), one per line, in byte order.
cmd_list(string[] keys, int[] vals, int[] used, string[] argv) {
  string prefix = "";
  if(len(argv) == 4) {
    prefix = argv[3];
  }
  string[] picked = db_keys(keys, vals, used, prefix);
} chain (string[] keys, int[] vals, int[] used, string[] argv) {
  list_print(picked);
} return int 0;
