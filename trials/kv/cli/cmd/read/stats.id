// The counters of a store as lines of "name: number".
stats_text(int[] st) {
  string text = "keys: " + st[(import st_live)] + "\nrecords: " + st[(import st_recs)] + "\ngarbage-bytes: " + st[(import st_dead)] + "\nlog-bytes: " + st[(import st_size)] + "\nfile-bytes: " + st[(import st_file)];
} return string text;
([0, 2, 33, 57, 3, 57, 0]):("keys: 2\nrecords: 3\ngarbage-bytes: 33\nlog-bytes: 57\nfile-bytes: 57")
([0, 0, 0, 0, 0, 0, 0]):("keys: 0\nrecords: 0\ngarbage-bytes: 0\nlog-bytes: 0\nfile-bytes: 0")

// kv DB stats: prints the counters.
cmd_stats(int[] st) {
  print(stats_text(st));
} return int 0;
([0, 2, 33, 57, 3, 57, 0]):(0) then prints:("keys: 2\nrecords: 3\ngarbage-bytes: 33\nlog-bytes: 57\nfile-bytes: 57\n")
([0, 1, 0, 8, 1, 10, 0]):(0) then prints:("keys: 1\nrecords: 1\ngarbage-bytes: 0\nlog-bytes: 8\nfile-bytes: 10\n")
