given db_t_recs ("/dev/null", 0, "zz"):(1) then eprints:("kv: no such key: zz\n")

// kv DB get KEY: the value's bytes on outp, or a message and status 1 if there is no such key.
cmd_get(string outp, string[] keys, int[] vals, int[] used, word[] ea, string[] argv) {
  word rec = db_rec(keys, vals, used, ea, argv[3]);
  int code = get_out(outp, rec, argv[3]);
} return int code;
