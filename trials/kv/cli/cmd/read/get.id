// Writes the value of the record at rec, all of its bytes and nothing else, to the file outp. 0, or 3 (with a message) if the write failed.
emit_value(string outp, word rec) {
  int n = rec_vlen(rec);
  int sent = log_write(outp, "a", rec + rec_voff(rec), n);
  int code = 0;
} chain (string outp, word rec) {
  if(sent < 0) {
    eprint("kv: cannot write the value to " + outp);
    code = 3;
  }
} return int code;
