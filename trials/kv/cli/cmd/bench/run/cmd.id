// kv DB bench COUNT: puts COUNT keys of about a hundred bytes each, reopens the log, reads them all back and prints the timings. Status 2 if COUNT is not above zero.
cmd_bench(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  int n = to_int(argv[3]);
  int[] res = [0, 0, 0, 0, 0];
  int code = 2;
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  if(n > 0) {
    code = bench_go(path, keys, vals, used, st, ea, n, res);
  } else {
    eprint("kv: bench needs a count above zero");
  }
} return int code;
