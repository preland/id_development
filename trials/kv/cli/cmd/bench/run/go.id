// Times n puts, then reloads and reads them back, and prints the four lines of results. The exit status.
bench_go(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, int n, int[] res) {
  int t0 = ticks();
  int code = bench_put(path, keys, vals, used, st, ea, n);
  int t1 = ticks();
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, int n, int[] res) {
  res[0] = t1 - t0;
  if(code == 0) {
    bench_reload(path, n, res);
    print(bench_text(n, res));
  }
  if(code == 0) {
    code = bench_verdict(n, res);
  }
} return int code;
