// Opens the log at path again into fresh lists, timing that, then reads every entry 0 to n-1 back, timing that. Fills res: the reopen's and the gets' milliseconds at 1 and 2, how many values were right at 3, how many keys the reopened store has at 4.
bench_reload(string path, int n, int[] res) {
  string[] keys = [];
  int[] vals = [];
  int[] used = [];
} chain (string path, int n, int[] res) {
  int[] st = [];
  word[] ea = [];
  db_new(keys, vals, used, st);
} chain (string path, int n, int[] res) {
  int t0 = ticks();
  int status = db_load(path, keys, vals, used, st, ea);
  int t1 = ticks();
} chain (string path, int n, int[] res) {
  res[1] = t1 - t0;
  res[4] = st[(import st_live)];
  int ok = bench_get(keys, vals, used, ea, n);
} chain (string path, int n, int[] res) {
  int t2 = ticks();
  res[3] = ok;
  res[2] = t2 - t1;
} return void;
