// Fixture: a store on a scratch file with two entries, key-0 holding bench_val(0) and key-1 holding a different value. bench_t_a is where the record of key-0 is.
bench_t_pair() {
  bench_t_fresh();
  put_arg((import file_t_path), (import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_st), (import db_t_ea), "key-0", bench_val(0));
  put_arg((import file_t_path), (import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_st), (import db_t_ea), "key-1", "wrong");
} chain () {
  export word bench_t_a = db_rec((import db_t_keys), (import db_t_vals), (import db_t_used), (import db_t_ea), "key-0");
} return void;
():() then db_t_state:("2/0/2") then file_t_done:(0)
():() then file_t_size:("size 136") then file_t_done:(0)

