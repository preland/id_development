// Fixtures: a growing buffer as slurp keeps it, in a word list of address, capacity and length, beside an open handle on the ten byte scratch file. The 16 bytes behind the address are all 1.
// Room for 16 bytes, none used.
slurp_t_big() {
  file_t_open();
  word ad = alloc(16);
  buf_fill(ad, 16, 1);
} chain () {
  export word[] slurp_t_l = [ad, 16, 0];
} return void;
():() then slurp_t_check:("16/0/0") then file_t_done:(0)
():() then file_t_size:(10) then file_t_done:(0)
