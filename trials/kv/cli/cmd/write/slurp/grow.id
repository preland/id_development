// Reads once from the handle into the room the buffer has left, and grows the buffer if that filled it. The bytes read, 0 at the end of the file, -1 on an error.
slurp_step(int h, word[] sl) {
  int room = sl[1] - sl[2];
  int got = fs_read_mem(h, sl[0] + sl[2], room);
  if(got > 0) {
    sl[2] = sl[2] + got;
  }
} chain (int h, word[] sl) {
  if(sl[2] == sl[1]) {
    slurp_grow(sl);
  }
} return int got;
