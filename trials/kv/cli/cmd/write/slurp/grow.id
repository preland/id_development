// Doubles the buffer's capacity, keeping the bytes it already holds.
slurp_grow(word[] sl) {
  int have = sl[2];
  word cap = sl[1] * 2;
  word ad = alloc(cap);
} chain (word[] sl) {
  buffer_copy(ad, sl[0], have);
  sl[0] = ad;
  sl[1] = cap;
} return void;
