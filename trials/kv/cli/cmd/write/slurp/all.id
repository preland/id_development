// Reads the handle to its end into the buffer. It stops early, without reading further, once more than rec_max_val bytes are in: no record could hold them. The last read's answer: 0 at the end of the file, -1 on an error.
slurp_loop(int h, word[] sl) {
  int got = 1;
  while(got > 0 && sl[2] <= (import rec_max_val)) {
    got = slurp_step(h, sl);
  }
} return int got;
