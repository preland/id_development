// Reads the whole file at path (standard input is /dev/stdin) into the buffer. 0 or more once it has been read, -1 if it could not be opened or read.
slurp(string path, word[] sl) {
  int h = fs_open(path, "r");
  int got = 0 - 1;
  if(h >= 0) {
    got = slurp_loop(h, sl);
    int shut = fs_close(h);
  }
} return int got;
