// The message for a log that has no room for another record.
full_text(string path) {
  string msg = "kv: " + path + ": the log is full (over " + (import log_max) + " bytes); compact it or delete keys";
} return string msg;
("x.kv"):("kv: x.kv: the log is full (over 2147483647 bytes); compact it or delete keys")
(""):("kv: : the log is full (over 2147483647 bytes); compact it or delete keys")
