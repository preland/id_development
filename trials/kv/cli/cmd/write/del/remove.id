  int status = db_del(path, keys, vals, used, st, ea, argv[3]);
  string msg = del_text(path, argv[3], status);
  say_err(msg);
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  int code = (import del_exits)[status];
} return int code;
