// What to tell the user about how a delete of key ended: 0 done, 1 there was no such key, 3 could not write, 5 the log is full. "" for success.
del_text(string path, string key, int status) {
  string msg = "";
  if(status == 1) {
    msg = "kv: no such key: " + key;
  }
  if(status == 3) {
    msg = "kv: " + path + ": cannot write to the log";
  }
} chain (string path, string key, int status) {
  if(status == 5) {
    msg = full_text(path);
  }
} return string msg;
("x.kv", "k", 0):("")
("x.kv", "k", 1):("kv: no such key: k")
("x.kv", "k", 3):("kv: x.kv: cannot write to the log")
("x.kv", "k", 5):("kv: x.kv: the log is full (over 2147483647 bytes); compact it or delete keys")

