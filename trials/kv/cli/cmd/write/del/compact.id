// Prints how a compaction went, and answers its exit status: 0 with a line on standard output, or 3 with a message.
compact_report(string path, int before, int total) {
  int code = 3;
  if(total >= 0) {
    print("compacted " + before + " -> " + total + " bytes");
    code = 0;
  } else {
    eprint("kv: " + path + ": compaction failed; the log is unchanged");
  }
} return int code;
("x.kv", 52, 42):(0) then prints:("compacted 52 -> 42 bytes\n")
("x.kv", 52, -1):(3) then eprints:("kv: x.kv: compaction failed; the log is unchanged\n")

// Compacts the log, which had before bytes in the file, and reports.
compact_run(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, int before) {
  int total = db_compact(path, keys, vals, used, st, ea);
  int code = compact_report(path, before, total);
} return int code;
