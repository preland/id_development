// kv DB compact: rewrites the log so it holds only what is live. A message and status 1 if there is no log to compact.
cmd_compact(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea) {
  int before = st[(import st_file)];
  int code = 1;
  if(before > 0) {
    code = compact_run(path, keys, vals, used, st, ea, before);
  }
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea) {
  if(before == 0) {
    eprint("kv: " + path + ": no database to compact");
  }
} return int code;
