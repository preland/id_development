// Prints the message for how a put ended, and answers its exit status.
put_report(string path, int status) {
  string msg = put_text(path, status);
  say_err(msg);
  int code = put_exit(status);
} return int code;
("x.kv", 0):(0) then eprints:("")
("x.kv", 3):(3) then eprints:("kv: x.kv: cannot write to the log\n")
