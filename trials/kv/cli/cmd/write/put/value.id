// Stores the string val (its bytes, however many) under key.
put_arg(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key, string val) {
  int n = len(val);
  word ad = alloc(n + 1);
  str_blit(val, 0, n, ad);
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key, string val) {
  int status = db_put(path, keys, vals, used, st, ea, key, ad, n);
  int code = put_report(path, status);
} return int code;
