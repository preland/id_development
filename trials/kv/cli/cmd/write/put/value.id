// Stores everything that can be read from the file inp (standard input, for the command) under key.
put_stdin(string path, string inp, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  word ad = alloc((import slurp_chunk));
  word[] sl = [ad, (import slurp_chunk), 0];
  int got = slurp(inp, sl);
} chain (string path, string inp, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  int status = 4;
  int vlen = sl[2];
  if(got >= 0) {
    status = db_put(path, keys, vals, used, st, ea, key, sl[0], vlen);
  }
} chain (string path, string inp, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string key) {
  int code = put_report(path, status);
} return int code;
