// kv DB put KEY VALUE, or with - for VALUE, the value is all of standard input (inp).
cmd_put(string path, string inp, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  int code = 0;
  if(argv[4] == "-") {
    code = put_stdin(path, inp, keys, vals, used, st, ea, argv[3]);
  } else {
    code = put_arg(path, keys, vals, used, st, ea, argv[3], argv[4]);
  }
} return int code;
