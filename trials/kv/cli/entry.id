// Checks the command line and runs it; the exit status. A bad command line is reported with the usage on standard error and is status 2.
cli_run(int argc, string[] argv) {
  string bad = cli_check(argc, argv);
  int code = cli_go(bad, argv);
} return int code;
(1, ["kv"]):(2) then eprints:("kv: expected: kv DB COMMAND [ARGS]\nusage: kv DB put KEY VALUE | put KEY - | get KEY | del KEY | list [PREFIX] | compact | stats | bench COUNT\n")
(3, ["kv", "/nonexistent-kv-dir/none", "list"]):(0) then prints:("")
(5, ["kv", "/nonexistent-kv-dir/none", "list", "a", "b"]):(2) then eprints:("kv: wrong number of arguments for 'list'\nusage: kv DB put KEY VALUE | put KEY - | get KEY | del KEY | list [PREFIX] | compact | stats | bench COUNT\n")

// Runs the command line if bad is empty, otherwise reports bad. The exit status.
cli_go(string bad, string[] argv) {
  int code = 2;
  if(bad == "") {
    code = cli_db(argv[1], argv);
  } else {
    eprint("kv: " + bad + "\n" + (import usage_text));
  }
} return int code;
("", ["kv", "/nonexistent-kv-dir/none", "list"]):(0)
("", ["kv", ".", "list"]):(3) then eprints:("kv: .: cannot read the file\n")
("wrong", ["kv", "x", "list"]):(2) then eprints:("kv: wrong\nusage: kv DB put KEY VALUE | put KEY - | get KEY | del KEY | list [PREFIX] | compact | stats | bench COUNT\n")

main(int argc, string[] argv) {
  int code = cli_run(argc, argv);
} return int code;
