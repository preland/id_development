// Times n puts, then reloads and reads them back, and prints the four lines of results. The exit status.
bench_go(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, int benchmark_keys, int[] results) {
  int puts_started = ticks();
  int code = bench_put(path, keys, entry_numbers, used, counters, entry_records, benchmark_keys);
  int puts_ended = ticks();
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, int benchmark_keys, int[] results) {
  results[0] = puts_ended - puts_started;
  if(code == 0) {
    bench_reload(path, benchmark_keys, results);
    print(bench_text(benchmark_keys, results));
  }
  if(code == 0) {
    code = bench_verdict(benchmark_keys, results);
  }
} return int code;
