// Stores entries 0 to n-1, each with put_arg, stopping at the first that fails. Its exit status.
bench_put(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, int puts_wanted) {
  int code = 0;
  int index = 0;
  while(index < puts_wanted && code == 0) {
    code = put_argument(path, keys, entry_numbers, used, counters, entry_records, "key-" + index, bench_value(index));
    index = index + 1;
  }
} return int code;
