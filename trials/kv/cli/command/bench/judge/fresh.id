// Fixture: a scratch file and empty store, and a results list of five zeros as bench_reload fills it.
bench_empty_setup() {
  log_image_on_file();
  export int[] bench_empty_results = [0, 0, 0, 0, 0];
} return void;
():() then bench_counts_text:("0/0") then scratch_remove:(0)
():() then scratch_size_text:("size 0") then scratch_remove:(0)

// The last two counts of the results list, as "correct/keys".
bench_counts_text() {
  string counts = (import bench_empty_results)[3] + "/" + (import bench_empty_results)[4];
} return string counts;
given bench_pair_store ():("0/0") then scratch_remove:(0)
given bench_pair_with_counts ():("7/9") then scratch_remove:(0)

