// Writes the value of the record at rec, all of its bytes and nothing else, to the file outp. 0, or 3 (with a message) if the write failed.
emit_value(string output_path, word record) {
  int stored_length = peek32(record + (import rec_off_vlen));
  int sent = log_write(output_path, "a", record + record_value_offset(record), stored_length);
  int code = 0;
} chain (string output_path, word record) {
  if(sent < 0) {
    eprint("kv: cannot write the value to " + output_path);
    code = 3;
  }
} return int code;
