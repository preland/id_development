// The answer to a get: the value of rec if there is one, otherwise (rec is 0) a message about key and exit status 1.
get_out(string output_path, word record, string key) {
  int code = 1;
  if(record != 0) {
    code = emit_value(output_path, record);
  } else {
    eprint("kv: no such key: " + key);
  }
} return int code;
