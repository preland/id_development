// kv DB get KEY: the value's bytes on outp, or a message and status 1 if there is no such key.
command_get(string output_path, string[] keys, int[] entry_numbers, int[] used, word[] entry_records, string[] argv) {
  word record = database_record(keys, entry_numbers, used, entry_records, argv[3]);
  int code = get_out(output_path, record, argv[3]);
} return int code;
