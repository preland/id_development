// Prints each string on a line of its own.
list_print(string[] strings) {
  int index = 0;
  while(index < len(strings)) {
    print(strings[index]);
    index = index + 1;
  }
} return void;
(["a", "b"]):(["a", "b"]) then prints:("a\nb\n")
([]):([]) then prints:("")

// kv DB list [PREFIX]: the live keys that start with PREFIX (all of them without one), one per line, in byte order.
command_list(string[] keys, int[] entry_numbers, int[] used, string[] argv) {
  string prefix = "";
  if(len(argv) == 4) {
    prefix = argv[3];
  }
  string[] picked = database_keys(keys, entry_numbers, used, prefix);
} chain (string[] keys, int[] entry_numbers, int[] used, string[] argv) {
  list_print(picked);
} return int 0;
