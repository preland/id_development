("x.kv", "k", 1):("kv: no such key: k")
("x.kv", "k", 3):("kv: x.kv: cannot write to the log")
("x.kv", "k", 5):("kv: x.kv: the log is full (over 2147483647 bytes); compact it or delete keys")

