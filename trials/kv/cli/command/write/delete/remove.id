// What to tell the user about how a delete of key ended: 0 done, 1 there was no such key, 3 could not write, 5 the log is full. "" for success.
delete_text(string path, string key, int status) {
  string message = "";
  if(status == 1) {
    message = "kv: no such key: " + key;
  }
  if(status == 3) {
    message = "kv: " + path + ": cannot write to the log";
  }
} chain (string path, string key, int status) {
  if(status == 5) {
    message = full_text(path);
  }
} return string message;
