// Compacts the log, which had before bytes in the file, and reports.
compact_run(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, int before) {
  int total = database_compact(path, keys, entry_numbers, used, counters, entry_records);
  int code = compact_report(path, before, total);
} return int code;
