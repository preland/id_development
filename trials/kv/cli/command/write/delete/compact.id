// kv DB compact: rewrites the log so it holds only what is live. A message and status 1 if there is no log to compact.
command_compact(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records) {
  int before = counters[(import st_file)];
  int code = 1;
  if(before > 0) {
    code = compact_run(path, keys, entry_numbers, used, counters, entry_records, before);
  }
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records) {
  if(before == 0) {
    eprint("kv: " + path + ": no database to compact");
  }
} return int code;
