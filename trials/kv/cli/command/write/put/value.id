// Stores everything that can be read from the file inp (standard input, for the command) under key.
put_standard_input(string path, string input_path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  word address = alloc((import slurp_chunk));
  word[] slurp_buffer = [address, (import slurp_chunk), 0];
  int got = slurp(input_path, slurp_buffer);
} chain (string path, string input_path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  int status = 4;
  int value_length = slurp_buffer[2];
  if(got >= 0) {
    status = database_put(path, keys, entry_numbers, used, counters, entry_records, key, slurp_buffer[0], value_length);
  }
} chain (string path, string input_path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key) {
  int code = put_report(path, status);
} return int code;
