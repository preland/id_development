// Stores the string val (its bytes, however many) under key.
put_argument(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key, string value_text) {
  int argument_length = len(value_text);
  word address = alloc(argument_length + 1);
  string_copy_to_memory(value_text, 0, argument_length, address);
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string key, string value_text) {
  int status = database_put(path, keys, entry_numbers, used, counters, entry_records, key, address, argument_length);
  int code = put_report(path, status);
} return int code;
