// kv DB put KEY VALUE, or with - for VALUE, the value is all of standard input (inp).
command_put(string path, string input_path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string[] argv) {
  int code = 0;
  if(argv[4] == "-") {
    code = put_standard_input(path, input_path, keys, entry_numbers, used, counters, entry_records, argv[3]);
  } else {
    code = put_argument(path, keys, entry_numbers, used, counters, entry_records, argv[3], argv[4]);
  }
} return int code;
