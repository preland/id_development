// Doubles the buffer's capacity, keeping the bytes it already holds.
slurp_grow(word[] slurp_buffer) {
  int have = slurp_buffer[2];
  word cap = slurp_buffer[1] * 2;
  word address = alloc(cap);
} chain (word[] slurp_buffer) {
  buffer_copy(address, slurp_buffer[0], have);
  slurp_buffer[0] = address;
  slurp_buffer[1] = cap;
} return void;
