// Reads once from the handle into the room the buffer has left, and grows the buffer if that filled it. The bytes read, 0 at the end of the file, -1 on an error.
slurp_step(int file_handle, word[] slurp_buffer) {
  int room = slurp_buffer[1] - slurp_buffer[2];
  int got = fs_read_mem(file_handle, slurp_buffer[0] + slurp_buffer[2], room);
  if(got > 0) {
    slurp_buffer[2] = slurp_buffer[2] + got;
  }
} chain (int file_handle, word[] slurp_buffer) {
  if(slurp_buffer[2] == slurp_buffer[1]) {
    slurp_grow(slurp_buffer);
  }
} return int got;
