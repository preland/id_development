// Opens the database at path into fresh lists, reports what the open found, and runs the command. 3 if the file could not be opened as a log.
cli_db(string path, string[] argv) {
  string[] keys = [];
  int[] vals = [];
  int[] used = [];
} chain (string path, string[] argv) {
  int[] st = [];
  word[] ea = [];
  db_new(keys, vals, used, st);
} chain (string path, string[] argv) {
  int status = db_load(path, keys, vals, used, st, ea);
  warn_open(path, st, status);
  int code = 3;
} chain (string path, string[] argv) {
  if(status < 2) {
    code = cmd_run(path, keys, vals, used, st, ea, argv);
  } else {
    code = fail_open(path, status);
  }
} return int code;
