// What is wrong with the whole command line, or "" if nothing.
cli_check(int argc, string[] argv) {
  string bad = "expected: kv DB COMMAND [ARGS]";
  if(argc >= 3) {
    bad = cmd_bad(argc, argv[2]);
  }
} return string bad;
