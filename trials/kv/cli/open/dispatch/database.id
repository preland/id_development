// Opens the database at path into fresh lists, reports what the open found, and runs the command. 3 if the file could not be opened as a log.
cli_database(string path, string[] argv) {
  string[] keys = [];
  int[] entry_numbers = [];
  int[] used = [];
} chain (string path, string[] argv) {
  int[] counters = [];
  word[] entry_records = [];
  database_new(keys, entry_numbers, used, counters);
} chain (string path, string[] argv) {
  int status = database_load(path, keys, entry_numbers, used, counters, entry_records);
  warn_open(path, counters, status);
  int code = 3;
} chain (string path, string[] argv) {
  if(status < 2) {
    code = command_run(path, keys, entry_numbers, used, counters, entry_records, argv);
  } else {
    code = fail_open(path, status);
  }
} return int code;
