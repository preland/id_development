// Runs the command argv[2] against an opened store. The command line has been checked, so the word is one of cmd_names; a value that gets here without being one answers 2.
cmd_run(string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  string cmd = argv[2];
  int code = 2;
  if(cmd == "put") {
    code = cmd_put(path, (import in_dev), keys, vals, used, st, ea, argv);
  }
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  if(cmd == "get") {
    code = cmd_get((import out_dev), keys, vals, used, ea, argv);
  }
  if(cmd == "del") {
    code = cmd_del(path, keys, vals, used, st, ea, argv);
  }
  if(cmd == "list") {
    code = cmd_list(keys, vals, used, argv);
  }
} chain (string path, string[] keys, int[] vals, int[] used, int[] st, word[] ea, string[] argv) {
  if(cmd == "compact") {
    code = cmd_compact(path, keys, vals, used, st, ea);
  }
  if(cmd == "stats") {
    code = cmd_stats(st);
  }
  if(cmd == "bench") {
    code = cmd_bench(path, keys, vals, used, st, ea, argv);
  }
} return int code;
