// Runs the command argv[2] against an opened store. The command line has been checked, so the word is one of cmd_names; a value that gets here without being one answers 2.
command_run(string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string[] argv) {
  string command = argv[2];
  int code = 2;
  if(command == "put") {
    code = command_put(path, (import in_dev), keys, entry_numbers, used, counters, entry_records, argv);
  }
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string[] argv) {
  if(command == "get") {
    code = command_get((import out_dev), keys, entry_numbers, used, entry_records, argv);
  }
  if(command == "del") {
    code = command_delete(path, keys, entry_numbers, used, counters, entry_records, argv);
  }
  if(command == "list") {
    code = command_list(keys, entry_numbers, used, argv);
  }
} chain (string path, string[] keys, int[] entry_numbers, int[] used, int[] counters, word[] entry_records, string[] argv) {
  if(command == "compact") {
    code = command_compact(path, keys, entry_numbers, used, counters, entry_records);
  }
  if(command == "stats") {
    code = command_stats(counters);
  }
  if(command == "bench") {
    code = command_bench(path, keys, entry_numbers, used, counters, entry_records, argv);
  }
} return int code;
