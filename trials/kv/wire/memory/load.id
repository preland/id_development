// Pokes a list of byte values into the flat store, starting at ad. Test fixtures build their byte images from literal lists with it.
memory_load(word address, int[] byte_values) {
  int index = 0;
  while(index < len(byte_values)) {
    poke8(address + index, byte_values[index]);
    index = index + 1;
  }
} return void;
