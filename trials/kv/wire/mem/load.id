// Pokes a list of byte values into the flat store, starting at ad. Test fixtures build their byte images from literal lists with it.
mem_load(word ad, int[] bs) {
  int i = 0;
  while(i < len(bs)) {
    poke8(ad + i, bs[i]);
    i = i + 1;
  }
} return void;
