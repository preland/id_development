// One bit of a reflected CRC-32: shift right, and fold in the polynomial when the bit that fell off was set.
checksum_round(word checksum) {
  word mask = 0 - (checksum & 1);
  word next = ushr(checksum, 1) ^ (mask & (import crc_poly));
} return word next;
