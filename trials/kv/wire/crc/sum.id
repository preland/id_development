// The CRC-32 of n bytes at ad, as gzip and zlib compute it: crc32("123456789") is 0xCBF43926.
crc32(word ad, int n) {
  word run = crc_range((import crc_init), ad, n);
  word out = run ^ (import crc_init);
} return word out;
