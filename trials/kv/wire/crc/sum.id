// Folds n bytes of the flat store, from ad, into a running CRC value.
crc_range(word crc, word ad, int n) {
  int i = 0;
  while(i < n) {
    crc = crc_step(crc, peek8(ad + i));
    i = i + 1;
  }
} return word crc;
