// The CRC-32 a record's header should carry: over everything after the checksum field.
record_checksum(word record) {
  int size = record_length(record);
  int covered_length = size - (import rec_crc_len);
  word checksum = crc32(record + (import rec_crc_len), covered_length);
} return word checksum;
