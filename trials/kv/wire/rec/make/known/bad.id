// Fixtures: records that rec_check must refuse. Each differs from rec_t_good in one place.
// One value byte changed, checksum left alone.
rec_t_flip() {
  rec_t_good();
  poke8((import mem_t_ad) + 15, 121);
} return void;
():() then mem_t_sum:(914)
():() then rec_t_head:(1)

// A kind byte no record has, checksum left alone.
rec_t_kind() {
  rec_t_good();
  poke8((import mem_t_ad) + 4, 9);
} return void;
():() then mem_t_sum:(921)
():() then rec_t_head:(9)
