// Constants of the kv log format and of the in-memory state.
// The reflected CRC-32 polynomial (the one gzip and zlib use) and its start value.
word crc_poly = 0xEDB88320;
word crc_init = 0xFFFFFFFF;

// A record is a 13 byte header (crc32, kind, key length, value length, all little endian) then the key then the value.
// The crc covers everything after its own four bytes.
int rec_hdr = 13;
int rec_crc_len = 4;
int rec_off_kind = 4;
int rec_off_klen = 5;
int rec_off_vlen = 9;
int rec_put = 1;
int rec_del = 2;
int rec_max_key = 65535;
int rec_max_val = 1073741824;

// Why a record failed rec_check, in the order of the negative codes -1, -2, ...
string[] rec_reasons = ["truncated header", "unknown record kind", "impossible length", "truncated record", "checksum mismatch", "key holds a NUL byte"];

// The log file starts with these eight bytes; a file that does not is not a kv log.
string log_magic = "IDKVLOG1";
int log_hdr = 8;

// What an index lookup answers for a key that is not there, or was deleted.
int no_entry = -1;

// The counters of an open store, in one int[]. Slot 0 belongs to the hash table (how many slots hold a key, deleted or not).
int st_len = 7;
int st_live = 1;
int st_dead = 2;
int st_size = 3;
int st_recs = 4;
int st_file = 5;
int st_why = 6;

// Where the command line program reads a value from and writes one to; the commands take them as parameters so their cases can name other files.
string in_dev = "/dev/stdin";
string out_dev = "/dev/stdout";

// The first read of a value from standard input asks for this many bytes, and doubles when it fills.
int slurp_chunk = 65536;

// The commands, and how many words a command line may have for each, program name and database included.
string[] cmd_names = ["put", "get", "del", "list", "compact", "stats", "bench"];
int[] cmd_least = [5, 4, 4, 3, 3, 3, 4];
int[] cmd_most = [5, 4, 4, 4, 3, 3, 4];

// How each outcome of db_put (0 to 3, 4 for a value that could not be read, 5 for a full log) and of db_del (0, 1 missing, 3, 5 for a full log) becomes an exit status.
int[] put_exits = [0, 2, 2, 3, 3, 3];
int[] del_exits = [0, 1, 1, 3, 3, 3];

string usage_text = "usage: kv DB put KEY VALUE | put KEY - | get KEY | del KEY | list [PREFIX] | compact | stats | bench COUNT";

// A log is addressed with 32 bit sizes (fs_size answers an int), so it cannot grow past this many bytes.
int log_max = 2147483647;
