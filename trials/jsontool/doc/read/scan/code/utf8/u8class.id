utf8_bound(int bound_lead, int default_bound, int first_lead, int first_limit, int second_lead, int second_limit) {
  int chosen_limit = default_bound;
  if (bound_lead = first_lead) {
    chosen_limit = first_limit;
  } else if (bound_lead = second_lead) {
    chosen_limit = second_limit;
