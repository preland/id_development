given t_hexload stdin "f0 9f 98 41" (0, 4):(0)
given t_hexload stdin "c3 a9" (0, 2):(1)

u8_len(int pos) {
  int b0 = byte_at(pos);
  int n = u8_need(b0);
  int b1 = byte_at(pos + 1);
} chain (int pos) {
  int ok = b1 >= u8_lo(b0) && b1 <= u8_hi(b0);
  if (ok = 1 && n > 2) {
    ok = u8_tail(pos, n);
  }
  if (ok = 0) {
    n = 0;
  }
} return int n;
