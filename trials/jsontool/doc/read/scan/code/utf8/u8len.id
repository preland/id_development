u8_cont(int b) {
  int r = b >= 128 && b <= 191;
} return int r;
(128):(1)
(191):(1)
(127):(0)
(192):(0)
(-1):(0)

u8_tail(int pos, int n) {
  int ok = 1;
  int i = 2;
  while (i < n) {
    ok = ok & u8_cont(byte_at(pos + i));
    i = i + 1;
  }
} return int ok;
given t_hexload stdin "e2 82 ac" (0, 3):(1)
