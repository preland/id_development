hex_value(int digit_character) {
  int digit_value = -1;
  if (character_is_digit(digit_character) == 1) {
    digit_value = digit_character - 48;
  } else if ((digit_character | 32) >= 97 && (digit_character | 32) <= 102) {
    digit_value = (digit_character | 32) - 87;
  }
} return int digit_value;
