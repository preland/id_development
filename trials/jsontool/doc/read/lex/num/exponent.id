exp_sign(int at) {
  int q = at;
  int c = byte_at(at);
  if (c = (import k_plus) || c = (import k_minus)) {
    q = at + 1;
  }
} return int q;
given t_load stdin "+1" (0):(1)
given t_load stdin "-1" (0):(1)
given t_load stdin "1" (0):(0)

num_exp(int p) {
  int q = p;
  int c = byte_at(p) | 32;
  if (c = 101) {
    q = need_digits(exp_sign(p + 1), (import e_exp));
  }
} return int q;
given t_load stdin "e5" (0):(2)
given t_load stdin "E-12" (0):(4)
given t_load stdin "x" (0):(0)
given t_load stdin "e" (0):(-1) then t_err:(12)
given t_load stdin "e+" (0):(-1) then t_erp:(2)
