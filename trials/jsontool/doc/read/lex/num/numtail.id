num_zero(int p) {
  int q = p + 1;
  if (character_is_digit(byte_at(q)) = 1) {
    q = jfail((import e_zero), q);
  }
} return int q;
given t_load stdin "01" (0):(-1) then (import jc)[(import c_erp)]:(1)
given t_load stdin "0" (0):(1)
given t_load stdin "0.5" (0):(1)

need_digits(int at, int code) {
  int q = digits(at);
  if (q = at) {
    q = jfail(code, at);
  }
} return int q;
