given t_load stdin "x" (0, 12):(-1) then (import jc)[(import c_err)]:(12)

num_frac(int p) {
  int q = p;
  if (byte_at(p) = (import k_dot)) {
    q = need_digits(p + 1, (import e_frac));
  }
} return int q;
