output_string(string output_text) {
  int index = 0;
  while (index < len(output_text)) {
    output_byte(character_code_at(output_text, index));
    index = index + 1;
  }
} return void;
given fixture_loaded_input ("ab"):() then fixture_output_text:("ab")
given fixture_loaded_input (""):() then fixture_output_text:("")
given fixture_loaded_input ("a\nb"):() then fixture_output_text:("a\nb")

output_range(int from, int to) {
  word base = (import buffer_addresses)[(import w_src)];
  output_memory(base + from, to - from);
} return void;
given fixture_loaded_input stdin "abcdef" (1, 4):() then fixture_output_text:("bcd")
given fixture_loaded_input stdin "abcdef" (2, 2):() then fixture_output_text:("")
given fixture_loaded_input stdin "abcdef" (0, 6):() then fixture_output_text:("abcdef")

output_spaces(int space_total) {
  int index = 0;
  while (index < space_total) {
    output_byte((import k_sp));
    index = index + 1;
