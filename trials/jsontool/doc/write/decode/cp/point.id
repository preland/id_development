decode_pair(int hi, int byte_position) {
  int low_surrogate = hex_four(byte_position + 8);
  int combined_point = 65536 + ((hi - 55296) << 10) + (low_surrogate - 56320);
} return int combined_point;
given fixture_loaded_input stdin "\\ud83d\\ude00" (55357, 0):(128512)
given fixture_loaded_input stdin "\\ud800\\udc00" (55296, 0):(65536)
given fixture_loaded_input stdin "\\udbff\\udfff" (56319, 0):(1114111)

decode_code_point(int byte_position) {
  int code_point = hex_four(byte_position + 2);
  if (surrogate_class(code_point) == 1) {
    code_point = decode_pair(code_point, byte_position);
  }
} return int code_point;
given fixture_loaded_input stdin "\\u00e9" (0):(233)
given fixture_loaded_input stdin "\\ud83d\\ude00" (0):(128512)
given fixture_loaded_input stdin "\\u0041" (0):(65)

utf8_size(int scalar_value) {
  int width_in_bytes = 1;
  if (scalar_value >= 128) {
    width_in_bytes = 2;
  }
  if (scalar_value >= 2048) {
    width_in_bytes = 3;
  }
} chain (int scalar_value) {
  if (scalar_value >= 65536) {
    width_in_bytes = 4;
  }
} return int width_in_bytes;
(65):(1)
(127):(1)
(128):(2)
(2047):(2)
(2048):(3)
(65535):(3)
(65536):(4)
(1114111):(4)
