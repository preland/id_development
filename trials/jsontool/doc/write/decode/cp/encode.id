utf8_byte(int point_value, int sequence_length, int byte_index) {
  int shifted_value = point_value >> (6 * (sequence_length - 1 - byte_index));
  int encoded_byte = 128 | (shifted_value & 63);
  if (byte_index = 0) {
    encoded_byte = utf8_lead(sequence_length, shifted_value);
  }
} return int encoded_byte;
