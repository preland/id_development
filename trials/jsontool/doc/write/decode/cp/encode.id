utf8_put(word destination, int output_offset, int written_point) {
  int encoded_length = utf8_size(written_point);
  int written_count = 0;
  while (written_count < encoded_length) {
    poke8(destination + output_offset, utf8_byte(written_point, encoded_length, written_count));
    output_offset = output_offset + 1;
    written_count = written_count + 1;
  }
} return int output_offset;
