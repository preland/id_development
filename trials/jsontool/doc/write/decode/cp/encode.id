utf8_lead(int sequence_size, int lead_bits) {
  int lead_byte = lead_bits;
  if (sequence_size = 2) {
    lead_byte = 192 | lead_bits;
  } else if (sequence_size = 3) {
    lead_byte = 224 | lead_bits;
  }
} chain (int sequence_size, int lead_bits) {
  if (sequence_size = 4) {
    lead_byte = 240 | lead_bits;
  }
} return int lead_byte;
