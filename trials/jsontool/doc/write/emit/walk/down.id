emit_down(int cur, int kind, int child) {
  ob_byte(opener_of(kind));
  stk_push(cur);
  nl_indent(len((import stk)));
} return int child;
given t_parse stdin "[1]" (0, 5, 1):(1) then t_out:("[\n  ")
given t_parse stdin "{\"a\":1}" (0, 6, 1):(1) then t_out:("{\n  ")
given t_parse stdin "[1]" (0, 5, 1):(1) then t_stk:(1)

emit_flat(int cur, int kind) {
  emit_leaf(cur, kind);
  int nx = emit_up(cur);
} return int nx;
given t_parse stdin "7" (0, 3):(-1) then t_out:("7")
given t_parse stdin "[]" (0, 5):(-1) then t_out:("[]")
given t_parse stdin "[1,2" (1, 3):(2) then t_out:("1,\n  ")

emit_go(int cur, int kind, int child) {
  int nx = 0;
  if ((kind = (import kn_arr) || kind = (import kn_obj)) && child >= 0) {
    nx = emit_down(cur, kind, child);
  } else {
    nx = emit_flat(cur, kind);
  }
} return int nx;
given t_parse stdin "[1]" (0, 5, 1):(1) then t_out:("[\n  ")
given t_parse stdin "[]" (0, 5, -1):(-1) then t_out:("[]")
given t_parse stdin "7" (0, 3, -1):(-1) then t_out:("7")
given t_parse stdin "{\"a\":1}" (0, 6, 1):(1) then t_out:("{\n  ")
