emit_down(int current_node, int kind, int child) {
  output_byte(opener_of(kind));
  push((import container_stack), current_node);
  newline_indent(len((import container_stack)));
} return int child;
given fixture_parsed_document stdin "[1]" (0, 5, 1):(1) then fixture_output_text:("[\n  ")
given fixture_parsed_document stdin "{\"a\":1}" (0, 6, 1):(1) then fixture_output_text:("{\n  ")
given fixture_parsed_document stdin "[1]" (0, 5, 1):(1) then stack_state:("stk 1:0")

emit_flat(int current_node, int kind) {
  emit_leaf(current_node, kind);
  int flat_next_node = emit_up(current_node);
} return int flat_next_node;
given fixture_parsed_document stdin "7" (0, 3):(-1) then fixture_output_text:("7")
given fixture_parsed_document stdin "[]" (0, 5):(-1) then fixture_output_text:("[]")
given fixture_parsed_document stdin "[1,2" (1, 3):(2) then fixture_output_text:("1,\n  ")

emit_go(int current_node, int kind, int child) {
  int go_next_node = 0;
  if ((kind = (import kn_arr) || kind = (import kn_obj)) && child >= 0) {
    go_next_node = emit_down(current_node, kind, child);
  } else {
    go_next_node = emit_flat(current_node, kind);
  }
} return int go_next_node;
