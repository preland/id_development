attach_link(int par, int node) {
  int last = nget(par, (import f_last));
  if (last < 0) {
    nput(par, (import f_child), node);
  } else {
    nput(last, (import f_next), node);
  }
} chain (int par, int node) {
  nput(par, (import f_last), node);
  int cnt = nget(par, (import f_count));
  nput(par, (import f_count), cnt + 1);
} return void;
