msort(int[] xs) {
  int[] tmp = lst_copy(xs);
  int w = 1;
  while (w < len(xs)) {
    merge_pass(xs, tmp, w);
    w = w * 2;
  }
} return void;
given t_parse stdin "{\"d\":0,\"c\":0,\"b\":0,\"a\":0}" ([1, 3, 5, 7]):([7, 5, 3, 1])
given t_parse stdin "{\"a\":0,\"a\":1,\"a\":2}" ([1, 3, 5]):([1, 3, 5])
given t_parse stdin "{\"b\":0,\"\\u0061\":0}" ([1, 3]):([3, 1])
given t_parse stdin "{\"b\":0,\"c\":1,\"a\":2}" ([1, 3, 5]):([5, 1, 3])
given t_parse stdin "{\"a\":0}" ([1]):([1])
given t_parse stdin "{}" ([]):([])

keys_of(int o) {
  int[] ks = [];
  int c = nget(o, (import f_child));
  while (c >= 0) {
    push(ks, c);
    c = nget(nget(c, (import f_next)), (import f_next));
  }
} return int[] ks;
given t_parse stdin "{\"a\":1,\"b\":2}" (0):([1, 3])
given t_parse stdin "{}" (0):([])
given t_parse stdin "{\"a\":[1,2],\"b\":{\"c\":3}}" (0):([1, 5])
