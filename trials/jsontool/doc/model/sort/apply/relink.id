given fixture_parsed_document stdin "{\"a\":0,\"b\":1}" (0, [1, 3]):() then fixture_node_dump:("6:4-4:1:-1;7:1-4:-1:2;3:5-6:-1:3;7:7-10:-1:4;3:11-12:-1:-1;")

sort_object(int sorted_object) {
  int[] key_nodes = keys_of(sorted_object);
  if (len(key_nodes) > 1) {
    merge_sort(key_nodes);
    relink(sorted_object, key_nodes);
  }
} return void;
