relink_pair(int[] key_nodes, int index) {
  int member_value = node_get(key_nodes[index], (import f_next));
  int next_key = -1;
  if (index + 1 < len(key_nodes)) {
    next_key = key_nodes[index + 1];
  }
} chain (int[] key_nodes, int index) {
  node_put(member_value, (import f_next), next_key);
} return void;
given fixture_parsed_document stdin "{\"a\":0,\"b\":1}" ([3, 1], 0):([3, 1], 0) then fixture_node_dump:("6:4-4:1:-1;7:1-4:-1:2;3:5-6:-1:3;7:7-10:-1:4;3:11-12:-1:1;")
given fixture_parsed_document stdin "{\"a\":0,\"b\":1}" ([3, 1], 1):([3, 1], 1) then fixture_node_dump:("6:4-4:1:-1;7:1-4:-1:2;3:5-6:-1:-1;7:7-10:-1:4;3:11-12:-1:-1;")

relink(int linked_object, int[] key_nodes) {
  int key_total = len(key_nodes);
  node_put(linked_object, (import f_child), key_nodes[0]);
  int index = 0;
} chain (int linked_object, int[] key_nodes) {
  while (index < key_total) {
    relink_pair(key_nodes, index);
    index = index + 1;
  }
  node_put(linked_object, (import f_last), node_get(key_nodes[key_total - 1], (import f_next)));
} return void;
