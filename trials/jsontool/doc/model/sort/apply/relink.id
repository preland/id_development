relink_pair(int[] ks, int i) {
  int val = nget(ks[i], (import f_next));
  int nk = -1;
  if (i + 1 < len(ks)) {
    nk = ks[i + 1];
  }
} chain (int[] ks, int i) {
  nput(val, (import f_next), nk);
} return void;
given t_parse stdin "{\"a\":0,\"b\":1}" ([3, 1], 0):([3, 1], 0) then t_dump:("6:4-4:1:-1;7:1-4:-1:2;3:5-6:-1:3;7:7-10:-1:4;3:11-12:-1:1;")
given t_parse stdin "{\"a\":0,\"b\":1}" ([3, 1], 1):([3, 1], 1) then t_dump:("6:4-4:1:-1;7:1-4:-1:2;3:5-6:-1:-1;7:7-10:-1:4;3:11-12:-1:-1;")

relink(int o, int[] ks) {
  int m = len(ks);
  nput(o, (import f_child), ks[0]);
  int i = 0;
} chain (int o, int[] ks) {
  while (i < m) {
    relink_pair(ks, i);
    i = i + 1;
  }
  nput(o, (import f_last), nget(ks[m - 1], (import f_next)));
} return void;
given t_parse stdin "{\"a\":0,\"b\":1}" (0, [3, 1]):() then t_dump:("6:4-2:3:-1;7:1-4:-1:2;3:5-6:-1:-1;7:7-10:-1:4;3:11-12:-1:1;")
given t_parse stdin "{\"a\":0,\"b\":1}" (0, [1, 3]):() then t_dump:("6:4-4:1:-1;7:1-4:-1:2;3:5-6:-1:3;7:7-10:-1:4;3:11-12:-1:-1;")

sort_obj(int o) {
  int[] ks = keys_of(o);
  if (len(ks) > 1) {
    msort(ks);
    relink(o, ks);
  }
} return void;
given t_parse stdin "{\"b\":1,\"a\":2}" (0):() then t_ec:("{\"a\":2,\"b\":1}\n")
given t_parse stdin "{\"a\":1}" (0):() then t_ec:("{\"a\":1}\n")
given t_parse stdin "{}" (0):() then t_ec:("{}\n")
given t_parse stdin "{\"b\":{\"y\":1,\"x\":2},\"a\":0}" (0):() then t_ec:("{\"a\":0,\"b\":{\"y\":1,\"x\":2}}\n")
