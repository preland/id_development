memory_order(int left_size, int right_size) {
  int common_length = fixed_point_minimum(left_size, right_size);
  int order_result = memory_difference(common_length);
  if (order_result = 0) {
    order_result = fixed_point_sign(left_size - right_size);
  }
} return int order_result;
