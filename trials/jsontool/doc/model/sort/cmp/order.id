mem_order(int la, int lb) {
  int m = fixed_point_minimum(la, lb);
  int r = mem_diff(m);
  if (r = 0) {
    r = fixed_point_sign(la - lb);
  }
} return int r;
given t_dec2 stdin "{\"ab\":0,\"ac\":0}" (2, 2):(-1)
given t_dec2 stdin "{\"a\":0,\"ab\":0}" (1, 2):(-1)
given t_dec2 stdin "{\"a\":0,\"a\":0}" (1, 1):(0)
given t_dec2 stdin "{\"ab\":0,\"a\":0}" (2, 1):(1)

key_cmp(int a, int b) {
  int la = key_dec(a, (import w_s0));
  int lb = key_dec(b, (import w_s1));
  int r = mem_order(la, lb);
} return int r;
given t_parse stdin "{\"b\":0,\"a\":0}" (1, 3):(1)
given t_parse stdin "{\"b\":0,\"a\":0}" (3, 1):(-1)
given t_parse stdin "{\"b\":0,\"a\":0}" (1, 1):(0)
given t_parse stdin "{\"\\u0061\":0,\"a\":0}" (1, 3):(0)
given t_parse stdin "{\"\\u00e9\":0,\"z\":0}" (1, 3):(1)
