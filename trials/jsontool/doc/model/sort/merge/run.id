merge_pass(int[] node_list, int[] scratch_list, int pass_width) {
  int run_start = 0;
  int element_total = len(node_list);
  while (run_start < element_total) {
    merge_run(node_list, scratch_list, run_start, pass_width);
    run_start = run_start + 2 * pass_width;
  }
} chain (int[] node_list, int[] scratch_list, int pass_width) {
  copy_back(node_list, scratch_list);
} return void;
