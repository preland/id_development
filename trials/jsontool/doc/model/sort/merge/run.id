given fixture_parsed_document stdin "{\"a\":0,\"b\":0,\"c\":0,\"d\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 0, 2, 4):([1, 3, 5, 7], [1, 3, 5, 7], 0, 2, 4)
