merge_take(int[] xs, int[] tmp, int lo, int mid, int hi) {
  int i = lo;
  int j = mid;
  int k = lo;
} chain (int[] xs, int[] tmp, int lo, int mid, int hi) {
  while (k < hi) {
    if (take_left(xs, i, j, mid, hi) = 1) {
      lset(tmp, k, xs[i]);
      i = i + 1;
    } else {
      lset(tmp, k, xs[j]);
      j = j + 1;
    }
    k = k + 1;
  }
} return void;
given t_parse stdin "{\"c\":0,\"d\":0,\"a\":0,\"b\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 0, 2, 4):([1, 3, 5, 7], [5, 7, 1, 3], 0, 2, 4)
given t_parse stdin "{\"a\":0,\"b\":0,\"c\":0,\"d\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 0, 2, 4):([1, 3, 5, 7], [1, 3, 5, 7], 0, 2, 4)
given t_parse stdin "{\"a\":0,\"a\":1}" ([1, 3], [0, 0], 0, 1, 2):([1, 3], [1, 3], 0, 1, 2)

merge_run(int[] xs, int[] tmp, int lo, int w) {
  int n = len(xs);
  int mid = fx_min(lo + w, n);
  int hi = fx_min(lo + 2 * w, n);
} chain (int[] xs, int[] tmp, int lo, int w) {
  merge_take(xs, tmp, lo, mid, hi);
} return void;
given t_parse stdin "{\"c\":0,\"d\":0,\"a\":0,\"b\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 0, 2):([1, 3, 5, 7], [5, 7, 1, 3], 0, 2)
given t_parse stdin "{\"c\":0,\"d\":0,\"a\":0,\"b\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 2, 2):([1, 3, 5, 7], [0, 0, 5, 7], 2, 2)
given t_parse stdin "{\"c\":0,\"d\":0,\"a\":0,\"b\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 3, 2):([1, 3, 5, 7], [0, 0, 0, 7], 3, 2)

merge_pass(int[] xs, int[] tmp, int w) {
  int lo = 0;
  int n = len(xs);
  while (lo < n) {
    merge_run(xs, tmp, lo, w);
    lo = lo + 2 * w;
  }
} chain (int[] xs, int[] tmp, int w) {
  copy_back(xs, tmp);
} return void;
given t_parse stdin "{\"c\":0,\"d\":0,\"a\":0,\"b\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 2):([5, 7, 1, 3], [5, 7, 1, 3], 2)
given t_parse stdin "{\"d\":0,\"c\":0,\"b\":0,\"a\":0}" ([1, 3, 5, 7], [0, 0, 0, 0], 1):([3, 1, 7, 5], [3, 1, 7, 5], 1)
