merge_run(int[] node_list, int[] scratch_list, int run_begin, int run_width) {
  int list_length = len(node_list);
  int mid = fixed_point_minimum(run_begin + run_width, list_length);
  int hi = fixed_point_minimum(run_begin + 2 * run_width, list_length);
} chain (int[] node_list, int[] scratch_list, int run_begin, int run_width) {
  merge_take(node_list, scratch_list, run_begin, mid, hi);
} return void;
