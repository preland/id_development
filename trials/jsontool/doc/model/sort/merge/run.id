merge_take(int[] node_list, int[] scratch_list, int take_begin, int mid, int hi) {
  int index = take_begin;
  int right_position = mid;
  int merged_index = take_begin;
} chain (int[] node_list, int[] scratch_list, int take_begin, int mid, int hi) {
  while (merged_index < hi) {
    if (take_left(node_list, index, right_position, mid, hi) == 1) {
      integer_list_set(scratch_list, merged_index, node_list[index]);
      index = index + 1;
    } else {
      integer_list_set(scratch_list, merged_index, node_list[right_position]);
      right_position = right_position + 1;
    }
    merged_index = merged_index + 1;
  }
} return void;
