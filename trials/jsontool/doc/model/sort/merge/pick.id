given fixture_parsed_document stdin "{\"b\":0,\"a\":0}" ([1, 3], 0, 1, 1, 2):(0)

copy_back(int[] node_list, int[] scratch_list) {
  int index = 0;
  while (index < len(node_list)) {
    integer_list_set(node_list, index, scratch_list[index]);
    index = index + 1;
  }
} return void;
