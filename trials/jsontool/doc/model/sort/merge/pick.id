take_compare(int[] node_list, int index, int right_candidate, int hi) {
  int take_left_flag = 1;
  if (right_candidate < hi) {
    int comparison = key_compare(node_list[index], node_list[right_candidate]);
    take_left_flag = comparison <= 0;
  }
} return int take_left_flag;
given fixture_parsed_document stdin "{\"b\":0,\"a\":0}" ([1, 3], 0, 1, 2):(0)
given fixture_parsed_document stdin "{\"b\":0,\"a\":0}" ([3, 1], 0, 1, 2):(1)
given fixture_parsed_document stdin "{\"b\":0,\"a\":0}" ([1, 3], 0, 1, 1):(1)

take_left(int[] node_list, int index, int right_cursor, int mid, int hi) {
  int left_wins = 0;
  if (index < mid) {
    left_wins = take_compare(node_list, index, right_cursor, hi);
  }
} return int left_wins;
