child_at(int cur, int i, int cnt) {
  int c = -1;
  if (i >= 0 && i < cnt) {
    c = nget(cur, (import f_child));
    while (i > 0) {
      c = nget(c, (import f_next));
      i = i - 1;
    }
  }
} return int c;
given t_parse stdin "[10,20,30]" (0, 2, 3):(3)
given t_parse stdin "[10,20,30]" (0, 0, 3):(1)
