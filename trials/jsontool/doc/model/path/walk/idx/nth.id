given t_parse stdin "[10,20,30]" (0, -1, 3):(-1)

nth_child(int cur, int a) {
  int cnt = nget(cur, (import f_count));
  int i = a;
  if (a < 0) {
    i = cnt + a;
  }
} chain (int cur, int a) {
  int hit = child_at(cur, i, cnt);
} return int hit;
