mem_same(int off, int n) {
  int i = 0;
  while (i < n && peek8((import jw)[(import w_s0)] + i) = peek8((import jw)[(import w_pth)] + off + i)) {
    i = i + 1;
  }
  int ok = i == n;
} return int ok;
given t_wdec stdin "{\"a\":1}" (0, 1):(1)
given t_wdec stdin "{\"b\":1}" (0, 1):(0)
given t_wdec stdin "{\"a\":1}" (0, 0):(1)

key_eq(int c, int off, int n) {
  int m = key_dec(c, (import w_s0));
  int ok = 0;
  if (m = n) {
    ok = mem_same(off, n);
  }
} return int ok;
given t_wparse stdin "{\"a\":7}" (1, 0, 1):(1)
given t_wparse stdin "{\"b\":7}" (1, 0, 1):(0)
given t_wparse stdin "{\"ab\":7}" (1, 0, 1):(0)
given t_wparse stdin "{\"\\u0061\":7}" (1, 0, 1):(1)

key_pick(int hit, int c, int off, int n) {
  int r = hit;
  if (key_eq(c, off, n) = 1) {
    r = nget(c, (import f_next));
  }
} return int r;
given t_wparse stdin "{\"a\":7}" (-1, 1, 0, 1):(2)
given t_wparse stdin "{\"b\":7}" (5, 1, 0, 1):(5)
