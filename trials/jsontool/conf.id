string version_text = "jsontool 1.0.0";
string usage_text = "Usage: jsontool COMMAND [OPTIONS] [ARGS] [FILE]\n\nA strict JSON tool (RFC 8259). FILE defaults to standard input; '-' also\nmeans standard input.\n\nCommands:\n  fmt [--indent N | --compact] [FILE]\n        Pretty-print the document. Strings and numbers keep their spelling.\n  validate [FILE]\n        Print nothing; exit 0 if the input is valid JSON, 1 otherwise.\n  get [--raw] [--indent N | --compact] PATH [FILE]\n        Print the value at PATH, for example .a.b[2].c (see below).\n  keys [FILE]\n        List the top-level object's keys, one per line, in document order.\n  sort-keys [--indent N | --compact] [FILE]\n        Print the document with every object's keys sorted (bytewise).\n\nOptions:\n  --indent N    spaces per level, 0 to 64 (default 2); also --indent=N\n  --compact     no whitespace at all\n  -r, --raw     with get: print a string result decoded, without quotes\n  -h, --help    show this help and exit\n  --version     show the version and exit\n\nPaths: .key  [index]  [-index from the end]  [\"key with . or [ in it\"]\n  A bare '.' is the whole document. Duplicate keys: the last one wins.\n\nExit status: 0 success; 1 invalid input, path not found or I/O error;\n2 usage error.";
