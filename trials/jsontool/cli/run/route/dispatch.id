cli_after(int scan_outcome, int command_index) {
  int exit_status = 2;
  if (scan_outcome == (import a_help)) {
    print((import usage_text));
    exit_status = 0;
  } else if (scan_outcome >= 0) {
    exit_status = cli_check(command_index);
  }
} return int exit_status;
