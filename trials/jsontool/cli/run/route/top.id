cli_command(string[] argv) {
  int command_index = command_index_of(argv[1]);
  int exit_status = cli_pick(argv, command_index);
} return int exit_status;
given fixture_arguments stdin "[1]" (["p", "validate"]):(0)
given fixture_arguments (["p", "zzz"]):(2) then eprints:("jsontool: unknown command 'zzz'\nTry 'jsontool --help' for usage.\n")
given fixture_arguments stdin "[1]" (["p", "fmt", "--compact"]):(0) then fixture_output_text:("[1]\n")

cli_route(string[] argv) {
  int exit_status = cli_word(argv[1]);
  if (exit_status < 0) {
    exit_status = cli_command(argv);
  }
} return int exit_status;
given fixture_arguments (["p", "--version"]):(0) then prints:("jsontool 1.0.0\n")
given fixture_arguments stdin "{}" (["p", "fmt"]):(0) then fixture_output_text:("{}\n")
given fixture_arguments (["p", "nope"]):(2)

cli_dispatch(int argc, string[] argv) {
  int exit_status = 2;
  if (argc < 2) {
    eprint((import usage_text));
  } else {
    exit_status = cli_route(argv);
  }
} return int exit_status;
