cli_word(string command_word) {
  int exit_status = -1;
  if (command_word = "--help" || command_word = "-h") {
    print((import usage_text));
    exit_status = 0;
  } else if (command_word = "--version") {
    print((import version_text));
    exit_status = 0;
  }
} return int exit_status;
("--help"):(0)
("-h"):(0)
("--version"):(0) then prints:("jsontool 1.0.0\n")
("fmt"):(-1) then prints:("")
("--Help"):(-1)

cli_unknown(string unknown_command) {
  eprint("jsontool: unknown command '" + unknown_command + "'");
  eprint("Try 'jsontool --help' for usage.");
  int exit_status = 2;
} return int exit_status;
("bogus"):(2) then eprints:("jsontool: unknown command 'bogus'\nTry 'jsontool --help' for usage.\n")
(""):(2) then eprints:("jsontool: unknown command ''\nTry 'jsontool --help' for usage.\n")

cli_pick(string[] argv, int command_index) {
  int exit_status = 0;
  if (command_index >= 0) {
    exit_status = cli_go(argv, command_index);
  } else {
    exit_status = cli_unknown(argv[1]);
  }
} return int exit_status;
given fixture_arguments stdin "[1]" (["p", "fmt"], 0):(0) then fixture_output_text:("[\n  1\n]\n")
given fixture_arguments (["p", "zzz"], -1):(2) then eprints:("jsontool: unknown command 'zzz'\nTry 'jsontool --help' for usage.\n")
