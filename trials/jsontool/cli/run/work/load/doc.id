src_name(string src_file, string src_dash) {
  string path = src_file;
  if (src_file = "-") {
    path = src_dash;
  }
} return string path;
("-", "/dev/stdin"):("/dev/stdin")
("a.json", "/dev/stdin"):("a.json")
("--", "/dev/stdin"):("--")
("-", "<stdin>"):("<stdin>")
("a.json", "<stdin>"):("a.json")
("--", "<stdin>"):("--")

doc_check(string file, int st) {
  int code = 0;
  if (st != (import s_end)) {
    eprint(parse_message(file));
    code = 1;
  }
} return int code;
