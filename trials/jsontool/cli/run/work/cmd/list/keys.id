keys_pick(int code, int root) {
  int rc = code;
  if (code = 0 && nget(root, (import f_kind)) = (import kn_obj)) {
    rc = keys_run(root);
  } else if (code = 0) {
    eprint("jsontool: keys: the top-level value is not an object");
    rc = 1;
  }
} return int rc;
