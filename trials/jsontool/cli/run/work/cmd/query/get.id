get_emit(int node) {
  if ((import json_context)[(import c_raw)] = 1 && node_get(node, (import f_kind)) = (import kn_str)) {
    emit_raw(node);
  } else {
    emit_tree(node);
  }
  int code = out_finish();
} return int code;
given fixture_parsed_document stdin "[\"s\"]" (1):(0) then fixture_output_text:("\"s\"\n")
given fixture_raw_parse stdin "[\"s\"]" (1):(0) then fixture_output_text:("s\n")
