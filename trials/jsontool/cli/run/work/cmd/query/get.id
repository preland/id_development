get_pick(int hit, string path) {
  int code = 1;
  if (hit >= 0) {
    code = get_emit(hit);
  } else {
    eprint(walk_message(path));
  }
} return int code;
given fixture_parsed_document stdin "[5]" (1, ".a"):(0) then fixture_output_text:("5\n")
given fixture_failed_walk stdin "{\"b\":1}" (-1, ".a[1]"):(1) then eprints:("jsontool: get: .a[1]: key not found at .a\n")

get_walk(string path) {
  int hit = path_walk((import json_context)[(import c_root)]);
  int code = get_pick(hit, path);
} return int code;
