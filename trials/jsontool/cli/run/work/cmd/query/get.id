get_emit(int node) {
  if ((import jc)[(import c_raw)] = 1 && nget(node, (import f_kind)) = (import kn_str)) {
    emit_raw(node);
  } else {
    emit_tree(node);
  }
  int code = out_finish();
} return int code;
given t_parse stdin "[\"s\"]" (1):(0) then t_out:("\"s\"\n")
given t_rawparse stdin "[\"s\"]" (1):(0) then t_out:("s\n")
given t_rawparse stdin "[7]" (1):(0) then t_out:("7\n")
given t_rawparse stdin "[\"a\\tb\"]" (1):(0) then t_out:("a\tb\n")

get_pick(int hit, string path) {
  int code = 1;
  if (hit >= 0) {
    code = get_emit(hit);
  } else {
    eprint(walk_message(path));
  }
} return int code;
given t_parse stdin "[5]" (1, ".a"):(0) then t_out:("5\n")
given t_walk_bad stdin "{\"b\":1}" (-1, ".a[1]"):(1) then eprints:("jsontool: get: .a[1]: key not found at .a\n")

get_walk(string path) {
  int hit = path_walk((import jc)[(import c_root)]);
  int code = get_pick(hit, path);
} return int code;
given t_wparse stdin "{\"a\":[5,6]}" (".a[1]"):(0) then t_out:("6\n")
given t_wparse stdin "{\"b\":1}" (".a[1]"):(1) then eprints:("jsontool: get: .a[1]: key not found at .a\n")
given t_wparse stdin "{\"a\":[5,{\"x\":1}]}" (".a[1]"):(0) then t_out:("{\n  \"x\": 1\n}\n")
