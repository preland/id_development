cmd_get(string file) {
  string path = (import pargs)[0];
  int pc = path_parse(path);
  int code = 2;
} chain (string file) {
  if (pc = 0) {
    code = doc_load(file);
  } else {
    eprint(path_message(path));
  }
  if (code = 0) {
    code = get_walk(path);
  }
} return int code;
given t_get_file stdin "{\"a\":[5,6]}" ((import tp)):(0) then t_out:("6\n") then t_tmp_drop:(0)
