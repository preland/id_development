cmd_index(string name) {
  int i = 0;
  int at = -1;
  while (i < len((import cmd_names))) {
    if ((import cmd_names)[i] = name) {
      at = i;
    }
    i = i + 1;
  }
} return int at;
("fmt"):(0)
("get"):(2)
("sort-keys"):(4)
("nope"):(-1)
(""):(-1)
("FMT"):(-1)

all_digits(string txt) {
  int i = 0;
  while (i < len(txt) && chr_is_digit(charat(txt, i)) = 1) {
    i = i + 1;
  }
  int ok = i == len(txt);
} return int ok;
("123"):(1)
("12a"):(0)
("1x"):(0)
("x1"):(0)
(""):(1)
