arguments_reset() {
  export string[] positional_arguments = [];
} return void export positional_arguments;
():() then len((import positional_arguments)):(0)
():() then prints:("")

command_index_of(string name) {
  int index = 0;
  int at = -1;
  while (index < len((import cmd_names))) {
    if ((import cmd_names)[index] == name) {
      at = index;
    }
    index = index + 1;
  }
} return int at;
("fmt"):(0)
("get"):(2)
("sort-keys"):(4)
("nope"):(-1)
(""):(-1)
("FMT"):(-1)

all_digits(string digit_text) {
  int index = 0;
  while (index < len(digit_text) && character_is_digit(character_code_at(digit_text, index)) == 1) {
    index = index + 1;
  }
  int ok = index == len(digit_text);
} return int ok;
("123"):(1)
("12a"):(0)
("1x"):(0)
("x1"):(0)
(""):(1)
