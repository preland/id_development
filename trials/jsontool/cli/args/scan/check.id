arguments_miscount(int command_index, int need, int given_count) {
  int bad = 0;
  if (given_count < need) {
    eprint("jsontool: '" + (import cmd_names)[command_index] + "' needs a PATH argument");
    bad = 1;
  } else if (given_count > need + 1) {
    eprint("jsontool: '" + (import cmd_names)[command_index] + "' got too many arguments (" + given_count + ")");
    bad = 1;
  }
} return int bad;
