args_bad(int idx, int need, int n) {
  int bad = 0;
  if (n < need) {
    eprint("jsontool: '" + (import cmd_names)[idx] + "' needs a PATH argument");
    bad = 1;
  } else if (n > need + 1) {
    eprint("jsontool: '" + (import cmd_names)[idx] + "' got too many arguments (" + n + ")");
    bad = 1;
  }
} return int bad;
