opt_kind(string s) {
  int k = 0;
  if (s = "--indent") {
    k = 1;
  } else if (str_starts(s, "--indent=") = 1) {
    k = 2;
  }
} chain (string s) {
  if (s = "--compact") {
    k = 3;
  } else if (s = "--raw" || s = "-r") {
    k = 4;
  }
  if (s = "--help" || s = "-h") {
    k = 5;
  }
} chain (string s) {
  if (s = "--") {
    k = 7;
  } else if (str_starts(s, "-") = 1 && len(s) > 1 && k = 0) {
    k = 6;
  }
} return int k;
("--indent"):(1)
("--indent=3"):(2)
("--compact"):(3)
("--raw"):(4)
("-r"):(4)
("--help"):(5)
("-h"):(5)
("--"):(7)
("-x"):(6)
("--indentx"):(6)
("-"):(0)
("file.json"):(0)
(""):(0)
