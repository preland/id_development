option_kind(string option_text) {
  int option_kind_code = 0;
  if (option_text == "--indent") {
    option_kind_code = 1;
  } else if (string_starts_with(option_text, "--indent=") == 1) {
    option_kind_code = 2;
  }
} chain (string option_text) {
  if (option_text == "--compact") {
    option_kind_code = 3;
  } else if (option_text == "--raw" || option_text == "-r") {
    option_kind_code = 4;
  }
  if (option_text == "--help" || option_text == "-h") {
    option_kind_code = 5;
  }
} chain (string option_text) {
  if (option_text == "--") {
    option_kind_code = 7;
  } else if (string_starts_with(option_text, "-") == 1 && len(option_text) > 1 && option_kind_code == 0) {
    option_kind_code = 6;
  }
} return int option_kind_code;
("--indent"):(1)
("--indent=3"):(2)
("--compact"):(3)
("--raw"):(4)
("-r"):(4)
("--help"):(5)
("-h"):(5)
("--"):(7)
("-x"):(6)
("--indentx"):(6)
("-"):(0)
("file.json"):(0)
(""):(0)
