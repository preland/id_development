given t_parse stdin "" ("e.json"):("e.json:1:1: error: expected a value (found end of input)")

errno_text(int en) {
  int at = lst_index_of((import errnos), en);
  string why = "error " + en;
  if (at >= 0) {
    why = (import errtxt)[at];
  }
} return string why;
