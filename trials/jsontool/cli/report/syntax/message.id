parse_message(string file) {
  int error_position = (import json_context)[(import c_erp)];
  int line_of_error = error_line(error_position);
  int column_of_error = error_column(error_position);
} chain (string file) {
  string error_description = error_text();
  string message = source_name(file, "<stdin>") + ":" + line_of_error + ":" + column_of_error + ": error: " + error_description;
} return string message;
