read_error_message(string file) {
  int read_error_number = (import json_context)[(import c_errno)];
  string why = errno_text(read_error_number);
  string message = "jsontool: " + source_name(file, "<stdin>") + ": cannot read: " + why;
} return string message;
given fixture_failed_load ("x.json"):("jsontool: x.json: cannot read: no such file or directory")
given fixture_failed_load ("-"):("jsontool: <stdin>: cannot read: no such file or directory")

path_message(string path) {
  int code = (import json_context)[(import c_perr)];
  int at = (import json_context)[(import c_pep)];
  string message = "jsontool: invalid path '" + path + "' at position " + (at + 1) + ": " + (import p_msg)[code];
} return string message;
given fixture_parsed_path("a") ("a"):("jsontool: invalid path 'a' at position 1: a path must start with '.' or '['")
given fixture_parsed_path("q") ("q"):("jsontool: invalid path 'q' at position 1: a path must start with '.' or '['")

segment_body(int segment_form, int segment_first, int segment_second) {
  string segment_label = "[" + segment_first + "]";
  if (segment_form == 0) {
    segment_label = "." + str_of_mem((import buffer_addresses)[(import w_pth)] + segment_first, segment_second);
  }
} return string segment_label;
given fixture_walk_path(".a[1]") stdin "0" (0, 0, 1):(".a")
given fixture_walk_path(".a[1]") stdin "0" (1, 7, 0):("[7]")
given fixture_walk_path(".a[1]") stdin "0" (1, -1, 0):("[-1]")
