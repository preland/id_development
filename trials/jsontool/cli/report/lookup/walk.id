seg_text(int k) {
  int sk = (import pth)[k * 3];
  int sa = (import pth)[k * 3 + 1];
  int sb = (import pth)[k * 3 + 2];
} chain (int k) {
  string t = seg_body(sk, sa, sb);
} return string t;
given t_wparse stdin "0" (0):(".a")
given t_wparse stdin "0" (1):("[1]")
given t_wneg stdin "0" (1):("[-1]")

walk_message(string path) {
  int fk = (import jc)[(import c_fk)];
  int fr = (import jc)[(import c_fr)];
  string msg = "jsontool: get: " + path + ": " + (import fr_msg)[fr] + " at " + seg_text(fk);
} return string msg;
given t_walk_bad stdin "{\"b\":1}" (".a[1]"):("jsontool: get: .a[1]: key not found at .a")
given t_walk_bad stdin "{\"a\":[1]}" (".a[1]"):("jsontool: get: .a[1]: index out of range at [1]")
given t_walk_bad stdin "{\"a\":5}" (".a[1]"):("jsontool: get: .a[1]: the value is not an array at [1]")
given t_walk_bad stdin "[1]" (".a[1]"):("jsontool: get: .a[1]: the value is not an object at .a")
