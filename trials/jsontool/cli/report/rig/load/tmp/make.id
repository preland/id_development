fixture_temporary_file() {
  state_start();
  export string temporary_path = fs_mktemp("jsontool_", 0);
  fs_drop_exit(temporary_path);
} chain () {
  string file_content = read_all();
  int file_handle = fs_open((import temporary_path), "w");
  int write_result = fs_write_mem(file_handle, mem_of_str(file_content), len(file_content));
} chain () {
  int close_status = fs_close(file_handle);
} return void;
stdin "hey" ():() then fixture_temporary_size_text:("t_tmp_size 3") then fixture_temporary_remove:(0)
stdin "" ():() then fixture_temporary_size_text:("t_tmp_size 0") then fixture_temporary_remove:(0)

fixture_temporary_size_text() {
  string size_text = "t_tmp_size " + (fs_size((import temporary_path)));
} return string size_text;
given fixture_temporary_file stdin "abcd" ():("t_tmp_size 4") then fixture_temporary_remove:(0)
given fixture_temporary_file stdin "x" ():("t_tmp_size 1") then fixture_temporary_remove:(0)

fixture_temporary_remove() {
  int remove_status = fs_remove((import temporary_path));
} return int remove_status;
given fixture_temporary_file ():(0)
given fixture_temporary_file ():(0) then fixture_temporary_size_text:("t_tmp_size -1")
