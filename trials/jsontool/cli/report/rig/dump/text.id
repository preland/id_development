fixture_node_text(int index) {
  string node_text = node_get(index, (import f_kind)) + ":" + node_get(index, (import f_from)) + "-" + node_get(index, (import f_to)) + ":" + node_get(index, (import f_child)) + ":" + node_get(index, (import f_next)) + ";";
} return string node_text;
