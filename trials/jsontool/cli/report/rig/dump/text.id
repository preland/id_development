t_node_text(int i) {
  string s = nget(i, (import f_kind)) + ":" + nget(i, (import f_from)) + "-" + nget(i, (import f_to)) + ":" + nget(i, (import f_child)) + ":" + nget(i, (import f_next)) + ";";
} return string s;
given t_parse stdin "7" (0):("3:0-1:-1:-1;")
given t_parse stdin "[]" (0):("5:0--1:-1:-1;")

t_dump() {
  string s = "";
  int i = 0;
  while (i < t_nodes()) {
    s = s + t_node_text(i);
    i = i + 1;
  }
} return string s;
given t_parse stdin "[7]" ():("5:1-1:1:-1;3:1-2:-1:-1;")
given t_parse stdin "{\"a\":null}" ():("6:2-2:1:-1;7:1-4:-1:2;0:5-9:-1:-1;")

t_segstr() {
  string s = "";
  int k = 0;
  while (k * 3 < len((import pth))) {
    s = s + seg_text(k);
    k = k + 1;
  }
} return string s;
given t_path_a ():(".a[2]")
given t_pinit ():("")
