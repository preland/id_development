fixture_segments_text() {
  string segments_text = "";
  int segment_position = 0;
  while (segment_position * 3 < len((import path_cells))) {
    segments_text = segments_text + segment_text(segment_position);
    segment_position = segment_position + 1;
  }
} return string segments_text;
