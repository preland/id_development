t_flat() {
  t_parse();
  integer_list_set((import jc), (import c_ind), -1);
  emit_tree((import jc)[(import c_root)]);
} return void;
stdin "[ 1 , 2 ]" ():() then t_out:("[1,2]\n")
stdin "{\"a\" : true}" ():() then t_out:("{\"a\":true}\n")

t_pretty() {
  t_parse();
  emit_tree((import jc)[(import c_root)]);
} return void;
stdin "[1]" ():() then t_out:("[\n  1\n]\n")
stdin "{}" ():() then t_out:("{}\n")

t_path_a() {
  t_pinit();
  int rc = path_parse(".a[2]");
} return void;
():() then t_segs:(2)
():() then (import jc)[(import c_pk)]:(1)
