// The text in a scratch buffer: the decoded bytes are followed by zeros, so the
// length is where the first zero is. str_of_mem refuses a range that holds one.
scratch_buffer_text(int buffer_slot) {
  word scratch_address = (import buffer_addresses)[buffer_slot];
  int text_length = buffer_length_before_zero(scratch_address, 8);
  string decoded_text = str_of_mem(scratch_address, text_length);
} return string decoded_text;
given fixture_decoded_text stdin "a" (2):("a")
given fixture_loaded_input stdin "abc" (2):("")

fixture_first_buffer() {
  string first_text = scratch_buffer_text((import w_s0));
} return string first_text;
given fixture_loaded_input stdin "abc" ():("")
given fixture_decoded_text stdin "a" ():("a")

fixture_second_buffer() {
  string prefixed_text = "t_s1 " + (scratch_buffer_text((import w_s1)));
} return string prefixed_text;
given fixture_loaded_input stdin "abc" ():("t_s1 ")
given fixture_two_decoded_keys stdin "{\"ab\":0,\"ac\":0}" ():("t_s1 ac")
