// How the sqlite natives declared beside this file are linked: one C source over the system's libsqlite3, found by -lsqlite3, so the build's cc must already see its header and library (docs/INTEROP.md, "Calling C from id").

string name = "sq";
string c_header = "sq.h";

string[] c_linux_sources = ["sq.c"];
string[] c_linux_cflags = [];
string[] c_linux_link = ["-lsqlite3"];
string[] c_darwin_sources = ["sq.c"];
string[] c_darwin_cflags = [];
string[] c_darwin_link = ["-lsqlite3"];
