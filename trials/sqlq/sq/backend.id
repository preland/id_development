// How the sqlite natives declared beside this file are linked: one C source over the system's libsqlite3, whose flags pkg-config supplies (docs/BACKENDS.md, "backend.id"; docs/INTEROP.md, "Calling C from id").

string name = "sq";
string c_header = "sq.h";

string[] c_linux_sources = ["sq.c"];
string[] c_linux_pkg = ["sqlite3"];
string[] c_darwin_sources = ["sq.c"];
string[] c_darwin_pkg = ["sqlite3"];
