// Values for a statement's ? parameters, counted from 1. A blob is bytes in the flat store, copied by sqlite before the call returns. Each answers 0 or sqlite's error code, -1 for a stale handle.

native sq_bind_int(int st, int idx, word v) return int;

native sq_bind_text(int st, int idx, string s) return int;

native sq_bind_blob(int st, int idx, word addr, int n) return int;
