// The database the cases of this program work on. A case that needs one names sqq_t_mem and finds a connection to a private in-memory database in (import sqq_t_db).

// Opens a private in-memory database. Nothing closes it: the process ends with the case.
sqq_t_mem() {
  export int sqq_t_db = sq_open(":memory:");
} return void;
():() then sqq_t_n:(-1)
():() then sqq_t_ok:(1)

// Runs the statement sqq_tq on (import sqq_t_db) and ignores what it answers.
sqq_t_sql(string sqq_tq) {
  string[] sqq_tl = [];
  int sqq_tr = sqq_run((import sqq_t_db), sqq_tq, sqq_tl);
} return void;
given sqq_t_mem ("create table t(a)"):() then sqq_t_n:(0)
given sqq_t_mem ("select 1"):() then sqq_t_n:(-1)

// The number of rows of t in (import sqq_t_db), -1 when there is no table t.
sqq_t_n() {
  int sqq_tp = sq_prepare((import sqq_t_db), "select count(*) from t");
  int sqq_tc = 0 - 1;
  int sqq_ts = sq_step(sqq_tp);
} chain () {
  if (sqq_ts == 100) {
    sqq_tc = sq_cint(sqq_tp, 0);
  }
} return int sqq_tc;
given sqq_t_mem given sqq_t_sql("create table t(a)") ():(0)
given sqq_t_mem given sqq_t_sql("create table t(a)") given sqq_t_sql("insert into t values (1), (2)") ():(2)
