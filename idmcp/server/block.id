// A tool's answer as the MCP result of tools/call: one text content block that
// holds the tool's JSON, quoted, so the client sees a string and parses it.

server_block(string block_text) {
  string block_quoted = wire_quote(block_text);
  string block_result = "{\"content\":[{\"type\":\"text\",\"text\":" + block_quoted + "}]}";
} return string block_result;
("{\"ok\":true}"):("{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"ok\\\":true}\"}]}")
("a\nb"):("{\"content\":[{\"type\":\"text\",\"text\":\"a\\nb\"}]}")
