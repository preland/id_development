// What each MCP method answers. initialize echoes the protocol version the
// client asked for (any string, quoted back safely) and falls back to the
// version in conf.id when it sent none; tools/list is the constant tool list.

server_method(string server_line, string server_name, string server_id_text) {
  string server_answer = wire_failure(server_id_text, -32601, "Method not found");
  if (server_name == "initialize") {
    server_answer = wire_result(server_id_text, server_initialize(server_line));
  }
  if (server_name == "tools/list") {
    server_answer = wire_result(server_id_text, tool_list((import tool_specs)));
  }
} chain (string server_line, string server_name, string server_id_text) {
  if (server_name == "tools/call") {
    server_answer = server_call(server_line, server_id_text);
  }
} return string server_answer;
("{}", "initialize", "1"):("{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"idmcp\",\"version\":\"0.1.0\"}}}")
("{}", "tools/list", "\"a\""):("{\"jsonrpc\":\"2.0\",\"id\":\"a\",\"result\":{\"tools\":[{\"name\":\"echo\",\"description\":\"Returns the text it is given.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}},{\"name\":\"project_open\",\"description\":\"Opens an id project for this session by copying it into a private workspace. Returns counts, the top of the tree and the compiler baseline.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}},{\"name\":\"list\",\"description\":\"Lists a directory or a file of the open project, with each file's functions, line numbers and case counts.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"depth\":{\"type\":\"integer\"}},\"required\":[]}},{\"name\":\"read\",\"description\":\"Reads one function by name (idstd with std true) with its cases, location, callers and callees, or a slice of a file of at most 200 lines.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"file\":{\"type\":\"string\"},\"std\":{\"type\":\"boolean\"},\"line\":{\"type\":\"integer\"},\"count\":{\"type\":\"integer\"}},\"required\":[]}},{\"name\":\"find\",\"description\":\"Finds functions by exact name first, then by substring, in the project and in idstd.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"where\":{\"type\":\"string\"}},\"required\":[\"query\"]}},{\"name\":\"calls\",\"description\":\"Shows call edges of the open project around one function.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"direction\":{\"type\":\"string\"},\"depth\":{\"type\":\"integer\"}},\"required\":[\"name\"]}},{\"name\":\"explain\",\"description\":\"Explains a compiler error code such as E0408.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"code\":{\"type\":\"string\"}},\"required\":[\"code\"]}},{\"name\":\"check\",\"description\":\"Runs the compiler check on the open project and returns the first ten diagnostics with their fixes.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"required\":[]}}]}}")
("{}", "resources/list", "2"):("{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}")
("{\"params\":{\"name\":\"echo\",\"arguments\":{\"text\":\"x\"}}}", "tools/call", "3"):("{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"x\"}]}}")

server_initialize(string server_line) {
  string server_version_text = (import server_protocol_default);
  if (wire_expect(server_line, "params.protocolVersion", "string") == 1) {
    server_version_text = json_text(server_line, "params.protocolVersion");
  }
  string server_quoted = json_quote(server_version_text);
} chain (string server_line) {
  string server_info = "{\"protocolVersion\":" + server_quoted + ",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"idmcp\",\"version\":" + json_quote((import server_version)) + "}}";
} return string server_info;
