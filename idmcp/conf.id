string[] tool_specs = ["echo~Returns the text it is given.~text:string~text","project_open~Opens an id project for this session by copying it into a private workspace. Returns counts, the top of the tree and the compiler baseline.~path:string~path","list~Lists a directory or a file of the open project, with each file's functions, line numbers and case counts.~path:string;depth:integer~","read~Reads one function by name (idstd with std true) with its cases, location, callers and callees, or a slice of a file of at most 200 lines.~name:string;file:string;std:boolean;line:integer;count:integer~","find~Finds functions by exact name first, then by substring, in the project and in idstd.~query:string;where:string~query","calls~Shows call edges of the open project around one function.~name:string;direction:string;depth:integer~name","explain~Explains a compiler error code such as E0408.~code:string~code","check~Runs the compiler check on the open project and returns the first ten diagnostics with their fixes.~~"];
