// Counting for the sample project.

sample_count(int sample_limit) {
  int sample_index = 0;
  int sample_sum = 0;
  while (sample_index < sample_limit) {
    sample_sum = sample_sum + sample_index;
    sample_index = sample_index + 1;
  }
} return int sample_sum;
