// Keeps a value at or under a top. Anything lower stays as it is.
sample_clamp(int sample_value, int sample_top) {
  int sample_kept = sample_value;
  if (sample_value > sample_top) {
    sample_kept = sample_top;
  }
} return int sample_kept;
