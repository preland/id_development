// A small library for the idmcp protocol tests: it counts, clamps and reports.
// It has no main, so it is a library, and idmcp compiles it along with itself.

sample_report(int sample_limit, int sample_top) {
  int sample_total = sample_count(sample_limit);
  int sample_shown = sample_clamp(sample_total, sample_top);
  string sample_line = "total " + sample_shown;
} return string sample_line;
(5, 7):("total 7")
(3, 7):("total 3")
