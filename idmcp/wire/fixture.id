// A buffer for the cases of wire_fill and wire_clean: 64 bytes of the store that begin 7, 8, NUL, 9;
// a case takes its address as (import wire_buffer).

wire_t_buffer() {
  export word wire_buffer = alloc(64);
  poke32(wire_buffer, 150996999);
} return void;
