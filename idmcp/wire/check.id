// Classifying a request line before anything reads it: 0 for a request the server
// can dispatch, -32700 (parse error) for a line that is not one complete JSON
// object, -32600 (invalid request) for an object that is not a JSON-RPC 2.0
// request: "jsonrpc" must be the string "2.0", "method" a string, "id" absent, a
// string or a number, and "params" absent, an object or an array.

wire_check(string wire_line) {
  int wire_code = -32700;
  if (wire_balanced(wire_line) == 1) {
    wire_code = -32600;
  }
  if (wire_code == -32600 && wire_shape(wire_line) == 1) {
    wire_code = 0;
  }
} return int wire_code;
("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"):(0)
("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"):(0)
("{bad"):(-32700)
(""):(-32700)
("[1,2]"):(-32700)
("{\"jsonrpc\":\"1.0\",\"id\":1,\"method\":\"x\"}"):(-32600)
("{\"id\":1,\"method\":\"x\"}"):(-32600)
("{\"jsonrpc\":\"2.0\",\"id\":1}"):(-32600)
("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":5}"):(-32600)
("{\"jsonrpc\":\"2.0\",\"id\":[1],\"method\":\"x\"}"):(-32600)
("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"x\",\"params\":5}"):(-32600)

wire_shape(string wire_line) {
  int wire_version_ok = wire_expect(wire_line, "jsonrpc", "string");
  int wire_method_ok = wire_expect(wire_line, "method", "string");
  int wire_id_ok = wire_expect(wire_line, "id", "missing,string,number");
} chain (string wire_line) {
  int wire_params_ok = wire_expect(wire_line, "params", "missing,object,array");
  int wire_good = wire_version_ok * wire_method_ok * wire_id_ok * wire_params_ok;
  if (json_text(wire_line, "jsonrpc") != "2.0") {
    wire_good = 0;
  }
} return int wire_good;
("{\"jsonrpc\":\"2.0\",\"id\":\"a\",\"method\":\"m\",\"params\":[]}"):(1)
("{\"jsonrpc\":\"2.0\",\"method\":\"m\"}"):(1)
("{\"jsonrpc\":2.0,\"id\":1,\"method\":\"m\"}"):(0)
("{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"m\"}"):(0)
("{\"jsonrpc\":\"2.0\",\"params\":{\"id\":[1]},\"method\":\"m\"}"):(1)

wire_expect(string wire_line, string wire_path, string wire_allowed) {
  string wire_name = wire_kind(wire_line, json_find(wire_line, wire_path));
  int wire_ok = str_find("," + wire_allowed + ",", "," + wire_name + ",") >= 0;
} return int wire_ok;
("{\"a\":1}", "a", "number"):(1)
("{\"a\":1}", "a", "string,object"):(0)
("{\"a\":1}", "b", "missing,number"):(1)
("{\"a\":1}", "b", "number"):(0)
("{\"a\":{\"b\":\"s\"}}", "a.b", "string"):(1)
