// A buffer filled from the case's stdin by wire_fill, for the cases of wire_line_text:
// the address is (import wire_filled_buffer) and the length wire_fill answered
// (import wire_filled_size).

wire_t_fill() {
  export word wire_filled_buffer = alloc(64);
  export int wire_filled_size = wire_fill(wire_filled_buffer, 60);
} return void;
stdin "hello\n" ():() then wire_t_filled:(5)
stdin "" ():() then wire_t_filled:(-1)

wire_t_filled() {
  int wire_filled = (import wire_filled_size);
} return int wire_filled;
given wire_t_fill stdin "abc\n" ():(3)
given wire_t_fill stdin "\n" ():(0)
