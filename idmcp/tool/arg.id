// Reading a tool's arguments out of the tools/call request line. A missing or
// wrongly typed argument reads as empty (text), the fallback (integer) or false
// (boolean), and the tool itself decides whether that is an error.

tool_argument(string arg_line, string arg_key) {
  int arg_pos = json_find(arg_line, "params.arguments." + arg_key);
  string arg_kind = wire_kind(arg_line, arg_pos);
  string arg_text = "";
} chain (string arg_line, string arg_key) {
  if (arg_kind == "string") {
    arg_text = wire_string(arg_line, arg_pos);
  }
} return string arg_text;
("{\"params\":{\"arguments\":{\"path\":\"a\\\\b\"}}}", "path"):("a\\b")
("{\"params\":{\"arguments\":{\"path\":3}}}", "path"):("")
("{\"params\":{\"arguments\":{}}}", "path"):("")

tool_integer(string arg_line, string arg_key, int arg_fallback) {
  int arg_pos = json_find(arg_line, "params.arguments." + arg_key);
  string arg_kind = wire_kind(arg_line, arg_pos);
  int arg_value = arg_fallback;
} chain (string arg_line, string arg_key, int arg_fallback) {
  if (arg_kind == "number") {
    arg_value = to_int(json_str(arg_line, arg_pos));
  }
} return int arg_value;
("{\"params\":{\"arguments\":{\"depth\":3}}}", "depth", 1):(3)
("{\"params\":{\"arguments\":{\"depth\":\"3\"}}}", "depth", 1):(1)
("{\"params\":{\"arguments\":{}}}", "depth", 7):(7)

tool_boolean(string arg_line, string arg_key) {
  int arg_pos = json_find(arg_line, "params.arguments." + arg_key);
  string arg_kind = wire_kind(arg_line, arg_pos);
  int arg_flag = 0;
} chain (string arg_line, string arg_key) {
  if (arg_kind == "boolean" && json_str(arg_line, arg_pos) == "true") {
    arg_flag = 1;
  }
} return int arg_flag;
("{\"params\":{\"arguments\":{\"std\":true}}}", "std"):(1)
("{\"params\":{\"arguments\":{\"std\":false}}}", "std"):(0)
("{\"params\":{\"arguments\":{\"std\":\"true\"}}}", "std"):(0)
