// Where a function is defined, from `idc --where NAME PATH` (FILE:LINE:
// SIGNATURE on one line, or "idwhere: no function ..." when there is none), and
// the first sentence of the comment above it, which is how find says what a
// function is for.

tool_where_parse(string where_text) {
  string where_line = str_before(where_text, "\n");
  string where_rest = str_after(where_line, ":");
  string where_found = "";
} chain (string where_text) {
  if (str_starts(where_line, "idwhere:") == 0 && str_find(where_rest, ": ") > 0) {
    where_found = str_before(where_line, ":") + "|" + str_before(where_rest, ":") + "|" + str_after(where_rest, ": ");
  }
} return string where_found;
("a/b.id:14: f(int x, string y) -> int\n"):("a/b.id|14|f(int x, string y) -> int")
("idwhere: no function 'q' under .\n"):("")
(""):("")
("/abs/c.id:3: g() -> void"):("/abs/c.id|3|g() -> void")

tool_locate(string where_name, string where_scope) {
  string where_text = "";
  if (tool_safe(where_name) == 1) {
    where_text = tool_idc("--where\n" + where_name + "\n" + where_scope + "\n");
  }
  string where_found = tool_where_parse(where_text);
} return string where_found;
given tool_t_session ("sample_clamp", "sample"):("sample/math/count.id|15|sample_clamp(int sample_value, int sample_top) -> int")
given tool_t_session ("no_such_function_anywhere", "sample"):("")
given tool_t_session ("sample_clamp\n--help", "sample"):("")

tool_sentence(string note_doc) {
  string note_flat = str_replace(note_doc, "\n", " ");
  string note_plain = str_replace(note_flat, "// ", "");
  int note_stop = str_find(note_plain + " ", ". ");
} chain (string note_doc) {
  int note_cap = fx_min(len(note_plain), 240);
  string note_first = str_sub(note_plain, 0, note_cap);
  if (note_stop >= 0 && note_stop < 240) {
    note_first = str_sub(note_plain, 0, note_stop + 1);
  }
} return string note_first;
("// Adds two numbers. Slowly.\n// Really."):("Adds two numbers.")
("// Only one sentence"):("Only one sentence")
("// Adds\n// across lines. More."):("Adds across lines.")
(""):("")
