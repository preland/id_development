// A list of names as JSON strings, ready for tool_array.

tool_quote_list(string[] quoted_items) {
  string[] quoted_out = [];
  int quoted_at = 0;
  while (quoted_at < len(quoted_items)) {
    push(quoted_out, wire_quote(quoted_items[quoted_at]));
    quoted_at = quoted_at + 1;
  }
} return string[] quoted_out;
(["a", "b\"c"]):(["\"a\"", "\"b\\\"c\""])
([]):([])
(["a", "b", "c", "d"]):(["\"a\"", "\"b\"", "\"c\"", "\"d\""])[time:O(n), mem:O(n)]
(["a", "b", "c", "d", "e", "f", "g", "h"]):(["\"a\"", "\"b\"", "\"c\"", "\"d\"", "\"e\"", "\"f\"", "\"g\"", "\"h\""])[time:O(n), mem:O(n)]
