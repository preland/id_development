// How many consecutively numbered fixtures the .odt directory holds: the first index with no file ends the count.
fixture_count(string fixture_directory) {
  int probe_number = 1;
  string stem = fixture_name(fixture_directory, probe_number);
  while (stem != "") {
    probe_number = probe_number + 1;
    stem = fixture_name(fixture_directory, probe_number);
  }
} chain (string fixture_directory) {
  int total = probe_number - 1;
} return int total;
("../quillcorpus/odt"):(12)
("../quillcorpus/none"):(0)

// Prints "N name" for fixture n.
fixture_say(string fixture_directory, int fixture_number) {
  string stem = fixture_name(fixture_directory, fixture_number);
  print("" + fixture_number + " " + stem);
} return void;
("../quillcorpus/odt", 3):() then prints:("3 03_inline\n")
("../quillcorpus/odt", 12):() then prints:("12 12_image\n")

// Prints one "N name" line per fixture, in index order.
fixture_list(string fixture_directory) {
  int total = fixture_count(fixture_directory);
  int fixture_number = 1;
  while (fixture_number <= total) {
    fixture_say(fixture_directory, fixture_number);
    fixture_number = fixture_number + 1;
  }
} return void;
("../quillcorpus/odt"):() then prints:("1 01_plain\n2 02_headings\n3 03_inline\n4 04_colours\n5 05_lists\n6 06_pagebreak\n7 07_pages\n8 08_long\n9 09_unicode\n10 10_empty\n11 11_table\n12 12_image\n")
("../quillcorpus/odt/"):() then prints:("1 01_plain\n2 02_headings\n3 03_inline\n4 04_colours\n5 05_lists\n6 06_pagebreak\n7 07_pages\n8 08_long\n9 09_unicode\n10 10_empty\n11 11_table\n12 12_image\n")
("../quillcorpus/none"):() then prints:("")
