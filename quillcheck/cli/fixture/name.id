// The file-name prefix fixture n carries: two digits and an underscore.
fixture_prefix(int fixture_number) {
  string number_prefix = "" + fixture_number + "_";
  if (fixture_number < 10) {
    number_prefix = "0" + number_prefix;
  }
} return string number_prefix;
(3):("03_")
(12):("12_")

// The fixture name inside one directory entry: the entry minus ".odt" when it starts with the prefix and ends with ".odt", otherwise the stem it was given.
fixture_stem_of(string entry, string number_prefix, string stem) {
  string chosen = stem;
  int fits = str_starts(entry, number_prefix) == 1 && str_ends(entry, ".odt") == 1;
  if (fits == 1) {
    chosen = str_sub(entry, 0, len(entry) - 4);
  }
} return string chosen;
("03_inline.odt", "03_", ""):("03_inline")
("03_inline.fodt", "03_", "keep"):("keep")
("04_colours.odt", "03_", "keep"):("keep")

// The name of fixture n in the .odt directory, without its extension, or "" when there is none.
fixture_name(string fixture_directory, int fixture_number) {
  string[] names = exec_ls(fixture_directory);
  string number_prefix = fixture_prefix(fixture_number);
  string stem = "";
} chain (string fixture_directory, int fixture_number) {
  int listing_cursor = 0;
  while (listing_cursor < len(names)) {
    stem = fixture_stem_of(names[listing_cursor], number_prefix, stem);
    listing_cursor = listing_cursor + 1;
  }
} return string stem;
("../quillcorpus/odt", 3):("03_inline")
("../quillcorpus/odt", 12):("12_image")
("../quillcorpus/odt", 99):("")
