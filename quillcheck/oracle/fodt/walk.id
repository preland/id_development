// Steps every line, in order.
fodt_each(string[] lines, int[] walk_state, string[] records) {
  int line_cursor = 0;
  while (line_cursor < len(lines)) {
    fodt_step(lines[line_cursor], walk_state, records);
    line_cursor = line_cursor + 1;
  }
} return void;
