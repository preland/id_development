// The paragraphs, headings, list items, tables and frames of a fodt document as one "kind:text" line each, in document order, "" for a document with none. Tags, styles and everything outside the body are dropped.
ofodt_norm(string raw) {
  string[] lines = str_split(raw, "\n");
  int[] st = [];
  string[] recs = [];
} chain (string raw) {
  list_fill(st, (import st_len), 0);
  ofodt_each(lines, st, recs);
  string joined = str_join(recs, "\n");
} chain (string raw) {
  string norm = joined;
  if (len(recs) > 0) {
    norm = joined + "\n";
  }
} return string norm;
