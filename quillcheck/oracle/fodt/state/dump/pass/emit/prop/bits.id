// The six flags of a run as a dump prints them: "b=0 i=0 u=0 s=0 sup=0 sub=0".
fodt_dump_flags(Catalog style_store, string[] span_styles, string paragraph_key) {
  int bold_flag = fodt_dump_flag_on(fodt_dump_run_property(style_store, span_styles, paragraph_key, "t.fo:font-weight"), 0);
  int italic_flag = fodt_dump_flag_on(fodt_dump_run_property(style_store, span_styles, paragraph_key, "t.fo:font-style"), 1);
  int underline_flag = fodt_dump_flag_on(fodt_dump_run_property(style_store, span_styles, paragraph_key, "t.style:text-underline-style"), 2);
} chain (Catalog style_store, string[] span_styles, string paragraph_key) {
  int strike_flag = fodt_dump_flag_on(fodt_dump_run_property(style_store, span_styles, paragraph_key, "t.style:text-line-through-style"), 2);
  int script_position = fodt_dump_script_position(fodt_dump_run_property(style_store, span_styles, paragraph_key, "t.style:text-position"));
  string result_text = "b=" + bold_flag + " i=" + italic_flag + " u=" + underline_flag + " s=" + strike_flag + " sup=" + (script_position == 1) + " sub=" + (script_position == 2);
} return string result_text;
(Catalog(["t:T", "p:"], ["|t.fo:font-weight=bold|t.style:text-position=super 58%", ""], ["", "", "", "", "", ""]), ["t:T"], "p:"):("b=1 i=0 u=0 s=0 sup=1 sub=0")
(Catalog(["p:"], ["|t.fo:font-style=italic|t.style:text-line-through-style=solid"], ["", "", ""]), [], "p:"):("b=0 i=1 u=0 s=1 sup=0 sub=0")

// A colour value as a dump prints it: "#rrggbb" in lowercase, "-" for anything else (transparent, absent).
fodt_dump_color(string value_text) {
  string result_text = "-";
  if(len(value_text) == 7 && character_code_at(value_text, 0) == 35) {
    result_text = string_lower(value_text);
  }
} return string result_text;
("#FF0000"):("#ff0000")
("transparent"):("-")
(""):("-")
