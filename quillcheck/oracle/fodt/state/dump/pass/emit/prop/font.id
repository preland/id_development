// The family a declared face name stands for: the family in its font-face entry, or the name itself when no such face is declared.
fodt_dump_face_family(Catalog style_store, string own) {
  int entry_index = fodt_dump_entry_index(style_store, "f:" + own);
  string font_family = own;
  if(entry_index >= 0) {
    font_family = fodt_dump_value(style_store.props[entry_index], "fam");
  }
} return string font_family;
(Catalog(["f:F1"], ["|fam=Liberation Serif"], ["", "", ""]), "F1"):("Liberation Serif")
(Catalog(["f:F1"], ["|fam=Liberation Serif"], ["", "", ""]), "Other"):("Other")

// The family a style's own properties name: style:font-name (through the face declared by that name), else fo:font-family; "" when it names none.
fodt_dump_style_family(Catalog style_store, string style_key) {
  string face_name = fodt_dump_own(style_store, style_key, "t.style:font-name");
  string family_declared = fodt_dump_own(style_store, style_key, "t.fo:font-family");
  string family_resolved = fodt_dump_unquote(family_declared);
} chain (Catalog style_store, string style_key) {
  if(face_name != "") {
    family_resolved = fodt_dump_face_family(style_store, face_name);
  }
} return string family_resolved;
(Catalog(["t:T", "f:F"], ["|t.style:font-name=F|t.fo:font-family='X'", "|fam=Real"], ["", "", "", "", "", ""]), "t:T"):("Real")
(Catalog(["t:T"], ["|t.fo:font-family='X Y'"], ["", "", ""]), "t:T"):("X Y")
(Catalog(["t:T"], [""], ["", "", ""]), "t:T"):("")
