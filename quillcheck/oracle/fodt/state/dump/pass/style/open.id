// The key prefix of a paragraph style family ("p:"), of a text style family ("t:"), "" for any other.
fodt_dump_family_prefix(string font_family) {
  string style_prefix = "";
  if(font_family == "paragraph") {
    style_prefix = "p:";
  }
  if(font_family == "text") {
    style_prefix = "t:";
  }
} return string style_prefix;
("paragraph"):("p:")
("text"):("t:")
("graphic"):("")

// The listed attributes the reader's element has, as "|prefix+name=value" pairs one after the other; an attribute the element lacks adds nothing.
fodt_dump_attributes(string key_prefix, string[] attribute_names, XmlR document_reader) {
  string result_text = "";
  int name_cursor = 0;
  while(name_cursor < len(attribute_names)) {
    result_text = result_text + fodt_dump_pair(key_prefix + attribute_names[name_cursor], xml_reader_attribute(document_reader, attribute_names[name_cursor]));
    name_cursor = name_cursor + 1;
  }
} return string result_text;
given fodt_dump_test_open("<p fo:color=\"#ff0000\" fo:font-size=\"12pt\"/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ("t.", ["fo:color", "fo:font-size", "fo:x"], (import fodt_dump_test_reader)):("|t.fo:color=#ff0000|t.fo:font-size=12pt")
given fodt_dump_test_open("<p/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ("p.", ["fo:color"], (import fodt_dump_test_reader)):("")

// "|name=value", or "" when the value is empty.
fodt_dump_pair(string own, string value_text) {
  string result_text = "";
  if(value_text != "") {
    result_text = "|" + own + "=" + value_text;
  }
} return string result_text;
("a", "b"):("|a=b")
("a", ""):("")
