// The key of a parent style: its family prefix (see ofd_famk) and name, "" when there is none.
fodt_dump_parent_key(string parent_prefix, string parent_name) {
  string result_text = "";
  if(parent_name != "") {
    result_text = parent_prefix + parent_name;
  }
} return string result_text;
