// Sets one property in the bag of entry owi.
fodt_dump_property(Catalog style_store, int entry_index, string own, string value_text) {
  string[] property_lists = style_store.props;
  if(value_text != "") {
    property_lists[entry_index] = fodt_dump_set_property(property_lists[entry_index], own, value_text);
  }
} return void;
