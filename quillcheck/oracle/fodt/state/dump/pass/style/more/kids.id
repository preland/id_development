// Reads a style:style (or the default paragraph style) from its start event through its end: the entry from ofd_style_open, then every properties element inside it. The default style has the key "p:", which no style:style can have since it has a name.
fodt_dump_style_read(Catalog style_store, XmlR document_reader, int reader_event, string font_family, int automatic_styles) {
  int element_depth = xml_reader_depth(document_reader);
  int entry_index = fodt_dump_style_open(style_store, document_reader, font_family, automatic_styles);
  int owe = 0;
} chain (Catalog style_store, XmlR document_reader, int reader_event, string font_family, int automatic_styles) {
  if(entry_index >= 0 && reader_event == 1) {
    owe = xml_reader_next(document_reader);
  }
  int reading_more = xml_reader_inside(document_reader, owe, element_depth);
  while(reading_more == 1) {
    fodt_dump_style_part(style_store, document_reader, entry_index);
    owe = xml_reader_next(document_reader);
    reading_more = xml_reader_inside(document_reader, owe, element_depth);
  }
} return void;
