// Appends the property pairs of a text-properties or paragraph-properties element the reader is at to the bag of entry owi; any other element adds nothing.
fodt_dump_style_part(Catalog style_store, XmlR document_reader, int entry_index) {
  string element_name = xml_reader_get(document_reader, (import xml_reader_k_name));
  string[] property_lists = style_store.props;
  if(element_name == "style:text-properties") {
    property_lists[entry_index] = property_lists[entry_index] + fodt_dump_attributes("t.", (import ow_tattr), document_reader);
  }
} chain (Catalog style_store, XmlR document_reader, int entry_index) {
  if(element_name == "style:paragraph-properties") {
    property_lists[entry_index] = property_lists[entry_index] + fodt_dump_attributes("p.", (import ow_pattr), document_reader);
  }
} return void;
