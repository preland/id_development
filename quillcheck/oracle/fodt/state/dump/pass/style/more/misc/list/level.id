// The number the dump gives a style:num-format value (see ow_numfmts); decimal for any other.
fodt_dump_number_format(string value_text) {
  int format_index = list_string_index((import ow_numfmts), value_text);
  if(format_index < 0) {
    format_index = 0;
  }
} return int format_index;
("a"):(1)
("I"):(4)
(""):(0)


// The level, 1 to 3, of a style:list-level-style-* element the reader is at, 0 for a level the dump does not follow.
fodt_dump_level_number(XmlR document_reader) {
  int owl = to_int(xml_reader_attribute(document_reader, "text:level"));
  if(owl < 1 || owl > 3) {
    owl = 0;
  }
} return int owl;
given fodt_dump_test_open("<a text:level=\"2\"/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ((import fodt_dump_test_reader)):(2)
given fodt_dump_test_open("<a text:level=\"4\"/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ((import fodt_dump_test_reader)):(0)
given fodt_dump_test_open("<a/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ((import fodt_dump_test_reader)):(0)


// The start value of a numbered level as text: its text:start-value, 1 when it has none.
fodt_dump_start_value(XmlR document_reader) {
  string value_text = xml_reader_attribute(document_reader, "text:start-value");
  if(value_text == "") {
    value_text = "1";
  }
} return string value_text;
given fodt_dump_test_open("<a text:start-value=\"5\"/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ((import fodt_dump_test_reader)):("5")
given fodt_dump_test_open("<a/>") given xml_reader_skip((import fodt_dump_test_reader), 1) ((import fodt_dump_test_reader)):("1")
