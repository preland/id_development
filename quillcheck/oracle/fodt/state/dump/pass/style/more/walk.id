// Reads every style, face, list style, page layout and master page up to the document body into the store; the reader is left at the body's start.
fodt_dump_styles(Catalog style_store, XmlR document_reader) {
  int reader_event = xml_reader_next(document_reader);
  int automatic_styles = 0;
  while(reader_event > 0 && automatic_styles >= 0) {
    automatic_styles = fodt_dump_style_event(style_store, document_reader, reader_event, automatic_styles);
    if(automatic_styles >= 0) {
      reader_event = xml_reader_next(document_reader);
    }
  }
} return void;
