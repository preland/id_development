// What one event of a fodt document's style sections adds to the store: a font face, a style (automatic when owauto is 1, which is inside office:automatic-styles), the default paragraph style, a list style, a page layout with its properties, or a master page. Answers the new owauto: 1 or 0, and -1 once the body begins.
fodt_dump_style_event(Catalog style_store, XmlR document_reader, int reader_event, int automatic_styles) {
  string element_name = xml_reader_get(document_reader, (import xml_reader_k_name));
  int next_automatic = automatic_styles;
  if(element_name == "style:font-face" && reader_event != 2) {
    fodt_dump_font_face(style_store, document_reader);
  }
} chain (Catalog style_store, XmlR document_reader, int reader_event, int automatic_styles) {
  if(element_name == "style:style" && reader_event != 2) {
    fodt_dump_style_read(style_store, document_reader, reader_event, xml_reader_attribute(document_reader, "style:family"), automatic_styles);
  }
  if(element_name == "style:default-style" && reader_event != 2 && xml_reader_attribute(document_reader, "style:family") == "paragraph") {
    fodt_dump_style_read(style_store, document_reader, reader_event, "paragraph", 0);
  }
  if(element_name == "text:list-style" && reader_event != 2) {
    fodt_dump_list_style_read(style_store, document_reader, reader_event);
  }
} chain (Catalog style_store, XmlR document_reader, int reader_event, int automatic_styles) {
  if(element_name == "style:page-layout" && reader_event != 2) {
    fodt_dump_layout(style_store, document_reader);
  }
  if(element_name == "style:page-layout-properties" && reader_event != 2) {
    fodt_dump_layout_properties(style_store, document_reader);
  }
  if(element_name == "style:master-page" && reader_event != 2) {
    fodt_dump_master_page(style_store, document_reader);
  }
} chain (Catalog style_store, XmlR document_reader, int reader_event, int automatic_styles) {
  if(element_name == "office:automatic-styles") {
    next_automatic = reader_event == 1;
  }
  if(element_name == "office:body") {
    next_automatic = 0 - 1;
  }
} return int next_automatic;
