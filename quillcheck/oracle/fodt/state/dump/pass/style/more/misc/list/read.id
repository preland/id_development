// Reads a list style from its start event through its end into the store: its entry, then every level element and the label alignment or properties inside them.
fodt_dump_list_style_read(Catalog style_store, XmlR document_reader, int reader_event) {
  int element_depth_list = xml_reader_depth(document_reader);
  fodt_dump_list_style_open(style_store, document_reader);
  int entry_index = len(style_store.keys) - 1;
} chain (Catalog style_store, XmlR document_reader, int reader_event) {
  int owe = 0;
  int current_level = 0;
  if(reader_event == 1) {
    owe = xml_reader_next(document_reader);
  }
} chain (Catalog style_store, XmlR document_reader, int reader_event) {
  int reading_more = xml_reader_inside(document_reader, owe, element_depth_list);
  while(reading_more == 1) {
    current_level = fodt_dump_level_event(style_store, entry_index, document_reader, owe, current_level);
    owe = xml_reader_next(document_reader);
    reading_more = xml_reader_inside(document_reader, owe, element_depth_list);
  }
} return void;
