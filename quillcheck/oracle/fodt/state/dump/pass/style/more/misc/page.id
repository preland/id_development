// Adds the page layout the reader is at, keyed "g:" and its name, with no properties yet.
fodt_dump_layout(Catalog style_store, XmlR document_reader) {
  string style_key = "g:" + xml_reader_attribute(document_reader, "style:name");
  fodt_dump_add_entry(style_store, style_key, "", "", "");
} return void;
