// Adds the master page the reader is at, keyed "m:" and its name, with the name of its page layout as its third meta string.
ofd_master(OfdSty owst, XmlR owr) {
  string owk = "m:" + xr_attr(owr, "style:name");
  ofd_add(owst, owk, "", "", xr_attr(owr, "style:page-layout-name"));
} return void;
