// Adds the page layout the reader is at, keyed "g:" and its name, with no properties yet.
ofd_layout(OfdSty owst, XmlR owr) {
  string owk = "g:" + xr_attr(owr, "style:name");
  ofd_add(owst, owk, "", "", "");
} return void;
given ofd_t_open("<style:page-layout style:name=\"Mpm1\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty([], [], []), (import ofd_t_r)):(OfdSty(["g:Mpm1"], [""], ["", "", ""]), (import ofd_t_r))
given ofd_t_open("<style:page-layout/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["x"], ["y"], ["1", "2", "3"]), (import ofd_t_r)):(OfdSty(["x", "g:"], ["y", ""], ["1", "2", "3", "", "", ""]), (import ofd_t_r))

// Reads the page-layout-properties element the reader is at into the bag of the last entry, which is the layout it belongs to.
ofd_gprops(OfdSty owst, XmlR owr) {
  string[] owlp = owst.props;
  int owi = len(owlp) - 1;
  owlp[owi] = owlp[owi] + ofd_attrs("", (import ow_gattr), owr);
} return void;
