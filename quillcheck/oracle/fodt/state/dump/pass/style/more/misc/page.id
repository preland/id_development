// Adds the master page the reader is at, keyed "m:" and its name, with the name of its page layout as its third meta string.
fodt_dump_master_page(Catalog style_store, XmlR document_reader) {
  string style_key = "m:" + xml_reader_attribute(document_reader, "style:name");
  fodt_dump_add_entry(style_store, style_key, "", "", xml_reader_attribute(document_reader, "style:page-layout-name"));
} return void;
