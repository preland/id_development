// Reads the page-layout-properties element the reader is at into the bag of the last entry, which is the layout it belongs to.
fodt_dump_layout_properties(Catalog style_store, XmlR document_reader) {
  string[] property_lists = style_store.props;
  int entry_index = len(property_lists) - 1;
  property_lists[entry_index] = property_lists[entry_index] + fodt_dump_attributes("", (import ow_gattr), document_reader);
} return void;
