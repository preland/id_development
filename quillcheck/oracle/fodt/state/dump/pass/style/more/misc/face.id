// A font family value without the quotes around a name with a space: 'Liberation Sans' is Liberation Sans.
ofd_unq(string owv) {
  string owout = owv;
  int owc = character_code_at(owv, 0);
  if((owc == 39 || owc == 34) && len(owv) >= 2) {
    owout = str_sub(owv, 1, len(owv) - 2);
  }
} return string owout;
("'Liberation Sans'"):("Liberation Sans")
("\"Free Serif\""):("Free Serif")
("FreeSans"):("FreeSans")
("'"):("'")

// Adds the font face the reader is at, keyed "f:" and its declared name, with its family unquoted in the bag.
ofd_face(OfdSty owst, XmlR owr) {
  string owk = "f:" + xr_attr(owr, "style:name");
  string owfam = ofd_unq(xr_attr(owr, "svg:font-family"));
  ofd_add(owst, owk, "", "", "");
} chain (OfdSty owst, XmlR owr) {
  ofd_prop(owst, len(owst.keys) - 1, "fam", owfam);
} return void;
given ofd_t_open("<style:font-face style:name=\"Liberation Serif1\" svg:font-family=\"&apos;Liberation Serif&apos;\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty([], [], []), (import ofd_t_r)):(OfdSty(["f:Liberation Serif1"], ["|fam=Liberation Serif"], ["", "", ""]), (import ofd_t_r))
given ofd_t_open("<style:font-face style:name=\"A\" svg:font-family=\"B\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["x"], ["y"], ["1", "2", "3"]), (import ofd_t_r)):(OfdSty(["x", "f:A"], ["y", "|fam=B"], ["1", "2", "3", "", "", ""]), (import ofd_t_r))
