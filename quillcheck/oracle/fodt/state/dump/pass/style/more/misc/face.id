// A font family value without the quotes around a name with a space: 'Liberation Sans' is Liberation Sans.
fodt_dump_unquote(string value_text) {
  string result_text = value_text;
  int first_character = character_code_at(value_text, 0);
  if((first_character == 39 || first_character == 34) && len(value_text) >= 2) {
    result_text = str_sub(value_text, 1, len(value_text) - 2);
  }
} return string result_text;
("'Liberation Sans'"):("Liberation Sans")
("\"Free Serif\""):("Free Serif")
("FreeSans"):("FreeSans")
("'"):("'")

// Adds the font face the reader is at, keyed "f:" and its declared name, with its family unquoted in the bag.
fodt_dump_font_face(Catalog style_store, XmlR document_reader) {
  string style_key = "f:" + xml_reader_attr(document_reader, "style:name");
  string font_family = fodt_dump_unquote(xml_reader_attr(document_reader, "svg:font-family"));
  fodt_dump_add_entry(style_store, style_key, "", "", "");
} chain (Catalog style_store, XmlR document_reader) {
  fodt_dump_property(style_store, len(style_store.keys) - 1, "fam", font_family);
} return void;
