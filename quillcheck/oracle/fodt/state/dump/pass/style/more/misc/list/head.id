// Records a level's left indent and hanging indent, in twips, from the element the reader is at: a style:list-level-label-alignment (margin-left, and a negative text-indent as the hang) or the older style:list-level-properties (space-before plus min-label-width, and the width as the hang).
fodt_dump_level_child(Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  string element_name = xml_reader_get(document_reader, (import xml_reader_k_name));
  int margin_length = fodt_dump_length(xml_reader_attr(document_reader, "fo:margin-left"));
  int indent_length = fodt_dump_length(xml_reader_attr(document_reader, "fo:text-indent"));
} chain (Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  if(element_name == "style:list-level-label-alignment" && margin_length != (import ow_bad)) {
    fodt_dump_property(style_store, entry_index, owl + ".l", "" + margin_length);
  }
  if(element_name == "style:list-level-label-alignment" && indent_length != (import ow_bad)) {
    fodt_dump_property(style_store, entry_index, owl + ".h", "" + fixed_point_maximum(0 - indent_length, 0));
  }
  if(element_name == "style:list-level-properties" && xml_reader_attr(document_reader, "text:min-label-width") != "") {
    fodt_dump_legacy_indents(style_store, entry_index, document_reader, owl);
  }
} return void;
