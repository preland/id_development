// Records, in the bag of list entry owi, what the level element the reader is at says: its kind (b bullet, n number), its bullet code point or number format, and its start value.
ofd_lvl_head(OfdSty owst, int owi, XmlR owr, int owl) {
  string owkind = "b";
  string owbul = xr_attr(owr, "text:bullet-char");
  int owfmt = 8226;
} chain (OfdSty owst, int owi, XmlR owr, int owl) {
  if(owbul != "") {
    owfmt = utf8_code_point(owbul, 0);
  }
  if(xr_get(owr, (import xr_k_name)) == "text:list-level-style-number") {
    owkind = "n";
    owfmt = ofd_numf(xr_attr(owr, "style:num-format"));
  }
  ofd_prop(owst, owi, owl + ".k", owkind);
} chain (OfdSty owst, int owi, XmlR owr, int owl) {
  ofd_prop(owst, owi, owl + ".f", "" + owfmt);
  ofd_prop(owst, owi, owl + ".s", ofd_start(owr));
} return void;
given ofd_t_open("<text:list-level-style-number text:level=\"1\" style:num-format=\"a\" text:start-value=\"3\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 1):(OfdSty(["l:L"], ["|1.k=n|1.f=1|1.s=3"], ["", "", ""]), 0, (import ofd_t_r), 1)
given ofd_t_open("<text:list-level-style-bullet text:level=\"2\" text:bullet-char=\"-\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 2):(OfdSty(["l:L"], ["|2.k=b|2.f=45|2.s=1"], ["", "", ""]), 0, (import ofd_t_r), 2)

// Records a level's left indent and hanging indent, in twips, from the element the reader is at: a style:list-level-label-alignment (margin-left, and a negative text-indent as the hang) or the older style:list-level-properties (space-before plus min-label-width, and the width as the hang).
ofd_lvl_kid(OfdSty owst, int owi, XmlR owr, int owl) {
  string owname = xr_get(owr, (import xr_k_name));
  int owmar = ofd_tw(xr_attr(owr, "fo:margin-left"));
  int owind = ofd_tw(xr_attr(owr, "fo:text-indent"));
} chain (OfdSty owst, int owi, XmlR owr, int owl) {
  if(owname == "style:list-level-label-alignment" && owmar != (import ow_bad)) {
    ofd_prop(owst, owi, owl + ".l", "" + owmar);
  }
  if(owname == "style:list-level-label-alignment" && owind != (import ow_bad)) {
    ofd_prop(owst, owi, owl + ".h", "" + fixed_point_maximum(0 - owind, 0));
  }
  if(owname == "style:list-level-properties" && xr_attr(owr, "text:min-label-width") != "") {
    ofd_legacy(owst, owi, owr, owl);
  }
} return void;
given ofd_t_open("<style:list-level-label-alignment fo:margin-left=\"0.5in\" fo:text-indent=\"-0.25in\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 1):(OfdSty(["l:L"], ["|1.l=720|1.h=360"], ["", "", ""]), 0, (import ofd_t_r), 1)
given ofd_t_open("<style:list-level-properties text:space-before=\"0.25in\" text:min-label-width=\"0.25in\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 2):(OfdSty(["l:L"], ["|2.h=360|2.l=720"], ["", "", ""]), 0, (import ofd_t_r), 2)
given ofd_t_open("<other fo:margin-left=\"0.5in\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 1):(OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 1)

// Records a level's indents from the older spelling: the label starts text:space-before from the margin and is text:min-label-width wide, so the text starts at their sum and the label hangs by the width.
ofd_legacy(OfdSty owst, int owi, XmlR owr, int owl) {
  int owsp = ofd_tw(xr_attr(owr, "text:space-before"));
  int owmw = ofd_tw(xr_attr(owr, "text:min-label-width"));
  ofd_prop(owst, owi, owl + ".h", "" + owmw);
} chain (OfdSty owst, int owi, XmlR owr, int owl) {
  if(owsp != (import ow_bad)) {
    ofd_prop(owst, owi, owl + ".l", "" + (owsp + owmw));
  }
} return void;
given ofd_t_open("<a text:space-before=\"0.25in\" text:min-label-width=\"0.5in\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 3):(OfdSty(["l:L"], ["|3.h=720|3.l=1080"], ["", "", ""]), 0, (import ofd_t_r), 3)
given ofd_t_open("<a text:min-label-width=\"0.5in\"/>") given xr_skip((import ofd_t_r), 1) (OfdSty(["l:L"], [""], ["", "", ""]), 0, (import ofd_t_r), 1):(OfdSty(["l:L"], ["|1.h=720"], ["", "", ""]), 0, (import ofd_t_r), 1)
