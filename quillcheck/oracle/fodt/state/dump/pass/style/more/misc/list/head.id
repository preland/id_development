// Records, in the bag of list entry owi, what the level element the reader is at says: its kind (b bullet, n number), its bullet code point or number format, and its start value.
fodt_dump_level_head(Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  string level_kind = "b";
  string bullet_text = xml_reader_attr(document_reader, "text:bullet-char");
  int format_code = 8226;
} chain (Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  if(bullet_text != "") {
    format_code = utf8_code_point(bullet_text, 0);
  }
  if(xml_reader_get(document_reader, (import xml_reader_k_name)) == "text:list-level-style-number") {
    level_kind = "n";
    format_code = fodt_dump_number_format(xml_reader_attr(document_reader, "style:num-format"));
  }
  fodt_dump_property(style_store, entry_index, owl + ".k", level_kind);
} chain (Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  fodt_dump_property(style_store, entry_index, owl + ".f", "" + format_code);
  fodt_dump_property(style_store, entry_index, owl + ".s", fodt_dump_start_value(document_reader));
} return void;
