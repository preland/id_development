// Records a level's indents from the older spelling: the label starts text:space-before from the margin and is text:min-label-width wide, so the text starts at their sum and the label hangs by the width.
fodt_dump_legacy_indents(Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  int space_before = fodt_dump_length(xml_reader_attr(document_reader, "text:space-before"));
  int label_width = fodt_dump_length(xml_reader_attr(document_reader, "text:min-label-width"));
  fodt_dump_property(style_store, entry_index, owl + ".h", "" + label_width);
} chain (Catalog style_store, int entry_index, XmlR document_reader, int owl) {
  if(space_before != (import ow_bad)) {
    fodt_dump_property(style_store, entry_index, owl + ".l", "" + (space_before + label_width));
  }
} return void;
