// The list style a paragraph sits in: inside a text:list the outermost list's style name, outside one the list style its paragraph style gives; "" for none.
fodt_dump_paragraph_list(Catalog style_store, Accumulator accumulator) {
  string list_style = fodt_dump_walk(style_store, accumulator.slot_strings[0], bind(fodt_dump_meta_slot, 1));
  if(accumulator.walk_state[1] > 0) {
    list_style = accumulator.slot_strings[1];
  }
} return string list_style;
