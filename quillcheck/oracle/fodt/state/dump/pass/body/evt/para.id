// Empties a list of strings.
fodt_dump_clear(string[] emptied_list) {
  while(len(emptied_list) > 0) {
    pop(emptied_list);
  }
} return void;
(["a", "b"]):([])
(["z"]):([])
([]):([])

// Starts a paragraph or heading: its style key, no runs yet, no span styles, and, for the first paragraph, its style key kept for finding the page.
fodt_dump_paragraph_start(Accumulator accumulator, XmlR document_reader, string[] span_styles) {
  string[] string_slots = accumulator.slot_strings;
  string_slots[0] = "p:" + xml_reader_attr(document_reader, "text:style-name");
  fodt_dump_clear(accumulator.segment_strings);
} chain (Accumulator accumulator, XmlR document_reader, string[] span_styles) {
  fodt_dump_clear(span_styles);
  accumulator.walk_state[2] = 1;
  if(accumulator.walk_state[3] == 0) {
    string_slots[4] = string_slots[0];
  }
} return void;
