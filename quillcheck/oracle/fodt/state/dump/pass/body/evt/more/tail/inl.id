// An inline object (a drawing frame, an image): one private-use character in the paragraph's text, and its subtree is skipped.
ofd_frame(OfdSty owst, OfdAcc owacc, XmlR owr, int owev, string[] owspans) {
  if(owacc.st[2] == 1) {
    ofd_text(owst, owacc, owspans, utf8_string(57344));
  }
  ofd_skip_start(owacc, owr, owev);
} return void;
