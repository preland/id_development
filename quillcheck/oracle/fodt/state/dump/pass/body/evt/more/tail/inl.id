// A text:s, text:tab or text:line-break as text: text:c spaces (one without it), a tab, a line feed.
ofd_special(OfdSty owst, OfdAcc owacc, XmlR owr, string[] owspans) {
  string owname = xr_get(owr, (import xr_k_name));
  string owtext = "\t";
  int owc = to_int(xr_attr(owr, "text:c"));
} chain (OfdSty owst, OfdAcc owacc, XmlR owr, string[] owspans) {
  if(owname == "text:s") {
    owtext = str_repeat(" ", fixed_point_maximum(owc, 1));
  }
  if(owname == "text:line-break") {
    owtext = "\n";
  }
  ofd_text(owst, owacc, owspans, owtext);
} return void;
