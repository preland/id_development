// A text:s, text:tab or text:line-break as text: text:c spaces (one without it), a tab, a line feed.
fodt_dump_special(Catalog style_store, Accumulator accumulator, XmlR document_reader, string[] span_styles) {
  string element_name = xml_reader_get(document_reader, (import xml_reader_k_name));
  string run_text = "\t";
  int space_count = to_int(xml_reader_attr(document_reader, "text:c"));
} chain (Catalog style_store, Accumulator accumulator, XmlR document_reader, string[] span_styles) {
  if(element_name == "text:s") {
    run_text = str_repeat(" ", fixed_point_maximum(space_count, 1));
  }
  if(element_name == "text:line-break") {
    run_text = "\n";
  }
  fodt_dump_add_text(style_store, accumulator, span_styles, run_text);
} return void;
