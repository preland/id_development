// An inline object (a drawing frame, an image): one private-use character in the paragraph's text, and its subtree is skipped.
fodt_dump_frame(Catalog style_store, Accumulator accumulator, XmlR document_reader, int reader_event, string[] span_styles) {
  if(accumulator.walk_state[2] == 1) {
    fodt_dump_add_text(style_store, accumulator, span_styles, utf8_string(57344));
  }
  fodt_dump_skip_start(accumulator, document_reader, reader_event);
} return void;
