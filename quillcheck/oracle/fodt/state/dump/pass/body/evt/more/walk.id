// A text:list's effect on the nesting: the depth goes up when it starts and down when it ends, and the outermost one's style name is kept while it is open.
fodt_dump_list(Accumulator accumulator, XmlR document_reader, int reader_event) {
  string[] string_slots = accumulator.slot_strings;
  if(reader_event == 1) {
    accumulator.walk_state[1] = accumulator.walk_state[1] + 1;
  }
  if(reader_event == 1 && accumulator.walk_state[1] == 1) {
    string_slots[1] = xml_reader_attribute(document_reader, "text:style-name");
  }
} chain (Accumulator accumulator, XmlR document_reader, int reader_event) {
  if(reader_event == 2) {
    accumulator.walk_state[1] = accumulator.walk_state[1] - 1;
  }
} return void;
