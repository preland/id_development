// A paragraph or heading event: its start (or an empty one) begins the paragraph, its end (or an empty one) finishes it.
fodt_dump_paragraph_event(Catalog style_store, Accumulator accumulator, XmlR document_reader, int reader_event, string[] span_styles) {
  if(reader_event == 1 || reader_event == 4) {
    fodt_dump_paragraph_start(accumulator, document_reader, span_styles);
  }
  if(reader_event == 2 || reader_event == 4) {
    fodt_dump_paragraph_end(style_store, accumulator);
  }
} return void;
