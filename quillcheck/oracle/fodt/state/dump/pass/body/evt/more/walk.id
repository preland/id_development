// What one event of the document body does, outside any skipped subtree: text goes into the paragraph it is in, a paragraph or heading starts or ends one, a span or a link or a list changes what the text is in, a space, tab, line break or frame adds its character, and a table outside a paragraph becomes an opaque block.
fodt_dump_live_event(Catalog style_store, XmlR document_reader, int reader_event, Accumulator accumulator, string[] span_styles) {
  string element_name = xml_reader_get(document_reader, (import xml_reader_k_name));
  if(reader_event == 3 && accumulator.walk_state[2] == 1) {
    fodt_dump_add_text(style_store, accumulator, span_styles, xml_reader_text(document_reader));
  }
  if(element_name == "text:p" || element_name == "text:h") {
    fodt_dump_paragraph_event(style_store, accumulator, document_reader, reader_event, span_styles);
  }
} chain (Catalog style_store, XmlR document_reader, int reader_event, Accumulator accumulator, string[] span_styles) {
  if(element_name == "text:span") {
    fodt_dump_span(span_styles, document_reader, reader_event);
  }
  if(element_name == "text:a") {
    fodt_dump_link(accumulator, document_reader, reader_event);
  }
  if(element_name == "text:list") {
    fodt_dump_list(accumulator, document_reader, reader_event);
  }
} chain (Catalog style_store, XmlR document_reader, int reader_event, Accumulator accumulator, string[] span_styles) {
  if((element_name == "text:s" || element_name == "text:tab" || element_name == "text:line-break") && reader_event != 2) {
    fodt_dump_special(style_store, accumulator, document_reader, span_styles);
  }
  if(element_name == "draw:frame" && reader_event != 2) {
    fodt_dump_frame(style_store, accumulator, document_reader, reader_event, span_styles);
  }
  if(string_starts_with(element_name, "table:") == 1 && accumulator.walk_state[2] == 0 && reader_event != 2) {
    fodt_dump_opaque_block(accumulator, document_reader, reader_event);
  }
} return void;
