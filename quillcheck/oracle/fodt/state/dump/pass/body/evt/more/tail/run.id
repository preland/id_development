// Handles one event of the document body: inside a skipped subtree only its end is looked for, anywhere else ofd_live.
ofd_body_one(OfdSty owst, XmlR owr, int owev, OfdAcc owacc, string[] owspans) {
  if(owacc.st[0] >= 0) {
    ofd_skipping(owacc, owr, owev);
  } else {
    ofd_live(owst, owr, owev, owacc, owspans);
  }
} return void;
