// Reads the document body from the reader's position to the end: every event goes through ofd_body_one.
fodt_dump_body(Catalog style_store, XmlR document_reader, Accumulator accumulator) {
  string[] span_styles = [];
  int reader_event = xml_reader_next(document_reader);
  while(reader_event > 0) {
    fodt_dump_body_event(style_store, document_reader, reader_event, accumulator, span_styles);
    reader_event = xml_reader_next(document_reader);
  }
} return void;
