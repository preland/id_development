// Reads the document body from the reader's position to the end: every event goes through ofd_body_one.
ofd_body(OfdSty owst, XmlR owr, OfdAcc owacc) {
  string[] owspans = [];
  int owev = xr_next(owr);
  while(owev > 0) {
    ofd_body_one(owst, owr, owev, owacc, owspans);
    owev = xr_next(owr);
  }
} return void;
