// Handles one event of the document body: inside a skipped subtree only its end is looked for, anywhere else ofd_live.
fodt_dump_body_event(Catalog style_store, XmlR document_reader, int reader_event, Accumulator accumulator, string[] span_styles) {
  if(accumulator.walk_state[0] >= 0) {
    fodt_dump_skipping(accumulator, document_reader, reader_event);
  } else {
    fodt_dump_live_event(style_store, document_reader, reader_event, accumulator, span_styles);
  }
} return void;
