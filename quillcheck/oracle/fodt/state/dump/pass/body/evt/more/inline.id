// Adds text to the current paragraph with the properties its span styles (innermost last) and its paragraph style give it, and the hyperlink it is inside, if any.
fodt_dump_add_text(Catalog style_store, Accumulator accumulator, string[] span_styles, string run_text) {
  string run_signature = fodt_dump_run_signature(style_store, span_styles, accumulator.slot_strings[0], accumulator.slot_strings[2]);
  fodt_dump_segment(accumulator, run_signature, run_text);
} return void;
