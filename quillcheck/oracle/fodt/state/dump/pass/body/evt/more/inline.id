// A text:a's effect on the hyperlink: its target is kept while it is open.
fodt_dump_link(Accumulator accumulator, XmlR document_reader, int reader_event) {
  string[] string_slots = accumulator.slot_strings;
  if(reader_event == 1) {
    string_slots[2] = xml_reader_attribute(document_reader, "xlink:href");
  }
  if(reader_event == 2) {
    string_slots[2] = "";
  }
} return void;
