// A text:span's effect on the stack of span styles: its style key goes on when it starts and comes off when it ends.
fodt_dump_span(string[] span_styles, XmlR document_reader, int reader_event) {
  if(reader_event == 1) {
    push(span_styles, "t:" + xml_reader_attribute(document_reader, "text:style-name"));
  }
  if(reader_event == 2) {
    pop(span_styles);
  }
} return void;
