// Starts skipping the element the reader is at, with everything inside it, unless it is empty and has nothing inside.
fodt_dump_skip_start(Accumulator accumulator, XmlR document_reader, int reader_event) {
  if(reader_event == 1) {
    accumulator.walk_state[0] = xml_reader_depth(document_reader);
  }
} return void;
