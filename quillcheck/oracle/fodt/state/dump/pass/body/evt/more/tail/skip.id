// While skipping a subtree, the end of the element the skip began at ends it: the skip depth goes back to -1.
fodt_dump_skipping(Accumulator accumulator, XmlR document_reader, int reader_event) {
  if(reader_event == 2 && xml_reader_depth(document_reader) == accumulator.walk_state[0]) {
    accumulator.walk_state[0] = 0 - 1;
  }
} return void;
