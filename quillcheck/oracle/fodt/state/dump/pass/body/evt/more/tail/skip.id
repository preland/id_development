// An opaque block, such as a table: one "para N opaque" line, and its subtree is skipped.
fodt_dump_opaque_block(Accumulator accumulator, XmlR document_reader, int reader_event) {
  string[] string_slots = accumulator.slot_strings;
  string_slots[3] = string_slots[3] + "\npara " + accumulator.walk_state[3] + " opaque";
  accumulator.walk_state[3] = accumulator.walk_state[3] + 1;
} chain (Accumulator accumulator, XmlR document_reader, int reader_event) {
  fodt_dump_skip_start(accumulator, document_reader, reader_event);
} return void;
