// The fields of a page layout bag as a dump prints them: "w= h= orient= top= right= bottom= left=", in twips (the orientation 0 portrait, 1 landscape); an absent or unreadable size or margin is A4 with one-inch margins.
fodt_dump_page_fields(string layout_bag) {
  int page_width = fodt_dump_dimension(layout_bag, "fo:page-width", 11906);
  int page_height = fodt_dump_dimension(layout_bag, "fo:page-height", 16838);
  string orientation_text = fodt_dump_value(layout_bag, "style:print-orientation");
} chain (string layout_bag) {
  int is_landscape = page_width > page_height;
  if(orientation_text != "") {
    is_landscape = orientation_text == "landscape";
  }
  string size_fields = "w=" + page_width + " h=" + page_height + " orient=" + is_landscape;
} chain (string layout_bag) {
  string top_right_fields = "top=" + fodt_dump_dimension(layout_bag, "fo:margin-top", 1440) + " right=" + fodt_dump_dimension(layout_bag, "fo:margin-right", 1440);
  string bottom_left_fields = "bottom=" + fodt_dump_dimension(layout_bag, "fo:margin-bottom", 1440) + " left=" + fodt_dump_dimension(layout_bag, "fo:margin-left", 1440);
  string result_text = size_fields + " " + top_right_fields + " " + bottom_left_fields;
} return string result_text;
("|fo:page-width=8.2681in|fo:page-height=11.6929in|style:print-orientation=portrait|fo:margin-top=0.7874in|fo:margin-right=0.7874in|fo:margin-bottom=0.7874in|fo:margin-left=0.7874in"):("w=11906 h=16838 orient=0 top=1134 right=1134 bottom=1134 left=1134")
("|fo:page-width=29.7cm|fo:page-height=21cm"):("w=16838 h=11906 orient=1 top=1440 right=1440 bottom=1440 left=1440")
(""):("w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440")

// A length in a layout bag in twips, owdefault when it is absent or does not read.
fodt_dump_dimension(string layout_bag, string own, int default_length) {
  int length_value = fodt_dump_length(fodt_dump_value(layout_bag, own));
  if(length_value == (import ow_bad)) {
    length_value = default_length;
  }
} return int length_value;
("|fo:margin-left=1in", "fo:margin-left", 5):(1440)
("|fo:margin-left=1in", "fo:margin-top", 5):(5)
("|fo:margin-left=big", "fo:margin-left", 7):(7)

// The normalised dump of a fodt document, as docs/QUILL.md 4.9 defines it: the page record (the page layout of the first paragraph's master page), then every paragraph's records, each line ending in a line feed.
fodt_dump_document(string raw_text) {
  int[] document_bytes = exec_bytes(raw_text);
  XmlR document_reader = xml_reader_open(document_bytes);
  Catalog style_store = fodt_dump_store_new();
} chain (string raw_text) {
  fodt_dump_styles(style_store, document_reader);
  Accumulator accumulator = fodt_dump_accumulator_new();
  fodt_dump_body(style_store, document_reader, accumulator);
} chain (string raw_text) {
  string master_page = fodt_dump_walk(style_store, accumulator.slot_strings[4], bind(fodt_dump_meta_slot, 2));
  string page_record = "page " + fodt_dump_page_fields(fodt_dump_page_bag(style_store, master_page));
  string result_text = page_record + accumulator.slot_strings[3] + "\n";
} return string result_text;
("<a><office:body><text:p text:style-name=\"Standard\">hi</text:p></office:body></a>"):("page w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\npara 0 style=\"Normal\" align=- left=- right=- first=- before=- after=- line=- brk=0 level=0 list=-\nrun b=0 i=0 u=0 s=0 sup=0 sub=0 size=- color=- hl=- link=- font=- text=\"hi\"\n")
("<a><style:page-layout style:name=\"L\"><style:page-layout-properties fo:page-width=\"1in\"/></style:page-layout><style:master-page style:name=\"M\" style:page-layout-name=\"L\"/><office:body/></a>"):("page w=1440 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\n")
