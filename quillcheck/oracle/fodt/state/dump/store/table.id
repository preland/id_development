// An empty store.
fodt_dump_store_new() {
  string[] entry_keys = [];
  string[] entry_properties = [];
  string[] meta_strings = [];
} chain () {
  Catalog style_store = Catalog(entry_keys, entry_properties, meta_strings);
} return Catalog style_store;
():(Catalog([], [], []))
given fodt_dump_test_open("<a/>") ():(Catalog([], [], []))

// The entry of a key, -1 when it is not there; a later entry of the same key wins.
fodt_dump_entry_index(Catalog style_store, string style_key) {
  int key_cursor = len(style_store.keys) - 1;
  int found_index = 0 - 1;
  while(key_cursor >= 0 && found_index < 0) {
    if(style_store.keys[key_cursor] == style_key) {
      found_index = key_cursor;
    }
    key_cursor = key_cursor - 1;
  }
} return int found_index;
(Catalog(["a", "b", "a"], ["", "", ""], ["", "", "", "", "", "", "", "", ""]), "a"):(2)
(Catalog(["a"], [""], ["", "", ""]), "z"):(-1)

// Adds an entry with no properties and the three meta strings.
fodt_dump_add_entry(Catalog style_store, string style_key, string parent_name, string list_style, string master_name) {
  push(style_store.keys, style_key);
  push(style_store.props, "");
  list_string_extend(style_store.meta, [parent_name, list_style, master_name]);
} return void;
(Catalog([], [], []), "p:A", "p:B", "L", "M"):(Catalog(["p:A"], [""], ["p:B", "L", "M"]), "p:A", "p:B", "L", "M")
(Catalog(["x"], ["y"], ["1", "2", "3"]), "p:", "", "", ""):(Catalog(["x", "p:"], ["y", ""], ["1", "2", "3", "", "", ""]), "p:", "", "", "")
