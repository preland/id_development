// A size in points as half-points, rounded to the nearest; -1 for a size that is not set.
fodt_dump_half_points(float size_points) {
  int half_points = 0 - 1;
  if(size_points >= 0.0) {
    half_points = size_points * 2.0 + 0.5;
  }
} return int half_points;
