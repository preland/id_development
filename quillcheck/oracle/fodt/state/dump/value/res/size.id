// The size in half-points text has: the first of the spans (innermost, the last of the list, outward) to set one, else the paragraph style's; -1 when none does.
fodt_dump_run_size(Catalog style_store, string[] span_styles, string paragraph_key) {
  float size_points = fodt_dump_points(style_store, paragraph_key, 0);
  int size_span_cursor = len(span_styles) - 1;
  float span_points = 0.0 - 1.0;
} chain (Catalog style_store, string[] span_styles, string paragraph_key) {
  while(size_span_cursor >= 0 && span_points < 0.0) {
    span_points = fodt_dump_points(style_store, span_styles[size_span_cursor], 0);
    size_span_cursor = size_span_cursor - 1;
  }
  if(span_points >= 0.0) {
    size_points = span_points;
  }
  int half_points = fodt_dump_half_points(size_points);
} return int half_points;
