// The size in points a style gives text: its own font-size (a percentage is taken of what the style it inherits from gives, 12 points when that gives none), else what it inherits; -1.0 when nothing in the chain sets one.
fodt_dump_points(Catalog style_store, string style_key, int inherit_depth) {
  string own = fodt_dump_own(style_store, style_key, "t.fo:font-size");
  string parent_key = fodt_dump_parent(style_store, style_key);
  float base_points = 0.0 - 1.0;
} chain (Catalog style_store, string style_key, int inherit_depth) {
  if(parent_key != "" && inherit_depth < 24) {
    base_points = fodt_dump_points(style_store, parent_key, inherit_depth + 1);
  }
  float size_points = base_points;
  int length_value = fodt_dump_length(own);
} chain (Catalog style_store, string style_key, int inherit_depth) {
  float reference_points = 12.0;
  if(base_points >= 0.0) {
    reference_points = base_points;
  }
  if(own != "" && length_value != (import ow_bad)) {
    size_points = length_value / 20.0;
  }
} chain (Catalog style_store, string style_key, int inherit_depth) {
  if(fodt_dump_unit(own) == "%") {
    size_points = reference_points * str_to_float(own) / 100.0;
  }
} return float size_points;
