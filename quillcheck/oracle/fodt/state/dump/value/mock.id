// Test fixture: a reader over a string kept in an export, so a case can `given` it, step it and hand it to the function under test.
ofd_t_open(string owss) {
  int[] owlsrc = exec_bytes(owss);
  export XmlR ofd_t_r = xml_reader_open(owlsrc);
} return void;
("<a/>"):() then ofd_t_name:("")
("<a><b/></a>"):() then ofd_t_name:("")

// Test fixture: the name of the fixture reader's element.
ofd_t_name() {
  XmlR owr = (import ofd_t_r);
  string own = xml_reader_get(owr, (import xml_reader_k_name));
} return string own;
given ofd_t_open("<ab/>") given xml_reader_skip((import ofd_t_r), 1) ():("ab")
given ofd_t_open("<a><b/></a>") given xml_reader_skip((import ofd_t_r), 2) ():("b")
