// The text of a normalised record "kind:text": everything after the first colon, "" for a record without one.
ofodt_text(string rec) {
  int at = str_find(rec, ":");
  string body = "";
  if (at >= 0) {
    body = str_sub(rec, at + 1, len(rec) - at - 1);
  }
} return string body;
("p:hi there"):("hi there")
("table:"):("")
("li2:a:b"):("a:b")
