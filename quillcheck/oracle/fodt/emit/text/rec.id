// The text of a normalised record "kind:text": everything after the first colon, "" for a record without one.
fodt_text(string record_text) {
  int at = string_find(record_text, ":");
  string body = "";
  if (at >= 0) {
    body = str_sub(record_text, at + 1, len(record_text) - at - 1);
  }
} return string body;
("p:hi there"):("hi there")
("table:"):("")
("li2:a:b"):("a:b")
