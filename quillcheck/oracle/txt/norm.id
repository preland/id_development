// LibreOffice's txt export as plain text: its UTF-8 byte-order mark dropped and CRLF line ends made LF.
plain_norm(string raw) {
  int skip = plain_byte_order_mark(raw);
  string body = str_sub(raw, skip, len(raw) - skip);
  string[] parts = string_split(body, "\r\n");
} chain (string raw) {
  string flat = string_join(parts, "\n");
} return string flat;
("﻿abc\ndef\n"):("abc\ndef\n")
("a\r\nb\r\n"):("a\nb\n")
("plain"):("plain")

// 3 when the text starts with the UTF-8 byte-order mark (EF BB BF) that soffice writes first, else 0.
plain_byte_order_mark(string raw) {
  int skip = 0;
  if (character_code_at(raw, 0) == 239 && character_code_at(raw, 1) == 187 && character_code_at(raw, 2) == 191) {
    skip = 3;
  }
} return int skip;
("﻿x"):(3)
("x"):(0)
("é"):(0)

// The normalised text of a txt file soffice wrote; "" when it cannot be read.
plain_norm_file(string path) {
  string raw = fs_read_text(path);
  string flat = plain_norm(raw);
} return string flat;
("../quillcorpus/oracle/out/07_pages.txt"):("A4 portrait, 21 by 29.7 cm, margins 2 cm.\nUS Letter portrait, 8.5 by 11 in, margins 2 cm.\nA4 landscape, 29.7 by 21 cm, margins 2 cm.\n")
("../quillcorpus/oracle/out/none.txt"):("")
