// 1 when a fodt record carries text that the txt export does not contain; records with no text (a table, a frame) never miss.
plain_missing(string record_text, string export_text) {
  string body = fodt_text(record_text);
  int found = str_find(export_text, body);
  int miss = len(body) > 0 && found < 0;
} return int miss;
("p:hello", "say hello\n"):(0)
("p:bye", "say hello\n"):(1)
("table:", "x"):(0)

// How many records of the normalised fodt have text the normalised txt lacks: the two oracle outputs of one fixture agreeing.
plain_cover(string export_content, string norm) {
  string[] records = str_split(norm, "\n");
  int cover_cursor = 0;
  int missing = 0;
} chain (string export_content, string norm) {
  while (cover_cursor < len(records)) {
    missing = missing + plain_missing(records[cover_cursor], export_content);
    cover_cursor = cover_cursor + 1;
  }
} return int missing;
("a b\n", "p:a\nli1:b\n"):(0)
("a\n", "p:a\nh1:zz\nframe:\n"):(1)
("", "p:a\np:b\n"):(2)
