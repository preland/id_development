// A file's bytes, one per cell; an empty list when it cannot be opened.
opdf_load(string path) {
  int h = fs_open(path, "r");
  int n = fs_size(path) * (h >= 0);
  int[] file_content = [];
} chain (string path) {
  list_fill(file_content, n, 0);
  int got = fs_read(h, file_content, n);
  int shut = fs_close(h);
} return int[] file_content;
