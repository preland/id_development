// A file's bytes, one per cell; an empty list when it cannot be opened.
pdf_load(string path) {
  int file_handle = fs_open(path, "r");
  int byte_count = fs_size(path) * (file_handle >= 0);
  int[] file_content = [];
} chain (string path) {
  list_fill(file_content, byte_count, 0);
  int got = fs_read(file_handle, file_content, byte_count);
  int shut = fs_close(file_handle);
} return int[] file_content;
