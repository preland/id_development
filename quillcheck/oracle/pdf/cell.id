// The byte at k, or -1 when k is outside the file.
opdf_byte(int[] b, int k) {
  int v = 0 - 1;
  if (k >= 0 && k < len(b)) {
    v = b[k];
  }
} return int v;
([5, 6], 1):(6)
([5, 6], 2):(-1)
([5, 6], -1):(-1)

// 1 when byte at+i of the file is byte i of the pattern.
opdf_same(int[] b, string pat, int at, int i) {
  int got = opdf_byte(b, at + i);
  int want = charat(pat, i);
  int same = got == want;
} return int same;
([47, 84], "/T", 0, 1):(1)
([47, 84], "/T", 0, 0):(1)
([47, 84], "/T", 1, 1):(0)

// The first index at or after j that is not a space.
opdf_skip(int[] b, int j) {
  while (opdf_byte(b, j) == 32) {
    j = j + 1;
  }
} return int j;
([47, 32, 32, 80], 1):(3)
([47, 80], 0):(0)
