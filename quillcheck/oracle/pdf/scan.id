// 1 when the pattern occurs in the file at index at.
pdf_match(int[] byte_list, string pat, int at) {
  int pattern_cursor = 0;
  int ok = 1;
  while (character_code_at(pat, pattern_cursor) >= 0 && ok == 1) {
    ok = pdf_same(byte_list, pat, at, pattern_cursor);
    pattern_cursor = pattern_cursor + 1;
  }
} return int ok;
([47, 84, 121, 112, 101], "/Type", 0):(1)
([47, 84, 121, 112, 111], "/Type", 0):(0)
([47, 84], "/Type", 0):(0)

// 1 when a page object (a "/Type" entry naming "/Page", spaces allowed between, and not "/Pages" or "/PageLabels") starts at index i.
pdf_is_page(int[] byte_list, int candidate_index) {
  int hit = pdf_match(byte_list, "/Type", candidate_index);
  int page_name_start = pdf_skip(byte_list, candidate_index + 5);
  int page_match = pdf_match(byte_list, "/Page", page_name_start);
} chain (int[] byte_list, int candidate_index) {
  int next_byte = pdf_byte(byte_list, page_name_start + 5);
  int is_page = hit * page_match * (character_is_alpha(next_byte) == 0);
} return int is_page;
([47, 84, 121, 112, 101, 47, 80, 97, 103, 101], 0):(1)
([47, 84, 121, 112, 101, 32, 47, 80, 97, 103, 101, 32], 0):(1)
([47, 84, 121, 112, 101, 47, 80, 97, 103, 101, 115, 47, 67], 0):(0)
([47, 84, 121, 112, 101, 47, 80, 97, 103, 101, 76, 97, 98, 101, 108, 115], 0):(0)

// The number of page objects in a PDF's bytes. LibreOffice writes them uncompressed, one "/Type/Page" per page.
pdf_pages(int[] byte_list) {
  int scan_cursor = 0;
  int pages = 0;
  while (scan_cursor < len(byte_list)) {
    pages = pages + pdf_is_page(byte_list, scan_cursor);
    scan_cursor = scan_cursor + 1;
  }
} return int pages;
([47, 84, 121, 112, 101, 47, 80, 97, 103, 101, 47, 84, 121, 112, 101, 47, 80, 97, 103, 101, 115, 47, 84, 121, 112, 101, 32, 47, 80, 97, 103, 101, 62]):(2)
([]):(0)
