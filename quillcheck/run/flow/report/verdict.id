// The word a lane verdict is printed as; an unavailable lane says why, and so does one that is skipped.
report_verdict(int verdict) {
  string says = "FAIL";
  if (verdict == (import lane_ok)) {
    says = "OK";
  }
  if (verdict == (import lane_unavailable)) {
    says = "UNAVAILABLE(" + (import no_word) + ")";
  }
} chain (int verdict) {
  if (verdict == (import lane_skipped)) {
    says = (import skip_pages);
  }
} return string says;
(1):("OK")
(0):("FAIL")
(2):("UNAVAILABLE(quill binary not available)")
(3):("SKIP(the document model keeps one page layout; this fixture changes it per paragraph)")

// "mode=VERDICT" for one quill-binary lane; vs holds the verdicts of the lanes that have run, [--text, --pages].
report_word_one(string lane_mode, int[] quill_verdicts) {
  int verdict = quill_lane_run(lane_mode, quill_verdicts);
  string says = report_verdict(verdict);
  string part = lane_mode + "=" + says;
} return string part;
("--text", [2, 1]):("--text=UNAVAILABLE(quill binary not available)")
("--text", [1, 2]):("--text=OK")
("--pages", [1, 0]):("--pages=FAIL")
("--dump", [1, 1]):("--dump=UNAVAILABLE(quill binary not available)")
("--bogus", [1, 1]):("--bogus=FAIL")

// The quill-binary lanes, space separated.
report_word_all(string[] modes, int[] quill_verdicts) {
  string[] parts = [];
  int mode_cursor = 0;
  while (mode_cursor < len(modes)) {
    push(parts, report_word_one(modes[mode_cursor], quill_verdicts));
    mode_cursor = mode_cursor + 1;
  }
} chain (string[] modes, int[] quill_verdicts) {
  string line = string_join(parts, " ");
} return string line;
(["--text", "--dump"], [2, 2]):("--text=UNAVAILABLE(quill binary not available) --dump=UNAVAILABLE(quill binary not available)")
(["--text", "--dump"], [0, 2]):("--text=FAIL --dump=UNAVAILABLE(quill binary not available)")
(["--text", "--pages"], [1, 1]):("--text=OK --pages=OK")
(["--bogus"], [1, 1]):("--bogus=FAIL")
