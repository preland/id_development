// The verdict of a --text run: unavailable when the binary does not exist (the shell's 127, or no child at all), equal when it exited 0 and printed exactly the fodt's paragraphs, different otherwise.
quill_lane_compare(int code, string said, string wanted) {
  int verdict = (import lane_fail);
  if (code == 127 || code == 0 - 1) {
    verdict = (import lane_unavailable);
  }
  if (code == 0 && said == wanted) {
    verdict = (import lane_ok);
  }
} return int verdict;
(127, "", "x"):(2)
(0, "a\n", "a\n"):(1)
(0, "a\n", "b\n"):(0)
(1, "a\n", "a\n"):(0)

// The index of the first line two lists of lines differ at, or the length of the shorter one when one is a prefix of the other.
quill_lane_first(string[] gl, string[] wl) {
  int first_difference = 0;
  while (first_difference < len(gl) && first_difference < len(wl) && gl[first_difference] == wl[first_difference]) {
    first_difference = first_difference + 1;
  }
} return int first_difference;
(["a", "b"], ["a", "c"]):(1)
(["a"], ["a", "b"]):(1)
([], ["a"]):(0)

