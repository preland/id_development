// Says on stderr where quill's text and the fodt's first differ, and what to fix.
quill_lane_diff(string said, string wanted, int code) {
  string[] gl = string_split(said, "\n");
  string[] wl = string_split(wanted, "\n");
  int at = quill_lane_first(gl, wl);
} chain (string said, string wanted, int code) {
  string quill_line = line_or(gl, at, "(no such paragraph)");
  string fodt_line = line_or(wl, at, "(no such paragraph)");
  eprint("quillcheck: quill --text (exit " + code + ") differs from the fodt at paragraph " + (at + 1) + ": quill printed '" + quill_line + "', the fodt has '" + fodt_line + "'; fix the ODT reader (quill/io/odt/read/content), or the fodt walker (quillcheck/oracle/fodt) when the fodt is the one that is wrong");
} return void;
("", "a\n", 0):() then eprints:("quillcheck: quill --text (exit 0) differs from the fodt at paragraph 1: quill printed '', the fodt has 'a'; fix the ODT reader (quill/io/odt/read/content), or the fodt walker (quillcheck/oracle/fodt) when the fodt is the one that is wrong\n")
("a\nb\n", "a\nc\n", 3):() then eprints:("quillcheck: quill --text (exit 3) differs from the fodt at paragraph 2: quill printed 'b', the fodt has 'c'; fix the ODT reader (quill/io/odt/read/content), or the fodt walker (quillcheck/oracle/fodt) when the fodt is the one that is wrong\n")
