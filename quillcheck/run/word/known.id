// 1 when the mode is one of the quill binary's CLI modes (docs/QUILL.md 4.9).
wlane_known(string wmode, string[] modes) {
  int i = 0;
  int known = 0;
  while (i < len(modes)) {
    known = known + (modes[i] == wmode);
    i = i + 1;
  }
} return int known;
("--dump", ["--text", "--dump"]):(1)
("--render", ["--text", "--dump"]):(0)

// The verdict of one quill-binary lane. vs holds the verdicts of the lanes that have run, [--text, --pages]; every other known mode has nothing to run yet and is reported unavailable, never as a pass; an unknown mode fails.
wlane_run(string wmode, int[] vs) {
  int code = (import lane_fail);
  if (wlane_known(wmode, (import quill_modes)) == 1) {
    code = (import lane_unavailable);
  }
  if (wmode == (import text_mode)) {
    code = vs[0];
  }
} chain (string wmode, int[] vs) {
  if (wmode == (import pages_mode)) {
    code = vs[1];
  }
} return int code;
("--text", [1, 2]):(1)
("--text", [0, 1]):(0)
("--pages", [1, 0]):(0)
("--pages", [0, 3]):(3)
("--roundtrip", [1, 1]):(2)
("--bogus", [1, 1]):(0)

// How many of the quill-binary lanes have verdict v.
wlane_count(string[] modes, int[] vs, int v) {
  int i = 0;
  int n = 0;
  while (i < len(modes)) {
    n = n + (wlane_run(modes[i], vs) == v);
    i = i + 1;
  }
} return int n;
(["--text", "--dump"], [1, 2], 1):(1)
(["--text", "--dump"], [0, 2], 2):(1)
(["--text", "--pages"], [1, 1], 1):(2)
([], [1, 1], 1):(0)
