// The argument lines, one per line as exec_run takes them, of one soffice conversion: an isolated profile under root, headless, filter filter, output into root's out directory.
office_arguments(string bin, string root, string filter, string source_path) {
  string prof = "-env:UserInstallation=file://" + root + "/" + (import prof_sub);
  string output_directory = root + "/" + (import out_sub);
  string command_lines = bin + "\n" + prof + "\n--headless\n--convert-to\n" + filter + "\n--outdir\n" + output_directory + "\n" + source_path + "\n";
} return string command_lines;
("soffice", "/tmp/r", "txt:Text", "a.odt"):("soffice\n-env:UserInstallation=file:///tmp/r/prof\n--headless\n--convert-to\ntxt:Text\n--outdir\n/tmp/r/out\na.odt\n")
("true", "/x", "pdf", "d/b.odt"):("true\n-env:UserInstallation=file:///x/prof\n--headless\n--convert-to\npdf\n--outdir\n/x/out\nd/b.odt\n")

// Runs a command to its end or to ms milliseconds; its exit status, -2 for one that was killed. A killed soffice wrapper leaves soffice.bin behind, so a timeout also reaps whatever still holds the profile under root.
office_execute(string command_lines, int limit_milliseconds, string root) {
  int[] sin = [];
  int[] output_bytes = [];
  int[] error_bytes = [];
} chain (string command_lines, int limit_milliseconds, string root) {
  int code = exec_run(command_lines, 0, 0, sin, output_bytes, error_bytes, limit_milliseconds);
  if (code == 0 - 2) {
    office_reap(root);
  }
} return int code;
("sh\n-c\nexit 3\n", 5000, "/tmp/quillcheck_none"):(3) then calls office_reap:[0]
("sleep\n30\n", 200, "/tmp/quillcheck_none"):(-2) then calls office_reap:[1]

// Kills (SIGKILL: oosplash survives SIGTERM) every process whose command line names the profile under root; pkill's status, 0 when something was killed and 1 when nothing held it.
office_reap(string root) {
  string command_lines = "pkill\n-9\n-f\n--\nUserInstallation=file://" + root + "/" + (import prof_sub) + "\n";
  int[] sin = [];
  int[] output_bytes = [];
} chain (string root) {
  int[] error_bytes = [];
  int code = exec_run(command_lines, 0, 0, sin, output_bytes, error_bytes, 5000);
} return int code;
given office_test_spawn("sh\n-c\nread x\n-env:UserInstallation=file:///tmp/quillcheck_t_reap/prof\n") ("/tmp/quillcheck_t_reap"):(0) then office_test_gone:(1)
("/tmp/quillcheck_t_nobody"):(1)
