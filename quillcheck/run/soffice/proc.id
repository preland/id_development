// The argument lines, one per line as exec_run takes them, of one soffice conversion: an isolated profile under root, headless, filter filter, output into root's out directory.
soff_argv(string bin, string root, string filter, string src) {
  string prof = "-env:UserInstallation=file://" + root + "/" + (import prof_sub);
  string outd = root + "/" + (import out_sub);
  string cmd = bin + "\n" + prof + "\n--headless\n--convert-to\n" + filter + "\n--outdir\n" + outd + "\n" + src + "\n";
} return string cmd;
("soffice", "/tmp/r", "txt:Text", "a.odt"):("soffice\n-env:UserInstallation=file:///tmp/r/prof\n--headless\n--convert-to\ntxt:Text\n--outdir\n/tmp/r/out\na.odt\n")
("true", "/x", "pdf", "d/b.odt"):("true\n-env:UserInstallation=file:///x/prof\n--headless\n--convert-to\npdf\n--outdir\n/x/out\nd/b.odt\n")

// Runs a command to its end or to ms milliseconds; its exit status, -2 for one that was killed. A killed soffice wrapper leaves soffice.bin behind, so a timeout also reaps whatever still holds the profile under root.
soff_exec(string cmd, int ms, string root) {
  int[] sin = [];
  int[] sout = [];
  int[] serr = [];
} chain (string cmd, int ms, string root) {
  int code = exec_run(cmd, 0, 0, sin, sout, serr, ms);
  if (code == 0 - 2) {
    soff_reap(root);
  }
} return int code;
("sh\n-c\nexit 3\n", 5000, "/tmp/quillcheck_none"):(3) then calls soff_reap:[0]
("sleep\n30\n", 200, "/tmp/quillcheck_none"):(-2) then calls soff_reap:[1]

// Kills (SIGKILL: oosplash survives SIGTERM) every process whose command line names the profile under root; pkill's status, 0 when something was killed and 1 when nothing held it.
soff_reap(string root) {
  string cmd = "pkill\n-9\n-f\n--\nUserInstallation=file://" + root + "/" + (import prof_sub) + "\n";
  int[] sin = [];
  int[] sout = [];
} chain (string root) {
  int[] serr = [];
  int code = exec_run(cmd, 0, 0, sin, sout, serr, 5000);
} return int code;
given soff_t_spawn("sh\n-c\nread x\n-env:UserInstallation=file:///tmp/quillcheck_t_reap/prof\n") ("/tmp/quillcheck_t_reap"):(0) then soff_t_gone:(1)
("/tmp/quillcheck_t_nobody"):(1)
