// Prints the outcome of one fixture's dump comparison and answers the exit status: with no quill binary (owwbin "") the oracle's dump itself and 0; with one, "N STEM dump=OK" and 0 when its "--dump" equals the oracle's, else "N STEM dump=FAIL" and one line per differing field (see ofd_diff) and the failed status.
dump_report(string binary_path, string dump_source, string fixture_stem, int fixture_number, string their_dump) {
  string our_dump = fodt_dump_ours(binary_path, dump_source);
  string report_text = fodt_dump_difference(our_dump, their_dump);
  int exit_status = 0;
} chain (string binary_path, string dump_source, string fixture_stem, int fixture_number, string their_dump) {
  if(binary_path == "") {
    put(their_dump);
  }
  if(binary_path != "" && report_text == "") {
    print("" + fixture_number + " " + fixture_stem + " dump=OK");
  }
  if(binary_path != "" && report_text != "") {
    print("" + fixture_number + " " + fixture_stem + " dump=FAIL\n" + report_text);
    exit_status = (import exit_failed);
  }
} return int exit_status;
("", "x.odt", "07_x", 7, "page w=1\n"):(0) then prints:("page w=1\n")
("echo", "x.odt", "07_x", 7, "--dump x.odt\n"):(0) then prints:("7 07_x dump=OK\n")
("echo", "x.odt", "07_x", 7, "other\n"):(1) then prints:("7 07_x dump=FAIL\np-1: records differ: ours=--dump x.odt theirs=other\n")

// Converts fixture n with soffice into a throwaway root, runs the comparison on it and removes the root; the exit status of dump_report.
dump_run(string office_binary, string binary_path, int fixture_number, string assets_directory) {
  string fixture_stem = fixture_name(assets_directory + "/" + (import odt_sub), fixture_number);
  string work_root = fs_mktemp((import tmp_prefix), 1);
  fs_drop_exit(work_root);
} chain (string office_binary, string binary_path, int fixture_number, string assets_directory) {
  int directory_made = fs_mkdir(work_root + "/" + (import out_sub));
  string dump_source = assets_directory + "/" + (import odt_sub) + "/" + fixture_stem + ".odt";
  int exit_status = lane_office(office_binary, work_root, (import r_fodt), dump_source);
} chain (string office_binary, string binary_path, int fixture_number, string assets_directory) {
  string their_dump = fodt_dump_theirs(work_root, fixture_stem);
  int dump_exit = dump_report(binary_path, dump_source, fixture_stem, fixture_number, their_dump);
  int root_removed = exec_drop(work_root);
} return int dump_exit;
("true", "", 7, "../quillcorpus"):(0) then prints:("page w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\n")
("true", "echo", 7, "../quillcorpus"):(1) then prints:("7 07_pages dump=FAIL\np-1: records differ: ours=--dump ../quillcorpus/odt/07_pages.odt theirs=page w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\n")

// Runs the dump comparison for fixture n of the corpus under assets, or says there is none; exit status 2 for a missing fixture. owwbin "" prints the oracle's dump instead of comparing.
dump_go(string office_binary, string binary_path, int fixture_number, string assets_directory) {
  string fixture_stem = fixture_name(assets_directory + "/" + (import odt_sub), fixture_number);
  int exit_status = (import exit_usage);
  if(fixture_stem != "") {
    exit_status = dump_run(office_binary, binary_path, fixture_number, assets_directory);
  }
} chain (string office_binary, string binary_path, int fixture_number, string assets_directory) {
  if(fixture_stem == "") {
    eprint("quillcheck: no fixture " + fixture_number + " in " + assets_directory + "/" + (import odt_sub) + "; list the fixtures with: quillcheck --list");
  }
} return int exit_status;
("true", "", 99, "../quillcorpus"):(2) then eprints:("quillcheck: no fixture 99 in ../quillcorpus/odt; list the fixtures with: quillcheck --list\n")
("true", "echo", 7, "../quillcorpus"):(1) then prints:("7 07_pages dump=FAIL\np-1: records differ: ours=--dump ../quillcorpus/odt/07_pages.odt theirs=page w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\n")
