// What the quill binary prints for "--dump" of a document: its standard output as text, "" when it cannot be run or prints nothing.
fodt_dump_ours(string binary_path, string dump_source) {
  string dump_command = binary_path + "\n--dump\n" + dump_source + "\n";
  int[] dump_input_bytes = [];
  int[] dump_output_bytes = [];
} chain (string binary_path, string dump_source) {
  int[] dump_error_bytes = [];
  int exit_status = exec_run(dump_command, 0, 0, dump_input_bytes, dump_output_bytes, dump_error_bytes, (import soffice_ms));
  string binary_output = exec_text(dump_output_bytes);
} return string binary_output;
("echo", "x.odt"):("--dump x.odt\n")
("false", "x.odt"):("")

// The dump of the fodt file soffice left for a fixture under root.
fodt_dump_theirs(string work_root, string fixture_stem) {
  string raw_text = fs_read_text(lane_out(work_root, fixture_stem, (import r_fodt)));
  string fodt_dump_text = fodt_dump_document(raw_text);
} return string fodt_dump_text;
