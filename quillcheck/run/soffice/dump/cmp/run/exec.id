// What the quill binary prints for "--dump" of a document: its standard output as text, "" when it cannot be run or prints nothing.
ofd_ours(string owwbin, string owsrc) {
  string owcmd = owwbin + "\n--dump\n" + owsrc + "\n";
  int[] owsin = [];
  int[] owsout = [];
} chain (string owwbin, string owsrc) {
  int[] owserr = [];
  int owcode = exec_run(owcmd, 0, 0, owsin, owsout, owserr, (import soffice_ms));
  string owtext = exec_text(owsout);
} return string owtext;
("echo", "x.odt"):("--dump x.odt\n")
("false", "x.odt"):("")

// The dump of the fodt file soffice left for a fixture under root.
ofd_theirs(string owroot, string owstem) {
  string owraw = fs_read_text(lane_out(owroot, owstem, (import r_fodt)));
  string owtext = ofd_dump(owraw);
} return string owtext;
