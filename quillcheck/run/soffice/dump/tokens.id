// The index after the closing quote of a quoted value whose first character after the opening quote is at owi; a backslash escapes the character after it.
ofd_qend(string owline, int owi) {
  int owe = owi;
  while(charat(owline, owe) >= 0 && charat(owline, owe) != 34) {
    owe = owe + 1 + (charat(owline, owe) == 92);
  }
  int owafter = owe + 1;
} return int owafter;
("\"a\\\"b\" c", 1):(6)
("\"\"", 1):(2)

// Where the value that starts at index owi of a dump line ends: after the closing quote for a quoted value, at the next space otherwise; the index after its last character.
ofd_vend(string owline, int owi) {
  int owe = owi;
  int owq = charat(owline, owi) == 34;
  if(owq == 1) {
    owe = ofd_qend(owline, owi + 1);
  }
} chain (string owline, int owi) {
  if(owq == 0) {
    owe = str_findat(owline, " ", owi);
  }
  if(owq == 0 && owe < 0) {
    owe = len(owline);
  }
} return int owe;
("a=\"x y\" b=2", 2):(7)
("a=1 b=2", 2):(3)
("a=1", 2):(3)

// Where the token that starts at index owi of a dump line ends: a bare word ends at the next space, "key=value" after its value (see ofd_vend).
ofd_tend(string owline, int owi) {
  int owsp = str_findat(owline, " ", owi);
  int owq = str_findat(owline, "=", owi);
  int owe = owsp;
} chain (string owline, int owi) {
  if(owsp < 0) {
    owe = len(owline);
  }
  if(owq >= 0 && (owsp < 0 || owq < owsp)) {
    owe = ofd_vend(owline, owq + 1);
  }
} return int owe;
("para 3 style=\"A B\" x=1", 0):(4)
("style=\"A B\" x=1", 0):(11)
("x=1", 0):(3)
("run", 0):(3)
