// The two ways a new string comes into existence: one byte of it, or two
// existing ones end to end.
//
// Both hand back arena space that nothing will ever reclaim, which is what
// docs/SPEC.md 6 promises and what makes string building in a loop a memory
// cost rather than a bug.

chr(int n) {
  word p = mem_alloc(2);
  st8(p, n);
  st8(p + 1, 0);
} return string w2s(p);

// `copy_bytes` answers with the count it copied, so the address just past each
// half falls out of the copy rather than being computed twice.
concat(string s, string r) {
  word p = mem_alloc(len(s) + len(r) + 1);
  word a = p + copy_bytes(s2w(s), p, len(s));
  st8(a + copy_bytes(s2w(r), a, len(r)), 0);
} return string w2s(p);
