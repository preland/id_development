// A string is a NUL-terminated byte sequence reached through a pointer, which
// is the representation docs/SPEC.md 4 already describes -- and the reason a
// string cannot contain a NUL there is the reason it cannot here.

len(string s) {
  word a = s2w(s);
  int n = 0;
} return int len_scan(a, n);

len_scan(word a, int n) {
  while(ld8(a + n) != 0) {
    n = n + 1;
  }
} return int n;

charat(string s, int i) {
  int c = 0 - 1;
  if(i >= 0 && i < len(s)) {
    c = ld8(s2w(s) + i);
  }
} return int c;
