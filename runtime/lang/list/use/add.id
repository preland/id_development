// Appending, and the growth that makes it always possible.
//
// Capacity doubles, so the copying a long run of pushes does is proportional
// to the list rather than to the square of it. Nothing releases the old cells:
// there is no free (docs/SPEC.md 6), so a list that grows through n doublings
// leaves every earlier array of cells behind it in the arena.

list_push(int[] xs, word v) {
  word p = list_room(l2w(xs));
  st64(ld64(p + 16) + ld64(p) * 8, v);
  st64(p, ld64(p) + 1);
} return void;

list_room(word p) {
  if(ld64(p) >= ld64(p + 8)) {
    list_grow(p, ld64(p + 8) * 2);
  }
} return word p;

list_grow(word p, word z) {
  word a = mem_alloc(z * 8);
  copy_bytes(ld64(p + 16), a, ld64(p) * 8);
  list_wide(p, a, z);
} return void;
