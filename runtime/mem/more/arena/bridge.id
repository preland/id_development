// The two crossings between the flat store and a string.
//
// They are cheap here in a way they are not on a hosted target: there the
// store is a separate array and a string is a C pointer, so both directions
// copy. Here a string *is* an address in the one memory the kernel has, so
// only the direction that has to add a NUL does any work.

copy_bytes(word a, word p, word z) {
  word d = 0;
  while(d < z) {
    st8(p + d, ld8(a + d));
    d = d + 1;
  }
} return word z;

str_of_mem(word a, word z) {
  word p = mem_alloc(z + 1);
  st8(p + copy_bytes(a, p, z), 0);
} return string w2s(p);

mem_of_str(string s) {
} return word s2w(s);
