# todo.idml
# A clean, modern to-do list UI. All state/logic lives in an externally
# registered id -> wasm module; this file only describes the view and
# binds to the exact names of that contract:
#   values   : @remaining  @count  @todos (rows: @item.text/.done/.index)
#   handlers : addTodo  toggleItem
#   model    : ~newtodo
# The card is vertically and horizontally centred by wrapping it in
# Spacers, so it stays a compact panel rather than filling the viewport.
# CardWrap caps the panel's real width via the `app-card-wrap` class
# (idml has no max-width prop). Card/ListWrap/TodoInput/AddBtn/the
# toggles/Line/EmptyState all carry class hooks (see globals.css) for
# shadow, border, scrollbar, focus ring, and hover/strike styles that
# idml's inline style props cannot express.
# The todo rows use Line:Row (a fixed vh height): a Repeat collapses to
# content height, so a % row height would resolve to 0 and rows would
# overlap; a concrete vh gives each row a real height so they scroll.
# Repeat and EmptyState are mutually exclusive on `@hasTodos` (the
# numeric visibility predicate page.tsx exposes for this -- @count and
# @remaining are registered as STRINGS so Text can render "0", and a
# non-empty string is always truthy, so it can't gate a condition).
# EmptyState is `hug-h` so it doesn't have to balance Repeat's height.

Page:Col {}

CardWrap:Col `app-card-wrap` {}

Card:Col `app-card` {
  bg: #ffffff
  radius: 20
  pad: 6
}

ListWrap:Col `app-list` {
  overflow: auto
}

Title:Text {
  size: 1.45vw
  weight: 700
  fg: #0f172a
}

Badge:Row `app-badge` {}

BadgeNum:Text {
  size: 1.05vw
  weight: 700
  fg: #4338ca
}

BadgeLabel:Text {
  size: 0.85vw
  weight: 600
  fg: #818cf8
}

TodoInput:Input `app-input` {
  bg: #f8fafc
  fg: #0f172a
  radius: 12
  size: 0.95vw
}

AddBtn:Button `app-add-btn` {
  bg: #6366f1
  fg: #ffffff
  radius: 12
  weight: 700
  size: 0.95vw
}

ItemText:Text {
  size: 1vw
  weight: 500
  fg: #1e293b
}

ItemTextDone:Text `app-done-text` {
  size: 1vw
  weight: 500
  fg: #cbd5e1
}

ToggleOpen:Button `app-toggle app-toggle-open` {
  bg: #e2e8f0
  radius: 999
}

ToggleDone:Button `app-toggle app-toggle-done` {
  bg: #22c55e
  fg: #ffffff
  weight: 700
  radius: 999
}

Line:Row `app-row` {
  h: 6.2vh
}

EmptyState:Text `app-empty` {
  size: 0.95vw
  weight: 500
  align: center
}

./
Page()[100,100,top-left] {
  Row()[100,100,top-left] {
    Spacer()[100,26,top-left]{}
    CardWrap()[100,48,top-left] {
      Spacer()[18,100,top-left]{}
      Card()[64,100,top-left] {
        Row()[12,100,center-left] {
          Title("id . todo")[100,55,center-left]{}
          Spacer()[100,15,top-left]{}
          Badge()[100,30,center-right,hug-w] {
            BadgeNum(@remaining)[100,50,center]{}
            BadgeLabel(" left")[100,50,center]{}
          }
        }
        Spacer()[3,100,top-left]{}
        Row()[11,100,center-left] {
          TodoInput(~newtodo, "What needs doing?")
            [100,74,center-left]{}
          Spacer()[100,3,top-left]{}
          AddBtn("Add", addTodo)[100,23,center,hug-h]{}
        }
        Spacer()[3,100,top-left]{}
        ListWrap()[71,100,top-left] {
          Repeat(@todos)[100,100,top-left]?@hasTodos {
            Line()[9,100,center-left] {
              ToggleOpen("", toggleItem)
                [100,7,center]?!@item.done{}
              ToggleDone("✓", toggleItem)
                [100,7,center]?@item.done{}
              Spacer()[100,4,top-left]{}
              ItemText(@item.text)
                [100,41,center-left]?!@item.done{}
              ItemTextDone(@item.text)
                [100,41,center-left]?@item.done{}
            }
          }
          EmptyState("Nothing yet - add your first task.")
            [100,100,center,hug-h]?!@hasTodos{}
        }
      }
      Spacer()[18,100,top-left]{}
    }
    Spacer()[100,26,top-left]{}
  }
}
