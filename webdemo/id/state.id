// Todo application STATE, written in id and compiled to WebAssembly.
//
// The whole app's state lives in two append-only lists owned by init():
//   todos    -- the task texts, in the order they were added
//   toggles  -- a log of "toggle" events; each entry is the index of a todo
//               whose done-state was flipped. A todo i is "done" iff i appears
//               an odd number of times in this log (see query.id / done()).
//
// Nothing is ever mutated in place: every change is a push, every read is an
// index or len. That lets a single owner (init) create the lists once while
// every other function touches them through `import` -- staying inside id's
// one-owner-per-global rule and the three-actions-per-block limit, yet still
// giving the UI arbitrary per-item toggling.

init() {
  export string[] todos = [];
  export int[] toggles = [];
} return void;

add(string t) {
  push((import todos), t);
} return void;

toggle(int i) {
  push((import toggles), i);
} return void;
