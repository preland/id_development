// Remaining statement forms.

ps2(int id) {
  string s = "(assign " + s1_of(id) + " " + print_expr(i1_of(id)) + ")";
  if(k_of(id) != "assign") {
    s = ps3(id);
  }
} return string s;

ps3(int id) {
  string s = "(expr " + print_expr(i1_of(id)) + ")";
  if(k_of(id) != "exprstmt") {
    s = ps4(id);
  }
} return string s;

ps4(int id) {
  string s = "(while " + print_expr(i1_of(id)) + " (body" + print_list(l1_of(id)) + "))";
  if(k_of(id) == "if") {
    s = "(if " + print_expr(i1_of(id)) + " (then" + print_list(l1_of(id)) + ") (else" + print_list(l2_of(id)) + "))";
  }
} return string s;
