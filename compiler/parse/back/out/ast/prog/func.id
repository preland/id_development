// Program printer: render each parsed function as a nested S-expression.

print_program() {
  int i = 0;
  while(i < len((import prog))) {
    show_func(i);
    i = i + 1;
  }
} return void;

show_func(int i) {
  print(print_func((import prog)[i]));
} return void;

print_func(int id) {
  string s = "(func " + s1_of(id) + " (params" + print_list(l1_of(id)) + ") " + s2_of(id);
  s = s + " (body" + print_list(l2_of(id)) + ")" + print_ret(id) + ")";
} return string s;
