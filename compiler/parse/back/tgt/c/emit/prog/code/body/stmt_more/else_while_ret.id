// The else arm, while loops, and the return clause.

emit_else(int id, string ind) {
  emit_line(ind + "} else {");
  emit_block(l2_of(id), ind + "    ");
  emit_line(ind + "}");
} return void;

emit_while(int id, string ind) {
  emit_line(ind + "while (" + emit_expr(i1_of(id)) + ") {");
  emit_block(l1_of(id), ind + "    ");
  emit_line(ind + "}");
} return void;

emit_ret(int id) {
  if(i1_of(id) >= 0) {
    emit_line("    return " + emit_expr(i1_of(id)) + ";");
  } else {
    emit_line("    return;");
  }
} return void;
