ll_funcs() {
  int i = 0;
  while(i < len((import irprog))) {
    ll_func((import irprog)[i]);
    i = i + 1;
  }
} return int ll_ends();

ll_ends() {
  emit_line("");
  ll_strs();
} return int ll_entry();

ll_func(int f) {
  emit_line("define " + ll_ty(irf_ret(f)) + " @id_" + irf_name(f) + "(" + ll_pstr(f) + ") {");
  ll_blocks(f);
  emit_line("}");
} return void;
