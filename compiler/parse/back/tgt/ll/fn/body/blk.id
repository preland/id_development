ll_blocks(int f) {
  int i = 0;
  while(i < len(irf_blk(f))) {
    ll_block(irf_blk(f)[i]);
    i = i + 1;
  }
} return void;

ll_insns(int b) {
  int i = 0;
  while(i < len(blk_ins(b))) {
    ll_insn(blk_ins(b)[i]);
    i = i + 1;
  }
} return void;

// A parameter is spelled in the signature and a nop is what a pass left
// behind; neither is a line of the body.
ll_insn(int id) {
  if(ir_op(id) != "nop" && ir_op(id) != "param") {
    emit_line("  " + ll_text(id));
  }
} return void;
