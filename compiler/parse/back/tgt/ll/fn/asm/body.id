ll_asm_par(int r) {
  string s = "";
  int i = 0;
  while(i < len((import afparams)[r])) {
    s = s + ll_sep(i) + ll_ty(s1_of((import afparams)[r][i])) + " %a" + i;
    i = i + 1;
  }
} return string s;

// Volatile with a memory clobber on every block, as in the C target: a wrong
// hand-written clobber list is a miscompile that appears months later, and the
// whole body of an `asm` function is the block, so nothing of the caller's is
// live across it.
ll_asm_body(int r) {
  emit_line("  %r = call " + ll_ty((import afret)[r]) + " asm sideeffect " + chr(34) + ll_asm_text(r) + chr(34) + ", " + chr(34) + ll_asm_cons(r, 0) + chr(34) + "(" + ll_asm_par(r) + ")");
  emit_line("  ret " + ll_ty((import afret)[r]) + " %r");
} return void;

// One `=r` for the result, one `r` per parameter, then the memory clobber.
ll_asm_cons(int r, int i) {
  string s = "=r";
  while(i < len((import afparams)[r])) {
    s = s + ",r";
    i = i + 1;
  }
} return string s + ",~{memory}";
