ll_t5(int id) {
  string s = ll_t6(id);
  if(ir_op(id) == "icmp" || ir_op(id) == "fcmp") {
    s = "%v" + id + " = " + ir_op(id) + " " + ll_pred(ir_s(id), ll_vty(ir_a(id))) + " " + ll_op(ir_a(id)) + ", " + ll_val(ir_b(id));
  } else if(ll_iscast(ir_op(id)) == 1) {
    s = "%v" + id + " = " + ir_op(id) + " " + ll_op(ir_a(id)) + " to " + ll_ty(ir_ty(id));
  }
} return string s;

// `neg` and `not` have no LLVM opcode of their own: negation is a subtraction
// from zero and complement is an exclusive-or with all ones.
ll_t6(int id) {
  string s = "%v" + id + " = " + ir_op(id) + " " + ll_op(ir_a(id)) + ", " + ll_val(ir_b(id));
  if(ir_op(id) == "neg") {
    s = "%v" + id + " = " + ll_negop(ir_ty(id)) + " " + ll_ty(ir_ty(id)) + " " + ll_zero(ir_ty(id)) + ", " + ll_val(ir_a(id));
  } else if(ir_op(id) == "not") {
    s = "%v" + id + " = xor " + ll_op(ir_a(id)) + ", -1";
  }
} return string s;
