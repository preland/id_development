ll_lit(int v) {
  string s = ir_s(v);
  if(ll_isstr(v) == 1) {
    s = "@.str" + v;
  }
} return string s;

// A typed operand: `<ty> <value>`, the form LLVM wants nearly everywhere.
ll_op(int v) {
} return string ll_ty(ll_vty(v)) + " " + ll_val(v);

ll_args(int id) {
  string s = "";
  int i = 0;
  while(i < len(ir_l(id))) {
    s = s + ll_sep(i) + ll_op(ir_l(id)[i]);
    i = i + 1;
  }
} return string s;
