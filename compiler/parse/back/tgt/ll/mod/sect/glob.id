// An exported variable is a module-level global. A constant from conf.id
// carries its value; everything else starts zeroed and is written when its
// declaring function runs.
ll_globals() {
  int i = 0;
  while(i < len((import enames))) {
    emit_line("@" + (import enames)[i] + " = global " + ll_ty((import etypes)[i]) + " " + ll_init(i));
    i = i + 1;
  }
} return void;

ll_init(int i) {
  string s = ll_zero((import etypes)[i]);
  if((import eowners)[i] == "conf.id") {
    s = s1_of(i1_of(const_decl((import enames)[i])));
  }
} return string s;
