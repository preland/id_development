// The module preamble, and the three sections that make up its body.
ll_head(string triple) {
  emit_line("; generated by idc -- the `id` language compiler");
  emit_line("target triple = " + chr(34) + triple + chr(34));
  emit_line("");
} return void;

ll_body() {
  ll_declares();
  ll_globals();
  ll_funcs();
} return void;
