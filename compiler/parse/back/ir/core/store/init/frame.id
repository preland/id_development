// The block and function columns. A block is a straight line of instructions
// ending in a branch or a return; a function is a list of blocks, entry first.
//
//   bfunc   the IR function a block belongs to
//   binsn   its instructions, in order
//   blabel  its label
//   bpred   its predecessors -- computed by a pass, not maintained by hand,
//           because a branch rewrite that forgets to fix them is silent
//
//   fnname  the id function's name
//   fnret   its return type
//   fnpar   its parameters, as `param` instructions
//   fnblk   its blocks, entry first
//   fnnode  the AST node it was lowered from
//   irprog  every IR function, in the order they were lowered

init_ir4() {
  export int[][] binsn = [];
  export string[] blabel = [];
  export int[][] bpred = [];
} return int init_ir5();

init_ir5() {
  export string[] fnname = [];
  export string[] fnret = [];
  export int[][] fnpar = [];
} return int init_ir6();

init_ir6() {
  export int[][] fnblk = [];
  export int[] fnnode = [];
  export int[] irprog = [];
} return int init_lw();
