ir_bl(int id) {
} return int[] (import iblk)[id];

ir_home(int id) {
} return int (import ihome)[id];

// A constant is not an instruction anybody emits: it prints as its literal at
// every use. Asking this is how the printer and the folders tell the two apart.
ir_isconst(int id) {
} return int ir_op(id) == "const";
