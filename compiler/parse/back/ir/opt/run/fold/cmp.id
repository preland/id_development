fold_cmp(int f, int id) {
  if(fold_iszext(ir_a(id)) == 1 && fold_zero(ir_b(id)) == 1) {
    fold_kill(f, id, ir_a(ir_a(id)));
  }
} return void;

fold_iszext(int v) {
  int r = 0;
  if(v >= 0 && ir_op(v) == "zext" && ir_ty(ir_a(v)) == "bool") {
    r = 1;
  }
} return int r;

fold_zero(int v) {
  int r = 0;
  if(v >= 0 && ir_op(v) == "const" && ir_s(v) == "0") {
    r = 1;
  }
} return int r;
