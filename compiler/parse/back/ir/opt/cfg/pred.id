// The predecessors of every block, computed rather than maintained.
//
// A branch rewrite that forgets to fix a predecessor list is silent and the
// bug shows up in a phi three passes later, so no pass edits bpred: this runs
// again whenever the CFG has changed.

op_preds(int f) {
  pred_clear(f, 0);
  pred_scan(f, 0);
} return void;

pred_clear(int f, int i) {
  while(i < len(irf_blk(f))) {
    pred_wipe(blk_pre(irf_blk(f)[i]));
    i = i + 1;
  }
} return void;

pred_scan(int f, int i) {
  while(i < len(irf_blk(f))) {
    pred_of(irf_blk(f)[i]);
    i = i + 1;
  }
} return void;
