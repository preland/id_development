// A phi has to be the first instruction of its block, and a list has no
// insert: push it on the end and walk it forward.
m2r_front(int b, int ph) {
  push(blk_ins(b), ph);
  m2r_shift(blk_ins(b), len(blk_ins(b)) - 1);
  lset((import ihome), ph, b);
} return void;

m2r_shift(int[] l, int i) {
  while(i > 0) {
    m2r_swap(l, i);
    i = i - 1;
  }
} return void;

m2r_swap(int[] l, int i) {
  int v = l[i];
  lset(l, i, l[i - 1]);
  lset(l, i - 1, v);
} return void;
