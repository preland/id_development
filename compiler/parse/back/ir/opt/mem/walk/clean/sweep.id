m2r_sweep(int f, int i, int n) {
  while(i < len(irf_blk(f))) {
    n = m2r_sweep_b(f, irf_blk(f)[i], n);
    i = i + 1;
  }
} return int n;

m2r_sweep_b(int f, int b, int n) {
  int i = 0;
  while(i < len(blk_ins(b))) {
    n = m2r_try(f, blk_ins(b)[i], n);
    i = i + 1;
  }
} return int n;

m2r_try(int f, int id, int n) {
  int v = m2r_same(id);
  if(ir_op(id) == "phi" && v >= 0) {
    n = m2r_drop(f, id, v, n);
  }
} return int n;
