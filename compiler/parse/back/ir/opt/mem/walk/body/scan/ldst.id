m2r_load(int f, int id, int i) {
  int j = m2r_slot(ir_a(id));
  if(j >= 0) {
    m2r_drop(f, id, (import outv)[i][j], 0);
  }
} return void;

m2r_store(int id, int i) {
  int j = m2r_slot(ir_a(id));
  if(j >= 0) {
    m2r_kept(id, i, j);
  }
} return void;

m2r_kept(int id, int i, int j) {
  lset((import outv)[i], j, ir_b(id));
  ir_kill(id);
} return void;
