m2r_incs(int f, int b, int ph, int j) {
  int i = 0;
  while(i < len(blk_pre(b))) {
    i = m2r_inc(f, b, ph, j, i);
  }
} return void;

m2r_inc(int f, int b, int ph, int j, int i) {
  push(ir_l(ph), (import outv)[m2r_pos(f, blk_pre(b)[i])][j]);
  push(ir_bl(ph), blk_pre(b)[i]);
} return int i + 1;

m2r_pos(int f, int b) {
} return int lst_index_of(irf_blk(f), b);
