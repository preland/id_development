m2r_rows(int f, int i) {
  while(i < len(irf_blk(f))) {
    m2r_row();
    i = i + 1;
  }
} return void;

m2r_row() {
  push((import phiof), m2r_blank());
  push((import outv), m2r_blank());
} return void;

m2r_blank() {
  int[] row = [];
  lst_fill(row, len((import pra)), 0 - 1);
} return int[] row;
