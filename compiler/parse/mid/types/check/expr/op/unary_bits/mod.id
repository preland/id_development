// `%` is the odd one: it is an arithmetic operator, so two numbers are the
// shape it expects, and only a float among them is the error. Anything
// non-numeric on either side is a different diagnostic in idc.py ("cannot
// apply '%' to ..."), so both sides being numbers is part of the test rather
// than assumed -- otherwise `"a" % 2` would draw the wrong explanation.

chk_mod(int id) {
  string lt = type_of(i1_of(id));
  string rt = type_of(i2_of(id));
  if(ty_num(lt) == 1 && ty_num(rt) == 1 && (lt == "float" || rt == "float")) {
    tc_err(id, "'%' requires int operands");
  }
} return void;

is_logop(string s) {
  int ok = 0;
  if(s == "&&" || s == "||") {
    ok = 1;
  }
} return int ok;

is_bitop(string s) {
  int ok = 0;
  if(s == "&" || s == "|" || s == "^" || s == "<<" || s == ">>") {
    ok = 1;
  }
} return int ok;
