// type_of for the array/index nodes, extending the dispatch chain
// (type_of4 -> type_of5 -> type_of6). An index has the list's element type;
// an arr has element-type + "[]".

type_of5(int id) {
  string t = type_of6(id);
  if(k_of(id) == "index") {
    t = type_index(id);
  }
} return string t;

type_of6(int id) {
  string t = type_of7(id);
  if(k_of(id) == "arr") {
    t = type_arr(id);
  }
} return string t;

type_index(int id) {
} return string elem_type(type_of(i1_of(id)));
