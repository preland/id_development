// One comparison, and the diagnostic.
//
// The message is idc.py's, word for word, so a program rejected by either
// compiler is rejected with the same explanation -- including where the
// function it collides with was defined, which is the part that makes the
// error actionable.

dup_probe(int i, int j) {
  int found = 0 - 1;
  if((import cfp)[i] == (import cfp)[j]) {
    found = j;
  }
} return int found;

report_dup(int i, int j) {
  note_failure();
  print(loc_at(fname_at(i), func_line(fname_at(i))) + "function '" + fname_at(i) + "' has the same signature and logic as '" + fname_at(j) + "' (defined at " + func_file(fname_at(j)) + ":" + func_line(fname_at(j)) + "); functions must be unique -- remove one and call it from both places, or make them genuinely differ");
} return void;

fname_at(int i) {
} return string s1_of((import prog)[i]);
