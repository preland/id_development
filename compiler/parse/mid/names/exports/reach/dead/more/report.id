// A read of an exported name whose owner is not reachable. Reached only from
// the final sweep, which already established that the reading function is.
chk_import_at(int id) {
  if(find_str((import enames), s1_of(id)) >= 0 && is_reach(export_owner(s1_of(id))) == 0) {
    dead_err(id);
  }
} return void;

dead_err(int id) {
  tc_err(id, "'" + s1_of(id) + "' is exported by '" + export_owner(s1_of(id)) + "', which nothing calls -- an export is initialised when its declaring function runs, so this reads an uninitialised global. Call '" + export_owner(s1_of(id)) + "' from main's setup chain");
} return void;
