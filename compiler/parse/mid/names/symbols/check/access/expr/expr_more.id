// A binary operator and an index both hold two expressions in the same two
// fields, so one walker serves both.
acc_expr3(int id, string owner, int ln) {
  if(k_of(id) == "bin" || k_of(id) == "index") {
    acc_pair(id, owner, ln);
  } else {
    acc_expr4(id, owner, ln);
  }
} return void;

acc_pair(int id, string owner, int ln) {
  acc_expr(i1_of(id), owner, ln);
  acc_expr(i2_of(id), owner, ln);
} return void;

acc_expr4(int id, string owner, int ln) {
  if(k_of(id) == "un") {
    acc_expr(i1_of(id), owner, ln);
  } else {
    acc_expr5(id, owner, ln);
  }
} return void;
