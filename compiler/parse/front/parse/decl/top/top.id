// Top level is a marker the driver injected -- a file boundary or a conf.id
// constant -- or an ordinary declaration.
parse_top(int[] pos) {
  if(cur_kind(pos) == "file") {
    take_file(pos);
  } else if(cur_kind(pos) == "const") {
    take_const(pos);
  } else {
    parse_decl_top(pos);
  }
} return void;

// asm "triple" name(params) { "insn" ... } return TYPE name;
parse_asm(int[] pos) {
  advance(pos);
  push((import aftriple), unquote(cur_text(pos)));
  advance(pos);
} return int asm_sig(pos);

asm_sig(int[] pos) {
  push((import afname), cur_text(pos));
  advance(pos);
  push((import afparams), parse_params(pos));
} return int asm_lines(pos);
