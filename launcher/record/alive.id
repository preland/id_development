// Rows that survive the check that their binary is still there, and rows turned
// back into record text. The text is written with a temporary name and renamed
// over the record so that a build appending at the same moment never sees half a file.

// The rows whose output path is a program that can still be run, in order.
record_keep(string[] record_rows) {
  string[] record_alive = [];
  int record_index = 0;
  while (record_index < len(record_rows)) {
    int record_here = record_present(str_before(record_rows[record_index], "\t"));
    if (record_here == 1) {
      push(record_alive, record_rows[record_index]);
    }
    record_index = record_index + 1;
  }
} return string[] record_alive;
