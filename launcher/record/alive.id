// The record text for rows: one line each, the seconds back as milliseconds.
record_text(string[] record_rows) {
  string record_body = str_join(record_rows, "000\n");
  string record_joined = "";
  if (len(record_rows) > 0) {
    record_joined = record_body + "000\n";
  }
} return string record_joined;
