// Replaces the record file at record_path with the rows (the record's directory is made
// when it is missing): 0 when it was written and renamed into place, else -1.
record_save(string record_path, string[] record_rows) {
  string record_staged = record_path + ".new";
  int record_directory_made = fs_mkdir_p(fs_dir_of(record_path));
  int record_wrote = fs_write_text(record_staged, record_text(record_rows));
} chain (string record_path, string[] record_rows) {
  int record_moved = fs_rename(record_staged, record_path);
} return int record_moved;
