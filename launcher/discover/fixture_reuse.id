// Test fixtures for the forget list and the scan cache against a real scratch program: how many
// forget-list lines name it after discover_test_times more forgets, and whether a cache row with a
// doctored size or mtime is believed.

discover_test_forgotten(int discover_test_times) {
  int discover_test_again = 0;
  while (discover_test_again < discover_test_times) {
    int discover_test_done = discover_forget((import record_test_path), (import discover_test_path));
    discover_test_again = discover_test_again + 1;
  }
  string discover_test_file = discover_beside((import record_test_path), "forgotten.tsv");
} chain (int discover_test_times) {
  string discover_test_body = fs_read_text(discover_test_file);
  string[] discover_test_lines = str_lines(discover_test_body);
  int discover_test_index = 0;
} chain (int discover_test_times) {
  int discover_test_named = 0;
  while (discover_test_index < len(discover_test_lines)) {
    discover_test_named = discover_test_named + (str_before(discover_test_lines[discover_test_index], "\t") == (import discover_test_path));
    discover_test_index = discover_test_index + 1;
  }
} return int discover_test_named;
given record_test_file("") given discover_test_image(100, "/src/a", "\x7fELF", 1) (0):(0)
given record_test_file("") given discover_test_image(100, "/src/a", "\x7fELF", 1) (2):(2)

discover_test_reuse(string discover_test_size_extra, string discover_test_time_extra) {
  string[] discover_test_candidates = discover_candidates([fs_dir_of((import discover_test_path))]);
  string discover_test_row = discover_test_candidates[0];
  string discover_test_cached = str_field(discover_test_row, "\t", 0) + "\t" + str_field(discover_test_row, "\t", 1) + discover_test_size_extra + "\t" + str_field(discover_test_row, "\t", 2) + discover_test_time_extra + "\t/cached";
} chain (string discover_test_size_extra, string discover_test_time_extra) {
  string[] discover_test_resolved = discover_resolve(discover_test_candidates, [discover_test_cached]);
  string discover_test_word = str_field(discover_test_resolved[0], "\t", 3);
} return string discover_test_word;
given discover_test_image(100, "/src/a", "\x7fELF", 1) ("", ""):("/cached")
given discover_test_image(100, "/src/a", "\x7fELF", 1) ("1", ""):("/src/a")
given discover_test_image(100, "/src/a", "\x7fELF", 1) ("", "1"):("/src/a")
