// What the keys that edit the menu's own small state do: digits typed for a jump, Escape,
// and the selection moving.

// Applies a key to the number being typed (menu_words[typed]): a digit adds to it (at most six),
// Backspace removes the last one, and any other key abandons it.
menu_type(string[] menu_words, int menu_key) {
  string menu_before = menu_words[(import menu_at_typed)];
  int menu_digit = (menu_key >= 48 && menu_key <= 57) || menu_key == (import key_backspace);
  string menu_after = "";
} chain (string[] menu_words, int menu_key) {
  if (menu_digit == 1) {
    menu_after = key_edit(menu_before, menu_key);
  }
  if (len(menu_after) > 6) {
    menu_after = menu_before;
  }
  menu_words[(import menu_at_typed)] = menu_after;
} return void;
(["", "12", "", "", ""], 51):(["", "123", "", "", ""], 51)
