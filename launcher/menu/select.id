// menu_value kept inside the list: at least 0 and at most menu_count minus one (0 for an empty list).
menu_clamp(int menu_value, int menu_count) {
  int menu_limit = menu_count - 1;
  int menu_inside = menu_value;
  if (menu_inside > menu_limit) {
    menu_inside = menu_limit;
  }
} chain (int menu_value, int menu_count) {
  if (menu_inside < 0) {
    menu_inside = 0;
  }
} return int menu_inside;
(3, 5):(3)
(9, 5):(4)
(-2, 5):(0)
(0, 0):(0)
(4, 0):(0)

// The row index a typed number names (1 is the first row), kept inside the list; the current
// selection when nothing was typed.
menu_jump(string menu_typed, int menu_count, int menu_selected) {
  int menu_goal = menu_selected;
  if (len(menu_typed) > 0) {
    menu_goal = to_int(menu_typed) - 1;
  }
  int menu_landed = menu_clamp(menu_goal, menu_count);
} return int menu_landed;
