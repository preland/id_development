// Which row is selected, and where a key or typed number moves the selection. The selection is an
// index into the rows as filtered, so everything here takes the filter into account.

// The selected row of the filtered list, or "" when nothing is listed.
menu_row(string[] menu_rows, string[] menu_words, int[] menu_place) {
  string[] menu_shown = filter_rows(menu_rows, menu_words[(import menu_at_filter)]);
  string menu_chosen = lst_str_get_or(menu_shown, menu_place[(import menu_at_selected)], "");
} return string menu_chosen;
