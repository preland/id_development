// `x`: forgets the selected program: its rows leave the list and the record, and the program itself is untouched.
menu_forget(string[] menu_rows, string[] menu_words, int[] menu_place) {
  string menu_chosen = menu_row(menu_rows, menu_words, menu_place);
  string menu_gone = str_before(menu_chosen, "\t");
  string[] menu_left = menu_without(menu_rows, menu_gone);
} chain (string[] menu_rows, string[] menu_words, int[] menu_place) {
  menu_replace(menu_rows, menu_left);
  int menu_saved = record_save(menu_words[(import menu_at_record)], entry_bares(menu_rows));
  menu_place[(import menu_at_selected)] = menu_clamp(menu_place[(import menu_at_selected)], len(menu_rows));
} chain (string[] menu_rows, string[] menu_words, int[] menu_place) {
  int menu_hidden = discover_forget(menu_words[(import menu_at_record)], menu_gone);
} return void;
