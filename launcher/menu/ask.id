// `/`: asks for a filter, starting from the current one; Escape clears it. Selection goes back to the first row.
menu_ask_filter(string[] menu_words, int[] menu_place) {
  string menu_text = menu_prompt("filter: ", menu_words[(import menu_at_filter)]);
  if (menu_text == chr(27)) {
    menu_text = "";
  }
  menu_words[(import menu_at_filter)] = menu_text;
} chain (string[] menu_words, int[] menu_place) {
  menu_place[(import menu_at_selected)] = 0;
} return void;
