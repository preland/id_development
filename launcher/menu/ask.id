// The keys that ask a question first: `a` for arguments, `/` for a filter, `x` to forget.

// `a`: asks for a line of arguments and runs the selected program with them; Escape runs nothing.
menu_ask_args(string[] menu_rows, string[] menu_words, int[] menu_place) {
  string menu_line = menu_prompt("args: ", "");
  if (menu_line != chr(27)) {
    menu_run(menu_rows, menu_words, menu_place, menu_line);
  }
} return void;
