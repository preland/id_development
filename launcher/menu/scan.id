// `r`: reads the record again (the list is not re-read otherwise), keeps the selection inside it and measures the screen.
menu_reload(string[] menu_rows, string[] menu_words, int[] menu_place) {
  string[] menu_fresh = session_rows(menu_words[(import menu_at_record)]);
  menu_replace(menu_rows, menu_fresh);
  menu_place[(import menu_at_selected)] = menu_clamp(menu_place[(import menu_at_selected)], len(menu_rows));
} chain (string[] menu_rows, string[] menu_words, int[] menu_place) {
  menu_words[(import menu_at_status)] = "reloaded: " + len(menu_rows) + " programs";
  menu_measure(menu_place);
} return void;
