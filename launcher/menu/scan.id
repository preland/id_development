// The keys that change what the list contains: `s` adds programs found by walking a directory, `r` reads the record again.

// Scans menu_directory for built programs, merges what it finds into the list and the record, and answers how many it found.
menu_scan_into(string[] menu_rows, string[] menu_words, int[] menu_place, string menu_directory) {
  string[] menu_found = [];
  scan_tree(menu_directory, 0, menu_found);
  string[] menu_merged = menu_merge(menu_rows, menu_found);
} chain (string[] menu_rows, string[] menu_words, int[] menu_place, string menu_directory) {
  menu_replace(menu_rows, menu_merged);
  int menu_saved = record_save(menu_words[(import menu_at_record)], entry_bares(menu_rows));
  menu_words[(import menu_at_status)] = "scan found " + len(menu_found) + " programs";
} chain (string[] menu_rows, string[] menu_words, int[] menu_place, string menu_directory) {
  int menu_count = len(menu_found);
} return int menu_count;
