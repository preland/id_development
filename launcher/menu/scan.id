// `s`: asks for a directory (Escape cancels) and scans it.
menu_scan(string[] menu_rows, string[] menu_words, int[] menu_place) {
  string menu_directory = menu_prompt("scan directory: ", "");
  int menu_count = 0;
  if (menu_directory != chr(27) && len(menu_directory) > 0) {
    menu_count = menu_scan_into(menu_rows, menu_words, menu_place, menu_directory);
  }
} return void;
