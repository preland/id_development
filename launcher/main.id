// `idlaunch`: a terminal menu of every built id program, to see which are fresh and to run one
// in place without a shell. idc records each program it builds (see launch/mode.id for the three
// ways to run this). The clock is read once, here, and handed down; the terminal's signals are
// ignored for the program's whole life so that Ctrl-C, Ctrl-\ and Ctrl-Z reach only the program
// being run. Usage: idlaunch with no arguments, --list, or --run N [ARGUMENT...].

main(int main_count, string[] main_arguments) {
  int main_now = clock_nanoseconds((import clock_real)) / 1000000000;
  int main_kind = launch_mode(main_count, main_arguments);
  int main_guarded = job_guard_all();
} chain (int main_count, string[] main_arguments) {
  int main_code = launch_dispatch(main_kind, main_arguments, main_now);
} return int main_code;
