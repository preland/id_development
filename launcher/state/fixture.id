// Test fixtures for the freshness cases: a scratch tree whose files have chosen
// modification times, made inside the case's own directory (the harness removes
// it). Layout: a.id (500), sub/b.id, .git/c.id, notes.txt (9000, not source).

state_test_file(string state_test_path, int state_test_when) {
  int state_test_made = fs_mkdir_p(fs_dir_of(state_test_path));
  int state_test_put = fs_write_text(state_test_path, "x");
  int state_test_set = fs_set_mtime(state_test_path, state_test_when, 0);
} return void;
("/proc/state_t_none/x.id", 5):()
("/proc/state_t_none/y.id", 6):()

state_test_tree(int state_test_sub, int state_test_git) {
  string state_test_directory = fs_mktemp("state_t_", 1);
  export string state_test_root = state_test_directory;
  state_test_file(state_test_directory + "/a.id", 500);
} chain (int state_test_sub, int state_test_git) {
  string state_test_inner = state_test_directory + "/sub/b.id";
  export string state_test_leaf = state_test_inner;
  state_test_file(state_test_inner, state_test_sub);
} chain (int state_test_sub, int state_test_git) {
  state_test_file(state_test_directory + "/.git/c.id", state_test_git);
  string state_test_note = state_test_directory + "/notes.txt";
  export string state_test_plain = state_test_note;
} chain (int state_test_sub, int state_test_git) {
  state_test_file(state_test_note, 9000);
} return void export state_test_root;
(1, 2):() then state_test_mtime:(1)
(7, 2):() then state_test_mtime:(7)

state_test_mtime() {
  int state_test_seen = fs_mtime((import state_test_leaf));
} return int state_test_seen;
given state_test_tree(3, 4) ():(3)
