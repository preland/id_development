// A row with its freshness appended as a fifth field. Computed once when the list
// is loaded, never while it is drawn: a walk of a large source tree is too slow
// to repeat on every key.

// 1 when the source at state_path (a file, or a directory searched whole) has a
// `.id` file newer than state_built.
state_newer(string state_path, int state_built) {
  int state_is_directory = fs_is_dir(state_path);
  int state_hit = state_file(state_path, state_built);
  if (state_is_directory == 1) {
    state_hit = state_tree(state_path, state_built, 0);
  }
} return int state_hit;
given state_test_tree(2000, 2000) ((import state_test_leaf), 1000):(1)
given state_test_tree(2000, 2000) ((import state_test_root), 1000):(1)
given state_test_tree(2000, 2000) ((import state_test_root), 5000):(0)
("/bin/sh", 0):(0)

// The word for a row: fresh, stale, or ? (see state_label).
state_word(string state_entry) {
  string state_source = string_field_at(state_entry, "\t", 1);
  int state_there = fs_exists(state_source);
  int state_built = entry_seconds(state_entry);
} chain (string state_entry) {
  int state_newer_found = state_newer(state_source, state_built);
  string state_text = state_label(state_source, state_there, state_newer_found);
} return string state_text;
given state_test_tree(2000, 2000) given state_test_rows(1000) ((import state_test_row_file)):("stale")
given state_test_tree(2000, 2000) given state_test_rows(3000) ((import state_test_row_file)):("fresh")
given state_test_tree(2000, 2000) given state_test_rows(1000) ((import state_test_row_directory)):("stale")
("/x\t-\tc\t5"):("?")
("/x\t/no/such/dir\tc\t5"):("?")
("/x\t/bin/sh\tc\t5"):("fresh")

// Every row with "\t" and its state word appended.
state_stamp(string[] state_rows) {
  string[] state_stamped = [];
  int state_index = 0;
  while (state_index < len(state_rows)) {
    push(state_stamped, state_rows[state_index] + "\t" + state_word(state_rows[state_index]));
    state_index = state_index + 1;
  }
} return string[] state_stamped;
