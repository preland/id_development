// Test fixtures that turn the scratch tree of state_t_tree into record rows (a
// file source and a directory source) so a case can hand a path to state_word.

state_t_rows(int state_t_built) {
  string state_t_root_row = "/x\t" + (import state_t_root) + "\tc\t" + state_t_built;
  export string state_t_row_dir = state_t_root_row;
  string state_t_leaf_row = "/x\t" + (import state_t_leaf) + "\tc\t" + state_t_built;
} chain (int state_t_built) {
  export string state_t_row_file = state_t_leaf_row;
} return void export state_t_row_dir;
given state_t_tree(1, 2) (3):() then state_t_tail("\tc\t3"):(1)
given state_t_tree(1, 2) (4):() then state_t_tail("\tc\t3"):(0)

state_t_tail(string state_t_suffix) {
  int state_t_ends = str_ends((import state_t_row_dir), state_t_suffix) * str_ends((import state_t_row_file), state_t_suffix);
} return int state_t_ends;
given state_t_tree(1, 2) given state_t_rows(5) ("\tc\t5"):(1)
given state_t_tree(1, 2) given state_t_rows(5) ("\tc\t6"):(0)
