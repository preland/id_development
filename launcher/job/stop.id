// What the launcher does to a program that is stopped: let it go on, or end it.
// Ending it is never "wait for it to die": TERM first (with CONT, so a stopped program can
// act on it), two seconds' grace, then KILL, and then a wait that cannot block for ever.

// Puts the launcher's line settings back, gives the terminal back to the program's group, continues it and waits for its next change of
// state: its kind (exited 0, killed 1, stopped 2) or -1.
job_resume(int job_pid, int job_group) {
  int job_mode = term_mode_back(0);
  int job_given = term_foreground(0, job_group);
  int job_woken = process_signal_group(job_group, (import sig_n_cont));
} chain (int job_pid, int job_group) {
  int job_seen = process_wait_child(job_pid, (import proc_w_stopped));
  int job_kind = job_event(job_seen);
} return int job_kind;
