// Ends the program: SIGTERM and SIGCONT to its group, up to 2 s for it to go, then SIGKILL.
// Answers the kind of the final wait (killed, 1) or -1 when there was nothing to wait for.
job_terminate(int job_pid, int job_group) {
  int job_termed = process_signal_group(job_group, (import sig_n_term));
  int job_woken = process_signal_group(job_group, (import sig_n_cont));
  int job_reaped = job_poll(job_pid, 40);
} chain (int job_pid, int job_group) {
  if (job_reaped == 0) {
    int job_killed = process_signal_group(job_group, (import sig_n_kill));
    job_reaped = process_wait_child(job_pid, 0) > 0;
  }
  int job_kind = job_event(job_reaped);
} return int job_kind;
