// The words around running a program: its argument lines, and how a signal and a
// duration are spelled in the message that says how it ended.

// The argument lines proc_start wants: the program, then each argument, one per line, newline last.
job_argv(string job_path, string[] job_words) {
  string[] job_all = [job_path];
  list_string_extend(job_all, job_words);
  string job_lines = string_join(job_all, "\n") + "\n";
} return string job_lines;
("/bin/ls", ["-l", "/tmp"]):("/bin/ls\n-l\n/tmp\n")
("/bin/true", []):("/bin/true\n")

// The signal's name in parentheses with a space in front, " (INT)", or "" for a
// number with no name here.
job_signal_label(int job_number) {
  string job_name = list_string_get_or((import job_signal_names), job_number, "");
  string job_label = "";
  if (len(job_name) > 0) {
    job_label = " (" + job_name + ")";
  }
} return string job_label;
(2):(" (INT)")
(15):(" (TERM)")
(9):(" (KILL)")
(0):("")
(99):("")
(-3):("")

// A duration given in tenths of a second as seconds with one decimal: 12 is "1.2".
job_seconds_text(int job_tenths) {
  int job_whole = job_tenths / 10;
  int job_part = job_tenths % 10;
  string job_text = job_whole + "." + job_part;
} return string job_text;
(12):("1.2")
(0):("0.0")
(305):("30.5")
(9):("0.9")
