// Waiting for the program to change state, without ever blocking forever on a
// program that will not die, and reading what the wait found.

// The kind of the last wait (proc_wait_kind) when job_seen says a child changed state, else -1.
job_event(int job_seen) {
  int job_kind = -1;
  if (job_seen > 0) {
    job_kind = process_wait_kind();
  }
} return int job_kind;
