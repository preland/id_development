// Waits up to job_ticks times 50 ms for job_pid to exit, without blocking: 1 when it did (and
// the wait's result can be read), 0 when it is still running, -1 when it is not a child.
job_poll(int job_pid, int job_ticks) {
  int job_seen = process_wait_child(job_pid, (import proc_w_nohang));
  int job_tick = 0;
  while (job_seen == 0 && job_tick < job_ticks) {
    clock_sleep_nanoseconds(50000000);
    job_seen = process_wait_child(job_pid, (import proc_w_nohang));
    job_tick = job_tick + 1;
  }
} chain (int job_pid, int job_ticks) {
  int job_flag = (job_seen > 0) - (job_seen < 0);
} return int job_flag;
