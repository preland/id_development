// Waits for the program job_pid (leader of process group job_group) and answers how it ended: the kind of
// the last wait, exited 0, killed 1. A stop is not the end: it asks the user (job_pause) and goes on
// waiting. job_flags[0] becomes 1 when the user chose to kill the stopped program.
job_watch(int job_pid, int job_group, int[] job_flags) {
  int job_seen = process_wait_child(job_pid, (import proc_w_stopped));
  int job_kind = job_event(job_seen);
  while (job_kind == (import proc_k_stopped)) {
    job_kind = job_pause(job_pid, job_group, job_flags);
  }
} return int job_kind;
