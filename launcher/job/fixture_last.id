// Test fixture: the kind times 256 plus the code of the last wait this process did.

job_test_last() {
  int job_test_kind = process_wait_kind();
  int job_test_code = process_wait_code();
  int job_test_both = job_test_kind * 256 + job_test_code;
} return int job_test_both;
given job_test_start("exit 7") given job_test_wait(0) ():(7)
given job_test_start("kill -9 $$") given job_test_wait(0) ():(265)

