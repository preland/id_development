// The pause after a program in the menu: the result stays on screen until the user presses Enter.

// Prints `Enter returns to the menu`, puts the terminal in key mode and waits for Enter (or for
// input to close).
job_return() {
  put("Enter returns to the menu\n");
  flush();
  int job_mode = term_mode_keys(0);
} chain () {
  int job_key = key_read(-1);
  while (job_key != (import key_enter) && job_key != (import key_closed)) {
    job_key = key_read(-1);
  }
} return void;
stdin "\n" ():() then prints:("Enter returns to the menu\n")
stdin "" ():() then prints:("Enter returns to the menu\n")
