// How big the screen is. The answer is rows times 1000 plus columns (30100 for 30 rows of
// 100 columns), 24 by 80 when the terminal does not answer within a fifth of a second.

// The size in a cursor-position report `ESC [ rows ; columns R` anywhere in screen_reply, or 0
// when there is no complete report.
screen_parse(string screen_reply) {
  string screen_tail = string_after(screen_reply, "\x1b[");
  int screen_rows = to_int(string_before(screen_tail, ";"));
  string screen_rest = string_after(screen_tail, ";");
} chain (string screen_reply) {
  int screen_columns = to_int(string_before(screen_rest, "R"));
  int screen_size = screen_rows * 1000 + screen_columns;
  if (string_find(screen_tail, "R") < 0 || screen_rows < 1 || screen_columns < 1) {
    screen_size = 0;
  }
} return int screen_size;
("\x1b[30;100R"):(30100)
("junk\x1b[24;80R"):(24080)
(""):(0)
("\x1b[30;R"):(0)
("\x1b[30;100"):(0)
("\x1b[0;100R"):(0)

// Asks the terminal where the cursor is after moving it to the far corner, and answers the size.
screen_measure() {
  put("\x1b[999;999H\x1b[6n");
  flush();
  int[] screen_bytes = list_filled(32, 0);
} chain () {
  int screen_got = proc_fd_read(0, screen_bytes, 32, 200);
  int screen_used = screen_got * (screen_got > 0);
  string screen_reply = exec_text(list_slice(screen_bytes, 0, screen_used));
} chain () {
  int screen_found = screen_parse(screen_reply);
  int screen_size = screen_found + 24080 * (screen_found == 0);
} return int screen_size;
stdin "\x1b[30;100R" ():(30100) then prints:("\x1b[999;999H\x1b[6n")
stdin "" ():(24080)
stdin "\x1b[50;200Rmore" ():(50200)
