// One menu row as text: number, name, state, age, source, in fixed columns. The
// columns before the source take 34 bytes; the source gets the rest of the width,
// cut from the left so the end of the path (the part that tells programs apart) stays.

view_line(string view_entry, int view_number, int view_now, string view_base, int view_width, int view_selected) {
  string view_binary = path_base(string_before(view_entry, "\t"));
  string view_label = view_name(view_binary, 18);
  string view_state = view_name(string_field_at(view_entry, "\t", 4), 5);
} chain (string view_entry, int view_number, int view_now, string view_base, int view_width, int view_selected) {
  int view_when = entry_seconds(view_entry);
  string view_old = view_name(view_age(view_now, view_when), 4);
  string view_source = view_source_shown(view_entry, view_base);
} chain (string view_entry, int view_number, int view_now, string view_base, int view_width, int view_selected) {
  string view_place = view_cut(view_source, view_width - 34);
  string view_row = format_integer(view_number, 3) + " " + view_label + " " + view_state + " " + view_old + " " + view_place;
  if (view_selected == 1) {
    view_row = "\x1b[7m" + view_row + "\x1b[0m";
  }
} return string view_row;
("/home/ann/bin/hello\t/home/ann/src/hello\tc\t1000\tfresh", 1, 8300, "/home/ann", 80, 0):("  1 hello              fresh 2h   ~/src/hello")
("/home/ann/bin/hello\t/home/ann/src/hello\tc\t1000\tstale", 12, 1030, "/home/ann", 40, 1):("\x1b[7m 12 hello              stale now  ...llo\x1b[0m")
("/o/a-very-long-program-name\t-\tc\t1000\t?", 3, 87400, "", 80, 0):("  3 a-very-long-progra ?     1d   -")
