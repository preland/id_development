// Putting rows in newest-first order by insertion: the list is a few dozen rows
// and arrives nearly sorted (the record is appended in time order), so an
// insertion sort does about one comparison per row.

// Moves the row at entry_at forward until the row before it is not older.
entry_sink(string[] entry_rows, int entry_at) {
  int entry_position = entry_at;
  int entry_more = entry_newer(entry_rows, entry_position);
  while (entry_more == 1) {
    entry_exchange(entry_rows, entry_position);
    entry_position = entry_position - 1;
    entry_more = entry_newer(entry_rows, entry_position);
  }
} return void;
(["/a\t-\tc\t3", "/b\t-\tc\t2", "/c\t-\tc\t9"], 2):(["/c\t-\tc\t9", "/a\t-\tc\t3", "/b\t-\tc\t2"])
(["/a\t-\tc\t3", "/b\t-\tc\t2"], 1):(["/a\t-\tc\t3", "/b\t-\tc\t2"])

// Sorts the rows in place, newest build first.
entry_order(string[] entry_rows) {
  int entry_index = 1;
  while (entry_index < len(entry_rows)) {
    entry_sink(entry_rows, entry_index);
    entry_index = entry_index + 1;
  }
} return void;
