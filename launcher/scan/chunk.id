// Looking through a file without holding it: a file is read in chunks of
// scan_chunk_size bytes, and the last bytes of each chunk are kept in front of the
// next so a marker that straddles two chunks is still found. A built program is megabytes;
// as a byte list it would be eight times that.

// The next chunk of an open file as a byte list: up to scan_chunk_size bytes, and
// [] at the end of the file or for a handle that is not open.
scan_chunk(int scan_handle) {
  int[] scan_cells = list_filled((import scan_chunk_size), 0);
  int scan_got = fs_read(scan_handle, scan_cells, (import scan_chunk_size));
  int scan_kept = scan_got * (scan_got > 0);
} chain (int scan_handle) {
  while (len(scan_cells) > scan_kept) {
    pop(scan_cells);
  }
} return int[] scan_cells;
