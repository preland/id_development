// 1 when the marker is in scan_window (the first chunk of the file, already read) or
// anywhere in the rest of the file behind the open handle scan_handle.
scan_sweep(int scan_handle, int[] scan_window) {
  int scan_found = scan_find(scan_window, (import scan_marker_text));
  int[] scan_next = scan_chunk(scan_handle);
  int[] scan_current = scan_window;
} chain (int scan_handle, int[] scan_window) {
  while (scan_found == 0 && len(scan_next) > 0) {
    scan_current = scan_merge(scan_current, scan_next);
    scan_found = scan_find(scan_current, (import scan_marker_text));
    scan_next = scan_chunk(scan_handle);
  }
} return int scan_found;
