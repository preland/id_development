// The last scan_marker_text-length-minus-one bytes of scan_window followed by scan_next:
// what the next search looks at.
scan_merge(int[] scan_window, int[] scan_next) {
  int scan_carry = len((import scan_marker_text)) - 1;
  int scan_from = len(scan_window) - scan_carry;
  if (scan_from < 0) {
    scan_from = 0;
  }
} chain (int[] scan_window, int[] scan_next) {
  int[] scan_joined = list_slice(scan_window, scan_from, len(scan_window) - scan_from);
  list_extend(scan_joined, scan_next);
} return int[] scan_joined;
