// 1 when scan_path is an executable regular file of a plausible size (4 bytes to
// scan_size_limit) that scan_read accepts.
scan_file(string scan_path) {
  int scan_size = fs_size(scan_path);
  int scan_fits = (scan_size > 3) * (scan_size <= (import scan_size_limit));
  int scan_runs = fs_can(scan_path, 1) * (1 - fs_is_dir(scan_path));
} chain (string scan_path) {
  int scan_ok = 0;
  if (scan_fits * scan_runs == 1) {
    scan_ok = scan_read(scan_path);
  }
} return int scan_ok;
