// Whether one file on disk is a built `id` program, and the row it becomes.

// 1 when the file at scan_path starts with the ELF magic and holds the runtime marker.
scan_read(string scan_path) {
  int scan_handle = fs_open(scan_path, "r");
  int[] scan_head_cells = scan_chunk(scan_handle);
  int scan_found = 0;
} chain (string scan_path) {
  if (scan_elf(scan_head_cells) == 1) {
    scan_found = scan_sweep(scan_handle, scan_head_cells);
  }
  int scan_closed = fs_close(scan_handle);
} return int scan_found;
