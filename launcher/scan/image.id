// A scratch executable for the scan's cases: scan_test_total bytes of 'A', the text
// scan_test_magic at the front and the marker at scan_test_where (-1 for none), mode 0755.

scan_test_image(int scan_test_total, int scan_test_where, string scan_test_magic) {
  int[] scan_test_bytes = list_filled(scan_test_total, 65);
  string scan_test_place = fs_mktemp("scan_t_", 0);
  export string scan_test_path = scan_test_place;
} chain (int scan_test_total, int scan_test_where, string scan_test_magic) {
  scan_test_plant(scan_test_bytes, scan_test_where, (import scan_marker_text));
  scan_test_plant(scan_test_bytes, 0, scan_test_magic);
  int scan_test_opened = fs_open(scan_test_place, "w");
} chain (int scan_test_total, int scan_test_where, string scan_test_magic) {
  int scan_test_put = fs_write(scan_test_opened, scan_test_bytes, len(scan_test_bytes));
  int scan_test_shut = fs_close(scan_test_opened);
  int scan_test_mode = fs_chmod(scan_test_place, 493);
} return void export scan_test_path;
(100, 20, "\x7fELF"):() then scan_test_found:(1)
(100, -1, "\x7fELF"):() then scan_test_found:(0)

scan_test_found() {
  int scan_test_is = scan_file((import scan_test_path));
} return int scan_test_is;
given scan_test_image(100, 20, "\x7fELF") ():(1)
given scan_test_image(100, 20, "NOPE") ():(0)
