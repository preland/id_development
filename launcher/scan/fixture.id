// Test fixtures for the scan's cases: an open handle on idstd's scratch file, and a
// helper that writes a word into a byte list.

scan_test_open() {
  int scan_test_opened = fs_open((import idstd_fs_fixture_path), "r");
  export int scan_test_handle = scan_test_opened;
} return void export scan_test_handle;
given idstd_fs_fixture_file ([1, 2]) ():() then scan_test_size:(2)
given idstd_fs_fixture_file ([]) ():() then scan_test_size:(0)

scan_test_size() {
  int[] scan_test_read = scan_chunk((import scan_test_handle));
  int scan_test_amount = len(scan_test_read);
} return int scan_test_amount;
given idstd_fs_fixture_file ([1, 2, 3]) given scan_test_open ():(3)
given idstd_fs_fixture_file ([9]) given scan_test_open ():(1)

scan_test_plant(int[] scan_test_cells, int scan_test_at, string scan_test_word) {
  int scan_test_offset = 0;
  while (scan_test_at >= 0 && scan_test_offset < len(scan_test_word)) {
    scan_test_cells[scan_test_at + scan_test_offset] = character_code_at(scan_test_word, scan_test_offset);
    scan_test_offset = scan_test_offset + 1;
  }
} return void;
([65, 65, 65, 65], 1, "xy"):([65, 120, 121, 65], 1, "xy")
([65, 65], -1, "xy"):([65, 65], -1, "xy")
