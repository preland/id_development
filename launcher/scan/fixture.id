// Test fixtures for the scan's cases: an open handle on idstd's scratch file, and a
// helper that writes a word into a byte list.

scan_t_open() {
  int scan_t_h = fs_open((import idstd_fs_t_path), "r");
  export int scan_t_handle = scan_t_h;
} return void export scan_t_handle;
given idstd_fs_t_file ([1, 2]) ():() then scan_t_size:(2)
given idstd_fs_t_file ([]) ():() then scan_t_size:(0)

scan_t_size() {
  int[] scan_t_read = scan_chunk((import scan_t_handle));
  int scan_t_amount = len(scan_t_read);
} return int scan_t_amount;
given idstd_fs_t_file ([1, 2, 3]) given scan_t_open ():(3)
given idstd_fs_t_file ([9]) given scan_t_open ():(1)

scan_t_plant(int[] scan_t_cells, int scan_t_at, string scan_t_word) {
  int scan_t_k = 0;
  while (scan_t_at >= 0 && scan_t_k < len(scan_t_word)) {
    scan_t_cells[scan_t_at + scan_t_k] = character_code_at(scan_t_word, scan_t_k);
    scan_t_k = scan_t_k + 1;
  }
} return void;
([65, 65, 65, 65], 1, "xy"):([65, 120, 121, 65], 1, "xy")
([65, 65], -1, "xy"):([65, 65], -1, "xy")
