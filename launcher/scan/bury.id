// Test fixtures that drive the scan's walk: a scratch program moved into a nested
// directory, and a tally of what scan_visit, scan_files and scan_tree find around it.

scan_test_bury(int scan_test_levels, string scan_test_folder) {
  string scan_test_root_directory = fs_dir_of((import scan_test_path));
  export string scan_test_root = scan_test_root_directory;
  string scan_test_deep = scan_test_root_directory + "/" + scan_test_folder + string_repeat("/n", scan_test_levels);
} chain (int scan_test_levels, string scan_test_folder) {
  int scan_test_made = fs_mkdir_p(scan_test_deep);
  int scan_test_moved = fs_rename((import scan_test_path), scan_test_deep + "/prog");
} return void export scan_test_root;
given scan_test_image(100, 20, "\x7fELF") (1, "n"):() then scan_test_tally(3):(1)
given scan_test_image(100, 20, "\x7fELF") (1, ".git"):() then scan_test_tally(3):(0)

scan_test_tally(int scan_test_mode) {
  string[] scan_test_hits = [];
  string scan_test_directory = fs_dir_of((import scan_test_path));
  string scan_test_name = path_base((import scan_test_path));
} chain (int scan_test_mode) {
  if (scan_test_mode == 1) {
    scan_visit(scan_test_directory, scan_test_name, scan_test_hits);
  }
  if (scan_test_mode == 2) {
    scan_files(scan_test_directory, [scan_test_name, "missing"], scan_test_hits);
  }
  if (scan_test_mode == 3) {
    scan_tree((import scan_test_root), 0, scan_test_hits);
  }
} chain (int scan_test_mode) {
  int scan_test_count = len(scan_test_hits);
} return int scan_test_count;
given scan_test_image(100, 20, "\x7fELF") (1):(1)
given scan_test_image(100, 20, "\x7fELF") (2):(1)
given scan_test_image(100, 20, "NOPE") (2):(0)
given scan_test_image(100, 20, "\x7fELF") given scan_test_bury(2, "n") (3):(1)
given scan_test_image(100, 20, "\x7fELF") given scan_test_bury(4, "n") (3):(1)
given scan_test_image(100, 20, "\x7fELF") given scan_test_bury(5, "n") (3):(0)
