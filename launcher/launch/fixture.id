// Test fixture for the launch cases: a record of the given text in a scratch state directory
// that XDG_STATE_HOME points at, so no case reads or rewrites the real record.

launch_test_state(string launch_test_body) {
  string launch_test_directory = fs_mktemp("launch_t_", 1);
  int launch_test_made = fs_mkdir_p(launch_test_directory + "/id");
  int launch_test_put = fs_write_text(launch_test_directory + "/id/built.tsv", launch_test_body);
} chain (string launch_test_body) {
  discover_test_configuration("/proc/no_root\n");
  environment_put("XDG_STATE_HOME", launch_test_directory);
} return void;
("x"):() then launch_test_size:(1)
("xyz"):() then launch_test_size:(3)

launch_test_size() {
  string launch_test_read = fs_read_text(session_record_path());
  int launch_test_bytes = len(launch_test_read);
} return int launch_test_bytes;
given launch_test_state("abcd") ():(4)
given launch_test_state("") ():(0)
