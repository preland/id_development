// Doing what was asked once the arguments are understood.

// Loads the record and does the mode launch_kind says: the menu (0), the listing (1), running a program (2).
// Answers the exit status.
launch_serve(int launch_kind, string[] launch_words, int launch_now) {
  string launch_record = session_record_path();
  string[] launch_rows = session_rows(launch_record);
  string launch_home = env_text("HOME");
} chain (int launch_kind, string[] launch_words, int launch_now) {
  int launch_code = 0;
  if (launch_kind == 1) {
    put(view_list(launch_rows, launch_now, launch_home));
  }
  if (launch_kind == 2) {
    launch_code = launch_run(launch_rows, launch_words);
  }
} chain (int launch_kind, string[] launch_words, int launch_now) {
  if (launch_kind == 0) {
    launch_code = menu_start(launch_rows, launch_record, launch_home, launch_now);
  }
} return int launch_code;
given launch_t_state("/bin/sh\t-\tc\t5000\n") (1, ["idlaunch", "--list"], 7205):(0) then prints:("1\tsh\t?\t2h\t/bin/sh\t-\n")
given launch_t_state("") (1, ["idlaunch", "--list"], 7205):(0) then prints:("")
given launch_t_state("/bin/sh\t-\tc\t5000\n/no/such/x\t-\tc\t9000\n") (1, ["idlaunch", "--list"], 30):(0) then prints:("1\tsh\t?\tnow\t/bin/sh\t-\n")
given launch_t_state("/bin/sh\t-\tc\t5000\n") (2, ["idlaunch", "--run", "1", "-c", "exit 7"], 0):(7) then prints:("sh exited with status 7 after 0.0 s\n")
given launch_t_state("") (2, ["idlaunch", "--run", "1"], 0):(1) then eprints:("idlaunch: no program 1 in the list (idlaunch --list shows it)\n")
given launch_t_state("") (0, ["idlaunch"], 0):(1) then eprints:("idlaunch: standard input is not a terminal (use --list or --run N)\n")

// The exit status for a command line: the usage text and 2 when the arguments make no sense, else launch_serve's.
launch_dispatch(int launch_kind, string[] launch_words, int launch_now) {
  int launch_code = 2;
  if (launch_kind == 3) {
    eprint((import launch_usage));
  }
  if (launch_kind != 3) {
    launch_code = launch_serve(launch_kind, launch_words, launch_now);
  }
} return int launch_code;
(3, ["idlaunch", "--bogus"], 0):(2) then eprints:("usage: idlaunch              open the menu (needs a terminal)\n       idlaunch --list       print the programs, one per line\n       idlaunch --run N ...  run program N of --list with the arguments after N\n")
given launch_t_state("/bin/sh\t-\tc\t5000\n") (1, ["idlaunch", "--list"], 30):(0) then prints:("1\tsh\t?\tnow\t/bin/sh\t-\n")
