# tiny.idml -- a three-level page for uicheck's cases: a card holding a row of
# a spacer and a text, over a spacer. In a 200x100 window it is easy to check by hand.

Card:Col `c` {}

./
Card()[100,100,top-left] {
  Row()[50,100,top-left] {
    Spacer()[100,25,top-left]{}
    Text("a")[100,75,top-left]{}
  }
  Spacer()[50,100,top-left]{}
}
