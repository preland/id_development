// The rectangle and name of node nd: `x y w h Name`, then ` class` when it has one.
uc_row(int[] t, string[] s, int[] rc, int nd) {
  string nm = gui_node_str(t, s, nd, (import gui_k_name));
  string tl = uc_tail(gui_node_str(t, s, nd, (import gui_k_cls)));
  string out = gui_rect_get(rc, nd, 0) + " " + gui_rect_get(rc, nd, 1) + " " + gui_rect_get(rc, nd, 2) + " " + gui_rect_get(rc, nd, 3) + " " + nm + tl;
} return string out;
given uc_t_tiny ((import uc_tt), (import uc_ts), (import uc_trq), 2):("0 0 200 100 Card c")
given uc_t_tiny ((import uc_tt), (import uc_ts), (import uc_trq), 5):("50 0 150 50 Text")

// A class as it is printed after the name, or nothing.
uc_tail(string cl) {
  string tl = "";
  if (cl != "") {
    tl = " " + cl;
  }
} return string tl;
("c"):(" c")
