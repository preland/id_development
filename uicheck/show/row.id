// The rectangle and name of node node_index: `x y w h Name`, then ` class` when it has one.
rectangle_row_text(int[] tape, string[] strings, int[] rectangle_values, int node_index) {
  string node_name = gui_node_str(tape, strings, node_index, (import gui_k_name));
  string suffix_text = class_suffix(gui_node_str(tape, strings, node_index, (import gui_k_cls)));
  string out = gui_rect_get(rectangle_values, node_index, 0) + " " + gui_rect_get(rectangle_values, node_index, 1) + " " + gui_rect_get(rectangle_values, node_index, 2) + " " + gui_rect_get(rectangle_values, node_index, 3) + " " + node_name + suffix_text;
} return string out;
