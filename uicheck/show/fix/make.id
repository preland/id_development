// Test fixtures (internal). A case's setup takes no arguments, so the tape it
// builds is an export that the case's checks read back.
//
// A fresh tape and its strings, in the exports fixture_tape and fixture_strings.
fresh_tape_fixture() {
  export int[] fixture_tape = [];
  export string[] fixture_strings = [];
  gui_new((import fixture_tape), (import fixture_strings));
} return void;
():() then tape_count_report:("count 1")
():() then tape_strings_report:("strs ")

// tiny.idml loaded and laid out in a 200x100 window, the rectangles in the
// export fixture_rectangles.
tiny_tape_fixture() {
  fresh_tape_fixture();
  export int[] fixture_rectangles = [];
  int load_status = gui_load("test_assets/tiny.idml", (import fixture_tape), (import fixture_strings));
} chain () {
  gui_layout((import fixture_tape), (import fixture_rectangles), 200, 100);
} return void;
():() then tape_count_report:("count 8")
():() then tape_strings_report:("strs |Card|Col|c|/|Card|Row|Spacer|Text|a|Spacer")

// A load that fails: the file does not exist, so the tape holds the diagnostic.
missing_file_fixture() {
  fresh_tape_fixture();
  int load_status = gui_load("test_assets/none.idml", (import fixture_tape), (import fixture_strings));
} return void;
():() then tape_strings_report:("strs ||test_assets/none.idml")
():() then tape_count_report:("count 1")
