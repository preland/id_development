// Test checks (internal): what a case reads back from the tape a fixture left.
uc_t_count() {
  string n_t = "count " + (gui_count((import uc_tt)));
} return string n_t;
given uc_t_new ():("count 1")
given uc_t_tiny ():("count 8")

uc_t_strs() {
  string rs_t = "strs " + (str_join((import uc_ts), "|"));
} return string rs_t;
given uc_t_new ():("strs ")
given uc_t_tiny ():("strs |Card|Col|c|/|Card|Row|Spacer|Text|a|Spacer")
