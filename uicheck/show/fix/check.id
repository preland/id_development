// Test checks (internal): what a case reads back from the tape a fixture left.
tape_count_report() {
  string count_line = "count " + (gui_count((import fixture_tape)));
} return string count_line;
given fresh_tape_fixture ():("count 1")
given tiny_tape_fixture ():("count 8")

tape_strings_report() {
  string strings_line = "strs " + (string_join((import fixture_strings), "|"));
} return string strings_line;
given fresh_tape_fixture ():("strs ")
given tiny_tape_fixture ():("strs |Card|Col|c|/|Card|Row|Spacer|Text|a|Spacer")
