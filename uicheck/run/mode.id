// The mode after the file name: --dump prints the document, --rects lays it out,
// anything else just says it is fine.
report_requested_mode(int argc, string[] argv, int[] tape, string[] strings) {
  string mode_flag = command_line_argument(argc, argv, 2);
  if (mode_flag == "--dump") {
    print(gui_dump(tape, strings));
  } else {
    report_rectangles_or_count(argc, argv, tape, strings, mode_flag);
  }
} return void;
given tiny_tape_fixture (2, ["uicheck", "x"], (import fixture_tape), (import fixture_strings)):() then prints:("ok 8 records\n")
given tiny_tape_fixture (3, ["uicheck", "x", "--dump"], (import fixture_tape), (import fixture_strings)):() then prints:("var Card:Col`c`\nroute /\nnode Card()[100,100,top-left]`c`{Row()[50,100,top-left]{Spacer()[100,25,top-left] Text(\"a\")[100,75,top-left]} Spacer()[50,100,top-left]}\n")

// --rects with its two sizes, or the plain report.
report_rectangles_or_count(int argc, string[] argv, int[] tape, string[] strings, string mode_flag) {
  if (mode_flag == "--rects") {
    print_rectangles_for_window_size(argc, argv, tape, strings);
  } else {
    print("ok " + gui_count(tape) + " records");
  }
} return void;
given tiny_tape_fixture (2, ["uicheck", "x"], (import fixture_tape), (import fixture_strings), ""):() then prints:("ok 8 records\n")
given tiny_tape_fixture (5, ["uicheck", "x", "--rects", "40", "40"], (import fixture_tape), (import fixture_strings), "--rects"):() then prints:("0 0 40 40 Card c\n0 0 40 20 Row\n0 0 10 20 Spacer\n10 0 30 20 Text\n0 20 40 20 Spacer\n")

// The window size from the command line, then the rectangles.
print_rectangles_for_window_size(int argc, string[] argv, int[] tape, string[] strings) {
  int window_width = to_int(command_line_argument(argc, argv, 3));
  int window_height = to_int(command_line_argument(argc, argv, 4));
  print_laid_out_rectangles(tape, strings, window_width, window_height);
} return void;
