// The mode after the file name: --dump prints the document, --rects lays it out,
// anything else just says it is fine.
uc_ok(int argc, string[] argv, int[] t, string[] s) {
  string md = uc_arg(argc, argv, 2);
  if (md == "--dump") {
    print(gui_dump(t, s));
  } else {
    uc_ok2(argc, argv, t, s, md);
  }
} return void;
given uc_t_tiny (2, ["uicheck", "x"], (import uc_tt), (import uc_ts)):() then prints:("ok 8 records\n")
given uc_t_tiny (3, ["uicheck", "x", "--dump"], (import uc_tt), (import uc_ts)):() then prints:("var Card:Col`c`\nroute /\nnode Card()[100,100,top-left]`c`{Row()[50,100,top-left]{Spacer()[100,25,top-left] Text(\"a\")[100,75,top-left]} Spacer()[50,100,top-left]}\n")

// --rects with its two sizes, or the plain report.
uc_ok2(int argc, string[] argv, int[] t, string[] s, string md) {
  if (md == "--rects") {
    uc_size(argc, argv, t, s);
  } else {
    print("ok " + gui_count(t) + " records");
  }
} return void;
given uc_t_tiny (2, ["uicheck", "x"], (import uc_tt), (import uc_ts), ""):() then prints:("ok 8 records\n")
given uc_t_tiny (5, ["uicheck", "x", "--rects", "40", "40"], (import uc_tt), (import uc_ts), "--rects"):() then prints:("0 0 40 40 Card c\n0 0 40 20 Row\n0 0 10 20 Spacer\n10 0 30 20 Text\n0 20 40 20 Spacer\n")

// The window size from the command line, then the rectangles.
uc_size(int argc, string[] argv, int[] t, string[] s) {
  int w = to_int(uc_arg(argc, argv, 3));
  int h = to_int(uc_arg(argc, argv, 4));
  uc_rects(t, s, w, h);
} return void;
given uc_t_tiny (5, ["uicheck", "x", "--rects", "200", "100"], (import uc_tt), (import uc_ts)):() then prints:("0 0 200 100 Card c\n0 0 200 50 Row\n0 0 50 50 Spacer\n50 0 150 50 Text\n0 50 200 50 Spacer\n")
given uc_t_tiny (5, ["uicheck", "x", "--rects", "100", "50"], (import uc_tt), (import uc_ts)):() then prints:("0 0 100 50 Card c\n0 0 100 25 Row\n0 0 25 25 Spacer\n25 0 75 25 Text\n0 25 100 25 Spacer\n")
