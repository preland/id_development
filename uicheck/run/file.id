// Parse the file named by argv[1], then act on it.
check_document_file(int argc, string[] argv) {
  int[] tape = [];
  string[] strings = [];
  gui_new(tape, strings);
} chain (int argc, string[] argv) {
  int load_status = gui_load(argv[1], tape, strings);
  int exit_status = run_requested_mode(argc, argv, tape, strings, load_status);
} return int exit_status;
(2, ["uicheck", "test_assets/tiny.idml"]):(0) then prints:("ok 8 records\n")
