// A failed parse is reported on stderr with the file's name; a good one goes on
// to the mode the command line asked for.
run_requested_mode(int argc, string[] argv, int[] tape, string[] strings, int load_status) {
  int exit_status = 1;
  if (load_status == 0) {
    report_requested_mode(argc, argv, tape, strings);
    exit_status = 0;
  } else {
    eprint(argv[1] + ": " + gui_diag(tape, strings));
  }
} return int exit_status;
