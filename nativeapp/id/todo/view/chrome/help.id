// View helpers over geo/pal: draw a geo-rect filled with a palette colour, draw
// a string at a geo text-position, and a 1px horizontal divider. Every other
// view function is expressed in terms of these three.

panel(int gi, int ci) {
  fill_rect((import geo)[gi], (import geo)[gi + 1],
            (import geo)[gi + 2], (import geo)[gi + 3], (import pal)[ci]);
} return void;

gtext(int gi, string s, int ci, int sc) {
  draw_text((import geo)[gi], (import geo)[gi + 1], s, (import pal)[ci], sc);
} return void;

hline(int x, int y, int w, int ci) {
  fill_rect(x, y, w, 1, (import pal)[ci]);
} return void;
