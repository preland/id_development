// Static chrome: the page background + card, the header (title + count badge),
// and the input bar (text field + Add button). The dynamic parts (badge number,
// typed text, the list) are drawn on top by the list/ modules.

paint_base() {
  fill_rect(0, 0, (import win_w), (import win_h), (import pal)[0]);
  panel(0, 1);
} return void;

draw_header() {
  panel(12, 4);
  gtext(20, "id . todo", 5, 3);
  draw_badge();
} return void;

draw_inputbar() {
  panel(4, 2);
  panel(8, 3);
  gtext(28, "Add", 1, 2);
} return void;
