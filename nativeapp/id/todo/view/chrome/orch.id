// Frame orchestration: one draw_frame() paints a whole frame into the
// framebuffer. Split into a static upper half (background/card/header/input bar)
// and a dynamic lower half (typed field + the todo list) to stay within the
// 3-actions-per-block budget.

draw_frame() {
  paint_base();
  draw_upper();
  draw_lower();
} return void;

draw_upper() {
  draw_header();
  draw_inputbar();
} return void;

draw_lower() {
  draw_inputtext();
  draw_body();
} return void;
