// The list body: one row per todo (from the reused count()/text()/done()
// accessors), or a friendly empty state when there are none.

draw_body() {
  if(count() > 0) {
    draw_rows();
  } else {
    draw_empty();
  }
} return void;

draw_rows() {
  int i = 0;
  while(i < count()) {
    draw_row(i);
    i = i + 1;
  }
} return void;

draw_empty() {
  draw_text((import geo)[16] + 70, (import geo)[17] + 70,
            "nothing yet - type a task and press Enter", (import pal)[6], 1);
} return void;
