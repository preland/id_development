// The row's checkbox: a filled green square when the todo is done, a light-grey
// square when it is still open. Drawn at the left of the row's band.

draw_rowcheck(int i, int ry) {
  fill_rect((import geo)[16] + 8, ry + 10, 24, 24, checkcolor(i));
} return void;

checkcolor(int i) {
  int c = (import pal)[9];
  if(done(i) == 1) {
    c = (import pal)[8];
  }
} return int c;
