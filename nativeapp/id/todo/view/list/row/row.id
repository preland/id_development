// One todo row at list index i: a background band (highlighted when it is the
// Tab-selected row), the checkbox, and the task text. Row top = list_y + i*rowh.

draw_row(int i) {
  int ry = (import geo)[17] + i * (import geo)[22];
  draw_rowbg(i, ry);
  draw_rowfg(i, ry);
} return void;

draw_rowbg(int i, int ry) {
  fill_rect((import geo)[16], ry, (import geo)[18], (import geo)[22],
            rowbg_color(i));
} return void;

draw_rowfg(int i, int ry) {
  draw_rowcheck(i, ry);
  draw_text((import geo)[16] + 44, ry + 15, text(i), rowcolor(i), 2);
} return void;
