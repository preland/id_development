// Row colours. The band is the card colour normally, a light tint when this row
// is the Tab selection. The text is ink when open, muted when done.

rowbg_color(int i) {
  int c = (import pal)[1];
  if(i == sel_cur()) {
    c = (import pal)[4];
  }
} return int c;

rowcolor(int i) {
  int c = (import pal)[5];
  if(done(i) == 1) {
    c = (import pal)[6];
  }
} return int c;
