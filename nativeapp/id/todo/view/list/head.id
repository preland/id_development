// Dynamic header + input contents: the badge's live "N left" count (from the
// reused id logic's remaining()), and the typed field -- the input buffer as a
// string, or a muted placeholder when empty.

badge_label() {
  string s = remaining() + " left";
} return string s;

draw_badge() {
  draw_text((import geo)[24], (import geo)[25], badge_label(), (import pal)[7], 2);
} return void;

draw_inputtext() {
  if(len(import buf) == 0) {
    gtext(26, "type a task...", 6, 2);
  } else {
    draw_text((import geo)[26], (import geo)[27], buf_str(), (import pal)[5], 2);
  }
} return void;
