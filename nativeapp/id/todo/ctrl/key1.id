// Keyboard dispatch, part 1. gfx_poll only delivers keys XLookupString maps to a
// character: printable bytes plus Enter(13/10), Backspace(8/127), Tab(9) and
// Esc(27) -- arrow keys produce no event. The chain is split across one-decision
// helpers so each block stays within id's 3-actions-per-block limit.
//   Enter -> add typed todo   Backspace -> erase   Tab -> move selection

on_key(int k) {
  if(k == 13 || k == 10) {
    do_add();
  } else {
    on_key2(k);
  }
} return void;

on_key2(int k) {
  if(k == 8 || k == 127) {
    buf_back();
  } else {
    on_key3(k);
  }
} return void;

on_key3(int k) {
  if(k == 9) {
    sel_move(1);
  } else {
    on_key4(k);
  }
} return void;
