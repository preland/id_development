// Keyboard dispatch, part 2. Esc toggles the selected row's done-state; any other
// printable byte is appended to the typed field.

on_key4(int k) {
  if(k == 27) {
    do_toggle();
  } else {
    on_char(k);
  }
} return void;

on_char(int k) {
  if(k >= 32 && k <= 126) {
    buf_addc(k);
  }
} return void;

do_toggle() {
  int si = sel_cur();
  if(si >= 0 && si < count()) {
    toggle(si);
  }
} return void;
