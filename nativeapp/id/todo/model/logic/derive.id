// A derived statistic: how many todos are still open (done() == 0). Shown in
// the header so the UI has a computed value that is pure id logic, not just a
// mirror of stored state.

remaining() {
  int r = 0;
  int k = 0;
  while(k < len(import todos)) {
    if(done(k) == 0) {
      r = r + 1;
    }
    k = k + 1;
  }
} return int r;
