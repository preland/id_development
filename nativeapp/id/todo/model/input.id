// The new-todo text field, kept as an int[] of character codes. Storing codes
// (not a string) makes Backspace a plain pop() -- no substring builtin needed --
// and lets the renderer draw the field a glyph at a time. buf_str (in ctrl)
// rebuilds a real string for add() by concatenating chr() of each code.

buf_reset() {
  export int[] buf = [];
} return void;

buf_addc(int code) {
  push((import buf), code);
} return void;

buf_back() {
  int n = len(import buf);
  if(n > 0) {
    pop((import buf));
  }
} return void;
