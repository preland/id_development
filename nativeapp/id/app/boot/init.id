// Startup: resolve the layout + palette (from the idml-compiled layout.gen.id),
// allocate the framebuffer at the window size, and load the font. init_model
// (companion file) seeds the empty todo state and input.

boot() {
  init_view();
  init_model();
} return void;

init_view() {
  layout();
  palette();
  init_fb();
} return void;

init_fb() {
  fb_init((import win_w), (import win_h));
  font_data();
} return void;
