// Drain every input event buffered since the last frame, dispatching each key to
// the controller. gfx_poll returns >=0 (a key code), -1 (no more events this
// frame), or -2 (the window wants to close). Returns 1 to keep looping, 0 to
// quit -- alive_flag reads the terminating event.

drain() {
  int ev = gfx_poll();
  while(ev >= 0) {
    on_key(ev);
    ev = gfx_poll();
  }
} return int alive_flag(ev);

alive_flag(int ev) {
  int keep = 1;
  if(ev == 0 - 2) {
    keep = 0;
  }
} return int keep;
