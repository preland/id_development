// Feed a string through the keyboard controller one character at a time, exactly
// as if the user typed it -- so a --shot exercises on_key -> on_char -> the input
// buffer -> the rendered field end to end.

type_str(string s) {
  int i = 0;
  while(i < len(s)) {
    on_key(charat(s, i));
    i = i + 1;
  }
} return void;
