// `--shot` mode: build a representative state, render one frame, dump a PPM.
// The typed field is filled through on_key (type.id) so the shot exercises the
// real keyboard input path, not just the render; the todos are seeded directly
// and one is toggled done.

demo_shot() {
  seed();
  type_str("Buy fresh oat milk");
  finish();
} return void;

seed() {
  add("Design the landing page");
  add("Review the pull request");
  add("Water the plants");
} return void;

finish() {
  toggle(0);
  draw_frame();
  dump_ppm();
} return void;
