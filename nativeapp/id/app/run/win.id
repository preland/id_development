// The windowed event loop. Open the GPU/X11 window (backends/gfx), then each
// frame: draw into the framebuffer, present it, and drain input. spin stops when
// a frame reports the window wants to close (drain -> 0). sleep_ms paces ~60fps.

run_window() {
  int ok = gfx_open((import win_w), (import win_h), "id . todo");
  spin(ok);
  gfx_close();
} return void;

spin(int run) {
  while(run > 0) {
    run = frame();
    sleep_ms(16);
  }
} return void;

frame() {
  draw_frame();
  gfx_present((import fb));
} return int drain();
