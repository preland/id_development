// The sprite maker. Every image the game uses is pixel art held in art/data.id
// and drawn by this program into SVG on stdout; scripts/build-sprites.sh splits
// the stream into public/sprites/*.svg. No image ever comes from anywhere else.

main(int argc, string[] argv) {
  boot();
  emit_art();
  emit_words();
} return int 0;

emit_art() {
  int i = 0;
  while (i < spec_count(import apack)) {
    draw_sprite(spec_at((import apack), i));
    i = i + 1;
  }
} return void;

emit_words() {
  digits_all();
  titles();
  labels();
} return void;
