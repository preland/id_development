// A sprite's name carries its flags as a prefix, so the art table stays one
// flat list of strings with nothing beside it to keep in step:
//
//   *  stretch -- drop preserveAspectRatio (for shafts, strips and skies)
//   ^  flip    -- emit the rows bottom to top (one cap serves both pipe ends)
//   +  outline -- lay a dark 1 px halo under the art (all the lettering)

flag_of(string s, int c) {
  int r = 0;
  if (charat(s, 0) == c) { r = 1; }
  if (charat(s, 1) == c) { r = 1; }
} return int r;

clean(string s) {
  int a = 0;
  while (charat(s, a) == 42 || charat(s, a) == 43 || charat(s, a) == 94) {
    a = a + 1;
  }
} return string sub(s, a, len(s));

// One run of pixels. On the outline pass (`m` = 1) the run is drawn as a dark
// rectangle one pixel bigger on every side; because that whole pass is emitted
// before any colour, the union of those rectangles ends up as a clean halo
// behind the art rather than a smear across it.
pen(int x, int y, int w, int m, int c) {
  string s = rect(x, y, w, 1, c);
  if (m == 1) { s = rect(x - 1, y - 1, w + 2, 3, 107); }
} return string s;
