// SVG output. A sprite is emitted as one <rect> per horizontal run of identical
// pixels, which keeps the files small and keeps every edge exactly on a pixel
// boundary -- the art scales to any size in the page without going soft.

// `fit` 0 means the sprite is allowed to stretch (a pipe shaft, the sky), 1
// means keep its aspect ratio whatever box it lands in (the bird, a digit).
head(int w, int h, int fit) {
  string s = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + w + " " + h + "\"";
  if (fit == 0) { s = s + " preserveAspectRatio=\"none\""; }
} return string s + " shape-rendering=\"crispEdges\">";

rect(int x, int y, int w, int h, int c) {
} return string "<rect x=\"" + x + "\" y=\"" + y + "\" width=\"" + w + "\" height=\"" + h + "\" fill=\"" + pal_hex(c) + "\"/>";

// Every sprite is printed to stdout behind one of these markers; the build
// script splits the stream back into files on it. id has no way to open a file,
// and it does not need one for this.
banner(string s) {
  print(">>>" + s);
} return void;
