// Reading the art tables. One table is a single string holding many sprites:
//
//   name|row/row/row ; name|row/row/row ; ...
//
// A sprite's width is the length of its first row and its height is the number
// of rows, so neither is ever written down and neither can disagree with the
// art.

spec_count(string s) {
} return int count_char(s, 59) + 1;

spec_at(string s, int i) {
  int a = 0;
  int k = 0;
  while (k < i) {
    a = find(s, 59, a) + 1;
    k = k + 1;
  }
} return string sub(s, a, find(s, 59, a));

spec_body(string s) {
} return string sub(s, find(s, 124, 0) + 1, len(s));
