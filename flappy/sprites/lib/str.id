// The three string operations the whole generator is built from. id gives you
// len/charat/chr and concatenation; everything else here is made of those.

sub(string s, int a, int b) {
  string t = "";
  int i = a;
  while (i < b) {
    t = t + chr(charat(s, i));
    i = i + 1;
  }
} return string t;

// The index of byte `c` at or after `a`. Missing returns len(s) -- the end --
// which is exactly what a caller slicing "up to the next separator" wants for
// the final field, so no result ever needs a special case.
find(string s, int c, int a) {
  int i = a;
  int r = len(s);
  while (i < r) {
    if (charat(s, i) == c) { r = i; }
    i = i + 1;
  }
} return int r;

count_char(string s, int c) {
  int n = 0;
  int i = 0;
  while (i < len(s)) {
    if (charat(s, i) == c) { n = n + 1; }
    i = i + 1;
  }
} return int n;
