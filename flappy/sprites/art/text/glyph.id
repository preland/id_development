// The 5x7 font, one glyph at a time. The glyph table is in the same format as
// the art table, in a fixed order -- '0'..'9' then 'A'..'Z' -- so a character
// indexes straight into it and no lookup is needed.

glyph_body(int c) {
  int i = c - 48;
  if (c > 64) { i = c - 55; }
} return string spec_body(spec_at((import fpack), i));

// Anything outside the table -- a space, or a row past the glyph's seven --
// comes back blank, which is what gives a word its gaps and its border.
glyph_line(int c, int r) {
  string s = ".....";
  if (c > 32 && r >= 0 && r < 7) { s = row_at(glyph_body(c), r); }
} return string s;

pick(int r, int h, int f) {
  int i = r;
  if (f == 1) { i = h - 1 - r; }
} return int i;
