// Every piece of lettering the game shows.

// The score is drawn as digit sprites, never as text in a typeface -- the
// original doesn't have a typeface, and neither does this.
digits_all() {
  int i = 0;
  while (i < 10) {
    draw_word("d" + i, "" + i);
    i = i + 1;
  }
} return void;

titles() {
  draw_word("t-getready", "GET READY");
  draw_word("t-gameover", "GAME OVER");
  draw_word("t-tap", "TAP OR SPACE");
} return void;

labels() {
  draw_word("t-score", "SCORE");
  draw_word("t-best", "BEST");
  draw_word("t-new", "NEW");
} return void;
