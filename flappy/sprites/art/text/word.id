// Words. A word is assembled into exactly the same row-string a hand-drawn
// sprite is written in, then handed to the ordinary sprite path -- so lettering
// gets the run packing, the halo and the SVG for free, and there is only one
// renderer in the program.

draw_word(string nm, string t) {
  draw_sprite("+" + nm + "|" + word_rows(t));
} return void;

// Nine rows: a blank one, the glyphs' seven, and a blank one. The border is
// what the outline pass needs to spill its halo into.
word_rows(string t) {
  string s = line_of(t, 0 - 1);
  int r = 0;
  while (r < 8) {
    s = s + "/" + line_of(t, r);
    r = r + 1;
  }
} return string s;

// One pixel row across the whole word: a dot, then each glyph's row followed by
// a dot -- one column of space between letters and a border at both ends.
line_of(string t, int r) {
  string s = ".";
  int i = 0;
  while (i < len(t)) {
    s = s + glyph_line(charat(t, i), r) + ".";
    i = i + 1;
  }
} return string s;
