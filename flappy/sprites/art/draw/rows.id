// Walking a sprite's rows.

// Outlined art is painted twice: once for the halo, once for the colour. Doing
// it as two full passes -- rather than a halo and a colour per run -- is what
// stops one run's halo from being laid over the run before it.
paint(string nm, string s, int h) {
  if (flag_of(nm, 43) == 1) { rows_out(s, h, flag_of(nm, 94), 1); }
  rows_out(s, h, flag_of(nm, 94), 0);
} return void;

rows_out(string s, int h, int f, int m) {
  int r = 0;
  while (r < h) {
    draw_row(row_at(s, pick(r, h, f)), r, m);
    r = r + 1;
  }
} return void;

row_at(string s, int r) {
  int a = 0;
  int i = 0;
  while (i < r) {
    a = find(s, 47, a) + 1;
    i = i + 1;
  }
} return string sub(s, a, find(s, 47, a));
