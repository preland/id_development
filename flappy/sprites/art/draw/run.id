// Runs within a row. Consecutive pixels of the same colour become one <rect>;
// transparent ones become nothing at all.

draw_row(string s, int y, int m) {
  int x = 0;
  while (x < len(s)) {
    x = emit_run(s, x, y, m);
  }
} return void;

emit_run(string s, int x, int y, int m) {
  int e = run_end(s, x);
  if (charat(s, x) != 46) { print(pen(x, y, e - x, m, charat(s, x))); }
} return int e;

run_end(string s, int a) {
  int i = a;
  while (i < len(s) && charat(s, i) == charat(s, a)) {
    i = i + 1;
  }
} return int i;
