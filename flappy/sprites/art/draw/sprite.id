// One sprite, start to finish.

draw_sprite(string spec) {
  draw_body(sub(spec, 0, find(spec, 124, 0)), spec_body(spec));
} return void;

draw_body(string nm, string s) {
  open_svg(nm, find(s, 47, 0), count_char(s, 47) + 1);
  paint(nm, s, count_char(s, 47) + 1);
  print("</svg>");
} return void;

open_svg(string nm, int w, int h) {
  banner(clean(nm) + ".svg");
  print(head(w, h, 1 - flag_of(nm, 42)));
} return void;
