// The bird's attitude, and its idle hover.

// 0 is nose-up (-20 degrees) and 11 is straight down; the step is the falling
// speed as a fraction of terminal velocity. Climbing pins it nose-up, and the
// death fall pins it nose-down whatever the speed says.
tilt() {
  int a = 0;
  if ((import g)[2] > 0) { a = (import g)[2] * 11 / 60000; }
  if ((import g)[0] == 2) { a = 11; }
} return int a;

bob() {
  int r = 0;
  if ((import g)[0] == 0) { r = wave(); }
} return int r;

// A triangle wave over 40 frames, +/-5 px. A sine would need floats and would
// not look any different at this size.
wave() {
  int p = (import g)[6] % 40;
  int r = p;
  if (p > 20) { r = 40 - p; }
} return int (r - 10) / 2;
