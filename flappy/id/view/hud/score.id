// The score, as a row of digit sprites -- the original never draws the score in
// a typeface, and neither does this.

digits() {
  int n = 1;
  if ((import g)[3] > 9) { n = 2; }
  if ((import g)[3] > 99) { n = 3; }
} return int n;

pow10(int n) {
  int p = 1;
  int i = 0;
  while (i < n) {
    p = p * 10;
    i = i + 1;
  }
} return int p;

digit_src(int i) {
  int p = pow10(digits() - 1 - i);
} return string "/sprites/d" + (import g)[3] / p % 10 + ".svg";
