// The original's four medals, at 10 / 20 / 30 / 40 pipes. 0 means the run
// wasn't worth one, and the scoreboard leaves the slot empty.
//
// A block holds three actions, so the ladder is three functions rather than one
// chain -- each rung only has to know its own threshold.

medal() {
  int m = 0;
  if ((import g)[3] >= 10) { m = 1 + medal_hi(); }
} return int m;

medal_hi() {
  int m = 0;
  if ((import g)[3] >= 20) { m = 1 + medal_top(); }
} return int m;

medal_top() {
  int m = 0;
  if ((import g)[3] >= 30) { m = 1; }
  if ((import g)[3] >= 40) { m = 2; }
} return int m;
