// Three odds and ends the scoreboard binds to.

medal_src() {
} return string "/sprites/medal-" + medal() + ".svg";

// The score sits in a row of digit sprites, so the row is exactly as wide as it
// has digits: 31 px each against the 288 px playfield, which is the width that
// keeps a 40 px-tall digit in proportion.
score_w() {
} return string pct(digits() * 31, 288);

is_new() {
} return int (import g)[9];
