// Which screen the game is on. The UI switches whole panels on these, so the
// question "is the run over?" is answered in id and not re-derived by the host.

// Nonzero for a few frames after a hit -- the UI shows a white sheet over
// everything while it lasts.
flash() {
} return int (import g)[10];

is_ready() {
} return int (import g)[0] == 0;

is_over() {
} return int (import g)[0] == 3;
