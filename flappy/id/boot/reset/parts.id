// The three halves of a reset, split because a block may hold three actions.

reset_run() {
  poke((import g), 0, 0);
  poke((import g), 3, 0);
  poke((import g), 5, 0);
} return void;

// y = 20000 centipixels = 200 px: the bird hangs a little above the middle of
// the sky, where the ready screen shows it bobbing.
reset_bird() {
  poke((import g), 1, 20000);
  poke((import g), 2, 0);
  poke((import g), 9, 0);
} return void;

clear_gaps() {
  poke((import g), 7, 0);
  poke((import g), 10, 0);
  drain((import gaps));
} return void;
