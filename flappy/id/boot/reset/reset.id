// Starting over, and starting off.

// Back to the ready screen with a clean run. `best` (g[4]) is deliberately not
// touched -- it outlives the run.
reset() {
  reset_run();
  reset_bird();
  clear_gaps();
} return void;

// Leaving the ready screen: the first flap is part of the tap that started the
// game, which is what makes the original's start feel instant.
begin() {
  poke((import g), 0, 1);
  poke((import g), 2, 0 - 42000);
} return void;
