// What the bird can run into. Only three pipes can ever be near it -- the one
// leaving, the one it is at, and the one arriving -- so the check is three
// tests wide and needs no loop.

collide() {
  if ((import g)[1] / 100 + 24 >= 400) { strike(); }
  if (hit_at(first_pipe()) + hit_at(first_pipe() + 1) > 0) { strike(); }
} return void;

// Pipe k's screen x, against the bird's fixed column at x=57..91. The 2 px of
// slack on each side is the original's forgiving hitbox: a pixel of overlap is
// a graze, not a crash.
hit_at(int k) {
  int x = 320 + k * 172 - dist_px();
  int r = 0;
  if (x < 89 && x + 52 > 59) { r = out_of_gap(k); }
} return int r;

// A pipe scores the moment its trailing edge clears the bird's nose. `next`
// only ever moves forward, so a pipe can't be counted twice.
pass_check() {
  int k = (import g)[7];
  if (dist_px() > 315 + k * 172) {
    poke((import g), 3, (import g)[3] + 1);
    poke((import g), 7, k + 1);
  }
} return void;
