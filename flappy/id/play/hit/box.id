// The vertical half of the collision test, plus the one conversion everything
// else is phrased in.

out_of_gap(int k) {
  int t = gap_of(k);
  int y = (import g)[1] / 100 + 3;
} return int in_gap(y, t);

// The bird's 24 px box, trimmed by 3 px top and bottom for the same reason the
// horizontal test is trimmed. Returns 1 for a crash, 0 for a clean pass.
in_gap(int y, int t) {
  int r = 1;
  if (y >= t && y + 18 <= t + 100) { r = 0; }
} return int r;

dist_px() {
} return int (import g)[5] / 100;
