// The two live modes: flying, and the death fall.

play(int dt) {
  gravity(dt);
  advance(dt);
  collide();
} return void;

// After a hit the world freezes and only the bird keeps moving -- it tumbles to
// the ground before the scoreboard appears.
falling(int dt) {
  gravity(dt);
  fly(dt);
  land_check();
} return void;

// 400 is the top of the ground; 24 is the bird's height, so this is its feet.
land_check() {
  if ((import g)[1] / 100 + 24 >= 400) { finish(); }
} return void;
