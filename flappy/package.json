{
  "name": "id-idml-flappy",
  "version": "0.1.0",
  "private": true,
  "description": "Flappy Bird: state and logic in id (compiled to WebAssembly), UI in idml, sprites drawn by an id program.",
  "scripts": {
    "build:id": "bash scripts/build-id.sh",
    "build:sprites": "bash scripts/build-sprites.sh",
    "build:config": "node scripts/build-config.mjs",
    "build:all": "npm run build:id && npm run build:sprites && npm run build:config",
    "prebuild": "npm run build:all",
    "predev": "npm run build:all",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "idml": "file:../../idml",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.4.0"
  }
}
