  int cli_state_has_path = len(cli_state_app.ui.shell.path) > 0;
} chain () {
  string cli_state_text = cli_state_integers + "|" + cli_state_has_path + "|" + cli_state_app.ui.shell.dirty;
} return string cli_state_text;
