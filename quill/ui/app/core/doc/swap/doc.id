// The document has no change that is not saved: the count of changes now is the one a save compares with, and the shell says so.
cli_mark_clean(App cli_clean_app) {
  lset((import cli_state_list), (import wa_s_mark), (import editor_typing_row)[1]);
  cli_clean_app.ui.shell.dirty = 0;
} return void;
