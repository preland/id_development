// The document has no change that is not saved: the count of changes now is the one a save compares with, and the shell says so.
wa_clean(App waa) {
  lset((import wa_st), (import wa_s_mark), (import ed_typing)[1]);
  waa.ui.shell.dirty = 0;
} return void;
given wa_t_app given wa_t_type(120) given wa_t_type(121) ((import wa_app)):() then wa_t_state:("2,0,0,0,|0|0")
