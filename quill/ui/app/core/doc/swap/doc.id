// Makes the document wad the one the canvas edits: it is laid out and paginated as the view vw_v, with a controller of its own, vw_ctl, and its caret at the start (cv_ed_new).
wa_view(Doc wad) {
  View wav = lay_view(wad);
  lay_all(wav);
  lay_paginate(wav, 0);
} chain (Doc wad) {
  cv_ed_new(wav);
} return void;
