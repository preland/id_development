// Puts the document wad in the app's place, as a new document or a file just read: the canvas edits it from the start, the page area is scrolled to the top, and the app holds its document, controller and view. Nothing is unsaved afterwards.
wa_swap(App waa, Doc wad) {
  wa_view(wad);
  View wav = (import vw_v);
  lst_splice((import vw_st), 0, 2, [0, 0]);
} chain (App waa, Doc wad) {
  vw_fit_all(wav);
  waa.doc = wad;
  waa.ctl = (import vw_ctl);
} chain (App waa, Doc wad) {
  waa.ui.view = wav;
  wa_clean(waa);
} return void;
