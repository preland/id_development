// Puts the document wad in the app's place, as a new document or a file just read: the canvas edits it from the start, the page area is scrolled to the top, and the app holds its document, controller and view. Nothing is unsaved afterwards.
cli_swap_document(App cli_swap_app, Doc wad) {
  cli_view_document(wad);
  View wav = (import view_input_viewer_view);
  list_splice((import view_state), 0, 2, [0, 0]);
} chain (App cli_swap_app, Doc wad) {
  view_input_window_fit(wav);
  cli_swap_app.doc = wad;
  cli_swap_app.ctl = (import view_input_controller);
} chain (App cli_swap_app, Doc wad) {
  cli_swap_app.ui.view = wav;
  cli_mark_clean(cli_swap_app);
} return void;
