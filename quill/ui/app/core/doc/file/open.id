// Opens the file at the path in place of the document the app holds. The file is read first: one that cannot be read leaves the document and its path as they are. Answers odt_load's code, 0 when the file is the document now.
app_open(App cli_open_app, string was_path) {
  Doc wad = doc_new();
  int cli_open_code = odt_load(was_path, wad);
  if(cli_open_code == 0) {
    cli_swap_document(cli_open_app, wad);
  }
} chain (App cli_open_app, string was_path) {
  if(cli_open_code == 0) {
    cli_open_app.ui.shell.path = was_path;
  }
} return int cli_open_code;
