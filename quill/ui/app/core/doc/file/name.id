// Gives the window the title app_title makes, and keeps it in cell 0 of wat_k with the path and the star (was_s) it was made from in cells 1 and 2, so that wa_note makes the title again only when one of the two changes.
cli_retitle_window(App cli_retitle_app, string[] cli_retitle_cells, string cli_retitle_star) {
  string cli_retitle_title = app_title(cli_retitle_app);
  cli_retitle_cells[0] = cli_retitle_title;
  cli_retitle_cells[1] = cli_retitle_app.ui.shell.path;
} chain (App cli_retitle_app, string[] cli_retitle_cells, string cli_retitle_star) {
  cli_retitle_cells[2] = cli_retitle_star;
  int cli_retitle_set = gfx_title(cli_retitle_title);
} return void;
