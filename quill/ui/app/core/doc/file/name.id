// The title of the window: the name of the document's file, a star after it when there are changes that are not saved, then the program.
app_title(App cli_window_app) {
  string cli_window_name = cli_file_name(cli_window_app.ui.shell.path);
  string cli_window_star = "";
  if(cli_window_app.ui.shell.dirty == 1) {
    cli_window_star = (import wa_star);
  }
} chain (App cli_window_app) {
  string cli_window_title = cli_window_name + cli_window_star + (import wa_prog);
} return string cli_window_title;
