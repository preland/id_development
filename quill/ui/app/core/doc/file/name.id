// The name of the file at the path, which is what follows its last slash, or the name of a document that has no file yet when the path is empty.
cli_file_name(string was_path) {
  string[] cli_name_parts = str_split(was_path, "/");
  string cli_name_last = cli_name_parts[len(cli_name_parts) - 1];
  if(len(cli_name_last) == 0) {
    cli_name_last = (import wa_untitled);
  }
} return string cli_name_last;
