// Puts the file the save just wrote, at was_tmp, in the place of the one at was_path, which it replaces only when the write was whole (wai_code is 0): a save that failed leaves the old file, and the half-written one is removed. Answers wai_code, or the code of a file that could not be written when the replacing failed.
cli_place_saved_file(string cli_place_partial, string was_path, int cli_place_code) {
  int cli_place_result = cli_place_code;
  if(cli_place_code == 0 && fs_rename(cli_place_partial, was_path) != 0) {
    cli_place_result = (import odw_e_file);
    odt_package_save_note(cli_place_result, was_path);
  }
  if(cli_place_result != 0) {
    int cli_place_removed = fs_remove(cli_place_partial);
  }
} return int cli_place_result;
