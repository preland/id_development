// The list commands: bullets and numbering start or stop their list (wa_mark), and deeper and shallower move the paragraphs a level in or out (wa_shift). Any other command is left alone.
app_list_command(App app_list_command_application, int app_list_command_command_code, int app_list_command_argument) {
  int app_list_command_index = list_index_of((import wa_list_cmd), app_list_command_command_code);
  if(app_list_command_index >= 0) {
    app_list_start(app_list_command_application, app_list_command_index + 1, app_list_command_argument);
  }
  if(app_list_command_command_code == (import cmd_list_deeper)) {
    app_list_shift(app_list_command_application, 1);
  }
} chain (App app_list_command_application, int app_list_command_command_code, int app_list_command_argument) {
  if(app_list_command_command_code == (import cmd_list_shallower)) {
    app_list_shift(app_list_command_application, 0 - 1);
  }
} return void;
