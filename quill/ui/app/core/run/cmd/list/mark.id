// Starts the built-in list wai_id (1 bullets, 2 numbers) on the paragraphs the selection touches, as one undo step, or takes them out of it when they are in it already (a mixed selection is put in it) or when wai_arg is 1, the menu's "Remove" entry.
app_list_start(App app_list_start_application, int app_list_start_kind, int app_list_start_argument) {
  int app_list_start_current = editor_selection_state(app_list_start_application.doc, app_list_start_application.ctl, (import ed_s_para) + (import quill_paragraph_list));
  int app_list_start_target = app_list_start_kind;
  if(app_list_start_current == app_list_start_kind || app_list_start_argument == 1) {
    app_list_start_target = 0;
  }
} chain (App app_list_start_application, int app_list_start_kind, int app_list_start_argument) {
  view_input_command_begin(app_list_start_application.ui.view);
  editor_set_paragraph(app_list_start_application.doc, app_list_start_application.ctl, (import quill_paragraph_list), app_list_start_target);
  view_input_command_end(app_list_start_application.ui.view);
} return void;
