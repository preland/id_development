// Moves the paragraphs of the selection that are in a list wai_d levels in (1) or out (-1), as one undo step; a paragraph that is not in a list, or would leave the levels there are, stays.
app_list_shift(App app_list_shift_application, int app_list_shift_direction) {
  int[] app_list_shift_arguments = [app_list_shift_direction];
  view_input_command_begin(app_list_shift_application.ui.view);
