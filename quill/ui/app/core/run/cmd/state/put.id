// Tells the ribbon what the commands of wa_put_cmd show now when that is not what it was told last: undo and redo grey when there is nothing to undo or redo, cut and copy when nothing is selected, the list buttons on for the list the caret is in, the moves of a list level grey outside a list.
app_ribbon_update(App app_update_application) {
  int[] app_update_numbers = [];
  app_collect_states(app_update_application, app_update_numbers);
  int app_update_changed = list_equal(app_update_numbers, (import cli_ribbon_states)) == 0;
} chain (App app_update_application) {
  if(app_update_changed == 1) {
    app_ribbon_tell(app_update_application, app_update_numbers);
  }
} return void;
