// Gives the ribbon the states wal_n of the commands of wa_put_cmd, keeps them as the ones it has (the export wa_ps), and makes the picture stale, because the ribbon is painted again only whole.
wa_tell(App waa, int[] wal_n) {
  int wai_k = 0;
  while(wai_k < len(wal_n)) {
    rib_put(waa.ui.rib, (import wa_put_cmd)[wai_k], wal_n[wai_k]);
    wai_k = wai_k + 1;
  }
  list_splice((import wa_ps), 0, len(wal_n), wal_n);
} chain (App waa, int[] wal_n) {
  lset((import vw_st), (import vw_s_d), 1);
} return void;
given wa_t_app given lset((import vw_st), 3, 0) ((import wa_app), [0, 3, 3, 3, 1, 0, 0, 0]):() then wa_t_put:("0,3,3,1") then vw_t_sts:("sts 0,0,100,1,")
