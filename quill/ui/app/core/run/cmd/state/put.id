// Gives the ribbon the states wal_n of the commands of wa_put_cmd, keeps them as the ones it has (the export wa_ps), and makes the picture stale, because the ribbon is painted again only whole.
app_ribbon_tell(App app_tell_application, int[] app_tell_numbers) {
  int app_tell_index = 0;
  while(app_tell_index < len(app_tell_numbers)) {
    rib_put(app_tell_application.ui.rib, (import wa_put_cmd)[app_tell_index], app_tell_numbers[app_tell_index]);
    app_tell_index = app_tell_index + 1;
  }
  list_splice((import cli_ribbon_states), 0, len(app_tell_numbers), app_tell_numbers);
} chain (App app_tell_application, int[] app_tell_numbers) {
