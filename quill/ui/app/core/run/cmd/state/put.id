// Adds to wal_n what each command of wa_put_cmd shows now, in that order (cmd_state).
wa_states(App waa, int[] wal_n) {
  int wai_k = 0;
  while(wai_k < len((import wa_put_cmd))) {
    push(wal_n, cmd_state(waa, (import wa_put_cmd)[wai_k]));
    wai_k = wai_k + 1;
  }
} return void;
given wa_t_app ((import wa_app), []):((import wa_app), [3, 3, 3, 3, 0, 0, 3, 3])
