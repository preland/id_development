// Adds to wal_n what each command of wa_put_cmd shows now, in that order (cmd_state).
app_collect_states(App app_collect_application, int[] app_collect_numbers) {
  int app_collect_index = 0;
  while(app_collect_index < len((import wa_put_cmd))) {
    push(app_collect_numbers, app_command_state(app_collect_application, (import wa_put_cmd)[app_collect_index]));
    app_collect_index = app_collect_index + 1;
  }
} return void;
