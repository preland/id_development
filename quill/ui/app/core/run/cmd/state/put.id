// Tells the ribbon what the commands of wa_put_cmd show now when that is not what it was told last: undo and redo grey when there is nothing to undo or redo, cut and copy when nothing is selected, the list buttons on for the list the caret is in, the moves of a list level grey outside a list.
wa_put(App waa) {
  int[] wal_n = [];
  wa_states(waa, wal_n);
  int wai_c = list_equal(wal_n, (import wa_ps)) == 0;
} chain (App waa) {
  if(wai_c == 1) {
    wa_tell(waa, wal_n);
  }
} return void;
