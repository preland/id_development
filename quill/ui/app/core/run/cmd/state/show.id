// What the selection says about a command that is a switch: for a character flag 0 off, 1 on, 2 mixed; for an alignment 1 when the paragraphs have it; for bullets and numbering 1 when they are in that list. Any other command is 0.
app_command_switch(App app_switch_application, int app_switch_command_code) {
  int app_switch_flag_index = list_index_of((import cv_f_cmd), app_switch_command_code);
  int app_switch_alignment_index = list_index_of((import cv_al_cmd), app_switch_command_code);
  int app_switch_list_index = list_index_of((import wa_list_cmd), app_switch_command_code);
} chain (App app_switch_application, int app_switch_command_code) {
  int app_switch_state = 0;
  if(app_switch_flag_index >= 0) {
    app_switch_state = editor_selection_state(app_switch_application.doc, app_switch_application.ctl, (import ed_s_flag) + (import cv_f_bit)[app_switch_flag_index]);
  }
  if(app_switch_alignment_index >= 0) {
    app_switch_state = editor_selection_state(app_switch_application.doc, app_switch_application.ctl, (import ed_s_para) + (import quill_paragraph_alignment)) == app_switch_alignment_index;
  }
} chain (App app_switch_application, int app_switch_command_code) {
  if(app_switch_list_index >= 0) {
    app_switch_state = editor_selection_state(app_switch_application.doc, app_switch_application.ctl, (import ed_s_para) + (import quill_paragraph_list)) == app_switch_list_index + 1;
  }
} return int app_switch_state;
