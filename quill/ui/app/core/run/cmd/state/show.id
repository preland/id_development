// What the ribbon shows for a command now: 0 off, 1 on, 2 mixed, 3 disabled (the ribbon's own numbers, rib_put).
app_command_state(App app_state_application, int app_state_command_code) {
  int app_state_shown = app_command_switch(app_state_application, app_state_command_code);
  int app_state_disabled = app_command_disabled(app_state_application, app_state_command_code);
  if(app_state_disabled == 1) {
    app_state_shown = 3;
  }
} return int app_state_shown;
