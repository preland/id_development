// 1 when the command cannot be done now: undo and redo with nothing to undo or redo, cut and copy with nothing selected, a move of a list level with the paragraphs not in a list.
app_command_disabled(App app_gate_application, int app_gate_command_code) {
  int app_gate_no_undo = len(app_gate_application.ctl.hist.undo) == 0 && app_gate_command_code == (import cmd_undo);
  int app_gate_no_redo = len(app_gate_application.ctl.hist.redo) == 0 && app_gate_command_code == (import cmd_redo);
  int app_gate_no_selection = editor_selection_empty(app_gate_application.ctl.sel) == 1 && (app_gate_command_code == (import cmd_cut) || app_gate_command_code == (import cmd_copy));
} chain (App app_gate_application, int app_gate_command_code) {
  int app_gate_no_list = 0;
  if(app_gate_command_code == (import cmd_list_deeper) || app_gate_command_code == (import cmd_list_shallower)) {
    app_gate_no_list = editor_selection_state(app_gate_application.doc, app_gate_application.ctl, (import ed_s_para) + (import quill_paragraph_list)) < 1;
  }
  int app_gate_result = app_gate_no_undo || app_gate_no_redo || app_gate_no_selection || app_gate_no_list;
} return int app_gate_result;
