// Test check: the list and the level of the first paragraph of the app's document, as the styles have them, a colon between.
app_test_list_level() {
  App app_level_application = (import cli_application);
  int app_level_properties = app_level_application.doc.body.paras[0].pprop;
  string app_level_text = document_style_effective_paragraph(app_level_application.doc.fmt, app_level_properties, (import quill_paragraph_list)) + ":" + document_style_effective_paragraph(app_level_application.doc.fmt, app_level_properties, (import quill_paragraph_level));
} return string app_level_text;
given cli_test_boot_app ():("0:0")
given cli_test_boot_app given app_test_set_list(1, 1) ():("1:1")

// Test check: the name of the style the first paragraph of the app's document is on.
app_test_style_name() {
  App app_style_application = (import cli_application);
  int app_style_index = tab_get(app_style_application.doc.fmt.paras, app_style_application.doc.body.paras[0].pprop, (import quill_paragraph_style));
  string app_style_name_text = app_style_application.doc.fmt.sty.styles[app_style_index].name;
} return string app_style_name_text;
given cli_test_boot_app ():("Normal")
given cli_test_boot_app given app_heading_shortcuts((import cli_application), 415) ():("Heading 1")

// Test check: the states the ribbon shows for undo and redo in the quick-access strip, for cut in the Home tab and for bullets, comma separated (0 off, 1 on, 2 mixed, 3 disabled).
app_test_ribbon_states() {
  Ribbon app_states_home_ribbon = (import view_ribbon);
  Ribbon app_states_quick_ribbon = (import ribbon_fit_quick_ribbon);
  string app_states_text = app_states_quick_ribbon.state[1] + "," + app_states_quick_ribbon.state[2] + "," + app_states_home_ribbon.state[1] + "," + app_states_home_ribbon.state[16];
} return string app_states_text;
