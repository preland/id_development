// The dispatcher under cmd_run_arg: each family of commands looks at the command and does it when it is its own.
app_dispatch_command(App app_dispatch_application, int app_dispatch_command_code, int app_dispatch_argument) {
  app_file_commands(app_dispatch_application, app_dispatch_command_code);
  app_zoom_commands(app_dispatch_application, app_dispatch_command_code);
  app_list_command(app_dispatch_application, app_dispatch_command_code, app_dispatch_argument);
} chain (App app_dispatch_application, int app_dispatch_command_code, int app_dispatch_argument) {
  app_heading_shortcuts(app_dispatch_application, app_dispatch_command_code);
  view_input_ribbon_command(app_dispatch_application.ui.view, app_dispatch_command_code, app_dispatch_argument, rib_name(app_dispatch_application.ui.rib));
} return void;
