// Does the command wai_cmd of the ribbon's table (word/conf.id) with the argument wai_arg the ribbon gave it, unless a dialog is open, which has every event: the file commands, the zoom, the lists and the heading shortcuts are the app's, any other command is the canvas's (cv_rib), which leaves alone the ones it does not do.
app_run_command_argument(App app_run_argument_application, int app_run_argument_command_code, int app_run_argument_value) {
  if((import cli_state_list)[(import wa_s_dlg)] == (import wa_d_none)) {
    app_dispatch_command(app_run_argument_application, app_run_argument_command_code, app_run_argument_value);
  }
} return void;
given cli_test_boot_app given cli_test_type_code_point(120) ((import cli_application), 101, 0):() then cli_test_state_text:("0,1,1,0,|0|1")
given cli_test_boot_app given app_dialog_show("T", ["a"], ["OK"], 4) ((import cli_application), 102, 0):() then cli_test_state_text:("0,0,4,0,|0|0")

// Does the command wai_cmd, which takes no argument (a key's, or a button's).
app_run_command(App app_run_application, int app_run_command_code) {
  app_run_command_argument(app_run_application, app_run_command_code, 0);
} return void;
given cli_test_boot_app ((import cli_application), 102):() then cli_test_state_text:("0,0,2,0,|0|0")
