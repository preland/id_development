// The file commands: New and Open ask about unsaved changes first, Save saves where the document is (or asks where), Save As always asks where. Any other command is left alone.
app_file_commands(App app_file_application, int app_file_command_code) {
  if(app_file_command_code == (import cmd_new)) {
    app_action_ask(app_file_application, (import wa_a_new));
  }
  if(app_file_command_code == (import cmd_open)) {
    app_action_ask(app_file_application, (import wa_a_open));
  }
  if(app_file_command_code == (import cmd_save)) {
    app_document_save(app_file_application);
  }
} chain (App app_file_application, int app_file_command_code) {
  if(app_file_command_code == (import cmd_save_as)) {
    app_picker_show(app_file_application, (import wa_d_save));
  }
} return void;
