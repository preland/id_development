// The style shortcuts, Ctrl+Alt+1 to 3: the command is the Heading style of its number, applied as the Styles gallery would apply it. Any other command is left alone.
app_heading_shortcuts(App app_heading_application, int app_heading_command_code) {
  int app_heading_index = list_index_of((import wa_head_cmd), app_heading_command_code);
  if(app_heading_index >= 0) {
    view_input_ribbon_command(app_heading_application.ui.view, (import cmd_style), 0, (import wa_head_name)[app_heading_index]);
  }
} return void;
