// Test check: 1 when the open dialog is in the middle of the window, to a pixel in each direction.
app_test_dialog_centered() {
  int[] app_centered_rectangles = (import app_open_dialog).rects;
  int app_centered_horizontal = fixed_point_absolute((import pixel_surface_width) - 2 * app_centered_rectangles[0] - app_centered_rectangles[2]) <= 1;
  int app_centered_vertical = fixed_point_absolute((import pixel_surface_height) - 2 * app_centered_rectangles[1] - app_centered_rectangles[3]) <= 1;
} chain () {
  int app_centered_result = app_centered_horizontal == 1 && app_centered_vertical == 1;
} return int app_centered_result;
given cli_test_boot_app given app_dialog_show("T", ["hi"], ["OK"], 4) ():(1)
given cli_test_boot_app given app_dialog_show("T", ["hi"], ["OK"], 4) given surface_create(800, 600) ():(0)
