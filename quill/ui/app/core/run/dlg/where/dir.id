// The folder a picker shows first: the one that holds the document's file, or the home directory when the document has none or its path names no folder (a relative path, which the file list cannot climb out of).
app_picker_folder(App app_folder_application) {
  string app_folder_path = fs_directory_of(app_folder_application.ui.shell.path);
  if(app_folder_path == ".") {
    app_folder_path = app_home_directory();
  }
  if(len(app_folder_path) == 0) {
    app_folder_path = "/";
  }
} return string app_folder_path;
given cli_test_boot_app given environment_put("HOME", "/usr") ((import cli_application)):("/usr")
given cli_test_boot_app given app_test_set_path("/etc/fonts/a.odt") ((import cli_application)):("/etc/fonts")
given cli_test_boot_app given app_test_set_path("/a.odt") ((import cli_application)):("/")

// The path the Save As picker offers: its folder and the name of the document's file, or Untitled, with the .odt it needs.
app_save_suggestion(App app_suggestion_application) {
  string app_suggestion_name = cli_file_name(app_suggestion_application.ui.shell.path);
  if(string_ends_with(app_suggestion_name, ".odt") == 0) {
    app_suggestion_name = app_suggestion_name + ".odt";
  }
  string app_suggestion_path = app_picker_folder(app_suggestion_application) + "/" + app_suggestion_name;
} return string app_suggestion_path;
