// The folder a picker shows first: the one that holds the document's file, or the home directory when the document has none or its path names no folder (a relative path, which the file list cannot climb out of).
wa_where(App waa) {
  string was_d = fs_dir_of(waa.ui.shell.path);
  if(was_d == ".") {
    was_d = wa_home();
  }
  if(len(was_d) == 0) {
    was_d = "/";
  }
} return string was_d;
given wa_t_app given environment_put("HOME", "/usr") ((import wa_app)):("/usr")
given wa_t_app given wa_t_at("/etc/fonts/a.odt") ((import wa_app)):("/etc/fonts")
given wa_t_app given wa_t_at("/a.odt") ((import wa_app)):("/")

// The path the Save As picker offers: its folder and the name of the document's file, or Untitled, with the .odt it needs.
wa_sugg(App waa) {
  string was_n = wa_name(waa.ui.shell.path);
  if(str_ends(was_n, ".odt") == 0) {
    was_n = was_n + ".odt";
  }
  string was_s = wa_where(waa) + "/" + was_n;
} return string was_s;
given wa_t_app given environment_put("HOME", "/usr") ((import wa_app)):("/usr/Untitled.odt")
given wa_t_app given wa_t_at("/etc/a.odt") ((import wa_app)):("/etc/a.odt")
