// The directory the pickers start in when the document has no file: the home directory, or the root when HOME is not set, is empty or is longer than 1024 bytes.
app_home_directory() {
  int[] app_home_buffer = [];
  list_fill(app_home_buffer, 1024, 0);
  int app_home_length = environment_get("HOME", app_home_buffer, 1024);
} chain () {
  string app_home_path = "/";
  if(app_home_length > 0 && app_home_length <= 1024) {
    app_home_path = exec_text(list_slice(app_home_buffer, 0, app_home_length));
  }
} return string app_home_path;
given environment_put("HOME", "/usr") ():("/usr")
given environment_put("HOME", "") ():("/")
