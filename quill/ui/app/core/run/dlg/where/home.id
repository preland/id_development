// The directory the pickers start in when the document has no file: the home directory, or the root when HOME is not set, is empty or is longer than 1024 bytes.
wa_home() {
  int[] wal_b = [];
  lst_fill(wal_b, 1024, 0);
  int wai_n = environment_get("HOME", wal_b, 1024);
} chain () {
  string was_h = "/";
  if(wai_n > 0 && wai_n <= 1024) {
    was_h = exec_text(lst_slice(wal_b, 0, wai_n));
  }
} return string was_h;
given environment_put("HOME", "/usr") ():("/usr")
given environment_put("HOME", "") ():("/")
