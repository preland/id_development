// Saves the document where it is: to its file, or, when it has none, through the Save As picker. Once saved, the action that was waiting for it happens (wa_go); a save that failed says why and nothing waits.
app_document_save(App app_save_application) {
  string app_save_path = app_save_application.ui.shell.path;
  int app_save_code = 0;
  if(len(app_save_path) == 0) {
    app_picker_show(app_save_application, (import wa_d_save));
  }
} chain (App app_save_application) {
  if(len(app_save_path) > 0) {
    app_save_code = app_save(app_save_application, app_save_path);
  }
  if(len(app_save_path) > 0 && app_save_code == 0) {
    app_action_perform(app_save_application);
  }
  if(app_save_code != 0) {
    app_error_dialog(app_save_application, app_save_code);
  }
} return void;
