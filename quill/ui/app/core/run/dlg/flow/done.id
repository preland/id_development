// What the file picker chose: the dialog goes, and the file at was_path is opened (the Open picker) or written (the Save As picker), saying why when it cannot be, and after a Save As the action that was waiting for it happens.
app_picker_chosen(App app_chosen_application, string was_path) {
  int app_chosen_dialog = (import cli_state_list)[(import wa_s_dlg)];
  app_dialog_close();
  int app_chosen_code = 0;
} chain (App app_chosen_application, string was_path) {
  if(app_chosen_dialog == (import wa_d_open)) {
    app_chosen_code = app_open(app_chosen_application, was_path);
  }
  if(app_chosen_dialog == (import wa_d_save)) {
    app_chosen_code = app_save(app_chosen_application, was_path);
  }
  if(app_chosen_code != 0) {
    app_error_dialog(app_chosen_application, app_chosen_code);
  }
} chain (App app_chosen_application, string was_path) {
  if(app_chosen_code == 0 && app_chosen_dialog == (import wa_d_save)) {
    app_action_perform(app_chosen_application);
  }
} return void;
