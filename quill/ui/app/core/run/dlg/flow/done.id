// Saves the document where it is: to its file, or, when it has none, through the Save As picker. Once saved, the action that was waiting for it happens (wa_go); a save that failed says why and nothing waits.
wa_keep(App waa) {
  string was_p = waa.ui.shell.path;
  int wai_code = 0;
  if(len(was_p) == 0) {
    wa_picker(waa, (import wa_d_save));
  }
} chain (App waa) {
  if(len(was_p) > 0) {
    wai_code = app_save(waa, was_p);
  }
  if(len(was_p) > 0 && wai_code == 0) {
    wa_go(waa);
  }
  if(wai_code != 0) {
    wa_oops(waa, wai_code);
  }
} return void;
