// What the file picker chose: the dialog goes, and the file at was_path is opened (the Open picker) or written (the Save As picker), saying why when it cannot be, and after a Save As the action that was waiting for it happens.
wa_took(App waa, string was_path) {
  int wai_k = (import wa_st)[(import wa_s_dlg)];
  wa_shut();
  int wai_code = 0;
} chain (App waa, string was_path) {
  if(wai_k == (import wa_d_open)) {
    wai_code = app_open(waa, was_path);
  }
  if(wai_k == (import wa_d_save)) {
    wai_code = app_save(waa, was_path);
  }
  if(wai_code != 0) {
    wa_oops(waa, wai_code);
  }
} chain (App waa, string was_path) {
  if(wai_code == 0 && wai_k == (import wa_d_save)) {
    wa_go(waa);
  }
} return void;
