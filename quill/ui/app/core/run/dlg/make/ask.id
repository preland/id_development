// Asks whether to save the changes of the document before something replaces it: the unsaved-changes dialog, Save, Don't Save or Cancel, naming the document's file.
wa_confirm(App waa) {
  string was_n = wa_name(waa.ui.shell.path);
  string[] wat_b = ["Save changes to " + was_n + "?"];
  wa_open((import wa_h_ask), wat_b, (import wa_k_ask), (import wa_d_ask));
} return void;
given wa_t_app ((import wa_app)):() then wa_t_state:("0,0,1,0,|0|0") then wa_t_body:("Save changes to Untitled?")
given wa_t_app given wa_t_at("/etc/x.odt") ((import wa_app)):() then wa_t_body:("Save changes to x.odt?")

// Tells the user what went wrong with a file, in the words odt_error has for the code wai_code: a dialog with an OK button, and no action waits any more.
wa_oops(App waa, int wai_code) {
  string was_m = odt_error(wai_code);
  string[] wat_b = vw_wrap((import rbd_ui)[0], was_m, (import wa_msgw));
  lset((import wa_st), (import wa_s_ask), (import wa_a_none));
} chain (App waa, int wai_code) {
  wa_open((import wa_h_msg), wat_b, (import wa_k_msg), (import wa_d_msg));
} return void;
