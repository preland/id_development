// Puts the open dialog in the middle of the window as it is now, and the file list of a picker in the free part of it. Call it after the window changed size.
app_dialog_center() {
  GuiDialog app_center_dialog = (import app_open_dialog);
  gui_dialog_place(app_center_dialog, (import sf_l_w), (import sf_l_h));
  int app_center_state = (import cli_state_list)[(import wa_s_dlg)];
} chain () {
  int[] app_center_area = gui_dialog_area(app_center_dialog);
  if(app_center_state == (import wa_d_open) || app_center_state == (import wa_d_save)) {
    gui_files_place((import app_picker_file_list), app_center_area[0], app_center_area[1], app_center_area[2], app_center_area[3]);
  }
} return void;
