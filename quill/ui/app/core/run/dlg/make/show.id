// Puts a dialog on the screen as dialog kind wai_kind (a wa_d_* code): one titled was_title with the lines wat_body and the buttons wat_keys, the first the default, kept as the export wa_dg and placed in the middle of the window. From now on it has every event, and the picture is stale.
app_dialog_show(string was_title, string[] wat_body, string[] wat_keys, int app_show_kind) {
  GuiDialog app_show_dialog = gui_dialog_new(was_title, wat_body, wat_keys, 0, (import wa_minw), (import ribbon_faces)[0]);
  export GuiDialog app_open_dialog = app_show_dialog;
  lset((import cli_state_list), (import wa_s_dlg), app_show_kind);
} chain (string was_title, string[] wat_body, string[] wat_keys, int app_show_kind) {
  app_dialog_center();
  lset((import view_state), (import vw_s_d), 1);
} return void;
