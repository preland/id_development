// Paints the open dialog over the picture, and the file list in it when it is a picker; nothing when there is no dialog.
app_dialog_paint() {
  int app_paint_state = (import cli_state_list)[(import wa_s_dlg)];
  if(app_paint_state != (import wa_d_none)) {
    gui_dialog_draw((import app_open_dialog));
  }
  if(app_paint_state == (import wa_d_open) || app_paint_state == (import wa_d_save)) {
    gui_files_draw((import app_picker_file_list));
  }
} return void;
