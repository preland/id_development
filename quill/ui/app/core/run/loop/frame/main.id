// Runs frames until the app should close or wai_max frames have run (a negative wai_max is no limit), and answers how many ran. A window that never opened (wai_ok 0) runs none.
app_frame_loop(App app_loop_application, int app_loop_opened, int app_loop_limit) {
  int app_loop_count = 0;
  int app_loop_quit = app_loop_opened == 0;
  while(app_loop_quit == 0 && app_loop_count != app_loop_limit) {
    app_loop_quit = app_frame(app_loop_application);
    app_loop_count = app_loop_count + 1;
  }
} return int app_loop_count;
