// One frame: the surface is fitted to the window when it changed, the waiting events are taken, the caret and the ribbon's tooltip get their turn, and the picture is painted when it is stale. Answers 1 when the app should close.
app_frame(App app_frame_application) {
  int app_frame_changed = gfx_sync();
  if(app_frame_changed == 1) {
    app_surface_resize(app_frame_application);
  }
  int app_frame_quit = app_events_take(app_frame_application);
} chain (App app_frame_application) {
  view_input_blink_tick(app_frame_application.ui.view);
  view_ribbon_tick();
  app_window_paint(app_frame_application, app_frame_quit);
} chain (App app_frame_application) {
  sleep_ms(1);
} return int app_frame_quit;
