// Takes every event the window has waiting, one at a time, into the one list wa_ev (a frame with nothing waiting allocates nothing), and answers 1 as soon as one asks to close the app (the rest stay waiting), else 0.
app_events_take(App app_take_application) {
  int[] app_take_fields = (import cli_event_list);
  int app_take_kind = graphics_event(app_take_fields);
  int app_take_quit = 0;
} chain (App app_take_application) {
  while(app_take_kind != 0 && app_take_quit == 0) {
    app_take_quit = app_on(app_take_application, app_take_kind, app_take_fields);
    app_take_kind = graphics_event(app_take_fields);
  }
} return int app_take_quit;
