// An event that no dialog took: the ribbon sees it first (wa_rib); the window closing asks about unsaved changes; and what the ribbon did not take goes to the page area or the scrollbar (wa_input).
app_event_route(App app_route_application, int app_route_kind, int[] app_route_fields) {
  int app_route_ribbon_took = app_ribbon_event(app_route_application, app_route_kind, app_route_fields);
  if(app_route_kind == 7) {
    app_action_ask(app_route_application, (import wa_a_close));
  }
  if(app_route_ribbon_took == 0) {
    app_event_page(app_route_application, app_route_kind, app_route_fields);
  }
} return void;
