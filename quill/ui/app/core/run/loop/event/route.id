// What the page area takes of an event the ribbon did not: a key (wa_key), the text a key types, the wheel (scroll, or zoom with Ctrl), the mouse, and a resize, which makes the picture stale.
app_event_page(App app_input_application, int app_input_kind, int[] app_input_fields) {
  if(app_input_kind == 1) {
    app_key_event(app_input_application, app_input_fields[1], app_input_fields[2]);
  }
  if(app_input_kind == 2) {
    view_input_text_type(app_input_application.ui.view, app_input_fields[1], app_input_fields[2]);
  }
  if(app_input_kind == 8) {
    view_input_wheel_handle(app_input_application.ui.view, app_input_fields[1], app_input_fields[2], gfx_mods(), view_box_field("canvas", 3), view_box_field("canvas", 2));
  }
} chain (App app_input_application, int app_input_kind, int[] app_input_fields) {
  if(app_input_kind >= 3 && app_input_kind <= 5) {
    view_input_mouse_handle(app_input_application.ui.view, app_input_kind, app_input_fields);
  }
  if(app_input_kind == 6) {
    integer_list_set((import view_state), (import vw_s_d), 1);
  }
} return void;
