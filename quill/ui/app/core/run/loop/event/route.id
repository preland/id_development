// One event of the window, of kind wai_kind with the fields wal_ev: a dialog that is open has it; otherwise it is routed (wa_route). Afterwards the title and the ribbon's switches are brought up to date, except after a mouse move or the wheel. Answers 1 when the app should close.
app_on(App app_on_application, int app_on_kind, int[] app_on_fields) {
  int app_on_dialog = (import cli_state_list)[(import wa_s_dlg)];
  if(app_on_dialog != (import wa_d_none)) {
    app_dialog_event(app_on_application, app_on_kind, app_on_fields);
  }
  if(app_on_dialog == (import wa_d_none)) {
    app_event_route(app_on_application, app_on_kind, app_on_fields);
  }
} chain (App app_on_application, int app_on_kind, int[] app_on_fields) {
  int app_on_quit = (import cli_state_list)[(import wa_s_quit)];
  if(app_on_kind != 5 && app_on_kind != 8) {
    app_state_refresh(app_on_application);
  }
} return int app_on_quit;
