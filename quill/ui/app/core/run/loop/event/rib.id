// What a key does: the command the key table has for it when it is one the app does itself and can do now (a Tab is a list command only in a list), else, for Page Up and Page Down, a screenful (wa_plain), else what the canvas does with it (zoom, caret movement, typing).
app_key_event(App app_key_application, int app_key_code, int app_key_modifiers) {
  int app_key_command_code = ribbon_key_command(app_key_modifiers, app_key_code);
  int app_key_owned = list_index_of((import wa_own_cmd), app_key_command_code) >= 0 && app_command_disabled(app_key_application, app_key_command_code) == 0;
  if(app_key_owned == 1) {
    app_run_command(app_key_application, app_key_command_code);
  }
} chain (App app_key_application, int app_key_code, int app_key_modifiers) {
  if(app_key_owned == 0) {
    app_key_plain(app_key_application, app_key_code, app_key_modifiers);
  }
} return void;
