  if(app_refresh_application.ui.shell.path != app_refresh_title_pair[1] || app_refresh_mark != app_refresh_title_pair[2]) {
    cli_retitle_window(app_refresh_application, app_refresh_title_pair, app_refresh_mark);
  }
