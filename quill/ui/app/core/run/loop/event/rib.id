// Notes what an event may have changed: whether the document has changes that are not saved, the title of the window when that or the file's name changed it, and what the ribbon shows for the commands that depend on the selection and the history.
app_state_refresh(App app_refresh_application) {
  cli_update_dirty(app_refresh_application);
  string[] app_refresh_title_pair = (import cli_title_cache);
  string app_refresh_mark = "";
} chain (App app_refresh_application) {
