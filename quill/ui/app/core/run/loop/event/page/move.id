// Puts the caret where the pixel at the surface's wai_my and the caret's own x are, after the page area scrolled wai_by pixels (down positive): the position under that pixel, with the selection growing from where it was when wai_ext is 1. When the page area could not scroll (wai_by is 0) the caret goes to the end of the document, or its start, by wai_dir.
app_caret_land(App app_land_application, int app_land_direction, int app_land_extend, int[] app_land_caret, int app_land_mouse_y, int app_land_scrolled) {
  Pos app_land_position = Pos(0, 0);
  int app_land_mouse_x = app_caret_surface_x(app_land_application, app_land_caret);
  view_input_command_begin(app_land_application.ui.view);
} chain (App app_land_application, int app_land_direction, int app_land_extend, int[] app_land_caret, int app_land_mouse_y, int app_land_scrolled) {
  if(app_land_scrolled != 0) {
    view_input_pixel_hit(app_land_application.ui.view, app_land_mouse_x, app_land_mouse_y, app_land_position);
    editor_place(app_land_application.doc, app_land_application.ctl, app_land_position, app_land_extend);
  }
  if(app_land_scrolled == 0) {
    editor_move(app_land_application.doc, app_land_application.ctl, app_land_direction, (import ed_u_doc), app_land_extend);
  }
  view_input_command_end(app_land_application.ui.view);
} return void;
