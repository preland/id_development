// Moves the page area a screenful, less wa_overlap pixels, up (wai_dir -1) or down (1), and the caret with it: it stays at the same place on the screen, so the lines it was among are the ones it lands among, and when the page area cannot move any more it goes to the start or the end of the document, as in Word. With wai_ext 1 the selection grows.
wa_page(App waa, int wai_dir, int wai_ext) {
  int[] wal_o = [0, 0, 0, 0];
  cv_where(waa.ui.view, wal_o);
  int wai_ch = vw_box("canvas", 3);
} chain (App waa, int wai_dir, int wai_ext) {
  int wai_sy = (import vw_st)[(import vw_s_y)];
  int wai_z = (import vw_st)[(import vw_s_z)];
  int wai_ty = vw_top(waa.ui.view, wal_o[0], wai_z) + vw_px(wal_o[2] + wal_o[3] / 2, wai_z) - wai_sy;
} chain (App waa, int wai_dir, int wai_ext) {
  vw_scroll(waa.ui.view, wai_dir * (wai_ch - (import wa_overlap)), wai_ch);
  int wai_by = (import vw_st)[(import vw_s_y)] - wai_sy;
  int wai_my = vw_box("canvas", 1) + fixed_point_clamp(wai_ty, 0, wai_ch - 1);
} chain (App waa, int wai_dir, int wai_ext) {
  wa_land(waa, wai_dir, wai_ext, wal_o, wai_my, wai_by);
} return void;
