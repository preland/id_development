// The x on the surface, in pixels, of the caret wal_o ([page, x, y, height] in lu, as cv_where has it) at the zoom and the scroll the page area has now.
app_caret_surface_x(App app_surface_application, int[] app_surface_caret) {
  int app_surface_zoom = (import view_state)[(import vw_s_z)];
  int app_surface_scroll = view_sheet_left(app_surface_application.ui.view, app_surface_zoom, view_box_field("canvas", 2), (import view_state)[(import vw_s_x)]);
  int app_surface_position = view_box_field("canvas", 0) + app_surface_scroll + view_units_pixels(app_surface_caret[1], app_surface_zoom);
} return int app_surface_position;
