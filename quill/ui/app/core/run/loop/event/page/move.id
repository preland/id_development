// Moves the page area a screenful, less wa_overlap pixels, up (wai_dir -1) or down (1), and the caret with it: it stays at the same place on the screen, so the lines it was among are the ones it lands among, and when the page area cannot move any more it goes to the start or the end of the document, as in Word. With wai_ext 1 the selection grows.
app_page_scroll(App app_page_application, int app_page_direction, int app_page_extend) {
  int[] app_page_caret = [0, 0, 0, 0];
  view_input_caret_place(app_page_application.ui.view, app_page_caret);
  int app_page_canvas_height = view_box_field("canvas", 3);
} chain (App app_page_application, int app_page_direction, int app_page_extend) {
  int app_page_scroll_start = (import view_state)[(import vw_s_y)];
  int app_page_zoom = (import view_state)[(import vw_s_z)];
  int app_page_caret_top = view_page_top(app_page_application.ui.view, app_page_caret[0], app_page_zoom) + view_units_pixels(app_page_caret[2] + app_page_caret[3] / 2, app_page_zoom) - app_page_scroll_start;
} chain (App app_page_application, int app_page_direction, int app_page_extend) {
  view_state_scroll(app_page_application.ui.view, app_page_direction * (app_page_canvas_height - (import wa_overlap)), app_page_canvas_height);
  int app_page_scrolled = (import view_state)[(import vw_s_y)] - app_page_scroll_start;
  int app_page_mouse_y = view_box_field("canvas", 1) + fixed_point_clamp(app_page_caret_top, 0, app_page_canvas_height - 1);
} chain (App app_page_application, int app_page_direction, int app_page_extend) {
  app_caret_land(app_page_application, app_page_direction, app_page_extend, app_page_caret, app_page_mouse_y, app_page_scrolled);
} return void;
