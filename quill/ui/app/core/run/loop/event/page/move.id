// The x on the surface, in pixels, of the caret wal_o ([page, x, y, height] in lu, as cv_where has it) at the zoom and the scroll the page area has now.
wa_x(App waa, int[] wal_o) {
  int wai_z = (import vw_st)[(import vw_s_z)];
  int wai_s = vw_sx(waa.ui.view, wai_z, vw_box("canvas", 2), (import vw_st)[(import vw_s_x)]);
  int wai_x = vw_box("canvas", 0) + wai_s + vw_px(wal_o[1], wai_z);
} return int wai_x;
