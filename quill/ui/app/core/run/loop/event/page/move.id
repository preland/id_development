// Puts the caret where the pixel at the surface's wai_my and the caret's own x are, after the page area scrolled wai_by pixels (down positive): the position under that pixel, with the selection growing from where it was when wai_ext is 1. When the page area could not scroll (wai_by is 0) the caret goes to the end of the document, or its start, by wai_dir.
wa_land(App waa, int wai_dir, int wai_ext, int[] wal_o, int wai_my, int wai_by) {
  Pos wap = Pos(0, 0);
  int wai_mx = wa_x(waa, wal_o);
  cv_begin(waa.ui.view);
} chain (App waa, int wai_dir, int wai_ext, int[] wal_o, int wai_my, int wai_by) {
  if(wai_by != 0) {
    cv_hit(waa.ui.view, wai_mx, wai_my, wap);
    ed_place(waa.doc, waa.ctl, wap, wai_ext);
  }
  if(wai_by == 0) {
    ed_move(waa.doc, waa.ctl, wai_dir, (import ed_u_doc), wai_ext);
  }
  cv_end(waa.ui.view);
} return void;
