// Test setup: presses Enter at the caret of the app's document, as the key does: one command of the canvas.
app_test_press_enter() {
  App app_enter_application = (import cli_application);
  view_input_command_begin(app_enter_application.ui.view);
  editor_break(app_enter_application.doc, app_enter_application.ctl, 0);
} chain () {
  view_input_command_end(app_enter_application.ui.view);
} return void;
given cli_test_boot_app ():() then cli_test_document_text:("|")
given cli_test_boot_app given cli_test_type_code_point(97) ():() then cli_test_document_text:("a|")

// Test setup: the app's document has wai_n paragraphs of the letter a, and a last, empty one, with the caret in it.
app_test_fill_lines(int app_lines_count) {
  int app_lines_index = 0;
  while(app_lines_index < app_lines_count) {
    cli_test_type_code_point(97);
    app_test_press_enter();
    app_lines_index = app_lines_index + 1;
  }
} return void;
given cli_test_boot_app (2):() then cli_test_document_text:("a|a|")
given cli_test_boot_app (0):() then cli_test_document_text:("")
