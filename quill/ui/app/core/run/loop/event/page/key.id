// A key the ribbon and the shortcut table did not want: Page Up and Page Down (with Shift the selection grows) move a screenful (wa_page); any other key is the canvas's (vw_key: the zoom keys, caret movement, editing).
wa_plain(App waa, int wai_key, int wai_mods) {
  int wai_pg = wai_key == (import wa_k_pgup) || wai_key == (import wa_k_pgdn);
  if(wai_pg == 1) {
    wa_page(waa, 2 * (wai_key - (import wa_k_pgup)) - 1, wai_mods & 1);
  }
  if(wai_pg == 0) {
    vw_key(waa.ui.view, wai_key, wai_mods, vw_box("canvas", 3));
  }
} return void;
