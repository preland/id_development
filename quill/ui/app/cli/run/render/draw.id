// Paints page wai_k (counted from 0) of the view wav on a surface made for it, as big as the sheet at the zoom wai_z percent: the white sheet and the text on it, as the window paints a page, without the desk, the selection or the caret.
cli_draw(View wav, int wai_k, int wai_z) {
  int wai_w = vw_px(lay_sheet(wav.doc, 0), wai_z);
  int wai_h = vw_px(lay_sheet(wav.doc, 1), wai_z);
  sf_l_init(wai_w, wai_h);
} chain (View wav, int wai_k, int wai_z) {
  d2_l_rect(0, 0, wai_w, wai_h, (import vw_c_sheet));
  int[] wal_g = [0, 0, wai_z, lay_margin(wav.doc, 3), lay_margin(wav.doc, 0)];
  cv_cull(wal_g, 0, wai_h);
} chain (View wav, int wai_k, int wai_z) {
  vw_page(wav, wai_k, wal_g);
} return void;
