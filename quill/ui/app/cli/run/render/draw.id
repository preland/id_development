// Test setup: a scratch file named by fs_mktemp, in the export cli_t_p, open for writing in the export cli_t_h.
cli_t_open(string was_tag) {
  string was_p = fs_mktemp("wa_ppm_" + was_tag, 0);
  export string cli_t_p = was_p;
  export int cli_t_h = fs_open(was_p, "w");
} return void;
