// Paints page wai_k (counted from 0) of the view wav on a surface made for it, as big as the sheet at the zoom wai_z percent: the white sheet and the text on it, as the window paints a page, without the desk, the selection or the caret.
cli_draw(View wav, int cli_draw_page_index, int cli_draw_zoom) {
  int cli_draw_width = view_units_pixels(lay_sheet(wav.doc, 0), cli_draw_zoom);
  int cli_draw_height = view_units_pixels(lay_sheet(wav.doc, 1), cli_draw_zoom);
  surface_create(cli_draw_width, cli_draw_height);
} chain (View wav, int cli_draw_page_index, int cli_draw_zoom) {
  surface_fill_rectangle(0, 0, cli_draw_width, cli_draw_height, (import vw_c_sheet));
  int[] cli_draw_geometry = [0, 0, cli_draw_zoom, lay_margin(wav.doc, 3), lay_margin(wav.doc, 0)];
  view_flow_add_band(cli_draw_geometry, 0, cli_draw_height);
} chain (View wav, int cli_draw_page_index, int cli_draw_zoom) {
  view_flow_draw_page(wav, cli_draw_page_index, cli_draw_geometry);
} return void;
