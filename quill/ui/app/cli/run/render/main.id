// Paints page wai_page (counted from 1) of the document wad at the zoom wai_z percent and writes it to the file at was_out as a PPM. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_shot(Doc wad, string was_out, int cli_shot_page, int cli_shot_zoom) {
  gui_font_state_create();
  int cli_shot_face = gui_face("sans-serif", 13, 0);
  ribbon_faces_set(cli_shot_face, cli_shot_face, cli_shot_face);
} chain (Doc wad, string was_out, int cli_shot_page, int cli_shot_zoom) {
  View wav = lay_view(wad);
  lay_all(wav);
  lay_paginate(wav, 0);
} chain (Doc wad, string was_out, int cli_shot_page, int cli_shot_zoom) {
  int cli_shot_page_count = lay_page_count(wav);
  int cli_shot_valid = cli_shot_page >= 1 && cli_shot_page <= cli_shot_page_count && cli_shot_zoom >= (import vw_zoom_min) && cli_shot_zoom <= (import vw_zoom_max);
  int cli_shot_status = 1;
} chain (Doc wad, string was_out, int cli_shot_page, int cli_shot_zoom) {
  if(cli_shot_valid == 1) {
    cli_draw(wav, cli_shot_page - 1, cli_shot_zoom);
    cli_shot_status = cli_write_picture(was_out);
  }
  if(cli_shot_valid == 0) {
    eprint("render: the page or the zoom is not there; the document has " + cli_shot_page_count + " page(s) and the zoom is from 25 to 400 percent");
  }
} return int cli_shot_status;
