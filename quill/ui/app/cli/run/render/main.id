// Test check: closes the scratch file and answers how many bytes it holds; the file is removed.
cli_test_close_scratch() {
  int cli_test_got_closed = fs_close((import cli_test_scratch_handle));
  int cli_test_got_size = fs_size((import cli_test_scratch_path));
  int cli_test_got_removed = fs_remove((import cli_test_scratch_path));
} return int cli_test_got_size;
