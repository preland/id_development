// word --render IN.odt OUT.ppm [--page N] [--zoom Z]: lays out the document IN.odt and writes page N (the first when not given) at Z percent (100 when not given) to OUT.ppm. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_render(int argc, string[] argv) {
  Doc wad = doc_new();
  int wai_code = odt_load(argv[2], wad);
  int wai_rc = 1;
} chain (int argc, string[] argv) {
  if(wai_code == 0) {
    wai_rc = cli_shot(wad, argv[3], cli_opt(argc, argv, "--page", 1), cli_opt(argc, argv, "--zoom", 100));
  }
  if(wai_code != 0) {
    eprint(odt_error(wai_code));
  }
} return int wai_rc;
