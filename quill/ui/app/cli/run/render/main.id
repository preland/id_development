// Paints page wai_page (counted from 1) of the document wad at the zoom wai_z percent and writes it to the file at was_out as a PPM. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_shot(Doc wad, string was_out, int wai_page, int wai_z) {
  gui_font_init();
  int wai_f = gui_face("sans-serif", 13, 0);
  rbd_ui_set(wai_f, wai_f, wai_f);
} chain (Doc wad, string was_out, int wai_page, int wai_z) {
  View wav = lay_view(wad);
  lay_all(wav);
  lay_paginate(wav, 0);
} chain (Doc wad, string was_out, int wai_page, int wai_z) {
  int wai_n = lay_page_count(wav);
  int wai_ok = wai_page >= 1 && wai_page <= wai_n && wai_z >= (import vw_zoom_min) && wai_z <= (import vw_zoom_max);
  int wai_rc = 1;
} chain (Doc wad, string was_out, int wai_page, int wai_z) {
  if(wai_ok == 1) {
    cli_draw(wav, wai_page - 1, wai_z);
    wai_rc = cli_ppm(was_out);
  }
  if(wai_ok == 0) {
    eprint("render: the page or the zoom is not there; the document has " + wai_n + " page(s) and the zoom is from 25 to 400 percent");
  }
} return int wai_rc;
