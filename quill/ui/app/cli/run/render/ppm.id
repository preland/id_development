// Writes the surface to the file at the path as a binary PPM (P6, 255), the picture a browser or an image viewer shows. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_write_picture(string was_path) {
  int cli_picture_failure = picture_write(was_path);
  if(cli_picture_failure != 0) {
    eprint("render: the picture could not be written; check that the folder exists and that you may write to it [" + was_path + "]");
  }
} return int cli_picture_failure;
