// The words of a script line that look at the document without changing it: d is the normalised dump of the document (docs/QUILL.md 4.9a), t the title of the window and a line feed, g the name of the dialog that is open and a line feed (none, unsaved, open, save, message). Any other verb says nothing.
cli_see_document(App cli_see_app, int cli_see_verb) {
  string cli_see_output = "";
  if(cli_see_verb == 100) {
    cli_see_output = odt_style_dump_document(cli_see_app.doc);
  }
  if(cli_see_verb == 116) {
    cli_see_output = app_title(cli_see_app) + "\n";
  }
} chain (App cli_see_app, int cli_see_verb) {
  if(cli_see_verb == 103) {
    cli_see_output = (import wa_d_names)[(import cli_state_list)[(import wa_s_dlg)]] + "\n";
  }
} return string cli_see_output;
given cli_test_boot_app ((import cli_application), 116):("Untitled - Quill\n")
given cli_test_boot_app ((import cli_application), 103):("none\n")
given cli_test_boot_app ((import cli_application), 100):("page w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\npara 0 style=\"Normal\" align=0 left=0 right=0 first=0 before=0 after=120 line=100 brk=0 level=0 list=-\n")
given cli_test_boot_app ((import cli_application), 120):("")

// What a script line does to the application's files and windows: n starts a new document, o opens the file named after it (the Open picker when nothing follows), s saves to the file named after it (the document's own file, or the Save As picker, when nothing follows), q asks the window to close, p chooses the file named after it in the picker that is open, and u presses the button of that number in the dialog that is open. Answers what it has to say: the reason a file could not be read or written, or what q came to.
cli_run_shell_verb(App cli_shell_app, int cli_shell_verb, string cli_shell_argument) {
  string cli_shell_output = "";
  if(cli_shell_verb == 110) {
    app_run_command(cli_shell_app, (import cmd_new));
  }
  if(cli_shell_verb == 111) {
    cli_shell_output = cli_load_for_script(cli_shell_app, cli_shell_argument);
  }
} chain (App cli_shell_app, int cli_shell_verb, string cli_shell_argument) {
  if(cli_shell_verb == 115) {
    cli_shell_output = cli_store_for_script(cli_shell_app, cli_shell_argument);
  }
  if(cli_shell_verb == 113) {
    cli_shell_output = cli_close_window(cli_shell_app);
  }
  if(cli_shell_verb == 117 && (import cli_state_list)[(import wa_s_dlg)] != (import wa_d_none)) {
    app_dialog_answer(cli_shell_app, to_int(cli_shell_argument));
  }
} chain (App cli_shell_app, int cli_shell_verb, string cli_shell_argument) {
  if(cli_shell_verb == 112 && (import cli_state_list)[(import wa_s_dlg)] != (import wa_d_none)) {
    app_picker_chosen(cli_shell_app, cli_shell_argument);
  }
} return string cli_shell_output;
given cli_test_boot_app ((import cli_application), 113, ""):("close\n")
given cli_test_boot_app ((import cli_application), 110, ""):("")

// One line of a script: its first character is the verb and the rest its argument. Lower case verbs are the application's (wa_see, wa_shell, and k, c, m and x, which are events of the window, wa_enter); upper case ones are the editor's (ed_play: T types, E is Enter, G toggles a flag, ...). Anything else is skipped. The title and the ribbon's switches are brought up to date after each line. Answers what the line printed: nothing, or a dump, a title, a dialog's name or a reason.
cli_play_line(App cli_line_app, string was_line) {
  int cli_line_verb = character_code_at(was_line, 0);
  int cli_line_length = fixed_point_maximum(len(was_line) - 1, 0);
  string cli_line_argument = str_sub(was_line, 1, cli_line_length);
} chain (App cli_line_app, string was_line) {
  string cli_line_seen = cli_see_document(cli_line_app, cli_line_verb);
  string cli_line_shell_output = cli_run_shell_verb(cli_line_app, cli_line_verb, cli_line_argument);
  cli_enter_script_line(cli_line_app, cli_line_verb, cli_line_argument, was_line);
} chain (App cli_line_app, string was_line) {
  app_state_refresh(cli_line_app);
  string cli_line_result = cli_line_seen + cli_line_shell_output;
} return string cli_line_result;
given cli_test_boot_app ((import cli_application), "t"):("Untitled - Quill\n")
