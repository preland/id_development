// Field wai_i of an argument that was split at its colons, as a number: 0 when the line gave fewer fields.
cli_field_number(string[] cli_number_fields, int cli_number_index) {
  int cli_number_value = 0;
  if(cli_number_index < len(cli_number_fields)) {
    cli_number_value = to_int(cli_number_fields[cli_number_index]);
  }
} return int cli_number_value;
(["12", "7"], 1):(7)
