// Types the text of was_t into the document the way the window delivers it: one text event for each code point (kind 2), each routed as the window's would be.
cli_type_text_events(App cli_type_app, string cli_type_text) {
  int cli_type_position = 0;
  while(character_code_at(cli_type_text, cli_type_position) >= 0) {
    app_on(cli_type_app, 2, [2, utf8_code_point(cli_type_text, cli_type_position), 0, 0, 0]);
    cli_type_position = utf8_next(cli_type_text, cli_type_position);
  }
} return void;
