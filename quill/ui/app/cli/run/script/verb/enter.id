// What a script line does as the window's events do: k<key>:<mods> a key, c<command>:<argument> a command of the ribbon's table, m<kind>:<x>:<y>:<button> a mouse event (kind 3 press, 4 release, 5 move), x<text> text typed; and for an upper case verb the whole line is the editor's (ed_play), done as one command of the canvas so that what changed is laid out. Any other verb does nothing here.
cli_enter_script_line(App cli_enter_app, int cli_enter_verb, string cli_enter_argument, string cli_enter_line) {
  string[] cli_enter_fields = str_split(cli_enter_argument, ":");
  if(cli_enter_verb == 107) {
    app_on(cli_enter_app, 1, [1, cli_field_number(cli_enter_fields, 0), cli_field_number(cli_enter_fields, 1), 0, 0]);
  }
  if(cli_enter_verb == 99) {
    app_run_command_argument(cli_enter_app, cli_field_number(cli_enter_fields, 0), cli_field_number(cli_enter_fields, 1));
  }
} chain (App cli_enter_app, int cli_enter_verb, string cli_enter_argument, string cli_enter_line) {
  if(cli_enter_verb == 109) {
    app_on(cli_enter_app, cli_field_number(cli_enter_fields, 0), [cli_field_number(cli_enter_fields, 0), cli_field_number(cli_enter_fields, 1), cli_field_number(cli_enter_fields, 2), cli_field_number(cli_enter_fields, 3), 1]);
  }
  if(cli_enter_verb == 120) {
    cli_type_text_events(cli_enter_app, cli_enter_argument);
  }
  if(cli_enter_verb >= 65 && cli_enter_verb <= 90) {
    view_input_command_begin(cli_enter_app.ui.view);
    editor_play_event(cli_enter_app.doc, cli_enter_app.ctl, cli_enter_line);
    view_input_command_end(cli_enter_app.ui.view);
  }
} return void;
