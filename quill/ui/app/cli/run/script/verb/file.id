// Saves the document to the file at the path for a script (app_save); with no path it saves where the document is, or shows the Save As picker. Answers why the file could not be written, and a line feed, or "" when it was.
cli_store_for_script(App cli_store_app, string was_path) {
  string cli_store_output = "";
  int cli_store_code = 0;
  if(len(was_path) == 0) {
    app_run_command(cli_store_app, (import cmd_save));
  }
} chain (App cli_store_app, string was_path) {
  if(len(was_path) > 0) {
    cli_store_code = app_save(cli_store_app, was_path);
  }
  if(cli_store_code != 0) {
    cli_store_output = odt_error(cli_store_code) + "\n";
  }
} return string cli_store_output;
