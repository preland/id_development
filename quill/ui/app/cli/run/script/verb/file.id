// Opens the file at the path for a script, as a user's Open does (wa_took); with no path it shows the Open picker. Answers why the file could not be read, and a line feed, or "" when it was.
cli_load_for_script(App cli_load_app, string was_path) {
  string cli_load_output = "";
  int cli_load_code = 0;
  if(len(was_path) == 0) {
    app_run_command(cli_load_app, (import cmd_open));
  }
} chain (App cli_load_app, string was_path) {
  if(len(was_path) > 0) {
    cli_load_code = app_open(cli_load_app, was_path);
  }
  if(cli_load_code != 0) {
    cli_load_output = odt_error(cli_load_code) + "\n";
  }
} return string cli_load_output;
