// Asks the window to close, as its close button does, and answers what came of it: "close" and a line feed when the app is closing, else the name of the dialog that opened (unsaved) and a line feed.
cli_close_window(App cli_leave_app) {
  int[] cli_leave_event = [7, 0, 0, 0, 0];
  int cli_leave_closing = app_on(cli_leave_app, 7, cli_leave_event);
  string cli_leave_output = (import wa_d_names)[(import cli_state_list)[(import wa_s_dlg)]] + "\n";
} chain (App cli_leave_app) {
  if(cli_leave_closing == 1) {
    cli_leave_output = "close\n";
  }
} return string cli_leave_output;
