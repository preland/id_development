// word --script FILE [IN.odt [OUT.odt]]: replays the script FILE (cli_play) on a document, which is IN.odt when given and a new one otherwise, in an application that has no window, and saves the document to OUT.odt when given. A script is one line per event; see wa_play for the verbs. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_script(string was_file, string was_in, string was_out) {
  int cli_script_exists = fs_exists(was_file);
  string was_text = "";
  int cli_script_status = cli_script_exists == 0;
} chain (string was_file, string was_in, string was_out) {
  if(cli_script_exists == 1) {
    was_text = fs_read_text(was_file);
  }
  app_new();
  App cli_script_app = (import cli_application);
} chain (string was_file, string was_in, string was_out) {
  int cli_script_code = 0;
  if(len(was_in) > 0) {
    cli_script_code = app_open(cli_script_app, was_in);
  }
  if(cli_script_exists == 1 && cli_script_code == 0) {
    cli_play(cli_script_app, string_split(was_text, "\n"));
  }
} chain (string was_file, string was_in, string was_out) {
  if(cli_script_exists == 1 && cli_script_code == 0 && len(was_out) > 0) {
    cli_script_code = app_save(cli_script_app, was_out);
  }
  if(cli_script_exists == 0) {
    eprint("script: the file could not be read; check that the path exists and that you may read it [" + was_file + "]");
  }
  if(cli_script_code != 0) {
    eprint(odt_error(cli_script_code));
    cli_script_status = 1;
  }
} return int cli_script_status;
