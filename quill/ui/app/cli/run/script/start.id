// Plays the lines wat_l of a script one after another (wa_play) on the application waa and prints what each of them printed.
cli_play(App cli_play_app, string[] cli_play_lines) {
  int cli_play_index = 0;
  while(cli_play_index < len(cli_play_lines)) {
    put(cli_play_line(cli_play_app, cli_play_lines[cli_play_index]));
    cli_play_index = cli_play_index + 1;
  }
} return void;
