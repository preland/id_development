// Test setup: plays the script was_s (wa_play) on the app, a line at a time, and answers what the lines printed, the ones that printed nothing left out.
cli_t_outs(string was_s) {
  string[] wat_l = str_split(was_s, "\n");
  string[] wat_o = [];
  int wai_k = 0;
} chain (string was_s) {
  while(wai_k < len(wat_l)) {
    string was_r = wa_play((import wa_app), wat_l[wai_k]);
    wai_k = wai_k + 1;
    if(len(was_r) > 0) {
      push(wat_o, was_r);
    }
  }
} return string[] wat_o;
given wa_t_app ("t\nTx\nt"):(["Untitled - Word\n", "Untitled* - Word\n"])
given wa_t_app ("Tx"):([])

// Test check: 1 when the first two things the script was_s printed are the same, 0 when they are not or it printed fewer than two. %P in the script is a scratch file's path, named by fs_mktemp, that is removed afterwards: so a script that dumps the document, saves it to %P, opens %P and dumps it again answers 1 when saving and reading lost nothing.
cli_t_same(string was_s) {
  string was_p = fs_mktemp("wa_rt_", 0);
  string was_t = str_join(str_split(was_s, "%P"), was_p);
  string[] wat_o = cli_t_outs(was_t);
} chain (string was_s) {
  int wai_same = len(wat_o) >= 2 && wat_o[0] == wat_o[1];
  int wai_g = fs_remove(was_p);
} return int wai_same;
given wa_t_app ("Thello world\nE\nTsecond\nS0:0:0:5\nG1\nd\ns%P\no%P\nd"):(1)
given wa_t_app ("Tabc\nd\nTzzz\nd"):(0)
given wa_t_app ("Tabc\nd\ns%P\nTzzz\no%P\nd"):(1)
