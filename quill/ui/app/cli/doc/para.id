// The text of one paragraph as plain text: an opaque block shows its label and an object inside a paragraph shows nothing, because their markers are not text; a line break is a newline.
cli_para(Para p) {
  string[] pieces = [];
  int i = 0;
  while(i < len(p.txt.cps)) {
    push(pieces, cli_code_point_text(p.txt.cps[i]));
    i = i + 1;
  }
} chain (Para p) {
  string text = string_join(pieces, "");
} return string text;
(Para(Text([72, 105], [Run(2, 0, -1)], 0), Lay([], [], -1), 0)):("Hi")
(Para(Text([97, 983040, 98], [Run(3, 0, -1)], 0), Lay([], [], -1), 0)):("ab")
(Para(Text([983041, 91, 84, 93], [Run(4, 0, -1)], 0), Lay([], [], -1), 9)):("[T]")
(Para(Text([97, 11, 98], [Run(3, 0, -1)], 0), Lay([], [], -1), 0)):("a\nb")
(Para(Text([], [Run(0, 0, -1)], 0), Lay([], [], -1), 0)):("")

// One code point as plain text.
cli_code_point_text(int cp) {
  string cli_code_point_string = utf8_string(cp);
  if(cp >= (import quill_object_marker)) {
    cli_code_point_string = "";
  }
  if(cp == (import orc_cp_break)) {
    cli_code_point_string = "\n";
  }
} return string cli_code_point_string;
(65):("A")
(233):("é")
(983040):("")
(11):("\n")
