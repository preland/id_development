// What the document prints as: its paragraphs one per line with a line feed at the end (dump 0), or the normalised dump (dump 1).
cli_form(Doc d, int dump) {
  string[] texts = cli_lines(d);
  string text = str_join(texts, "\n") + "\n";
  if(dump == 1) {
    text = ndump_doc(d);
  }
} return string text;
