// word --text IN.odt and word --dump IN.odt: loads the document and prints its paragraphs, one per line (dump 0), or its normalised dump (dump 1, docs/QUILL.md 4.9a). Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_doc(string path, int dump) {
  Doc d = doc_new();
  int code = odt_load(path, d);
  int rc = code != 0;
} chain (string path, int dump) {
  string text = cli_form(d, dump);
  if(code == 0) {
    put(text);
  } else {
    eprint(odt_error(code));
  }
} return int rc;
