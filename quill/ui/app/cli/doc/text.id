given orc_t_open("<r><office:text><text:p>Hi</text:p></office:text></r>") given orc_t_load ((import orc_td), 1):("page w=11906 h=16838 orient=0 top=1440 right=1440 bottom=1440 left=1440\npara 0 style=\"Normal\" align=0 left=0 right=0 first=0 before=0 after=120 line=100 brk=0 level=0 list=-\nrun b=0 i=0 u=0 s=0 sup=0 sub=0 size=24 color=- hl=- link=- font=\"serif\" text=\"Hi\"\n")

// The text of every paragraph of the document, in order.
cli_lines(Doc d) {
  string[] texts = [];
  int i = 0;
  while(i < len(d.body.paras)) {
    push(texts, cli_para(d.body.paras[i]));
    i = i + 1;
  }
} return string[] texts;
