// word --roundtrip IN.odt OUT.odt: loads the document and saves it again, so that a program can compare what came out with what went in. Answers 0, or 1 after naming on stderr what went wrong and how to fix it.
cli_round(string cli_input_path, string cli_output_path) {
  Doc d = doc_new();
  int code = odt_load(cli_input_path, d);
  int cli_round_status = code != 0;
} chain (string cli_input_path, string cli_output_path) {
  if(code == 0) {
    code = odt_save(cli_output_path, d);
    cli_round_status = code != 0;
  }
  if(code != 0) {
    eprint(odt_error(code));
  }
} return int cli_round_status;
