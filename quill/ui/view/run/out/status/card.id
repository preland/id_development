// Breaks the text vws_s into lines no wider than vwi_w pixels in font vwi_f, at its spaces; a word wider than a line has a line of its own.
view_card_wrap(int view_card_wrap_face, string view_card_wrap_text, int view_card_wrap_width) {
  string[] view_card_wrap_words = str_split(view_card_wrap_text, " ");
  string[] view_card_wrap_texts = [];
  string view_card_wrap_current = "";
} chain (int view_card_wrap_face, string view_card_wrap_text, int view_card_wrap_width) {
  int view_card_wrap_index = 0;
  while(view_card_wrap_index < len(view_card_wrap_words)) {
    view_card_wrap_current = view_card_fill(view_card_wrap_texts, view_card_wrap_face, view_card_wrap_current, view_card_wrap_words[view_card_wrap_index], view_card_wrap_width);
    view_card_wrap_index = view_card_wrap_index + 1;
  }
  push(view_card_wrap_texts, view_card_wrap_current);
} return string[] view_card_wrap_texts;
