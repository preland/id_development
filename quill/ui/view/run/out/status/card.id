// Paints a card in the page area (x, y, width, height) that says why there is no document: a white card with a border, centred, a title in bold in dark red and the message wrapped below it.
view_card_paint(string view_card_paint_message, int view_card_paint_area_left, int view_card_paint_area_top, int view_card_paint_area_width, int view_card_paint_area_height) {
  int view_card_paint_card_width = fixed_point_minimum(view_card_paint_area_width - 40, 520);
  int view_card_paint_face = (import ribbon_faces)[0];
  string[] view_card_paint_wrapped = view_card_wrap(view_card_paint_face, view_card_paint_message, view_card_paint_card_width - 32);
} chain (string view_card_paint_message, int view_card_paint_area_left, int view_card_paint_area_top, int view_card_paint_area_width, int view_card_paint_area_height) {
  int view_card_paint_card_height = len(view_card_paint_wrapped) * gui_font_line(view_card_paint_face) + 64;
  int view_card_paint_card_left = view_card_paint_area_left + (view_card_paint_area_width - view_card_paint_card_width) / 2;
  int view_card_paint_card_top = view_card_paint_area_top + (view_card_paint_area_height - view_card_paint_card_height) / 2;
} chain (string view_card_paint_message, int view_card_paint_area_left, int view_card_paint_area_top, int view_card_paint_area_width, int view_card_paint_area_height) {
  surface_fill_rectangle(view_card_paint_card_left, view_card_paint_card_top, view_card_paint_card_width, view_card_paint_card_height, (import vw_c_edge));
  surface_fill_rectangle(view_card_paint_card_left + 1, view_card_paint_card_top + 1, view_card_paint_card_width - 2, view_card_paint_card_height - 2, (import vw_c_sheet));
  gui_text_draw((import ribbon_faces)[1], view_card_paint_card_left + 16, view_card_paint_card_top + 14, "This document cannot be opened", (import vw_c_red));
} chain (string view_card_paint_message, int view_card_paint_area_left, int view_card_paint_area_top, int view_card_paint_area_width, int view_card_paint_area_height) {
  view_card_paint_lines(view_card_paint_wrapped, view_card_paint_card_left + 16, view_card_paint_card_top + 44);
} return void;
