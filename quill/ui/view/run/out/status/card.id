// Adds the word vws_w to the line vws_cur: when the line then still fits vwi_w pixels it is the line, else the line is finished (kept in vwl_lines) and the word starts the next. Answers the line to go on with.
view_card_fill(string[] view_card_fill_texts, int view_card_fill_face, string view_card_fill_current, string view_card_fill_word, int view_card_fill_width) {
  string view_card_fill_attempt = view_card_fill_current + " " + view_card_fill_word;
  int view_card_fill_fits = len(view_card_fill_current) == 0 || gui_text_width(view_card_fill_face, view_card_fill_attempt) <= view_card_fill_width;
  string view_card_fill_next = view_card_fill_word;
} chain (string[] view_card_fill_texts, int view_card_fill_face, string view_card_fill_current, string view_card_fill_word, int view_card_fill_width) {
  if(view_card_fill_fits == 1 && len(view_card_fill_current) > 0) {
    view_card_fill_next = view_card_fill_attempt;
  }
  if(view_card_fill_fits == 0) {
    push(view_card_fill_texts, view_card_fill_current);
  }
} return string view_card_fill_next;
