// Paints every page from the first, each when it shows in the page area vwl_r (x, y, width, height).
view_canvas_paint_pages(View view_canvas_paint_pages_viewer, int[] view_canvas_paint_pages_area) {
  int view_canvas_paint_pages_index = 0;
  int view_canvas_paint_pages_count = lay_page_count(view_canvas_paint_pages_viewer);
  while(view_canvas_paint_pages_index < view_canvas_paint_pages_count) {
    view_canvas_paint_page(view_canvas_paint_pages_viewer, view_canvas_paint_pages_index, view_canvas_paint_pages_area);
    view_canvas_paint_pages_index = view_canvas_paint_pages_index + 1;
  }
} return void;
