// The height of the whole continuous document in pixels at zoom vwi_z percent: a gap, then every sheet followed by a gap.
// By hand: a 3000 twip sheet is 12800 lu, 200 px at 100 percent, and the gap is 24; two sheets are 24 + 2 * (200 + 24) = 472; at 200 percent every size doubles, 944.
view_document_height(View view_document_height_viewer, int view_document_height_zoom) {
  int view_document_height_sheet_height = view_units_pixels(lay_sheet(view_document_height_viewer.doc, 1), view_document_height_zoom);
  int view_document_height_gap = view_units_pixels((import quill_layout_sheet_gap), view_document_height_zoom);
  int view_document_height_page_count = lay_page_count(view_document_height_viewer);
} chain (View view_document_height_viewer, int view_document_height_zoom) {
  int view_document_height_result = view_document_height_gap + view_document_height_page_count * (view_document_height_sheet_height + view_document_height_gap);
} return int view_document_height_result;
