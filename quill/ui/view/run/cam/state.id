// Sets the zoom to vwi_z percent, kept between the least and the most, and keeps the same part of the document in view: the scroll is scaled with the zoom, then held inside the document for a page area vwi_ch pixels tall. The picture is stale.
view_state_zoom(View view_state_zoom_viewer, int view_state_zoom_requested, int view_state_zoom_area_height) {
  int[] view_state_zoom_state = (import view_state);
  int view_state_zoom_clamped = fixed_point_clamp(view_state_zoom_requested, (import vw_zoom_min), (import vw_zoom_max));
  int view_state_zoom_scaled_row = view_state_zoom_state[(import vw_s_y)] * view_state_zoom_clamped / view_state_zoom_state[(import vw_s_z)];
} chain (View view_state_zoom_viewer, int view_state_zoom_requested, int view_state_zoom_area_height) {
  int view_state_zoom_maximum = view_scroll_maximum(view_state_zoom_viewer, view_state_zoom_clamped, view_state_zoom_area_height);
  lset(view_state_zoom_state, (import vw_s_z), view_state_zoom_clamped);
  lset(view_state_zoom_state, (import vw_s_y), fixed_point_minimum(view_state_zoom_scaled_row, view_state_zoom_maximum));
} chain (View view_state_zoom_viewer, int view_state_zoom_requested, int view_state_zoom_area_height) {
