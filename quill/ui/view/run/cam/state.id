// A new state: scrolled to the top left, at 100 percent, with the picture stale so that the first frame paints. It is kept in the export vw_st.
view_state_new() {
  export int[] view_state = [0, 0, 100, 1];
  export int[] view_state_status_keys = [0 - 1, 0 - 1];
  export string[] view_state_status_text = [""];
} return void;
