// Scrolls the page area by vwi_dy pixels (down is positive), never past the top or the end of the document for a page area vwi_ch pixels tall, and marks the picture stale when that moved it.
view_state_scroll(View view_state_scroll_viewer, int view_state_scroll_distance, int view_state_scroll_area_height) {
  int[] view_state_scroll_state = (import view_state);
  int view_state_scroll_maximum = view_scroll_maximum(view_state_scroll_viewer, view_state_scroll_state[(import vw_s_z)], view_state_scroll_area_height);
  int view_state_scroll_new_row = fixed_point_clamp(view_state_scroll_state[(import vw_s_y)] + view_state_scroll_distance, 0, view_state_scroll_maximum);
} chain (View view_state_scroll_viewer, int view_state_scroll_distance, int view_state_scroll_area_height) {
  if(view_state_scroll_new_row != view_state_scroll_state[(import vw_s_y)]) {
    lset(view_state_scroll_state, (import vw_s_y), view_state_scroll_new_row);
    lset(view_state_scroll_state, (import vw_s_d), 1);
  }
} return void;
