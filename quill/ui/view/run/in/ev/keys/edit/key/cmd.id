view_input_canvas_command(View view_input_canvas_view, int view_input_canvas_command_number) {
  Ctl view_input_canvas_controller = (import view_input_controller);
  view_input_history_command(view_input_canvas_view, view_input_canvas_controller, view_input_canvas_command_number);
  view_input_clipboard_command(view_input_canvas_view, view_input_canvas_controller, view_input_canvas_command_number);
} chain (View view_input_canvas_view, int view_input_canvas_command_number) {
  view_input_format_command(view_input_canvas_view, view_input_canvas_controller, view_input_canvas_command_number);
  if(view_input_canvas_command_number == (import cmd_select_all)) {
    editor_select_all(view_input_canvas_view.doc, view_input_canvas_controller);
  }
} return void;
