    view_input_clipboard_text = editor_cut(view_input_clipboard_view.doc, view_input_clipboard_controller);
  }
  if(view_input_clipboard_command_number == (import cmd_copy)) {
    view_input_clipboard_text = editor_copy(view_input_clipboard_view.doc, view_input_clipboard_controller);
  }
} chain (View view_input_clipboard_view, Ctl view_input_clipboard_controller, int view_input_clipboard_command_number) {
  int view_input_clipboard_stored = len(view_input_clipboard_text) > 0 && graphics_clip_set(view_input_clipboard_text) == 1;
  if(view_input_clipboard_command_number == (import cmd_paste)) {
    editor_paste(view_input_clipboard_view.doc, view_input_clipboard_controller, graphics_clip_get());
  }
} return void;
