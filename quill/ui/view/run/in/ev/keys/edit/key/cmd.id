view_input_history_command(View view_input_history_view, Ctl view_input_history_controller, int view_input_history_command_number) {
  int view_input_history_result = 0;
  if(view_input_history_command_number == (import cmd_undo)) {
    view_input_history_result = hist_undo(view_input_history_view.doc, view_input_history_controller);
  }
  if(view_input_history_command_number == (import cmd_redo)) {
    view_input_history_result = hist_redo(view_input_history_view.doc, view_input_history_controller);
  }
} return void;
