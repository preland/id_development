// The commands that take an argument, done to the selection by what each one sets (the argument is a value, the name a font family or a style): a font colour, highlight or size, a font family, a grow or a shrink of the font, a paragraph's line spacing, indent or space, its alignment or indent step, a style, and the page's size, orientation and margins.
cv_arg(View cvv, int cvi_cmd, int cvi_arg, string cvs_name) {
  Ctl cvc = (import vw_ctl);
  cv_char(cvv, cvc, cvi_cmd, cvi_arg);
  cv_family(cvv, cvc, cvi_cmd, cvs_name);
} chain (View cvv, int cvi_cmd, int cvi_arg, string cvs_name) {
  cv_resize(cvv, cvc, cvi_cmd);
  cv_para(cvv, cvc, cvi_cmd, cvi_arg);
  cv_align(cvv, cvc, cvi_cmd);
} chain (View cvv, int cvi_cmd, int cvi_arg, string cvs_name) {
  cv_style(cvv, cvc, cvi_cmd, cvs_name);
  cv_page(cvv, cvc, cvi_cmd, cvi_arg);
} return void;
