// Runs the command cvi_cmd of the ribbon, with the argument cvi_arg and the name cvs_name it gave (a font family, a style), as one command that can be undone as one: what the canvas does without an argument (cv_cmd), then what it does with one (cv_arg). A command the canvas does not do (cv_r_cmd) changes nothing, and does not scroll the page to the caret either.
cv_rib(View cvv, int cvi_cmd, int cvi_arg, string cvs_name) {
  int cvi_k = lst_index_of((import cv_r_cmd), cvi_cmd);
  if(cvi_k >= 0) {
    cv_begin(cvv);
    cv_cmd(cvv, cvi_cmd);
    cv_arg(cvv, cvi_cmd, cvi_arg, cvs_name);
  }
  if(cvi_k >= 0) {
    cv_end(cvv);
  }
} return void;
