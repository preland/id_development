// The font family of the selection set to the family named cvs_name when the command is cmd_font_family: its number in the document's list of fonts, which gets the family at the end when it has not got it yet. An empty name sets nothing.
cv_family(View cvv, Ctl cvc, int cvi_cmd, string cvs_name) {
  int cvi_f = list_string_index(cvv.doc.ext.fonts, cvs_name);
  int cvi_on = cvi_cmd == (import cmd_font_family) && len(cvs_name) > 0;
  if(cvi_on == 1 && cvi_f < 0) {
    push(cvv.doc.ext.fonts, cvs_name);
    cvi_f = len(cvv.doc.ext.fonts) - 1;
  }
} chain (View cvv, Ctl cvc, int cvi_cmd, string cvs_name) {
  if(cvi_on == 1) {
    ed_set_char(cvv.doc, cvc, (import word_c_font), cvi_f);
  }
} return void;
