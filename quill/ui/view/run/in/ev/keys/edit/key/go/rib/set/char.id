// The grow font button (cmd_size_grow) makes the size of the selection one step bigger and the shrink button (cmd_size_shrink) one step smaller, as far as two half-points; a selection whose size differs along it, or any other command, is left alone.
cv_resize(View cvv, Ctl cvc, int cvi_cmd) {
  int cvi_s = sel_state(cvv.doc, cvc, (import word_c_size));
  int cvi_d = (cvi_cmd == (import cmd_size_grow)) - (cvi_cmd == (import cmd_size_shrink));
  if(cvi_d != 0 && cvi_s > 0) {
    ed_set_char(cvv.doc, cvc, (import word_c_size), fixed_point_maximum(cvi_s + cvi_d * (import cv_grow), 2));
  }
} return void;
