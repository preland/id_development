// Lays the document out again when something needs it: an edit marked paragraphs stale (cvl_r says which) or the paragraphs are not the ones the pagination has. Answers how many were laid out again.
view_input_again_stale(View view_input_again_view, int[] view_input_again_range) {
  int view_input_again_count = 0;
  int view_input_again_needed = view_input_again_range[0] >= 0 || len(view_input_again_view.pages.tops) != len(view_input_again_view.doc.body.paras);
  if(view_input_again_needed == 1) {
    view_input_again_count = layout_page_layout_again(view_input_again_view);
  }
} return int view_input_again_count;
