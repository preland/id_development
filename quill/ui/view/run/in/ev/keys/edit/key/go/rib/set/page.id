// Does the page setup command cvi_cmd, with the argument cvi_arg, to the document: each field that cv_sheet has a value for is set, one undo step a field.
view_input_page_setup_apply(View view_input_page_view, Ctl view_input_page_controller, int view_input_page_command_number, int view_input_page_value) {
  int[] view_input_page_fields = view_input_page_setup_values(view_input_page_view, view_input_page_command_number, view_input_page_value);
  int view_input_page_field_index = 0;
  while(view_input_page_field_index < len(view_input_page_fields)) {
    if(view_input_page_fields[view_input_page_field_index] >= 0) {
      editor_set_page(view_input_page_view.doc, view_input_page_controller, view_input_page_field_index, view_input_page_fields[view_input_page_field_index]);
    }
    view_input_page_field_index = view_input_page_field_index + 1;
  }
} return void;
