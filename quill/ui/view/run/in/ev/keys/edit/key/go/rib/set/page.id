// The style the command cmd_style names: the style of the document that has the name cvs_name is applied (a paragraph style to the paragraphs the selection touches, a character style to the selected text); a name the document has no style of changes nothing.
cv_style(View cvv, Ctl cvc, int cvi_cmd, string cvs_name) {
  int cvi_s = style_find(cvv.doc.fmt, cvs_name);
  if(cvi_cmd == (import cmd_style) && cvi_s >= 0) {
    ed_set_style(cvv.doc, cvc, cvi_s);
  }
} return void;
