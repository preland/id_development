// Does the page setup command cvi_cmd, with the argument cvi_arg, to the document: each field that cv_sheet has a value for is set, one undo step a field.
cv_page(View cvv, Ctl cvc, int cvi_cmd, int cvi_arg) {
  int[] cvl_v = cv_sheet(cvv, cvi_cmd, cvi_arg);
  int cvi_k = 0;
  while(cvi_k < len(cvl_v)) {
    if(cvl_v[cvi_k] >= 0) {
      ed_set_page(cvv.doc, cvc, cvi_k, cvl_v[cvi_k]);
    }
    cvi_k = cvi_k + 1;
  }
} return void;
