// The page the command cmd_page_size, cmd_page_orient or cmd_page_margins asks for, as the seven numbers of ed_set_page's fields (the width, the height and the orientation, then the top, right, bottom and left margin), -1 for each that stays as it is: the paper at position cvi_arg of rbd_paper (kept in the orientation the page has), the orientation cvi_arg (turning the page puts its width and height the other way round), or the margins at position cvi_arg of rbd_margins.
cv_sheet(View cvv, int cvi_cmd, int cvi_arg) {
  int[] cvl_s = cvv.doc.body.page.size;
  int[] cvl_v = [-1, -1, -1, -1, -1, -1, -1];
  int cvi_o = cvl_s[2];
} chain (View cvv, int cvi_cmd, int cvi_arg) {
  if(cvi_cmd == (import cmd_page_size)) {
    cvl_v = [(import rbd_paper)[2 * cvi_arg + cvi_o], (import rbd_paper)[2 * cvi_arg + 1 - cvi_o], -1, -1, -1, -1, -1];
  }
  if(cvi_cmd == (import cmd_page_orient) && cvi_arg != cvi_o) {
    cvl_v = [cvl_s[1], cvl_s[0], cvi_arg, -1, -1, -1, -1];
  }
  if(cvi_cmd == (import cmd_page_margins)) {
    cvl_v = list_slice((import rbd_margins), 4 * cvi_arg, 4);
    list_splice(cvl_v, 0, 0, [-1, -1, -1]);
  }
} return int[] cvl_v;
