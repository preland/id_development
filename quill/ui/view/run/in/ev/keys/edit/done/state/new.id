// Replaces the contents of the list cvl_d with those of cvl_s, keeping the room cvl_d has grown to.
view_input_list_replace(int[] view_input_replace_target, int[] view_input_replace_source) {
  int view_input_replace_index = 0;
  layout_paragraph_clear(view_input_replace_target);
  while(view_input_replace_index < len(view_input_replace_source)) {
    push(view_input_replace_target, view_input_replace_source[view_input_replace_index]);
    view_input_replace_index = view_input_replace_index + 1;
  }
} return void;
