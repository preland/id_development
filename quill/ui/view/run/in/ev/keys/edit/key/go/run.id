// Does a key as one command: the command the table gives (a Tab with no modifier is typed, not the table's list command), then the caret movement or the text change the key is.
view_input_key_do(View view_input_doing_view, int view_input_doing_key, int view_input_doing_modifiers, int view_input_doing_command_number) {
  int view_input_doing_command_used = view_input_doing_command_number;
  if(view_input_doing_key == 1010 && view_input_doing_modifiers == 0) {
    view_input_doing_command_used = 0;
  }
  view_input_canvas_command(view_input_doing_view, view_input_doing_command_used);
} chain (View view_input_doing_view, int view_input_doing_key, int view_input_doing_modifiers, int view_input_doing_command_number) {
  view_input_key_edit(view_input_doing_view, view_input_doing_key, view_input_doing_modifiers, view_input_doing_command_used);
} return void;
