// A key (an event of kind 1: key id cvi_key, modifiers cvi_mods): when the ribbon's key table has a command for it, or it is a navigation or editing key (Escape is not), it is done as one command.
view_input_key_press(View view_input_pressed_view, int view_input_pressed_key, int view_input_pressed_modifiers) {
  int view_input_pressed_command_number = ribbon_key_command(view_input_pressed_modifiers, view_input_pressed_key);
  int view_input_pressed_proceed = view_input_pressed_command_number != 0 || (view_input_pressed_key > 1000 && view_input_pressed_key != 1011);
  if(view_input_pressed_proceed == 1) {
    view_input_command_begin(view_input_pressed_view);
    view_input_key_do(view_input_pressed_view, view_input_pressed_key, view_input_pressed_modifiers, view_input_pressed_command_number);
    view_input_command_end(view_input_pressed_view);
  }
} return void;
