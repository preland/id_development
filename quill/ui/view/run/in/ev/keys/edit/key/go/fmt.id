// Backspace (1007), Delete (1008), Enter (1009) and Tab (1010) change the text: the first two take a character or, with Ctrl (cvi_c 1), a word; Enter splits the paragraph and Tab types a tab. Any other key does nothing here.
cv_chg(View cvv, int cvi_key, int cvi_c) {
  Ctl cvc = (import vw_ctl);
  if(cvi_key == 1007) {
    ed_back(cvv.doc, cvc, cvi_c);
