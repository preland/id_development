// The formatting commands the canvas does: bold (cmd_bold), italic, underline and strikethrough toggle their flag over the selection (or for what is typed next when nothing is selected), and cmd_page_break puts a page break before the caret.
cv_fmt(View cvv, Ctl cvc, int cvi_cmd) {
  int cvi_b = cv_bit(cvi_cmd);
  if(cvi_b != 0) {
    ed_toggle(cvv.doc, cvc, cvi_b);
  }
  if(cvi_cmd == (import cmd_page_break)) {
    ed_break(cvv.doc, cvc, 1);
  }
} return void;
