    ed_delete(cvv.doc, cvc, cvi_c);
  }
} chain (View cvv, int cvi_key, int cvi_c) {
  if(cvi_key == 1009) {
    ed_break(cvv.doc, cvc, 0);
  }
  if(cvi_key == 1010) {
    ed_type(cvv.doc, cvc, (import quill_code_point_tab));
  }
} return void;
