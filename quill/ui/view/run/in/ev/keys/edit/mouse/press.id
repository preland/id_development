// A mouse event of kind cvi_kind (3 press, 4 release, 5 move) with the fields cvl_ev, and whether the page area took it (1) or the scrollbar should see it (0): a left press inside the page area starts a drag and a move or the release while one lasts goes on with it, even outside the area; a move also sets the pointer to the text I-beam over the area and the arrow elsewhere.
cv_mouse(View cvv, int cvi_kind, int[] cvl_ev) {
  int cvi_in = vw_in("canvas", cvl_ev[1], cvl_ev[2]);
  int[] cvl_e = (import vw_ed);
  int cvi_h = 0;
} chain (View cvv, int cvi_kind, int[] cvl_ev) {
  if(cvi_kind == 3 && cvi_in == 1 && cvl_ev[3] == 1) {
    cv_press(cvv, cvl_ev);
    cvi_h = 1;
  }
  if(cvi_kind == 5) {
    cvi_h = cv_move(cvv, cvl_ev, cvi_in);
  }
  if(cvi_kind == 4 && cvl_e[(import cv_e_drag)] == 1) {
    lset(cvl_e, (import cv_e_drag), 0);
    cvi_h = 1;
  }
} return int cvi_h;
