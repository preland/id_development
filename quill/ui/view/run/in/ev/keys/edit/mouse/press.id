// What a press with click count cvi_n at the position cvp does to the selection: one click puts the caret there (with Shift, cvi_mods bit 1, the selection grows to it), two select the word there and three the paragraph.
view_input_click_select(View view_input_click_view, Pos view_input_click_position, int view_input_click_count, int view_input_click_modifiers) {
  Ctl view_input_click_controller = (import view_input_controller);
  if(view_input_click_count == 2) {
    editor_select_word(view_input_click_view.doc, view_input_click_controller, view_input_click_position);
  }
  if(view_input_click_count >= 3) {
    editor_select_paragraph(view_input_click_view.doc, view_input_click_controller, view_input_click_position);
  }
} chain (View view_input_click_view, Pos view_input_click_position, int view_input_click_count, int view_input_click_modifiers) {
  if(view_input_click_count < 2) {
    editor_place(view_input_click_view.doc, view_input_click_controller, view_input_click_position, view_input_click_modifiers & 1);
  }
} return void;
