  int view_input_mouse_handled = 0;
} chain (View view_input_mouse_view, int view_input_mouse_kind, int[] view_input_mouse_event) {
  if(view_input_mouse_kind == 3 && view_input_mouse_inside == 1 && view_input_mouse_event[3] == 1) {
    view_input_press_start(view_input_mouse_view, view_input_mouse_event);
