// What a press with click count cvi_n at the position cvp does to the selection: one click puts the caret there (with Shift, cvi_mods bit 1, the selection grows to it), two select the word there and three the paragraph.
cv_pick(View cvv, Pos cvp, int cvi_n, int cvi_mods) {
  Ctl cvc = (import vw_ctl);
  if(cvi_n == 2) {
    ed_select_word(cvv.doc, cvc, cvp);
  }
  if(cvi_n >= 3) {
    ed_select_para(cvv.doc, cvc, cvp);
  }
} chain (View cvv, Pos cvp, int cvi_n, int cvi_mods) {
  if(cvi_n < 2) {
    ed_place(cvv.doc, cvc, cvp, cvi_mods & 1);
  }
} return void;
