// A press of the left button inside the page area, as one command: the position under the pointer is found, the selection is set by cv_pick from the click count and the modifiers held, and the drag that follows is begun.
cv_press(View cvv, int[] cvl_ev) {
  Pos cvp = Pos(0, 0);
  cv_hit(cvv, cvl_ev[1], cvl_ev[2], cvp);
  cv_begin(cvv);
} chain (View cvv, int[] cvl_ev) {
  cv_pick(cvv, cvp, cvl_ev[4], gfx_mods());
  lset((import vw_ed), (import cv_e_drag), 1);
  cv_end(cvv);
} return void;
