cv_flags(View cvv, Ctl cvc, int[] cvl_f) {
  int cvi_k = 0;
  while(cvi_k < len((import cv_f_bit))) {
    push(cvl_f, sel_state(cvv.doc, cvc, (import ed_s_flag) + (import cv_f_bit)[cvi_k]));
    cvi_k = cvi_k + 1;
  }
} return void;
