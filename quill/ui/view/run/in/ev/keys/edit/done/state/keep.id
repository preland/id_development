// Keeps in the list cvl_t what the layout is now, to compare with it after a command: the top of every paragraph, as pages.tops has them, and after them how far down the continuous document the last paragraph ends. (The controller's state keeps it in the export vw_tp.)
cv_keep(View cvv, int[] cvl_t) {
  cv_snap(cvl_t, cvv.pages.tops);
  int cvi_e = cv_last_y(cvv, len(cvv.doc.body.paras) - 1);
  push(cvl_t, cvi_e);
} return void;
