  int view_input_movement_below_index = view_input_movement_range[1] + 1;
  if(view_input_movement_level == 0 && view_input_movement_range[0] >= 0 && view_input_movement_below_index < view_input_movement_paragraph_count) {
    view_input_movement_level = view_input_movement_view.pages.tops[view_input_movement_below_index] != view_input_movement_kept_tops[view_input_movement_below_index];
