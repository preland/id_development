// Opens the document at the path for the viewer: it is read by odt_load, laid out and paginated, and kept as the view vw_v (exported by cv_ed_new, which also starts its editing state). A document that cannot be read leaves an empty one in its place and the message that names the fix as the one entry of vw_msg (the window shows it); a good one leaves vw_msg empty. Answers odt_load's code.
view_input_document_open(string view_input_open_path) {
  Doc view_input_open_document = doc_new();
  int view_input_open_code = odt_load(view_input_open_path, view_input_open_document);
  string view_input_open_message = "";
} chain (string view_input_open_path) {
  if(view_input_open_code != 0) {
    view_input_open_message = odt_error(view_input_open_code);
    view_input_open_document = doc_new();
  }
  View view_input_open_view = lay_view(view_input_open_document);
  lay_all(view_input_open_view);
} chain (string view_input_open_path) {
  lay_paginate(view_input_open_view, 0);
  view_input_message_keep(view_input_open_message);
  view_input_editing_start(view_input_open_view);
} return int view_input_open_code;
