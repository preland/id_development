// Opens the document at the path for the viewer: it is read by odt_load, laid out and paginated, and kept as the view vw_v (exported by cv_ed_new, which also starts its editing state). A document that cannot be read leaves an empty one in its place and the message that names the fix as the one entry of vw_msg (the window shows it); a good one leaves vw_msg empty. Answers odt_load's code.
vw_open(string vws_path) {
  Doc vwd = doc_new();
  int vwi_code = odt_load(vws_path, vwd);
  string vws_msg = "";
} chain (string vws_path) {
  if(vwi_code != 0) {
    vws_msg = odt_error(vwi_code);
    vwd = doc_new();
  }
  View vwv = lay_view(vwd);
  lay_all(vwv);
} chain (string vws_path) {
  lay_paginate(vwv, 0);
  vw_msg_new(vws_msg);
  cv_ed_new(vwv);
} return int vwi_code;
