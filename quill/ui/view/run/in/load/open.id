// Keeps the message that takes a document's place as the one entry of the export vw_msg, replacing the one before; "" when there is a document to show.
// vw_msg: Test check: the message the viewer shows in place of a document, "" when it has one.
vw_msg_new(string vws_m) {
  export string[] vw_msg = [vws_m];
} return void export vw_msg;
