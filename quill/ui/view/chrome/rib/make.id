given ribbon_faces_set(5, 6, 7) ():() then ribbon_fit_check_tip_font:(5)

// Puts the ribbon in the band the chrome gave it. Call it after every change of the surface.
view_ribbon_fit() {
  int[] view_ribbon_fit_rectangle = view_ribbon_rectangle();
  rib_fit((import view_ribbon), view_ribbon_fit_rectangle[0], view_ribbon_fit_rectangle[1], view_ribbon_fit_rectangle[2], view_ribbon_fit_rectangle[3]);
} return void;
