// The ribbon band's rectangle from the chrome as a list: x, y, width and height.
view_ribbon_rectangle() {
  int[] view_ribbon_rectangle_values = [view_box_field("ribbon", 0), view_box_field("ribbon", 1), view_box_field("ribbon", 2), view_box_field("ribbon", 3)];
} return int[] view_ribbon_rectangle_values;
given view_test_fit_chrome(800, 600) ():([0, 0, 800, 156])
given view_test_fit_chrome(1000, 700) ():([0, 0, 1000, 156])

// Starts the ribbon (B7b) in the faces rbd_ui_set gave, which are the viewer's own text's too, and keeps the ribbon of the Home tab in the export vw_rb. Call it once, after rbd_ui_set.
view_ribbon_make() {
  export Ribbon view_ribbon = ribbon_fit_start_ribbon();
} return void;
