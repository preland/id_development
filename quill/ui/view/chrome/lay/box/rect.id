// Field k (0 x, 1 y, 2 width, 3 height) of the rectangle the class vws_c got in the last layout.
view_box_field(string view_box_field_class, int view_box_field_index) {
  int view_box_field_node = gui_find_class((import view_chrome_tape), (import view_chrome_strings), view_box_field_class);
  int view_box_field_value = gui_rect_get((import view_chrome_rectangles), view_box_field_node, view_box_field_index);
} return int view_box_field_value;
