given view_test_fit_chrome(800, 600) ("vbar", 0):(784)


// 1 when the point (x, y) is inside the rectangle of class vws_c.
view_box_contains(string view_box_contains_class, int view_box_contains_column, int view_box_contains_row) {
  int view_box_contains_left = view_box_field(view_box_contains_class, 0);
  int view_box_contains_top = view_box_field(view_box_contains_class, 1);
  int view_box_contains_width = view_box_field(view_box_contains_class, 2);
} chain (string view_box_contains_class, int view_box_contains_column, int view_box_contains_row) {
  int view_box_contains_height = view_box_field(view_box_contains_class, 3);
  int view_box_contains_inside = view_box_contains_column >= view_box_contains_left && view_box_contains_column < view_box_contains_left + view_box_contains_width && view_box_contains_row >= view_box_contains_top && view_box_contains_row < view_box_contains_top + view_box_contains_height;
} return int view_box_contains_inside;
