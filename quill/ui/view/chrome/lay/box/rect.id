given view_test_fit_chrome(800, 600) ("vbar", 790, 577):(1)


// Test check: the rectangle of the ribbon band as x,y,w,h.
view_test_ribbon_rectangle() {
  string view_test_ribbon_rectangle_text = view_box_field("ribbon", 0) + "," + view_box_field("ribbon", 1) + "," + view_box_field("ribbon", 2) + "," + view_box_field("ribbon", 3);
} return string view_test_ribbon_rectangle_text;
