// Parses idml source into a fresh tape, kept in the exports vw_t (the tape), vw_s (its strings) and vw_rc (the rectangles of the last layout). Answers the parser's diagnostic, "" when the source is good.
view_chrome_load(string view_chrome_load_source) {
  export int[] view_chrome_tape = [];
  export string[] view_chrome_strings = [];
  gui_new(view_chrome_tape, view_chrome_strings);
} chain (string view_chrome_load_source) {
  int view_chrome_load_parse_result = gui_parse(view_chrome_load_source, view_chrome_tape, view_chrome_strings, "quill.idml", fs_read_text);
  export int[] view_chrome_rectangles = [];
  string view_chrome_load_diagnostic = gui_diag(view_chrome_tape, view_chrome_strings);
} return string view_chrome_load_diagnostic;
