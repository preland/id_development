// The chrome document: vw_idml parsed by vw_load. Answers the parser's diagnostic, "" when the idml is good.
view_chrome_make() {
  string view_chrome_make_source = str_join((import vw_idml), "\n");
  string view_chrome_make_diagnostic = view_chrome_load(view_chrome_make_source);
} return string view_chrome_make_diagnostic;
