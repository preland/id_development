// Parses idml source into a fresh tape, kept in the exports vw_t (the tape), vw_s (its strings) and vw_rc (the rectangles of the last layout). Answers the parser's diagnostic, "" when the source is good.
vw_load(string vws_src) {
  export int[] vw_t = [];
  export string[] vw_s = [];
  gui_new(vw_t, vw_s);
} chain (string vws_src) {
  int vwi_err = gui_parse(vws_src, vw_t, vw_s, "quill.idml", fs_read_text);
  export int[] vw_rc = [];
  string vws_diag = gui_diag(vw_t, vw_s);
} return string vws_diag;
("./\nCol()[100,100,top-left]{}\n"):("")
("./\nCol()[100,"):("2:11: a dimension is a number (a percentage of the parent, up to two decimals) or an @ref; write the number or bind it with @name")

// The chrome document: vw_idml parsed by vw_load. Answers the parser's diagnostic, "" when the idml is good.
vw_make() {
  string vws_src = str_join((import vw_idml), "\n");
  string vws_diag = vw_load(vws_src);
} return string vws_diag;
():("") then vw_t_count:("count 11")
given vw_t_ld("./\nCol()[100,100,top-left]{}\n") ():("") then vw_t_count:("count 11")

// Test setup: the tape of the idml source vws_src, whatever the parser thought of it.
vw_t_ld(string vws_src) {
  string vws_diag = vw_load(vws_src);
} return void;
("./\nCol()[100,100,top-left]{}\n"):() then vw_t_count:("count 2")
("./\nCol()[100,100,top-left]{}\nCol()[100,100,top-left]{}\n"):() then vw_t_count:("count 3")
