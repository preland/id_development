// Makes cvl_r the area list of the page area for a repaint of rows cvi_y0 to cvi_y1 - 1 of the surface: the page area's rectangle from the chrome, and the band cut to lie inside it (nothing, with its two rows equal, when they miss it). The caller makes the six-cell list, so that it is its own and is freed with it.
view_flow_set_area_rows(int view_flow_rows_first, int view_flow_rows_last, int[] view_flow_rows_area) {
  int view_flow_rows_canvas_top = view_box_field("canvas", 1);
  int view_flow_rows_canvas_height = view_box_field("canvas", 3);
  int view_flow_rows_band_top = fixed_point_clamp(view_flow_rows_first, view_flow_rows_canvas_top, view_flow_rows_canvas_top + view_flow_rows_canvas_height);
} chain (int view_flow_rows_first, int view_flow_rows_last, int[] view_flow_rows_area) {
  int view_flow_rows_band_bottom = fixed_point_clamp(view_flow_rows_last, view_flow_rows_band_top, view_flow_rows_canvas_top + view_flow_rows_canvas_height);
  lset(view_flow_rows_area, 0, view_box_field("canvas", 0));
  lset(view_flow_rows_area, 1, view_flow_rows_canvas_top);
} chain (int view_flow_rows_first, int view_flow_rows_last, int[] view_flow_rows_area) {
  lset(view_flow_rows_area, 2, view_box_field("canvas", 2));
  lset(view_flow_rows_area, 3, view_flow_rows_canvas_height);
  lset(view_flow_rows_area, 4, view_flow_rows_band_top);
} chain (int view_flow_rows_first, int view_flow_rows_last, int[] view_flow_rows_area) {
  lset(view_flow_rows_area, 5, view_flow_rows_band_bottom);
} return void;
