// Paints the page area in the band of rows its area list names: cvl_r is [x, y, width, height] of the page area and, after them, the first row of the band and the row after its last (cv_a_y0, cv_a_y1). The desk is laid over the band first and then the sheets that reach into it, all cut to the band.
view_flow_paint_area(View view_flow_area_view, int[] view_flow_area_list) {
  int view_flow_area_top = view_flow_area_list[(import cv_a_y0)];
  int view_flow_area_height = view_flow_area_list[(import cv_a_y1)] - view_flow_area_top;
  sf_l_clip(view_flow_area_list[0], view_flow_area_top, view_flow_area_list[2], view_flow_area_height);
} chain (View view_flow_area_view, int[] view_flow_area_list) {
  d2_l_rect(view_flow_area_list[0], view_flow_area_top, view_flow_area_list[2], view_flow_area_height, (import vw_c_desk));
  view_canvas_paint_pages(view_flow_area_view, view_flow_area_list);
  sf_l_unclip();
} return void;
