// Paints the part of the picture that the band of rows asked for (vw_ed) needs and no more: the page area in the band, and the status bar, whose page and word count an edit changes. The band is then empty again.
view_flow_paint_part(View view_flow_part_view) {
  int[] view_flow_part_edit_states = (import view_input_edit_state);
  int[] view_flow_part_area = [0, 0, 0, 0, 0, 0];
  view_flow_set_area_rows(view_flow_part_edit_states[(import cv_e_y0)], view_flow_part_edit_states[(import cv_e_y1)], view_flow_part_area);
} chain (View view_flow_part_view) {
  view_flow_paint_area(view_flow_part_view, view_flow_part_area);
  view_status_paint(view_flow_part_view);
  lset(view_flow_part_edit_states, (import cv_e_y0), 0 - 1);
} chain (View view_flow_part_view) {
  lset(view_flow_part_edit_states, (import cv_e_y1), 0 - 1);
} return void;
