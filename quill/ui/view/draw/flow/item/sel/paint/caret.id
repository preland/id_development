// Paints the caret as a bar one pixel wide and as tall as its line, at the pixel the pen of its code point is on, the page's geometry cvl_g and the caret's [page, x, y, height] cvl_o in lu from the top left of the sheet.
view_flow_paint_caret_bar(int[] view_flow_bar_caret, int[] view_flow_bar_geometry) {
  int view_flow_bar_scale = view_flow_bar_geometry[(import vw_g_z)];
  int view_flow_bar_left = view_flow_bar_geometry[(import vw_g_x)] + view_units_pixels(view_flow_bar_caret[1], view_flow_bar_scale);
  int view_flow_bar_top = view_flow_bar_geometry[(import vw_g_y)] + view_units_pixels(view_flow_bar_caret[2], view_flow_bar_scale);
} chain (int[] view_flow_bar_caret, int[] view_flow_bar_geometry) {
  int view_flow_bar_height = fixed_point_maximum(view_units_pixels(view_flow_bar_caret[3], view_flow_bar_scale), 1);
  d2_l_rect(view_flow_bar_left, view_flow_bar_top, 1, view_flow_bar_height, (import cv_c_caret));
} return void;
