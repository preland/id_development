// Paints the caret of the controller if it is on page cvi_k (whose geometry is cvl_g) and in the solid half of its blink.
view_flow_paint_caret_page(View view_flow_caret_view, int view_flow_caret_page, int[] view_flow_caret_geometry) {
  int[] view_flow_caret_position = [0, 0, 0, 0];
  view_input_caret_place(view_flow_caret_view, view_flow_caret_position);
  if(view_flow_caret_position[0] == view_flow_caret_page && view_input_caret_visible() == 1) {
    view_flow_paint_caret_bar(view_flow_caret_position, view_flow_caret_geometry);
  }
} return void;
