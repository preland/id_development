// Paints what lies over the text of page cvi_k, whose geometry is cvl_g: the selection, then the caret.
view_flow_paint_over(View view_flow_over_view, int view_flow_over_page, int[] view_flow_over_geometry) {
  view_flow_paint_selection_page(view_flow_over_view, view_flow_over_page, view_flow_over_geometry);
  view_flow_paint_caret_page(view_flow_over_view, view_flow_over_page, view_flow_over_geometry);
} return void;
