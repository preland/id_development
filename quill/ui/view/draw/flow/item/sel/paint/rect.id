// Paints the rectangles cvl_o holds (cvi_n of them) one after another on the page whose geometry is cvl_g.
view_flow_paint_selection_rectangles(int[] view_flow_rectangles_list, int view_flow_rectangles_count, int[] view_flow_rectangles_geometry) {
  int view_flow_rectangles_index = 0;
  while(view_flow_rectangles_index < view_flow_rectangles_count) {
    view_flow_paint_selection_rectangle(view_flow_rectangles_list, view_flow_rectangles_index, view_flow_rectangles_geometry);
    view_flow_rectangles_index = view_flow_rectangles_index + 1;
  }
} return void;
