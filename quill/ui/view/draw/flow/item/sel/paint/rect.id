// Paints the selection of the controller on page cvi_k, whose geometry is cvl_g: a rectangle for each line of the page that it covers, as the layout's lay_sel_rects gives them.
view_flow_paint_selection_page(View view_flow_selection_page_view, int view_flow_selection_page_index, int[] view_flow_selection_page_geometry) {
  Ctl view_flow_selection_page_controller = (import view_input_controller);
  int[] view_flow_selection_page_rectangles = [];
  int view_flow_selection_page_count = layout_page_selection_rectangles(view_flow_selection_page_view, view_flow_selection_page_controller.sel, view_flow_selection_page_index, view_flow_selection_page_rectangles);
} chain (View view_flow_selection_page_view, int view_flow_selection_page_index, int[] view_flow_selection_page_geometry) {
  view_flow_paint_selection_rectangles(view_flow_selection_page_rectangles, view_flow_selection_page_count, view_flow_selection_page_geometry);
} return void;
