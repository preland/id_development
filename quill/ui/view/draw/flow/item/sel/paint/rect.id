// Paints rectangle cvi_k of the flat list cvl_o ([x, y, width, height] each in lu from the top left of the sheet) on the page whose geometry is cvl_g, in the selection's colour with its coverage, so that the text under it shows through. The corners are rounded to pixels as the text is, and it is at least one pixel in each direction.
view_flow_paint_selection_rectangle(int[] view_flow_rectangle_list, int view_flow_rectangle_index, int[] view_flow_rectangle_geometry) {
  int view_flow_rectangle_scale = view_flow_rectangle_geometry[(import vw_g_z)];
  int view_flow_rectangle_left = view_flow_rectangle_geometry[(import vw_g_x)] + view_units_pixels(view_flow_rectangle_list[4 * view_flow_rectangle_index], view_flow_rectangle_scale);
  int view_flow_rectangle_top = view_flow_rectangle_geometry[(import vw_g_y)] + view_units_pixels(view_flow_rectangle_list[4 * view_flow_rectangle_index + 1], view_flow_rectangle_scale);
} chain (int[] view_flow_rectangle_list, int view_flow_rectangle_index, int[] view_flow_rectangle_geometry) {
  int view_flow_rectangle_right = view_flow_rectangle_geometry[(import vw_g_x)] + view_units_pixels(view_flow_rectangle_list[4 * view_flow_rectangle_index] + view_flow_rectangle_list[4 * view_flow_rectangle_index + 2], view_flow_rectangle_scale);
  int view_flow_rectangle_bottom = view_flow_rectangle_geometry[(import vw_g_y)] + view_units_pixels(view_flow_rectangle_list[4 * view_flow_rectangle_index + 1] + view_flow_rectangle_list[4 * view_flow_rectangle_index + 3], view_flow_rectangle_scale);
  int view_flow_rectangle_width = fixed_point_maximum(view_flow_rectangle_right - view_flow_rectangle_left, 1);
} chain (int[] view_flow_rectangle_list, int view_flow_rectangle_index, int[] view_flow_rectangle_geometry) {
  surface_blend_rectangle(view_flow_rectangle_left, view_flow_rectangle_top, view_flow_rectangle_width, fixed_point_maximum(view_flow_rectangle_bottom - view_flow_rectangle_top, 1), (import cv_c_sel), (import cv_sel_a));
} return void;
