  }
} chain (int[] view_flow_mark_text, int[] view_flow_mark_look, int view_flow_mark_index, int view_flow_mark_left, int view_flow_mark_baseline) {
  gui_cp_draw(view_flow_mark_look[(import vw_q_fh)], view_flow_mark_left, view_flow_mark_baseline, view_flow_mark_code_point, view_flow_mark_look[(import vw_q_col)]);
  int view_flow_mark_advance = gui_cp_adv(view_flow_mark_look[(import vw_q_fh)], view_flow_mark_code_point, view_flow_mark_following);
  int view_flow_mark_next = view_flow_mark_left + view_flow_mark_advance;
} return int view_flow_mark_next;
