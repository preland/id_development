// Draws the code points of a label one after another from x (in 64ths of a pixel) on the baseline vwi_b, in the look vwl_q.
view_flow_draw_marks(int[] view_flow_marks_text, int[] view_flow_marks_look, int view_flow_marks_start, int view_flow_marks_baseline) {
  int view_flow_marks_index = 0;
  int view_flow_marks_next = view_flow_marks_start;
  while(view_flow_marks_index < len(view_flow_marks_text)) {
    view_flow_marks_next = view_flow_draw_mark(view_flow_marks_text, view_flow_marks_look, view_flow_marks_index, view_flow_marks_next, view_flow_marks_baseline);
    view_flow_marks_index = view_flow_marks_index + 1;
  }
} return void;
