// Draws the code points of a label one after another from x (in 64ths of a pixel) on the baseline vwi_b, in the look vwl_q.
vw_marks(int[] vwl_lb, int[] vwl_q, int vwi_x, int vwi_b) {
  int vwi_k = 0;
  int vwi_nx = vwi_x;
  while(vwi_k < len(vwl_lb)) {
    vwi_nx = vw_mark(vwl_lb, vwl_q, vwi_k, vwi_nx, vwi_b);
    vwi_k = vwi_k + 1;
  }
} return void;
