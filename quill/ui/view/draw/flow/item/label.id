// Draws code point vwi_k of a label at x (64ths of a pixel) and answers where the next one starts: its advance on, kerned against the code point after it.
vw_mark(int[] vwl_lb, int[] vwl_q, int vwi_k, int vwi_x, int vwi_b) {
  int vwi_cp = vwl_lb[vwi_k];
  int vwi_after = 0;
  if(vwi_k + 1 < len(vwl_lb)) {
    vwi_after = vwl_lb[vwi_k + 1];
  }
} chain (int[] vwl_lb, int[] vwl_q, int vwi_k, int vwi_x, int vwi_b) {
  gui_cp_draw(vwl_q[(import vw_q_fh)], vwi_x, vwi_b, vwi_cp, vwl_q[(import vw_q_col)]);
  int vwi_adv = gui_cp_adv(vwl_q[(import vw_q_fh)], vwi_cp, vwi_after);
  int vwi_nx = vwi_x + vwi_adv;
} return int vwi_nx;
