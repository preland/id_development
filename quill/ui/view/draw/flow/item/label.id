// Draws code point vwi_k of a label at x (64ths of a pixel) and answers where the next one starts: its advance on, kerned against the code point after it.
view_flow_draw_mark(int[] view_flow_mark_text, int[] view_flow_mark_look, int view_flow_mark_index, int view_flow_mark_left, int view_flow_mark_baseline) {
  int view_flow_mark_code_point = view_flow_mark_text[view_flow_mark_index];
