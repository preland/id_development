// Draws lines vwi_jf to vwi_jt - 1 of paragraph vwi_p, one after the other.
view_flow_draw_lines(View view_flow_lines_view, int view_flow_lines_paragraph, int[] view_flow_lines_geometry, int view_flow_lines_base, int view_flow_lines_first, int view_flow_lines_end) {
  int view_flow_lines_current = view_flow_lines_first;
  while(view_flow_lines_current < view_flow_lines_end) {
    view_line_paint(view_flow_lines_view, view_flow_lines_paragraph, view_flow_lines_geometry, view_flow_lines_base, view_flow_lines_current);
    view_flow_lines_current = view_flow_lines_current + 1;
  }
} return void;
