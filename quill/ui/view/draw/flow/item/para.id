// Draws lines vwi_jf to vwi_jt - 1 of paragraph vwi_p, whose own top is vwi_base lu down the page: an object as its box (when its one line is on this page), a list item's label before its first line, then the lines.
view_flow_draw_paragraph(View view_flow_paragraph_view, int view_flow_paragraph_index, int[] view_flow_paragraph_geometry, int view_flow_paragraph_base_offset, int view_flow_paragraph_first_line, int view_flow_paragraph_end_line) {
  int view_flow_paragraph_is_object = layout_page_is_object(view_flow_paragraph_view.doc, view_flow_paragraph_index);
  if(view_flow_paragraph_is_object == 1 && view_flow_paragraph_first_line == 0) {
    view_flow_draw_object(view_flow_paragraph_view, view_flow_paragraph_index, view_flow_paragraph_geometry, view_flow_paragraph_base_offset);
  }
  if(view_flow_paragraph_is_object == 0 && view_flow_paragraph_first_line == 0) {
    view_flow_draw_label(view_flow_paragraph_view, view_flow_paragraph_index, view_flow_paragraph_geometry, view_flow_paragraph_base_offset);
  }
} chain (View view_flow_paragraph_view, int view_flow_paragraph_index, int[] view_flow_paragraph_geometry, int view_flow_paragraph_base_offset, int view_flow_paragraph_first_line, int view_flow_paragraph_end_line) {
  if(view_flow_paragraph_is_object == 0) {
    view_flow_draw_lines(view_flow_paragraph_view, view_flow_paragraph_index, view_flow_paragraph_geometry, view_flow_paragraph_base_offset, view_flow_paragraph_first_line, view_flow_paragraph_end_line);
  }
} return void;
