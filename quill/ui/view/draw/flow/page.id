  int view_flow_base_result = view_flow_base_view.pages.tops[view_flow_base_paragraph] - view_flow_base_page * (lay_sheet(view_flow_base_view.doc, 1) + (import quill_layout_sheet_gap)) - lay_margin(view_flow_base_view.doc, 0);
} chain (View view_flow_base_view, int view_flow_base_page, int view_flow_base_paragraph) {
  if(view_flow_base_paragraph == view_flow_base_start_paragraph && view_flow_base_first_line > 0) {
    view_flow_base_result = 0 - view_flow_base_view.doc.body.paras[view_flow_base_paragraph].lay.lines[view_flow_base_first_line * (import quill_line_stride) + (import quill_line_y)];
  }
} return int view_flow_base_result;
