// Draws page vwi_k of the view on the sheet whose geometry is vwl_g: the paragraphs that start on the page and the ones that go on over it, the lines of each that Pages put there.
view_flow_draw_page(View view_flow_page_view, int view_flow_page_index, int[] view_flow_page_geometry) {
  int view_flow_page_paragraph = view_flow_page_view.pages.starts[2 * view_flow_page_index];
  int view_flow_page_next_paragraph = view_flow_page_view.pages.starts[2 * view_flow_page_index + 2];
  int view_flow_page_next_line = view_flow_page_view.pages.starts[2 * view_flow_page_index + 3];
} chain (View view_flow_page_view, int view_flow_page_index, int[] view_flow_page_geometry) {
  int view_flow_page_end = view_flow_page_next_paragraph + (view_flow_page_next_line > 0);
  while(view_flow_page_paragraph < view_flow_page_end && view_flow_page_paragraph < len(view_flow_page_view.doc.body.paras)) {
    view_flow_draw_paragraph_on_page(view_flow_page_view, view_flow_page_index, view_flow_page_paragraph, view_flow_page_geometry);
    view_flow_page_paragraph = view_flow_page_paragraph + 1;
  }
} return void;
