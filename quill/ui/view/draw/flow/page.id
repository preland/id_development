// Draws the lines of paragraph vwi_p that belong on page vwi_k: from the line the page starts at when the paragraph carries on from the page before, to the line the next page starts at when the paragraph goes on after it, else all of them.
view_flow_draw_paragraph_on_page(View view_flow_one_view, int view_flow_one_page, int view_flow_one_paragraph, int[] view_flow_one_geometry) {
  int view_flow_one_first_line = 0;
  int view_flow_one_end_line = len(view_flow_one_view.doc.body.paras[view_flow_one_paragraph].lay.lines) / (import quill_line_stride);
  if(view_flow_one_paragraph == view_flow_one_view.pages.starts[2 * view_flow_one_page]) {
    view_flow_one_first_line = view_flow_one_view.pages.starts[2 * view_flow_one_page + 1];
  }
} chain (View view_flow_one_view, int view_flow_one_page, int view_flow_one_paragraph, int[] view_flow_one_geometry) {
  if(view_flow_one_paragraph == view_flow_one_view.pages.starts[2 * view_flow_one_page + 2]) {
    view_flow_one_end_line = view_flow_one_view.pages.starts[2 * view_flow_one_page + 3];
  }
  int view_flow_one_base = view_flow_paragraph_base(view_flow_one_view, view_flow_one_page, view_flow_one_paragraph);
  int view_flow_one_seen = view_flow_paragraph_seen(view_flow_one_view, view_flow_one_paragraph, view_flow_one_geometry, view_flow_one_base);
} chain (View view_flow_one_view, int view_flow_one_page, int view_flow_one_paragraph, int[] view_flow_one_geometry) {
  if(view_flow_one_seen == 1) {
    view_flow_draw_paragraph(view_flow_one_view, view_flow_one_paragraph, view_flow_one_geometry, view_flow_one_base, view_flow_one_first_line, view_flow_one_end_line);
  }
} return void;
