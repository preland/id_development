// The part of the rows cvi_y to cvi_y + cvi_h - 1 that lies in the band of rows cvi_c0 to cvi_c1 - 1, as its first row when cvi_k is 0 and how many rows it is when cvi_k is 1 (none, how many 0, when they do not meet).
cv_span(int cvi_y, int cvi_h, int cvi_c0, int cvi_c1, int cvi_k) {
  int cvi_a = fixed_point_maximum(cvi_y, cvi_c0);
  int cvi_b = fixed_point_minimum(cvi_y + cvi_h, cvi_c1);
  int cvi_s = cvi_a * (cvi_k == 0) + fixed_point_maximum(cvi_b - cvi_a, 0) * (cvi_k == 1);
} return int cvi_s;
(10, 20, 0, 100, 0):(10)
(10, 20, 0, 100, 1):(20)
(10, 20, 0, 15, 1):(5)
(10, 20, 40, 60, 0):(40)
(10, 20, 40, 60, 1):(0)
