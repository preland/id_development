// A sheet of paper at (x, y), w by h pixels, over the desk: its shadow first, offset down and right and blended over what is there, then the white sheet. Only the rows from vwi_c0 to vwi_c1 - 1 (the band being painted) are drawn, since the primitives test the clip a pixel at a time and a whole sheet is a million of them.
vw_sheet(int vwi_x, int vwi_y, int vwi_w, int vwi_h, int vwi_c0, int vwi_c1) {
  int vwi_o = (import vw_shadow_off);
  int vwi_s0 = cv_span(vwi_y + vwi_o, vwi_h, vwi_c0, vwi_c1, 0);
  int vwi_s1 = cv_span(vwi_y + vwi_o, vwi_h, vwi_c0, vwi_c1, 1);
} chain (int vwi_x, int vwi_y, int vwi_w, int vwi_h, int vwi_c0, int vwi_c1) {
  d2_l_arect(vwi_x + vwi_o, vwi_s0, vwi_w, vwi_s1, 0, (import vw_shadow_a));
  int vwi_p0 = cv_span(vwi_y, vwi_h, vwi_c0, vwi_c1, 0);
  int vwi_p1 = cv_span(vwi_y, vwi_h, vwi_c0, vwi_c1, 1);
} chain (int vwi_x, int vwi_y, int vwi_w, int vwi_h, int vwi_c0, int vwi_c1) {
  d2_l_rect(vwi_x, vwi_p0, vwi_w, vwi_p1, (import vw_c_sheet));
} return void;
