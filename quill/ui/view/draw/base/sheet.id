// A sheet of paper at (x, y), w by h pixels, over the desk: its shadow first, offset down and right and blended over what is there, then the white sheet. Only the rows from vwi_c0 to vwi_c1 - 1 (the band being painted) are drawn, since the primitives test the clip a pixel at a time and a whole sheet is a million of them.
view_sheet_paint(int view_sheet_paint_column, int view_sheet_paint_row, int view_sheet_paint_width, int view_sheet_paint_height, int view_sheet_paint_band_start, int view_sheet_paint_band_end) {
  int view_sheet_paint_shadow_offset = (import vw_shadow_off);
  int view_sheet_paint_shadow_first = view_sheet_band_span(view_sheet_paint_row + view_sheet_paint_shadow_offset, view_sheet_paint_height, view_sheet_paint_band_start, view_sheet_paint_band_end, 0);
  int view_sheet_paint_shadow_count = view_sheet_band_span(view_sheet_paint_row + view_sheet_paint_shadow_offset, view_sheet_paint_height, view_sheet_paint_band_start, view_sheet_paint_band_end, 1);
} chain (int view_sheet_paint_column, int view_sheet_paint_row, int view_sheet_paint_width, int view_sheet_paint_height, int view_sheet_paint_band_start, int view_sheet_paint_band_end) {
  surface_blend_rectangle(view_sheet_paint_column + view_sheet_paint_shadow_offset, view_sheet_paint_shadow_first, view_sheet_paint_width, view_sheet_paint_shadow_count, 0, (import vw_shadow_a));
  int view_sheet_paint_sheet_first = view_sheet_band_span(view_sheet_paint_row, view_sheet_paint_height, view_sheet_paint_band_start, view_sheet_paint_band_end, 0);
  int view_sheet_paint_sheet_count = view_sheet_band_span(view_sheet_paint_row, view_sheet_paint_height, view_sheet_paint_band_start, view_sheet_paint_band_end, 1);
} chain (int view_sheet_paint_column, int view_sheet_paint_row, int view_sheet_paint_width, int view_sheet_paint_height, int view_sheet_paint_band_start, int view_sheet_paint_band_end) {
  surface_fill_rectangle(view_sheet_paint_column, view_sheet_paint_sheet_first, view_sheet_paint_width, view_sheet_paint_sheet_count, (import vw_c_sheet));
} return void;
