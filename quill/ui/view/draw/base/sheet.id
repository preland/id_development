// The part of the rows cvi_y to cvi_y + cvi_h - 1 that lies in the band of rows cvi_c0 to cvi_c1 - 1, as its first row when cvi_k is 0 and how many rows it is when cvi_k is 1 (none, how many 0, when they do not meet).
view_sheet_band_span(int view_sheet_band_span_row, int view_sheet_band_span_height, int view_sheet_band_span_band_start, int view_sheet_band_span_band_end, int view_sheet_band_span_kind) {
  int view_sheet_band_span_start = fixed_point_maximum(view_sheet_band_span_row, view_sheet_band_span_band_start);
  int view_sheet_band_span_end = fixed_point_minimum(view_sheet_band_span_row + view_sheet_band_span_height, view_sheet_band_span_band_end);
  int view_sheet_band_span_result = view_sheet_band_span_start * (view_sheet_band_span_kind == 0) + fixed_point_maximum(view_sheet_band_span_end - view_sheet_band_span_start, 0) * (view_sheet_band_span_kind == 1);
} return int view_sheet_band_span_result;
