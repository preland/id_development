// Paints the part of run vwi_ri (which starts at code point vwi_rs) that lies on line vwi_j of paragraph vwi_p, and answers where the run ends. The end of the segment is the pen of the next code point, or the end of the line's visible text for the last one.
vw_run(View vwv, int vwi_p, int[] vwl_g, int vwi_j, int vwi_ri, int vwi_rs, int vwi_base) {
  Para vwp = vwv.doc.body.paras[vwi_p];
  int vwi_o = vwi_j * (import quill_line_stride);
  int vwi_re = vwi_rs + vwp.txt.runs[vwi_ri].len;
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_j, int vwi_ri, int vwi_rs, int vwi_base) {
  int vwi_lo = vwp.lay.lines[vwi_o + (import quill_line_low)];
  int vwi_hi = vwp.lay.lines[vwi_o + (import quill_line_high)];
  int vwi_xe = vwp.lay.pen[vwi_lo] + vwp.lay.lines[vwi_o + (import quill_line_width)];
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_j, int vwi_ri, int vwi_rs, int vwi_base) {
  int vwi_a = fixed_point_maximum(vwi_rs, vwi_lo);
  int vwi_b = fixed_point_minimum(vwi_re, vwi_hi);
  vw_cut(vwv, vwi_p, vwl_g, vwi_ri, vwi_a, vwi_b, vwi_xe, vwi_hi, vwi_base);
} return int vwi_re;
