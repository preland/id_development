// Paints the code points vwi_a to vwi_b - 1 of run vwi_ri of paragraph vwi_p, which end at pen position vwi_xe, on the baseline vwi_base: the highlight behind, the glyphs, the underline and the strike over them. A raised or dropped run (super and subscript) sits off the baseline by its lift.
vw_seg(View vwv, int vwi_p, int[] vwl_g, int vwi_ri, int vwi_a, int vwi_b, int vwi_xe, int vwi_base) {
  int[] vwl_q = [0, 0, 0, 0, 0, 0];
  vw_look(vwv, vwi_p, vwi_ri, vwl_g[(import vw_g_z)], vwl_q);
  vw_ink(vwv, vwi_p, vwi_ri, vwl_q);
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_ri, int vwi_a, int vwi_b, int vwi_xe, int vwi_base) {
  int vwi_lift = lp_rlift(vwv, vwi_p, vwi_ri);
  int vwi_y = vwi_base - vw_px(vwi_lift, vwl_g[(import vw_g_z)]);
  int vwi_x0 = vw_x(vwl_g, vwv.doc.body.paras[vwi_p].lay.pen[vwi_a]);
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_ri, int vwi_a, int vwi_b, int vwi_xe, int vwi_base) {
  int vwi_x1 = vw_x(vwl_g, vwi_xe);
  vw_hl(vwl_q, vwi_x0, vwi_x1, vwi_y);
  vw_glyphs(vwv, vwi_p, vwl_g, vwl_q, vwi_a, vwi_b, vwi_y);
} chain (View vwv, int vwi_p, int[] vwl_g, int vwi_ri, int vwi_a, int vwi_b, int vwi_xe, int vwi_base) {
  vw_decor(vwl_q, vwi_x0, vwi_x1, vwi_y);
} return void;
