// Paints the segment a to b of a run when it is not empty, ending at the pen of the next code point unless it reaches vwi_hi, the end of the line, where it ends at vwi_xe.
vw_cut(View vwv, int vwi_p, int[] vwl_g, int vwi_ri, int vwi_a, int vwi_b, int vwi_xe, int vwi_hi, int vwi_base) {
  int vwi_e = vwi_xe;
  if(vwi_b < vwi_hi) {
    vwi_e = vwv.doc.body.paras[vwi_p].lay.pen[vwi_b];
  }
  if(vwi_a < vwi_b) {
    vw_seg(vwv, vwi_p, vwl_g, vwi_ri, vwi_a, vwi_b, vwi_e, vwi_base);
  }
} return void;
