// Draws the code points vwi_a to vwi_b - 1 of paragraph vwi_p on the baseline vwi_base, each at its own pen position, in the face and the colour of the look vwl_q.
vw_glyphs(View vwv, int vwi_p, int[] vwl_g, int[] vwl_q, int vwi_a, int vwi_b, int vwi_base) {
  int[] vwl_pen = vwv.doc.body.paras[vwi_p].lay.pen;
  int[] vwl_cps = vwv.doc.body.paras[vwi_p].txt.cps;
  int vwi_k = vwi_a;
} chain (View vwv, int vwi_p, int[] vwl_g, int[] vwl_q, int vwi_a, int vwi_b, int vwi_base) {
  while(vwi_k < vwi_b) {
    vw_glyph(vwl_g, vwl_q, vwl_cps[vwi_k], vwl_pen[vwi_k], vwi_base);
    vwi_k = vwi_k + 1;
  }
} return void;
