// The underline and the strike of a run segment from vwi_x0 to vwi_x1 over the baseline vwi_b, when the flag bits of its look ask for them: the underline a sixteenth of the face below the baseline, the strike three tenths of the ascent above it.
vw_decor(int[] vwl_q, int vwi_x0, int vwi_x1, int vwi_b) {
  int vwi_f = vwl_q[(import vw_q_asc)] + vwl_q[(import vw_q_desc)];
  if((vwl_q[(import vw_q_bits)] & 4) != 0) {
    vw_rule(vwl_q, vwi_x0, vwi_x1, vwi_b + 1 + vwi_f / 16);
  }
  if((vwl_q[(import vw_q_bits)] & 8) != 0) {
    vw_rule(vwl_q, vwi_x0, vwi_x1, vwi_b - vwl_q[(import vw_q_asc)] * 3 / 10);
  }
} return void;
