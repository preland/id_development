// The tooltip, as an export: one for the whole ribbon, in the regular face, so that there is one at a time.
ribbon_fit_create_tip() {
  export GuiTip[] ribbon_fit_tips = [];
  int ribbon_fit_tip_face = (import ribbon_faces)[0];
  GuiTip ribbon_fit_new_tip = gui_tip_new(ribbon_fit_tip_face);
} chain () {
  push((import ribbon_fit_tips), ribbon_fit_new_tip);
} return void;
