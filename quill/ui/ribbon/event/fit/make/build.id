// Makes a widget for every control of the ribbon rib, in the order of its controls, replacing those in rbl_ws.
ribbon_fit_make_widgets(Ribbon rib, GuiToggle[] ribbon_fit_widgets_list) {
  int ribbon_fit_widgets_index = 0;
  while(len(ribbon_fit_widgets_list) > 0) {
    pop(ribbon_fit_widgets_list);
  }
  while(ribbon_fit_widgets_index < len(rib.items)) {
    ribbon_fit_make_widget(rib, ribbon_fit_widgets_list, ribbon_fit_widgets_index);
    ribbon_fit_widgets_index = ribbon_fit_widgets_index + 1;
  }
} return void;
