// Makes the widget for control rbi_i of the ribbon rib at the rectangle it was placed at, in the ribbon's regular face, and keeps it after the others in rbl_ws: its body is the whole rectangle less the arrow strip of a split button, and none at all for a combo box, which is a widget of its own (rbd_cb) and must not meet the pointer twice.
ribbon_fit_make_widget(Ribbon rib, GuiToggle[] ribbon_fit_make_list, int ribbon_fit_make_control) {
  int ribbon_fit_make_row = rib.items[ribbon_fit_make_control];
  int ribbon_fit_make_cell = ribbon_fit_make_control * 4;
  GuiToggle ribbon_fit_make_toggle = gui_toggle_new(ribbon_fit_control_label(ribbon_fit_make_row), (import rb_icon)[ribbon_fit_make_row], (import rb_cmd)[ribbon_fit_make_row], 0);
} chain (Ribbon rib, GuiToggle[] ribbon_fit_make_list, int ribbon_fit_make_control) {
