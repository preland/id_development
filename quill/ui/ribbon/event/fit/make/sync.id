// Makes the widget rbg follow the state rbi_st of its control: a toggle shows on (1) or mixed (2) and is off for any other state, and the control is enabled unless the state is disabled (3).
ribbon_fit_sync_widget(GuiToggle ribbon_fit_one_widget, int ribbon_fit_one_state) {
  int ribbon_fit_one_enabled = ribbon_fit_one_state != 3;
  gui_tgl_set(ribbon_fit_one_widget, (ribbon_fit_one_state == 1 || ribbon_fit_one_state == 2) * ribbon_fit_one_state);
  if(gui_btn_cell(ribbon_fit_one_widget.btn, 5) != ribbon_fit_one_enabled) {
    gui_btn_enable(ribbon_fit_one_widget.btn, ribbon_fit_one_enabled);
  }
} return void;
