// Makes every widget in rbl_ws follow the state of the control it stands for in the ribbon rib.
ribbon_fit_sync_widget_list(Ribbon rib, GuiToggle[] ribbon_fit_follow_widgets) {
  int ribbon_fit_follow_index = 0;
  while(ribbon_fit_follow_index < len(ribbon_fit_follow_widgets)) {
    ribbon_fit_sync_widget(ribbon_fit_follow_widgets[ribbon_fit_follow_index], rib.state[ribbon_fit_follow_index]);
    ribbon_fit_follow_index = ribbon_fit_follow_index + 1;
  }
} return void;
