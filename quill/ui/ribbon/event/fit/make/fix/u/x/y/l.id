// Test check: how many of the tooltips of the controls of tab rbi_tab are empty or lack their shortcut. Taken from a ribbon built for the tab, not placed.
ribbon_fit_count_bad_tab(int ribbon_fit_tab_checked) {
  Ribbon ribbon_fit_tab_ribbon = rib_build(ribbon_fit_tab_checked);
  int ribbon_fit_tab_bad_count = 0;
  int ribbon_fit_tab_control = 0;
} chain (int ribbon_fit_tab_checked) {
  while(ribbon_fit_tab_control < len(ribbon_fit_tab_ribbon.items)) {
    ribbon_fit_tab_bad_count = ribbon_fit_tab_bad_count + ribbon_fit_count_bad_row(ribbon_fit_tab_ribbon, ribbon_fit_tab_control);
    ribbon_fit_tab_control = ribbon_fit_tab_control + 1;
  }
} return int ribbon_fit_tab_bad_count;
(1):(0)
(5):(0)

// Test check: how many of the tooltips of every tab, up to tab rbi_last, are empty or lack their shortcut.
ribbon_fit_count_bad_tabs(int ribbon_fit_last_tab) {
  int ribbon_fit_all_bad_count = 0;
  int ribbon_fit_all_tab = 0;
  while(ribbon_fit_all_tab <= ribbon_fit_last_tab) {
    ribbon_fit_all_bad_count = ribbon_fit_all_bad_count + ribbon_fit_count_bad_tab(ribbon_fit_all_tab);
    ribbon_fit_all_tab = ribbon_fit_all_tab + 1;
  }
} return int ribbon_fit_all_bad_count;
(5):(0)
(3):(0)
(0):(0)
