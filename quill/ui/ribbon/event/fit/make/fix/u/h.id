// Test setup: a tap on the control at index rbi_i of the open tab, rbi_dx pixels right of the middle of its rectangle: a press and a release there, the ribbon in rbd_t_r getting both.
ribbon_fit_tap_control(int ribbon_fit_tap_index, int ribbon_fit_tap_offset) {
  Ribbon ribbon_fit_tap_ribbon = (import ribbon_fit_test_ribbon);
  int ribbon_fit_tap_cell = ribbon_fit_tap_index * 4;
  int ribbon_fit_tap_column = ribbon_fit_tap_ribbon.ribbon_rectangles[ribbon_fit_tap_cell] + ribbon_fit_tap_ribbon.ribbon_rectangles[ribbon_fit_tap_cell + 2] / 2 + ribbon_fit_tap_offset;
} chain (int ribbon_fit_tap_index, int ribbon_fit_tap_offset) {
  int ribbon_fit_tap_row = ribbon_fit_tap_ribbon.ribbon_rectangles[ribbon_fit_tap_cell + 1] + ribbon_fit_tap_ribbon.ribbon_rectangles[ribbon_fit_tap_cell + 3] / 2;
  ribbon_fit_send_mouse_event(3, ribbon_fit_tap_column, ribbon_fit_tap_row);
  ribbon_fit_send_mouse_event(4, ribbon_fit_tap_column, ribbon_fit_tap_row);
} return void;
