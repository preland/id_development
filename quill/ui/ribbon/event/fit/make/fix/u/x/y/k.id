// Test check: 1 when the tooltip of control rbi_i of the ribbon rbr is empty or lacks the shortcut of its row.
ribbon_fit_count_bad_row(Ribbon ribbon_fit_row_ribbon, int ribbon_fit_row_control) {
  string ribbon_fit_row_text = ribbon_tip_text(ribbon_fit_row_ribbon, ribbon_fit_row_control);
  int ribbon_fit_row_bad = ribbon_fit_count_bad_tip(ribbon_fit_row_text, (import rb_key)[ribbon_fit_row_ribbon.items[ribbon_fit_row_control]]);
} return int ribbon_fit_row_bad;
