// Test check: 1 when the tooltip text rbs_t is empty, or when the row has a shortcut (the key code rbi_code is not 0) that the text does not hold; 0 for a tooltip that is as it should be.
ribbon_fit_count_bad_tip(string ribbon_fit_tip_text, int ribbon_fit_tip_key_code) {
  int ribbon_fit_tip_empty = len(ribbon_fit_tip_text) == 0;
  int ribbon_fit_tip_lacks_key = ribbon_fit_tip_key_code != 0 && string_find(ribbon_fit_tip_text, key_text(ribbon_fit_tip_key_code)) < 0;
  int ribbon_fit_tip_bad = ribbon_fit_tip_empty || ribbon_fit_tip_lacks_key;
} return int ribbon_fit_tip_bad;
