// Test check: the rectangles of the open menu, gallery or the open list of the combo box that has the keyboard: its box, then each choice, then what follows them; none when nothing is open.
ribbon_fit_open_popup_rectangles() {
  int ribbon_fit_rectangles_open_kind = (import ribbon_fit_state)[(import rbd_s_pk)];
  int[] ribbon_fit_rectangles_list = [];
  if(ribbon_fit_rectangles_open_kind == 1) {
    GuiMenu ribbon_fit_rectangles_menu = (import ribbon_fit_menus)[0];
    ribbon_fit_rectangles_list = ribbon_fit_rectangles_menu.rects;
  }
} chain () {
  if(ribbon_fit_rectangles_open_kind == 2) {
    GuiGallery ribbon_fit_rectangles_gallery = (import ribbon_fit_galleries)[0];
    ribbon_fit_rectangles_list = ribbon_fit_rectangles_gallery.rects;
  }
  if(ribbon_fit_rectangles_open_kind == 0 && (import ribbon_fit_focused_combo)[0] >= 0) {
    GuiCombo ribbon_fit_rectangles_combo = (import ribbon_fit_combos)[(import ribbon_fit_focused_combo)[0]];
    ribbon_fit_rectangles_list = ribbon_fit_rectangles_combo.list.rects;
  }
} return int[] ribbon_fit_rectangles_list;
