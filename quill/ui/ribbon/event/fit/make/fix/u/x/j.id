// Test check: whether the Home tab fits the width of the surface, and how many of its rectangles overlap another, comma separated.
rbd_t_hf() {
  Ribbon rbr = (import rbd_t_r);
  int rbi_f = rib_fits(rbr, (import sf_l_w));
  int rbi_o = rects_overlap(rbr.rects, len(rbr.items));
} chain () {
  string rbs_z = rbi_f + "," + rbi_o;
} return string rbs_z;
given lp_t_font given rbd_t_up(1024) ():("1,0")
given lp_t_font given rbd_t_up(600) ():("0,0")

// Test check: the rectangles of the open menu, gallery or the open list of the combo box that has the keyboard: its box, then each choice, then what follows them; none when nothing is open.
rbd_t_rects() {
  int rbi_pk = (import rbd_s)[(import rbd_s_pk)];
  int[] rbl_r = [];
  if(rbi_pk == 1) {
    GuiMenu rbm = (import rbd_menu)[0];
    rbl_r = rbm.rects;
  }
} chain () {
  if(rbi_pk == 2) {
    GuiGallery rby = (import rbd_gal)[0];
    rbl_r = rby.rects;
  }
  if(rbi_pk == 0 && (import rbd_fo)[0] >= 0) {
    GuiCombo rbc = (import rbd_cb)[(import rbd_fo)[0]];
    rbl_r = rbc.list.rects;
  }
} return int[] rbl_r;
