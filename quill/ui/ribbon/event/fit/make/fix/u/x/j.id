// Test setup: a tap on choice rbi_k of the open menu or gallery: a press and a release at the middle of its rectangle, the ribbon in rbd_t_r getting both.
ribbon_fit_tap_choice(int ribbon_fit_choose_index) {
  int[] ribbon_fit_choose_rectangles = ribbon_fit_open_popup_rectangles();
  int ribbon_fit_choose_cell = 4 + 4 * ribbon_fit_choose_index;
  int ribbon_fit_choose_column = ribbon_fit_choose_rectangles[ribbon_fit_choose_cell] + ribbon_fit_choose_rectangles[ribbon_fit_choose_cell + 2] / 2;
} chain (int ribbon_fit_choose_index) {
  int ribbon_fit_choose_row = ribbon_fit_choose_rectangles[ribbon_fit_choose_cell + 1] + ribbon_fit_choose_rectangles[ribbon_fit_choose_cell + 3] / 2;
  ribbon_fit_send_mouse_event(3, ribbon_fit_choose_column, ribbon_fit_choose_row);
  ribbon_fit_send_mouse_event(4, ribbon_fit_choose_column, ribbon_fit_choose_row);
} return void;
