// Test setup: a tap on choice rbi_k of the open menu or gallery: a press and a release at the middle of its rectangle, the ribbon in rbd_t_r getting both.
rbd_t_choose(int rbi_k) {
  int[] rbl_r = rbd_t_rects();
  int rbi_q = 4 + 4 * rbi_k;
  int rbi_x = rbl_r[rbi_q] + rbl_r[rbi_q + 2] / 2;
} chain (int rbi_k) {
  int rbi_y = rbl_r[rbi_q + 1] + rbl_r[rbi_q + 3] / 2;
  rbd_t_ev(3, rbi_x, rbi_y);
  rbd_t_ev(4, rbi_x, rbi_y);
} return void;
