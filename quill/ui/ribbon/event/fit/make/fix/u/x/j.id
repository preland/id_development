// Test check: whether the Home tab fits the width of the surface, and how many of its rectangles overlap another, comma separated.
ribbon_fit_check_home_fit() {
  Ribbon ribbon_fit_home_ribbon = (import ribbon_fit_test_ribbon);
  int ribbon_fit_home_fits = rib_fits(ribbon_fit_home_ribbon, (import pixel_surface_width));
  int ribbon_fit_home_overlaps = ribbon_rectangles_overlap(ribbon_fit_home_ribbon.ribbon_rectangles, len(ribbon_fit_home_ribbon.items));
} chain () {
  string ribbon_fit_home_text = ribbon_fit_home_fits + "," + ribbon_fit_home_overlaps;
} return string ribbon_fit_home_text;
