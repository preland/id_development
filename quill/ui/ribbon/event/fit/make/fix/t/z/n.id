// Test check: the open colour grid as how many are open, its x, y, width and height and the label of its bar, comma separated.
ribbon_fit_check_color_grid() {
  GuiColors[] ribbon_fit_grid_list = (import ribbon_fit_color_grids);
  string ribbon_fit_grid_text = len(ribbon_fit_grid_list) + "";
  if(len(ribbon_fit_grid_list) > 0) {
    ribbon_fit_grid_text = ribbon_fit_grid_text + "," + ribbon_fit_grid_list[0].rects[0] + "," + ribbon_fit_grid_list[0].rects[1] + "," + ribbon_fit_grid_list[0].rects[2] + "," + ribbon_fit_grid_list[0].rects[3] + "," + ribbon_fit_grid_list[0].label;
  }
} return string ribbon_fit_grid_text;
