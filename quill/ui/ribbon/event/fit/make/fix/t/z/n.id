// Test check: the open colour grid as how many are open, its x, y, width and height and the label of its bar, comma separated.
rbd_t_cp() {
  GuiColors[] rbl_gk = (import rbd_cg);
  string rbs_z = len(rbl_gk) + "";
  if(len(rbl_gk) > 0) {
    rbs_z = rbs_z + "," + rbl_gk[0].rects[0] + "," + rbl_gk[0].rects[1] + "," + rbl_gk[0].rects[2] + "," + rbl_gk[0].rects[3] + "," + rbl_gk[0].label;
  }
} return string rbs_z;
given lp_t_font given rbd_t_up(1024) ():("0")
given lp_t_font given rbd_t_up(1024) given rbd_t_open(312) ():("1,10,30,212,184,No Color")

// Test setup: makes swatch rbi_k the hot one of the open colour grid, 70 being the bar of the automatic colour.
rbd_t_swatch(int rbi_k) {
  GuiColors rbk = (import rbd_cg)[0];
  rbk.rects[5] = rbi_k;
} return void;
