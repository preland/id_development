// Test setup: makes swatch rbi_k the hot one of the open colour grid, 70 being the bar of the automatic colour.
ribbon_fit_set_hot_swatch(int ribbon_fit_swatch_index) {
  GuiColors ribbon_fit_swatch_grid = (import ribbon_fit_color_grids)[0];
  ribbon_fit_swatch_grid.rects[5] = ribbon_fit_swatch_index;
} return void;
