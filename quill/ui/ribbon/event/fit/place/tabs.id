// Puts the five tabs side by side on the tab strip whose top is rbi_y, the first a margin in from the left edge rbi_x.
ribbon_fit_place_tabs(int ribbon_fit_tabs_left, int ribbon_fit_tabs_top) {
  int ribbon_fit_tabs_index = 0;
  int ribbon_fit_tabs_cursor = ribbon_fit_tabs_left + 4;
  while(ribbon_fit_tabs_index < len((import rbd_tabs))) {
    ribbon_fit_tabs_cursor = ribbon_fit_tabs_cursor + ribbon_fit_place_tab(ribbon_fit_tabs_index, ribbon_fit_tabs_cursor, ribbon_fit_tabs_top);
    ribbon_fit_tabs_index = ribbon_fit_tabs_index + 1;
  }
} return void;
