// Puts the ribbon rib, the quick-access strip and the tabs in the band at (rbi_x, rbi_y) of size rbi_w by rbi_h: the quick-access strip along the top, the tab strip under it, the groups of the open tab in the body, a margin in from the sides; makes a widget for every control at the place it got and closes any open menu. Call it after every change of the window's size.
rib_fit(Ribbon rib, int ribbon_fit_fit_left, int ribbon_fit_fit_top, int ribbon_fit_fit_width, int ribbon_fit_fit_height) {
  ribbon_fit_remember_band(ribbon_fit_fit_left, ribbon_fit_fit_top, ribbon_fit_fit_width, ribbon_fit_fit_height);
  int ribbon_fit_fit_body_top = ribbon_fit_fit_top + (import rbd_qat_px) + (import rbd_tab_px);
  rib_place(rib, ribbon_fit_fit_left + 4, ribbon_fit_fit_body_top, ribbon_fit_fit_width - 8, ribbon_fit_fit_top + ribbon_fit_fit_height - ribbon_fit_fit_body_top);
} chain (Ribbon rib, int ribbon_fit_fit_left, int ribbon_fit_fit_top, int ribbon_fit_fit_width, int ribbon_fit_fit_height) {
  rib_place((import ribbon_fit_quick_ribbon), ribbon_fit_fit_left + 4, ribbon_fit_fit_top, ribbon_fit_fit_width - 8, (import rbd_qat_px));
  ribbon_fit_place_tabs(ribbon_fit_fit_left, ribbon_fit_fit_top + (import rbd_qat_px));
  ribbon_fit_make_widgets(rib, (import ribbon_fit_body_widgets));
} chain (Ribbon rib, int ribbon_fit_fit_left, int ribbon_fit_fit_top, int ribbon_fit_fit_width, int ribbon_fit_fit_height) {
  ribbon_fit_make_widgets((import ribbon_fit_quick_ribbon), (import ribbon_fit_quick_widgets));
  ribbon_fit_close_popups();
  ribbon_combo_place(rib);
} return void;
