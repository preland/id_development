// Opens tab rbi_tab in the ribbon rib: the controls of that tab take the place of the controls of the one that was open, placed in the same band, and nothing of the old tab's menus stays open.
rib_show(Ribbon rib, int rbi_tab) {
  Ribbon rbn = rib_build(rbi_tab);
  rib.items = rbn.items;
  rib.state = rbn.state;
} chain (Ribbon rib, int rbi_tab) {
