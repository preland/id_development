// What the activated control does, the one the state list names (its ribbon and its index): a button, a toggle, a wide button, a split button's body or a colour button's body gives its command (a colour button with the colour it remembers); a control that opens a menu opens it.
ribbon_activate_control(Ribbon rib) {
  int[] ribbon_activate_state = (import ribbon_fit_state);
  Ribbon ribbon_activate_ribbon = ribbon_source_ribbon_of(rib, ribbon_activate_state[(import rbd_s_src)]);
  int ribbon_activate_row = ribbon_activate_ribbon.items[ribbon_activate_state[(import rbd_s_act)]];
} chain (Ribbon rib) {
  int ribbon_activate_menu = (import rbd_k_menu)[(import rb_kind)[ribbon_activate_row]];
  int ribbon_activate_command = (import rb_cmd)[ribbon_activate_row];
  if(ribbon_activate_menu == 1) {
    ribbon_open_menu_at(ribbon_activate_ribbon, ribbon_activate_state[(import rbd_s_src)], ribbon_activate_state[(import rbd_s_act)], ribbon_activate_command);
  }
} chain (Ribbon rib) {
  if(ribbon_activate_menu == 0) {
    ribbon_answer_write(ribbon_activate_command, ribbon_item_argument(ribbon_activate_row), "");
  }
} return void;
