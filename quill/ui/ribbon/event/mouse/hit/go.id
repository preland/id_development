// A press on tab rbi_t of the tab strip: the File tab opens its menu of commands under it, any other tab takes the place of the open one in the ribbon rib.
ribbon_press_tab(Ribbon rib, int ribbon_press_tab_number) {
  int[] ribbon_press_tab_anchor = list_slice((import ribbon_fit_tab_rectangles), 0, 4);
  if(ribbon_press_tab_number == 0) {
    ribbon_open_popup(0, 2, 0, ribbon_press_tab_anchor);
  }
  if(ribbon_press_tab_number > 0) {
    rib_show(rib, ribbon_press_tab_number);
  }
} return void;
