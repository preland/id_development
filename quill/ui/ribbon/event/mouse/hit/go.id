// A press at the point of the event rbl_ev: on a tab it opens it, on the arrow strip of a split button it opens that button's menu, anywhere else it goes to the widgets. Answers the bits of the event, 1 when the press did something to the picture.
ribbon_press_point(Ribbon rib, int[] ribbon_press_event) {
  int ribbon_press_tab_hit = ribbon_rectangle_index_at((import ribbon_fit_tab_rectangles), 5, ribbon_press_event[1], ribbon_press_event[2]);
  int ribbon_press_arrow = ribbon_arrow_index_at(rib, ribbon_press_event[1], ribbon_press_event[2]);
  int ribbon_press_bits = 1;
} chain (Ribbon rib, int[] ribbon_press_event) {
  if(ribbon_press_tab_hit >= 0) {
    ribbon_press_tab(rib, ribbon_press_tab_hit);
  }
  if(ribbon_press_arrow >= 0) {
    ribbon_open_menu_at(rib, 0, ribbon_press_arrow, (import rb_cmd)[rib.items[ribbon_press_arrow]]);
  }
  if(ribbon_press_tab_hit < 0 && ribbon_press_arrow < 0) {
    ribbon_press_bits = ribbon_bands_event(3, ribbon_press_event);
  }
} return int ribbon_press_bits;
