// Gives the event to every widget in rbl_ws, the ribbon rbi_src's, and answers the bits of all of them together.
ribbon_widgets_event(GuiToggle[] ribbon_widgets_all, int ribbon_widgets_source, int ribbon_widgets_kind, int[] ribbon_widgets_event_fields) {
  int ribbon_widgets_number = 0;
  int ribbon_widgets_bits = 0;
  while(ribbon_widgets_number < len(ribbon_widgets_all)) {
    ribbon_widgets_bits = ribbon_widgets_bits | ribbon_widget_event(ribbon_widgets_all, ribbon_widgets_source, ribbon_widgets_number, ribbon_widgets_kind, ribbon_widgets_event_fields);
    ribbon_widgets_number = ribbon_widgets_number + 1;
  }
} return int ribbon_widgets_bits;
