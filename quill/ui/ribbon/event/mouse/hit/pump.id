// Gives the window event of kind rbi_kind to the widget at index rbi_i of rbl_ws, which stands for a control of the ribbon rbi_src, and answers the widget's bits (1 draw it again, 2 it was activated, which is noted).
ribbon_widget_event(GuiToggle[] ribbon_widget_widgets, int ribbon_widget_source, int ribbon_widget_index, int ribbon_widget_kind, int[] ribbon_widget_event_fields) {
  GuiToggle ribbon_widget_control = ribbon_widget_widgets[ribbon_widget_index];
  int ribbon_widget_bits = gui_btn_event(ribbon_widget_control.btn, ribbon_widget_kind, ribbon_widget_event_fields);
  ribbon_note_activation(ribbon_widget_source, ribbon_widget_index, ribbon_widget_bits);
} return int ribbon_widget_bits;
