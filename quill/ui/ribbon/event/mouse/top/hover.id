// What the pointer of the event rbl_ev does to the tooltip: it is armed under the control of the ribbon rib the pointer is on, or else under the quick-access control it is on, and taken away when it is on none. Answers 1 when a tooltip that was on show has to be wiped out.
rbe_tip_for(Ribbon rib, int[] rbl_ev) {
  int rbi_a = rbe_tip_at(rib, rbl_ev);
  int rbi_b = 0;
  if(rbi_a < 2) {
    rbi_b = rbe_tip_at((import rbd_q), rbl_ev);
  }
} chain (Ribbon rib, int[] rbl_ev) {
  int rbi_r = (rbi_a | rbi_b) & 1;
  if((rbi_a | rbi_b) < 2) {
    rbi_r = gui_tip_hide((import rbd_tip)[0]);
  }
} return int rbi_r;
