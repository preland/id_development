// What the pointer of the event rbl_ev does to the tooltip: it is armed under the control of the ribbon rib the pointer is on, or else under the quick-access control it is on, and taken away when it is on none. Answers 1 when a tooltip that was on show has to be wiped out.
ribbon_tip_follow(Ribbon rib, int[] ribbon_follow_event_fields) {
  int ribbon_follow_body = ribbon_tip_arm(rib, ribbon_follow_event_fields);
  int ribbon_follow_quick = 0;
  if(ribbon_follow_body < 2) {
    ribbon_follow_quick = ribbon_tip_arm((import ribbon_fit_quick_ribbon), ribbon_follow_event_fields);
  }
} chain (Ribbon rib, int[] ribbon_follow_event_fields) {
  int ribbon_follow_result = (ribbon_follow_body | ribbon_follow_quick) & 1;
  if((ribbon_follow_body | ribbon_follow_quick) < 2) {
    ribbon_follow_result = gui_tip_hide((import ribbon_fit_tips)[0]);
  }
} return int ribbon_follow_result;
