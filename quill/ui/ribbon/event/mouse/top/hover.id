// Arms the tooltip of the control of the ribbon rbr that the pointer of the event rbl_ev is on, under that control. Answers 0 when the pointer is on none, else 2 and 1 more when the tooltip it replaced was on show and has to be wiped out.
rbe_tip_at(Ribbon rbr, int[] rbl_ev) {
  int rbi_i = rbe_at(rbr.rects, len(rbr.items), rbl_ev[1], rbl_ev[2]);
  int rbi_r = 0;
  if(rbi_i >= 0) {
    rbi_r = 2 + gui_tip_show((import rbd_tip)[0], rbe_tip_text(rbr, rbi_i), rbr.rects[rbi_i * 4], rbr.rects[rbi_i * 4 + 1] + rbr.rects[rbi_i * 4 + 3] + 4);
  }
} return int rbi_r;
