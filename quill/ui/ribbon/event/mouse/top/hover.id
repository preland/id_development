// The text of the tooltip of the control at index rbi_i of the ribbon rbr: its name with its shortcut, a dash, and the line that says what it does.
rbe_tip_text(Ribbon rbr, int rbi_i) {
  int rbi_row = rbr.items[rbi_i];
  string rbs_h = tip_head((import rb_label)[rbi_row], (import rb_key)[rbi_row]);
  string rbs_t = rbs_h + " - " + (import rb_tip)[rbi_row];
} return string rbs_t;
