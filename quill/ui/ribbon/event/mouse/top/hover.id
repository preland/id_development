// The text of the tooltip of the control at index rbi_i of the ribbon rbr: its name with its shortcut, a dash, and the line that says what it does.
ribbon_tip_text(Ribbon ribbon_tip_ribbon, int ribbon_tip_control) {
  int ribbon_tip_text_row = ribbon_tip_ribbon.items[ribbon_tip_control];
  string ribbon_tip_heading = tip_head((import rb_label)[ribbon_tip_text_row], (import rb_key)[ribbon_tip_text_row]);
  string ribbon_tip_result = ribbon_tip_heading + " - " + (import rb_tip)[ribbon_tip_text_row];
} return string ribbon_tip_result;
(Ribbon([14], [], [0]), 0):("Bold (Ctrl+B) - Make the selected text bold.")
(Ribbon([4, 17], [], [0, 0]), 1):("Strikethrough - Draw a line through the selected text.")

// Arms the tooltip of the control of the ribbon rbr that the pointer of the event rbl_ev is on, under that control. Answers 0 when the pointer is on none, else 2 and 1 more when the tooltip it replaced was on show and has to be wiped out.
ribbon_tip_arm(Ribbon ribbon_arm_ribbon, int[] ribbon_arm_event_fields) {
  int ribbon_arm_control = ribbon_rectangle_index_at(ribbon_arm_ribbon.ribbon_rectangles, len(ribbon_arm_ribbon.items), ribbon_arm_event_fields[1], ribbon_arm_event_fields[2]);
  int ribbon_arm_result = 0;
  if(ribbon_arm_control >= 0) {
    ribbon_arm_result = 2 + gui_tip_show((import ribbon_fit_tips)[0], ribbon_tip_text(ribbon_arm_ribbon, ribbon_arm_control), ribbon_arm_ribbon.ribbon_rectangles[ribbon_arm_control * 4], ribbon_arm_ribbon.ribbon_rectangles[ribbon_arm_control * 4 + 1] + ribbon_arm_ribbon.ribbon_rectangles[ribbon_arm_control * 4 + 3] + 4);
  }
} return int ribbon_arm_result;
