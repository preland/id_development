// The pointer moved, in the event rbl_ev: the tab and the arrow strip it is on are remembered for painting, the tooltip follows it, and the widgets learn of it. Answers the bits of the event, 1 when something has to be painted again.
rbe_move(Ribbon rib, int[] rbl_ev) {
  int[] rbl_s = (import rbd_s);
  int rbi_t = rbe_at((import rbd_tr), 5, rbl_ev[1], rbl_ev[2]);
  int rbi_a = rbe_arrow_at(rib, rbl_ev[1], rbl_ev[2]);
} chain (Ribbon rib, int[] rbl_ev) {
  int rbi_c = (rbi_t != rbl_s[(import rbd_s_hot)]) || (rbi_a != rbl_s[(import rbd_s_ahot)]);
  lset(rbl_s, (import rbd_s_hot), rbi_t);
  lset(rbl_s, (import rbd_s_ahot), rbi_a);
} chain (Ribbon rib, int[] rbl_ev) {
  int rbi_h = rbe_tip_for(rib, rbl_ev);
  int rbi_p = rbe_pumps(5, rbl_ev);
  int rbi_b = rbi_c | rbi_h | rbi_p;
} return int rbi_b;
