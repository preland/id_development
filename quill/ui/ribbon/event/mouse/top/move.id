// A mouse event of kind rbi_kind (3 press, 4 release, 5 move) at the point of the event rbl_ev, for the ribbon rib when no menu is open: a press goes to the tabs, the arrow strips and the widgets, a release to the widgets, and the control that was activated by it acts; a move to the pointer's followers. Adds 8 when the point is in the ribbon's band, so the program knows the ribbon had it.
ribbon_mouse_event(Ribbon rib, int ribbon_mouse_kind, int[] ribbon_mouse_fields) {
  int ribbon_mouse_bits = 0;
  if(ribbon_mouse_kind == 3) {
    ribbon_mouse_bits = ribbon_press_point(rib, ribbon_mouse_fields);
  }
  if(ribbon_mouse_kind == 4) {
    ribbon_mouse_bits = ribbon_bands_event(4, ribbon_mouse_fields);
  }
} chain (Ribbon rib, int ribbon_mouse_kind, int[] ribbon_mouse_fields) {
  if(ribbon_mouse_kind == 5) {
    ribbon_mouse_bits = ribbon_pointer_move(rib, ribbon_mouse_fields);
  }
  if((ribbon_mouse_bits & 2) != 0) {
    ribbon_activate_control(rib);
  }
  int ribbon_mouse_inside = ribbon_rectangle_contains((import ribbon_fit_state), (import rbd_s_bx), ribbon_mouse_fields[1], ribbon_mouse_fields[2]);
} chain (Ribbon rib, int ribbon_mouse_kind, int[] ribbon_mouse_fields) {
  ribbon_mouse_bits = ribbon_mouse_bits + 8 * ribbon_mouse_inside;
} return int ribbon_mouse_bits;
