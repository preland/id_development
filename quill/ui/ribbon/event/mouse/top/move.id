// The pointer moved, in the event rbl_ev: the tab and the arrow strip it is on are remembered for painting, the tooltip follows it, and the widgets learn of it. Answers the bits of the event, 1 when something has to be painted again.
ribbon_pointer_move(Ribbon rib, int[] ribbon_move_fields) {
  int[] ribbon_move_state = (import ribbon_fit_state);
  int ribbon_move_tab = ribbon_rectangle_index_at((import ribbon_fit_tab_rectangles), 5, ribbon_move_fields[1], ribbon_move_fields[2]);
  int ribbon_move_arrow = ribbon_arrow_index_at(rib, ribbon_move_fields[1], ribbon_move_fields[2]);
} chain (Ribbon rib, int[] ribbon_move_fields) {
  int ribbon_move_changed = (ribbon_move_tab != ribbon_move_state[(import rbd_s_hot)]) || (ribbon_move_arrow != ribbon_move_state[(import rbd_s_ahot)]);
  integer_list_set(ribbon_move_state, (import rbd_s_hot), ribbon_move_tab);
  integer_list_set(ribbon_move_state, (import rbd_s_ahot), ribbon_move_arrow);
} chain (Ribbon rib, int[] ribbon_move_fields) {
  int ribbon_move_tip = ribbon_tip_follow(rib, ribbon_move_fields);
  int ribbon_move_widgets = ribbon_bands_event(5, ribbon_move_fields);
  int ribbon_move_bits = ribbon_move_changed | ribbon_move_tip | ribbon_move_widgets;
} return int ribbon_move_bits;
