// A mouse event of kind rbi_kind (3 press, 4 release, 5 move) at the point of the event rbl_ev, for the ribbon rib when no menu is open: a press goes to the tabs, the arrow strips and the widgets, a release to the widgets, and the control that was activated by it acts; a move to the pointer's followers. Adds 8 when the point is in the ribbon's band, so the program knows the ribbon had it.
rbe_mouse(Ribbon rib, int rbi_kind, int[] rbl_ev) {
  int rbi_b = 0;
  if(rbi_kind == 3) {
    rbi_b = rbe_press(rib, rbl_ev);
  }
  if(rbi_kind == 4) {
    rbi_b = rbe_pumps(4, rbl_ev);
  }
} chain (Ribbon rib, int rbi_kind, int[] rbl_ev) {
  if(rbi_kind == 5) {
    rbi_b = rbe_move(rib, rbl_ev);
  }
  if((rbi_b & 2) != 0) {
    rbe_act(rib);
  }
  int rbi_in = rbe_in((import rbd_s), (import rbd_s_bx), rbl_ev[1], rbl_ev[2]);
} chain (Ribbon rib, int rbi_kind, int[] rbl_ev) {
  rbi_b = rbi_b + 8 * rbi_in;
} return int rbi_b;
