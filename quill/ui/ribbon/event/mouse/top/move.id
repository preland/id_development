// Gives the event of kind rbi_kind to the widgets of the body and to those of the quick-access strip, and answers the bits of both together.
rbe_pumps(int rbi_kind, int[] rbl_ev) {
  int rbi_a = rbe_pump((import rbd_ws), 0, rbi_kind, rbl_ev);
  int rbi_b = rbe_pump((import rbd_qs), 1, rbi_kind, rbl_ev);
  int rbi_r = rbi_a | rbi_b;
} return int rbi_r;
