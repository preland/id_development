// Starts an event with no answer: the command and the argument, the activated control and the name of the last choice are cleared.
ribbon_event_clear() {
  int[] ribbon_clear_state = (import ribbon_fit_state);
  string[] ribbon_clear_names = (import ribbon_fit_choice_name);
  integer_list_set(ribbon_clear_state, (import rbd_s_cmd), 0);
} chain () {
  integer_list_set(ribbon_clear_state, (import rbd_s_arg), 0);
  integer_list_set(ribbon_clear_state, (import rbd_s_act), -1);
  ribbon_clear_names[0] = "";
} return void;
