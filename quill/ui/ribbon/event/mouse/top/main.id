// What the ribbon does with the event of kind rbi_kind, fields rbl_ev, that no combo box took: a menu that is open takes it first; otherwise a mouse event goes to the tabs and the controls, and a key or a press takes the tooltip away. Answers the bits rib_event does.
ribbon_event_remaining(Ribbon rib, int ribbon_remaining_kind, int[] ribbon_remaining_fields) {
  int ribbon_remaining_popup = (import ribbon_fit_state)[(import rbd_s_pk)];
  int ribbon_remaining_bits = 0;
  if(ribbon_remaining_popup != 0) {
    ribbon_remaining_bits = ribbon_popup_event(ribbon_remaining_kind, ribbon_remaining_fields);
  }
} chain (Ribbon rib, int ribbon_remaining_kind, int[] ribbon_remaining_fields) {
  int ribbon_remaining_tip = gui_tip_event((import ribbon_fit_tips)[0], ribbon_remaining_kind, ribbon_remaining_fields);
  int ribbon_remaining_mouse = ribbon_remaining_kind >= 3 && ribbon_remaining_kind <= 5;
  if((ribbon_remaining_bits & 8) == 0 && ribbon_remaining_mouse == 1) {
    ribbon_remaining_bits = ribbon_remaining_bits | ribbon_mouse_event(rib, ribbon_remaining_kind, ribbon_remaining_fields);
  }
} chain (Ribbon rib, int ribbon_remaining_kind, int[] ribbon_remaining_fields) {
  ribbon_remaining_bits = ribbon_remaining_bits | ribbon_remaining_tip;
} return int ribbon_remaining_bits;
