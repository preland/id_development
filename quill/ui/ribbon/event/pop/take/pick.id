  }
} chain () {
  if(ribbon_choice_hot_popup == 2) {
    ribbon_choice_hot_result = gui_gallery_hot((import ribbon_fit_galleries)[0]);
  }
  if(ribbon_choice_hot_popup == 3) {
    ribbon_choice_hot_result = 0;
  }
} return int ribbon_choice_hot_result;
