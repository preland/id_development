// What an event did to the open menu or gallery, as the widget's own bits: 1 draw again, 2 a choice was made, 4 dismissed; 0 when nothing is open.
ribbon_popup_route(int ribbon_popup_route_kind, int[] ribbon_popup_route_fields) {
  int ribbon_popup_route_popup = (import ribbon_fit_state)[(import rbd_s_pk)];
  int ribbon_popup_route_bits = 0;
  if(ribbon_popup_route_popup == 1) {
    ribbon_popup_route_bits = gui_menu_event((import ribbon_fit_menus)[0], ribbon_popup_route_kind, ribbon_popup_route_fields);
  }
} chain (int ribbon_popup_route_kind, int[] ribbon_popup_route_fields) {
  if(ribbon_popup_route_popup == 2) {
    ribbon_popup_route_bits = gui_gallery_event((import ribbon_fit_galleries)[0], ribbon_popup_route_kind, ribbon_popup_route_fields);
  }
  if(ribbon_popup_route_popup == 3) {
    ribbon_popup_route_bits = gui_colors_event((import ribbon_fit_color_grids)[0], ribbon_popup_route_kind, ribbon_popup_route_fields);
  }
  if((ribbon_popup_route_bits & 2) != 0 && ribbon_popup_route_popup == 3) {
    ribbon_color_answer();
  }
} return int ribbon_popup_route_bits;
