// Takes what the open menu or gallery has hot as the choice made: its command is the one the menu was opened for (for the File tab's menu, command 0, the choice is itself a command), its argument and its name are the choice's, and a colour choice is remembered for the colour button.
ribbon_choice_take() {
  int[] ribbon_choice_take_state = (import ribbon_fit_state);
  int ribbon_choice_take_position = ribbon_choice_hot();
  int ribbon_choice_take_command = ribbon_choice_take_state[(import rbd_s_pcmd)];
} chain () {
  int ribbon_choice_take_argument = (import ribbon_fit_answers)[ribbon_choice_take_position];
  string ribbon_choice_take_name = (import ribbon_fit_labels)[ribbon_choice_take_position];
  if(ribbon_choice_take_command == 0) {
    ribbon_choice_take_command = ribbon_choice_take_argument;
    ribbon_choice_take_argument = 0;
  }
} chain () {
  ribbon_answer_write(ribbon_choice_take_command, ribbon_choice_take_argument, ribbon_choice_take_name);
  ribbon_color_remember(ribbon_choice_take_command, ribbon_choice_take_argument);
} return void;
