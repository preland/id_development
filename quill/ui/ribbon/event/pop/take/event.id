// An event for the open menu or gallery: the widget decides what it means, and the answer is rbe_ret's. A choice is taken and every end of the menu closes it.
ribbon_popup_event(int ribbon_popup_event_kind, int[] ribbon_popup_event_fields) {
  int ribbon_popup_event_bits = ribbon_popup_route(ribbon_popup_event_kind, ribbon_popup_event_fields);
  int ribbon_popup_event_on_opener = gui_popup_in((import ribbon_fit_anchor), 0, ribbon_popup_event_fields[1], ribbon_popup_event_fields[2]);
  int ribbon_popup_event_result = ribbon_popup_answer(ribbon_popup_event_bits, ribbon_popup_event_kind, ribbon_popup_event_on_opener);
} chain (int ribbon_popup_event_kind, int[] ribbon_popup_event_fields) {
  if((ribbon_popup_event_bits & 2) != 0) {
    ribbon_choice_take();
  }
  if((ribbon_popup_event_bits & 6) != 0) {
    ribbon_popup_close();
  }
} return int ribbon_popup_event_result;
