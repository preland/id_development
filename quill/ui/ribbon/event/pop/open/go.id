// Opens the menu of command rbi_cmd with the labels rbt_l under the control whose rectangle is rbl_a: a gallery for the styles, a colour grid for the colour buttons and a plain menu for any other. Answers what it opened, 1 a menu, 2 a gallery and 3 a colour grid.
ribbon_open_widget(int ribbon_open_widget_command, string[] ribbon_open_widget_labels, int[] ribbon_open_widget_anchor) {
  int ribbon_open_widget_kind = 1 + (ribbon_open_widget_command == (import cmd_style)) + 2 * (list_index_of((import rbd_col_cmd), ribbon_open_widget_command) >= 0);
  if(ribbon_open_widget_kind == 1) {
    ribbon_open_plain_menu(ribbon_open_widget_labels, ribbon_open_widget_anchor);
  }
  if(ribbon_open_widget_kind == 2) {
    ribbon_open_gallery(ribbon_open_widget_command, ribbon_open_widget_labels, ribbon_open_widget_anchor);
  }
} chain (int ribbon_open_widget_command, string[] ribbon_open_widget_labels, int[] ribbon_open_widget_anchor) {
  if(ribbon_open_widget_kind == 3) {
    ribbon_open_colors(ribbon_open_widget_command, ribbon_open_widget_anchor);
  }
} return int ribbon_open_widget_kind;
