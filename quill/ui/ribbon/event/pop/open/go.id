// Opens the menu of command rbi_cmd with the labels rbt_l under the control whose rectangle is rbl_a: a gallery for the styles, a colour grid for the colour buttons and a plain menu for any other. Answers what it opened, 1 a menu, 2 a gallery and 3 a colour grid.
rbe_widget(int rbi_cmd, string[] rbt_l, int[] rbl_a) {
  int rbi_pk = 1 + (rbi_cmd == (import cmd_style)) + 2 * (lst_index_of((import rbd_col_cmd), rbi_cmd) >= 0);
  if(rbi_pk == 1) {
    rbe_menu(rbt_l, rbl_a);
  }
  if(rbi_pk == 2) {
    rbe_gallery(rbi_cmd, rbt_l, rbl_a);
  }
} chain (int rbi_cmd, string[] rbt_l, int[] rbl_a) {
  if(rbi_pk == 3) {
    rbe_colours(rbi_cmd, rbl_a);
  }
} return int rbi_pk;
