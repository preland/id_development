// Opens the menu of command rbi_cmd under the control at index rbi_i of the ribbon rbi_src (0 the body, 1 the quick-access strip, 2 the tab strip), whose rectangle is rbl_a: the labels and what each answers with are kept, any menu that was open is closed, the tooltip is taken away, and the state says what is open.
ribbon_open_popup(int ribbon_open_popup_command, int ribbon_open_popup_source, int ribbon_open_popup_control, int[] ribbon_open_popup_anchor) {
  ribbon_popup_close();
  string[] ribbon_open_popup_labels = ribbon_menu_labels(ribbon_open_popup_command);
  int[] ribbon_open_popup_arguments = ribbon_menu_arguments(ribbon_open_popup_command, len(ribbon_open_popup_labels));
} chain (int ribbon_open_popup_command, int ribbon_open_popup_source, int ribbon_open_popup_control, int[] ribbon_open_popup_anchor) {
  list_string_splice((import ribbon_fit_labels), 0, len((import ribbon_fit_labels)), ribbon_open_popup_labels);
  list_splice((import ribbon_fit_answers), 0, len((import ribbon_fit_answers)), ribbon_open_popup_arguments);
  list_splice((import ribbon_fit_anchor), 0, 4, ribbon_open_popup_anchor);
} chain (int ribbon_open_popup_command, int ribbon_open_popup_source, int ribbon_open_popup_control, int[] ribbon_open_popup_anchor) {
  int ribbon_open_popup_kind = ribbon_open_widget(ribbon_open_popup_command, ribbon_open_popup_labels, ribbon_open_popup_anchor);
  ribbon_open_note(ribbon_open_popup_command, ribbon_open_popup_source, ribbon_open_popup_control, ribbon_open_popup_kind);
  int ribbon_open_popup_hidden = gui_tip_hide((import ribbon_fit_tips)[0]);
} return void;
