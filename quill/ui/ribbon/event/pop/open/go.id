// Writes down in the state list what was opened: the control it came from (its index rbi_i in the ribbon rbi_src, 0 the body, 1 the quick-access strip, 2 the tab strip), the command, and the kind rbi_pk of widget.
rbe_mark(int rbi_cmd, int rbi_src, int rbi_i, int rbi_pk) {
  int[] rbl_s = (import rbd_s);
  lset(rbl_s, (import rbd_s_pop), rbi_i);
  lset(rbl_s, (import rbd_s_psrc), rbi_src);
} chain (int rbi_cmd, int rbi_src, int rbi_i, int rbi_pk) {
  lset(rbl_s, (import rbd_s_pcmd), rbi_cmd);
  lset(rbl_s, (import rbd_s_pk), rbi_pk);
} return void;
