// Opens the menu of command rbi_cmd under the control at index rbi_i of the ribbon rbi_src (0 the body, 1 the quick-access strip, 2 the tab strip), whose rectangle is rbl_a: the labels and what each answers with are kept, any menu that was open is closed, the tooltip is taken away, and the state says what is open.
rbe_open(int rbi_cmd, int rbi_src, int rbi_i, int[] rbl_a) {
  rbe_close();
  string[] rbt_l = rbe_labels(rbi_cmd);
  int[] rbl_v = rbe_args(rbi_cmd, len(rbt_l));
} chain (int rbi_cmd, int rbi_src, int rbi_i, int[] rbl_a) {
  lst_str_splice((import rbd_pl), 0, len((import rbd_pl)), rbt_l);
  lst_splice((import rbd_pa), 0, len((import rbd_pa)), rbl_v);
  lst_splice((import rbd_an), 0, 4, rbl_a);
} chain (int rbi_cmd, int rbi_src, int rbi_i, int[] rbl_a) {
  int rbi_pk = rbe_widget(rbi_cmd, rbt_l, rbl_a);
  rbe_mark(rbi_cmd, rbi_src, rbi_i, rbi_pk);
  int rbi_h = gui_tip_hide((import rbd_tip)[0]);
} return void;
