// Opens A5c's colour grid for the colour button of command rbi_cmd under the control whose rectangle is rbl_a: Word's theme grid and the standard colours, and above them the bar that says automatic for the font colour and no colour for the highlight. It is kept in the list of open grids.
ribbon_open_colors(int ribbon_open_colors_command, int[] ribbon_open_colors_anchor) {
  string ribbon_open_colors_bar_label = "Automatic";
  if(ribbon_open_colors_command == (import cmd_highlight)) {
    ribbon_open_colors_bar_label = "No Color";
  }
  GuiColors ribbon_open_colors_grid = gui_colors_new(gui_colors_word((import idstd_pc_office)), ribbon_open_colors_bar_label, (import ribbon_faces)[0]);
} chain (int ribbon_open_colors_command, int[] ribbon_open_colors_anchor) {
  gui_colors_place(ribbon_open_colors_grid, ribbon_open_colors_anchor[0], ribbon_open_colors_anchor[1], ribbon_open_colors_anchor[2], ribbon_open_colors_anchor[3], (import sf_l_w), (import sf_l_h));
  push((import ribbon_fit_color_grids), ribbon_open_colors_grid);
} return void;
given layout_paragraph_test_font given ribbon_fit_setup_surface(1024) (311, [10, 10, 40, 20]):() then ribbon_fit_check_color_grid:("1,10,30,212,184,Automatic")
given layout_paragraph_test_font given ribbon_fit_setup_surface(1024) (312, [900, 10, 40, 20]):() then ribbon_fit_check_color_grid:("1,728,30,212,184,No Color")

// Writes down the colour the open grid just chose where a menu keeps the answer of its choice, so that the grid is picked like any other: the colour is the one answer and its name is its #rrggbb, or the label of the bar for the automatic colour.
ribbon_color_answer() {
  GuiColors ribbon_color_answer_grid = (import ribbon_fit_color_grids)[0];
  int ribbon_color_answer_value = gui_colors_value(ribbon_color_answer_grid);
  string ribbon_color_answer_name = ribbon_color_answer_grid.label;
} chain () {
  list_splice((import ribbon_fit_answers), 0, len((import ribbon_fit_answers)), [ribbon_color_answer_value]);
  if(ribbon_color_answer_value >= 0) {
    ribbon_color_answer_name = odt_write_hex_color(ribbon_color_answer_value);
  }
  list_string_splice((import ribbon_fit_labels), 0, len((import ribbon_fit_labels)), [ribbon_color_answer_name]);
} return void;
given layout_paragraph_test_font given ribbon_fit_setup_surface(1024) given ribbon_fit_open_menu(311) given ribbon_fit_set_hot_swatch(5) ():() then ribbon_fit_check_answers:("15564081,#ed7d31")
given layout_paragraph_test_font given ribbon_fit_setup_surface(1024) given ribbon_fit_open_menu(312) given ribbon_fit_set_hot_swatch(70) ():() then ribbon_fit_check_answers:("-1,No Color")
