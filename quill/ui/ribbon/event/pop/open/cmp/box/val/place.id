} chain (Ribbon rib) {
  while(ribbon_combo_place_number < ribbon_combo_place_count) {
    ribbon_combo_make(rib, ribbon_combo_place_number, gui_combo_text((import ribbon_fit_combos)[ribbon_combo_place_number]));
    ribbon_combo_place_number = ribbon_combo_place_number + 1;
  }
} return void;
