// Looks up the installed font families once, as the choices of the font family combo box: the scan costs a moment, so it is done when the box is first used and not when the ribbon starts. Nothing is looked up again once there are families.
rbe_fonts() {
  if(len((import rbd_fm)) == 0) {
    list_string_splice((import rbd_fm), 0, 0, gui_font_families());
  }
} return void;
