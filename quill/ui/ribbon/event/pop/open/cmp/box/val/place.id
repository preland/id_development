// Shows text rbs_t in the combo box of command rbi_cmd, which is the font family or the font size, as what the selection has now: it becomes the committed text. A combo box that has the keyboard is being typed in and is left alone, and so is any command that has none.
rib_text(Ribbon rib, int rbi_cmd, string rbs_t) {
  int rbi_k = list_index_of((import rbd_cb_cmd), rbi_cmd);
  int rbi_f = (import rbd_fo)[0];
  if(rbi_k >= 0 && rbi_k < len((import rbd_cb)) && rbi_k != rbi_f) {
    gui_combo_set((import rbd_cb)[rbi_k], rbs_t);
  }
} return void;
