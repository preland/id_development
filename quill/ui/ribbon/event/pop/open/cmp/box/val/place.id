// Makes the combo boxes again for the ribbon rib (the first time, makes them), each showing the text of the one it takes the place of, and where its control is now: after a change of the band or of the tab, and when the families have been looked up.
rbe_cb_place(Ribbon rib) {
  int rbi_k = 0;
  int rbi_n = len((import rbd_cb_cmd));
  if(len((import rbd_cb)) == 0) {
    rbe_cb_new();
  }
} chain (Ribbon rib) {
  while(rbi_k < rbi_n) {
    rbe_cb_make(rib, rbi_k, gui_combo_text((import rbd_cb)[rbi_k]));
    rbi_k = rbi_k + 1;
  }
} return void;
