  GuiCombo ribbon_combo_make_box = gui_combo_new(ribbon_combo_make_text, ribbon_menu_labels(ribbon_combo_make_command), (import ribbon_faces)[0], 0);
} chain (Ribbon rib, int ribbon_combo_make_number, string ribbon_combo_make_text) {
  GuiCombo[] ribbon_combo_make_boxes = (import ribbon_fit_combos);
