  string[] rbt_e = [];
  int rbi_f = (import rbd_ui)[0];
} chain () {
  list_fill((import rbd_cx), len((import rbd_cb_cmd)), -1);
  while(rbi_k < len((import rbd_cb_cmd))) {
    GuiCombo rbc = gui_combo_new("", rbt_e, rbi_f, 0);
    push((import rbd_cb), rbc);
    rbi_k = rbi_k + 1;
  }
} return void;
