// Makes combo box number rbi_k showing the text rbs_t with the choices of its command, in place of the one that was there, and puts it where its control stands in the open tab of the ribbon rib; for a command with no control in the tab it is made and left unplaced, and rbd_cx says so with -1.
rbe_cb_make(Ribbon rib, int rbi_k, string rbs_t) {
  int rbi_c = (import rbd_cb_cmd)[rbi_k];
  int rbi_i = rbe_ctl_of(rib, rbi_c);
  GuiCombo rbc = gui_combo_new(rbs_t, rbe_labels(rbi_c), (import rbd_ui)[0], 0);
} chain (Ribbon rib, int rbi_k, string rbs_t) {
  GuiCombo[] rbl_b = (import rbd_cb);
  if(rbi_i >= 0) {
    gui_combo_place(rbc, rib.rects[rbi_i * 4], rib.rects[rbi_i * 4 + 1], rib.rects[rbi_i * 4 + 2], rib.rects[rbi_i * 4 + 3], (import sf_l_w), (import sf_l_h));
  }
  lset((import rbd_cx), rbi_k, rbi_i);
} chain (Ribbon rib, int rbi_k, string rbs_t) {
  rbl_b[rbi_k] = rbc;
} return void;
