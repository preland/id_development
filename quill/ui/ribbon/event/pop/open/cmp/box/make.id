    gui_combo_place(ribbon_combo_make_box, rib.ribbon_rectangles[ribbon_combo_make_control * 4], rib.ribbon_rectangles[ribbon_combo_make_control * 4 + 1], rib.ribbon_rectangles[ribbon_combo_make_control * 4 + 2], rib.ribbon_rectangles[ribbon_combo_make_control * 4 + 3], (import pixel_surface_width), (import pixel_surface_height));
  }
