// The index of the control of the ribbon rbr whose command is rbi_cmd, -1 when it has none.
// By hand: in the Home tab the font family is the fourth control, the font size the fifth and bold the eighth.
ribbon_control_index(Ribbon ribbon_control_ribbon, int ribbon_control_command) {
  int ribbon_control_number = 0;
  int ribbon_control_found = -1;
  while(ribbon_control_number < len(ribbon_control_ribbon.items) && ribbon_control_found < 0) {
    if((import rb_cmd)[ribbon_control_ribbon.items[ribbon_control_number]] == ribbon_control_command) {
      ribbon_control_found = ribbon_control_number;
    }
    ribbon_control_number = ribbon_control_number + 1;
  }
} return int ribbon_control_found;
