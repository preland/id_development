  if(ribbon_combo_argument_command == (import cmd_font_size)) {
    ribbon_combo_argument_result = odt_named_font_size(ribbon_combo_argument_text + "pt", -1);
  }
  if(ribbon_combo_argument_command == (import cmd_font_size) && ribbon_combo_argument_result <= 0) {
    ribbon_combo_argument_result = (import ost_bad);
  }
} return int ribbon_combo_argument_result;
