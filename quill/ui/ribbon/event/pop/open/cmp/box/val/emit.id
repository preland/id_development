// The argument a combo box answers for the text rbs_t it holds: half-points for the font size (ost_bad when the text is no number of points above zero), the position in the installed families for the font family (-1 when the family is not one of them).
rbe_cb_arg(int rbi_cmd, string rbs_t) {
  int rbi_a = list_string_index((import rbd_fm), rbs_t);
  if(rbi_cmd == (import cmd_font_size)) {
    rbi_a = ost_size(rbs_t + "pt", -1);
  }
  if(rbi_cmd == (import cmd_font_size) && rbi_a <= 0) {
    rbi_a = (import ost_bad);
  }
} return int rbi_a;
