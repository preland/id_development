// Gives the program what combo box number rbi_k committed: its command, the argument rbe_cb_arg makes of its text, and the text as the name, for rib_cmd, rib_arg and rib_name. Answers 1 when it did, 0 when the text meant nothing (a font size that is no number) and nothing was given.
rbe_cb_emit(int rbi_k) {
  int rbi_c = (import rbd_cb_cmd)[rbi_k];
  string rbs_t = gui_combo_text((import rbd_cb)[rbi_k]);
  int rbi_a = rbe_cb_arg(rbi_c, rbs_t);
} chain (int rbi_k) {
  int rbi_ok = rbi_a != (import ost_bad);
  if(rbi_ok == 1) {
    rbe_emit(rbi_c, rbi_a, rbs_t);
  }
} return int rbi_ok;
