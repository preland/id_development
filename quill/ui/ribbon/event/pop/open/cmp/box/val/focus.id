// Takes the keyboard away from the combo box that has it, if one has, and puts back the text it had when it was last committed: what a change of the ribbon's band or tab does to a combo box in the middle of being typed in.
rbe_cb_blur() {
  int rbi_k = (import rbd_fo)[0];
  GuiCombo[] rbl_b = (import rbd_cb);
  if(rbi_k >= 0) {
    gui_textbox_focus(rbl_b[rbi_k].box, 0);
    gui_combo_set(rbl_b[rbi_k], rbl_b[rbi_k].set.back);
  }
} chain () {
  lset((import rbd_fo), 0, -1);
} return void;
