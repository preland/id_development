// What a combo box number rbi_k did, from the bits rbi_b it answered to an event of kind rbi_kind: a value committed is given to the program (rbe_cb_emit), and a commit or a give-up lets the keyboard go. Answers the bits of rib_event: the paint bit kept, 2 for a command given, and 4 for a press that ended the combo box (it is owed to what is under) or else 8, the event taken.
ribbon_combo_finish(int ribbon_combo_finish_number, int ribbon_combo_finish_kind, int ribbon_combo_finish_bits) {
  int ribbon_combo_finish_given = 0;
  if((ribbon_combo_finish_bits & 2) != 0) {
    ribbon_combo_finish_given = ribbon_combo_emit(ribbon_combo_finish_number);
  }
  int ribbon_combo_finish_ended = (ribbon_combo_finish_bits & 6) != 0;
} chain (int ribbon_combo_finish_number, int ribbon_combo_finish_kind, int ribbon_combo_finish_bits) {
