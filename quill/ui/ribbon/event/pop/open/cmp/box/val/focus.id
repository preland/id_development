// Gives the keyboard to combo box number rbi_k, whose control the ribbon rib has in the open tab. The font family combo box first looks up the installed families, which it then offers (rbe_fonts, and the combo boxes are made again so that they hold them), because the scan costs a moment and is not done when the ribbon starts.
rbe_cb_focus(Ribbon rib, int rbi_k) {
  if((import rbd_cb_cmd)[rbi_k] == (import cmd_font_family) && len((import rbd_fm)) == 0) {
    rbe_fonts();
    rbe_cb_place(rib);
  }
  GuiCombo rbc = (import rbd_cb)[rbi_k];
  gui_textbox_focus(rbc.box, 1);
} chain (Ribbon rib, int rbi_k) {
  lset((import rbd_fo), 0, rbi_k);
} return void;
