// The labels from rbi_lo on, rbi_n of them, in the table of menu labels.
ribbon_label_slice(int ribbon_label_slice_first, int ribbon_label_slice_count) {
  string[] ribbon_label_slice_result = [];
  int ribbon_label_slice_number = 0;
  while(ribbon_label_slice_number < ribbon_label_slice_count) {
    push(ribbon_label_slice_result, (import rbd_plab)[ribbon_label_slice_first + ribbon_label_slice_number]);
    ribbon_label_slice_number = ribbon_label_slice_number + 1;
  }
} return string[] ribbon_label_slice_result;
