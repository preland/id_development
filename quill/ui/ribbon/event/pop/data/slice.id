// The names of the commands of tab rbi_tab as menu labels, in the order of the tab.
ribbon_tab_labels(int ribbon_tab_labels_tab) {
  int[] ribbon_tab_labels_rows = rib_rows(ribbon_tab_labels_tab);
  string[] ribbon_tab_labels_result = [];
  int ribbon_tab_labels_number = 0;
} chain (int ribbon_tab_labels_tab) {
  while(ribbon_tab_labels_number < len(ribbon_tab_labels_rows)) {
    push(ribbon_tab_labels_result, (import rb_label)[ribbon_tab_labels_rows[ribbon_tab_labels_number]]);
    ribbon_tab_labels_number = ribbon_tab_labels_number + 1;
  }
} return string[] ribbon_tab_labels_result;
