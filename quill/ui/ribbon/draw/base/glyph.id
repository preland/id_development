// The mark that goes with a letter icon of width rbi_w at x rbi_x over the baseline rbi_b, in colour rbi_col: a line under a U, a line through an S, nothing for any other letter.
ribbon_draw_letter_marks(int ribbon_marks_code_point, int ribbon_marks_x, int ribbon_marks_width, int ribbon_marks_baseline, int ribbon_marks_color) {
  if(ribbon_marks_code_point == 85) {
    surface_fill_rectangle(ribbon_marks_x, ribbon_marks_baseline + 2, ribbon_marks_width, 1, ribbon_marks_color);
  }
  if(ribbon_marks_code_point == 83) {
    surface_fill_rectangle(ribbon_marks_x, ribbon_marks_baseline - 4, ribbon_marks_width, 1, ribbon_marks_color);
  }
} return void;
