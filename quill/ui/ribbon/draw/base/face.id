// The faces the ribbon's own text is set in, as font handles kept in the export rbd_ui: regular, bold and italic.
ribbon_faces_set(int ribbon_faces_set_regular, int ribbon_faces_set_bold, int ribbon_faces_set_italic) {
  export int[] ribbon_faces = [ribbon_faces_set_regular, ribbon_faces_set_bold, ribbon_faces_set_italic];
} return void;
