// A downward triangle in colour rbi_col, three rows of 5, 3 and 1 pixels, centred on x and one row down from y.
ribbon_draw_triangle(int ribbon_triangle_center_x, int ribbon_triangle_top_y, int ribbon_triangle_color) {
  int ribbon_triangle_row = 0;
  while(ribbon_triangle_row < 3) {
    d2_l_rect(ribbon_triangle_center_x - 2 + ribbon_triangle_row, ribbon_triangle_top_y - 1 + ribbon_triangle_row, 5 - 2 * ribbon_triangle_row, 1, ribbon_triangle_color);
    ribbon_triangle_row = ribbon_triangle_row + 1;
  }
} return void;
