// The arrow strip of a split button: the strip at (rbi_x, rbi_y) of width rbi_w and height rbi_h, on the hot colour while rbi_hot is 1 and on the body's otherwise, a line down its left edge and the triangle of a menu at its middle in colour rbi_col.
ribbon_draw_arrow_strip(int ribbon_strip_x, int ribbon_strip_y, int ribbon_strip_width, int ribbon_strip_height, int ribbon_strip_hot, int ribbon_strip_color) {
  int ribbon_strip_background = (import rbd_c_body) + ribbon_strip_hot * ((import rbd_c_hot) - (import rbd_c_body));
  d2_l_rect(ribbon_strip_x, ribbon_strip_y, ribbon_strip_width, ribbon_strip_height, ribbon_strip_background);
  d2_l_rect(ribbon_strip_x, ribbon_strip_y + 2, 1, ribbon_strip_height - 4, (import rbd_c_sep));
} chain (int ribbon_strip_x, int ribbon_strip_y, int ribbon_strip_width, int ribbon_strip_height, int ribbon_strip_hot, int ribbon_strip_color) {
  ribbon_draw_triangle(ribbon_strip_x + ribbon_strip_width / 2, ribbon_strip_y + ribbon_strip_height / 2, ribbon_strip_color);
} return void;
