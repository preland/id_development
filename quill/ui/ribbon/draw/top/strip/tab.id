  int[] rbl_s = (import rbd_s);
  int rbi_open = rbl_s[(import rbd_s_tab)] == rbi_k;
} chain (int rbi_k) {
  int rbi_q = rbi_k * 4;
  int rbi_f = (import rbd_ui)[rbi_open];
  int rbi_tw = gui_text_width(rbi_f, (import rbd_tabs)[rbi_k]);
} chain (int rbi_k) {
  if(rbl_s[(import rbd_s_hot)] == rbi_k && rbi_open == 0) {
    d2_l_rect(rbl_t[rbi_q], rbl_t[rbi_q + 1], rbl_t[rbi_q + 2], rbl_t[rbi_q + 3], (import rbd_c_tabhot));
  }
  gui_text_draw(rbi_f, rbl_t[rbi_q] + (rbl_t[rbi_q + 2] - rbi_tw) / 2, rbl_t[rbi_q + 1] + (rbl_t[rbi_q + 3] - gui_font_line(rbi_f)) / 2, (import rbd_tabs)[rbi_k], (import rbd_c_icon));
  if(rbi_open == 1) {
