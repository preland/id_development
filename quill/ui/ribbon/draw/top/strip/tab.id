// Paints the tab strip: every tab, one after the other.
ribbon_draw_tabs() {
  int ribbon_tabs_number = 0;
  while(ribbon_tabs_number < len((import rbd_tabs))) {
    ribbon_draw_tab(ribbon_tabs_number);
    ribbon_tabs_number = ribbon_tabs_number + 1;
  }
} return void;
