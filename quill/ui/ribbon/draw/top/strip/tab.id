// Paints the tab strip: every tab, one after the other.
rbd_tabs_draw() {
  int rbi_k = 0;
  while(rbi_k < len((import rbd_tabs))) {
    rbd_tab(rbi_k);
    rbi_k = rbi_k + 1;
  }
} return void;
