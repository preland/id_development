// Paints the lines between the groups of the ribbon rib and the names under them: the groups come after the controls in its rectangles, as x, y, width and height each.
ribbon_draw_group_captions(Ribbon rib) {
  int ribbon_captions_count = len(rib.ribbon_rectangles) / 4 - len(rib.items);
  int ribbon_captions_group = 0;
  while(ribbon_captions_group < ribbon_captions_count) {
    ribbon_draw_group_caption(rib, ribbon_captions_group);
    ribbon_captions_group = ribbon_captions_group + 1;
  }
} return void;
