// Paints the lines between the groups of the ribbon rib and the names under them: the groups come after the controls in its rectangles, as x, y, width and height each.
rbd_caps(Ribbon rib) {
  int rbi_n = len(rib.rects) / 4 - len(rib.items);
  int rbi_g = 0;
  while(rbi_g < rbi_n) {
    rbd_cap(rib, rbi_g);
    rbi_g = rbi_g + 1;
  }
} return void;
