// Paints what a control shows outside its body: the sign of a menu or the arrow strip of the control at index rbi_i of the ribbon, and the bar of a colour button.
ribbon_draw_outside(Ribbon rib, int ribbon_outside_index, int ribbon_outside_row, int ribbon_outside_look) {
  int[] ribbon_outside_rectangles = rib.ribbon_rectangles;
  int ribbon_outside_start = ribbon_outside_index * 4;
  int ribbon_outside_hot = ribbon_arrow_wanted(ribbon_outside_index);
} chain (Ribbon rib, int ribbon_outside_index, int ribbon_outside_row, int ribbon_outside_look) {
  ribbon_draw_sign(ribbon_outside_rectangles[ribbon_outside_start], ribbon_outside_rectangles[ribbon_outside_start + 1], ribbon_outside_rectangles[ribbon_outside_start + 2], ribbon_outside_rectangles[ribbon_outside_start + 3], ribbon_outside_look, ribbon_outside_hot);
  ribbon_draw_color_bar(ribbon_outside_rectangles[ribbon_outside_start], ribbon_outside_rectangles[ribbon_outside_start + 1], ribbon_outside_rectangles[ribbon_outside_start + 2], ribbon_outside_rectangles[ribbon_outside_start + 3], ribbon_outside_row);
} return void;
