// Paints what a control shows inside its body rbg of item row rbi_row and look rbi_shape: its icon and, for a large control, its name; or, for a field, its name at the left; or the preview of the gallery.
ribbon_draw_inside(GuiToggle ribbon_inside_control, int ribbon_inside_row, int ribbon_inside_look) {
  int[] ribbon_inside_values = ribbon_inside_control.btn.v;
  int ribbon_inside_ink = ribbon_item_ink(ribbon_inside_control);
  if(ribbon_inside_look < 3) {
    ribbon_draw_icon(ribbon_inside_row, ribbon_inside_values[0], ribbon_inside_values[1], ribbon_inside_values[2], ribbon_inside_values[3], ribbon_inside_ink);
  }
} chain (GuiToggle ribbon_inside_control, int ribbon_inside_row, int ribbon_inside_look) {
  if(ribbon_inside_look == 3) {
    ribbon_draw_field(ribbon_inside_control, ribbon_inside_row, ribbon_inside_ink);
  }
  if(ribbon_inside_look == 4) {
    ribbon_draw_tiles(ribbon_inside_control, ribbon_inside_ink);
  }
} return void;
