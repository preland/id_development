// Paints the control at index rbi_i of the ribbon rib whose widgets are rbl_ws: its body (a toggle shows its state), what is inside it, and the sign or the arrow strip outside it. A combo box paints itself (rbd_combos) and has nothing here.
ribbon_draw_item(Ribbon rib, GuiToggle[] ribbon_item_widgets, int ribbon_item_index) {
  GuiToggle ribbon_item_control = ribbon_item_widgets[ribbon_item_index];
  int ribbon_item_row = rib.items[ribbon_item_index];
  int ribbon_item_look = ribbon_item_shape(ribbon_item_row);
} chain (Ribbon rib, GuiToggle[] ribbon_item_widgets, int ribbon_item_index) {
  if(ribbon_item_look != 6) {
    gui_toggle_draw(ribbon_item_control);
    ribbon_draw_inside(ribbon_item_control, ribbon_item_row, ribbon_item_look);
    ribbon_draw_outside(rib, ribbon_item_index, ribbon_item_row, ribbon_item_look);
  }
} return void;
