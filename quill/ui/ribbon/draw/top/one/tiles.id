// Writes style number rbi_k of the gallery's preview in its own face (bold for a heading, italic for the subtitle) on the line rbi_k of the gallery at rbl_box, in colour rbi_col.
ribbon_draw_tile(int[] ribbon_tile_box, int ribbon_tile_number, int ribbon_tile_color) {
  int ribbon_tile_face = (import ribbon_faces)[(import rbd_style_f)[ribbon_tile_number]];
  string ribbon_tile_text = (import rbd_styles)[ribbon_tile_number];
  gui_text_draw(ribbon_tile_face, ribbon_tile_box[0] + 8, ribbon_tile_box[1] + 4 + ribbon_tile_number * 20, ribbon_tile_text, ribbon_tile_color);
} return void;
