// Paints the preview of the styles gallery in the field rbg: the first three styles, each in its own face, cut to the field and leaving room at the right for the sign of a menu.
ribbon_draw_tiles(GuiToggle ribbon_tiles_control, int ribbon_tiles_color) {
  int[] ribbon_tiles_values = ribbon_tiles_control.btn.v;
  int ribbon_tiles_number = 0;
  surface_clip_push(ribbon_tiles_values[0] + 1, ribbon_tiles_values[1] + 1, ribbon_tiles_values[2] - 16, ribbon_tiles_values[3] - 2);
} chain (GuiToggle ribbon_tiles_control, int ribbon_tiles_color) {
  while(ribbon_tiles_number < 3) {
    ribbon_draw_tile(ribbon_tiles_values, ribbon_tiles_number, ribbon_tiles_color);
    ribbon_tiles_number = ribbon_tiles_number + 1;
  }
  surface_clip_pop();
} return void;
