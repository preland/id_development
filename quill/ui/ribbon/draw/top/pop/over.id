// Paints the menu, the gallery or the colour grid that is open, over everything; nothing when none is.
rbd_pop_draw() {
  int rbi_k = (import rbd_s)[(import rbd_s_pk)];
  if(rbi_k == 1) {
    gui_menu_draw((import rbd_menu)[0]);
  }
  if(rbi_k == 2) {
    gui_gallery_draw((import rbd_gal)[0]);
  }
} chain () {
  if(rbi_k == 3) {
    gui_colors_draw((import rbd_cg)[0]);
  }
} return void;
