// Paints every control of the ribbon rib, one after the other; rbl_ws are its widgets.
ribbon_draw_items(Ribbon rib, GuiToggle[] ribbon_items_widgets) {
  int ribbon_items_index = 0;
  while(ribbon_items_index < len(rib.items)) {
    ribbon_draw_item(rib, ribbon_items_widgets, ribbon_items_index);
    ribbon_items_index = ribbon_items_index + 1;
  }
} return void;
