// Paints what lies over the band: the combo boxes (their lists are over the rest), the open menu, gallery or colour grid, then the tooltip when it is on show.
ribbon_draw_overlay() {
  ribbon_draw_combo_boxes();
  ribbon_draw_open_popup();
  gui_tip_draw((import ribbon_fit_tips)[0]);
} return void;
