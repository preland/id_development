// Paints the menu, the gallery or the colour grid that is open, over everything; nothing when none is.
ribbon_draw_open_popup() {
  int ribbon_popup_kind = (import ribbon_fit_state)[(import rbd_s_pk)];
  if(ribbon_popup_kind == 1) {
    gui_menu_draw((import ribbon_fit_menus)[0]);
  }
  if(ribbon_popup_kind == 2) {
    gui_gallery_draw((import ribbon_fit_galleries)[0]);
  }
} chain () {
  if(ribbon_popup_kind == 3) {
    gui_colors_draw((import ribbon_fit_color_grids)[0]);
  }
} return void;
