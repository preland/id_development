// Paints every control of the ribbon rib, one after the other; rbl_ws are its widgets.
rbd_items(Ribbon rib, GuiToggle[] rbl_ws) {
  int rbi_i = 0;
  while(rbi_i < len(rib.items)) {
    rbd_item(rib, rbl_ws, rbi_i);
    rbi_i = rbi_i + 1;
  }
} return void;
