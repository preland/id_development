// Paints the sign of the control at (rbi_x, rbi_y) of size rbi_w by rbi_h of look rbi_shape: the arrow strip at the right of a split button (on the hot colour while rbi_hot is 1), the triangle of a menu for a control that opens one, nothing for any other.
ribbon_draw_sign(int ribbon_sign_x, int ribbon_sign_y, int ribbon_sign_width, int ribbon_sign_height, int ribbon_sign_look, int ribbon_sign_hot) {
  int ribbon_sign_arrow_x = ribbon_sign_position(ribbon_sign_x, ribbon_sign_y, ribbon_sign_width, ribbon_sign_height, ribbon_sign_look, 0);
  int ribbon_sign_arrow_y = ribbon_sign_position(ribbon_sign_x, ribbon_sign_y, ribbon_sign_width, ribbon_sign_height, ribbon_sign_look, 1);
