// Where the sign of a menu goes on a control at (rbi_x, rbi_y) of size rbi_w by rbi_h of look rbi_shape (rbd_k_shape), as x when rbi_axis is 0 and as y when it is 1: under the icon of a large control with an icon and a name, at the right of a small one or of a field, at the bottom right of the gallery.
ribbon_sign_position(int ribbon_position_x, int ribbon_position_y, int ribbon_position_width, int ribbon_position_height, int ribbon_position_look, int ribbon_position_axis) {
  int ribbon_position_large = ribbon_position_height >= 48;
  int ribbon_position_sign_x = ribbon_position_x + ribbon_position_width - 9 + (ribbon_position_large * (ribbon_position_look == 1)) * (9 - ribbon_position_width / 2) + (ribbon_position_look == 1) * (1 - ribbon_position_large);
  int ribbon_position_sign_y = ribbon_position_y + ribbon_position_height / 2 + (ribbon_position_large * (ribbon_position_look == 1)) * (33 - ribbon_position_height / 2) + (ribbon_position_look == 4) * (ribbon_position_height / 2 - 9);
} chain (int ribbon_position_x, int ribbon_position_y, int ribbon_position_width, int ribbon_position_height, int ribbon_position_look, int ribbon_position_axis) {
  int ribbon_position_value = ribbon_position_sign_x * (ribbon_position_axis == 0) + ribbon_position_sign_y * (ribbon_position_axis == 1);
} return int ribbon_position_value;
