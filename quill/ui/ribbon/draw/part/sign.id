} chain (int ribbon_sign_x, int ribbon_sign_y, int ribbon_sign_width, int ribbon_sign_height, int ribbon_sign_look, int ribbon_sign_hot) {
  if(ribbon_sign_look == 1 || ribbon_sign_look == 3 || ribbon_sign_look == 4) {
    ribbon_draw_triangle(ribbon_sign_arrow_x, ribbon_sign_arrow_y, (import rbd_c_icon));
  }
} return void;
