// Writes the name of a large button (one rbi_big says is large) centred along its bottom in colour rbi_col, cut to the button when it is wider than it. A small button has no room for one.
ribbon_draw_large_name(int ribbon_large_row, int ribbon_large_x, int ribbon_large_y, int ribbon_large_width, int ribbon_large_height, int ribbon_large_flag, int ribbon_large_color) {
  string ribbon_large_text = (import rb_label)[ribbon_large_row];
  int ribbon_large_face = (import ribbon_faces)[0];
  int ribbon_large_text_width = gui_text_width(ribbon_large_face, ribbon_large_text);
} chain (int ribbon_large_row, int ribbon_large_x, int ribbon_large_y, int ribbon_large_width, int ribbon_large_height, int ribbon_large_flag, int ribbon_large_color) {
  if(ribbon_large_flag == 1) {
    surface_clip_push(ribbon_large_x + 1, ribbon_large_y + 1, ribbon_large_width - 2, ribbon_large_height - 2);
    gui_text_draw(ribbon_large_face, ribbon_large_x + (ribbon_large_width - ribbon_large_text_width) / 2, ribbon_large_y + ribbon_large_height - gui_font_line(ribbon_large_face) - 3, ribbon_large_text, ribbon_large_color);
    surface_clip_pop();
  }
} return void;
