// Paints the icon of item row rbi_row inside the button rectangle (rbi_x, rbi_y, rbi_w, rbi_h) in colour rbi_col: a vector icon where the ribbon has one for the command, 24 px high near the top of a large button and 16 px centred in a small one, else the letter the model names; a large button also carries its name at the bottom.
ribbon_draw_icon(int ribbon_icon_row, int ribbon_icon_x, int ribbon_icon_y, int ribbon_icon_width, int ribbon_icon_height, int ribbon_icon_color) {
  int ribbon_icon_code = (import rb_icon)[ribbon_icon_row];
  int ribbon_icon_large = ribbon_icon_height >= 48;
  int ribbon_icon_pixels = 16 + 8 * ribbon_icon_large;
} chain (int ribbon_icon_row, int ribbon_icon_x, int ribbon_icon_y, int ribbon_icon_width, int ribbon_icon_height, int ribbon_icon_color) {
  int ribbon_icon_left_x = ribbon_icon_x + (ribbon_icon_width - ribbon_icon_pixels) / 2;
  int ribbon_icon_top_y = ribbon_icon_y + 4 * ribbon_icon_large + (ribbon_icon_height - ribbon_icon_pixels) / 2 * (1 - ribbon_icon_large);
  int ribbon_icon_vector = list_index_of((import ic_cmd), ribbon_icon_code) >= 0;
} chain (int ribbon_icon_row, int ribbon_icon_x, int ribbon_icon_y, int ribbon_icon_width, int ribbon_icon_height, int ribbon_icon_color) {
  if(ribbon_icon_vector == 1) {
    vec_icon(ribbon_icon_code, ribbon_icon_pixels, ribbon_icon_color, ribbon_icon_left_x, ribbon_icon_top_y);
  }
  if(ribbon_icon_vector == 0) {
    ribbon_draw_letter(ribbon_icon_code, ribbon_icon_x + ribbon_icon_width / 2, ribbon_icon_y + ribbon_icon_height / 2, ribbon_icon_color);
  }
  ribbon_draw_large_name(ribbon_icon_row, ribbon_icon_x, ribbon_icon_y, ribbon_icon_width, ribbon_icon_height, ribbon_icon_large, ribbon_icon_color);
} return void;
