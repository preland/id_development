ribbon_command_at(Ribbon rib, int i) {
  int ribbon_command_at_row = rib.items[i];
  int ribbon_command_at_result = (import rb_cmd)[ribbon_command_at_row];
} return int ribbon_command_at_result;
(Ribbon([5, 7], [], [0, 0]), 0):(201)
(Ribbon([5, 7], [], [0, 0]), 1):(205)

ribbon_commands(Ribbon rib) {
  int[] ribbon_commands_result = [];
  int i = 0;
  while(i < len(rib.items)) {
    int ribbon_commands_command = ribbon_command_at(rib, i);
    push(ribbon_commands_result, ribbon_commands_command);
    i = i + 1;
  }
} return int[] ribbon_commands_result;
(Ribbon([5, 6, 7], [], [0, 0, 0])):([201, 202, 205])
(Ribbon([], [], [])):([])

rib_set_state(Ribbon rib, int ribbon_state_command, int ribbon_state_value) {
  int[] state = rib.state;
  int i = 0;
  while(i < len(state)) {
    if(ribbon_command_at(rib, i) == ribbon_state_command) {
      state[i] = ribbon_state_value;
    }
    i = i + 1;
  }
} return void;
(Ribbon([5, 6, 7], [], [0, 0, 0]), 202, 1):(Ribbon([5, 6, 7], [], [0, 1, 0]), 202, 1)
(Ribbon([5, 6, 7], [], [0, 0, 0]), 205, 3):(Ribbon([5, 6, 7], [], [0, 0, 3]), 205, 3)
(Ribbon([5, 6], [], [0, 0]), 999, 2):(Ribbon([5, 6], [], [0, 0]), 999, 2)
