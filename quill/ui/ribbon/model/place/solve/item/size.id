row_rect(int[] fr, int ri, int rx, int w) {
  int y = fr[0] + (ri % 3) * fr[1];
  int h = fr[1] + (fr[2] - fr[1]) * (ri / 3);
  int[] quad = [rx, y, w, h];
} return int[] quad;
