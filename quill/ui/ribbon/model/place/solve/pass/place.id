rib_place(Ribbon rib, int ribbon_place_left, int y, int w, int h) {
  int[] ribbon_place_geometry = [ribbon_place_left, y, h, 0];
  int[] probe = [];
  int ribbon_place_natural = rib_pass(rib.items, ribbon_place_geometry, probe);
} chain (Ribbon rib, int ribbon_place_left, int y, int w, int h) {
  int ribbon_place_extra = fixed_point_clamp(w - (ribbon_place_natural - ribbon_place_left), 0, (import rib_flex_grow));
  ribbon_place_geometry[3] = ribbon_place_extra;
  int[] out = [];
} chain (Ribbon rib, int ribbon_place_left, int y, int w, int h) {
  int right = rib_pass(rib.items, ribbon_place_geometry, out);
  rib.ribbon_rectangles = out;
} return void;
