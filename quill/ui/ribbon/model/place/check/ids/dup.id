ribbon_identifier_duplicates(int[] ribbon_duplicates_identifiers) {
  int ribbon_duplicates_count = 0;
  int i = 0;
  while(i < len(ribbon_duplicates_identifiers)) {
    ribbon_duplicates_count = ribbon_duplicates_count + (list_index_of(ribbon_duplicates_identifiers, ribbon_duplicates_identifiers[i]) != i);
    i = i + 1;
  }
} return int ribbon_duplicates_count;
([1, 2, 2, 3, 3]):(2)
([1, 2, 3]):(0)

ribbon_duplicate_commands(int tab) {
  Ribbon rib = rib_build(tab);
  int[] ribbon_duplicate_commands_list = ribbon_commands(rib);
  int ribbon_duplicate_commands_count = ribbon_identifier_duplicates(ribbon_duplicate_commands_list);
} return int ribbon_duplicate_commands_count;
(1):(0)
