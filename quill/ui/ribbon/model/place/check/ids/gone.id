ribbon_identifiers_missing(int[] ribbon_missing_identifiers, int[] ribbon_missing_first_routes, int[] ribbon_missing_second_routes) {
  int gone = 0;
  int i = 0;
  while(i < len(ribbon_missing_identifiers)) {
    gone = gone + (list_find(ribbon_missing_first_routes, ribbon_missing_identifiers[i]) + list_find(ribbon_missing_second_routes, ribbon_missing_identifiers[i]) == 0);
    i = i + 1;
  }
} return int gone;
([1, 2, 3], [1], [2]):(1)
([1, 2, 3], [1, 2, 3], [4]):(0)
