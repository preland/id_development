rects_right(int[] rects) {
  int right = 0;
  int i = 0;
  while(i < len(rects)) {
    right = fixed_point_maximum(right, rects[i] + rects[i + 2]);
    i = i + 4;
  }
} return int right;
([0, 0, 10, 10, 20, 0, 5, 10]):(25)
([]):(0)

rib_right(Ribbon rib) {
  int right = rects_right(rib.rects);
} return int right;
