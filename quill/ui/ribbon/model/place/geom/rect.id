rect_hit(int[] rects, int ia, int ib) {
  int rp = ia * 4;
  int q = ib * 4;
  int hx = (rects[rp] < rects[q] + rects[q + 2]) && (rects[q] < rects[rp] + rects[rp + 2]);
} chain (int[] rects, int ia, int ib) {
  int hy = (rects[rp + 1] < rects[q + 1] + rects[q + 3]) && (rects[q + 1] < rects[rp + 1] + rects[rp + 3]);
  int hit = hx * hy;
} return int hit;
([0, 0, 10, 10, 5, 5, 10, 10], 0, 1):(1)
([0, 0, 10, 10, 10, 0, 10, 10], 0, 1):(0)
([0, 0, 10, 10, 0, 10, 10, 10], 0, 1):(0)
([10, 0, 10, 10, 0, 0, 10, 10], 0, 1):(0)
([0, 10, 10, 10, 0, 0, 10, 10], 0, 1):(0)

rect_row_hits(int[] rects, int ia, int n) {
  int hits = 0;
  int ib = ia + 1;
  while(ib < n) {
    hits = hits + rect_hit(rects, ia, ib);
    ib = ib + 1;
  }
} return int hits;
([0, 0, 10, 10, 5, 5, 10, 10, 8, 8, 4, 4], 0, 3):(2)
([0, 0, 10, 10, 5, 5, 10, 10, 8, 8, 4, 4], 2, 3):(0)

rects_overlap(int[] rects, int n) {
  int total = 0;
  int ia = 0;
  while(ia < n) {
    total = total + rect_row_hits(rects, ia, n);
    ia = ia + 1;
  }
} return int total;
