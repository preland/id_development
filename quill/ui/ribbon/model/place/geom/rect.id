rect_hit(int[] ribbon_hit_rectangles, int ribbon_hit_first, int ribbon_hit_second) {
  int ribbon_hit_first_start = ribbon_hit_first * 4;
  int q = ribbon_hit_second * 4;
  int ribbon_hit_across = (ribbon_hit_rectangles[ribbon_hit_first_start] < ribbon_hit_rectangles[q] + ribbon_hit_rectangles[q + 2]) && (ribbon_hit_rectangles[q] < ribbon_hit_rectangles[ribbon_hit_first_start] + ribbon_hit_rectangles[ribbon_hit_first_start + 2]);
} chain (int[] ribbon_hit_rectangles, int ribbon_hit_first, int ribbon_hit_second) {
  int ribbon_hit_down = (ribbon_hit_rectangles[ribbon_hit_first_start + 1] < ribbon_hit_rectangles[q + 1] + ribbon_hit_rectangles[q + 3]) && (ribbon_hit_rectangles[q + 1] < ribbon_hit_rectangles[ribbon_hit_first_start + 1] + ribbon_hit_rectangles[ribbon_hit_first_start + 3]);
  int hit = ribbon_hit_across * ribbon_hit_down;
} return int hit;
([0, 0, 10, 10, 5, 5, 10, 10], 0, 1):(1)
([0, 0, 10, 10, 10, 0, 10, 10], 0, 1):(0)
([0, 0, 10, 10, 0, 10, 10, 10], 0, 1):(0)
([10, 0, 10, 10, 0, 0, 10, 10], 0, 1):(0)
([0, 10, 10, 10, 0, 0, 10, 10], 0, 1):(0)

rect_row_hits(int[] ribbon_row_hits_rectangles, int ribbon_row_hits_first, int n) {
  int hits = 0;
  int ribbon_row_hits_second = ribbon_row_hits_first + 1;
  while(ribbon_row_hits_second < n) {
    hits = hits + rect_hit(ribbon_row_hits_rectangles, ribbon_row_hits_first, ribbon_row_hits_second);
    ribbon_row_hits_second = ribbon_row_hits_second + 1;
  }
} return int hits;
([0, 0, 10, 10, 5, 5, 10, 10, 8, 8, 4, 4], 0, 3):(2)
([0, 0, 10, 10, 5, 5, 10, 10, 8, 8, 4, 4], 2, 3):(0)

ribbon_rectangles_overlap(int[] ribbon_overlap_rectangles, int n) {
  int total = 0;
  int ribbon_overlap_first = 0;
  while(ribbon_overlap_first < n) {
    total = total + rect_row_hits(ribbon_overlap_rectangles, ribbon_overlap_first, n);
    ribbon_overlap_first = ribbon_overlap_first + 1;
  }
} return int total;
