key_pick(int[] cmds, int at) {
  int cmd = 0;
  if(at >= 0) {
    cmd = cmds[at];
  }
} return int cmd;
([5, 6], 1):(6)
([5, 6], -1):(0)

key_cmd(int mods, int key) {
  int code = mods * 4096 + key;
  int at = list_index_of((import key_code), code);
  int cmd = key_pick((import key_cmds), at);
} return int cmd;
(2, 98):(301)
(3, 115):(104)
(0, 98):(0)
(0, 1010):(418)

key_name(int key) {
  string name = "";
  if(key > 1000) {
    name = (import key_names)[key - 1001];
  } else {
    name = chr(chr_upper(key));
  }
} return string name;
(98):("B")
(1009):("Enter")
(93):("]")
