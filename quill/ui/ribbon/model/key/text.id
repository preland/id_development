ribbon_modifier_part(int mods, int bit, string name) {
  string ribbon_modifier_segment = "";
  if((mods & bit) != 0) {
    ribbon_modifier_segment = name + "+";
  }
} return string ribbon_modifier_segment;
(2, 2, "Ctrl"):("Ctrl+")
(1, 2, "Ctrl"):("")

mods_text(int mods) {
  string ribbon_modifiers_head = ribbon_modifier_part(mods, 2, "Ctrl") + ribbon_modifier_part(mods, 1, "Shift");
  string text = ribbon_modifiers_head + ribbon_modifier_part(mods, 4, "Alt");
} return string text;
(3):("Ctrl+Shift+")
(6):("Ctrl+Alt+")
(0):("")

key_text(int code) {
  int mods = code / 4096;
  int key = code % 4096;
  string text = mods_text(mods) + key_name(key);
} return string text;
(8290):("Ctrl+B")
(12403):("Ctrl+Shift+S")
(1010):("Tab")
