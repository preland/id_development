int wa_d_ask = 1;
int wa_d_open = 2;
int wa_d_save = 3;
int wa_d_msg = 4;
string[] wa_d_names = ["none", "unsaved", "open", "save", "message"];
// What the dialogs say: the heading and the buttons of the unsaved-changes question (Save is button 0, Don't Save 1, Cancel 2), of a message that has only OK, and of the two pickers, which have only Cancel because choosing a file chooses it; the lines of the pickers dialog that are left to the file list; the narrowest a dialog is and the widest its message lines are, in pixels.
string wa_h_ask = "Unsaved changes";
string[] wa_k_ask = ["Save", "Don't Save", "Cancel"];
string wa_h_msg = "Quill";
string[] wa_k_msg = ["OK"];
