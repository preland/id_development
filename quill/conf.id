int[] cv_pc_fld = [quill_paragraph_line_percent, quill_paragraph_indent_left, quill_paragraph_indent_right, quill_paragraph_space_before, quill_paragraph_space_after];
// How much one press of the grow and shrink buttons changes the font size, in half-points, and of the indent buttons the left indent, in twips.
int cv_grow = 2;
int cv_indent = 720;
// Every command of the ribbon table the canvas does, with or without an argument: a command that is not here (opening a file, say, or the zoom, which is the viewer's) leaves the document and the view as they are.
int[] cv_r_cmd = [cmd_undo, cmd_redo, cmd_cut, cmd_copy, cmd_paste, cmd_select_all, cmd_bold, cmd_italic, cmd_underline, cmd_strike, cmd_sub, cmd_sup, cmd_font_family, cmd_font_size, cmd_size_grow, cmd_size_shrink, cmd_font_color, cmd_highlight, cmd_clear_fmt, cmd_align_left, cmd_align_center, cmd_align_right, cmd_align_justify, cmd_indent_dec, cmd_indent_inc, cmd_line_spacing, cmd_indent_left, cmd_indent_right, cmd_space_before, cmd_space_after, cmd_style, cmd_page_break, cmd_page_size, cmd_page_orient, cmd_page_margins];
