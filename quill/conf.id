string wa_h_save = "Save As";
string[] wa_k_pick = ["Cancel"];
string[] wa_b_pick = ["", "", "", "", "", "", "", "", "", "", "", ""];
int wa_minw = 360;
int wa_msgw = 420;
// The list commands, in the order of the built-in lists they start (1 bullets, 2 numbers): the list id is the command's place here plus one; the style shortcuts and the styles they apply; the commands whose state the ribbon is told after every command (the others it learns from the canvas, vw_lk).
int[] wa_list_cmd = [cmd_bullets, cmd_numbering];
int[] wa_head_cmd = [cmd_style_h1, cmd_style_h2, cmd_style_h3];
string[] wa_head_name = ["Heading 1", "Heading 2", "Heading 3"];
int[] wa_put_cmd = [cmd_undo, cmd_redo, cmd_cut, cmd_copy, cmd_bullets, cmd_numbering, cmd_list_deeper, cmd_list_shallower];
// How deep a list goes: the highest level a paragraph can sit on.
int wa_deepest = 2;
// The commands the app does for a key itself, because the canvas does not (they are the file commands, the list commands, the heading shortcuts, and the zoom the key table has); the keys Page Up and Page Down, which move a screenful less wa_overlap pixels so that the line the caret was on stays in view.
int[] wa_own_cmd = [cmd_new, cmd_open, cmd_save, cmd_save_as, cmd_find, cmd_replace, cmd_bullets, cmd_style_h1, cmd_style_h2, cmd_style_h3, cmd_zoom_100, cmd_list_deeper, cmd_list_shallower];
int wa_k_pgup = 1012;
