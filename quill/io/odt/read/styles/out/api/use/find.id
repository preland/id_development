// The index of a key in the lookup lists, searched from the end so that a content document's style beats a styles document's of the same name; -1 when it is not there.
odt_style_key_find(Odt_style_lookup odt_style_key_find_lookup, string odt_style_key_find_key) {
  int odt_style_key_find_result = 0 - 1;
  int i = len(odt_style_key_find_lookup.keys) - 1;
  while(i >= 0 && odt_style_key_find_result < 0) {
    if(odt_style_key_find_lookup.keys[i] == odt_style_key_find_key) {
      odt_style_key_find_result = i;
    }
    i = i - 1;
  }
} return int odt_style_key_find_result;
(Odt_style_lookup(["p:A", "t:A", "p:A"], [1, 2, 3], [-1, -1, -1]), "p:A"):(2)
(Odt_style_lookup(["p:A"], [1], [-1]), "t:A"):(-1)

// The character row that the text properties of the paragraph style called os_sname amount to when the style is automatic and sets any; -1 when it is named, undefined or sets none.
odt_style_over_for_name(Odt_style_lookup odt_style_over_for_name_lookup, string odt_style_over_for_name_name) {
  int odt_style_over_for_name_position = odt_style_key_find(odt_style_over_for_name_lookup, "p:" + odt_style_over_for_name_name);
  int odt_style_over_for_name_overlay = 0 - 1;
  if(odt_style_over_for_name_position >= 0) {
    odt_style_over_for_name_overlay = odt_style_over_for_name_lookup.over[odt_style_over_for_name_position];
  }
} return int odt_style_over_for_name_overlay;
(Odt_style_lookup(["p:P1"], [4], [7]), "P1"):(7)
(Odt_style_lookup(["p:P1"], [4], [-1]), "P1"):(-1)
(Odt_style_lookup(["p:P1"], [4], [7]), "P2"):(-1)
