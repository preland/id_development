// The row the lookup holds for the style called os_sname under the key prefix os_spre ("t:" a span's text style, "l:" a text:list's, "p:" a paragraph style), 0 (nothing set) when the name is "" or not defined.
ost_row(OdtSty os_k, string os_spre, string os_sname) {
  int os_ik = ost_key(os_k, os_spre + os_sname);
  int os_ir = 0;
  if(os_ik >= 0) {
    os_ir = os_k.ids[os_ik];
  }
} return int os_ir;
(OdtSty(["t:T1"], [6], [-1]), "t:", "T1"):(6)
(OdtSty(["t:T1"], [6], [-1]), "t:", "T2"):(0)
(OdtSty(["l:L1"], [3], [-1]), "l:", "L1"):(3)
(OdtSty(["l:L1"], [3], [-1]), "l:", ""):(0)
(OdtSty(["p:Heading_20_1"], [4], [-1]), "p:", "Heading_20_1"):(4)
(OdtSty(["p:Heading_20_1"], [4], [-1]), "p:", ""):(0)
(OdtSty(["p:Heading_20_1"], [4], [-1]), "p:", "Other"):(0)

// An empty lookup, to be filled by ost_load.
ost_new() {
  string[] os_lkeys = [];
  int[] os_lids = [];
  int[] os_lover = [];
} chain () {
  OdtSty os_k = OdtSty(os_lkeys, os_lids, os_lover);
} return OdtSty os_k;
():(OdtSty([], [], []))
given ost_t_doc ():(OdtSty([], [], []))
