// The row the lookup holds for the style called os_sname under the key prefix os_spre ("t:" a span's text style, "l:" a text:list's, "p:" a paragraph style), 0 (nothing set) when the name is "" or not defined.
odt_style_lookup_row(Odt_style_lookup odt_style_lookup_row_lookup, string odt_style_lookup_row_prefix, string odt_style_lookup_row_name) {
  int odt_style_lookup_row_position = odt_style_key_find(odt_style_lookup_row_lookup, odt_style_lookup_row_prefix + odt_style_lookup_row_name);
  int odt_style_lookup_row_row = 0;
  if(odt_style_lookup_row_position >= 0) {
    odt_style_lookup_row_row = odt_style_lookup_row_lookup.odt_style_list_identifiers[odt_style_lookup_row_position];
  }
} return int odt_style_lookup_row_row;
(Odt_style_lookup(["t:T1"], [6], [-1]), "t:", "T1"):(6)
(Odt_style_lookup(["t:T1"], [6], [-1]), "t:", "T2"):(0)
(Odt_style_lookup(["l:L1"], [3], [-1]), "l:", "L1"):(3)
(Odt_style_lookup(["l:L1"], [3], [-1]), "l:", ""):(0)
(Odt_style_lookup(["p:Heading_20_1"], [4], [-1]), "p:", "Heading_20_1"):(4)
(Odt_style_lookup(["p:Heading_20_1"], [4], [-1]), "p:", ""):(0)
(Odt_style_lookup(["p:Heading_20_1"], [4], [-1]), "p:", "Other"):(0)

// An empty lookup, to be filled by ost_load.
odt_style_lookup_new() {
  string[] odt_style_lookup_new_keys = [];
  int[] odt_style_lookup_new_identifiers = [];
  int[] odt_style_lookup_new_overlays = [];
} chain () {
  Odt_style_lookup odt_style_lookup_new_lookup = Odt_style_lookup(odt_style_lookup_new_keys, odt_style_lookup_new_identifiers, odt_style_lookup_new_overlays);
} return Odt_style_lookup odt_style_lookup_new_lookup;
():(Odt_style_lookup([], [], []))
given odt_style_test_document ():(Odt_style_lookup([], [], []))
