// The master page named by the style of the first paragraph or heading of a content document, "" when that style names none or there is no paragraph.
odt_style_first_master_page(int[] odt_style_first_master_page_content_bytes) {
  XmlR odt_style_first_master_page_reader = xml_reader_open(odt_style_first_master_page_content_bytes);
  string[] odt_style_first_master_page_pairs = [];
  int odt_style_first_master_page_event = xml_reader_next(odt_style_first_master_page_reader);
} chain (int[] odt_style_first_master_page_content_bytes) {
