  string odt_style_first_master_page_style_name = "";
  while(odt_style_first_master_page_event > 0 && odt_style_first_master_page_stop == 0) {
    odt_style_first_master_page_stop = odt_style_master_event(odt_style_first_master_page_pairs, odt_style_first_master_page_reader, odt_style_first_master_page_event);
    if(odt_style_first_master_page_stop == 1) {
      odt_style_first_master_page_style_name = xml_reader_attribute(odt_style_first_master_page_reader, "text:style-name");
    }
    odt_style_first_master_page_event = xml_reader_next(odt_style_first_master_page_reader);
  }
} chain (int[] odt_style_first_master_page_content_bytes) {
  string odt_style_first_master_page_master = odt_style_master_for_style(odt_style_first_master_page_pairs, odt_style_first_master_page_style_name);
} return string odt_style_first_master_page_master;
