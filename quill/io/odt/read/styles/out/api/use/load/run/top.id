// The master page named by the style of the first paragraph or heading of a content document, "" when that style names none or there is no paragraph.
ost_first_master(int[] os_lcx) {
  XmlR os_r = xr_open(os_lcx);
  string[] os_lpairs = [];
  int os_iev = xr_next(os_r);
} chain (int[] os_lcx) {
  int os_istop = 0;
  string os_sstyle = "";
  while(os_iev > 0 && os_istop == 0) {
    os_istop = ost_master_one(os_lpairs, os_r, os_iev);
    if(os_istop == 1) {
      os_sstyle = xr_attr(os_r, "text:style-name");
    }
    os_iev = xr_next(os_r);
  }
} chain (int[] os_lcx) {
  string os_smaster = ost_pair(os_lpairs, os_sstyle);
} return string os_smaster;
