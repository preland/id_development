// Reads the styles of an ODT package into a document made by doc_new: os_lsx is styles.xml and os_lcx is content.xml, as bytes. The named styles replace or join the document's styles, the font faces join its fonts, the list styles join its lists, and the page layout of the first paragraph's master page becomes its page. os_k becomes the lookup the content reader asks. Answers 0, or a code for ost_error.
odt_style_load(Doc odt_style_load_document, int[] odt_style_load_styles_bytes, int[] odt_style_load_content_bytes, Odt_style_lookup odt_style_load_lookup) {
  string[] odt_style_load_faces = [];
  odt_named_style_records odt_style_load_bag = odt_named_bag_new();
  int odt_style_load_code = odt_style_read_pass(odt_style_load_document, odt_style_load_bag, odt_style_load_faces, odt_style_load_styles_bytes, (import ost_e_styles));
} chain (Doc odt_style_load_document, int[] odt_style_load_styles_bytes, int[] odt_style_load_content_bytes, Odt_style_lookup odt_style_load_lookup) {
  if(odt_style_load_code == 0) {
    odt_style_load_code = odt_style_read_pass(odt_style_load_document, odt_style_load_bag, odt_style_load_faces, odt_style_load_content_bytes, (import ost_e_content));
  }
  if(odt_style_load_code == 0) {
    odt_style_apply_bag(odt_style_load_document, odt_style_load_bag, odt_style_load_faces, odt_style_load_lookup);
  }
  string odt_style_load_master = odt_style_first_master_page(odt_style_load_content_bytes);
} chain (Doc odt_style_load_document, int[] odt_style_load_styles_bytes, int[] odt_style_load_content_bytes, Odt_style_lookup odt_style_load_lookup) {
  odt_named_page_layouts odt_style_load_page_table = odt_named_page_scan(xml_reader_open(odt_style_load_styles_bytes));
  int[] odt_style_load_page_row = odt_named_page_pick(odt_style_load_page_table, odt_style_load_master);
  odt_named_page_apply(odt_style_load_document, odt_style_load_page_row);
} return int odt_style_load_code;
