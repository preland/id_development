// Puts the styles the bag holds into the document and the lookup: sizes made absolute, named styles registered and filled, then every style and list definition keyed by its name.
ost_apply(Doc os_d, StyBag os_b, string[] os_lface, OdtSty os_k) {
  ost_sizes(os_b);
  int[] os_lidx = ost_reg(os_d.fmt, os_b);
  ost_fill(os_d, os_b, os_lface, os_lidx);
} chain (Doc os_d, StyBag os_b, string[] os_lface, OdtSty os_k) {
  ost_keys(os_d, os_b, os_lface, os_lidx, os_k);
  ost_key_lists(os_d.fmt, os_k);
} return void;
