// Puts the styles the bag holds into the document and the lookup: sizes made absolute, named styles registered and filled, then every style and list definition keyed by its name.
odt_style_apply_bag(Doc odt_style_apply_bag_document, odt_named_style_records odt_style_apply_bag_bag, string[] odt_style_apply_bag_faces, Odt_style_lookup odt_style_apply_bag_lookup) {
  odt_style_size_resolve_all(odt_style_apply_bag_bag);
  int[] odt_style_apply_bag_indexes = odt_style_register_all(odt_style_apply_bag_document.fmt, odt_style_apply_bag_bag);
  odt_style_fill_all(odt_style_apply_bag_document, odt_style_apply_bag_bag, odt_style_apply_bag_faces, odt_style_apply_bag_indexes);
} chain (Doc odt_style_apply_bag_document, odt_named_style_records odt_style_apply_bag_bag, string[] odt_style_apply_bag_faces, Odt_style_lookup odt_style_apply_bag_lookup) {
  odt_style_keys_add_all(odt_style_apply_bag_document, odt_style_apply_bag_bag, odt_style_apply_bag_faces, odt_style_apply_bag_indexes, odt_style_apply_bag_lookup);
  odt_style_key_add_lists(odt_style_apply_bag_document.fmt, odt_style_apply_bag_lookup);
} return void;
