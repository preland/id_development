// Reads the styles of an ODT package into a document made by doc_new: os_lsx is styles.xml and os_lcx is content.xml, as bytes. The named styles replace or join the document's styles, the font faces join its fonts, the list styles join its lists, and the page layout of the first paragraph's master page becomes its page. os_k becomes the lookup the content reader asks. Answers 0, or a code for ost_error.
ost_load(Doc os_d, int[] os_lsx, int[] os_lcx, OdtSty os_k) {
  string[] os_lface = [];
  StyBag os_b = ost_bag_new();
  int os_icode = ost_pass(os_d, os_b, os_lface, os_lsx, (import ost_e_styles));
} chain (Doc os_d, int[] os_lsx, int[] os_lcx, OdtSty os_k) {
  if(os_icode == 0) {
    os_icode = ost_pass(os_d, os_b, os_lface, os_lcx, (import ost_e_content));
  }
  if(os_icode == 0) {
    ost_apply(os_d, os_b, os_lface, os_k);
  }
  string os_smaster = ost_first_master(os_lcx);
} chain (Doc os_d, int[] os_lsx, int[] os_lcx, OdtSty os_k) {
  PgTab os_pt = ost_pg_scan(xr_open(os_lsx));
  int[] os_lpg = ost_pg_pick(os_pt, os_smaster);
  ost_pg_apply(os_d, os_lpg);
} return int os_icode;
