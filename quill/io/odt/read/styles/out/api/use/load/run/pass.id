// The master page a paragraph style names, looked up in pairs of style name and master page name; "" for no style or none paired.
odt_style_master_for_style(string[] odt_style_master_for_style_pairs, string odt_style_master_for_style_style_name) {
  string odt_style_master_for_style_master = "";
  int i = 0;
  while(i < len(odt_style_master_for_style_pairs) && odt_style_master_for_style_style_name != "") {
    if(odt_style_master_for_style_pairs[i] == odt_style_master_for_style_style_name) {
      odt_style_master_for_style_master = odt_style_master_for_style_pairs[i + 1];
    }
    i = i + 2;
  }
} return string odt_style_master_for_style_master;
