// What one event of a content document says about the master page of the first paragraph: a style that names a master page adds a pair; the first paragraph or heading answers 1 to stop.
odt_style_master_event(string[] odt_style_master_event_pairs, XmlR odt_style_master_event_reader, int odt_style_master_event_event) {
  string odt_style_master_event_tag_name = xml_reader_get(odt_style_master_event_reader, (import xml_reader_k_name));
  int odt_style_master_event_stop = (odt_style_master_event_tag_name == "text:p" || odt_style_master_event_tag_name == "text:h") && odt_style_master_event_event != 2;
  if(odt_style_master_event_tag_name == "style:style" && odt_style_master_event_event != 2 && xml_reader_attribute(odt_style_master_event_reader, "style:master-page-name") != "") {
    list_string_extend(odt_style_master_event_pairs, [xml_reader_attribute(odt_style_master_event_reader, "style:name"), xml_reader_attribute(odt_style_master_event_reader, "style:master-page-name")]);
  }
} return int odt_style_master_event_stop;
