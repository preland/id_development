// Reads one document of the package (styles.xml, part 1, or content.xml, part 2) three times, each time up to its body: its font faces, its styles into the bag, its list styles into the document. Answers 0, or the error code of ost_error when the document is not well-formed before its body.
ost_pass(Doc os_d, StyBag os_b, string[] os_lface, int[] os_lxml, int os_ipart) {
  XmlR os_r1 = xr_open(os_lxml);
  ost_faces(os_lface, os_r1);
  XmlR os_r2 = xr_open(os_lxml);
} chain (Doc os_d, StyBag os_b, string[] os_lface, int[] os_lxml, int os_ipart) {
  ost_scan(os_b, os_r2);
  XmlR os_r3 = xr_open(os_lxml);
  ost_lists(os_d.fmt, os_r3);
} chain (Doc os_d, StyBag os_b, string[] os_lface, int[] os_lxml, int os_ipart) {
  int os_icode = ost_xerr(os_r2, os_ipart);
} return int os_icode;
