// Reads one document of the package (styles.xml, part 1, or content.xml, part 2) three times, each time up to its body: its font faces, its styles into the bag, its list styles into the document. Answers 0, or the error code of ost_error when the document is not well-formed before its body.
odt_style_read_pass(Doc odt_style_read_pass_document, odt_named_style_records odt_style_read_pass_bag, string[] odt_style_read_pass_faces, int[] odt_style_read_pass_bytes, int odt_style_read_pass_part) {
  XmlR odt_style_read_pass_first_reader = xml_reader_open(odt_style_read_pass_bytes);
  odt_named_faces_read(odt_style_read_pass_faces, odt_style_read_pass_first_reader);
  XmlR odt_style_read_pass_second_reader = xml_reader_open(odt_style_read_pass_bytes);
} chain (Doc odt_style_read_pass_document, odt_named_style_records odt_style_read_pass_bag, string[] odt_style_read_pass_faces, int[] odt_style_read_pass_bytes, int odt_style_read_pass_part) {
  odt_named_scan(odt_style_read_pass_bag, odt_style_read_pass_second_reader);
  XmlR odt_style_read_pass_third_reader = xml_reader_open(odt_style_read_pass_bytes);
  odt_named_lists_read(odt_style_read_pass_document.fmt, odt_style_read_pass_third_reader);
} chain (Doc odt_style_read_pass_document, odt_named_style_records odt_style_read_pass_bag, string[] odt_style_read_pass_faces, int[] odt_style_read_pass_bytes, int odt_style_read_pass_part) {
  int odt_style_read_pass_code = odt_style_reader_error_code(odt_style_read_pass_second_reader, odt_style_read_pass_part);
} return int odt_style_read_pass_code;
