// The master page a paragraph style names, looked up in pairs of style name and master page name; "" for no style or none paired.
ost_pair(string[] os_lpairs, string os_sname) {
  string os_smaster = "";
  int i = 0;
  while(i < len(os_lpairs) && os_sname != "") {
    if(os_lpairs[i] == os_sname) {
      os_smaster = os_lpairs[i + 1];
    }
    i = i + 2;
  }
} return string os_smaster;
(["P1", "Letter", "P2", "Wide"], "P2"):("Wide")
(["P1", "Letter"], "P3"):("")
(["P1", "Letter"], ""):("")

// What one event of a content document says about the master page of the first paragraph: a style that names a master page adds a pair; the first paragraph or heading answers 1 to stop.
ost_master_one(string[] os_lpairs, XmlR os_r, int os_iev) {
  string os_sname = xr_get(os_r, (import xr_k_name));
  int os_istop = (os_sname == "text:p" || os_sname == "text:h") && os_iev != 2;
  if(os_sname == "style:style" && os_iev != 2 && xr_attr(os_r, "style:master-page-name") != "") {
    list_string_extend(os_lpairs, [xr_attr(os_r, "style:name"), xr_attr(os_r, "style:master-page-name")]);
  }
} return int os_istop;
