// Adds the entry of list definition os_il, when it has a name.
odt_style_key_add_list(Fmt odt_style_key_add_list_format, Odt_style_lookup odt_style_key_add_list_lookup, int odt_style_key_add_list_list) {
  string odt_style_key_add_list_name = odt_style_key_add_list_format.sty.lists[odt_style_key_add_list_list].name;
  if(odt_style_key_add_list_name != "") {
    push(odt_style_key_add_list_lookup.keys, "l:" + odt_style_key_add_list_name);
    push(odt_style_key_add_list_lookup.odt_style_list_identifiers, odt_style_key_add_list_list);
    push(odt_style_key_add_list_lookup.over, 0 - 1);
  }
} return void;
