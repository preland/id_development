// Adds an entry "l:" and the list's name for every list definition that has a name, with its index as the id.
odt_style_key_add_lists(Fmt odt_style_key_add_lists_format, Odt_style_lookup odt_style_key_add_lists_lookup) {
  int i = 1;
  while(i < len(odt_style_key_add_lists_format.sty.lists)) {
    odt_style_key_add_list(odt_style_key_add_lists_format, odt_style_key_add_lists_lookup, i);
    i = i + 1;
  }
} return void;
