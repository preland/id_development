// Adds an entry for every style of the bag, named or automatic, to the lookup lists; the default paragraph style is not a name anything can use.
ost_keys(Doc os_d, StyBag os_b, string[] os_lface, int[] os_lidx, OdtSty os_k) {
  int i = 0;
  while(i < ost_bag_n(os_b)) {
    if(os_b.strings[i * (import ost_s_width) + (import ost_s_kind)] != "d") {
      ost_key_one(os_d, os_b, os_lface, os_lidx, i, os_k);
    }
    i = i + 1;
  }
} return void;
