// Adds the key, id and over entries of record os_i to the lookup lists.
ost_key_one(Doc os_d, StyBag os_b, string[] os_lface, int[] os_lidx, int os_i, OdtSty os_k) {
  string os_skey = ost_key_name(os_b, os_i);
  int os_iid = ost_key_id(os_d, os_b, os_lface, os_lidx, os_i);
  int os_iov = ost_key_over(os_d, os_b, os_lface, os_i);
} chain (Doc os_d, StyBag os_b, string[] os_lface, int[] os_lidx, int os_i, OdtSty os_k) {
  push(os_k.keys, os_skey);
  push(os_k.ids, os_iid);
  push(os_k.over, os_iov);
} return void;
