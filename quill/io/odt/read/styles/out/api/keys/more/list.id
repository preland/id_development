// Adds an entry for every style of the bag, named or automatic, to the lookup lists; the default paragraph style is not a name anything can use.
odt_style_keys_add_all(Doc odt_style_keys_add_all_document, odt_named_style_records odt_style_keys_add_all_bag, string[] odt_style_keys_add_all_faces, int[] odt_style_keys_add_all_indexes, Odt_style_lookup odt_style_keys_add_all_lookup) {
  int i = 0;
  while(i < odt_named_bag_count(odt_style_keys_add_all_bag)) {
    if(odt_style_keys_add_all_bag.strings[i * (import ost_s_width) + (import ost_s_kind)] != "d") {
      odt_style_key_add_record(odt_style_keys_add_all_document, odt_style_keys_add_all_bag, odt_style_keys_add_all_faces, odt_style_keys_add_all_indexes, i, odt_style_keys_add_all_lookup);
    }
    i = i + 1;
  }
} return void;
