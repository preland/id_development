// Adds the key, id and over entries of record os_i to the lookup lists.
odt_style_key_add_record(Doc odt_style_key_add_record_document, odt_named_style_records odt_style_key_add_record_bag, string[] odt_style_key_add_record_faces, int[] odt_style_key_add_record_indexes, int odt_style_key_add_record_record, Odt_style_lookup odt_style_key_add_record_lookup) {
  string odt_style_key_add_record_key = odt_style_key_name(odt_style_key_add_record_bag, odt_style_key_add_record_record);
  int odt_style_key_add_record_identifier = odt_style_key_identifier(odt_style_key_add_record_document, odt_style_key_add_record_bag, odt_style_key_add_record_faces, odt_style_key_add_record_indexes, odt_style_key_add_record_record);
  int odt_style_key_add_record_overlay = odt_style_key_over(odt_style_key_add_record_document, odt_style_key_add_record_bag, odt_style_key_add_record_faces, odt_style_key_add_record_record);
} chain (Doc odt_style_key_add_record_document, odt_named_style_records odt_style_key_add_record_bag, string[] odt_style_key_add_record_faces, int[] odt_style_key_add_record_indexes, int odt_style_key_add_record_record, Odt_style_lookup odt_style_key_add_record_lookup) {
  push(odt_style_key_add_record_lookup.keys, odt_style_key_add_record_key);
  push(odt_style_key_add_record_lookup.odt_style_list_identifiers, odt_style_key_add_record_identifier);
  push(odt_style_key_add_record_lookup.over, odt_style_key_add_record_overlay);
} return void;
