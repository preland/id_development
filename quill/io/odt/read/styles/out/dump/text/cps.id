// The code point a dump shows for os_icp: every private-use code point (U+E000 to U+F8FF, and quill_object_marker up to U+FFFFD, the plane the readers keep inline objects in) shows as U+E000, and a cell that is not a valid code point shows as U+FFFD.
odt_style_dump_code_point(int odt_style_dump_code_point_code_point) {
  int odt_style_dump_code_point_shown = odt_style_dump_code_point_code_point;
  if((odt_style_dump_code_point_code_point >= 57344 && odt_style_dump_code_point_code_point <= 63743) || (odt_style_dump_code_point_code_point >= (import quill_object_marker) && odt_style_dump_code_point_code_point <= 1048573)) {
    odt_style_dump_code_point_shown = 57344;
  }
  if(odt_style_dump_code_point_code_point <= 0 || odt_style_dump_code_point_code_point > 1114111) {
    odt_style_dump_code_point_shown = 65533;
  }
} return int odt_style_dump_code_point_shown;
