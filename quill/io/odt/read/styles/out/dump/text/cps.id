// A value as a dump prints it: its number, or "-" for -1, which every unset field is.
odt_style_dump_number(int odt_style_dump_number_number) {
  string odt_style_dump_number_text = "" + odt_style_dump_number_number;
  if(odt_style_dump_number_number == 0 - 1) {
    odt_style_dump_number_text = "-";
  }
} return string odt_style_dump_number_text;
(24):("24")
(-1):("-")
(0):("0")
