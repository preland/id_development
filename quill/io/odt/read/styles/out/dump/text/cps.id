// The code points os_lcps[os_ilo..os_ihi) as a UTF-8 string, as ndump_cp shows them.
odt_style_dump_code_points_string(int[] odt_style_dump_code_points_string_code_points, int odt_style_dump_code_points_string_low, int odt_style_dump_code_points_string_high) {
  string odt_style_dump_code_points_string_text = "";
  int i = odt_style_dump_code_points_string_low;
  while(i < odt_style_dump_code_points_string_high) {
    odt_style_dump_code_points_string_text = odt_style_dump_code_points_string_text + utf8_string(odt_style_dump_code_point(odt_style_dump_code_points_string_code_points[i]));
    i = i + 1;
  }
} return string odt_style_dump_code_points_string_text;
