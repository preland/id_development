// A colour as a dump prints it: "#rrggbb" in lowercase, or "-" for -1.
odt_style_dump_color(int odt_style_dump_color_color) {
  string odt_style_dump_color_text = "-";
  if(odt_style_dump_color_color >= 0) {
    odt_style_dump_color_text = "#" + str_sub(format_hex(odt_style_dump_color_color), 2, 6);
  }
} return string odt_style_dump_color_text;
(16711680):("#ff0000")
(-1):("-")
(255):("#0000ff")
