// The page record of a dump: "page w= h= orient= top= right= bottom= left=", all in twips except the orientation (0 portrait, 1 landscape).
odt_style_dump_page(Page odt_style_dump_page_page) {
  string odt_style_dump_page_size_field = "w=" + odt_style_dump_page_page.size[0] + " h=" + odt_style_dump_page_page.size[1] + " orient=" + odt_style_dump_page_page.size[2];
  string odt_style_dump_page_margin_field = "top=" + odt_style_dump_page_page.margin[0] + " right=" + odt_style_dump_page_page.margin[1] + " bottom=" + odt_style_dump_page_page.margin[2] + " left=" + odt_style_dump_page_page.margin[3];
  string odt_style_dump_page_text = "page " + odt_style_dump_page_size_field + " " + odt_style_dump_page_margin_field;
} return string odt_style_dump_page_text;
(Page([11906, 16838, 0], [1134, 1134, 1134, 1134], [0, 0, 0])):("page w=11906 h=16838 orient=0 top=1134 right=1134 bottom=1134 left=1134")
(Page([15840, 12240, 1], [1440, 720, 1440, 720], [0, 0, 0])):("page w=15840 h=12240 orient=1 top=1440 right=720 bottom=1440 left=720")

// What a list level says in a dump: "b:CODEPOINT:LEFT:HANG" for a bullet, "n:FORMAT:START:LEFT:HANG" for a number, the indents in twips; a level past the third reads as the third.
odt_style_dump_list_level(int[] odt_style_dump_list_level_levels, int odt_style_dump_list_level_level) {
  int odt_style_dump_list_level_base = fixed_point_minimum(fixed_point_maximum(odt_style_dump_list_level_level, 0), 2) * (import quill_list_level_stride);
  string odt_style_dump_list_level_indent_field = odt_style_dump_list_level_levels[odt_style_dump_list_level_base + (import quill_list_level_indent)] + ":" + odt_style_dump_list_level_levels[odt_style_dump_list_level_base + (import quill_list_level_hanging)];
  string odt_style_dump_list_level_text = "b:" + odt_style_dump_list_level_levels[odt_style_dump_list_level_base + (import quill_list_level_format)] + ":" + odt_style_dump_list_level_indent_field;
} chain (int[] odt_style_dump_list_level_levels, int odt_style_dump_list_level_level) {
  if(odt_style_dump_list_level_levels[odt_style_dump_list_level_base + (import quill_list_level_kind)] == 1) {
    odt_style_dump_list_level_text = "n:" + odt_style_dump_list_level_levels[odt_style_dump_list_level_base + (import quill_list_level_format)] + ":" + odt_style_dump_list_level_levels[odt_style_dump_list_level_base + (import quill_list_level_start)] + ":" + odt_style_dump_list_level_indent_field;
  }
} return string odt_style_dump_list_level_text;
([0, 8226, 0, 720, 360, 0, 9702, 0, 1440, 360, 0, 9642, 0, 2160, 360], 1):("b:9702:1440:360")
([1, 0, 3, 720, 360, 1, 1, 1, 1440, 360, 1, 3, 1, 2160, 360], 5):("n:3:1:2160:360")

// What a paragraph's list says in a dump: "-" for no list (id 0), else ndump_lvl of the list's level.
odt_style_dump_list(Fmt odt_style_dump_list_format, int odt_style_dump_list_list, int odt_style_dump_list_depth) {
  string odt_style_dump_list_text = "-";
  if(odt_style_dump_list_list > 0) {
    odt_style_dump_list_text = odt_style_dump_list_level(odt_style_dump_list_format.sty.lists[odt_style_dump_list_list].levels, odt_style_dump_list_depth);
  }
} return string odt_style_dump_list_text;
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [ListDef("", [], 0), ListDef("L", [0, 8226, 0, 720, 360, 0, 9702, 0, 1440, 360, 0, 9642, 0, 2160, 360], 0)], 0)), 1, 1):("b:9702:1440:360")
(Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [ListDef("", [], 0)], 0)), 0, 0):("-")
