// A paragraph's records: its head, then its runs, unless it is an opaque block (which has no runs in a dump).
ndump_para(Doc os_d, int os_i) {
  Para os_p = os_d.body.paras[os_i];
  string os_sout = ndump_phead(os_d, os_p, os_i);
  if(tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_kind)) == 0) {
    os_sout = os_sout + ndump_runs(os_d, os_p);
  }
} return string os_sout;
