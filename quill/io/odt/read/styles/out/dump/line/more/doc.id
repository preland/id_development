// A paragraph's records: its head, then its runs, unless it is an opaque block (which has no runs in a dump).
odt_style_dump_paragraph(Doc odt_style_dump_paragraph_document, int odt_style_dump_paragraph_position) {
  Para odt_style_dump_paragraph_paragraph = odt_style_dump_paragraph_document.body.paras[odt_style_dump_paragraph_position];
  string odt_style_dump_paragraph_text = odt_style_dump_paragraph_head(odt_style_dump_paragraph_document, odt_style_dump_paragraph_paragraph, odt_style_dump_paragraph_position);
  if(tab_get(odt_style_dump_paragraph_document.fmt.paras, odt_style_dump_paragraph_paragraph.pprop, (import quill_paragraph_kind)) == 0) {
    odt_style_dump_paragraph_text = odt_style_dump_paragraph_text + odt_style_dump_runs(odt_style_dump_paragraph_document, odt_style_dump_paragraph_paragraph);
  }
} return string odt_style_dump_paragraph_text;
