// The normalised dump of a document, as docs/QUILL.md 4.9 defines it: the page record, then every paragraph's records, each line ending in a line feed. Two documents with the same text and the same effective formatting dump identically however their rows and styles are numbered.
odt_style_dump_document(Doc odt_style_dump_document_document) {
  string odt_style_dump_document_text = odt_style_dump_page(odt_style_dump_document_document.body.page);
  int i = 0;
  while(i < len(odt_style_dump_document_document.body.paras)) {
    odt_style_dump_document_text = odt_style_dump_document_text + "\n" + odt_style_dump_paragraph(odt_style_dump_document_document, i);
    i = i + 1;
  }
} chain (Doc odt_style_dump_document_document) {
  odt_style_dump_document_text = odt_style_dump_document_text + "\n";
} return string odt_style_dump_document_text;
