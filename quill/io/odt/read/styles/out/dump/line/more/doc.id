// The run records of a paragraph: its runs merged where their printed properties are equal, each on a line after a line feed; "" for an empty paragraph.
ndump_runs(Doc os_d, Para os_p) {
  int os_ipstyle = fixed_point_maximum(tab_get(os_d.fmt.paras, os_p.pprop, (import word_p_style)), 0);
  string[] os_lsig = [];
  int[] os_lends = [];
} chain (Doc os_d, Para os_p) {
  int i = 0;
  while(i < len(os_p.txt.runs)) {
    ndump_take(os_d, os_ipstyle, os_p.txt.runs[i], os_lsig, os_lends);
    i = i + 1;
  }
  string os_sout = ndump_lines(os_p.txt.cps, os_lsig, os_lends);
} return string os_sout;
