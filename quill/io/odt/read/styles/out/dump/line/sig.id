// The effective font family of a run as a dump prints it: its name in quotes, "-" when no style gives one.
odt_style_dump_font(Doc odt_style_dump_font_document, int odt_style_dump_font_paragraph_style, int odt_style_dump_font_character_property) {
  string odt_style_dump_font_text = "-";
  int odt_style_dump_font_font = document_style_effective_character(odt_style_dump_font_document.fmt, odt_style_dump_font_paragraph_style, odt_style_dump_font_character_property, (import quill_character_font));
  if(odt_style_dump_font_font >= 0 && odt_style_dump_font_font < len(odt_style_dump_font_document.ext.fonts)) {
    odt_style_dump_font_text = string_quote(odt_style_dump_font_document.ext.fonts[odt_style_dump_font_font]);
  }
} return string odt_style_dump_font_text;
