// The six flags of a run as a dump prints them: "b=0 i=0 u=0 s=0 sup=0 sub=0", bold, italic, underline, strike, superscript, subscript.
ndump_bits(int os_ibits) {
  string os_sa = "b=" + (os_ibits & 1) + " i=" + ((os_ibits >> 1) & 1) + " u=" + ((os_ibits >> 2) & 1);
  string os_sb = "s=" + ((os_ibits >> 3) & 1) + " sup=" + ((os_ibits >> 4) & 1) + " sub=" + ((os_ibits >> 5) & 1);
  string os_sout = os_sa + " " + os_sb;
} return string os_sout;
