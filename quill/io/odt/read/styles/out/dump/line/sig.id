// The effective font family of a run as a dump prints it: its name in quotes, "-" when no style gives one.
ndump_font(Doc os_d, int os_ipstyle, int os_icprop) {
  string os_sout = "-";
  int os_ifont = style_eff_c(os_d.fmt, os_ipstyle, os_icprop, (import quill_character_font));
  if(os_ifont >= 0 && os_ifont < len(os_d.ext.fonts)) {
    os_sout = str_quote(os_d.ext.fonts[os_ifont]);
  }
} return string os_sout;
