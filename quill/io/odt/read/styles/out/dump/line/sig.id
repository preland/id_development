// The six flags of a run as a dump prints them: "b=0 i=0 u=0 s=0 sup=0 sub=0", bold, italic, underline, strike, superscript, subscript.
odt_style_dump_flag_bits(int odt_style_dump_flag_bits_flags) {
  string odt_style_dump_flag_bits_first_flags = "b=" + (odt_style_dump_flag_bits_flags & 1) + " i=" + ((odt_style_dump_flag_bits_flags >> 1) & 1) + " u=" + ((odt_style_dump_flag_bits_flags >> 2) & 1);
  string odt_style_dump_flag_bits_second_flags = "s=" + ((odt_style_dump_flag_bits_flags >> 3) & 1) + " sup=" + ((odt_style_dump_flag_bits_flags >> 4) & 1) + " sub=" + ((odt_style_dump_flag_bits_flags >> 5) & 1);
  string odt_style_dump_flag_bits_text = odt_style_dump_flag_bits_first_flags + " " + odt_style_dump_flag_bits_second_flags;
} return string odt_style_dump_flag_bits_text;
