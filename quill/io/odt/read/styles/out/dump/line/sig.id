// The hyperlink of a run as a dump prints it: its target in quotes, "-" for none.
odt_style_dump_link(Doc odt_style_dump_link_document, Run odt_style_dump_link_run) {
  string odt_style_dump_link_text = "-";
  if(odt_style_dump_link_run.link >= 0 && odt_style_dump_link_run.link < len(odt_style_dump_link_document.ext.links)) {
    odt_style_dump_link_text = string_quote(odt_style_dump_link_document.ext.links[odt_style_dump_link_run.link]);
  }
} return string odt_style_dump_link_text;
