// The hyperlink of a run as a dump prints it: its target in quotes, "-" for none.
ndump_link(Doc os_d, Run os_ru) {
  string os_sout = "-";
  if(os_ru.link >= 0 && os_ru.link < len(os_d.ext.links)) {
    os_sout = str_quote(os_d.ext.links[os_ru.link]);
  }
} return string os_sout;
