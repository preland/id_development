// Adds one run to a paragraph's merged runs: the signature list (each merged run's printed properties) and the list of where each merged run ends in the paragraph's text. A run that prints the same as the last merged run extends it, any other starts a new one; an empty run adds nothing.
odt_style_dump_run_take(Doc odt_style_dump_run_take_document, int odt_style_dump_run_take_paragraph_style, Run odt_style_dump_run_take_run, string[] odt_style_dump_run_take_signatures, int[] odt_style_dump_run_take_ends) {
  string odt_style_dump_run_take_signature = odt_style_dump_run_signature(odt_style_dump_run_take_document, odt_style_dump_run_take_paragraph_style, odt_style_dump_run_take_run);
  int odt_style_dump_run_take_last = len(odt_style_dump_run_take_signatures) - 1;
  int odt_style_dump_run_take_previous_end = 0;
} chain (Doc odt_style_dump_run_take_document, int odt_style_dump_run_take_paragraph_style, Run odt_style_dump_run_take_run, string[] odt_style_dump_run_take_signatures, int[] odt_style_dump_run_take_ends) {
  if(odt_style_dump_run_take_last >= 0) {
    odt_style_dump_run_take_previous_end = odt_style_dump_run_take_ends[odt_style_dump_run_take_last];
  }
  if(odt_style_dump_run_take_run.len > 0 && odt_style_dump_run_take_last >= 0 && odt_style_dump_run_take_signatures[odt_style_dump_run_take_last] == odt_style_dump_run_take_signature) {
    odt_style_dump_run_take_ends[odt_style_dump_run_take_last] = odt_style_dump_run_take_previous_end + odt_style_dump_run_take_run.len;
  }
  if(odt_style_dump_run_take_run.len > 0 && (odt_style_dump_run_take_last < 0 || odt_style_dump_run_take_signatures[odt_style_dump_run_take_last] != odt_style_dump_run_take_signature)) {
    push(odt_style_dump_run_take_signatures, odt_style_dump_run_take_signature);
    push(odt_style_dump_run_take_ends, odt_style_dump_run_take_previous_end + odt_style_dump_run_take_run.len);
  }
} return void;
