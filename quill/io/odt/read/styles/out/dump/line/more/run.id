// What a dump prints of a run's properties, resolved through its character style and its paragraph's style: the flags, size, colour, highlight, link and font, as the fields of a run record without its text. os_ipstyle is the index of the paragraph's style.
odt_style_dump_run_signature(Doc odt_style_dump_run_signature_document, int odt_style_dump_run_signature_paragraph_style, Run odt_style_dump_run_signature_run) {
  int odt_style_dump_run_signature_character_property = odt_style_dump_run_signature_run.cprop;
  string odt_style_dump_run_signature_flags = odt_style_dump_flag_bits(document_style_effective_character(odt_style_dump_run_signature_document.fmt, odt_style_dump_run_signature_paragraph_style, odt_style_dump_run_signature_character_property, (import quill_character_on)));
  string odt_style_dump_run_signature_size = "size=" + odt_style_dump_number(document_style_effective_character(odt_style_dump_run_signature_document.fmt, odt_style_dump_run_signature_paragraph_style, odt_style_dump_run_signature_character_property, (import quill_character_size)));
} chain (Doc odt_style_dump_run_signature_document, int odt_style_dump_run_signature_paragraph_style, Run odt_style_dump_run_signature_run) {
  string odt_style_dump_run_signature_color = "color=" + odt_style_dump_color(document_style_effective_character(odt_style_dump_run_signature_document.fmt, odt_style_dump_run_signature_paragraph_style, odt_style_dump_run_signature_character_property, (import quill_character_color)));
  string odt_style_dump_run_signature_highlight = "hl=" + odt_style_dump_color(document_style_effective_character(odt_style_dump_run_signature_document.fmt, odt_style_dump_run_signature_paragraph_style, odt_style_dump_run_signature_character_property, (import quill_character_highlight)));
  string odt_style_dump_run_signature_link = "link=" + odt_style_dump_link(odt_style_dump_run_signature_document, odt_style_dump_run_signature_run);
} chain (Doc odt_style_dump_run_signature_document, int odt_style_dump_run_signature_paragraph_style, Run odt_style_dump_run_signature_run) {
  string odt_style_dump_run_signature_font = "font=" + odt_style_dump_font(odt_style_dump_run_signature_document, odt_style_dump_run_signature_paragraph_style, odt_style_dump_run_signature_character_property);
  string odt_style_dump_run_signature_text = odt_style_dump_run_signature_flags + " " + odt_style_dump_run_signature_size + " " + odt_style_dump_run_signature_color + " " + odt_style_dump_run_signature_highlight + " " + odt_style_dump_run_signature_link + " " + odt_style_dump_run_signature_font;
} return string odt_style_dump_run_signature_text;
