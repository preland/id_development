// Adds one run to a paragraph's merged runs: the signature list (each merged run's printed properties) and the list of where each merged run ends in the paragraph's text. A run that prints the same as the last merged run extends it, any other starts a new one; an empty run adds nothing.
ndump_take(Doc os_d, int os_ipstyle, Run os_ru, string[] os_lsig, int[] os_lends) {
  string os_ssig = ndump_sig(os_d, os_ipstyle, os_ru);
  int os_ilast = len(os_lsig) - 1;
  int os_iprev = 0;
} chain (Doc os_d, int os_ipstyle, Run os_ru, string[] os_lsig, int[] os_lends) {
  if(os_ilast >= 0) {
    os_iprev = os_lends[os_ilast];
  }
  if(os_ru.len > 0 && os_ilast >= 0 && os_lsig[os_ilast] == os_ssig) {
    os_lends[os_ilast] = os_iprev + os_ru.len;
  }
  if(os_ru.len > 0 && (os_ilast < 0 || os_lsig[os_ilast] != os_ssig)) {
    push(os_lsig, os_ssig);
    push(os_lends, os_iprev + os_ru.len);
  }
} return void;
