// What a dump prints of a run's properties, resolved through its character style and its paragraph's style: the flags, size, colour, highlight, link and font, as the fields of a run record without its text. os_ipstyle is the index of the paragraph's style.
ndump_sig(Doc os_d, int os_ipstyle, Run os_ru) {
  int os_ic = os_ru.cprop;
  string os_sbits = ndump_bits(style_eff_c(os_d.fmt, os_ipstyle, os_ic, (import quill_character_on)));
  string os_ssize = "size=" + ndump_num(style_eff_c(os_d.fmt, os_ipstyle, os_ic, (import quill_character_size)));
} chain (Doc os_d, int os_ipstyle, Run os_ru) {
  string os_scol = "color=" + ndump_color(style_eff_c(os_d.fmt, os_ipstyle, os_ic, (import quill_character_color)));
  string os_shl = "hl=" + ndump_color(style_eff_c(os_d.fmt, os_ipstyle, os_ic, (import quill_character_highlight)));
  string os_slink = "link=" + ndump_link(os_d, os_ru);
} chain (Doc os_d, int os_ipstyle, Run os_ru) {
  string os_sfont = "font=" + ndump_font(os_d, os_ipstyle, os_ic);
  string os_sout = os_sbits + " " + os_ssize + " " + os_scol + " " + os_shl + " " + os_slink + " " + os_sfont;
} return string os_sout;
