// The run records of a paragraph, each on a line of its own after a line feed: "run" and the merged run's printed properties, then its text in quotes; os_lends says where each merged run ends in os_lcps.
ndump_lines(int[] os_lcps, string[] os_lsig, int[] os_lends) {
  string os_sout = "";
  int os_istart = 0;
  int i = 0;
} chain (int[] os_lcps, string[] os_lsig, int[] os_lends) {
  while(i < len(os_lsig)) {
    os_sout = os_sout + "\nrun " + os_lsig[i] + " text=" + string_quote(ndump_str(os_lcps, os_istart, os_lends[i]));
    os_istart = os_lends[i];
    i = i + 1;
  }
} return string os_sout;
