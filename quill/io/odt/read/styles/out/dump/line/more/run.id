// The run records of a paragraph, each on a line of its own after a line feed: "run" and the merged run's printed properties, then its text in quotes; os_lends says where each merged run ends in os_lcps.
odt_style_dump_run_lines(int[] odt_style_dump_run_lines_code_points, string[] odt_style_dump_run_lines_signatures, int[] odt_style_dump_run_lines_ends) {
  string odt_style_dump_run_lines_text = "";
  int odt_style_dump_run_lines_start = 0;
  int i = 0;
} chain (int[] odt_style_dump_run_lines_code_points, string[] odt_style_dump_run_lines_signatures, int[] odt_style_dump_run_lines_ends) {
  while(i < len(odt_style_dump_run_lines_signatures)) {
    odt_style_dump_run_lines_text = odt_style_dump_run_lines_text + "\nrun " + odt_style_dump_run_lines_signatures[i] + " text=" + string_quote(odt_style_dump_code_points_string(odt_style_dump_run_lines_code_points, odt_style_dump_run_lines_start, odt_style_dump_run_lines_ends[i]));
    odt_style_dump_run_lines_start = odt_style_dump_run_lines_ends[i];
    i = i + 1;
  }
} return string odt_style_dump_run_lines_text;
