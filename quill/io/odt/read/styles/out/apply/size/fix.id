// Replaces every relative font size of the bag (a percentage, held as ost_pct_base minus it) by the half-points it comes to once its parent's size is known.
ost_sizes(StyBag os_b) {
  int i = 0;
  while(i < ost_bag_n(os_b)) {
    ost_size_at(os_b, i);
    i = i + 1;
  }
} return void;
