// The character row of record os_i, ready to intern: its font resolved to an index in the document's fonts, and the character style it sits on as os_istyle.
ost_rowc(Doc os_d, StyBag os_b, string[] os_lface, int os_i, int os_istyle) {
  int[] os_lrow = list_copy(os_b.crows[os_i]);
  string os_sfont = os_b.strings[os_i * (import ost_s_width) + (import ost_s_font)];
  os_lrow[(import word_c_font)] = ost_font_at(os_d, os_lface, os_sfont);
} chain (Doc os_d, StyBag os_b, string[] os_lface, int os_i, int os_istyle) {
  os_lrow[(import word_c_style)] = os_istyle;
} return int[] os_lrow;
