// The paragraph row of record os_i, ready to intern: the paragraph style it sits on as os_istyle, and its page break and list as the record or its parent chain gives them.
ost_rowp(Fmt os_f, StyBag os_b, int os_i, int os_istyle) {
  int[] os_lrow = list_copy(os_b.prows[os_i]);
  os_lrow[(import word_p_style)] = os_istyle;
  os_lrow[(import word_p_brk)] = ost_fbrk(os_b, os_i, 0);
} chain (Fmt os_f, StyBag os_b, int os_i, int os_istyle) {
  os_lrow[(import word_p_list)] = ost_flist(os_f, os_b, os_i, 0);
} return int[] os_lrow;
