// The index of the model style called os_sname in family os_ifam, appended with no properties and no parent when the document does not have it yet.
odt_style_model_ensure(Fmt odt_style_model_ensure_format, string odt_style_model_ensure_name, int odt_style_model_ensure_family) {
  int odt_style_model_ensure_style = odt_style_model_find(odt_style_model_ensure_format, odt_style_model_ensure_name, odt_style_model_ensure_family);
  int[] odt_style_model_ensure_relation = [odt_style_model_ensure_family, 0 - 1, 0 - 1];
  int[] odt_style_model_ensure_style_format = [0, 0];
} chain (Fmt odt_style_model_ensure_format, string odt_style_model_ensure_name, int odt_style_model_ensure_family) {
  Style odt_style_model_ensure_new_style = Style(odt_style_model_ensure_name, odt_style_model_ensure_relation, odt_style_model_ensure_style_format);
  if(odt_style_model_ensure_style < 0) {
    push(odt_style_model_ensure_format.sty.styles, odt_style_model_ensure_new_style);
    odt_style_model_ensure_style = len(odt_style_model_ensure_format.sty.styles) - 1;
  }
} return int odt_style_model_ensure_style;
