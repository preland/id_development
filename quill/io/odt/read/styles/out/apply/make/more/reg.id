// The model style a record stands for: for a named style its index (found, or appended), -1 for any other kind of record.
odt_style_register_record(Fmt odt_style_register_record_format, odt_named_style_records odt_style_register_record_bag, int odt_style_register_record_record) {
  string odt_style_register_record_kind = odt_style_register_record_bag.strings[odt_style_register_record_record * (import ost_s_width) + (import ost_s_kind)];
  int odt_style_register_record_family = odt_style_register_record_bag.strings[odt_style_register_record_record * (import ost_s_width) + (import ost_s_fam)] == "t";
  int odt_style_register_record_style = 0 - 1;
} chain (Fmt odt_style_register_record_format, odt_named_style_records odt_style_register_record_bag, int odt_style_register_record_record) {
  string odt_style_register_record_wire_name = odt_style_register_record_bag.strings[odt_style_register_record_record * (import ost_s_width) + (import ost_s_name)];
  string odt_style_register_record_display_name = odt_style_register_record_bag.strings[odt_style_register_record_record * (import ost_s_width) + (import ost_s_disp)];
  if(odt_style_register_record_kind == "n") {
    odt_style_register_record_style = odt_style_model_ensure(odt_style_register_record_format, odt_style_model_name(odt_style_register_record_wire_name, odt_style_register_record_display_name), odt_style_register_record_family);
  }
} return int odt_style_register_record_style;
