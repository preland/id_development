// The model style index of every record of the bag, in order: styles the document names are found among the model's or appended; every other record gets -1.
odt_style_register_all(Fmt odt_style_register_all_format, odt_named_style_records odt_style_register_all_bag) {
  int[] odt_style_register_all_indexes = [];
  int i = 0;
  while(i < odt_named_bag_count(odt_style_register_all_bag)) {
    push(odt_style_register_all_indexes, odt_style_register_record(odt_style_register_all_format, odt_style_register_all_bag, i));
    i = i + 1;
  }
} return int[] odt_style_register_all_indexes;
