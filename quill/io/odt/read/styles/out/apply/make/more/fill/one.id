// Fills the model style of named record os_i: its character row and paragraph row interned and stored as the style's, then its parent and next style. A text style has no paragraph row, so it keeps row 0 there.
odt_style_fill_record(Doc odt_style_fill_record_document, odt_named_style_records odt_style_fill_record_bag, string[] odt_style_fill_record_faces, int[] odt_style_fill_record_indexes, int odt_style_fill_record_record) {
  int[] odt_style_fill_record_style_format = odt_style_fill_record_document.fmt.sty.styles[odt_style_fill_record_indexes[odt_style_fill_record_record]].fmt;
  int[] odt_style_fill_record_character_row = odt_style_character_row(odt_style_fill_record_document, odt_style_fill_record_bag, odt_style_fill_record_faces, odt_style_fill_record_record, 0);
  int[] odt_style_fill_record_paragraph_row = odt_style_paragraph_row(odt_style_fill_record_document.fmt, odt_style_fill_record_bag, odt_style_fill_record_record, 0 - 1);
} chain (Doc odt_style_fill_record_document, odt_named_style_records odt_style_fill_record_bag, string[] odt_style_fill_record_faces, int[] odt_style_fill_record_indexes, int odt_style_fill_record_record) {
  odt_style_fill_record_style_format[(import quill_style_character_property)] = tab_intern(odt_style_fill_record_document.fmt.chars, odt_style_fill_record_character_row);
  if(odt_style_fill_record_bag.strings[odt_style_fill_record_record * (import ost_s_width) + (import ost_s_fam)] == "p") {
    odt_style_fill_record_style_format[(import quill_style_paragraph_property)] = tab_intern(odt_style_fill_record_document.fmt.paras, odt_style_fill_record_paragraph_row);
  }
  odt_style_relation_set(odt_style_fill_record_document.fmt, odt_style_fill_record_bag, odt_style_fill_record_indexes, odt_style_fill_record_record);
} return void;
