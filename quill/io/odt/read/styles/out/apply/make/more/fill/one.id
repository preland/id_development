// Fills every named style of the bag except Normal (index 0), then Normal from the default style and "Standard".
odt_style_fill_all(Doc odt_style_fill_all_document, odt_named_style_records odt_style_fill_all_bag, string[] odt_style_fill_all_faces, int[] odt_style_fill_all_indexes) {
  int i = 0;
  while(i < odt_named_bag_count(odt_style_fill_all_bag)) {
    if(odt_style_fill_all_indexes[i] > 0) {
      odt_style_fill_record(odt_style_fill_all_document, odt_style_fill_all_bag, odt_style_fill_all_faces, odt_style_fill_all_indexes, i);
    }
    i = i + 1;
  }
  odt_style_normal_rebuild(odt_style_fill_all_document, odt_style_fill_all_bag, odt_style_fill_all_faces);
} return void;
