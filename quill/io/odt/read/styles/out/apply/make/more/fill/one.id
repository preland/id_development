// Fills every named style of the bag except Normal (index 0), then Normal from the default style and "Standard".
ost_fill(Doc os_d, StyBag os_b, string[] os_lface, int[] os_lidx) {
  int i = 0;
  while(i < ost_bag_n(os_b)) {
    if(os_lidx[i] > 0) {
      ost_fill_one(os_d, os_b, os_lface, os_lidx, i);
    }
    i = i + 1;
  }
  ost_fill_normal(os_d, os_b, os_lface);
} return void;
