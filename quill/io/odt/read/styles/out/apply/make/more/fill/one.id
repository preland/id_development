// Fills the model style of named record os_i: its character row and paragraph row interned and stored as the style's, then its parent and next style. A text style has no paragraph row, so it keeps row 0 there.
ost_fill_one(Doc os_d, StyBag os_b, string[] os_lface, int[] os_lidx, int os_i) {
  int[] os_lfm = os_d.fmt.sty.styles[os_lidx[os_i]].fmt;
  int[] os_lc = ost_rowc(os_d, os_b, os_lface, os_i, 0);
  int[] os_lp = ost_rowp(os_d.fmt, os_b, os_i, 0 - 1);
} chain (Doc os_d, StyBag os_b, string[] os_lface, int[] os_lidx, int os_i) {
  os_lfm[(import word_s_cprop)] = tab_intern(os_d.fmt.chars, os_lc);
  if(os_b.strings[os_i * (import ost_s_width) + (import ost_s_fam)] == "p") {
    os_lfm[(import word_s_pprop)] = tab_intern(os_d.fmt.paras, os_lp);
  }
  ost_rel_set(os_d.fmt, os_b, os_lidx, os_i);
} return void;
