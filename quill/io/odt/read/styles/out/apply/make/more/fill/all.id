// Stores the character row and paragraph row being built for Normal, interned, as Normal's own.
odt_style_normal_store(Doc odt_style_normal_store_document, int[][] odt_style_normal_store_rows) {
  int[] odt_style_normal_store_style_format = odt_style_normal_store_document.fmt.sty.styles[0].fmt;
  odt_style_normal_store_style_format[(import quill_style_character_property)] = tab_intern(odt_style_normal_store_document.fmt.chars, odt_style_normal_store_rows[0]);
  odt_style_normal_store_style_format[(import quill_style_paragraph_property)] = tab_intern(odt_style_normal_store_document.fmt.paras, odt_style_normal_store_rows[1]);
} return void;
