// Rebuilds Normal from the document's default paragraph style and its "Standard" style, the first with the second laid over it; the built-in Normal is left alone when the document defines neither.
odt_style_normal_rebuild(Doc odt_style_normal_rebuild_document, odt_named_style_records odt_style_normal_rebuild_bag, string[] odt_style_normal_rebuild_faces) {
  int odt_style_normal_rebuild_default_record = odt_style_record_find(odt_style_normal_rebuild_bag, "", "p", "d");
  int odt_style_normal_rebuild_standard_record = odt_style_record_find(odt_style_normal_rebuild_bag, (import quill_style_wire)[0], "p", "n");
  int[][] odt_style_normal_rebuild_rows = [list_copy((import ost_cdef)), list_copy((import ost_pdef))];
} chain (Doc odt_style_normal_rebuild_document, odt_named_style_records odt_style_normal_rebuild_bag, string[] odt_style_normal_rebuild_faces) {
  if(odt_style_normal_rebuild_default_record >= 0) {
    odt_style_normal_overlay(odt_style_normal_rebuild_document, odt_style_normal_rebuild_bag, odt_style_normal_rebuild_faces, odt_style_normal_rebuild_default_record, odt_style_normal_rebuild_rows);
  }
  if(odt_style_normal_rebuild_standard_record >= 0) {
    odt_style_normal_overlay(odt_style_normal_rebuild_document, odt_style_normal_rebuild_bag, odt_style_normal_rebuild_faces, odt_style_normal_rebuild_standard_record, odt_style_normal_rebuild_rows);
  }
  if(odt_style_normal_rebuild_default_record >= 0 || odt_style_normal_rebuild_standard_record >= 0) {
    odt_style_normal_store(odt_style_normal_rebuild_document, odt_style_normal_rebuild_rows);
  }
} return void;
