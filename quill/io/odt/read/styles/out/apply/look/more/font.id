// Where the pair declaring face os_sname starts in the face list (pairs of declared name and family), -1 when it is not declared; a later declaration of the same name wins.
odt_style_face_position(string[] odt_style_face_position_faces, string odt_style_face_position_name) {
  int odt_style_face_position_position = 0 - 1;
  int i = len(odt_style_face_position_faces) - 2;
  while(i >= 0 && odt_style_face_position_position < 0) {
    if(odt_style_face_position_faces[i] == odt_style_face_position_name) {
      odt_style_face_position_position = i;
    }
    i = i - 2;
  }
} return int odt_style_face_position_position;
(["A", "a", "B", "b", "A", "c"], "A"):(4)
(["A", "a"], "Z"):(-1)

// The index of font family os_sfam in the document's fonts, added at the end when it is not there yet.
odt_style_font_index_ensure(Doc odt_style_font_index_ensure_document, string odt_style_font_index_ensure_family) {
  int odt_style_font_index_ensure_font = list_string_index(odt_style_font_index_ensure_document.ext.fonts, odt_style_font_index_ensure_family);
  if(odt_style_font_index_ensure_font < 0) {
    push(odt_style_font_index_ensure_document.ext.fonts, odt_style_font_index_ensure_family);
    odt_style_font_index_ensure_font = len(odt_style_font_index_ensure_document.ext.fonts) - 1;
  }
} return int odt_style_font_index_ensure_font;
