// The index in the document's fonts of the family a declared face name stands for (the name itself when it is not declared), -1 for the empty name, which names no font.
odt_style_font_index_resolve(Doc odt_style_font_index_resolve_document, string[] odt_style_font_index_resolve_faces, string odt_style_font_index_resolve_name) {
  int odt_style_font_index_resolve_font = 0 - 1;
  int odt_style_font_index_resolve_position = odt_style_face_position(odt_style_font_index_resolve_faces, odt_style_font_index_resolve_name);
  string odt_style_font_index_resolve_family = odt_style_font_index_resolve_name;
} chain (Doc odt_style_font_index_resolve_document, string[] odt_style_font_index_resolve_faces, string odt_style_font_index_resolve_name) {
  if(odt_style_font_index_resolve_position >= 0) {
    odt_style_font_index_resolve_family = odt_style_font_index_resolve_faces[odt_style_font_index_resolve_position + 1];
  }
  if(odt_style_font_index_resolve_name != "") {
    odt_style_font_index_resolve_font = odt_style_font_index_ensure(odt_style_font_index_resolve_document, odt_style_font_index_resolve_family);
  }
} return int odt_style_font_index_resolve_font;
