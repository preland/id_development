// Where the pair declaring face os_sname starts in the face list (pairs of declared name and family), -1 when it is not declared; a later declaration of the same name wins.
ost_face_at(string[] os_lface, string os_sname) {
  int os_ik = 0 - 1;
  int i = len(os_lface) - 2;
  while(i >= 0 && os_ik < 0) {
    if(os_lface[i] == os_sname) {
      os_ik = i;
    }
    i = i - 2;
  }
} return int os_ik;
(["A", "a", "B", "b", "A", "c"], "A"):(4)
(["A", "a"], "Z"):(-1)

// The index of font family os_sfam in the document's fonts, added at the end when it is not there yet.
ost_font_idx(Doc os_d, string os_sfam) {
  int os_ifont = lst_str_index(os_d.ext.fonts, os_sfam);
  if(os_ifont < 0) {
    push(os_d.ext.fonts, os_sfam);
    os_ifont = len(os_d.ext.fonts) - 1;
  }
} return int os_ifont;
(Doc(Body([], Page([1, 2, 0], [1, 1, 1, 1], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext(["serif", "Liberation Serif"], [], [])), "Liberation Serif"):(1)
(Doc(Body([], Page([1, 2, 0], [1, 1, 1, 1], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext(["serif"], [], [])), "FreeSans"):(1)

// The index in the document's fonts of the family a declared face name stands for (the name itself when it is not declared), -1 for the empty name, which names no font.
ost_font_at(Doc os_d, string[] os_lface, string os_sname) {
  int os_ifont = 0 - 1;
  int os_ik = ost_face_at(os_lface, os_sname);
  string os_sfam = os_sname;
} chain (Doc os_d, string[] os_lface, string os_sname) {
  if(os_ik >= 0) {
    os_sfam = os_lface[os_ik + 1];
  }
  if(os_sname != "") {
    os_ifont = ost_font_idx(os_d, os_sfam);
  }
} return int os_ifont;
