// An ODT length in twips ("1.27cm", "0.25in", "12pt", "-3mm", "5px"), or ost_bad when it has no number or its unit is not one of ost_units.
ost_len(string os_ss) {
  int os_ie = ost_split(os_ss);
  int os_in = len(os_ss) - os_ie;
  string os_sunit = str_sub(os_ss, os_ie, os_in);
} chain (string os_ss) {
  int os_ik = list_string_index((import ost_units), os_sunit);
  word[] os_wd = ost_digits(os_ss, os_ie);
  int os_itw = (import ost_bad);
} chain (string os_ss) {
  int os_ineg = charat(os_ss, 0) == 45;
  if(os_ik >= 0 && os_ie > 0) {
    os_itw = ost_twips(os_wd, os_ik, os_ineg);
  }
} return int os_itw;
