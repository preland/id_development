// Ten to the n as a word, n small.
odt_named_power_of_ten(int os_in) {
  word odt_named_power_of_ten_result = 1;
  int i = 0;
  while(i < os_in) {
    odt_named_power_of_ten_result = odt_named_power_of_ten_result * 10;
    i = i + 1;
  }
} return word odt_named_power_of_ten_result;
(0):(1)
(3):(1000)

// The twips of a number given as [mantissa, fraction digits] in unit k of ost_units, rounded half away from zero; os_ineg is 1 for a minus sign.
odt_named_length_twentieths(word[] odt_named_length_twentieths_digits, int odt_named_length_twentieths_unit_index, int odt_named_length_twentieths_negative) {
  int odt_named_length_twentieths_fraction_digits = odt_named_length_twentieths_digits[1];
  word odt_named_length_twentieths_scale = (import ost_uden)[odt_named_length_twentieths_unit_index] * odt_named_power_of_ten(odt_named_length_twentieths_fraction_digits);
  word odt_named_length_twentieths_numerator = odt_named_length_twentieths_digits[0] * (import ost_unum)[odt_named_length_twentieths_unit_index];
} chain (word[] odt_named_length_twentieths_digits, int odt_named_length_twentieths_unit_index, int odt_named_length_twentieths_negative) {
  word odt_named_length_twentieths_quotient = (odt_named_length_twentieths_numerator * 2 + odt_named_length_twentieths_scale) / (odt_named_length_twentieths_scale * 2);
  int odt_named_length_twentieths_result = odt_named_length_twentieths_quotient;
  if(odt_named_length_twentieths_negative == 1) {
    odt_named_length_twentieths_result = 0 - odt_named_length_twentieths_result;
  }
} return int odt_named_length_twentieths_result;
