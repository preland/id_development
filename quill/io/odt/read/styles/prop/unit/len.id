// An ODT length in twips ("1.27cm", "0.25in", "12pt", "-3mm", "5px"), or ost_bad when it has no number or its unit is not one of ost_units.
odt_named_length_parse(string odt_named_length_parse_text) {
  int odt_named_length_parse_number_end = odt_named_number_end(odt_named_length_parse_text);
  int os_in = len(odt_named_length_parse_text) - odt_named_length_parse_number_end;
  string odt_named_length_parse_unit_text = str_sub(odt_named_length_parse_text, odt_named_length_parse_number_end, os_in);
} chain (string odt_named_length_parse_text) {
  int odt_named_length_parse_unit_index = list_string_index((import ost_units), odt_named_length_parse_unit_text);
  word[] odt_named_length_parse_digits = odt_named_number_digits(odt_named_length_parse_text, odt_named_length_parse_number_end);
  int odt_named_length_parse_twentieths = (import ost_bad);
} chain (string odt_named_length_parse_text) {
  int odt_named_length_parse_negative = character_code_at(odt_named_length_parse_text, 0) == 45;
  if(odt_named_length_parse_unit_index >= 0 && odt_named_length_parse_number_end > 0) {
    odt_named_length_parse_twentieths = odt_named_length_twentieths(odt_named_length_parse_digits, odt_named_length_parse_unit_index, odt_named_length_parse_negative);
  }
} return int odt_named_length_parse_twentieths;
