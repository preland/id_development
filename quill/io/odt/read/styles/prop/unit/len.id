// Ten to the n as a word, n small.
ost_pow10(int os_in) {
  word os_xp = 1;
  int i = 0;
  while(i < os_in) {
    os_xp = os_xp * 10;
    i = i + 1;
  }
} return word os_xp;
(0):(1)
(3):(1000)

// The twips of a number given as [mantissa, fraction digits] in unit k of ost_units, rounded half away from zero; os_ineg is 1 for a minus sign.
ost_twips(word[] os_wd, int os_ik, int os_ineg) {
  int os_if = os_wd[1];
  word os_xscale = (import ost_uden)[os_ik] * ost_pow10(os_if);
  word os_xnum = os_wd[0] * (import ost_unum)[os_ik];
} chain (word[] os_wd, int os_ik, int os_ineg) {
  word os_xq = (os_xnum * 2 + os_xscale) / (os_xscale * 2);
  int os_itw = os_xq;
  if(os_ineg == 1) {
    os_itw = 0 - os_itw;
  }
} return int os_itw;
