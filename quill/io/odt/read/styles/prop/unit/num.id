// Where the number in os_ss ends and its unit begins: past an optional sign, then digits and points.
odt_named_number_end(string odt_named_number_end_text) {
  int i = 0;
  int odt_named_number_end_code = character_code_at(odt_named_number_end_text, 0);
  if(odt_named_number_end_code == 45 || odt_named_number_end_code == 43) {
    i = 1;
  }
} chain (string odt_named_number_end_text) {
  odt_named_number_end_code = character_code_at(odt_named_number_end_text, i);
  while(odt_named_number_end_code == 46 || character_is_digit(odt_named_number_end_code) == 1) {
    i = i + 1;
    odt_named_number_end_code = character_code_at(odt_named_number_end_text, i);
  }
} return int i;
("12pt"):(2)
("-0.25in"):(5)
("pt"):(0)
("+3"):(2)

// Folds one character into os_wacc = [mantissa, fraction digits, digits taken, seen a point]; a thirteenth digit is dropped so that a mantissa times a unit never overflows a word.
odt_named_digit_fold(word[] odt_named_digit_fold_accumulator, int odt_named_digit_fold_code) {
  if(character_is_digit(odt_named_digit_fold_code) == 1 && odt_named_digit_fold_accumulator[2] < 12) {
    odt_named_digit_fold_accumulator[0] = odt_named_digit_fold_accumulator[0] * 10 + (odt_named_digit_fold_code - 48);
    odt_named_digit_fold_accumulator[2] = odt_named_digit_fold_accumulator[2] + 1;
    odt_named_digit_fold_accumulator[1] = odt_named_digit_fold_accumulator[1] + odt_named_digit_fold_accumulator[3];
  }
  if(odt_named_digit_fold_code == 46) {
    odt_named_digit_fold_accumulator[3] = 1;
  }
} return void;
([0, 0, 0, 0], 53):([5, 0, 1, 0], 53)
([7, 0, 1, 1], 56):([78, 1, 2, 1], 56)
([12, 0, 2, 1], 46):([12, 0, 2, 1], 46)
([999999999999, 0, 12, 0], 49):([999999999999, 0, 12, 0], 49)

// The digits of the number in os_ss[0..os_ie) as [mantissa, fraction digits]: "0.25" is [25, 2].
odt_named_number_digits(string odt_named_number_digits_text, int odt_named_number_digits_end) {
  word[] odt_named_number_digits_accumulator = [0, 0, 0, 0];
  int i = 0;
  while(i < odt_named_number_digits_end) {
    int odt_named_number_digits_code = character_code_at(odt_named_number_digits_text, i);
    odt_named_digit_fold(odt_named_number_digits_accumulator, odt_named_number_digits_code);
    i = i + 1;
  }
} chain (string odt_named_number_digits_text, int odt_named_number_digits_end) {
  word[] odt_named_number_digits_result = [odt_named_number_digits_accumulator[0], odt_named_number_digits_accumulator[1]];
} return word[] odt_named_number_digits_result;
("0.25in", 4):([25, 2])
("-12pt", 3):([12, 0])
("1.5", 3):([15, 1])
