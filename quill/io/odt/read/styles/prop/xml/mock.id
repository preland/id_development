// Test fixtures: a reader over a string kept in an export, so a case can `given` it, step it and hand it to the function under test.
odt_named_reader_open(string odt_named_reader_open_text) {
  int[] odt_named_reader_open_bytes = exec_bytes(odt_named_reader_open_text);
  export XmlR odt_named_reader = xml_reader_open(odt_named_reader_open_bytes);
} return void;
("<a/>"):() then odt_named_reader_name:("")
("<a><b/></a>"):() then odt_named_reader_name:("")

odt_named_reader_name() {
  XmlR odt_named_reader_name_reader = (import odt_named_reader);
  string odt_named_reader_name_result = xml_reader_get(odt_named_reader_name_reader, (import xml_reader_k_name));
} return string odt_named_reader_name_result;
given odt_named_reader_open("<ab/>") given xml_reader_skip((import odt_named_reader), 1) ():("ab")
given odt_named_reader_open("<a><b/></a>") given xml_reader_skip((import odt_named_reader), 2) ():("b")
