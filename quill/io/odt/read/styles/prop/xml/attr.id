// The text of a font family value without the quotes ODT wraps around a name with a space: 'Liberation Sans' is Liberation Sans.
odt_named_family_unquote(string odt_named_family_unquote_text) {
  string odt_named_family_unquote_result = odt_named_family_unquote_text;
  int odt_named_family_unquote_code = character_code_at(odt_named_family_unquote_text, 0);
  int os_in = len(odt_named_family_unquote_text) - 2;
} chain (string odt_named_family_unquote_text) {
  if((odt_named_family_unquote_code == 39 || odt_named_family_unquote_code == 34) && os_in >= 0) {
    odt_named_family_unquote_result = str_sub(odt_named_family_unquote_text, 1, os_in);
  }
} return string odt_named_family_unquote_result;
