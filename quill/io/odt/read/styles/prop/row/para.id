// A fo:text-align value as the model's alignment: start or left 0, center 1, end or right 2, justify 3, ost_bad for anything else.
odt_named_alignment_value(string odt_named_alignment_value_text) {
  int odt_named_alignment_value_result = (import ost_bad);
  if(odt_named_alignment_value_text == "start" || odt_named_alignment_value_text == "left") {
    odt_named_alignment_value_result = 0;
  }
  if(odt_named_alignment_value_text == "center") {
    odt_named_alignment_value_result = 1;
  }
} chain (string odt_named_alignment_value_text) {
  if(odt_named_alignment_value_text == "end" || odt_named_alignment_value_text == "right") {
    odt_named_alignment_value_result = 2;
  }
  if(odt_named_alignment_value_text == "justify") {
    odt_named_alignment_value_result = 3;
  }
} return int odt_named_alignment_value_result;
("start"):(0)
("center"):(1)
("right"):(2)
("justify"):(3)
("both"):(-2147483647)

// A length for a paragraph field in twips, ost_bad when unreadable; a length of exactly -1 twip becomes 0 because -1 means unset in a row.
odt_named_paragraph_length(string odt_named_paragraph_length_text) {
  int odt_named_paragraph_length_twentieths = odt_named_length_parse(odt_named_paragraph_length_text);
  if(odt_named_paragraph_length_twentieths == 0 - 1) {
    odt_named_paragraph_length_twentieths = 0;
  }
} return int odt_named_paragraph_length_twentieths;
("0.25in"):(360)
("-0.25in"):(-360)
("12furlong"):(-2147483647)
("-1pt"):(-20)
("-0.0007in"):(0)

// The value paragraph attribute k (the order of ost_pattr) gives its field: 0 alignment, 1 to 5 lengths in twips, 6 line height in percent, 7 break before as 1 for "page" and 0 otherwise; ost_bad when it does not read.
odt_named_paragraph_value(int odt_named_paragraph_value_attribute, string odt_named_paragraph_value_text) {
  int odt_named_paragraph_value_result = odt_named_paragraph_length(odt_named_paragraph_value_text);
  if(odt_named_paragraph_value_attribute == 0) {
    odt_named_paragraph_value_result = odt_named_alignment_value(odt_named_paragraph_value_text);
  }
  if(odt_named_paragraph_value_attribute == 6) {
    odt_named_paragraph_value_result = odt_named_percent_parse(odt_named_paragraph_value_text);
  }
} chain (int odt_named_paragraph_value_attribute, string odt_named_paragraph_value_text) {
  if(odt_named_paragraph_value_attribute == 7) {
    odt_named_paragraph_value_result = odt_named_paragraph_value_text == "page";
  }
} return int odt_named_paragraph_value_result;
(0, "center"):(1)
(1, "1in"):(1440)
(3, "-0.25in"):(-360)
(6, "115%"):(115)
(6, "0.5cm"):(-2147483647)
(7, "page"):(1)
(7, "auto"):(0)
