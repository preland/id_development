// Reads a whole styles or content document into the bag: every style:style (named, or automatic inside office:automatic-styles) and the default paragraph style, up to the body.
odt_named_scan(odt_named_style_records odt_named_scan_bag, XmlR odt_named_scan_reader) {
  int odt_named_scan_current_event = xml_reader_next(odt_named_scan_reader);
  int odt_named_scan_automatic = 0;
  while(odt_named_scan_current_event > 0 && odt_named_scan_automatic >= 0) {
    odt_named_scan_automatic = odt_named_scan_event(odt_named_scan_bag, odt_named_scan_reader, odt_named_scan_current_event, odt_named_scan_automatic);
    odt_named_scan_current_event = xml_reader_next(odt_named_scan_reader);
  }
} return void;
