// Reads the properties element the reader is at into record irec of the bag: style:text-properties into its character row and font name, style:paragraph-properties into its paragraph row; any other element changes nothing.
ost_rec_part(StyBag os_b, XmlR os_r, int os_irec) {
  string os_sname = xml_reader_get(os_r, (import xml_reader_k_name));
  if(os_sname == "style:text-properties") {
    ost_rec_chars(os_b, os_r, os_irec);
  }
  if(os_sname == "style:paragraph-properties") {
    ost_ptext(os_b.prows[os_irec], os_r);
  }
} return void;
