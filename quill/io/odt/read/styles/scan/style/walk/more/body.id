// Starts a record for the style element the reader is at, in kind skind, and reads its children when it has any; answers the record's index, -1 when its family is not modelled.
ost_rec_read(StyBag os_b, XmlR os_r, int os_iev, string os_skind) {
  int os_irec = ost_rec_add(os_b, os_r, os_skind);
  int os_idepth = xr_depth(os_r);
  if(os_irec >= 0 && os_iev == 1) {
    ost_rec_body(os_b, os_r, os_irec, os_idepth);
  }
} return int os_irec;
