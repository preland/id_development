// Reads the children of the style element the reader just started, at depth idepth, into record irec, up to its end.
ost_rec_body(StyBag os_b, XmlR os_r, int os_irec, int os_idepth) {
  int os_iev = xr_next(os_r);
  int os_imore = xr_inside(os_r, os_iev, os_idepth);
  while(os_imore == 1) {
    ost_rec_part(os_b, os_r, os_irec);
    os_iev = xr_next(os_r);
    os_imore = xr_inside(os_r, os_iev, os_idepth);
  }
} return void;
