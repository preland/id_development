// "p" for a paragraph style family, "t" for a text one, "" for any other family, which the reader does not model.
odt_named_family_code(string odt_named_family_code_text) {
  string odt_named_family_code_result = "";
  if(odt_named_family_code_text == "paragraph") {
    odt_named_family_code_result = "p";
  }
  if(odt_named_family_code_text == "text") {
    odt_named_family_code_result = "t";
  }
} return string odt_named_family_code_result;
