// What one event inside a list style does to the levels llv, given the level icur the last level element selected: a level element starts the level it names (-1 when the model keeps no such level), any other element applies to the current one. Answers the new current level.
ost_lvl_event(int[] os_llv, XmlR os_r, int os_iev, int os_icur) {
  int os_ihead = os_iev != 2 && str_starts(xml_reader_get(os_r, (import xml_reader_k_name)), "text:list-level-style-") == 1;
  int os_inew = os_icur;
  if(os_ihead == 1) {
    os_inew = ost_level_of(os_r);
  }
} chain (int[] os_llv, XmlR os_r, int os_iev, int os_icur) {
  if(os_ihead == 1 && os_inew >= 0) {
    ost_lvl_head(os_llv, os_r, os_inew);
  }
  if(os_ihead == 0 && os_inew >= 0 && os_iev != 2) {
    ost_lvl_kid(os_llv, os_r, os_inew);
  }
} return int os_inew;
