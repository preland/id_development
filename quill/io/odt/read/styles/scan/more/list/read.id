// Applies a child of a level element to the level at index ilevel: its label alignment or its (older) list-level properties; any other element changes nothing.
ost_lvl_kid(int[] os_llv, XmlR os_r, int os_ilevel) {
  string os_sname = xml_reader_get(os_r, (import xml_reader_k_name));
  int os_ib = os_ilevel * (import quill_list_level_stride);
  if(os_sname == "style:list-level-label-alignment") {
    ost_lvl_align(os_llv, os_r, os_ib);
  }
} chain (int[] os_llv, XmlR os_r, int os_ilevel) {
  if(os_sname == "style:list-level-properties") {
    ost_lvl_legacy(os_llv, os_r, os_ib);
  }
} return void;
