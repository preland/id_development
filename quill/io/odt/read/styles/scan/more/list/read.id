// Appends a list definition called os_sname with the levels llv to the document's lists; its kind is level 1's.
ost_list_add(Fmt os_f, string os_sname, int[] os_llv) {
  int os_ikind = os_llv[(import quill_list_level_kind)];
  ListDef os_ld = ListDef(os_sname, os_llv, os_ikind);
  ListDef[] os_lls = os_f.sty.lists;
} chain (Fmt os_f, string os_sname, int[] os_llv) {
  push(os_lls, os_ld);
} return void;
