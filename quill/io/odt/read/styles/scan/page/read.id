// Reads the width, height and four margins of the style:page-layout-properties element the reader is at into a layout's ints; an attribute that is absent or unreadable leaves its int as it was.
ost_pg_dims(int[] os_lpg, XmlR os_r) {
  int os_ik = 0;
  while(os_ik < len((import ost_gattr))) {
    string os_sv = xml_reader_attr(os_r, (import ost_gattr)[os_ik]);
    ost_pg_set(os_lpg, os_ik, os_sv);
    os_ik = os_ik + 1;
  }
} return void;
