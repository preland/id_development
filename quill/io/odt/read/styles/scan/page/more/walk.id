// Reads the page layouts and master pages of a styles document into a table.
ost_pg_scan(XmlR os_r) {
  PgTab os_pg = ost_pg_new();
  int os_iev = xr_next(os_r);
  int os_igo = 1;
} chain (XmlR os_r) {
  while(os_iev > 0 && os_igo == 1) {
    os_igo = ost_pg_event(os_pg, os_r, os_iev);
    os_iev = xr_next(os_r);
  }
} return PgTab os_pg;
