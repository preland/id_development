// The seven ints of the page layout of master page os_smaster ("" for the first master page), or an empty list when the document defines no layout.
ost_pg_pick(PgTab os_pg, string os_smaster) {
  int[] os_lpick = [];
  int os_im = ost_pg_master_at(os_pg, os_smaster);
  string os_slay = ost_pg_lname(os_pg, os_im);
} chain (PgTab os_pg, string os_smaster) {
  int os_il = ost_pg_layout_at(os_pg, os_slay);
  if(len(os_pg.vals) > 0) {
    os_lpick = list_copy(os_pg.vals[os_il]);
  }
} return int[] os_lpick;
