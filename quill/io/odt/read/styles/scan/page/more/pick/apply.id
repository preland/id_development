// The master page names of the table, in order.
ost_pg_masters(PgTab os_pg) {
  string[] os_lnames = [];
  int os_ik = 0;
  while(os_ik < len(os_pg.masters)) {
    push(os_lnames, os_pg.masters[os_ik]);
    os_ik = os_ik + 2;
  }
} return string[] os_lnames;
(PgTab([], [], ["A", "L", "B", "M"])):(["A", "B"])
(PgTab([], [], [])):([])

// Sets the page of a document from layout ints (ost_pgdef's order); an empty list changes nothing.
ost_pg_apply(Doc os_d, int[] os_lpg) {
  if(len(os_lpg) == 7) {
    list_splice(os_d.body.page.size, 0, 3, list_slice(os_lpg, 0, 3));
    list_splice(os_d.body.page.margin, 0, 4, list_slice(os_lpg, 3, 4));
  }
} return void;
