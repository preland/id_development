// Sets the page of a document from layout ints (ost_pgdef's order); an empty list changes nothing.
odt_named_page_apply(Doc odt_named_page_apply_document, int[] odt_named_page_apply_layout) {
  if(len(odt_named_page_apply_layout) == 7) {
    list_splice(odt_named_page_apply_document.body.page.size, 0, 3, list_slice(odt_named_page_apply_layout, 0, 3));
    list_splice(odt_named_page_apply_document.body.page.margin, 0, 4, list_slice(odt_named_page_apply_layout, 3, 4));
  }
} return void;
