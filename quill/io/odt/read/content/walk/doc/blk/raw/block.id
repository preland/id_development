// An element of the body the model does not edit, kept untouched: one paragraph of its own whose text is a marker for the kept bytes and a label, and whose paragraph row says it is opaque.
orc_block(Odt_Read_Context odt_read_block_context, int odt_read_block_event_code, string name) {
  int odt_read_block_part_index = orc_raw(odt_read_block_context, odt_read_block_event_code);
  Text t = text_new(0);
  integer_list_set(odt_read_block_context.cs.slots, (import orc_s_link), 0);
} chain (Odt_Read_Context odt_read_block_context, int odt_read_block_event_code, string name) {
  orc_run(odt_read_block_context, t, (import quill_object_marker) + odt_read_block_part_index, 1);
  orc_text(odt_read_block_context, t, orc_label(name));
  int pp = tab_with(odt_read_block_context.d.fmt.paras, 0, (import quill_paragraph_kind), 1);
} chain (Odt_Read_Context odt_read_block_context, int odt_read_block_event_code, string name) {
  Para p = para_make(t, pp);
  push(odt_read_block_context.d.body.paras, p);
} return void;
given odt_read_fixture_open("<table:table><x/></table:table>") given odt_read_fixture_remove_paragraph given odt_read_fixture_step_events(1) ((import odt_read_fixture_context), 1, "table:table"):() then odt_read_fixture_show:("P9 983040,91,84,97,98,108,101,93, 8:0:-1, {0,0,0,0,1} |  | table:table:0:<table:table><x/></table:table>,")
given odt_read_fixture_open("<r><a/><draw:frame/></r>") given odt_read_fixture_step_events(2) given orc_block((import odt_read_fixture_context), 4, "a") given odt_read_fixture_step_events(1) ((import odt_read_fixture_context), 4, "draw:frame"):() then odt_read_fixture_show:("P0  0:0:-1, {0,0,0,0,0}\nP9 983040,91,66,108,111,99,107,93, 8:0:-1, {0,0,0,0,1}\nP9 983041,91,66,108,111,99,107,93, 8:0:-1, {0,0,0,0,1} |  | a:0:<a/>,draw:frame:0:<draw:frame/>,")

// The label an opaque block shows in place of its content.
orc_label(string name) {
  int at = list_string_index((import orc_block_names), name);
  string label = "[Block]";
  if(at >= 0) {
    label = (import orc_block_labels)[at];
  }
} return string label;
("table:table"):("[Table]")
("text:section"):("[Section]")
("draw:frame"):("[Block]")

// What a start tag between blocks is: 0 a paragraph or heading, 1 a list, 2 an element stepped through, 3 a declaration kept apart, 4 anything else, an opaque block.
orc_kind(string name) {
  int kind = 4;
  if(name == "text:p" || name == "text:h") {
    kind = 0;
  }
  if(name == "text:list") {
    kind = 1;
  }
} chain (string name) {
  if(list_string_index((import orc_pass_names), name) >= 0) {
    kind = 2;
  }
  if(list_string_index((import orc_prologue), name) >= 0) {
    kind = 3;
  }
} return int kind;
("text:p"):(0)
("text:h"):(0)
("text:list"):(1)
("text:list-item"):(2)
("text:sequence-decls"):(3)
("table:table"):(4)
