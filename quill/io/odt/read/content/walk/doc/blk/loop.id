// A block starts. Paragraphs and headings are read into the model, a list only changes the counters the paragraphs inside it read, a list item wrapper is stepped through, a declaration of the body is kept apart, and anything else is kept untouched as an opaque block.
orc_start(Odt_Read_Context odt_read_start_context, int odt_read_start_event) {
  string name = xml_reader_get((odt_read_start_context.odt_read_xml_reader), (import xml_reader_k_name));
  int kind = orc_kind(name);
  if(kind == 0) {
    orc_para(odt_read_start_context, odt_read_start_event);
  }
} chain (Odt_Read_Context odt_read_start_context, int odt_read_start_event) {
  if(kind == 1 && odt_read_start_event == 1) {
    orc_list_open(odt_read_start_context);
  }
  if(kind == 3) {
    int odt_read_start_part_index = orc_raw(odt_read_start_context, odt_read_start_event);
  }
  if(kind == 4) {
    orc_block(odt_read_start_context, odt_read_start_event, name);
  }
} return void;
