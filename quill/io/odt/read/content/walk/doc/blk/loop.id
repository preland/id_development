given odt_read_fixture_open("<r><office:text/><text:p>z</text:p></r>") given odt_read_fixture_remove_paragraph given odt_read_fixture_step_events(2) ((import odt_read_fixture_context), 4):() then odt_read_fixture_show:(" |  | ")

// One event between blocks: an end tag may close a list or the body, a start or empty tag opens a block, and text here (white space between the tags) is nothing.
odt_read_block_event(Odt_Read_Context odt_read_block_step_context, int odt_read_block_step_event) {
  if(odt_read_block_step_event == 2) {
    orc_end(odt_read_block_step_context);
  }
  if(odt_read_block_step_event == 1 || odt_read_block_step_event == 4) {
    orc_start(odt_read_block_step_context, odt_read_block_step_event);
  }
} return void;
