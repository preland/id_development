// Reads the body of office:text, which the head stopped at (at 1 is a start tag with a body to read; an empty element has none), one event at a time until its end tag.
orc_body(Odt_Read_Context odt_read_body_context, int at) {
  int odt_read_body_event = 0;
  if(at == 1) {
    odt_read_body_event = orc_next(odt_read_body_context);
  }
  while(odt_read_body_event > 0 && odt_read_body_context.cs.slots[(import orc_s_done)] == 0) {
    odt_read_block_event(odt_read_body_context, odt_read_body_event);
    odt_read_body_event = orc_next(odt_read_body_context);
  }
} return void;
