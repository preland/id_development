// Keeps the automatic styles that an element kept as a part (its bytes are bytes) names, each once, as parts called "auto:NAME" holding the style's element: the writer puts them back in office:automatic-styles, which is how a table keeps its borders. The data are read again with a reader of their own, so the read of the document is not disturbed.
orc_autos(Odt_Read_Context odt_read_autos_context, int[] data) {
  XmlR odt_read_autos_reader = xml_reader_open(data);
  int odt_read_autos_event = xml_reader_next(odt_read_autos_reader);
  while(odt_read_autos_event > 0) {
    odt_read_style_references(odt_read_autos_context, odt_read_autos_reader);
    odt_read_autos_event = xml_reader_next(odt_read_autos_reader);
  }
} return void;
