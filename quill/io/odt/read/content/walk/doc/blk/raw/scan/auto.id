// What one element names: each of the attributes that name a style (conf.id) in the element the reader is at.
odt_read_style_references(Odt_Read_Context odt_read_references_context, XmlR odt_read_references_reader) {
  string[] odt_read_references_attributes = (import orc_style_attrs);
  int i = 0;
  while(i < len(odt_read_references_attributes)) {
    odt_read_style_reference(odt_read_references_context, xml_reader_attr(odt_read_references_reader, odt_read_references_attributes[i]));
    i = i + 1;
  }
} return void;
