// A style name an element gave: when it is an automatic style noted in the head and not yet kept, it is kept (a name no automatic style has, such as a style of styles.xml, or an empty name, is none of this reader's business).
odt_read_style_reference(Odt_Read_Context odt_read_reference_context, string odt_read_reference_style_name) {
  int k = list_string_index(odt_read_reference_context.cs.odt_read_automatic_styles.keys, (import orc_k_auto) + odt_read_reference_style_name);
  int fresh = odt_read_reference_style_name != "" && k >= 0 && odt_read_reference_context.cs.odt_read_automatic_styles.odt_read_values[k] >= 0;
  if(fresh == 1) {
    orc_take(odt_read_reference_context, odt_read_reference_style_name, k);
  }
} return void;
