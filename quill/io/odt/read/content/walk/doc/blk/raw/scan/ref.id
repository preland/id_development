// Keeps the automatic style that entry k of the table names as the part "auto:NAME", marks the entry as kept, and then keeps the automatic styles that style leans on in turn (its list style, its parent).
orc_take(Odt_Read_Context odt_read_take_context, string odt_read_take_style_name, int k) {
  int[] vs = odt_read_take_context.cs.odt_read_automatic_styles.odt_read_values;
  int[] data = list_slice(odt_read_take_context.odt_read_xml_reader.src, vs[k], vs[k + 1] - vs[k]);
  Part odt_read_take_part = Part((import orc_k_auto) + odt_read_take_style_name, data, (import orc_part_raw));
} chain (Odt_Read_Context odt_read_take_context, string odt_read_take_style_name, int k) {
  integer_list_set(vs, k, 0 - 1);
  push(odt_read_take_context.d.ext.parts, odt_read_take_part);
  orc_autos(odt_read_take_context, data);
} return void;
