// A text:list opens: one level deeper, and when it names a list style that one is the list its paragraphs belong to. A nested list that names none keeps the list around it.
orc_list_open(Odt_Read_Context odt_read_list_open_context) {
  int lvl = odt_read_list_open_context.cs.slots[(import orc_s_lvl)] + 1;
  int id = odt_style_lookup_row(odt_read_list_open_context.cs.look.odt_read_style_lookup, "l:", xml_reader_attribute(odt_read_list_open_context.odt_read_xml_reader, "text:style-name"));
  integer_list_set(odt_read_list_open_context.cs.slots, (import orc_s_lvl), lvl);
} chain (Odt_Read_Context odt_read_list_open_context) {
  if(id > 0) {
    integer_list_set(odt_read_list_open_context.cs.slots, (import orc_s_list), id);
  }
} return void;
