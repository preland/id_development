// An end tag between blocks: the end of a list takes one level off, the end of office:text ends the body.
orc_end(Odt_Read_Context odt_read_end_context) {
  string name = xml_reader_get((odt_read_end_context.odt_read_xml_reader), (import xml_reader_k_name));
  if(name == "text:list") {
    orc_list_end(odt_read_end_context);
  }
  if(name == "office:text") {
    integer_list_set(odt_read_end_context.cs.slots, (import orc_s_done), 1);
  }
} return void;
