// A text:list ends: one level up, and outside every list there is no list.
orc_list_end(Odt_Read_Context odt_read_list_end_context) {
  int lvl = odt_read_list_end_context.cs.slots[(import orc_s_lvl)] - 1;
  integer_list_set(odt_read_list_end_context.cs.slots, (import orc_s_lvl), lvl);
  if(lvl == 0) {
    integer_list_set(odt_read_list_end_context.cs.slots, (import orc_s_list), 0);
  }
} return void;
