// Reads on to the end tag of the element that has just started and answers the offset just past it; an empty element is already closed.
orc_close(Odt_Read_Context odt_read_close_context, int odt_read_close_event) {
  int shut = odt_read_close_event == 4;
  orc_skip(odt_read_close_context, xml_reader_depth(odt_read_close_context.odt_read_xml_reader), shut);
  int at = odt_read_reader_offset(odt_read_close_context.odt_read_xml_reader);
} return int at;
