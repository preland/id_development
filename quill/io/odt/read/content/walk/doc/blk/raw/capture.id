// The element that has just started, taken out of the document byte for byte and kept as a part; the part's index. Everything inside it is read past, so none of it reaches a paragraph. The automatic styles it names are kept as parts after it.
orc_raw(Odt_Read_Context odt_read_raw_context, int odt_read_raw_event) {
  int lo = orc_tag_at(odt_read_raw_context.odt_read_xml_reader, odt_read_raw_context.cs.slots[(import orc_s_prev)]);
  string name = xml_reader_get((odt_read_raw_context.odt_read_xml_reader), (import xml_reader_k_name));
  int hi = orc_close(odt_read_raw_context, odt_read_raw_event);
} chain (Odt_Read_Context odt_read_raw_context, int odt_read_raw_event) {
  int[] data = list_slice(odt_read_raw_context.odt_read_xml_reader.src, lo, hi - lo);
  Part odt_read_raw_part = Part(name, data, (import orc_part_raw));
  push(odt_read_raw_context.d.ext.parts, odt_read_raw_part);
} chain (Odt_Read_Context odt_read_raw_context, int odt_read_raw_event) {
  int odt_read_raw_part_index = len(odt_read_raw_context.d.ext.parts) - 1;
  orc_autos(odt_read_raw_context, data);
} return int odt_read_raw_part_index;
