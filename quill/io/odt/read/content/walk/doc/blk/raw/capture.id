// Reads events until one ends the element at depth base, or the document ends or breaks first; shut says the element is closed already.
orc_skip(Odt_Read_Context odt_read_skip_context, int base, int shut) {
  while(shut == 0) {
    int odt_read_skip_event = xml_reader_next(odt_read_skip_context.odt_read_xml_reader);
    shut = odt_read_skip_event <= 0 || (odt_read_skip_event == 2 && xml_reader_depth(odt_read_skip_context.odt_read_xml_reader) == base);
  }
} return void;
