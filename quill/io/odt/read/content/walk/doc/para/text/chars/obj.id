// An element inside a paragraph that the model does not know (a picture frame, a footnote, a bookmark): kept untouched as a part, and stood for in the text by one marker code point, so the rest of the paragraph stays editable.
orc_object(Cx cx, Text t, int ev) {
  int idx = orc_raw(cx, ev);
  orc_run(cx, t, (import word_o_marker) + idx, 1);
} return void;
