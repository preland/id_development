// An element inside a paragraph that the model does not know (a picture frame, a footnote, a bookmark): kept untouched as a part, and stood for in the text by one marker code point, so the rest of the paragraph stays editable.
orc_object(Odt_Read_Context odt_read_object_context, Text t, int odt_read_object_event) {
  int odt_read_object_part_index = orc_raw(odt_read_object_context, odt_read_object_event);
  orc_run(odt_read_object_context, t, (import quill_object_marker) + odt_read_object_part_index, 1);
} return void;
