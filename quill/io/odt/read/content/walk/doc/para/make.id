// A paragraph starts with no hyperlink around its text, with a space as the last character, so the white space that opens it is dropped, and with the character row its style's own text properties amount to (none: row 0, Normal's).
orc_reset(Odt_Read_Context odt_read_reset_context) {
  lset(odt_read_reset_context.cs.slots, (import orc_s_space), 1);
  lset(odt_read_reset_context.cs.slots, (import orc_s_link), 0);
  string odt_read_reset_style_name = xml_reader_attr(odt_read_reset_context.odt_read_xml_reader, "text:style-name");
} chain (Odt_Read_Context odt_read_reset_context) {
  int ov = odt_style_over_for_name(odt_read_reset_context.cs.look.odt_read_style_lookup, odt_read_reset_style_name);
  int[] odt_read_reset_row_stack = odt_read_reset_context.cs.look.odt_read_row_stack;
  int top = len(odt_read_reset_row_stack);
} chain (Odt_Read_Context odt_read_reset_context) {
  int[] odt_read_reset_first_row = [fixed_point_maximum(ov, 0)];
  list_splice(odt_read_reset_row_stack, 0, top, odt_read_reset_first_row);
} return void;
