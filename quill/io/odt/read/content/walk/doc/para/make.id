// The paragraph row of the paragraph element that has just started: its style (a heading with none takes Heading 1 to 3 by its outline level), then the list and level it sits in.
odt_read_paragraph_row(Odt_Read_Context odt_read_paragraph_row_context) {
  string odt_read_paragraph_row_style_name = xml_reader_attr(odt_read_paragraph_row_context.odt_read_xml_reader, "text:style-name");
  int lvl = to_int(xml_reader_attr(odt_read_paragraph_row_context.odt_read_xml_reader, "text:outline-level"));
  int odt_read_paragraph_row_style_row = odt_read_paragraph_style_row(odt_read_paragraph_row_context, odt_read_paragraph_row_style_name, lvl);
} chain (Odt_Read_Context odt_read_paragraph_row_context) {
  int pp = odt_read_paragraph_list_row(odt_read_paragraph_row_context, odt_read_paragraph_row_style_row);
} return int pp;
