// A text:p or text:h that has just started becomes a paragraph of the body: its paragraph row from the element's attributes, then its text up to the matching end tag (an empty element has none).
orc_para(Odt_Read_Context odt_read_paragraph_context, int odt_read_paragraph_event) {
  Text t = text_new(0);
  int pp = odt_read_paragraph_row(odt_read_paragraph_context);
  orc_reset(odt_read_paragraph_context);
} chain (Odt_Read_Context odt_read_paragraph_context, int odt_read_paragraph_event) {
  if(odt_read_paragraph_event == 1) {
    orc_inline(odt_read_paragraph_context, t, xml_reader_depth(odt_read_paragraph_context.odt_read_xml_reader));
  }
  Para p = para_make(t, pp);
  push(odt_read_paragraph_context.d.body.paras, p);
} return void;
