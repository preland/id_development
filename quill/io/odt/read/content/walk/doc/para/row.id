// The paragraph row for a style name: the row ost_row says it stands for (an automatic style's parent and page break, a named style's own row, Normal for a name the document does not know). A text:h with no style name is a heading of its outline level, which is capped at 3.
odt_read_paragraph_style_row(Odt_Read_Context odt_read_style_row_context, string odt_read_style_row_style_name, int lvl) {
  int odt_read_style_row_result = odt_style_lookup_row(odt_read_style_row_context.cs.look.odt_read_style_lookup, "p:", odt_read_style_row_style_name);
  int odt_read_style_row_heading_style = 2 + lvl - (lvl > 3) * (lvl - 3);
  if(odt_read_style_row_style_name == "" && lvl > 0) {
    odt_read_style_row_result = tab_with(odt_read_style_row_context.d.fmt.paras, 0, (import quill_paragraph_style), odt_read_style_row_heading_style);
  }
} return int odt_read_style_row_result;
