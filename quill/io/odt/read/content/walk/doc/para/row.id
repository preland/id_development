// The row rw with the list the paragraph sits in and its level (0 to 2, deeper lists count as 2), when it sits in one.
odt_read_paragraph_list_row(Odt_Read_Context odt_read_list_row_context, int odt_read_list_row_base) {
  int lvl = odt_read_list_row_context.cs.slots[(import orc_s_lvl)];
  int id = odt_read_list_row_context.cs.slots[(import orc_s_list)];
  int lev = lvl - 1 - (lvl > 3) * (lvl - 3);
} chain (Odt_Read_Context odt_read_list_row_context, int odt_read_list_row_base) {
  int pp = odt_read_list_row_base;
  if(lvl > 0 && id > 0) {
    pp = tab_with(odt_read_list_row_context.d.fmt.paras, odt_read_list_row_base, (import quill_paragraph_list), id);
    pp = tab_with(odt_read_list_row_context.d.fmt.paras, pp, (import quill_paragraph_level), lev);
  }
} return int pp;
