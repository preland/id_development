// Adds the text of a text event. ODT reads any run of white space (space, tab, newline, carriage return) as one space and drops it at the start of a paragraph; spaces and tabs that count are text:s and text:tab.
orc_text(Odt_Read_Context odt_read_text_context, Text t, string odt_read_text_content) {
  int i = 0;
  while(i < len(odt_read_text_content)) {
    i = orc_char(odt_read_text_context, t, odt_read_text_content, i);
  }
} return void;
