// Adds n copies of the code point cp as characters that count: the last character is no longer a space.
orc_run(Odt_Read_Context odt_read_run_context, Text t, int cp, int n) {
  int i = 0;
  while(i < n) {
    orc_add(odt_read_run_context, t, cp);
    i = i + 1;
  }
  integer_list_set(odt_read_run_context.cs.slots, (import orc_s_space), 0);
} return void;
