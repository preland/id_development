// Adds the character of s at byte i, or nothing for white space after white space; the byte offset of the next character.
orc_char(Cx cx, Text t, string s, int i) {
  int cp = utf8_code_point(s, i);
  int nx = i + utf8_sequence(s, i);
  int isws = cp == 32 || cp == 9 || cp == 10 || cp == 13;
} chain (Cx cx, Text t, string s, int i) {
  if(isws == 0) {
    orc_run(cx, t, cp, 1);
  }
  if(isws == 1 && cx.cs.slots[(import orc_s_space)] == 0) {
    orc_add(cx, t, 32);
    lset(cx.cs.slots, (import orc_s_space), 1);
  }
} return int nx;
