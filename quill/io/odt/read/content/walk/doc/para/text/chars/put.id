// Adds n copies of the code point cp as characters that count: the last character is no longer a space.
orc_run(Cx cx, Text t, int cp, int n) {
  int i = 0;
  while(i < n) {
    orc_add(cx, t, cp);
    i = i + 1;
  }
  lset(cx.cs.slots, (import orc_s_space), 0);
} return void;
