// Adds the character of s at byte i, or nothing for white space after white space; the byte offset of the next character.
orc_char(Odt_Read_Context odt_read_char_context, Text t, string odt_read_char_text, int i) {
  int cp = utf8_code_point(odt_read_char_text, i);
  int nx = i + utf8_sequence(odt_read_char_text, i);
  int odt_read_char_is_white_space = cp == 32 || cp == 9 || cp == 10 || cp == 13;
} chain (Odt_Read_Context odt_read_char_context, Text t, string odt_read_char_text, int i) {
  if(odt_read_char_is_white_space == 0) {
    orc_run(odt_read_char_context, t, cp, 1);
  }
  if(odt_read_char_is_white_space == 1 && odt_read_char_context.cs.slots[(import orc_s_space)] == 0) {
    orc_add(odt_read_char_context, t, 32);
    integer_list_set(odt_read_char_context.cs.slots, (import orc_s_space), 1);
  }
} return int nx;
