// What one event inside a paragraph adds: text, spaces, a tab or a line break as code points, the start or end of a hyperlink or of a text:span (the character row of the text follows it), or, for an element the model does not know, an object kept untouched.
odt_read_inline_event(Odt_Read_Context odt_read_inline_step_context, Text t, int odt_read_inline_step_event) {
  int k = odt_read_inline_kind(odt_read_inline_step_context, odt_read_inline_step_event);
  if(k == 0) {
    orc_text(odt_read_inline_step_context, t, xml_reader_text(odt_read_inline_step_context.odt_read_xml_reader));
  }
  if(k == 2) {
    orc_link(odt_read_inline_step_context);
  }
} chain (Odt_Read_Context odt_read_inline_step_context, Text t, int odt_read_inline_step_event) {
  if(k == 3) {
    lset(odt_read_inline_step_context.cs.slots, (import orc_s_link), 0);
  }
  if(k == 4) {
    orc_gap(odt_read_inline_step_context, t);
  }
  if(k == 5) {
    orc_run(odt_read_inline_step_context, t, (import orc_cp_tab), 1);
  }
} chain (Odt_Read_Context odt_read_inline_step_context, Text t, int odt_read_inline_step_event) {
  if(k == 6) {
    orc_run(odt_read_inline_step_context, t, (import orc_cp_break), 1);
  }
  if(k < 0) {
    orc_object(odt_read_inline_step_context, t, odt_read_inline_step_event);
  }
  if(k == 1 && odt_read_inline_step_event == 1 && xml_reader_get((odt_read_inline_step_context.odt_read_xml_reader), (import xml_reader_k_name)) == "text:span") {
    orc_span_in(odt_read_inline_step_context);
  }
} chain (Odt_Read_Context odt_read_inline_step_context, Text t, int odt_read_inline_step_event) {
  if(k == 1 && odt_read_inline_step_event == 2 && xml_reader_get((odt_read_inline_step_context.odt_read_xml_reader), (import xml_reader_k_name)) == "text:span") {
    orc_span_out(odt_read_inline_step_context);
  }
} return void;
