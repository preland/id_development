// The content of a paragraph, one event at a time, until the end tag of the paragraph itself (the end event at depth base).
orc_inline(Odt_Read_Context odt_read_inline_context, Text t, int base) {
  int odt_read_inline_event_code = orc_next(odt_read_inline_context);
  while(odt_read_inline_event_code > 0 && orc_inside(odt_read_inline_context, odt_read_inline_event_code, base) == 1) {
    odt_read_inline_event(odt_read_inline_context, t, odt_read_inline_event_code);
    odt_read_inline_event_code = orc_next(odt_read_inline_context);
  }
} return void;
