// What one event inside a paragraph adds: text, spaces, a tab or a line break as code points, the start or end of a hyperlink or of a text:span (the character row of the text follows it), or, for an element the model does not know, an object kept untouched.
orc_inline_ev(Cx cx, Text t, int ev) {
  int k = orc_ikind(cx, ev);
  if(k == 0) {
    orc_text(cx, t, xml_reader_text(cx.rd));
  }
  if(k == 2) {
    orc_link(cx);
  }
} chain (Cx cx, Text t, int ev) {
  if(k == 3) {
    lset(cx.cs.slots, (import orc_s_link), 0);
  }
  if(k == 4) {
    orc_gap(cx, t);
  }
  if(k == 5) {
    orc_run(cx, t, (import orc_cp_tab), 1);
  }
} chain (Cx cx, Text t, int ev) {
  if(k == 6) {
    orc_run(cx, t, (import orc_cp_break), 1);
  }
  if(k < 0) {
    orc_object(cx, t, ev);
  }
  if(k == 1 && ev == 1 && xml_reader_get((cx.rd), (import xml_reader_k_name)) == "text:span") {
    orc_span_in(cx);
  }
} chain (Cx cx, Text t, int ev) {
  if(k == 1 && ev == 2 && xml_reader_get((cx.rd), (import xml_reader_k_name)) == "text:span") {
    orc_span_out(cx);
  }
} return void;
