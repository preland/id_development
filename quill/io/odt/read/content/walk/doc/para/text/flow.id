// 1 while the event is part of the paragraph: every event but the end tag of the paragraph, the end event at depth base.
orc_inside(Odt_Read_Context odt_read_inside_context, int odt_read_inside_event, int base) {
  int ended = odt_read_inside_event == 2 && xml_reader_depth(odt_read_inside_context.odt_read_xml_reader) == base;
  int in = 1 - ended;
} return int in;
