// The content of a paragraph, one event at a time, until the end tag of the paragraph itself (the end event at depth base).
orc_inline(Cx cx, Text t, int base) {
  int ev = orc_next(cx);
  while(ev > 0 && orc_inside(cx, ev, base) == 1) {
    orc_inline_ev(cx, t, ev);
    ev = orc_next(cx);
  }
} return void;
