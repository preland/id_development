// Makes the runs cover one more code point under hyperlink lk in character row rw: the last run grows when it has that link and that row or is the empty paragraph's zero-length run, else a run of its own is added.
orc_grow(Text t, int lk, int rw) {
  Run lastrun = t.runs[len(t.runs) - 1];
  int same = lastrun.len == 0 || (lastrun.link == lk && lastrun.cprop == rw);
  int fresh = 1 - same;
} chain (Text t, int lk, int rw) {
  if(same == 1) {
    lastrun.len = lastrun.len + 1;
    lastrun.link = lk;
    lastrun.cprop = rw;
  }
  if(fresh == 1) {
    Run nr = Run(1, rw, lk);
    push(t.runs, nr);
  }
} return void;
