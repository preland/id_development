// A text:s: as many spaces as its text:c says, one when it says nothing.
orc_gap(Odt_Read_Context odt_read_gap_context, Text t) {
  int n = to_int(xml_reader_attr(odt_read_gap_context.odt_read_xml_reader, "text:c"));
  if(n < 1) {
    n = 1;
  }
  orc_run(odt_read_gap_context, t, 32, n);
} return void;
