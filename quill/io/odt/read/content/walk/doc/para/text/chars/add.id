// A text:s: as many spaces as its text:c says, one when it says nothing.
orc_gap(Cx cx, Text t) {
  int n = to_int(xr_attr(cx.rd, "text:c"));
  if(n < 1) {
    n = 1;
  }
  orc_run(cx, t, 32, n);
} return void;
