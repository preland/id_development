// Appends one code point to the paragraph's text, inside the hyperlink the text is in and in the character row in force (the top of Cs.rowstk).
orc_add(Odt_Read_Context odt_read_add_context, Text t, int cp) {
  push(t.cps, cp);
  int odt_read_add_character_row = list_last(odt_read_add_context.cs.look.odt_read_row_stack);
  orc_grow(t, odt_read_add_context.cs.slots[(import orc_s_link)] - 1, odt_read_add_character_row);
} return void;
