// Makes the runs cover one more code point under hyperlink lk in character row rw: the last run grows when it has that link and that row or is the empty paragraph's zero-length run, else a run of its own is added.
orc_grow(Text t, int lk, int odt_read_grow_character_row) {
  Run odt_read_grow_last_run = t.runs[len(t.runs) - 1];
  int same = odt_read_grow_last_run.len == 0 || (odt_read_grow_last_run.link == lk && odt_read_grow_last_run.cprop == odt_read_grow_character_row);
  int fresh = 1 - same;
} chain (Text t, int lk, int odt_read_grow_character_row) {
  if(same == 1) {
    odt_read_grow_last_run.len = odt_read_grow_last_run.len + 1;
    odt_read_grow_last_run.link = lk;
    odt_read_grow_last_run.cprop = odt_read_grow_character_row;
  }
  if(fresh == 1) {
    Run nr = Run(1, odt_read_grow_character_row, lk);
    push(t.runs, nr);
  }
} return void;
