// A read over the XML reader rd that fills the document d: the styles osty (from ost_load) say what the names mean, no automatic style is placed yet, outside every list, and at the start of a paragraph for white space.
orc_new(Doc d, XmlR odt_read_new_reader, Odt_style_lookup odt_read_new_styles) {
  string[] odt_read_new_style_keys = [];
  int[] lv = [];
  Names odt_read_new_style_names = Names(odt_read_new_style_keys, lv);
} chain (Doc d, XmlR odt_read_new_reader, Odt_style_lookup odt_read_new_styles) {
  int[] odt_read_new_slots = [];
  list_fill(odt_read_new_slots, (import orc_s_len), 0);
  int[] odt_read_new_row_stack = [0];
} chain (Doc d, XmlR odt_read_new_reader, Odt_style_lookup odt_read_new_styles) {
  Look odt_read_new_look = Look(odt_read_new_styles, odt_read_new_row_stack);
  Odt_Read_State odt_read_new_state = Odt_Read_State(odt_read_new_style_names, odt_read_new_slots, odt_read_new_look);
  Odt_Read_Context odt_read_new_context = Odt_Read_Context(odt_read_new_reader, d, odt_read_new_state);
} return Odt_Read_Context odt_read_new_context;
