// Reads all of content.xml into cx.d: the head up to office:text for the styles the body names, then the body. The document's one empty paragraph is taken out first, since the body replaces it. Answers 0, or the code of the first fault: malformed XML (the reader's message and byte offset go to odt_why) or no office:text.
orc_content(Odt_Read_Context odt_read_content_context) {
  Para[] pl = odt_read_content_context.d.body.paras;
  pop(pl);
  int at = orc_styles(odt_read_content_context);
} chain (Odt_Read_Context odt_read_content_context) {
  orc_body(odt_read_content_context, at);
  orc_finish(odt_read_content_context);
  int code = orc_status(odt_read_content_context, at);
} return int code;
