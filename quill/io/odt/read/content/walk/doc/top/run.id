// The next event of the reader, remembering where the reader stood before it: an element that starts here begins at or after that byte.
orc_next(Odt_Read_Context odt_read_next_context) {
  int at = odt_read_reader_offset(odt_read_next_context.odt_read_xml_reader);
  integer_list_set(odt_read_next_context.cs.slots, (import orc_s_prev), at);
  int odt_read_next_event = xml_reader_next(odt_read_next_context.odt_read_xml_reader);
} return int odt_read_next_event;
