// What a read learns on its way: under the keys "auto:NAME" and "aend:NAME" (conf.id), where each automatic style element of content.xml starts and ends in the document; the counters named by the orc_s_* slots in conf.id; and what the style names mean.
struct Odt_Read_State {
  Names odt_read_automatic_styles;
  int[] slots;
  Look look;
}
