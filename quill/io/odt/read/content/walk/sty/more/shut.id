// An end tag of a direct child of office:automatic-styles: when an entry is waiting for its end, the end is the offset hi.
odt_read_automatic_close(Odt_Read_Context odt_read_automatic_close_context, int hi) {
  int k = odt_read_automatic_close_context.cs.slots[(import orc_s_aopen)];
  if(k > 0) {
    integer_list_set(odt_read_automatic_close_context.cs.odt_read_automatic_styles.odt_read_values, k - 1, hi);
    integer_list_set(odt_read_automatic_close_context.cs.slots, (import orc_s_aopen), 0);
  }
} return void;
