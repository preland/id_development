orc_zip_code(Zip odt_read_zip_code_archive) {
  int code = 0;
  int odt_read_zip_code_media_type_index = zip_reader_find(odt_read_zip_code_archive, "mimetype");
  int odt_read_zip_code_content_index = zip_reader_find(odt_read_zip_code_archive, "content.xml");
} chain (Zip odt_read_zip_code_archive) {
  if(zip_reader_ok(odt_read_zip_code_archive) == 0) {
    code = (import orc_e_zip);
    orc_why(zip_reader_why(odt_read_zip_code_archive));
  }
  if(code == 0 && odt_read_zip_code_content_index < 0) {
    code = (import orc_e_nocontent);
  }
  if(code == 0 && odt_read_zip_code_media_type_index >= 0) {
    code = orc_mime(odt_read_zip_code_archive, odt_read_zip_code_media_type_index);
  }
} return int code;
