// Reads the styles and then content.xml of a sound archive into the document: ost_load for what the style names mean, then the XML reader over the body, the read, and its code. A bad CRC on the way surfaces as the zip code.
orc_parse(Zip odt_read_parse_archive, Doc d) {
  int odt_read_parse_content_index = zip_reader_find(odt_read_parse_archive, "content.xml");
  int[] xs = zip_reader_read(odt_read_parse_archive, odt_read_parse_content_index);
  Odt_style_lookup odt_read_parse_styles = odt_style_lookup_new();
} chain (Zip odt_read_parse_archive, Doc d) {
  int code = orc_sty(odt_read_parse_archive, d, xs, odt_read_parse_styles);
  XmlR odt_read_parse_reader = xml_reader_open(xs);
  Odt_Read_Context odt_read_parse_context = orc_new(d, odt_read_parse_reader, odt_read_parse_styles);
} chain (Zip odt_read_parse_archive, Doc d) {
  if(code == 0) {
    code = orc_content(odt_read_parse_context);
  }
  if(zip_reader_ok(odt_read_parse_archive) == 0) {
    code = (import orc_e_zip);
    orc_why(zip_reader_why(odt_read_parse_archive));
  }
} return int code;
