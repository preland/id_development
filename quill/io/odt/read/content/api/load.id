// What a code of odt_load or odt_load_bytes means, with where it went wrong in brackets when the code carries a detail: the reason the archive is bad, the XML fault and its byte offset, the mimetype found, the path that would not open.
odt_error(int code) {
  string[] msgs = (import orc_errors);
  string msg = "ODT: unknown error code " + code;
  int known = code >= 0 && code < len(msgs);
} chain (int code) {
  if(known == 1) {
    msg = msgs[code];
  }
  if(code == 1 || code == 2 || code == 3 || code == 5) {
    msg = msg + " [" + (import odt_why) + "]";
  }
  string styled = ost_error(code);
} chain (int code) {
  if(code == (import ost_e_styles) || code == (import ost_e_content)) {
    msg = "ODT: " + styled + " [" + (import odt_why) + "]";
  }
  if(code >= 100) {
    msg = odw_error(code);
  }
} return string msg;
