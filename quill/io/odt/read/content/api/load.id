// Fills the empty document d, made by doc_new, from the ODT file at path. 0 on success; otherwise a code that odt_error turns into a message that names the fix.
odt_load(string path, Doc d) {
  int[] xs = orc_file_bytes(path);
  int code = (import orc_e_file);
  if(len(xs) > 0) {
    code = odt_load_bytes(xs, d);
  }
} chain (string path, Doc d) {
  if(len(xs) == 0) {
    orc_why(path);
  }
} return int code;
