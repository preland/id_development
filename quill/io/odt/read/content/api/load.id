// What a code of odt_load or odt_load_bytes means, with where it went wrong in brackets when the code carries a detail: the reason the archive is bad, the XML fault and its byte offset, the mimetype found, the path that would not open.
odt_error(int code) {
  string[] odt_read_error_messages = (import orc_errors);
  string odt_read_error_message = "ODT: unknown error code " + code;
  int known = code >= 0 && code < len(odt_read_error_messages);
} chain (int code) {
  if(known == 1) {
    odt_read_error_message = odt_read_error_messages[code];
  }
  if(code == 1 || code == 2 || code == 3 || code == 5) {
    odt_read_error_message = odt_read_error_message + " [" + (import odt_why) + "]";
  }
  string styled = odt_style_error_message(code);
} chain (int code) {
  if(code == (import ost_e_styles) || code == (import ost_e_content)) {
    odt_read_error_message = "ODT: " + styled + " [" + (import odt_why) + "]";
  }
  if(code >= 100) {
    odt_read_error_message = odt_package_save_message(code);
  }
} return string odt_read_error_message;
