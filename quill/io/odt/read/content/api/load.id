    code = orc_parse(odt_read_bytes_archive, d);
  }
  if(code == 0) {
    orc_keep(odt_read_bytes_archive, d);
  }
  if(code == 0 && zip_reader_ok(odt_read_bytes_archive) == 0) {
    code = (import orc_e_zip);
    orc_why(zip_reader_why(odt_read_bytes_archive));
  }
} return int code;
