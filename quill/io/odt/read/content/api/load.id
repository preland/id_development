// The same from the bytes of the archive, one per cell. The zip is checked first (every entry read has its CRC verified), then the mimetype, then content.xml is read into the body, and last the entries the model does not know are kept as file parts.
odt_load_bytes(int[] zip, Doc d) {
  orc_why("");
  Zip z = zr_open(zip);
  int code = orc_zip_code(z);
} chain (int[] zip, Doc d) {
  if(code == 0) {
    code = orc_parse(z, d);
  }
  if(code == 0) {
    orc_keep(z, d);
  }
  if(code == 0 && zr_ok(z) == 0) {
    code = (import orc_e_zip);
    orc_why(zr_why(z));
  }
} return int code;
