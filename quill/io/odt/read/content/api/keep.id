// Keeps every zip entry the model does not read itself (pictures, thumbnails, settings, the empty directories) as a file part, in archive order, so a save can store it again.
orc_keep(Zip odt_read_keep_archive, Doc d) {
  int i = 0;
  while(i < zip_reader_count(odt_read_keep_archive)) {
    orc_keep_one(odt_read_keep_archive, d, i);
    i = i + 1;
  }
} return void;
given odt_read_fixture_make_archive("<a/>", "x") ((import odt_read_fixture_archive), (import odt_read_fixture_document)):() then odt_read_fixture_show:("P0  0:0:-1, {0,0,0,0,0} |  | Pictures/a.png:1:3,")
given odt_read_fixture_make_archive("", "") ((import odt_read_fixture_archive), (import odt_read_fixture_document)):() then odt_read_fixture_show:("P0  0:0:-1, {0,0,0,0,0} |  | Pictures/a.png:1:3,")

// Entry i of the archive, kept as a file part unless the model reads it itself.
orc_keep_one(Zip odt_read_keep_one_archive, Doc d, int i) {
  string name = zip_reader_name(odt_read_keep_one_archive, i);
  int[] xs = [];
  if(orc_known(name) == 0) {
    xs = zip_reader_read(odt_read_keep_one_archive, i);
    Part odt_read_keep_one_part = Part(name, xs, (import orc_part_file));
    push(d.ext.parts, odt_read_keep_one_part);
  }
} return void;
