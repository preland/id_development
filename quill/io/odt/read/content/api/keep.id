// Keeps every zip entry the model does not read itself (pictures, thumbnails, settings, the empty directories) as a file part, in archive order, so a save can store it again.
orc_keep(Zip z, Doc d) {
  int i = 0;
  while(i < zr_count(z)) {
    orc_keep_one(z, d, i);
    i = i + 1;
  }
} return void;
given orc_t_zip("<a/>", "x") ((import orc_tzo), (import orc_td)):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | Pictures/a.png:1:3,")
given orc_t_zip("", "") ((import orc_tzo), (import orc_td)):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | Pictures/a.png:1:3,")

// Entry i of the archive, kept as a file part unless the model reads it itself.
orc_keep_one(Zip z, Doc d, int i) {
  string name = zr_name(z, i);
  int[] xs = [];
  if(orc_known(name) == 0) {
    xs = zr_read(z, i);
    Part pt = Part(name, xs, (import orc_part_file));
    push(d.ext.parts, pt);
  }
} return void;
given orc_t_zip("<a/>", "x") ((import orc_tzo), (import orc_td), 0):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | ")
given orc_t_zip("<a/>", "x") ((import orc_tzo), (import orc_td), 2):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | Pictures/a.png:1:3,")
given orc_t_zip("<a/>", "x") ((import orc_tzo), (import orc_td), 1):() then orc_t_show:("P0  0:0:-1, {0,0,0,0,0} |  | ")

// 1 when the model reads or writes the zip entry itself: mimetype, the manifest, content, styles and meta.
orc_known(string name) {
  int known = list_string_index((import orc_entries), name) >= 0;
} return int known;
("content.xml"):(1)
("META-INF/manifest.xml"):(1)
("Pictures/a.png"):(0)
("Configurations2/"):(0)
