// Test fixture: the archive of orc_tz opened as a Zip, kept in the export orc_tzo.
odt_read_fixture_open_archive() {
  export Zip odt_read_fixture_archive = zip_reader_open(bytes_of_integer_list((import odt_read_fixture_archive_bytes)));
} return void;
given odt_read_fixture_make_archive("<a/>", "") ():() then odt_read_fixture_entry_count:(2)
given odt_read_fixture_make_archive("<a/>", "x") ():() then odt_read_fixture_entry_count:(3)

// Test fixture: writes the archive of orc_tz to a scratch file, orc_tp, which the case removes with `then orc_t_gone`.
odt_read_fixture_save_archive() {
  odt_read_fixture_make_file("");
  int h = fs_open((import odt_read_fixture_scratch_path), "w");
  int n = fs_write(h, (import odt_read_fixture_archive_bytes), len((import odt_read_fixture_archive_bytes)));
} chain () {
  int odt_read_fixture_save_close_status = fs_close(h);
} return void;
given odt_read_fixture_make_archive("<a/>", "") ():() then odt_read_fixture_remove_file:(0)
given odt_read_fixture_make_archive("<a/>", "x") ():() then odt_read_fixture_remove_file:(0)

// Test fixture: flips the low bit of byte at of the archive of orc_tz, which breaks the CRC of the entry that byte is in.
odt_read_fixture_flip_bit(int at) {
  integer_list_set((import odt_read_fixture_archive_bytes), at, (import odt_read_fixture_archive_bytes)[at] ^ 1);
  odt_read_fixture_open_archive();
} return void;
given odt_read_fixture_make_archive("<a/>", "") (41):() then odt_read_fixture_checksum_ok:(0)
given odt_read_fixture_make_archive("<a/>", "") (89):() then odt_read_fixture_checksum_ok:(1)
