// Test fixture: a scratch file holding text, named by fs_mktemp so two builds never share it, for the cases of the functions that read a file by path. The case removes it with `then orc_t_gone`.
orc_t_file(string text) {
  export string orc_tp = fs_mktemp("orc_odt_", 0);
  fs_drop_exit(orc_tp);
  int n = exec_file_put(orc_tp, text, 420);
} return void;
("abc"):() then orc_t_gone:(0)
(""):() then orc_t_gone:(0)

// Test fixture: removes the scratch file; fs_remove's answer, 0 when it was there.
orc_t_gone() {
  int gone = fs_remove((import orc_tp));
} return int gone;
given orc_t_file("x") ():(0)
given orc_t_file("yz") ():(0)

// Test fixture: 1 when entry content.xml of the archive of orc_tz reads with its CRC verified, 0 when it does not.
orc_t_crc() {
  Zip z = zr_open(bytes_of_int_list((import orc_tz)));
  int[] xs = zr_read(z, zr_find(z, "content.xml"));
  int ok = zr_ok(z);
} return int ok;
given orc_t_zip("<a/>", "") ():(1)
given orc_t_zip("<a/>", "") given orc_t_flip(41) ():(0)
