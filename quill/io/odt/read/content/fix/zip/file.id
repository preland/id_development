// Test fixture: a scratch file holding text, named by fs_mktemp so two builds never share it, for the cases of the functions that read a file by path. The case removes it with `then orc_t_gone`.
odt_read_fixture_make_file(string text) {
  export string odt_read_fixture_scratch_path = fs_mktemp("orc_odt_", 0);
  fs_drop_exit(odt_read_fixture_scratch_path);
  int n = exec_file_put(odt_read_fixture_scratch_path, text, 420);
} return void;
("abc"):() then odt_read_fixture_remove_file:(0)
(""):() then odt_read_fixture_remove_file:(0)

// Test fixture: removes the scratch file; fs_remove's answer, 0 when it was there.
odt_read_fixture_remove_file() {
  int gone = fs_remove((import odt_read_fixture_scratch_path));
} return int gone;
given odt_read_fixture_make_file("x") ():(0)
given odt_read_fixture_make_file("yz") ():(0)

// Test fixture: 1 when entry content.xml of the archive of orc_tz reads with its CRC verified, 0 when it does not.
odt_read_fixture_checksum_ok() {
  Zip odt_read_fixture_checksum_archive = zip_reader_open(bytes_of_int_list((import odt_read_fixture_archive_bytes)));
  int[] xs = zip_reader_read(odt_read_fixture_checksum_archive, zip_reader_find(odt_read_fixture_checksum_archive, "content.xml"));
  int ok = zip_reader_ok(odt_read_fixture_checksum_archive);
} return int ok;
