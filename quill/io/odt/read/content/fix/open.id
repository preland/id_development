// Test fixture: a new document orc_td and an XML reader orc_tr over the XML in xml, and a read of them, orc_tc, so a case can `given` it, run the function under test on it and read the result back with orc_t_show or `then (import orc_tc).cs.slots`.
odt_read_fixture_open(string xml) {
  int[] data = exec_bytes(xml);
  XmlR odt_read_fixture_open_reader = xml_reader_open(data);
  Doc d = doc_new();
} chain (string xml) {
  Odt_style_lookup odt_read_fixture_open_styles = odt_style_lookup_new();
  int[] none = [];
  int code = odt_style_load(d, none, data, odt_read_fixture_open_styles);
} chain (string xml) {
  export XmlR odt_read_fixture_xml_reader = odt_read_fixture_open_reader;
  export Doc odt_read_fixture_document = d;
  export Odt_Read_Context odt_read_fixture_context = orc_new(d, odt_read_fixture_open_reader, odt_read_fixture_open_styles);
} return void export odt_read_fixture_context;
("<a/>"):() then odt_read_fixture_show:("P0  0:0:-1, {0,0,0,0,0} |  | ")
("<a>b</a>"):() then (import odt_read_fixture_context).cs.slots:([0, 0, 0, 0, 0, 0, 0, 0])

// Test fixture: every paragraph of the document of orc_tc as a line (its paragraph row, its code points and its runs), then " | ", the hyperlink targets, " | ", and the kept parts.
odt_read_fixture_show() {
  Odt_Read_Context odt_read_fixture_show_context = (import odt_read_fixture_context);
  string[] pieces = [];
  int i = 0;
} chain () {
  while(i < len(odt_read_fixture_show_context.d.body.paras)) {
    push(pieces, para_dump(odt_read_fixture_show_context.d.body.paras[i]) + " {" + odt_read_fixture_paragraph_fields(odt_read_fixture_show_context, odt_read_fixture_show_context.d.body.paras[i].pprop) + "}");
    i = i + 1;
  }
  string text = string_join(pieces, "\n") + " | " + string_join(odt_read_fixture_show_context.d.ext.links, ",") + " | " + odt_read_fixture_parts_text(odt_read_fixture_show_context.d.ext.parts);
} return string text;
given odt_read_fixture_open("<a/>") ():("P0  0:0:-1, {0,0,0,0,0} |  | ")
given odt_read_fixture_open("<a/>") given odt_read_fixture_remove_paragraph ():(" |  | ")

// Test fixture: the kept parts as name:kind:content, comma separated, where the content is the XML of an element and the size of a file.
odt_read_fixture_parts_text(Part[] odt_read_fixture_parts_list) {
  string text = "";
  int i = 0;
  while(i < len(odt_read_fixture_parts_list)) {
    text = text + odt_read_fixture_parts_list[i].name + ":" + odt_read_fixture_parts_list[i].kind + ":" + odt_read_fixture_part_content(odt_read_fixture_parts_list[i]) + ",";
    i = i + 1;
  }
} return string text;
([]):("")
([Part("a", [1, 2], 1), Part("b", [60, 98, 47, 62], 0)]):("a:1:2,b:0:<b/>,")
