// Test fixture: adds a paragraph style called name to the document of orc_tc, as a style a file brings.
odt_read_fixture_add_style(string name) {
  Odt_Read_Context odt_read_fixture_style_context = (import odt_read_fixture_context);
  Style st = Style(name, [0, -1, 0], [0, 0]);
  push(odt_read_fixture_style_context.d.fmt.sty.styles, st);
} return void;
given odt_read_fixture_open("<a/>") ("X Y"):() then len((import odt_read_fixture_context).d.fmt.sty.styles):(9)
given odt_read_fixture_open("<a/>") ("Z"):() then len((import odt_read_fixture_context).d.fmt.sty.styles):(9)

