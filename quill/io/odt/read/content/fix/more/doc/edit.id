// Test fixture: takes the last paragraph out of the document of orc_tc, as the body read does with the new document's one empty paragraph before it starts.
odt_read_fixture_remove_paragraph() {
  Odt_Read_Context odt_read_fixture_pop_context = (import odt_read_fixture_context);
  Para[] pl = odt_read_fixture_pop_context.d.body.paras;
  pop(pl);
} return void;
given odt_read_fixture_open("<a/>") ():() then odt_read_fixture_show:(" |  | ")
given odt_read_fixture_open("<a/>") ():() then (import odt_read_fixture_context).cs.slots:([0, 0, 0, 0, 0, 0, 0, 0])

// Test fixture: sets slot k of the read counters of orc_tc to val.
odt_read_fixture_set_slot(int k, int val) {
  Odt_Read_Context odt_read_fixture_set_context = (import odt_read_fixture_context);
  integer_list_set(odt_read_fixture_set_context.cs.slots, k, val);
} return void;
given odt_read_fixture_open("<a/>") (1, 5):() then (import odt_read_fixture_context).cs.slots:([0, 5, 0, 0, 0, 0, 0, 0])
given odt_read_fixture_open("<a/>") (5, -1):() then (import odt_read_fixture_context).cs.slots:([0, 0, 0, 0, 0, -1, 0, 0])

// Test fixture: reads all of the XML of orc_tc into the document of orc_td, as a load does, whatever the outcome.
odt_read_fixture_read_content() {
  Odt_Read_Context odt_read_fixture_load_context = (import odt_read_fixture_context);
  int code = orc_content(odt_read_fixture_load_context);
} return void;
given odt_read_fixture_open("<r><office:text><text:p>Hi</text:p></office:text></r>") ():() then odt_read_fixture_show:("P0 72,105, 2:0:-1, {0,0,0,0,0} |  | ")
given odt_read_fixture_open("<r/>") ():() then odt_read_fixture_show:("P0  0:0:-1, {0,0,0,0,0} |  | ")
