// Test fixture: a table of names as name:value, comma separated.
orc_t_pairs(Names nm) {
  string text = "";
  int i = 0;
  while(i < len(nm.keys)) {
    text = text + nm.keys[i] + ":" + nm.vals[i] + ",";
    i = i + 1;
  }
} return string text;
