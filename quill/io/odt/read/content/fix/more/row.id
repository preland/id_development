// Test fixture: a table of names as name:value, comma separated.
odt_read_fixture_name_pairs(Names odt_read_fixture_pairs_names) {
  string text = "";
  int i = 0;
  while(i < len(odt_read_fixture_pairs_names.keys)) {
    text = text + odt_read_fixture_pairs_names.keys[i] + ":" + odt_read_fixture_pairs_names.odt_read_values[i] + ",";
    i = i + 1;
  }
} return string text;
