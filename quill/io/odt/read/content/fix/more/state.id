// Test fixture: reads n events of orc_tc and leaves the reader after them.
odt_read_fixture_step_events(int n) {
  Odt_Read_Context odt_read_fixture_steps_context = (import odt_read_fixture_context);
  int i = 0;
  while(i < n) {
    orc_next(odt_read_fixture_steps_context);
    i = i + 1;
  }
} return void;
given odt_read_fixture_open("<a>x</a>") (1):() then (import odt_read_fixture_context).cs.slots:([0, 0, 0, 0, 0, 0, 0, 0])
given odt_read_fixture_open("<a>x</a>") (3):() then (import odt_read_fixture_context).cs.slots:([0, 0, 0, 0, 4, 0, 0, 0])

// Test fixture: what a kept part holds, as a case reads it: the XML itself for an element, the number of bytes for a file.
odt_read_fixture_part_content(Part odt_read_fixture_what_part) {
  string what = "" + len(odt_read_fixture_what_part.data);
  if(odt_read_fixture_what_part.kind == 0) {
    what = exec_text(odt_read_fixture_what_part.data);
  }
} return string what;
