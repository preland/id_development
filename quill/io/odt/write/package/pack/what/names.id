// Adds the name of a preserved part to a list when it is kept.
odp_note(string[] odt_package_note_names, Part odt_package_note_part) {
  if(odp_keep(odt_package_note_part) == 1) {
    push(odt_package_note_names, odt_package_note_part.name);
  }
} return void;
(["a"], Part("Pictures/b.png", [], 1)):(["a", "Pictures/b.png"], Part("Pictures/b.png", [], 1))
([], Part("Pictures/c.png", [], 1)):(["Pictures/c.png"], Part("Pictures/c.png", [], 1))
(["a"], Part("meta.xml", [], 1)):(["a"], Part("meta.xml", [], 1))

// The names of the entries the manifest lists, in the order they are written: content.xml, styles.xml and meta.xml, then each kept part.
odp_names(Ext odt_package_names_references) {
  string[] odt_package_names_list = ["content.xml", "styles.xml", "meta.xml"];
  int odt_package_names_index = 0;
  while(odt_package_names_index < len(odt_package_names_references.parts)) {
    odp_note(odt_package_names_list, odt_package_names_references.parts[odt_package_names_index]);
    odt_package_names_index = odt_package_names_index + 1;
  }
} return string[] odt_package_names_list;
(Ext(["f"], [], [Part("Pictures/b.png", [], 1), Part("x", [], 0)])):(["content.xml", "styles.xml", "meta.xml", "Pictures/b.png"])
(Ext(["f"], [], [])):(["content.xml", "styles.xml", "meta.xml"])

// The media type of each name.
odp_types(string[] odt_package_types_names) {
  string[] odt_package_types_list = [];
  int odt_package_types_index = 0;
  while(odt_package_types_index < len(odt_package_types_names)) {
    push(odt_package_types_list, odp_media(odt_package_types_names[odt_package_types_index]));
    odt_package_types_index = odt_package_types_index + 1;
  }
} return string[] odt_package_types_list;
(["content.xml", "a.png", "d/"]):(["text/xml", "image/png", ""])
(["d/", "b.png"]):(["", "image/png"])
([]):([])
