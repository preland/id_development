  Zip odt_package_checksum_reader = zip_reader_open(odt_package_checksum_bytes);
  int odt_package_checksum_index = 0;
} chain () {
  while(odt_package_checksum_index < zip_reader_count(odt_package_checksum_reader)) {
    int[] odt_package_checksum_content = zip_reader_read(odt_package_checksum_reader, odt_package_checksum_index);
    odt_package_checksum_index = odt_package_checksum_index + 1;
  }
  int odt_package_checksum_status = zip_reader_ok(odt_package_checksum_reader);
} return int odt_package_checksum_status;
