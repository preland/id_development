// Test fixture (internal): 1 when our reader opens the exported archive and reads every entry with its size and CRC-32 matching, 0 otherwise.
odp_t_crc() {
  bytes pkzb = bytes_of_int_list(zw_finish((import odp_t_z)));
  Zip pkzr = zr_open(pkzb);
  int pki = 0;
} chain () {
  while(pki < zr_count(pkzr)) {
    int[] pkrd = zr_read(pkzr, pki);
    pki = pki + 1;
  }
  int pkq = zr_ok(pkzr);
} return int pkq;
