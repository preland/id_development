// Test fixture (internal): how many entries of the archive, other than mimetype and the manifest itself, the manifest text does not give a manifest:full-path.
odp_t_unlisted(Zip pkzr, string pkmf) {
  int pki = 0;
  int pkn = 0;
  while(pki < zr_count(pkzr)) {
    pkn = pkn + odp_t_miss(pkzr, pki, pkmf);
    pki = pki + 1;
  }
} return int pkn;
