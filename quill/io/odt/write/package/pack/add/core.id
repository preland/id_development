// Adds a finished XML part as a stored entry; when the writer holds no document, because an element was left open, the archive records the failure instead.
odp_put(ZipW odt_package_put_archive, string odt_package_put_name, XmlW odt_package_put_writer) {
  int[] odt_package_put_bytes = xml_writer_finish(odt_package_put_writer);
  if(len(odt_package_put_bytes) > 0) {
    zip_writer_add(odt_package_put_archive, odt_package_put_name, odt_package_put_bytes, 0);
  }
  if(len(odt_package_put_bytes) == 0) {
    odp_fail(odt_package_put_archive, odt_package_put_name, xml_writer_error(odt_package_put_writer));
  }
} return void;
