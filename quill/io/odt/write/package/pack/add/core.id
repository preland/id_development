// Adds the three files this writer makes besides the manifest: content.xml as the caller built it, then styles.xml and meta.xml, all stored.
odp_core(ZipW odt_package_core_archive, Doc odt_package_core_document, int[] odt_package_core_content) {
  zip_writer_add(odt_package_core_archive, "content.xml", odt_package_core_content, 0);
  XmlW odt_package_core_writer = odp_doc();
  odp_styles(odt_package_core_writer, odt_package_core_document);
} chain (ZipW odt_package_core_archive, Doc odt_package_core_document, int[] odt_package_core_content) {
  odp_put(odt_package_core_archive, "styles.xml", odt_package_core_writer);
  odt_package_core_writer = odp_doc();
  odp_meta(odt_package_core_writer, (import odp_generator));
} chain (ZipW odt_package_core_archive, Doc odt_package_core_document, int[] odt_package_core_content) {
  odp_put(odt_package_core_archive, "meta.xml", odt_package_core_writer);
} return void;
