// Records that a part could not be written on the archive itself, as a refused entry would be, so that zw_ok is 0 and zw_finish gives []; the first failure is kept.
odp_fail(ZipW odt_package_fail_archive, string odt_package_fail_name, string odt_package_fail_reason) {
  string[] odt_package_fail_names = odt_package_fail_archive.names;
  if(len(odt_package_fail_names[0]) == 0) {
    odt_package_fail_names[0] = "odt: " + odt_package_fail_name + " could not be written (" + odt_package_fail_reason + "); this is a fault in the ODT writer, so report it with the document that caused it";
  }
} return void;
