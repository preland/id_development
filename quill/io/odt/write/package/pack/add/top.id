// Adds META-INF/manifest.xml, which lists every entry written after it except itself.
odp_mf(ZipW pkz, Ext pkx) {
  string[] pknames = odp_names(pkx);
  string[] pktypes = odp_types(pknames);
  XmlW pkw = odp_doc();
} chain (ZipW pkz, Ext pkx) {
  odp_manifest(pkw, pknames, pktypes);
  odp_put(pkz, "META-INF/manifest.xml", pkw);
} return void;
given odp_t_new ((import odp_t_z), (import odp_t_x)):() then (import odp_t_z).names:(["", "META-INF/manifest.xml"])
given odp_t_new given zw_add((import odp_t_z), "x", [1], 0) ((import odp_t_z), (import odp_t_x)):() then (import odp_t_z).names:(["", "x", "META-INF/manifest.xml"])

// Fills an empty archive with the package of the document: mimetype first and stored, then META-INF/manifest.xml, content.xml (the caller's bytes), styles.xml, meta.xml and the preserved parts. Entries are all stored; zw_why on the archive says if one was refused.
odp_pack(Doc pkd, int[] pkc, ZipW pkz) {
  zw_mimetype(pkz, (import odp_mime));
  odp_mf(pkz, pkd.ext);
  odp_core(pkz, pkd, pkc);
} chain (Doc pkd, int[] pkc, ZipW pkz) {
  odp_parts(pkz, pkd.ext);
} return void;
