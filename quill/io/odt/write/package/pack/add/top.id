// Adds META-INF/manifest.xml, which lists every entry written after it except itself.
odt_package_add_manifest(ZipW odt_package_attach_archive, Ext odt_package_attach_references) {
  string[] odt_package_attach_names = odp_names(odt_package_attach_references);
  string[] odt_package_attach_types = odp_types(odt_package_attach_names);
  XmlW odt_package_attach_writer = odp_doc();
} chain (ZipW odt_package_attach_archive, Ext odt_package_attach_references) {
  odp_manifest(odt_package_attach_writer, odt_package_attach_names, odt_package_attach_types);
  odp_put(odt_package_attach_archive, "META-INF/manifest.xml", odt_package_attach_writer);
} return void;
