// Fills an empty archive with the package of the document: mimetype first and stored, then META-INF/manifest.xml, content.xml (the caller's bytes), styles.xml, meta.xml and the preserved parts. Entries are all stored; zw_why on the archive says if one was refused.
odp_pack(Doc odt_package_pack_document, int[] odt_package_pack_content, ZipW odt_package_pack_archive) {
  zw_mimetype(odt_package_pack_archive, (import odp_mime));
  odt_package_add_manifest(odt_package_pack_archive, odt_package_pack_document.ext);
  odp_core(odt_package_pack_archive, odt_package_pack_document, odt_package_pack_content);
} chain (Doc odt_package_pack_document, int[] odt_package_pack_content, ZipW odt_package_pack_archive) {
  odp_parts(odt_package_pack_archive, odt_package_pack_document.ext);
} return void;
