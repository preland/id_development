// What a save code means, with its detail in brackets: 100 the document holds something that cannot be written, 101 the package could not be assembled, 102 the file could not be written. Codes 1 to 99 belong to the reader.
odt_package_save_message(int odt_package_message_code) {
  string odt_package_message_text = "ODT: unknown error code " + odt_package_message_code;
  int odt_package_message_index = odt_package_message_code - (import odw_e_check);
  if(odt_package_message_index >= 0 && odt_package_message_index < len((import odw_errors))) {
    odt_package_message_text = (import odw_errors)[odt_package_message_index] + " [" + (import odt_package_save_detail) + "]";
  }
} return string odt_package_message_text;
