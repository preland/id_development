// Writes the bytes to the file at the path; 0 when all of them reached it, otherwise 102 with the path as the detail.
odt_package_write_file(string odt_package_write_path, int[] odt_package_write_bytes) {
  int odt_package_write_handle = fs_open(odt_package_write_path, "w");
  int odt_package_write_status = (import odw_e_file);
  int odt_package_write_count = 0;
} chain (string odt_package_write_path, int[] odt_package_write_bytes) {
  if(odt_package_write_handle >= 0) {
    odt_package_write_count = fs_write(odt_package_write_handle, odt_package_write_bytes, len(odt_package_write_bytes));
    odt_package_write_status = fs_close(odt_package_write_handle);
  }
  if(odt_package_write_status == 0 && odt_package_write_count == len(odt_package_write_bytes)) {
    odt_package_save_note(0, "");
  } else {
    odt_package_write_status = (import odw_e_file);
    odt_package_save_note(odt_package_write_status, odt_package_write_path);
  }
} return int odt_package_write_status;
