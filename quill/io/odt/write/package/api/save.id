// The bytes of the .odt file of a document: the checked content, then the package around it. [] when the document cannot be written or the archive refused an entry; odw_code and odt_error then say why.
odt_save_bytes(Doc odt_package_bytes_document) {
  odt_package_save_note(0, "");
  string odt_package_bytes_reason = odt_content_check(odt_package_bytes_document);
  ZipW odt_package_bytes_archive = zip_writer_new();
} chain (Doc odt_package_bytes_document) {
  if(len(odt_package_bytes_reason) == 0) {
    odp_pack(odt_package_bytes_document, odt_content_bytes(odt_package_bytes_document), odt_package_bytes_archive);
  }
  if(len(odt_package_bytes_reason) > 0) {
    odt_package_save_note((import odw_e_check), odt_package_bytes_reason);
  }
  int[] odt_package_bytes_result = odt_package_seal_archive(odt_package_bytes_archive, odt_package_bytes_reason);
} return int[] odt_package_bytes_result;
