// The archive's bytes when the document could be written (pkwhy is ""), otherwise []; a refused entry is noted with the archive's own reason.
odt_package_seal_archive(ZipW odt_package_seal_target, string odt_package_seal_reason) {
  int[] odt_package_seal_bytes = [];
  if(len(odt_package_seal_reason) == 0) {
    odt_package_seal_bytes = zip_writer_finish(odt_package_seal_target);
  }
  if(len(odt_package_seal_bytes) == 0 && len(odt_package_seal_reason) == 0) {
    odt_package_save_note((import odw_e_zip), zip_writer_failure_reason(odt_package_seal_target));
  }
} return int[] odt_package_seal_bytes;
