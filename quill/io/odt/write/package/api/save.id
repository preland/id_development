// Writes the document to the .odt file at the path. 0 on success, otherwise a code of 100 or more that odt_error turns into a message.
odt_save(string odt_package_save_path, Doc odt_package_save_document) {
  int[] odt_package_save_content = odt_save_bytes(odt_package_save_document);
  int odt_package_save_status = (import odt_package_save_code);
  if(len(odt_package_save_content) > 0) {
    odt_package_save_status = odt_package_write_file(odt_package_save_path, odt_package_save_content);
  }
} return int odt_package_save_status;
