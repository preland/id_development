// Test fixture (internal): the entry names, comma separated, of the zip in the scratch file once every entry has been read with its size and CRC-32 checked; "bad: " and the reader's reason when anything is wrong.
odt_package_fixture_entry_names() {
  bytes odt_package_entries_bytes = bytes_of_int_list(odt_package_fixture_scratch_bytes());
  Zip odt_package_entries_reader = zip_reader_open(odt_package_entries_bytes);
  int odt_package_entries_index = 0;
} chain () {
  while(odt_package_entries_index < zip_reader_count(odt_package_entries_reader)) {
    int[] odt_package_entries_content = zip_reader_read(odt_package_entries_reader, odt_package_entries_index);
    odt_package_entries_index = odt_package_entries_index + 1;
  }
  string[] odt_package_entries_names = list_string_tail(odt_package_entries_reader.names, 1);
  string odt_package_entries_result = str_join(odt_package_entries_names, ",");
} chain () {
  if(zip_reader_ok(odt_package_entries_reader) == 0) {
    odt_package_entries_result = "bad: " + zip_reader_why(odt_package_entries_reader);
  }
} return string odt_package_entries_result;
