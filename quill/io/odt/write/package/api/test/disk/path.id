// Test fixture (internal): a path for a scratch file, from fs_mktemp so that two builds never share it; the file exists and is empty.
odt_package_fixture_scratch_path() {
  export string odt_package_scratch_file = fs_mktemp("odw_odt_", 0);
  fs_drop_exit(odt_package_scratch_file);
} return void;
():() then odt_package_fixture_remove_scratch:("gone 0")
():() then odt_package_fixture_scratch_bytes:([])

// Test fixture (internal): removes the scratch file; 0 when it was there.
odt_package_fixture_remove_scratch() {
  string odt_package_gone_text = "gone " + (fs_remove((import odt_package_scratch_file)));
} return string odt_package_gone_text;
given odt_package_fixture_scratch_path ():("gone 0")
given odt_package_fixture_scratch_path given odt_package_fixture_put_byte ():("gone 0")

// Test fixture (internal): the bytes of the scratch file, one per cell; [] when it is missing or empty.
odt_package_fixture_scratch_bytes() {
  int odt_package_scratch_size = fs_size((import odt_package_scratch_file));
  int odt_package_scratch_handle = fs_open((import odt_package_scratch_file), "r");
  int[] odt_package_scratch_content = [];
} chain () {
  if(odt_package_scratch_size > 0 && odt_package_scratch_handle >= 0) {
    list_fill(odt_package_scratch_content, odt_package_scratch_size, 0);
    odt_package_scratch_size = fs_read(odt_package_scratch_handle, odt_package_scratch_content, odt_package_scratch_size);
  }
  odt_package_scratch_size = fs_close(odt_package_scratch_handle);
} return int[] odt_package_scratch_content;
given odt_package_fixture_scratch_path given odt_package_fixture_put_byte ():([97])
given odt_package_fixture_scratch_path ():([])
