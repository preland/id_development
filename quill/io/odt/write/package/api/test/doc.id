// Test fixture (internal): adds a preserved part with a zero byte and a 255 in it to a document's references.
odt_package_fixture_add_part(Ext odt_package_added_references, string odt_package_added_name) {
  Part odt_package_added_part = Part(odt_package_added_name, [137, 0, 255], 1);
  push(odt_package_added_references.parts, odt_package_added_part);
} return void;
