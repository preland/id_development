// Test fixture (internal): the default document, exported. Variant 1 holds a code point that stands for an object but names no part, which the content writer refuses; 2 holds two preserved parts of one name, which the archive refuses; 3 holds one preserved image; any other is the plain document.
odt_package_fixture_document(int odt_package_document_variant) {
  export Doc odt_package_exported_save_document = doc_new();
  if(odt_package_document_variant == 1) {
    text_insert(odt_package_exported_save_document.body.paras[0].txt, 0, [983040], 0);
  }
  if(odt_package_document_variant >= 2) {
    odt_package_fixture_add_part(odt_package_exported_save_document.ext, "Pictures/a.png");
  }
} chain (int odt_package_document_variant) {
  if(odt_package_document_variant == 2) {
    odt_package_fixture_add_part(odt_package_exported_save_document.ext, "Pictures/a.png");
  }
} return void;
