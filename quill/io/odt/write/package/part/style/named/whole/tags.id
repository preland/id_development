// Test fixture (internal): adds to pkns the name of the element that a piece of text opens, which is what comes before its first space, ">" or "/"; an end tag or plain text opens none.
odt_package_fixture_append_element_name(string[] odt_package_append_names, string odt_package_append_piece) {
  int odt_package_append_index = 0;
  while(odt_package_append_index < len(odt_package_append_piece) && character_code_at(odt_package_append_piece, odt_package_append_index) != 32 && character_code_at(odt_package_append_piece, odt_package_append_index) != 62 && character_code_at(odt_package_append_piece, odt_package_append_index) != 47) {
    odt_package_append_index = odt_package_append_index + 1;
  }
  string odt_package_append_element = str_sub(odt_package_append_piece, 0, odt_package_append_index);
} chain (string[] odt_package_append_names, string odt_package_append_piece) {
  if(len(odt_package_append_element) > 0) {
    push(odt_package_append_names, odt_package_append_element);
  }
} return void;
(["x"], "office:text a=\"b\">x"):(["x", "office:text"], "office:text a=\"b\">x")
(["x"], "p>t"):(["x", "p"], "p>t")
(["x"], "/office:text>"):(["x"], "/office:text>")

// Test fixture (internal): the element names of a list of pieces of text, in order.
odt_package_fixture_element_names(string[] odt_package_elements_pieces) {
  string[] odt_package_elements_names = [];
  int odt_package_elements_index = 0;
  while(odt_package_elements_index < len(odt_package_elements_pieces)) {
    odt_package_fixture_append_element_name(odt_package_elements_names, odt_package_elements_pieces[odt_package_elements_index]);
    odt_package_elements_index = odt_package_elements_index + 1;
  }
} chain (string[] odt_package_elements_pieces) {
  string odt_package_elements_result = str_join(odt_package_elements_names, " ");
} return string odt_package_elements_result;
(["", "a b", "/a>", "c>"]):("a c")
([]):("")

// Test fixture (internal): the names of the elements opened in what has been written to the exported writer so far, in order and separated by spaces.
odt_package_fixture_written_tags() {
  XmlW odt_package_tags_writer = (import odt_package_exported_writer);
  string[] odt_package_tags_pieces = str_split(exec_text(odt_package_tags_writer.out), "<");
  string odt_package_tags_result = odt_package_fixture_element_names(odt_package_tags_pieces);
} return string odt_package_tags_result;
given odt_package_fixture_new ():("r")
given odt_package_fixture_new given xw_start((import odt_package_exported_writer), "a") given xw_end((import odt_package_exported_writer)) ():("r a")
