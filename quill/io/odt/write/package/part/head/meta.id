// The meta:generator element naming the program that wrote the file.
odt_package_generator_element(XmlW odt_package_generator_writer, string odt_package_generator_name) {
  xw_start(odt_package_generator_writer, "meta:generator");
  xw_text(odt_package_generator_writer, odt_package_generator_name);
  xw_end(odt_package_generator_writer);
} return void;
