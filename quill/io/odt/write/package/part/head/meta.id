// The text of meta.xml: the document-meta root and the name of the program that wrote the file.
odp_meta(XmlW odt_package_meta_writer, string odt_package_meta_generator) {
  odp_root(odt_package_meta_writer, "office:document-meta");
  xw_start(odt_package_meta_writer, "office:meta");
  odt_package_generator_element(odt_package_meta_writer, odt_package_meta_generator);
} chain (XmlW odt_package_meta_writer, string odt_package_meta_generator) {
  xw_end(odt_package_meta_writer);
  xw_end(odt_package_meta_writer);
} return void;
