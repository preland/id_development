// Starts the root element of a part: its name, every namespace the writer knows and the ODF version.
odp_root(XmlW odt_package_root_writer, string odt_package_root_name) {
  xw_start(odt_package_root_writer, odt_package_root_name);
  odt_write_prefixes(odt_package_root_writer);
  xw_attr(odt_package_root_writer, "office:version", (import odp_version));
} return void;
