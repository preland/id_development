// Test fixture (internal): the start and the end of a long text with its length, which is enough to tell a root element from the namespaces and the version it carries; a short text is returned whole.
odt_package_fixture_trim_text(string odt_package_cut_text) {
  string odt_package_cut_result = odt_package_cut_text;
  if(len(odt_package_cut_text) > 150) {
    odt_package_cut_result = str_sub(odt_package_cut_text, 0, 40) + "|" + str_sub(odt_package_cut_text, len(odt_package_cut_text) - 110, 110) + "|" + len(odt_package_cut_text);
  }
} return string odt_package_cut_result;
