// META-INF/manifest.xml: the package root, then one entry for each name. The mimetype entry and the manifest itself are not listed, as in every file LibreOffice writes.
odp_manifest(XmlW odt_package_manifest_writer, string[] odt_package_manifest_names, string[] odt_package_manifest_types) {
  xw_start(odt_package_manifest_writer, "manifest:manifest");
  xw_attr(odt_package_manifest_writer, "xmlns:manifest", "urn:oasis:names:tc:opendocument:xmlns:manifest:1.0");
  xw_attr(odt_package_manifest_writer, "manifest:version", (import odp_version));
} chain (XmlW odt_package_manifest_writer, string[] odt_package_manifest_names, string[] odt_package_manifest_types) {
  odp_entry(odt_package_manifest_writer, "/", (import odp_mime), (import odp_version));
  odp_entries(odt_package_manifest_writer, odt_package_manifest_names, odt_package_manifest_types);
  xw_end(odt_package_manifest_writer);
} return void;
