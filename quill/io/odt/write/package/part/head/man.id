// One manifest:file-entry: the path in the archive, its media type and, for the package root only, the manifest version.
odp_entry(XmlW odt_package_entry_writer, string odt_package_entry_path, string odt_package_entry_type, string odt_package_entry_version) {
  xw_start(odt_package_entry_writer, "manifest:file-entry");
  xw_attr(odt_package_entry_writer, "manifest:full-path", odt_package_entry_path);
  if(len(odt_package_entry_version) > 0) {
    xw_attr(odt_package_entry_writer, "manifest:version", odt_package_entry_version);
  }
} chain (XmlW odt_package_entry_writer, string odt_package_entry_path, string odt_package_entry_type, string odt_package_entry_version) {
  xw_attr(odt_package_entry_writer, "manifest:media-type", odt_package_entry_type);
  xw_end(odt_package_entry_writer);
} return void;
