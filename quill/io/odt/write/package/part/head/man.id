// One file-entry for each name, with the media type at the same position.
odp_entries(XmlW odt_package_entries_writer, string[] odt_package_entries_name_list, string[] odt_package_entries_type_list) {
  int odt_package_entries_position = 0;
  while(odt_package_entries_position < len(odt_package_entries_name_list)) {
    odp_entry(odt_package_entries_writer, odt_package_entries_name_list[odt_package_entries_position], odt_package_entries_type_list[odt_package_entries_position], "");
    odt_package_entries_position = odt_package_entries_position + 1;
  }
} return void;
