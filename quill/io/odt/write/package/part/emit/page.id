// The page orientation attribute: portrait unless the orientation is 1.
odp_orient(XmlW pkw, int pkor) {
  string pkval = "portrait";
  if(pkor == 1) {
    pkval = "landscape";
  }
  xw_attr(pkw, "style:print-orientation", pkval);
} return void;
