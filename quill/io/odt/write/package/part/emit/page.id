// The style:page-layout-properties element: size, orientation and the four margins of the page, each length only when it is set.
odp_gprops(XmlW pkw, Page pkpg) {
  xw_start(pkw, "style:page-layout-properties");
  oc_a_len(pkw, "fo:page-width", pkpg.size[(import word_g_w)]);
  oc_a_len(pkw, "fo:page-height", pkpg.size[(import word_g_h)]);
} chain (XmlW pkw, Page pkpg) {
  odp_orient(pkw, pkpg.size[(import word_g_orient)]);
  oc_a_len(pkw, "fo:margin-top", pkpg.margin[(import word_g_top)]);
  oc_a_len(pkw, "fo:margin-bottom", pkpg.margin[(import word_g_bottom)]);
} chain (XmlW pkw, Page pkpg) {
  oc_a_len(pkw, "fo:margin-left", pkpg.margin[(import word_g_left)]);
  oc_a_len(pkw, "fo:margin-right", pkpg.margin[(import word_g_right)]);
  xw_end(pkw);
} return void;
