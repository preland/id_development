// The style:page-layout the master page uses, with the size, orientation and margins of the document's page.
odp_layout(XmlW pkw, Page pkpg) {
  xw_start(pkw, "style:page-layout");
  xw_attr(pkw, "style:name", (import odp_layout_name));
  odp_gprops(pkw, pkpg);
} chain (XmlW pkw, Page pkpg) {
  xw_end(pkw);
} return void;
