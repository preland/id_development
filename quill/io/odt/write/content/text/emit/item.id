// An element with no content, such as text:tab.
odt_write_empty_element(XmlW odt_write_empty_element_writer, string odt_write_empty_element_name) {
  xw_start(odt_write_empty_element_writer, odt_write_empty_element_name);
  xw_end(odt_write_empty_element_writer);
} return void;
