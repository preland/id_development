// Writes one text:s for the run of spaces that starts at i and stops at hi; answers how many spaces it covered.
odt_write_space_run(XmlW odt_write_space_run_writer, int[] odt_write_space_run_code_points, int odt_write_space_run_index, int odt_write_space_run_high) {
  int odt_write_space_run_count = 0;
  while(odt_write_space_run_index + odt_write_space_run_count < odt_write_space_run_high && odt_write_code_point_class(odt_write_space_run_code_points, odt_write_space_run_index + odt_write_space_run_count) == 2) {
    odt_write_space_run_count = odt_write_space_run_count + 1;
  }
  odt_write_space_element(odt_write_space_run_writer, odt_write_space_run_count);
} return int odt_write_space_run_count;
