// A text:s element standing for n spaces; the count is written only when it is more than one.
odt_write_space_element(XmlW odt_write_space_element_writer, int odt_write_space_element_count) {
  xw_start(odt_write_space_element_writer, "text:s");
  if(odt_write_space_element_count > 1) {
    xw_attr(odt_write_space_element_writer, "text:c", "" + odt_write_space_element_count);
  }
  xw_end(odt_write_space_element_writer);
} return void;
