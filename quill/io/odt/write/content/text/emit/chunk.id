// Writes the next piece of text starting at i, either the plain stretch up to the next special code point or that one code point, and answers where the next piece starts.
odt_write_chunk(XmlW odt_write_chunk_writer, Text odt_write_chunk_text, Ext odt_write_chunk_extras, int odt_write_chunk_low, int odt_write_chunk_high) {
  int odt_write_chunk_end = odt_write_plain_end(odt_write_chunk_text.cps, odt_write_chunk_low, odt_write_chunk_high);
  if(odt_write_chunk_end > odt_write_chunk_low) {
    xml_writer_text(odt_write_chunk_writer, document_text_string(odt_write_chunk_text, odt_write_chunk_low, odt_write_chunk_end));
  } else {
    odt_write_chunk_end = odt_write_special_code_point(odt_write_chunk_writer, odt_write_chunk_text.cps, odt_write_chunk_extras, odt_write_chunk_low, odt_write_chunk_high);
  }
} return int odt_write_chunk_end;
