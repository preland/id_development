// The first index from i, before hi, that is not plain text; hi when everything up to it is.
odt_write_plain_end(int[] odt_write_plain_end_code_points, int odt_write_plain_end_index, int odt_write_plain_end_high) {
  while(odt_write_plain_end_index < odt_write_plain_end_high && odt_write_code_point_class(odt_write_plain_end_code_points, odt_write_plain_end_index) < 2) {
    odt_write_plain_end_index = odt_write_plain_end_index + 1;
  }
} return int odt_write_plain_end_index;
