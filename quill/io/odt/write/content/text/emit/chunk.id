// The code points lo up to hi of a text as XML content: plain stretches as text, the rest as text:s, text:tab, text:line-break or an inline object.
odt_write_text_range(XmlW odt_write_text_range_writer, Text odt_write_text_range_text, Ext odt_write_text_range_extras, int odt_write_text_range_low, int odt_write_text_range_high) {
  while(odt_write_text_range_low < odt_write_text_range_high) {
    odt_write_text_range_low = odt_write_chunk(odt_write_text_range_writer, odt_write_text_range_text, odt_write_text_range_extras, odt_write_text_range_low, odt_write_text_range_high);
  }
} return void;
