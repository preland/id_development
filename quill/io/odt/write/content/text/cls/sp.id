// How the space at i is written: 1 as a literal space, which XML keeps only between two visible characters, else 2 as text:s.
oc_sp(int[] oc_cps, int oc_i) {
  int oc_pv = 0;
  int oc_nv = 0;
  if(oc_i > 0) {
    oc_pv = oc_ink(oc_cps[oc_i - 1]);
  }
} chain (int[] oc_cps, int oc_i) {
  if(oc_i + 1 < len(oc_cps)) {
    oc_nv = oc_ink(oc_cps[oc_i + 1]);
  }
  int oc_k = 2 - oc_pv * oc_nv;
} return int oc_k;
([97, 32, 98], 1):(1)
([97, 32, 32, 98], 1):(2)
([97, 32, 32, 98], 2):(2)
([32, 98], 0):(2)
([97, 32], 1):(2)
([97, 9, 32, 98], 2):(2)

// The class of the code point at i: oc_kind, except that a space is 1 or 2 by oc_sp.
oc_cls(int[] oc_cps, int oc_i) {
  int oc_cp = oc_cps[oc_i];
  int oc_cl = oc_kind(oc_cp);
  if(oc_cp == 32) {
    oc_cl = oc_sp(oc_cps, oc_i);
  }
} return int oc_cl;
([97, 32, 98], 1):(1)
([97, 32, 32], 1):(2)
([97, 9], 1):(3)
([97, 9], 0):(0)
