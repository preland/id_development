// How the space at i is written: 1 as a literal space, which XML keeps only between two visible characters, else 2 as text:s.
odt_write_space_kind(int[] odt_write_space_kind_code_points, int odt_write_space_kind_index) {
  int odt_write_space_kind_previous_visible = 0;
  int odt_write_space_kind_next_visible = 0;
  if(odt_write_space_kind_index > 0) {
    odt_write_space_kind_previous_visible = odt_write_code_point_visible(odt_write_space_kind_code_points[odt_write_space_kind_index - 1]);
  }
} chain (int[] odt_write_space_kind_code_points, int odt_write_space_kind_index) {
  if(odt_write_space_kind_index + 1 < len(odt_write_space_kind_code_points)) {
    odt_write_space_kind_next_visible = odt_write_code_point_visible(odt_write_space_kind_code_points[odt_write_space_kind_index + 1]);
  }
  int odt_write_space_kind_result = 2 - odt_write_space_kind_previous_visible * odt_write_space_kind_next_visible;
} return int odt_write_space_kind_result;
([97, 32, 98], 1):(1)
([97, 32, 32, 98], 1):(2)
([97, 32, 32, 98], 2):(2)
([32, 98], 0):(2)
([97, 32], 1):(2)
([97, 9, 32, 98], 2):(2)

// The class of the code point at i: oc_kind, except that a space is 1 or 2 by oc_sp.
odt_write_code_point_class(int[] odt_write_code_point_class_code_points, int odt_write_code_point_class_index) {
  int odt_write_code_point_class_code_point = odt_write_code_point_class_code_points[odt_write_code_point_class_index];
  int odt_write_code_point_class_result = odt_write_code_point_kind(odt_write_code_point_class_code_point);
  if(odt_write_code_point_class_code_point == 32) {
    odt_write_code_point_class_result = odt_write_space_kind(odt_write_code_point_class_code_points, odt_write_code_point_class_index);
  }
} return int odt_write_code_point_class_result;
([97, 32, 98], 1):(1)
([97, 32, 32], 1):(2)
([97, 9], 1):(3)
([97, 9], 0):(0)
