// What a code point is in the file: 0 text, 3 a tab, 4 a line break (10 or 11), 5 an object marker (quill_object_marker and up), 6 not allowed in XML (controls, surrogates, U+FFFE and U+FFFF) and so dropped. A space is 0 here; oc_sp decides how it is written.
oc_kind(int oc_cp) {
  int oc_k = 0;
  if(oc_cp < 32) {
    oc_k = 6;
  }
  if((oc_cp >= 55296 && oc_cp <= 57343) || oc_cp == 65534 || oc_cp == 65535) {
    oc_k = 6;
  }
} chain (int oc_cp) {
  if(oc_cp == 9) {
    oc_k = 3;
  }
  if(oc_cp == 10 || oc_cp == 11) {
    oc_k = 4;
  }
  if(oc_cp >= (import quill_object_marker)) {
    oc_k = 5;
  }
} return int oc_k;
