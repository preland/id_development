// Opens list levels, outermost first, until to levels are open.
odt_write_list_open_to(XmlW odt_write_list_open_to_writer, int[] odt_write_list_open_to_state, int odt_write_list_open_to_list, int odt_write_list_open_to_depth) {
  while(odt_write_list_open_to_state[0] < odt_write_list_open_to_depth) {
    odt_write_list_open_one(odt_write_list_open_to_writer, odt_write_list_open_to_list, odt_write_list_open_to_state[0]);
    odt_write_list_open_to_state[0] = odt_write_list_open_to_state[0] + 1;
  }
} return void;
