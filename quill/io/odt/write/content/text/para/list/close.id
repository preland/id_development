// Ends list items and their lists, innermost first, until only to levels are open; ls[0] counts the open levels.
odt_write_list_close_to(XmlW odt_write_list_close_to_writer, int[] odt_write_list_close_to_state, int odt_write_list_close_to_depth) {
  while(odt_write_list_close_to_state[0] > odt_write_list_close_to_depth) {
    xw_end(odt_write_list_close_to_writer);
    xw_end(odt_write_list_close_to_writer);
    odt_write_list_close_to_state[0] = odt_write_list_close_to_state[0] - 1;
  }
} return void;
