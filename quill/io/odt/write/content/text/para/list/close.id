// Opens one list level at depth: the text:list (the outermost carries the list style L<list>) and its first item.
odt_write_list_open_one(XmlW odt_write_list_open_one_writer, int odt_write_list_open_one_list, int odt_write_list_open_one_depth) {
  xw_start(odt_write_list_open_one_writer, "text:list");
  if(odt_write_list_open_one_depth == 0) {
    xw_attr(odt_write_list_open_one_writer, "text:style-name", "WL" + odt_write_list_open_one_list);
  }
  xw_start(odt_write_list_open_one_writer, "text:list-item");
} return void;
