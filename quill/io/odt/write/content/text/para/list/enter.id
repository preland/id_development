// Writes paragraph i, after getting the lists right for it; an opaque block is no list item and ends any open list.
oc_item(XmlW oc_w, Doc oc_d, int oc_i, int[] oc_ls) {
  int oc_kd = oc_pcell(oc_d, oc_i, (import word_p_kind));
  int oc_lst = oc_pcell(oc_d, oc_i, (import word_p_list)) * (oc_kd == 0);
  oc_enter(oc_w, oc_ls, oc_lst, oc_pcell(oc_d, oc_i, (import word_p_level)));
} chain (XmlW oc_w, Doc oc_d, int oc_i, int[] oc_ls) {
  if(oc_kd == 1) {
    oc_block(oc_w, oc_d, oc_i);
  } else {
    oc_para(oc_w, oc_d, oc_i);
  }
} return void;
