// Writes paragraph i, after getting the lists right for it; an opaque block is no list item and ends any open list.
odt_write_body_item(XmlW odt_write_body_item_writer, Doc odt_write_body_item_document, int odt_write_body_item_paragraph, int[] odt_write_body_item_state) {
  int odt_write_body_item_kind = odt_write_paragraph_cell(odt_write_body_item_document, odt_write_body_item_paragraph, (import quill_paragraph_kind));
  int odt_write_body_item_list = odt_write_paragraph_cell(odt_write_body_item_document, odt_write_body_item_paragraph, (import quill_paragraph_list)) * (odt_write_body_item_kind == 0);
  odt_write_list_enter(odt_write_body_item_writer, odt_write_body_item_state, odt_write_body_item_list, odt_write_paragraph_cell(odt_write_body_item_document, odt_write_body_item_paragraph, (import quill_paragraph_level)));
} chain (XmlW odt_write_body_item_writer, Doc odt_write_body_item_document, int odt_write_body_item_paragraph, int[] odt_write_body_item_state) {
  if(odt_write_body_item_kind == 1) {
    odt_write_block_part(odt_write_body_item_writer, odt_write_body_item_document, odt_write_body_item_paragraph);
  } else {
    odt_write_paragraph(odt_write_body_item_writer, odt_write_body_item_document, odt_write_body_item_paragraph);
  }
} return void;
