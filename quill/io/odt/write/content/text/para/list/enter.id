// One cell of the paragraph row that paragraph i uses.
oc_pcell(Doc oc_d, int oc_i, int oc_fd) {
  int oc_cv = tab_get(oc_d.fmt.paras, oc_d.body.paras[oc_i].pprop, oc_fd);
} return int oc_cv;
