// Gets the output ready for a paragraph of list `list` at `level` (0 for none): lists of another definition are closed, levels deeper than the paragraph's are closed, a new item starts at the paragraph's own level, and missing outer levels are opened. ls is [open levels, list definition now open].
oc_enter(XmlW oc_w, int[] oc_ls, int oc_list, int oc_lev) {
  int oc_to = 0;
  if(oc_list != 0) {
    oc_to = oc_lev + 1;
  }
  if(oc_ls[1] != oc_list) {
    oc_close_to(oc_w, oc_ls, 0);
    oc_ls[1] = oc_list;
  }
} chain (XmlW oc_w, int[] oc_ls, int oc_list, int oc_lev) {
  oc_close_to(oc_w, oc_ls, oc_to);
  if(oc_to > 0 && oc_ls[0] == oc_to) {
    xw_end(oc_w);
    xw_start(oc_w, "text:list-item");
  }
  oc_open_to(oc_w, oc_ls, oc_list, oc_to);
} return void;
