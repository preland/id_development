// Gets the output ready for a paragraph of list `list` at `level` (0 for none): lists of another definition are closed, levels deeper than the paragraph's are closed, a new item starts at the paragraph's own level, and missing outer levels are opened. ls is [open levels, list definition now open].
odt_write_list_enter(XmlW odt_write_list_enter_writer, int[] odt_write_list_enter_state, int odt_write_list_enter_list, int odt_write_list_enter_level) {
  int odt_write_list_enter_depth = 0;
  if(odt_write_list_enter_list != 0) {
    odt_write_list_enter_depth = odt_write_list_enter_level + 1;
  }
  if(odt_write_list_enter_state[1] != odt_write_list_enter_list) {
    odt_write_list_close_to(odt_write_list_enter_writer, odt_write_list_enter_state, 0);
    odt_write_list_enter_state[1] = odt_write_list_enter_list;
  }
} chain (XmlW odt_write_list_enter_writer, int[] odt_write_list_enter_state, int odt_write_list_enter_list, int odt_write_list_enter_level) {
  odt_write_list_close_to(odt_write_list_enter_writer, odt_write_list_enter_state, odt_write_list_enter_depth);
  if(odt_write_list_enter_depth > 0 && odt_write_list_enter_state[0] == odt_write_list_enter_depth) {
    xml_writer_end_element(odt_write_list_enter_writer);
    xml_writer_start_element(odt_write_list_enter_writer, "text:list-item");
  }
  odt_write_list_open_to(odt_write_list_enter_writer, odt_write_list_enter_state, odt_write_list_enter_list, odt_write_list_enter_depth);
} return void;
