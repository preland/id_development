// Writes run k of the paragraph when it is not empty; empty runs only carry the caret's properties and have nothing to write.
odt_write_run_step(XmlW odt_write_run_step_writer, Doc odt_write_run_step_document, Para odt_write_run_step_paragraph, int odt_write_run_step_run_index, int[] odt_write_run_step_state) {
  if(odt_write_run_step_paragraph.txt.runs[odt_write_run_step_run_index].len > 0) {
    odt_write_run_piece(odt_write_run_step_writer, odt_write_run_step_document, odt_write_run_step_paragraph.txt, odt_write_run_step_paragraph.txt.runs[odt_write_run_step_run_index], odt_write_run_step_state);
  }
} return void;
