// All the runs of a paragraph in order, with the hyperlinks and spans they call for.
odt_write_runs(XmlW odt_write_runs_writer, Doc odt_write_runs_document, Para odt_write_runs_paragraph) {
  int[] odt_write_runs_state = [0, -1];
  int odt_write_runs_run_index = 0;
  while(odt_write_runs_run_index < len(odt_write_runs_paragraph.txt.runs)) {
    odt_write_run_step(odt_write_runs_writer, odt_write_runs_document, odt_write_runs_paragraph, odt_write_runs_run_index, odt_write_runs_state);
    odt_write_runs_run_index = odt_write_runs_run_index + 1;
  }
} chain (XmlW odt_write_runs_writer, Doc odt_write_runs_document, Para odt_write_runs_paragraph) {
  odt_write_link_switch(odt_write_runs_writer, odt_write_runs_document, odt_write_runs_state[1], -1);
} return void;
