// All the runs of a paragraph in order, with the hyperlinks and spans they call for.
oc_runs(XmlW oc_w, Doc oc_d, Para oc_pa) {
  int[] oc_st = [0, -1];
  int oc_k = 0;
  while(oc_k < len(oc_pa.txt.runs)) {
    oc_step(oc_w, oc_d, oc_pa, oc_k, oc_st);
    oc_k = oc_k + 1;
  }
} chain (XmlW oc_w, Doc oc_d, Para oc_pa) {
  oc_link(oc_w, oc_d, oc_st[1], -1);
} return void;
