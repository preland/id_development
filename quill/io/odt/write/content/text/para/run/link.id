// Opens a text:a for hyperlink idx.
odt_write_link_open(XmlW odt_write_link_open_writer, Doc odt_write_link_open_document, int odt_write_link_open_index) {
  xw_start(odt_write_link_open_writer, "text:a");
  xw_attr(odt_write_link_open_writer, "xlink:type", "simple");
  xw_attr(odt_write_link_open_writer, "xlink:href", odt_write_link_target(odt_write_link_open_document.ext, odt_write_link_open_index));
} return void;
