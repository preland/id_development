// Moves from the hyperlink the last run was in (cur, -1 for none) to the one the next run is in: ends the old text:a and opens the new one when they differ. Answers the new one.
odt_write_link_switch(XmlW odt_write_link_switch_writer, Doc odt_write_link_switch_document, int odt_write_link_switch_current, int odt_write_link_switch_next) {
  if(odt_write_link_switch_current != odt_write_link_switch_next && odt_write_link_switch_current >= 0) {
    xw_end(odt_write_link_switch_writer);
  }
  if(odt_write_link_switch_current != odt_write_link_switch_next && odt_write_link_switch_next >= 0) {
    odt_write_link_open(odt_write_link_switch_writer, odt_write_link_switch_document, odt_write_link_switch_next);
  }
} return int odt_write_link_switch_next;
