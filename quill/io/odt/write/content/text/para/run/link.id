// The target of hyperlink idx, or nothing for an index that names no link.
odt_write_link_target(Ext odt_write_link_target_extras, int odt_write_link_target_index) {
  string odt_write_link_target_result = "";
  if(odt_write_link_target_index >= 0 && odt_write_link_target_index < len(odt_write_link_target_extras.links)) {
    odt_write_link_target_result = odt_write_link_target_extras.links[odt_write_link_target_index];
  }
} return string odt_write_link_target_result;
