// Writes the run at offset off as the hyperlink state in st says (st[0] is the offset of the next run, st[1] the hyperlink open now), then moves the state on.
odt_write_run_piece(XmlW odt_write_run_piece_writer, Doc odt_write_run_piece_document, Text odt_write_run_piece_text, Run odt_write_run_piece_run, int[] odt_write_run_piece_state) {
  odt_write_run_piece_state[1] = odt_write_link_switch(odt_write_run_piece_writer, odt_write_run_piece_document, odt_write_run_piece_state[1], odt_write_run_piece_run.link);
  odt_write_run(odt_write_run_piece_writer, odt_write_run_piece_document, odt_write_run_piece_text, odt_write_run_piece_state[0], odt_write_run_piece_run);
  odt_write_run_piece_state[0] = odt_write_run_piece_state[0] + odt_write_run_piece_run.len;
} return void;
