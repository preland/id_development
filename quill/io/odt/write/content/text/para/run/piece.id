// One run's text, inside a text:span when its character row sets anything and bare when it does not.
odt_write_run(XmlW odt_write_run_writer, Doc odt_write_run_document, Text odt_write_run_text, int odt_write_run_offset, Run odt_write_run_run) {
  int odt_write_run_plain = odt_write_character_plain(odt_write_run_document.fmt.chars, odt_write_run_run.cprop);
  if(odt_write_run_plain == 0) {
    odt_write_span_open(odt_write_run_writer, odt_write_run_run.cprop);
  }
  odt_write_text_range(odt_write_run_writer, odt_write_run_text, odt_write_run_document.ext, odt_write_run_offset, odt_write_run_offset + odt_write_run_run.len);
} chain (XmlW odt_write_run_writer, Doc odt_write_run_document, Text odt_write_run_text, int odt_write_run_offset, Run odt_write_run_run) {
  if(odt_write_run_plain == 0) {
    xw_end(odt_write_run_writer);
  }
} return void;
