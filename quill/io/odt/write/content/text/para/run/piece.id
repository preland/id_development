// Opens the text:span of character row cid.
odt_write_span_open(XmlW odt_write_span_open_writer, int odt_write_span_open_character_number) {
  xw_start(odt_write_span_open_writer, "text:span");
  xw_attr(odt_write_span_open_writer, "text:style-name", "WT" + odt_write_span_open_character_number);
} return void;
