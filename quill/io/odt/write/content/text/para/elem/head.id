// Paragraph i as a text:p or text:h with its runs.
oc_para(XmlW oc_w, Doc oc_d, int oc_i) {
  oc_pstart(oc_w, oc_d, oc_d.body.paras[oc_i].pprop);
  oc_runs(oc_w, oc_d, oc_d.body.paras[oc_i]);
  xw_end(oc_w);
} return void;
