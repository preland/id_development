// The attributes of a paragraph element: its style-name when it has one and, for a heading, its outline level.
oc_pattr(XmlW oc_w, string oc_nm, int oc_lv) {
  if(len(oc_nm) > 0) {
    xw_attr(oc_w, "text:style-name", oc_nm);
  }
  if(oc_lv > 0) {
    xw_attr(oc_w, "text:outline-level", "" + oc_lv);
  }
} return void;
