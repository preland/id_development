// Opens the paragraph of row pid: text:h with its outline level when the style is a heading, text:p otherwise, with the style-name.
oc_pstart(XmlW oc_w, Doc oc_d, int oc_pid) {
  int oc_sid = tab_get(oc_d.fmt.paras, oc_pid, (import quill_paragraph_style));
  int oc_lv = 0;
  if(oc_sid > 0) {
    oc_lv = oc_level(oc_d, oc_sid);
  }
} chain (XmlW oc_w, Doc oc_d, int oc_pid) {
  string oc_el = "text:p";
  if(oc_lv > 0) {
    oc_el = "text:h";
  }
  xw_start(oc_w, oc_el);
} chain (XmlW oc_w, Doc oc_d, int oc_pid) {
  oc_pattr(oc_w, oc_pname(oc_d, oc_pid), oc_lv);
} return void;
