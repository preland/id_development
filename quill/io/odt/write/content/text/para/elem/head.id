// Opens the paragraph of row pid: text:h with its outline level when the style is a heading, text:p otherwise, with the style-name.
odt_write_paragraph_start(XmlW odt_write_paragraph_start_writer, Doc odt_write_paragraph_start_document, int odt_write_paragraph_start_paragraph_number) {
  int odt_write_paragraph_start_style_number = tab_get(odt_write_paragraph_start_document.fmt.paras, odt_write_paragraph_start_paragraph_number, (import quill_paragraph_style));
  int odt_write_paragraph_start_level = 0;
  if(odt_write_paragraph_start_style_number > 0) {
    odt_write_paragraph_start_level = odt_write_heading_level(odt_write_paragraph_start_document, odt_write_paragraph_start_style_number);
  }
} chain (XmlW odt_write_paragraph_start_writer, Doc odt_write_paragraph_start_document, int odt_write_paragraph_start_paragraph_number) {
  string odt_write_paragraph_start_element = "text:p";
  if(odt_write_paragraph_start_level > 0) {
    odt_write_paragraph_start_element = "text:h";
  }
  xw_start(odt_write_paragraph_start_writer, odt_write_paragraph_start_element);
} chain (XmlW odt_write_paragraph_start_writer, Doc odt_write_paragraph_start_document, int odt_write_paragraph_start_paragraph_number) {
  odt_write_paragraph_attributes(odt_write_paragraph_start_writer, odt_write_paragraph_style_name(odt_write_paragraph_start_document, odt_write_paragraph_start_paragraph_number), odt_write_paragraph_start_level);
} return void;
