// The attributes of a paragraph element: its style-name when it has one and, for a heading, its outline level.
odt_write_paragraph_attributes(XmlW odt_write_paragraph_attributes_writer, string odt_write_paragraph_attributes_name, int odt_write_paragraph_attributes_level) {
  if(len(odt_write_paragraph_attributes_name) > 0) {
    xw_attr(odt_write_paragraph_attributes_writer, "text:style-name", odt_write_paragraph_attributes_name);
  }
  if(odt_write_paragraph_attributes_level > 0) {
    xw_attr(odt_write_paragraph_attributes_writer, "text:outline-level", "" + odt_write_paragraph_attributes_level);
  }
} return void;
