// Paragraph i as a text:p or text:h with its runs.
odt_write_paragraph(XmlW odt_write_paragraph_writer, Doc odt_write_paragraph_document, int odt_write_paragraph_index) {
  odt_write_paragraph_start(odt_write_paragraph_writer, odt_write_paragraph_document, odt_write_paragraph_document.body.paras[odt_write_paragraph_index].pprop);
  odt_write_runs(odt_write_paragraph_writer, odt_write_paragraph_document, odt_write_paragraph_document.body.paras[odt_write_paragraph_index]);
  xw_end(odt_write_paragraph_writer);
} return void;
