// Marks every paragraph row and character row the document uses.
odt_write_mark_used_styles(Doc odt_write_mark_used_styles_document, int[] odt_write_mark_used_styles_paragraph_marks, int[] odt_write_mark_used_styles_character_marks) {
  int odt_write_mark_used_styles_index = 0;
  while(odt_write_mark_used_styles_index < len(odt_write_mark_used_styles_document.body.paras)) {
    odt_write_mark_paragraph_styles(odt_write_mark_used_styles_document.body.paras[odt_write_mark_used_styles_index], odt_write_mark_used_styles_paragraph_marks, odt_write_mark_used_styles_character_marks);
    odt_write_mark_used_styles_index = odt_write_mark_used_styles_index + 1;
  }
} return void;
