// Opens a style:style element with its name, family and, when there is one, parent; the caller adds the properties and ends it.
odt_write_style_open(XmlW odt_write_style_open_writer, string odt_write_style_open_name, string odt_write_style_open_family, string odt_write_style_open_parent) {
  xw_start(odt_write_style_open_writer, "style:style");
