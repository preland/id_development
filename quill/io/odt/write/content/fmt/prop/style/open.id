  xw_attr(odt_write_style_open_writer, "style:family", odt_write_style_open_family);
} chain (XmlW odt_write_style_open_writer, string odt_write_style_open_name, string odt_write_style_open_family, string odt_write_style_open_parent) {
  if(len(odt_write_style_open_parent) > 0) {
    xw_attr(odt_write_style_open_writer, "style:parent-style-name", odt_write_style_open_parent);
  }
} return void;
