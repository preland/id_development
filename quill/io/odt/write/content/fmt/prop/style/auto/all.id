// The automatic styles of a document: one P<n> per paragraph row and one T<n> per character row that some paragraph or run uses and that sets something.
odt_write_automatic_style_entries(XmlW odt_write_automatic_style_entries_writer, Doc odt_write_automatic_style_entries_document) {
  int[] odt_write_automatic_style_entries_paragraph_marks = odt_write_zero_marks(odt_write_automatic_style_entries_document.fmt.paras);
  int[] odt_write_automatic_style_entries_character_marks = odt_write_zero_marks(odt_write_automatic_style_entries_document.fmt.chars);
  odt_write_mark_used_styles(odt_write_automatic_style_entries_document, odt_write_automatic_style_entries_paragraph_marks, odt_write_automatic_style_entries_character_marks);
} chain (XmlW odt_write_automatic_style_entries_writer, Doc odt_write_automatic_style_entries_document) {
  odt_write_paragraph_automatic_all(odt_write_automatic_style_entries_writer, odt_write_automatic_style_entries_document, odt_write_automatic_style_entries_paragraph_marks);
  odt_write_character_automatic_all(odt_write_automatic_style_entries_writer, odt_write_automatic_style_entries_document, odt_write_automatic_style_entries_character_marks);
} return void;
