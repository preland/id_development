// Superscript and subscript share one attribute, so it is written once: raised, lowered, or back to the baseline when either bit is specified but neither is on.
oc_a_pos(XmlW oc_w, int oc_set, int oc_on) {
  int oc_k = (oc_on >> 4) & 3;
  if((oc_set & 48) != 0) {
    xw_attr(oc_w, "style:text-position", (import odt_pos)[oc_k]);
  }
} return void;
