// The attribute value for character flag number ix: its "on" word when the on bit is set, else its "off" word.
oc_flag_val(int oc_on, int oc_ix) {
  string oc_v = (import odt_flag_off)[oc_ix];
  if(((oc_on >> oc_ix) & 1) == 1) {
    oc_v = (import odt_flag_on)[oc_ix];
  }
} return string oc_v;
(1, 0):("bold")
(1, 1):("normal")
(6, 2):("solid")
(4, 3):("none")

// One character flag (bold, italic, underline, strike; ix 0 to 3): written when the flag is specified, as its on or off value.
oc_a_flag(XmlW oc_w, int oc_set, int oc_on, int oc_ix) {
  if(((oc_set >> oc_ix) & 1) == 1) {
    string oc_v = oc_flag_val(oc_on, oc_ix);
    xw_attr(oc_w, (import odt_flag_attr)[oc_ix], oc_v);
  }
} return void;
