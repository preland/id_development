// The style:text-properties element of character row cid: font, size, colour, highlight, then flags and position.
oc_cprops(XmlW oc_w, Doc oc_d, int oc_cid) {
  int[] oc_rw = tab_row(oc_d.fmt.chars, oc_cid);
  xw_start(oc_w, "style:text-properties");
  oc_a_font(oc_w, oc_d, oc_rw[(import quill_character_font)]);
} chain (XmlW oc_w, Doc oc_d, int oc_cid) {
  oc_a_size(oc_w, oc_rw[(import quill_character_size)]);
  oc_a_rgb(oc_w, "fo:color", oc_rw[(import quill_character_color)]);
  oc_a_rgb(oc_w, "fo:background-color", oc_rw[(import quill_character_highlight)]);
} chain (XmlW oc_w, Doc oc_d, int oc_cid) {
  oc_flags(oc_w, oc_rw[(import quill_character_set)], oc_rw[(import quill_character_on)]);
  oc_a_pos(oc_w, oc_rw[(import quill_character_set)], oc_rw[(import quill_character_on)]);
  xw_end(oc_w);
} return void;
