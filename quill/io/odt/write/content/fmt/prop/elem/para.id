// The style:paragraph-properties element of paragraph row pid: alignment, indents, spacing, line height and page break.
odt_write_paragraph_properties(XmlW odt_write_paragraph_properties_writer, Doc odt_write_paragraph_properties_document, int odt_write_paragraph_properties_paragraph_number) {
