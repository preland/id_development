} chain (XmlW odt_write_paragraph_properties_writer, Doc odt_write_paragraph_properties_document, int odt_write_paragraph_properties_paragraph_number) {
  odt_write_length_attribute(odt_write_paragraph_properties_writer, "fo:margin-top", odt_write_paragraph_properties_row[(import quill_paragraph_space_before)]);
  odt_write_length_attribute(odt_write_paragraph_properties_writer, "fo:margin-bottom", odt_write_paragraph_properties_row[(import quill_paragraph_space_after)]);
  odt_write_line_height_attribute(odt_write_paragraph_properties_writer, odt_write_paragraph_properties_row[(import quill_paragraph_line_percent)]);
} chain (XmlW odt_write_paragraph_properties_writer, Doc odt_write_paragraph_properties_document, int odt_write_paragraph_properties_paragraph_number) {
  odt_write_break_attribute(odt_write_paragraph_properties_writer, odt_write_paragraph_properties_row[(import quill_paragraph_break_before)]);
  xw_end(odt_write_paragraph_properties_writer);
} return void;
