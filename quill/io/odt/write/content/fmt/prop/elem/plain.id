  int[] odt_write_paragraph_plain_row = tab_row(odt_write_paragraph_plain_table, odt_write_paragraph_plain_paragraph_number);
  int odt_write_paragraph_plain_unset = odt_write_range_unset(odt_write_paragraph_plain_row, (import quill_paragraph_alignment), (import quill_paragraph_break_before));
  int odt_write_paragraph_plain_result = odt_write_paragraph_plain_unset * (odt_write_paragraph_plain_row[(import quill_paragraph_break_before)] == 0);
} return int odt_write_paragraph_plain_result;
