// 1 when every cell of the row from lo up to hi is unset (-1).
odt_write_range_unset(int[] odt_write_range_unset_row, int odt_write_range_unset_low, int odt_write_range_unset_high) {
  int odt_write_range_unset_result = 1;
  while(odt_write_range_unset_low < odt_write_range_unset_high) {
    if(odt_write_range_unset_row[odt_write_range_unset_low] != -1) {
      odt_write_range_unset_result = 0;
    }
    odt_write_range_unset_low = odt_write_range_unset_low + 1;
  }
} return int odt_write_range_unset_result;
([-1, 5, -1, -1], 0, 1):(1)
([-1, 5, -1, -1], 1, 4):(0)
([-1, 5, -1, -1], 2, 2):(1)

// 1 when paragraph row pid sets nothing a paragraph style would have to carry (alignment, indents, spacing, line height, page break), so the paragraph needs no automatic style.
