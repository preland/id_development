// 1 when character row cid sets nothing a span would have to carry, so its run is written as plain text.
odt_write_character_plain(Tab odt_write_character_plain_table, int odt_write_character_plain_character_number) {
  int[] odt_write_character_plain_row = tab_row(odt_write_character_plain_table, odt_write_character_plain_character_number);
  int odt_write_character_plain_unset = odt_write_range_unset(odt_write_character_plain_row, (import quill_character_font), (import quill_character_on));
  int odt_write_character_plain_result = odt_write_character_plain_unset * (odt_write_character_plain_row[(import quill_character_style)] == 0) * (odt_write_character_plain_row[(import quill_character_set)] == 0);
} return int odt_write_character_plain_result;
