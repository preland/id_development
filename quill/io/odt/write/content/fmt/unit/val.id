// A font size given in half-points as ODT writes it: whole points, plus ".5" when odd.
oc_pt(int oc_h) {
  int oc_pts = oc_h / 2;
  string oc_s = "" + oc_pts;
  if(oc_h - oc_pts * 2 == 1) {
    oc_s = oc_s + ".5";
  }
} chain (int oc_h) {
  oc_s = oc_s + "pt";
} return string oc_s;
(24):("12pt")
(21):("10.5pt")

// A 0xRRGGBB colour as the "#rrggbb" ODT uses.
oc_hex(int oc_c) {
  string oc_hx = fmt_hex(oc_c);
  string oc_s = "#" + str_sub(oc_hx, 2, 6);
} return string oc_s;
(16711680):("#ff0000")
(255):("#0000ff")
