// A font size given in half-points as ODT writes it: whole points, plus ".5" when odd.
odt_write_points(int odt_write_points_half_points) {
  int odt_write_points_whole = odt_write_points_half_points / 2;
  string odt_write_points_result = "" + odt_write_points_whole;
  if(odt_write_points_half_points - odt_write_points_whole * 2 == 1) {
    odt_write_points_result = odt_write_points_result + ".5";
  }
} chain (int odt_write_points_half_points) {
  odt_write_points_result = odt_write_points_result + "pt";
} return string odt_write_points_result;
(24):("12pt")
(21):("10.5pt")

// A 0xRRGGBB colour as the "#rrggbb" ODT uses.
odt_write_hex_color(int odt_write_hex_color_color) {
  string odt_write_hex_color_digits = format_hex(odt_write_hex_color_color);
  string odt_write_hex_color_result = "#" + str_sub(odt_write_hex_color_digits, 2, 6);
} return string odt_write_hex_color_result;
(16711680):("#ff0000")
(255):("#0000ff")
