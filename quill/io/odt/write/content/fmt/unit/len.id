// Ten-thousandths of an inch in the magnitude of tw twips, rounded to the nearest; the product is taken as a word so a long indent cannot overflow an int.
odt_write_ten_thousandths_inch(int odt_write_ten_thousandths_inch_units) {
  word odt_write_ten_thousandths_inch_absolute = fixed_point_absolute(odt_write_ten_thousandths_inch_units);
  word odt_write_ten_thousandths_inch_scaled = odt_write_ten_thousandths_inch_absolute * 10000 + 720;
  int odt_write_ten_thousandths_inch_result = odt_write_ten_thousandths_inch_scaled / 1440;
} return int odt_write_ten_thousandths_inch_result;
(720):(5000)
(-720):(5000)
(1):(7)
(11906):(82681)
(300000):(2083333)

// A count of ten-thousandths as exactly four digits: the fraction of an inch.
odt_write_pad_four_digits(int odt_write_pad_four_digits_number) {
  int odt_write_pad_four_digits_shifted = odt_write_pad_four_digits_number + 10000;
  string odt_write_pad_four_digits_text = "" + odt_write_pad_four_digits_shifted;
  string odt_write_pad_four_digits_result = str_sub(odt_write_pad_four_digits_text, 1, 4);
} return string odt_write_pad_four_digits_result;
(7):("0007")
(5000):("5000")

// A length in twips as ODT writes it: inches with four decimals, which a reader turns back into the same twips because a twip is 0.0007 in.
odt_write_inches(int odt_write_inches_units) {
  int odt_write_inches_ten_thousandths = odt_write_ten_thousandths_inch(odt_write_inches_units);
  int odt_write_inches_whole = odt_write_inches_ten_thousandths / 10000;
  int odt_write_inches_fraction = odt_write_inches_ten_thousandths - odt_write_inches_whole * 10000;
} chain (int odt_write_inches_units) {
  string odt_write_inches_fraction_text = odt_write_pad_four_digits(odt_write_inches_fraction);
  string odt_write_inches_result = "";
  if(odt_write_inches_units < 0) {
    odt_write_inches_result = "-";
  }
} chain (int odt_write_inches_units) {
  odt_write_inches_result = odt_write_inches_result + odt_write_inches_whole + "." + odt_write_inches_fraction_text + "in";
} return string odt_write_inches_result;
(720):("0.5000in")
(-360):("-0.2500in")
(11906):("8.2681in")
(1):("0.0007in")
