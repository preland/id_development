// The outline level of a heading style, 0 for any other style: the number after "Heading_20_" in its file name.
odt_write_heading_level(Doc odt_write_heading_level_document, int odt_write_heading_level_style_number) {
  string odt_write_heading_level_wire = odt_write_style_wire_name(odt_write_heading_level_document, odt_write_heading_level_style_number);
  int odt_write_heading_level_result = 0;
  if(string_starts_with(odt_write_heading_level_wire, "Heading_20_") == 1) {
    string odt_write_heading_level_digits = str_sub(odt_write_heading_level_wire, 11, len(odt_write_heading_level_wire) - 11);
    odt_write_heading_level_result = to_int(odt_write_heading_level_digits);
  }
} return int odt_write_heading_level_result;
