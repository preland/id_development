// The style-name a paragraph's element carries: its automatic style P<row> when the row sets paragraph properties, else its named style, else nothing.
odt_write_paragraph_style_name(Doc odt_write_paragraph_style_name_document, int odt_write_paragraph_style_name_paragraph_number) {
  string odt_write_paragraph_style_name_result = "";
  int odt_write_paragraph_style_name_plain = odt_write_paragraph_plain(odt_write_paragraph_style_name_document.fmt.paras, odt_write_paragraph_style_name_paragraph_number);
  int odt_write_paragraph_style_name_style_number = tab_get(odt_write_paragraph_style_name_document.fmt.paras, odt_write_paragraph_style_name_paragraph_number, (import quill_paragraph_style));
} chain (Doc odt_write_paragraph_style_name_document, int odt_write_paragraph_style_name_paragraph_number) {
  if(odt_write_paragraph_style_name_plain == 0) {
    odt_write_paragraph_style_name_result = "WP" + odt_write_paragraph_style_name_paragraph_number;
  } else if(odt_write_paragraph_style_name_style_number > 0) {
    odt_write_paragraph_style_name_result = odt_write_style_wire_name(odt_write_paragraph_style_name_document, odt_write_paragraph_style_name_style_number);
  }
} return string odt_write_paragraph_style_name_result;
