// The name a style has in the file: the ODT name of a built-in style ("Standard" for Normal), otherwise its name with each space written as _20_ as ODF does.
odt_write_style_wire_name(Doc odt_write_style_wire_name_document, int odt_write_style_wire_name_style_number) {
  string odt_write_style_wire_name_name = odt_write_style_wire_name_document.fmt.sty.styles[odt_write_style_wire_name_style_number].name;
  string[] odt_write_style_wire_name_pieces = string_split(odt_write_style_wire_name_name, " ");
  string odt_write_style_wire_name_result = string_join(odt_write_style_wire_name_pieces, "_20_");
} chain (Doc odt_write_style_wire_name_document, int odt_write_style_wire_name_style_number) {
  int odt_write_style_wire_name_known_index = list_string_index((import quill_style_names), odt_write_style_wire_name_name);
  if(odt_write_style_wire_name_known_index >= 0) {
    odt_write_style_wire_name_result = (import quill_style_wire)[odt_write_style_wire_name_known_index];
  }
} return string odt_write_style_wire_name_result;
