// What is wrong with paragraph i for writing, as a message that names the fix, or "" when nothing is.
odt_write_paragraph_problem(Doc odt_write_paragraph_problem_document, int odt_write_paragraph_problem_paragraph) {
  string odt_write_paragraph_problem_result = "";
  int odt_write_paragraph_problem_marker_offset = odt_write_object_marker_invalid(odt_write_paragraph_problem_document.body.paras[odt_write_paragraph_problem_paragraph].txt, odt_write_paragraph_problem_document.ext);
  int odt_write_paragraph_problem_block_invalid = odt_write_block_invalid(odt_write_paragraph_problem_document, odt_write_paragraph_problem_paragraph);
} chain (Doc odt_write_paragraph_problem_document, int odt_write_paragraph_problem_paragraph) {
  if(odt_write_paragraph_problem_block_invalid == 1) {
    odt_write_paragraph_problem_result = "paragraph " + odt_write_paragraph_problem_paragraph + " is an opaque block (kind 1) whose first code point names no verbatim part; make that code point quill_object_marker plus the index of a Part of kind 0 in ext.parts, or make the paragraph a text paragraph";
  } else if(odt_write_paragraph_problem_marker_offset >= 0) {
    odt_write_paragraph_problem_result = "paragraph " + odt_write_paragraph_problem_paragraph + " has an object marker at offset " + odt_write_paragraph_problem_marker_offset + " that names no verbatim part; store the object's XML as a Part of kind 0 at index (code point - quill_object_marker) of ext.parts, or remove the code point";
  }
} return string odt_write_paragraph_problem_result;
