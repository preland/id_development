    if(odt_write_object_marker_invalid_text.cps[odt_write_object_marker_invalid_index] >= (import quill_object_marker) && odt_write_part_valid(odt_write_object_marker_invalid_extras, odt_write_object_marker_invalid_text.cps[odt_write_object_marker_invalid_index] - (import quill_object_marker)) == 0) {
