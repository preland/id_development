// Test fixture: oc_xd is the default document without its two list definitions and with the text b in its paragraph (k 1 adds an object marker that names no part), and oc_xb the bytes of the string want.
odt_write_test_make_document(int odt_write_test_document_variant, string odt_write_test_document_command) {
  export Doc odt_write_test_document_made = doc_new();
  export int[] odt_write_test_expected_bytes = exec_bytes(odt_write_test_document_command);
  text_insert(odt_write_test_document_made.body.paras[0].txt, 0, [98], 0);
} chain (int odt_write_test_document_variant, string odt_write_test_document_command) {
  pop(odt_write_test_document_made.fmt.sty.lists);
  pop(odt_write_test_document_made.fmt.sty.lists);
  if(odt_write_test_document_variant == 1) {
    text_insert(odt_write_test_document_made.body.paras[0].txt, 1, [983041], 0);
  }
} return void;
