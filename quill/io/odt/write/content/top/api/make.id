// content.xml of a document as bytes; [] when odt_content_check finds the document cannot be written, so a caller tests odt_content_check first to learn why.
odt_content_bytes(Doc odt_write_content_bytes_document) {
  int[] odt_write_content_bytes_result = [];
  string odt_write_content_bytes_problem = odt_content_check(odt_write_content_bytes_document);
  if(len(odt_write_content_bytes_problem) == 0) {
    XmlW odt_write_content_bytes_writer = xml_writer_new();
    odt_write_document_root(odt_write_content_bytes_writer, odt_write_content_bytes_document);
    odt_write_content_bytes_result = xml_writer_finish(odt_write_content_bytes_writer);
  }
} return int[] odt_write_content_bytes_result;
