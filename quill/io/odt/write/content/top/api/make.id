// content.xml of a document as bytes; [] when odt_content_check finds the document cannot be written, so a caller tests odt_content_check first to learn why.
odt_content_bytes(Doc oc_d) {
  int[] oc_bs = [];
  string oc_why = odt_content_check(oc_d);
  if(len(oc_why) == 0) {
    XmlW oc_w = xw_new();
    oc_root(oc_w, oc_d);
    oc_bs = xw_done(oc_w);
  }
} return int[] oc_bs;
