// Writes part i when it is a verbatim automatic style (its name starts with "auto:"), so an opaque block that refers to it still finds it.
oc_apart(XmlW oc_w, Doc oc_d, int oc_i) {
  if(str_starts(oc_d.ext.parts[oc_i].name, "auto:") == 1) {
    oc_raw(oc_w, oc_d.ext, oc_i);
  }
} return void;
