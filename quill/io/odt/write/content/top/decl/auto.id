// Every verbatim automatic style the document carries.
oc_aparts(XmlW oc_w, Doc oc_d) {
  int oc_i = 0;
  while(oc_i < len(oc_d.ext.parts)) {
    oc_apart(oc_w, oc_d, oc_i);
    oc_i = oc_i + 1;
  }
} return void;
