// Writes part i when it is a verbatim automatic style (its name starts with "auto:"), so an opaque block that refers to it still finds it.
odt_write_automatic_part(XmlW odt_write_automatic_part_writer, Doc odt_write_automatic_part_document, int odt_write_automatic_part_index) {
  if(string_starts_with(odt_write_automatic_part_document.ext.parts[odt_write_automatic_part_index].name, "auto:") == 1) {
    odt_write_raw_part(odt_write_automatic_part_writer, odt_write_automatic_part_document.ext, odt_write_automatic_part_index);
  }
} return void;
