// The office:automatic-styles element: the paragraph and character styles the rows in use call for, the list styles and the verbatim styles of preserved blocks.
odt_write_automatic_styles_element(XmlW odt_write_automatic_styles_element_writer, Doc odt_write_automatic_styles_element_document) {
  xml_writer_start_element(odt_write_automatic_styles_element_writer, "office:automatic-styles");
  odt_write_automatic_style_entries(odt_write_automatic_styles_element_writer, odt_write_automatic_styles_element_document);
  odt_write_list_styles(odt_write_automatic_styles_element_writer, odt_write_automatic_styles_element_document);
} chain (XmlW odt_write_automatic_styles_element_writer, Doc odt_write_automatic_styles_element_document) {
  odt_write_automatic_parts(odt_write_automatic_styles_element_writer, odt_write_automatic_styles_element_document);
  xml_writer_end_element(odt_write_automatic_styles_element_writer);
} return void;
