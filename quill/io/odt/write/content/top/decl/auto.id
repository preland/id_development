// Every verbatim automatic style the document carries.
odt_write_automatic_parts(XmlW odt_write_automatic_parts_writer, Doc odt_write_automatic_parts_document) {
  int odt_write_automatic_parts_index = 0;
  while(odt_write_automatic_parts_index < len(odt_write_automatic_parts_document.ext.parts)) {
    odt_write_automatic_part(odt_write_automatic_parts_writer, odt_write_automatic_parts_document, odt_write_automatic_parts_index);
    odt_write_automatic_parts_index = odt_write_automatic_parts_index + 1;
  }
} return void;
