// The office:font-face-decls element of content.xml.
odt_write_font_declarations(XmlW odt_write_font_declarations_writer, Doc odt_write_font_declarations_document) {
  xml_writer_start_element(odt_write_font_declarations_writer, "office:font-face-decls");
  odt_write_font_faces_all(odt_write_font_declarations_writer, odt_write_font_declarations_document);
  xml_writer_end_element(odt_write_font_declarations_writer);
} return void;
