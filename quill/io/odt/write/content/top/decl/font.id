// A declaration for each of the document's font families, in index order, so style:font-name finds one.
odt_write_font_faces_all(XmlW odt_write_font_faces_all_writer, Doc odt_write_font_faces_all_document) {
  int odt_write_font_faces_all_index = 0;
  while(odt_write_font_faces_all_index < len(odt_write_font_faces_all_document.ext.fonts)) {
    odt_write_font_face(odt_write_font_faces_all_writer, odt_write_font_faces_all_document.ext.fonts[odt_write_font_faces_all_index]);
    odt_write_font_faces_all_index = odt_write_font_faces_all_index + 1;
  }
} return void;
