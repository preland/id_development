// One style:font-face declaration: the family name, and the same name quoted as the CSS family the face stands for.
odt_write_font_face(XmlW odt_write_font_face_writer, string odt_write_font_face_name) {
  xml_writer_start_element(odt_write_font_face_writer, "style:font-face");
  xml_writer_attribute(odt_write_font_face_writer, "style:name", odt_write_font_face_name);
  xml_writer_attribute(odt_write_font_face_writer, "svg:font-family", "'" + odt_write_font_face_name + "'");
} chain (XmlW odt_write_font_face_writer, string odt_write_font_face_name) {
  xml_writer_end_element(odt_write_font_face_writer);
} return void;
