// The numbering attributes of a numbered level: the suffix, the format (decimal, letters or roman numerals) and, unless it is 1, the number to start from.
odt_write_level_number(XmlW odt_write_level_number_writer, int odt_write_level_number_format, int odt_write_level_number_start_value) {
  xml_writer_attribute(odt_write_level_number_writer, "style:num-suffix", ".");
  xml_writer_attribute(odt_write_level_number_writer, "style:num-format", (import odt_num_format)[odt_write_level_number_format]);
  if(odt_write_level_number_start_value != 1) {
    xml_writer_attribute(odt_write_level_number_writer, "text:start-value", "" + odt_write_level_number_start_value);
  }
} return void;
