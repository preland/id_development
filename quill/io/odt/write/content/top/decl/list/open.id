// Opens the level style of level k: a bullet with its character, or a number with its format and start.
odt_write_level_open(XmlW odt_write_level_open_writer, int[] odt_write_level_open_levels, int odt_write_level_open_index) {
  int odt_write_level_open_kind = odt_write_level_open_levels[odt_write_level_open_index * (import quill_list_level_stride) + (import quill_list_level_kind)];
  int odt_write_level_open_format = odt_write_level_open_levels[odt_write_level_open_index * (import quill_list_level_stride) + (import quill_list_level_format)];
  xml_writer_start_element(odt_write_level_open_writer, (import odt_lv_el)[odt_write_level_open_kind]);
} chain (XmlW odt_write_level_open_writer, int[] odt_write_level_open_levels, int odt_write_level_open_index) {
  xml_writer_attribute(odt_write_level_open_writer, "text:level", "" + (odt_write_level_open_index + 1));
  if(odt_write_level_open_kind == 0) {
    xml_writer_attribute(odt_write_level_open_writer, "text:bullet-char", utf8_string(odt_write_level_open_format));
