// The list style of definition i, written only when the definition has levels.
odt_write_list_style_nonempty(XmlW odt_write_list_style_nonempty_writer, Doc odt_write_list_style_nonempty_document, int odt_write_list_style_nonempty_index) {
  if(len(odt_write_list_style_nonempty_document.fmt.sty.lists[odt_write_list_style_nonempty_index].levels) > 0) {
    odt_write_list_style(odt_write_list_style_nonempty_writer, odt_write_list_style_nonempty_document, odt_write_list_style_nonempty_index);
  }
} return void;
