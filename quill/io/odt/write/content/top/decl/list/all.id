// A list style for every definition that has levels; index 0 is the "no list" placeholder and is skipped.
odt_write_list_styles(XmlW odt_write_list_styles_writer, Doc odt_write_list_styles_document) {
  int odt_write_list_styles_index = 1;
  while(odt_write_list_styles_index < len(odt_write_list_styles_document.fmt.sty.lists)) {
    odt_write_list_style_nonempty(odt_write_list_styles_writer, odt_write_list_styles_document, odt_write_list_styles_index);
    odt_write_list_styles_index = odt_write_list_styles_index + 1;
  }
} return void;
