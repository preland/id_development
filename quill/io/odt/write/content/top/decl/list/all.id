// The automatic list style L<li> of list definition li: its levels inside a text:list-style.
odt_write_list_style(XmlW odt_write_list_style_writer, Doc odt_write_list_style_document, int odt_write_list_style_list_index) {
  xml_writer_start_element(odt_write_list_style_writer, "text:list-style");
  xml_writer_attribute(odt_write_list_style_writer, "style:name", "WL" + odt_write_list_style_list_index);
  odt_write_levels(odt_write_list_style_writer, odt_write_list_style_document.fmt.sty.lists[odt_write_list_style_list_index].levels);
} chain (XmlW odt_write_list_style_writer, Doc odt_write_list_style_document, int odt_write_list_style_list_index) {
  xml_writer_end_element(odt_write_list_style_writer);
} return void;
