// Every paragraph in order, then whatever lists are still open.
odt_write_body_paragraphs(XmlW odt_write_body_paragraphs_writer, Doc odt_write_body_paragraphs_document) {
  int[] odt_write_body_paragraphs_state = [0, 0];
  int odt_write_body_paragraphs_index = 0;
  while(odt_write_body_paragraphs_index < len(odt_write_body_paragraphs_document.body.paras)) {
    odt_write_body_item(odt_write_body_paragraphs_writer, odt_write_body_paragraphs_document, odt_write_body_paragraphs_index, odt_write_body_paragraphs_state);
    odt_write_body_paragraphs_index = odt_write_body_paragraphs_index + 1;
  }
} chain (XmlW odt_write_body_paragraphs_writer, Doc odt_write_body_paragraphs_document) {
