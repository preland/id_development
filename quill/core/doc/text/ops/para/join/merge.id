// Appends paragraph para + 1 to paragraph para and removes it.
body_merge(Body paragraphs_merge_body, int para) {
  Para paragraphs_merge_paragraph = paragraphs_merge_body.paras[para];
  text_append(paragraphs_merge_paragraph.txt, paragraphs_merge_body.paras[para + 1].txt);
  paras_remove(paragraphs_merge_body.paras, para + 1);
} chain (Body paragraphs_merge_body, int para) {
  para_stale(paragraphs_merge_paragraph);
} return void;
