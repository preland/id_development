// Backspace at the start of paragraph para + 1: it joins the end of paragraph para and the merged paragraph keeps para's paragraph row. Nothing happens past the last paragraph.
body_join(Body paragraphs_join_body, int para) {
  if(para + 1 < len(paragraphs_join_body.paras)) {
    body_merge(paragraphs_join_body, para);
    paragraphs_join_body.rev = paragraphs_join_body.rev + 1;
  }
} return void;
