// A deep copy of a paragraph, with a stale layout.
para_copy(Para paragraph_clone_paragraph) {
  Text paragraph_clone_new_text = text_copy(paragraph_clone_paragraph.txt);
  Para paragraph_clone_new_paragraph = para_make(paragraph_clone_new_text, paragraph_clone_paragraph.pprop);
} return Para paragraph_clone_new_paragraph;
