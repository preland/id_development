// Appends paragraph para + 1 to paragraph para and removes it.
body_merge(Body b, int para) {
  Para p = b.paras[para];
  text_append(p.txt, b.paras[para + 1].txt);
  paras_remove(b.paras, para + 1);
} chain (Body b, int para) {
  para_stale(p);
} return void;
(Body([Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], 7), 3), Para(Text([2], [Run(1, 5, -1)], 0), Lay([], [], 7), 4)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), 0):(Body([Para(Text([1, 2], [Run(1, 0, -1), Run(1, 5, -1)], 1), Lay([], [], -1), 3)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), 0)
(Body([Para(Text([], [Run(0, 0, -1)], 0), Lay([], [], 7), 3), Para(Text([2], [Run(1, 5, -1)], 0), Lay([], [], 7), 4)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), 0):(Body([Para(Text([2], [Run(1, 5, -1)], 1), Lay([], [], -1), 3)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), 0)

// Backspace at the start of paragraph para + 1: it joins the end of paragraph para and the merged paragraph keeps para's paragraph row. Nothing happens past the last paragraph.
body_join(Body b, int para) {
  if(para + 1 < len(b.paras)) {
    body_merge(b, para);
    b.rev = b.rev + 1;
  }
} return void;
(Body([Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], 7), 3), Para(Text([2], [Run(1, 5, -1)], 0), Lay([], [], 7), 4)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 4), 0):(Body([Para(Text([1, 2], [Run(1, 0, -1), Run(1, 5, -1)], 1), Lay([], [], -1), 3)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 5), 0)
(Body([Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], 7), 3)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 4), 0):(Body([Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], 7), 3)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 4), 0)

// A deep copy of a paragraph, with a stale layout.
para_copy(Para p) {
  Text nt = text_copy(p.txt);
  Para np = para_make(nt, p.pprop);
} return Para np;
(Para(Text([1], [Run(1, 0, -1)], 2), Lay([], [], 7), 3)):(Para(Text([1], [Run(1, 0, -1)], 2), Lay([], [], -1), 3))
