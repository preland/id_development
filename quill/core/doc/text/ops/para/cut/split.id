// Splits paragraph para at code point off into two paragraphs; the second has the first's paragraph row, and the first keeps the text before off.
body_split(Body body_split_at_body, int para, int off) {
  Para body_split_at_paragraph = body_split_at_body.paras[para];
  Text body_split_at_new_text = text_tail(body_split_at_paragraph.txt, off);
  Para body_split_at_new_paragraph = para_make(body_split_at_new_text, body_split_at_paragraph.pprop);
} chain (Body body_split_at_body, int para, int off) {
  paras_insert(body_split_at_body.paras, para + 1, body_split_at_new_paragraph);
  para_stale(body_split_at_paragraph);
  body_split_at_body.rev = body_split_at_body.rev + 1;
} return void;
