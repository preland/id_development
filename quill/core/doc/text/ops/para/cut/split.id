// Marks a paragraph's layout stale so the next layout pass redoes it.
para_stale(Para stale_mark_paragraph) {
  Lay paragraph_layout = stale_mark_paragraph.lay;
  paragraph_layout.h = -1;
} return void;
(Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], 5), 0)):(Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], -1), 0))
