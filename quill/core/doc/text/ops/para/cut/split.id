// Splits paragraph para at code point off into two paragraphs; the second has the first's paragraph row, and the first keeps the text before off.
body_split(Body b, int para, int off) {
  Para p = b.paras[para];
  Text nt = text_tail(p.txt, off);
  Para np = para_make(nt, p.pprop);
} chain (Body b, int para, int off) {
  paras_insert(b.paras, para + 1, np);
  para_stale(p);
  b.rev = b.rev + 1;
} return void;
