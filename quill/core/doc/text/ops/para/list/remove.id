paras_remove(Para[] paragraphs_remove_paragraph_list, int at) {
  int paragraphs_remove_index = at;
  while(paragraphs_remove_index + 1 < len(paragraphs_remove_paragraph_list)) {
    paragraphs_remove_paragraph_list[paragraphs_remove_index] = paragraphs_remove_paragraph_list[paragraphs_remove_index + 1];
    paragraphs_remove_index = paragraphs_remove_index + 1;
  }
  pop(paragraphs_remove_paragraph_list);
} return void;
