// Removes paragraph index. A document keeps at least one paragraph, so removing the only one does nothing.
body_remove(Body body_remove_paragraph_body, int index) {
  if(len(body_remove_paragraph_body.paras) > 1) {
    paras_remove(body_remove_paragraph_body.paras, index);
    body_remove_paragraph_body.rev = body_remove_paragraph_body.rev + 1;
  }
} return void;
