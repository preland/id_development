// Removes paragraph index. A document keeps at least one paragraph, so removing the only one does nothing.
body_remove(Body b, int index) {
  if(len(b.paras) > 1) {
    paras_remove(b.paras, index);
    b.rev = b.rev + 1;
  }
} return void;
