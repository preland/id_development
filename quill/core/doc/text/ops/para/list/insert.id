paras_insert(Para[] paragraphs_insert_paragraph_list, int at, Para paragraphs_insert_paragraph) {
  push(paragraphs_insert_paragraph_list, paragraphs_insert_paragraph);
  int paragraphs_insert_index = len(paragraphs_insert_paragraph_list) - 1;
  while(paragraphs_insert_index > at) {
    paragraphs_insert_paragraph_list[paragraphs_insert_index] = paragraphs_insert_paragraph_list[paragraphs_insert_index - 1];
    paragraphs_insert_index = paragraphs_insert_index - 1;
  }
} chain (Para[] paragraphs_insert_paragraph_list, int at, Para paragraphs_insert_paragraph) {
  paragraphs_insert_paragraph_list[at] = paragraphs_insert_paragraph;
} return void;
