// Inserts paragraph p at index (0 to the paragraph count); its layout is marked stale.
body_insert(Body body_insert_paragraph_body, int index, Para body_insert_paragraph_paragraph) {
  paras_insert(body_insert_paragraph_body.paras, index, body_insert_paragraph_paragraph);
  para_stale(body_insert_paragraph_paragraph);
  body_insert_paragraph_body.rev = body_insert_paragraph_body.rev + 1;
} return void;
