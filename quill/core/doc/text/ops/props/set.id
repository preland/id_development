// Changes the character row of every run covering lo..hi-1 (see run_mut), splitting runs at the ends and merging equal neighbours afterwards. An empty paragraph (no text) has its one run changed.
text_apply(Text apply_change_text, int apply_change_lower_bound, int hi, Tab chars, int key, int apply_change_value, int mode) {
  int apply_change_index = run_cut(apply_change_text, apply_change_lower_bound);
  int apply_change_end_index = run_cut(apply_change_text, hi);
  if(len(apply_change_text.cps) == 0) {
    apply_change_end_index = 1;
  }
} chain (Text apply_change_text, int apply_change_lower_bound, int hi, Tab chars, int key, int apply_change_value, int mode) {
  while(apply_change_index < apply_change_end_index) {
    run_mut(apply_change_text.runs[apply_change_index], chars, key, apply_change_value, mode);
    apply_change_index = apply_change_index + 1;
  }
  text_merge(apply_change_text);
  apply_change_text.rev = apply_change_text.rev + 1;
} return void;
