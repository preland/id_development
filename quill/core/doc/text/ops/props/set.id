// Applies one change to a run's character row: mode quill_mode_field sets field key to val, quill_mode_bits turns the flag bits key on (val 1), off (0) or unset (-1); another mode changes nothing.
run_mut(Run run_modify_run, Tab chars, int key, int run_modify_value, int mode) {
  int run_modify_new_character_row = run_modify_run.cprop;
  if(mode == (import quill_mode_field)) {
    run_modify_new_character_row = tab_with(chars, run_modify_run.cprop, key, run_modify_value);
  }
  if(mode == (import quill_mode_bits)) {
    run_modify_new_character_row = tab_with_bits(chars, run_modify_run.cprop, key, run_modify_value);
  }
} chain (Run run_modify_run, Tab chars, int key, int run_modify_value, int mode) {
  run_modify_run.cprop = run_modify_new_character_row;
} return void;
