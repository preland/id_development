// Gives the code points lo..hi-1 the runs in runs, as [len, cprop, link] triples whose lengths add up to hi - lo; anything else changes nothing. The only way to set a link, and the way to set the properties of an empty paragraph (lo = hi = 0).
text_runs_set(Text t, int lo, int hi, int[] runs) {
  int n = runs_sum(runs);
  if(len(runs) % 3 == 0 && n == hi - lo) {
    text_swap(t, lo, hi, runs);
    text_merge(t);
  }
} return void;
