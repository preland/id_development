// Changes the character row of every run covering lo..hi-1 (see run_mut), splitting runs at the ends and merging equal neighbours afterwards. An empty paragraph (no text) has its one run changed.
text_apply(Text t, int lo, int hi, Tab chars, int key, int val, int mode) {
  int i = run_cut(t, lo);
  int j = run_cut(t, hi);
  if(len(t.cps) == 0) {
    j = 1;
  }
} chain (Text t, int lo, int hi, Tab chars, int key, int val, int mode) {
  while(i < j) {
    run_mut(t.runs[i], chars, key, val, mode);
    i = i + 1;
  }
  text_merge(t);
  t.rev = t.rev + 1;
} return void;
