// Applies one change to a run's character row: mode quill_mode_field sets field key to val, quill_mode_bits turns the flag bits key on (val 1), off (0) or unset (-1); another mode changes nothing.
run_mut(Run ru, Tab chars, int key, int val, int mode) {
  int nc = ru.cprop;
  if(mode == (import quill_mode_field)) {
    nc = tab_with(chars, ru.cprop, key, val);
  }
  if(mode == (import quill_mode_bits)) {
    nc = tab_with_bits(chars, ru.cprop, key, val);
  }
} chain (Run ru, Tab chars, int key, int val, int mode) {
  ru.cprop = nc;
} return void;
