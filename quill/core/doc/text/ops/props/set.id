// Gives the code points lo..hi-1 the runs in runs, as [len, cprop, link] triples whose lengths add up to hi - lo; anything else changes nothing. The only way to set a link, and the way to set the properties of an empty paragraph (lo = hi = 0).
text_runs_set(Text runs_assign_text, int runs_assign_lower_bound, int hi, int[] runs) {
  int runs_assign_total = runs_sum(runs);
  if(len(runs) % 3 == 0 && runs_assign_total == hi - runs_assign_lower_bound) {
    text_swap(runs_assign_text, runs_assign_lower_bound, hi, runs);
    text_merge(runs_assign_text);
  }
} return void;
