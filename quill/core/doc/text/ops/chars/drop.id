// An emptied paragraph keeps one empty run, with the properties the deleted text had.
rs_fill(Run[] rs, int cprop) {
  if(len(rs) == 0) {
    Run nr = Run(0, cprop, -1);
    push(rs, nr);
  }
} return void;
([], 7):([Run(0, 7, -1)], 7)
([], 4):([Run(0, 4, -1)], 4)
([Run(1, 0, -1)], 7):([Run(1, 0, -1)], 7)

// Removes the runs that cover lo..hi; the code points are removed by text_delete.
text_drop(Text t, int lo, int hi) {
  int ia = run_cut(t, lo);
  int iz = run_cut(t, hi);
  int keep = t.runs[ia].cprop;
} chain (Text t, int lo, int hi) {
  rs_remove(t.runs, ia, iz - ia);
  rs_fill(t.runs, keep);
  t.rev = t.rev + 1;
} return void;
(Text([1, 2, 3, 4], [Run(4, 0, -1)], 0), 1, 3):(Text([1, 2, 3, 4], [Run(1, 0, -1), Run(1, 0, -1)], 1), 1, 3)
(Text([1, 2], [Run(2, 5, -1)], 0), 0, 2):(Text([1, 2], [Run(0, 5, -1)], 1), 0, 2)

// Deletes the code points lo..hi-1, which must lie inside the text; an empty range does nothing. Neighbours left with equal properties merge.
text_delete(Text t, int lo, int hi) {
  int[] none = [];
  if(lo < hi) {
    text_drop(t, lo, hi);
    list_splice(t.cps, lo, hi, none);
    text_merge(t);
  }
} return void;
(Text([1, 2, 3, 4], [Run(4, 0, -1)], 0), 1, 3):(Text([1, 4], [Run(2, 0, -1)], 1), 1, 3)
(Text([1, 2], [Run(2, 5, -1)], 0), 0, 2):(Text([], [Run(0, 5, -1)], 1), 0, 2)
(Text([1, 2, 3, 4], [Run(2, 0, -1), Run(2, 1, -1)], 0), 1, 3):(Text([1, 4], [Run(1, 0, -1), Run(1, 1, -1)], 1), 1, 3)
(Text([1, 2, 3], [Run(1, 0, -1), Run(1, 1, -1), Run(1, 0, -1)], 0), 1, 2):(Text([1, 3], [Run(2, 0, -1)], 1), 1, 2)
(Text([1, 2], [Run(2, 0, -1)], 4), 1, 1):(Text([1, 2], [Run(2, 0, -1)], 4), 1, 1)
