// An empty paragraph's text: one empty run that carries the character row cprop, so a caret in it has properties to type with.
text_new(int text_make_character_row) {
  int[] text_make_code_points = [];
  Run text_make_run = Run(0, text_make_character_row, -1);
  Run[] text_make_run_list = [];
} chain (int text_make_character_row) {
  push(text_make_run_list, text_make_run);
  Text text_make_text = Text(text_make_code_points, text_make_run_list, 0);
} return Text text_make_text;
(0):(Text([], [Run(0, 0, -1)], 0))
(5):(Text([], [Run(0, 5, -1)], 0))

// A4 portrait with one inch margins and no header or footer; the lists are fresh copies, so editing them never touches the constants.
page_new() {
  int[] size = list_copy((import quill_page_size));
  int[] margin = list_copy((import quill_page_margin));
  int[] hf = [0, 0, 0];
} chain () {
  Page page_make_page = Page(size, margin, hf);
} return Page page_make_page;
():(Page([11906, 16838, 0], [1440, 1440, 1440, 1440], [0, 0, 0]))
():(Page([11906, 16838, 0], [1440, 1440, 1440, 1440], [0, 0, 0])) then calls list_copy:[2]

// A document's references: the font families it starts with (the default one first), no links, no preserved parts.
document_extras_new(string font) {
  string[] fonts = [font];
  string[] links = [];
  Part[] parts = [];
} chain (string font) {
  Ext extras_make_extras = Ext(fonts, links, parts);
} return Ext extras_make_extras;
("serif"):(Ext(["serif"], [], []))
("Liberation Sans"):(Ext(["Liberation Sans"], [], []))
