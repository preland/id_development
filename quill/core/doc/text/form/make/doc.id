// One empty paragraph on a new page, with paragraph row 0 and character row 0 (nothing set, so Normal).
body_new() {
  Page pg = page_new();
  Text t = text_new(0);
  Para p = para_make(t, 0);
} chain () {
  Para[] pl = [];
  push(pl, p);
  Body b = Body(pl, pg, 0);
} return Body b;
