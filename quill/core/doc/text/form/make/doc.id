// A new document: the built-in styles and lists, one empty Normal paragraph on an A4 page.
doc_new() {
  Fmt f = fmt_new();
  fmt_default(f);
  Body b = body_new();
} chain () {
  Ext x = ext_new((import quill_font_default));
  Doc d = Doc(b, f, x);
} return Doc d;
