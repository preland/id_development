dump_ints(int[] xs) {
  string text = "";
  int i = 0;
  while(i < len(xs)) {
    text = text + xs[i] + ",";
    i = i + 1;
  }
} return string text;
([1, -2, 30]):("1,-2,30,")
([]):("")

dump_runs(Run[] rs) {
  string text = "";
  int i = 0;
  while(i < len(rs)) {
    text = text + rs[i].len + ":" + rs[i].cprop + ":" + rs[i].link + ",";
    i = i + 1;
  }
} return string text;
([Run(2, 0, -1), Run(1, 5, 3)]):("2:0:-1,1:5:3,")
([]):("")

dump_page(Page pg) {
  string text = "G " + dump_ints(pg.size) + " " + dump_ints(pg.margin) + " " + dump_ints(pg.hf);
} return string text;
(Page([11906, 16838, 0], [1, 2, 3, 4], [0, 0, 0])):("G 11906,16838,0, 1,2,3,4, 0,0,0,")
(Page([1, 2, 1], [5, 6, 7, 8], [9, 0, 0])):("G 1,2,1, 5,6,7,8, 9,0,0,")
