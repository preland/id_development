document_dump_integers(int[] dump_integers_values) {
  string text = "";
  int dump_integers_index = 0;
  while(dump_integers_index < len(dump_integers_values)) {
    text = text + dump_integers_values[dump_integers_index] + ",";
    dump_integers_index = dump_integers_index + 1;
  }
} return string text;
([1, -2, 30]):("1,-2,30,")
([]):("")

dump_runs(Run[] dump_run_list_run_list) {
  string text = "";
  int dump_run_list_index = 0;
  while(dump_run_list_index < len(dump_run_list_run_list)) {
    text = text + dump_run_list_run_list[dump_run_list_index].len + ":" + dump_run_list_run_list[dump_run_list_index].cprop + ":" + dump_run_list_run_list[dump_run_list_index].link + ",";
    dump_run_list_index = dump_run_list_index + 1;
  }
} return string text;
([Run(2, 0, -1), Run(1, 5, 3)]):("2:0:-1,1:5:3,")
([]):("")

dump_page(Page dump_page_data_page) {
  string text = "G " + document_dump_integers(dump_page_data_page.size) + " " + document_dump_integers(dump_page_data_page.margin) + " " + document_dump_integers(dump_page_data_page.hf);
} return string text;
(Page([11906, 16838, 0], [1, 2, 3, 4], [0, 0, 0])):("G 11906,16838,0, 1,2,3,4, 0,0,0,")
(Page([1, 2, 1], [5, 6, 7, 8], [9, 0, 0])):("G 1,2,1, 5,6,7,8, 9,0,0,")
