document_paragraph_length(Para length_read_paragraph) {
  int length_read_total = len(length_read_paragraph.txt.cps);
} return int length_read_total;
(Para(Text([1, 2, 3], [Run(3, 0, -1)], 0), Lay([], [], -1), 0)):(3)
(Para(Text([], [Run(0, 0, -1)], 0), Lay([], [], -1), 0)):(0)

document_paragraph_code_point(Para code_point_read_paragraph, int off) {
  int code_point_read_code_point = code_point_read_paragraph.txt.cps[off];
} return int code_point_read_code_point;
(Para(Text([7, 8, 9], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), 1):(8)
(Para(Text([7, 8, 9], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), 2):(9)

// The index of the run holding code point off; an offset at the end gives the last run.
para_run(Para run_read_paragraph, int off) {
  int run_read_index = run_at(run_read_paragraph.txt, off);
} return int run_read_index;
(Para(Text([1, 2, 3], [Run(2, 0, -1), Run(1, 5, -1)], 0), Lay([], [], -1), 0), 2):(1)
(Para(Text([1, 2, 3], [Run(2, 0, -1), Run(1, 5, -1)], 0), Lay([], [], -1), 0), 1):(0)
