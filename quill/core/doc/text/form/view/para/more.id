// The character row of the run holding code point off, clamped into the text, so an empty paragraph answers with its one run. Typing after offset n takes the properties of para_cprop(p, n - 1).
document_paragraph_character_row(Para paragraph_row_paragraph, int off) {
  int paragraph_row_run_index = run_at(paragraph_row_paragraph.txt, off);
  int paragraph_row_character_row = paragraph_row_paragraph.txt.runs[paragraph_row_run_index].cprop;
} return int paragraph_row_character_row;
(Para(Text([1, 2, 3], [Run(2, 4, -1), Run(1, 5, -1)], 0), Lay([], [], -1), 0), 1):(4)
(Para(Text([1, 2, 3], [Run(2, 4, -1), Run(1, 5, -1)], 0), Lay([], [], -1), 0), 9):(5)
(Para(Text([], [Run(0, 6, -1)], 0), Lay([], [], -1), 0), 0):(6)

doc_count(Doc count_paragraphs_document) {
  int count_paragraphs_total = len(count_paragraphs_document.body.paras);
} return int count_paragraphs_total;
(Doc(Body([Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], -1), 0), Para(Text([2], [Run(1, 0, -1)], 0), Lay([], [], -1), 0)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext([], [], []))):(2)
(Doc(Body([Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], -1), 0)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext([], [], []))):(1)

// The text of the first paragraph, at most 64 code points, as the document's title.
doc_title(Doc title_text_document) {
  Text title_text_first_text = title_text_document.body.paras[0].txt;
  int title_text_length = len(title_text_first_text.cps);
  if(title_text_length > 64) {
    title_text_length = 64;
  }
} chain (Doc title_text_document) {
  string text = document_text_string(title_text_first_text, 0, title_text_length);
} return string text;
(Doc(Body([Para(Text([104, 105], [Run(2, 0, -1)], 0), Lay([], [], -1), 0), Para(Text([1], [Run(1, 0, -1)], 0), Lay([], [], -1), 0)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext([], [], []))):("hi")
