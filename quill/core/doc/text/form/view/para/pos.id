pos_eq(Pos pa, Pos pb) {
  int res = pa.para == pb.para && pa.off == pb.off;
} return int res;
(Pos(1, 2), Pos(1, 2)):(1)
(Pos(1, 2), Pos(1, 3)):(0)
(Pos(1, 2), Pos(2, 2)):(0)

// Document order: an earlier paragraph first, then an earlier offset.
pos_lt(Pos pa, Pos pb) {
  int res = pa.para < pb.para || (pa.para == pb.para && pa.off < pb.off);
} return int res;
(Pos(1, 2), Pos(1, 3)):(1)
(Pos(1, 9), Pos(2, 0)):(1)
(Pos(2, 0), Pos(1, 9)):(0)
(Pos(1, 3), Pos(1, 3)):(0)

// The code points lo..hi-1 of the text as a string; a code point that is not valid UTF-8 text, and 0, become U+FFFD and nothing as utf8_str says.
text_str(Text t, int lo, int hi) {
  string text = "";
  int i = lo;
  while(i < hi) {
    text = text + utf8_str(t.cps[i]);
    i = i + 1;
  }
} return string text;
(Text([104, 105, 8364], [Run(3, 0, -1)], 0), 0, 3):("hi€")
(Text([104, 105, 8364], [Run(3, 0, -1)], 0), 1, 2):("i")
(Text([104, 105], [Run(2, 0, -1)], 0), 1, 1):("")
