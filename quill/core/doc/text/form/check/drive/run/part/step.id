// Which operation to run next, drawn from quill_script_roll, except that a document of more than 12 paragraphs only joins or removes and one of more than 400 code points only deletes or joins, so it stays small.
script_kind(Doc kind_pick_document, Model kind_pick_model, int[] random_generator_seed) {
  int kind_pick_roll = document_random_below(random_generator_seed, len((import quill_script_roll)));
  int kind = (import quill_script_roll)[kind_pick_roll];
  if(doc_count(kind_pick_document) > 12) {
    kind = 6 + 2 * document_random_below(random_generator_seed, 2);
  }
} chain (Doc kind_pick_document, Model kind_pick_model, int[] random_generator_seed) {
  if(len(kind_pick_model.cps) > 400) {
    kind = 1 + 5 * document_random_below(random_generator_seed, 2);
  }
} return int kind;
