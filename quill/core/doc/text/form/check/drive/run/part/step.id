// The most runs any paragraph has.
document_maximum_runs(Doc runs_maximum_document) {
  int runs_maximum_result = 0;
  int runs_maximum_index = 0;
  while(runs_maximum_index < len(runs_maximum_document.body.paras)) {
    runs_maximum_result = fixed_point_maximum(runs_maximum_result, len(runs_maximum_document.body.paras[runs_maximum_index].txt.runs));
    runs_maximum_index = runs_maximum_index + 1;
  }
} return int runs_maximum_result;
