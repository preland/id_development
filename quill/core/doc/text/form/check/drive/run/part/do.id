// Runs operation kind (see quill_script_roll).
script_do(Doc d, Model mo, int[] rg, int kind) {
  if(kind == 0) {
    op_insert(d, mo, rg);
  }
  if(kind == 1) {
    op_delete(d, mo, rg);
  }
  if(kind == 2) {
    op_runs(d, mo, rg);
  }
} chain (Doc d, Model mo, int[] rg, int kind) {
  if(kind == 3) {
    op_patch(d, mo, rg);
  }
  if(kind == 4) {
    op_bits(d, mo, rg);
  }
  if(kind == 5) {
    op_split(d, mo, rg);
  }
} chain (Doc d, Model mo, int[] rg, int kind) {
  if(kind == 6) {
    op_join(d, mo, rg);
  }
  if(kind == 7) {
    op_newpara(d, mo, rg);
  }
  if(kind == 8) {
    op_remove(d, mo, rg);
  }
} chain (Doc d, Model mo, int[] rg, int kind) {
  if(kind == 9) {
    op_merge(d, mo, rg);
  }
} return void;
