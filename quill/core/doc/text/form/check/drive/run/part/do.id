// Runs operation kind (see quill_script_roll).
script_do(Doc script_dispatch_document, Model script_dispatch_model, int[] random_generator_seed, int kind) {
  if(kind == 0) {
    document_operation_insert(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
  if(kind == 1) {
    document_operation_delete(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
  if(kind == 2) {
    document_operation_runs(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
} chain (Doc script_dispatch_document, Model script_dispatch_model, int[] random_generator_seed, int kind) {
  if(kind == 3) {
    document_operation_patch(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
  if(kind == 4) {
    document_operation_bits(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
  if(kind == 5) {
    document_operation_split(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
} chain (Doc script_dispatch_document, Model script_dispatch_model, int[] random_generator_seed, int kind) {
  if(kind == 6) {
    document_operation_join(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
  if(kind == 7) {
    document_operation_new_paragraph(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
  if(kind == 8) {
    document_operation_remove(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
} chain (Doc script_dispatch_document, Model script_dispatch_model, int[] random_generator_seed, int kind) {
  if(kind == 9) {
    document_operation_merge(script_dispatch_document, script_dispatch_model, random_generator_seed);
  }
} return void;
