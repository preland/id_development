// Records what a step did in sx = [verify code, kinds seen as a bit mask, most paragraphs, most code points, most runs in one paragraph].
script_note(Doc script_record_document, Model script_record_model, int[] script_record_statistics, int kind) {
  script_record_statistics[1] = script_record_statistics[1] | (1 << kind);
  script_record_statistics[2] = fixed_point_maximum(script_record_statistics[2], doc_count(script_record_document));
  script_record_statistics[3] = fixed_point_maximum(script_record_statistics[3], len(script_record_model.cps));
} chain (Doc script_record_document, Model script_record_model, int[] script_record_statistics, int kind) {
  script_record_statistics[4] = fixed_point_maximum(script_record_statistics[4], document_maximum_runs(script_record_document));
} return void;
