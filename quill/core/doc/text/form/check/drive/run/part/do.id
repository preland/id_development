// Records what a step did in sx = [verify code, kinds seen as a bit mask, most paragraphs, most code points, most runs in one paragraph].
script_note(Doc d, Model mo, int[] sx, int kind) {
  sx[1] = sx[1] | (1 << kind);
  sx[2] = fixed_point_maximum(sx[2], doc_count(d));
  sx[3] = fixed_point_maximum(sx[3], len(mo.cps));
} chain (Doc d, Model mo, int[] sx, int kind) {
  sx[4] = fixed_point_maximum(sx[4], max_runs(d));
} return void;
