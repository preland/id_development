// Gives the document n hyperlink targets, so runs in a script may link.
document_extras_add_links(Ext links_add_extras, int n) {
  int links_add_index = 0;
  while(links_add_index < n) {
    push(links_add_extras.links, "link" + links_add_index);
    links_add_index = links_add_index + 1;
  }
} return void;
