// 0 when every document invariant holds and the document agrees with the model, the invariant's code when one fails, and -1 when only the model disagrees.
script_verify(Doc verify_state_document, Model verify_state_model) {
  int verify_state_result = doc_check(verify_state_document);
  if(verify_state_result == 0 && model_same(verify_state_document, verify_state_model) == 0) {
    verify_state_result = -1;
  }
} return int verify_state_result;
