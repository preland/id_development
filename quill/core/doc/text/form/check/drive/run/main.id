// One step: pick an operation, run it on the document and the model, note it, and check both again.
script_step(Doc step_run_document, Model step_run_model, int[] random_generator_seed, int[] step_run_statistics) {
  int kind = script_kind(step_run_document, step_run_model, random_generator_seed);
  script_do(step_run_document, step_run_model, random_generator_seed, kind);
  script_note(step_run_document, step_run_model, step_run_statistics, kind);
} chain (Doc step_run_document, Model step_run_model, int[] random_generator_seed, int[] step_run_statistics) {
  step_run_statistics[0] = script_verify(step_run_document, step_run_model);
} return void;
