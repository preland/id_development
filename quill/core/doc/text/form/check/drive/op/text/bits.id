// Turn one flag bit on, off or unset over a random range.
document_operation_bits(Doc flags_any_document, Model flags_any_model, int[] random_generator_seed) {
  int para = pick_para(flags_any_document, random_generator_seed);
  Para flags_any_paragraph = flags_any_document.body.paras[para];
  int bits = 1 << document_random_below(random_generator_seed, 6);
} chain (Doc flags_any_document, Model flags_any_model, int[] random_generator_seed) {
  int on = document_random_below(random_generator_seed, 3) - 1;
  int[] span_bounds = [0, 0];
  document_random_span(random_generator_seed, document_paragraph_length(flags_any_paragraph), span_bounds);
} chain (Doc flags_any_document, Model flags_any_model, int[] random_generator_seed) {
  int flags_any_flat_index = flat_at(flags_any_document, para, span_bounds[0]);
  model_patch(flags_any_model, flags_any_document.fmt.chars, flags_any_flat_index, span_bounds[1] - span_bounds[0], bits, on, (import quill_mode_bits));
  text_apply((flags_any_paragraph.txt), (span_bounds[0]), (span_bounds[1]), (flags_any_document.fmt.chars), bits, on, (import quill_mode_bits));
} return void;
