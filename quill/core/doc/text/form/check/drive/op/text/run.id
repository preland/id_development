// Give a random range random runs: character rows, and links of -1, 0 or 1.
document_operation_runs(Doc runs_any_document, Model runs_any_model, int[] random_generator_seed) {
  int para = pick_para(runs_any_document, random_generator_seed);
  Para runs_any_paragraph = runs_any_document.body.paras[para];
  int[] runs = [];
} chain (Doc runs_any_document, Model runs_any_model, int[] random_generator_seed) {
  int[] span_bounds = [0, 0];
  document_random_span(random_generator_seed, document_paragraph_length(runs_any_paragraph), span_bounds);
  rand_runs(random_generator_seed, span_bounds[1] - span_bounds[0], tab_count(runs_any_document.fmt.chars), runs);
} chain (Doc runs_any_document, Model runs_any_model, int[] random_generator_seed) {
