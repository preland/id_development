// Set one character field over a random range.
document_operation_patch(Doc patch_any_document, Model patch_any_model, int[] random_generator_seed) {
  int para = pick_para(patch_any_document, random_generator_seed);
  Para patch_any_paragraph = patch_any_document.body.paras[para];
  int pick = document_random_below(random_generator_seed, len((import quill_script_patch)) / 2) * 2;
} chain (Doc patch_any_document, Model patch_any_model, int[] random_generator_seed) {
  int[] span_bounds = [0, 0];
  document_random_span(random_generator_seed, document_paragraph_length(patch_any_paragraph), span_bounds);
  int patch_any_flat_index = flat_at(patch_any_document, para, span_bounds[0]);
} chain (Doc patch_any_document, Model patch_any_model, int[] random_generator_seed) {
  int key = (import quill_script_patch)[pick];
  int patch_any_value = (import quill_script_patch)[pick + 1];
  model_patch(patch_any_model, patch_any_document.fmt.chars, patch_any_flat_index, span_bounds[1] - span_bounds[0], key, patch_any_value, (import quill_mode_field));
} chain (Doc patch_any_document, Model patch_any_model, int[] random_generator_seed) {
  text_apply(patch_any_paragraph.txt, span_bounds[0], span_bounds[1], patch_any_document.fmt.chars, key, patch_any_value, (import quill_mode_field));
} return void;
