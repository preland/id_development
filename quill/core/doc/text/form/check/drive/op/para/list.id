// A paragraph of the given letters, typed with character row cprop into an empty text, with a random paragraph row.
rand_para(int[] random_generator_seed, Doc paragraph_random_document, int[] paragraph_random_code_points, int paragraph_random_character_row) {
  Text paragraph_random_text = text_new(0);
  text_insert(paragraph_random_text, 0, paragraph_random_code_points, paragraph_random_character_row);
  int paragraph_random_paragraph_row = document_random_below(random_generator_seed, tab_count(paragraph_random_document.fmt.paras));
} chain (int[] random_generator_seed, Doc paragraph_random_document, int[] paragraph_random_code_points, int paragraph_random_character_row) {
  Para paragraph_random_paragraph = para_make(paragraph_random_text, paragraph_random_paragraph_row);
} return Para paragraph_random_paragraph;
