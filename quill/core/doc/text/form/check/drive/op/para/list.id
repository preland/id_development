// Insert a new random paragraph at a random index.
document_operation_new_paragraph(Doc new_paragraph_document, Model new_paragraph_model, int[] random_generator_seed) {
  int index = document_random_below(random_generator_seed, doc_count(new_paragraph_document) + 1);
  int[] new_paragraph_code_points = document_random_code_points(random_generator_seed);
  int new_paragraph_character_row = document_random_below(random_generator_seed, tab_count(new_paragraph_document.fmt.chars));
} chain (Doc new_paragraph_document, Model new_paragraph_model, int[] random_generator_seed) {
  Para new_paragraph_paragraph = rand_para(random_generator_seed, new_paragraph_document, new_paragraph_code_points, new_paragraph_character_row);
  int new_paragraph_flat_index = flat_at(new_paragraph_document, index, 0);
  int[] ins = list_copy(new_paragraph_code_points);
} chain (Doc new_paragraph_document, Model new_paragraph_model, int[] random_generator_seed) {
  push(ins, -1);
  document_model_insert(new_paragraph_model, new_paragraph_flat_index, ins, new_paragraph_character_row, -1);
  body_insert(new_paragraph_document.body, index, new_paragraph_paragraph);
} return void;
