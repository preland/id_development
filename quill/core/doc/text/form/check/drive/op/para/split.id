// Split a random paragraph at a random offset.
document_operation_split(Doc split_any_document, Model split_any_model, int[] random_generator_seed) {
  int para = pick_para(split_any_document, random_generator_seed);
  Para split_any_paragraph = split_any_document.body.paras[para];
  int off = document_random_below(random_generator_seed, document_paragraph_length(split_any_paragraph) + 1);
} chain (Doc split_any_document, Model split_any_model, int[] random_generator_seed) {
  int split_any_flat_index = flat_at(split_any_document, para, off);
  int[] split_any_separator = [-1];
  document_model_insert(split_any_model, split_any_flat_index, split_any_separator, -1, -1);
} chain (Doc split_any_document, Model split_any_model, int[] random_generator_seed) {
  body_split(split_any_document.body, para, off);
} return void;
