// Join a random paragraph with the next one, when there is a next one.
document_operation_join(Doc join_any_document, Model join_any_model, int[] random_generator_seed) {
  int join_any_total = doc_count(join_any_document);
  if(join_any_total > 1) {
    document_operation_join_at(join_any_document, join_any_model, document_random_below(random_generator_seed, join_any_total - 1));
  }
} return void;
