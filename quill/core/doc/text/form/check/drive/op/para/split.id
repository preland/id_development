// Join paragraph para with the next one: the paragraph mark after it leaves the model.
document_operation_join_at(Doc join_at_document, Model join_at_model, int para) {
  int join_at_flat_index = flat_at(join_at_document, para, document_paragraph_length(join_at_document.body.paras[para]));
  document_model_delete(join_at_model, join_at_flat_index, 1);
  body_join(join_at_document.body, para);
} return void;
