// Remove paragraph index with its paragraph mark.
op_remove_at(Doc d, Model mo, int index) {
  int k = flat_at(d, index, 0);
  model_del(mo, k, para_len(d.body.paras[index]) + 1);
  body_remove(d.body, index);
} return void;
