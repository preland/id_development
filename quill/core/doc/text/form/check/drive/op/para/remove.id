// Remove a random paragraph, unless it is the only one.
document_operation_remove(Doc remove_any_document, Model remove_any_model, int[] random_generator_seed) {
  int remove_any_total = doc_count(remove_any_document);
  if(remove_any_total > 1) {
    document_operation_remove_at(remove_any_document, remove_any_model, document_random_below(random_generator_seed, remove_any_total));
  }
} return void;
