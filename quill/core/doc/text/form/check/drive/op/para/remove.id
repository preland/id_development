// Remove paragraph index with its paragraph mark.
document_operation_remove_at(Doc remove_at_document, Model remove_at_model, int index) {
  int remove_at_flat_index = flat_at(remove_at_document, index, 0);
  document_model_delete(remove_at_model, remove_at_flat_index, document_paragraph_length(remove_at_document.body.paras[index]) + 1);
  body_remove(remove_at_document.body, index);
} return void;
