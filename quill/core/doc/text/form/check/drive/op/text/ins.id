// Delete a random range of one paragraph (nothing in an empty one).
op_delete(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  int[] sp = [0, 0];
} chain (Doc d, Model mo, int[] rg) {
  rng_span(rg, para_len(p), sp);
  int k = flat_at(d, para, sp[0]);
  model_del(mo, k, sp[1] - sp[0]);
} chain (Doc d, Model mo, int[] rg) {
  text_delete(p.txt, sp[0], sp[1]);
} return void;
