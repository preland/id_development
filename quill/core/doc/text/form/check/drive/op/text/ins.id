// One random step of the script, each applied to the document and to the model: type 1 to 4 letters somewhere.
op_insert(Doc d, Model mo, int[] rg) {
  int para = pick_para(d, rg);
  Para p = d.body.paras[para];
  int[] cps = rand_cps(rg);
} chain (Doc d, Model mo, int[] rg) {
  int off = rng_below(rg, para_len(p) + 1);
  int cprop = rng_below(rg, tab_count(d.fmt.chars));
  int k = flat_at(d, para, off);
} chain (Doc d, Model mo, int[] rg) {
  int lk = ins_link(mo, k, off, para_len(p));
  model_ins(mo, k, cps, cprop, lk);
  text_insert(p.txt, off, cps, cprop);
} return void;
