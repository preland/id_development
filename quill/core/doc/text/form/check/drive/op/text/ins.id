// One random step of the script, each applied to the document and to the model: type 1 to 4 letters somewhere.
document_operation_insert(Doc insert_any_document, Model insert_any_model, int[] random_generator_seed) {
  int para = pick_para(insert_any_document, random_generator_seed);
  Para insert_any_paragraph = insert_any_document.body.paras[para];
  int[] insert_any_code_points = document_random_code_points(random_generator_seed);
} chain (Doc insert_any_document, Model insert_any_model, int[] random_generator_seed) {
  int off = document_random_below(random_generator_seed, document_paragraph_length(insert_any_paragraph) + 1);
  int cprop = document_random_below(random_generator_seed, tab_count(insert_any_document.fmt.chars));
  int insert_any_flat_index = flat_at(insert_any_document, para, off);
} chain (Doc insert_any_document, Model insert_any_model, int[] random_generator_seed) {
  int insert_any_link_value = ins_link(insert_any_model, insert_any_flat_index, off, document_paragraph_length(insert_any_paragraph));
  document_model_insert(insert_any_model, insert_any_flat_index, insert_any_code_points, cprop, insert_any_link_value);
  text_insert(insert_any_paragraph.txt, off, insert_any_code_points, cprop);
} return void;
