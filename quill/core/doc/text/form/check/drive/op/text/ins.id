// Delete a random range of one paragraph (nothing in an empty one).
document_operation_delete(Doc delete_any_document, Model delete_any_model, int[] random_generator_seed) {
  int para = pick_para(delete_any_document, random_generator_seed);
  Para delete_any_paragraph = delete_any_document.body.paras[para];
  int[] span_bounds = [0, 0];
} chain (Doc delete_any_document, Model delete_any_model, int[] random_generator_seed) {
  document_random_span(random_generator_seed, document_paragraph_length(delete_any_paragraph), span_bounds);
  int delete_any_flat_index = flat_at(delete_any_document, para, span_bounds[0]);
  document_model_delete(delete_any_model, delete_any_flat_index, span_bounds[1] - span_bounds[0]);
} chain (Doc delete_any_document, Model delete_any_model, int[] random_generator_seed) {
  text_delete(delete_any_paragraph.txt, span_bounds[0], span_bounds[1]);
} return void;
