// A random range inside a paragraph of n code points, as sp = [lo, hi]; [0, 0] when there is no text.
document_random_span(int[] random_generator_seed, int random_interval_limit, int[] span_bounds) {
  span_bounds[0] = 0;
  span_bounds[1] = 0;
  if(random_interval_limit > 0) {
    document_random_pair(random_generator_seed, random_interval_limit, span_bounds);
  }
} return void;
([1], 0, [7, 7]):([1], 0, [0, 0])
([1], 10, [0, 0]):([377401575], 10, [8, 9])

// One to four random lower case letters.
document_random_code_points(int[] random_generator_seed) {
  int[] random_text_code_points = [];
  int random_text_count = 1 + document_random_below(random_generator_seed, 4);
  int random_text_index = 0;
} chain (int[] random_generator_seed) {
  while(random_text_index < random_text_count) {
    push(random_text_code_points, 97 + document_random_below(random_generator_seed, 26));
    random_text_index = random_text_index + 1;
  }
} return int[] random_text_code_points;
([3]):([106, 114, 115, 101])
([9]):([98])

// Appends a run triple of the given length with a random character row below nc and a random link of -1, 0 or 1.
run_triple(int[] random_generator_seed, int triple_push_row_count, int piece, int[] runs) {
  push(runs, piece);
  push(runs, document_random_below(random_generator_seed, triple_push_row_count));
  push(runs, document_random_below(random_generator_seed, 3) - 1);
} return void;
([1], 8, 2, []):([377401575], 8, 2, [2, 6, 0])
([1], 8, 5, [9]):([377401575], 8, 5, [9, 5, 6, 0])
