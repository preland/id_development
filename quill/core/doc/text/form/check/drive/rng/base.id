// A linear congruential generator over a one-cell list, so every run of the script is the same run. The next state is kept below 2^31.
document_random_next(int[] random_generator_seed) {
  random_generator_seed[0] = (random_generator_seed[0] * 1103515245 + 12345) & 2147483647;
  int random_step_result = random_generator_seed[0];
} return int random_step_result;
([1]):(1103527590)
([0]):(12345)

// A number from 0 to n - 1, from the upper bits, which are the better ones.
document_random_below(int[] random_generator_seed, int random_range_limit) {
  int random_range_raw = document_random_next(random_generator_seed);
  int got = random_range_raw / 65536 % random_range_limit;
} return int got;
([1], 10):(8)
([5], 4):(3)

// Sets sp to a range lo..hi with 0 <= lo < hi <= n.
document_random_pair(int[] random_generator_seed, int random_bounds_limit, int[] span_bounds) {
  int random_bounds_lower_bound = document_random_below(random_generator_seed, random_bounds_limit);
  int random_bounds_width = document_random_below(random_generator_seed, random_bounds_limit - random_bounds_lower_bound);
  span_bounds[0] = random_bounds_lower_bound;
} chain (int[] random_generator_seed, int random_bounds_limit, int[] span_bounds) {
  span_bounds[1] = random_bounds_lower_bound + 1 + random_bounds_width;
} return void;
([1], 10, [0, 0]):([377401575], 10, [8, 9])
([7], 6, [0, 0]):([642666333], 6, [4, 5])
