// The link text inserted at flat index k, offset off of a paragraph of plen code points, takes: the one both neighbours have, as text_link does for runs.
ins_link(Model link_for_insert_model, int link_for_insert_flat_index, int off, int paragraph_length_value) {
  int link_for_insert_link_value = -1;
  if(off > 0 && off < paragraph_length_value && link_for_insert_model.links[link_for_insert_flat_index - 1] == link_for_insert_model.links[link_for_insert_flat_index]) {
    link_for_insert_link_value = link_for_insert_model.links[link_for_insert_flat_index];
  }
} return int link_for_insert_link_value;
