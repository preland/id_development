// Appends random run triples that cover n code points; for n = 0 one empty triple, which sets the properties of an empty paragraph.
rand_runs(int[] rg, int n, int nc, int[] runs) {
  int left = n;
  if(n == 0) {
    run_triple(rg, nc, 0, runs);
  }
  while(left > 0) {
    int piece = 1 + rng_below(rg, left);
    run_triple(rg, nc, piece, runs);
    left = left - piece;
  }
} return void;
