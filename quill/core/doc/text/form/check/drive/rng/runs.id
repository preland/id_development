// Appends random run triples that cover n code points; for n = 0 one empty triple, which sets the properties of an empty paragraph.
rand_runs(int[] random_generator_seed, int random_run_list_limit, int random_run_list_row_count, int[] runs) {
  int left = random_run_list_limit;
  if(random_run_list_limit == 0) {
    run_triple(random_generator_seed, random_run_list_row_count, 0, runs);
  }
  while(left > 0) {
    int piece = 1 + document_random_below(random_generator_seed, left);
    run_triple(random_generator_seed, random_run_list_row_count, piece, runs);
    left = left - piece;
  }
} return void;
([2], 3, 8, []):([671064393], 3, 8, [3, 1, -1])
([5], 5, 8, []):([1387050425], 5, 8, [1, 1, 1, 2, 1, 1, 1, 3, 0, 1, 5, 1])
([4], 0, 8, []):([1583775778], 0, 8, [0, 1, 0])

// The index in the flattened document (see Model) of offset off in paragraph para; para may be the paragraph count, which gives the end.
flat_at(Doc flat_offset_document, int para, int off) {
  int at = off;
  int flat_offset_index = 0;
  while(flat_offset_index < para) {
    at = at + document_paragraph_length(flat_offset_document.body.paras[flat_offset_index]) + 1;
    flat_offset_index = flat_offset_index + 1;
  }
} return int at;
