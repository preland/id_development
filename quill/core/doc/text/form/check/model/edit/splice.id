// A new list: xs with the m entries from index k replaced by ins. Built from slices, not by moving entries in place, so it shares no logic with list_splice.
model_splice(int[] splice_values_values, int splice_values_flat_index, int splice_values_count, int[] ins) {
  int[] splice_values_collected = list_slice(splice_values_values, 0, splice_values_flat_index);
  list_extend(splice_values_collected, ins);
  int[] tail_values = list_slice(splice_values_values, splice_values_flat_index + splice_values_count, len(splice_values_values) - splice_values_flat_index - splice_values_count);
} chain (int[] splice_values_values, int splice_values_flat_index, int splice_values_count, int[] ins) {
  list_extend(splice_values_collected, tail_values);
} return int[] splice_values_collected;
([1, 2, 3, 4], 1, 2, [9]):([1, 9, 4])
([1, 2], 2, 0, [7, 8]):([1, 2, 7, 8])
([1, 2, 3], 0, 3, []):([])

// ins with every entry except the -1 marks replaced by v.
document_repeat_like(int[] ins, int got) {
  int[] repeat_like_collected = [];
  int repeat_like_index = 0;
  while(repeat_like_index < len(ins)) {
    push(repeat_like_collected, got);
    repeat_like_index = repeat_like_index + 1;
  }
} chain (int[] ins, int got) {
  repeat_like_index = 0;
  while(repeat_like_index < len(ins)) {
    if(ins[repeat_like_index] == -1) {
      repeat_like_collected[repeat_like_index] = -1;
    }
    repeat_like_index = repeat_like_index + 1;
  }
} return int[] repeat_like_collected;
([4, 5, -1], 7):([7, 7, -1])
([-1], 3):([-1])
([], 3):([])
