// n copies of v.
rep_list(int got, int n) {
  int[] xs = [];
  list_fill(xs, n, got);
} return int[] xs;
(7, 3):([7, 7, 7])
(7, 0):([])

// Appends one entry per code point the run covers: its character row (which 1) or its link (which 2).
flat_fill(int[] acc, Run ru, int which) {
  int got = ru.cprop;
  if(which == 2) {
    got = ru.link;
  }
  list_extend(acc, rep_list(got, ru.len));
} return void;
([9], Run(2, 5, 3), 1):([9, 5, 5], Run(2, 5, 3), 1)
([9], Run(2, 5, 3), 2):([9, 3, 3], Run(2, 5, 3), 2)

flat_runs(Run[] rs, int which, int[] acc) {
  int i = 0;
  while(i < len(rs)) {
    flat_fill(acc, rs[i], which);
    i = i + 1;
  }
} return void;
([Run(1, 5, -1), Run(2, 6, 3)], 1, []):([Run(1, 5, -1), Run(2, 6, 3)], 1, [5, 6, 6])
([Run(1, 5, -1), Run(2, 6, 3)], 2, [0]):([Run(1, 5, -1), Run(2, 6, 3)], 2, [0, -1, 3, 3])
