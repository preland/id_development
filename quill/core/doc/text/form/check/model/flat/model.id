(Doc(Body([Para(Text([], [Run(0, 0, -1)], 0), Lay([], [], -1), 0)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext([], [], []))):(Model([-1], [-1], [-1]))

// 1 when the document's flattened code points, character rows and links all equal the model's.
model_same(Doc model_compare_document, Model model_compare_model) {
  int model_compare_result = document_integers_equal(flat_of(model_compare_document, 0), model_compare_model.cps);
  if(model_compare_result == 1) {
    model_compare_result = document_integers_equal(flat_of(model_compare_document, 1), model_compare_model.cprops);
  }
  if(model_compare_result == 1) {
    model_compare_result = document_integers_equal(flat_of(model_compare_document, 2), model_compare_model.links);
  }
} return int model_compare_result;
