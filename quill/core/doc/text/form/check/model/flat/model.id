(Doc(Body([Para(Text([], [Run(0, 0, -1)], 0), Lay([], [], -1), 0)], Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 0), Fmt(Tab([], 7, []), Tab([], 12, []), Sty([], [], 0)), Ext([], [], []))):(Model([-1], [-1], [-1]))

// 1 when the document's flattened code points, character rows and links all equal the model's.
model_same(Doc d, Model mo) {
  int res = ints_eq(flat_of(d, 0), mo.cps);
  if(res == 1) {
    res = ints_eq(flat_of(d, 1), mo.cprops);
  }
  if(res == 1) {
    res = ints_eq(flat_of(d, 2), mo.links);
  }
} return int res;
