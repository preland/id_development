document_integers_equal(int[] integers_compare_first_values, int[] integers_compare_second_values) {
  int integers_compare_result = len(integers_compare_first_values) == len(integers_compare_second_values);
  int integers_compare_index = 0;
  while(integers_compare_index < len(integers_compare_first_values) && integers_compare_result == 1) {
    integers_compare_result = integers_compare_first_values[integers_compare_index] == integers_compare_second_values[integers_compare_index];
    integers_compare_index = integers_compare_index + 1;
  }
} return int integers_compare_result;
([1, 2], [1, 2]):(1)
([1, 2], [1, 3]):(0)
([1, 2], [1, 2, 3]):(0)

model_new(Doc model_make_document) {
  int[] flat_characters = flat_of(model_make_document, 0);
  int[] flat_character_rows = flat_of(model_make_document, 1);
  int[] flat_links = flat_of(model_make_document, 2);
} chain (Doc model_make_document) {
  Model model_make_model = Model(flat_characters, flat_character_rows, flat_links);
} return Model model_make_model;
