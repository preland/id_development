ints_eq(int[] xs, int[] ys) {
  int res = len(xs) == len(ys);
  int i = 0;
  while(i < len(xs) && res == 1) {
    res = xs[i] == ys[i];
    i = i + 1;
  }
} return int res;
([1, 2], [1, 2]):(1)
([1, 2], [1, 3]):(0)
([1, 2], [1, 2, 3]):(0)

model_new(Doc d) {
  int[] fc = flat_of(d, 0);
  int[] fp = flat_of(d, 1);
  int[] fl = flat_of(d, 2);
} chain (Doc d) {
  Model mo = Model(fc, fp, fl);
} return Model mo;
