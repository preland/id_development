// 2 when the slot count is not a power of two, 3 when the rows fill more than half the slots (a probe could then never end).
tab_shape(Tab shape_verify_table, int shape_verify_row_count) {
  int shape_verify_slot_count = len(shape_verify_table.slots);
  int code = 0;
  if(shape_verify_slot_count == 0 || (shape_verify_slot_count & (shape_verify_slot_count - 1)) != 0) {
    code = 2;
  }
} chain (Tab shape_verify_table, int shape_verify_row_count) {
  if(code == 0 && shape_verify_row_count * 2 > shape_verify_slot_count) {
    code = 3;
  }
} return int code;
(Tab([], 2, [0, 0, 0, 0]), 0):(0)
(Tab([], 2, [0, 0, 0]), 0):(2)
(Tab([], 2, [0, 0, 0, 0]), 3):(3)

// 4 when some row is not found at its own id: interned rows are unique and found again.
tab_rows_ok(Tab rows_verify_table, int rows_verify_row_count) {
  int code = 0;
  int rows_verify_index = 0;
  while(rows_verify_index < rows_verify_row_count && code == 0) {
    int found = tab_find(rows_verify_table, tab_row(rows_verify_table, rows_verify_index));
    if(found != rows_verify_index) {
      code = 4;
    }
    rows_verify_index = rows_verify_index + 1;
  }
} return int code;
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), 2):(0)
(Tab([5, 6, 5, 6], 2, [0, 0, 1, 2, 0, 0, 0, 0]), 2):(4)
(Tab([5, 6], 2, [0, 0, 0, 0, 0, 0, 0, 0]), 1):(4)

// The invariants of an interning table, 0 when they hold: rows are whole (1), the slot count is a power of two (2) and at most half used (3), and every row is found at its own id (4).
tab_check(Tab table_verify_table) {
  int code = 0;
  int table_verify_row_count = len(table_verify_table.rows) / table_verify_table.width;
  if(table_verify_row_count * table_verify_table.width != len(table_verify_table.rows)) {
    code = 1;
  }
} chain (Tab table_verify_table) {
  if(code == 0) {
    code = tab_shape(table_verify_table, table_verify_row_count);
  }
  if(code == 0) {
    code = tab_rows_ok(table_verify_table, table_verify_row_count);
  }
} return int code;
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0])):(0)
(Tab([5, 6, 7], 2, [0, 0, 1, 0, 0, 0, 0, 0])):(1)
(Tab([5, 6, 7, 8], 2, [1, 2])):(3)
(Tab([5, 6, 5, 6], 2, [0, 0, 1, 2, 0, 0, 0, 0])):(4)
