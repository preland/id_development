runs_total(Run[] runs_length_run_list) {
  int runs_length_total = 0;
  int runs_length_index = 0;
  while(runs_length_index < len(runs_length_run_list)) {
    runs_length_total = runs_length_total + runs_length_run_list[runs_length_index].len;
    runs_length_index = runs_length_index + 1;
  }
} return int runs_length_total;
([Run(2, 0, -1), Run(3, 5, -1)]):(5)
([]):(0)

// What is wrong with run i, 0 when nothing is: 3 an empty run in a paragraph that has text, 5 the same properties as the run before it.
run_flaw(Text run_defect_text, int run_defect_index) {
  int code = 0;
  if(run_defect_text.runs[run_defect_index].len <= 0 && len(run_defect_text.cps) > 0) {
    code = 3;
  }
  if(run_defect_index > 0 && run_same(run_defect_text.runs[run_defect_index - 1], run_defect_text.runs[run_defect_index]) == 1) {
    code = 5;
  }
} return int code;
(Text([1, 2], [Run(1, 0, -1), Run(0, 5, -1), Run(1, 0, -1)], 0), 1):(3)
(Text([1, 2], [Run(1, 0, -1), Run(1, 0, -1)], 0), 1):(5)
(Text([1, 2], [Run(1, 0, -1), Run(1, 5, -1)], 0), 1):(0)

text_scan(Text text_scan_runs_text) {
  int code = 0;
  int text_scan_runs_index = 0;
  while(text_scan_runs_index < len(text_scan_runs_text.runs) && code == 0) {
    code = run_flaw(text_scan_runs_text, text_scan_runs_index);
    text_scan_runs_index = text_scan_runs_index + 1;
  }
} return int code;
(Text([1, 2], [Run(1, 0, -1), Run(1, 5, -1)], 0)):(0)
(Text([1, 2], [Run(1, 0, -1), Run(1, 0, -1)], 0)):(5)
(Text([1, 2], [Run(2, 0, -1), Run(0, 5, -1)], 0)):(3)
