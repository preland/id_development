tab_count(Tab rows_count_table) {
  int rows_count_total = len(rows_count_table.rows) / rows_count_table.width;
} return int rows_count_total;
(Tab([1, 2, 3, 4, 5, 6], 3, [])):(2)
(Tab([], 7, [])):(0)

// 1 when some run has a character row that does not exist or a link that is not in ext.links.
runs_bad(Run[] runs_invalid_run_list, int runs_invalid_character_count, int link_count) {
  int bad = 0;
  int runs_invalid_index = 0;
  while(runs_invalid_index < len(runs_invalid_run_list)) {
    if(runs_invalid_run_list[runs_invalid_index].cprop < 0 || runs_invalid_run_list[runs_invalid_index].cprop >= runs_invalid_character_count || runs_invalid_run_list[runs_invalid_index].link < -1 || runs_invalid_run_list[runs_invalid_index].link >= link_count) {
      bad = 1;
    }
    runs_invalid_index = runs_invalid_index + 1;
  }
} return int bad;
([Run(1, 0, -1), Run(1, 2, 0)], 3, 1):(0)
([Run(1, 0, -1), Run(1, 3, 0)], 3, 1):(1)
([Run(1, 0, 1)], 3, 1):(1)
([Run(1, -1, -1)], 3, 1):(1)

// The invariants of paragraph i: its text's (text_check), then 6 for a run that points at a missing character row or link and 7 for a paragraph row that does not exist.
para_check(Doc paragraph_check_document, int paragraph_check_index) {
  Para paragraph_check_paragraph = paragraph_check_document.body.paras[paragraph_check_index];
  int paragraph_check_character_count = tab_count(paragraph_check_document.fmt.chars);
  int code = text_check(paragraph_check_paragraph.txt);
} chain (Doc paragraph_check_document, int paragraph_check_index) {
  if(code == 0 && runs_bad(paragraph_check_paragraph.txt.runs, paragraph_check_character_count, len(paragraph_check_document.ext.links)) == 1) {
    code = 6;
  }
  if(code == 0 && (paragraph_check_paragraph.pprop < 0 || paragraph_check_paragraph.pprop >= tab_count(paragraph_check_document.fmt.paras))) {
    code = 7;
  }
} return int code;
