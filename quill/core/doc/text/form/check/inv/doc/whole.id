// 8 when there is no paragraph, else (i + 1) * 16 plus para_check's code for the first paragraph i that breaks an invariant.
body_check(Doc body_verify_document) {
  int code = 0;
  int body_verify_index = 0;
  if(len(body_verify_document.body.paras) == 0) {
    code = 8;
  }
} chain (Doc body_verify_document) {
  while(body_verify_index < len(body_verify_document.body.paras) && code == 0) {
    int body_verify_paragraph_code = para_check(body_verify_document, body_verify_index);
    if(body_verify_paragraph_code != 0) {
      code = (body_verify_index + 1) * 16 + body_verify_paragraph_code;
    }
    body_verify_index = body_verify_index + 1;
  }
} return int code;
