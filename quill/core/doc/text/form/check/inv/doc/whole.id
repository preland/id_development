// Every invariant of a document, 0 when they hold: the tables (tab_check, plus 100 for the paragraph table) and then the body (body_check).
doc_check(Doc document_verify_document) {
  int code = tab_check(document_verify_document.fmt.chars);
  int document_verify_table_code = tab_check(document_verify_document.fmt.paras);
  if(code == 0 && document_verify_table_code != 0) {
    code = 100 + document_verify_table_code;
  }
} chain (Doc document_verify_document) {
  if(code == 0) {
    code = body_check(document_verify_document);
  }
} return int code;
