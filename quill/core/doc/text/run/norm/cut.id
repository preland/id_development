// Splits run i so that its first cut code points stay in it and the rest become a new run after it.
run_halve(Text run_divide_text, int run_divide_run_index, int cut) {
  Run run_divide_run = run_divide_text.runs[run_divide_run_index];
  Run run_divide_new_run = Run(run_divide_run.len - cut, run_divide_run.cprop, run_divide_run.link);
  run_divide_run.len = cut;
} chain (Text run_divide_text, int run_divide_run_index, int cut) {
  document_runs_insert(run_divide_text.runs, run_divide_run_index + 1, run_divide_new_run);
} return void;
(Text([1, 2, 3], [Run(3, 4, 5)], 0), 0, 1):(Text([1, 2, 3], [Run(1, 4, 5), Run(2, 4, 5)], 0), 0, 1)
(Text([1, 2, 3], [Run(1, 0, -1), Run(2, 4, 5), Run(0, 9, -1)], 0), 1, 1):(Text([1, 2, 3], [Run(1, 0, -1), Run(1, 4, 5), Run(1, 4, 5), Run(0, 9, -1)], 0), 1, 1)

// The index of the run that starts at off, after splitting the run i that holds it if it began earlier.
run_split(Text run_split_at_text, int run_split_at_run_index, int off) {
  int at = run_start(run_split_at_text, run_split_at_run_index);
  int run_split_at_result = run_split_at_run_index;
  if(at < off) {
    run_halve(run_split_at_text, run_split_at_run_index, off - at);
    run_split_at_result = run_split_at_run_index + 1;
  }
} return int run_split_at_result;
(Text([1, 2, 3], [Run(3, 0, -1)], 0), 0, 2):(1) then calls run_halve:[1]
(Text([1, 2, 3], [Run(1, 0, -1), Run(2, 0, -1)], 0), 1, 1):(1) then calls run_halve:[0]
