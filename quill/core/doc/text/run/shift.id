// Inserts ru so that it sits at index at; at may be len(rs).
document_runs_insert(Run[] runs_insert_run_list, int at, Run runs_insert_run) {
  push(runs_insert_run_list, runs_insert_run);
  int runs_insert_index = len(runs_insert_run_list) - 1;
  while(runs_insert_index > at) {
    runs_insert_run_list[runs_insert_index] = runs_insert_run_list[runs_insert_index - 1];
    runs_insert_index = runs_insert_index - 1;
  }
} chain (Run[] runs_insert_run_list, int at, Run runs_insert_run) {
  runs_insert_run_list[at] = runs_insert_run;
} return void;
([Run(1, 0, -1)], 0, Run(2, 3, 4)):([Run(2, 3, 4), Run(1, 0, -1)], 0, Run(2, 3, 4))
([Run(1, 0, -1)], 1, Run(2, 3, 4)):([Run(1, 0, -1), Run(2, 3, 4)], 1, Run(2, 3, 4))
([Run(1, 0, -1), Run(2, 0, -1)], 1, Run(9, 9, 9)):([Run(1, 0, -1), Run(9, 9, 9), Run(2, 0, -1)], 1, Run(9, 9, 9))

// Removes the n runs that start at index at.
document_runs_remove(Run[] runs_remove_run_list, int at, int runs_remove_count) {
  int runs_remove_index = at;
  int runs_remove_removed_count = 0;
  while(runs_remove_index + runs_remove_count < len(runs_remove_run_list)) {
    runs_remove_run_list[runs_remove_index] = runs_remove_run_list[runs_remove_index + runs_remove_count];
    runs_remove_index = runs_remove_index + 1;
  }
} chain (Run[] runs_remove_run_list, int at, int runs_remove_count) {
  while(runs_remove_removed_count < runs_remove_count) {
    pop(runs_remove_run_list);
    runs_remove_removed_count = runs_remove_removed_count + 1;
  }
} return void;
([Run(1, 0, -1), Run(2, 1, -1), Run(3, 2, -1)], 1, 1):([Run(1, 0, -1), Run(3, 2, -1)], 1, 1)
([Run(1, 0, -1), Run(2, 1, -1), Run(3, 2, -1)], 0, 2):([Run(3, 2, -1)], 0, 2)
([Run(1, 0, -1), Run(2, 1, -1)], 2, 0):([Run(1, 0, -1), Run(2, 1, -1)], 2, 0)
