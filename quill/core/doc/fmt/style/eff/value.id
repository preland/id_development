  int got = tab_get(effective_character_format_set.chars, effective_character_character_row, field);
  int effective_character_character_style = tab_get(effective_character_format_set.chars, effective_character_character_row, (import quill_character_style));
  if(got == -1 && effective_character_character_style > 0) {
    got = style_up(effective_character_format_set, effective_character_character_style, 0, field);
  }
} chain (Fmt effective_character_format_set, int effective_character_paragraph_style, int effective_character_character_row, int field) {
  if(got == -1) {
    got = style_up(effective_character_format_set, effective_character_paragraph_style, 0, field);
  }
  if(field == (import quill_character_on)) {
    got = style_bits(effective_character_format_set, effective_character_paragraph_style, effective_character_character_row);
  }
  if(field == (import quill_character_set)) {
    got = (import quill_flag_all);
  }
} return int got;
