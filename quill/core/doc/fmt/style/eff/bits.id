// The effective flag bits of a run: its own, then its character style chain, then the paragraph style chain, each bit decided by the first layer that specifies it.
style_bits(Fmt bits_effective_format_set, int bits_effective_paragraph_style, int bits_effective_character_row) {
  int on = tab_get(bits_effective_format_set.chars, bits_effective_character_row, (import quill_character_on));
  int specified_bits = tab_get(bits_effective_format_set.chars, bits_effective_character_row, (import quill_character_set));
  int bits_effective_character_style = tab_get(bits_effective_format_set.chars, bits_effective_character_row, (import quill_character_style));
} chain (Fmt bits_effective_format_set, int bits_effective_paragraph_style, int bits_effective_character_row) {
  int fold = bits_fold(0, on, specified_bits);
  if(bits_effective_character_style > 0) {
    fold = style_fold(bits_effective_format_set, bits_effective_character_style, fold);
  }
  fold = style_fold(bits_effective_format_set, bits_effective_paragraph_style, fold);
} chain (Fmt bits_effective_format_set, int bits_effective_paragraph_style, int bits_effective_character_row) {
  int bits_effective_result = fold & 255;
} return int bits_effective_result;
