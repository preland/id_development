style_find(Fmt f, string name) {
  int res = -1;
  int i = 0;
  while(i < len(f.sty.styles) && res < 0) {
    if(f.sty.styles[i].name == name) {
      res = i;
    }
    i = i + 1;
  }
} return int res;
