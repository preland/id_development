style_find(Fmt style_lookup_format_set, string name) {
  int style_lookup_result = -1;
  int style_lookup_style_index = 0;
  while(style_lookup_style_index < len(style_lookup_format_set.sty.styles) && style_lookup_result < 0) {
    if(style_lookup_format_set.sty.styles[style_lookup_style_index].name == name) {
      style_lookup_result = style_lookup_style_index;
    }
    style_lookup_style_index = style_lookup_style_index + 1;
  }
} return int style_lookup_result;
