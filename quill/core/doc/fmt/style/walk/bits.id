// Folds one layer's flags into fold, highest priority layer first: a bit takes its value from the first layer that specifies it. fold is one int, the flags decided so far in its low 8 bits and the bits that are decided from bit 8 up, so no list is made and none is passed around.
bits_fold(int fold, int on, int specified_bits) {
  int seen = fold >> 8;
  int add = specified_bits & ~seen;
  int fold_layer_result = (fold & 255) | (on & add);
} chain (int fold, int on, int specified_bits) {
  int next_fold = fold_layer_result | ((seen | specified_bits) << 8);
} return int next_fold;
