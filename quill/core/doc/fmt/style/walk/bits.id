style_fold(Fmt fold_chain_format_set, int fold_chain_style_identifier, int fold) {
  int fold_chain_style_index = fold_chain_style_identifier;
  int fold_chain_step_count = 0;
  int kept = fold;
} chain (Fmt fold_chain_format_set, int fold_chain_style_identifier, int fold) {
  while(fold_chain_style_index >= 0 && fold_chain_step_count < (import quill_style_depth)) {
