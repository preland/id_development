// The value of a field in style s's own row: its character row when which is 0, its paragraph row when which is 1. -1 means that style leaves it unset.
style_cell(Fmt cell_read_format_set, int cell_read_style_index, int which, int field) {
  Tab cell_read_table = style_tab(cell_read_format_set, which);
  int[] style_row_identifiers = cell_read_format_set.sty.styles[cell_read_style_index].fmt;
  int got = tab_get(cell_read_table, style_row_identifiers[which], field);
} return int got;
