// The first value that is not -1 for a field, walking from style sid up through its parents; -1 for sid -1, and a chain longer than quill_style_depth (a cycle) ends the walk.
style_up(Fmt walk_up_format_set, int walk_up_style_identifier, int which, int field) {
  int got = -1;
  int walk_up_style_index = walk_up_style_identifier;
  int walk_up_step_count = 0;
} chain (Fmt walk_up_format_set, int walk_up_style_identifier, int which, int field) {
  while(walk_up_style_index >= 0 && got == -1 && walk_up_step_count < (import quill_style_depth)) {
    got = style_cell(walk_up_format_set, walk_up_style_index, which, field);
    walk_up_style_index = walk_up_format_set.sty.styles[walk_up_style_index].rel[(import quill_style_parent)];
    walk_up_step_count = walk_up_step_count + 1;
  }
} return int got;
