// An empty table of rows of the given width; eight slots to start with.
tab_new(int width) {
  int[] rows = [];
  int[] slot_list = [0, 0, 0, 0, 0, 0, 0, 0];
  Tab table_make_table = Tab(rows, width, slot_list);
} return Tab table_make_table;
(3):(Tab([], 3, [0, 0, 0, 0, 0, 0, 0, 0]))
(12):(Tab([], 12, [0, 0, 0, 0, 0, 0, 0, 0]))

// The id of the row equal to row, adding it when it is new; -1 for a row that is not width ints long.
tab_intern(Tab row_intern_table, int[] row) {
  int row_intern_row_identifier = tab_find(row_intern_table, row);
  if(row_intern_row_identifier < 0 && len(row) == row_intern_table.width) {
    row_intern_row_identifier = len(row_intern_table.rows) / row_intern_table.width;
    tab_add(row_intern_table, row);
  }
} return int row_intern_row_identifier;
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [7, 8]):(1) then calls tab_add:[0]
(Tab([5, 6], 2, [0, 0, 1, 0, 0, 0, 0, 0]), [7, 8]):(1) then calls tab_add:[1]
(Tab([5, 6], 2, [0, 0, 1, 0, 0, 0, 0, 0]), [7]):(-1) then calls tab_add:[0]

tab_get(Tab row_get_table, int row_get_row_identifier, int field) {
  int at = row_get_row_identifier * row_get_table.width + field;
  int got = row_get_table.rows[at];
} return int got;
(Tab([1, 2, 3, 4, 5, 6], 3, []), 1, 2):(6)
(Tab([1, 2, 3, 4, 5, 6], 3, []), 0, 0):(1)
