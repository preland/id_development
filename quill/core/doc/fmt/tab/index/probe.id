tab_same(Tab rows_same_table, int rows_same_row_identifier, int[] row) {
  int at = rows_same_row_identifier * rows_same_table.width;
  int rows_same_index = 0;
  while(rows_same_index < rows_same_table.width && rows_same_table.rows[at + rows_same_index] == row[rows_same_index]) {
    rows_same_index = rows_same_index + 1;
  }
} chain (Tab rows_same_table, int rows_same_row_identifier, int[] row) {
  int rows_same_result = rows_same_index == rows_same_table.width;
} return int rows_same_result;
(Tab([1, 2, 3, 4], 2, []), 1, [3, 4]):(1)
(Tab([1, 2, 3, 4], 2, []), 0, [1, 9]):(0)

// -1 when the row is not in the table, and for a row of the wrong width.
tab_find(Tab row_find_table, int[] row) {
  int row_find_result = -1;
  int row_find_slot_index = tab_home(row_find_table, row);
  int row_find_slot_value = row_find_table.slots[row_find_slot_index];
} chain (Tab row_find_table, int[] row) {
  while(row_find_slot_value != 0 && row_find_result < 0 && len(row) == row_find_table.width) {
    int same = tab_same(row_find_table, row_find_slot_value - 1, row);
    if(same == 1) {
      row_find_result = row_find_slot_value - 1;
    } else {
      row_find_slot_index = (row_find_slot_index + 1) & (len(row_find_table.slots) - 1);
      row_find_slot_value = row_find_table.slots[row_find_slot_index];
    }
  }
} return int row_find_result;
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [7, 8]):(1)
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [5, 6]):(0)
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [9, 9]):(-1)
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [5]):(-1)
