tab_same(Tab tb, int id, int[] row) {
  int at = id * tb.width;
  int i = 0;
  while(i < tb.width && tb.rows[at + i] == row[i]) {
    i = i + 1;
  }
} chain (Tab tb, int id, int[] row) {
  int res = i == tb.width;
} return int res;
(Tab([1, 2, 3, 4], 2, []), 1, [3, 4]):(1)
(Tab([1, 2, 3, 4], 2, []), 0, [1, 9]):(0)

// -1 when the row is not in the table, and for a row of the wrong width.
tab_find(Tab tb, int[] row) {
  int res = -1;
  int k = tab_home(tb, row);
  int sn = tb.slots[k];
} chain (Tab tb, int[] row) {
  while(sn != 0 && res < 0 && len(row) == tb.width) {
    int same = tab_same(tb, sn - 1, row);
    if(same == 1) {
      res = sn - 1;
    } else {
      k = (k + 1) & (len(tb.slots) - 1);
      sn = tb.slots[k];
    }
  }
} return int res;
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [7, 8]):(1)
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [5, 6]):(0)
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [9, 9]):(-1)
(Tab([5, 6, 7, 8], 2, [0, 0, 1, 2, 0, 0, 0, 0]), [5]):(-1)
