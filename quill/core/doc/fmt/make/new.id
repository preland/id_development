// A table of character rows, a table of paragraph rows and no styles or lists yet; fmt_default fills in the built-in ones.
document_format_new() {
  Tab format_make_character_table = tab_new((import quill_character_width));
  Tab format_make_paragraph_table = tab_new((import quill_paragraph_width));
  Style[] style_array = [];
} chain () {
  ListDef[] format_make_lists = [];
  Sty style_set = Sty(style_array, format_make_lists, 0);
  Fmt format_make_format_set = Fmt(format_make_character_table, format_make_paragraph_table, style_set);
} return Fmt format_make_format_set;
():(Fmt(Tab([], 7, [0, 0, 0, 0, 0, 0, 0, 0]), Tab([], 12, [0, 0, 0, 0, 0, 0, 0, 0]), Sty([], [], 0)))
():(Fmt(Tab([], 7, [0, 0, 0, 0, 0, 0, 0, 0]), Tab([], 12, [0, 0, 0, 0, 0, 0, 0, 0]), Sty([], [], 0))) then calls tab_new:[2]

// Row id 0 of each table is the row with nothing set.
document_format_base(Fmt base_intern_format_set) {
  tab_intern(base_intern_format_set.chars, (import quill_row_character_default));
  tab_intern(base_intern_format_set.paras, (import quill_row_paragraph_default));
} return void;
