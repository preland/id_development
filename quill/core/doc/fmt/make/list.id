document_format_default(Fmt default_fill_format_set) {
  if(len(default_fill_format_set.sty.styles) == 0) {
    document_format_base(default_fill_format_set);
    document_format_styles(default_fill_format_set);
    document_format_lists(default_fill_format_set);
