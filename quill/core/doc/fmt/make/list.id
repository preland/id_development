// List id 0 means "no list", so index 0 is a placeholder and the built-in bullet and number lists are 1 and 2.
fmt_lists(Fmt f) {
  int[] none = [];
  fmt_list(f, "", none, 0);
  fmt_list(f, (import quill_list_names)[0], (import quill_list_bullet), 0);
} chain (Fmt f) {
  fmt_list(f, (import quill_list_names)[1], (import quill_list_number), 1);
} return void;
