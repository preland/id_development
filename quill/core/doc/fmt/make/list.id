// List id 0 means "no list", so index 0 is a placeholder and the built-in bullet and number lists are 1 and 2.
document_format_lists(Fmt lists_make_format_set) {
  int[] none = [];
  document_format_list(lists_make_format_set, "", none, 0);
  document_format_list(lists_make_format_set, (import quill_list_names)[0], (import quill_list_bullet), 0);
} chain (Fmt lists_make_format_set) {
  document_format_list(lists_make_format_set, (import quill_list_names)[1], (import quill_list_number), 1);
} return void;
