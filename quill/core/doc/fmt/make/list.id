fmt_list(Fmt f, string name, int[] levels, int kind) {
  int[] lv = list_copy(levels);
  ListDef ld = ListDef(name, lv, kind);
  ListDef[] ls = f.sty.lists;
} chain (Fmt f, string name, int[] levels, int kind) {
  push(ls, ld);
} return void;
