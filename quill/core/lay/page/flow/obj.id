// 1 when paragraph lgi stands for an object the model keeps untouched: an opaque block (paragraph kind 1) or a paragraph that holds nothing but an inline object's marker, a picture on a line of its own.
lay_is_obj(Doc lgd, int lgi) {
  Para lgpa = lgd.body.paras[lgi];
  int lgk = tab_get(lgd.fmt.paras, lgpa.pprop, (import quill_paragraph_kind));
  int lgn = len(lgpa.txt.cps);
} chain (Doc lgd, int lgi) {
  int lgo = lgk == 1 || (lgn == 1 && lgpa.txt.cps[0] >= (import quill_object_marker));
} return int lgo;
