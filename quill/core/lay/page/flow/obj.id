// The height in lu of the box that stands for paragraph lgi in the flow: quill_layout_object_height for an object, 0 for any other paragraph.
lay_obj_h(Doc lgd, int lgi) {
  int lgo = lay_is_obj(lgd, lgi);
  int lgh = lgo * (import quill_layout_object_height);
