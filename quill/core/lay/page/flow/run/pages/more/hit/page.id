// The page that line lhj of paragraph lhi is on: the last page that starts at or before that line.
// By hand: 28 letters in lines of 3 fill 10 lines, 8 to a page, so lines 0 to 7 are on page 0 and 8 and 9 on page 1; of 8 one-line paragraphs 6 fit a page, so paragraph 5 is on page 0 and 6 on page 1.
lay_page_of(View hit_view, int target_paragraph, int target_line) {
  int target_page = 0;
  int scanned_page = 0;
  while(scanned_page < hit_view.pages.count) {
    if(lay_before(hit_view.pages.starts[2 * scanned_page], hit_view.pages.starts[2 * scanned_page + 1], target_paragraph, target_line) == 1) {
      target_page = scanned_page;
    }
    scanned_page = scanned_page + 1;
  }
} return int target_page;
given layout_page_test_text("AAAAAAAAAAAAAAAAAAAAAAAAAAAA") ((import layout_paragraph_test_view), 0, 7):(0)
given layout_page_test_text("AAAAAAAAAAAAAAAAAAAAAAAAAAAA") ((import layout_paragraph_test_view), 0, 8):(1)
