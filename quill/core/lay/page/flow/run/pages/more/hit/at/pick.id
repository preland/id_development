// Records line lhj of paragraph lhi in lhr, [paragraph, line, found], found being 1 when the line reaches below page height lhy, that is when it is the line that holds lhy or one below it.
// By hand: line 1 of "BBB EEE BBB" spans 1792 to 2944 on the page, so it reaches below 1000 and does not reach below 5000.
lay_visit(View hit_view, int target_paragraph, int target_line, int target_height, int[] result_list) {
  int reaches_below = lay_line_y(hit_view, target_paragraph, target_line) + layout_page_line_height(hit_view, target_paragraph, target_line) > target_height;
  lset(result_list, 0, target_paragraph);
  lset(result_list, 1, target_line);
} chain (View hit_view, int target_paragraph, int target_line, int target_height, int[] result_list) {
  lset(result_list, 2, reaches_below);
} return void;
