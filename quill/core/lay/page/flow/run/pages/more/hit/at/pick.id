// Which lines of paragraph lhi are on page lhk: lhr becomes [first line, line after the last]. A paragraph that carries on from the page before starts at the line the page starts at, one that goes on past the page ends at the line the next page starts at.
// By hand: the 28-letter paragraph has lines 0 to 7 on page 0 and 8 and 9 on page 1; of 8 one-line paragraphs, paragraph 7 is on page 1 with its line 0.
lay_span(View hit_view, int target_page, int target_paragraph, int[] result_list) {
  int span_first_line = 0;
  int span_end_line = len(hit_view.doc.body.paras[target_paragraph].lay.lines) / (import quill_line_stride);
  if(hit_view.pages.starts[2 * target_page] == target_paragraph) {
    span_first_line = hit_view.pages.starts[2 * target_page + 1];
  }
} chain (View hit_view, int target_page, int target_paragraph, int[] result_list) {
  if(hit_view.pages.starts[2 * target_page + 2] == target_paragraph) {
    span_end_line = hit_view.pages.starts[2 * target_page + 3];
  }
  lset(result_list, 0, span_first_line);
  lset(result_list, 1, span_end_line);
} return void;
