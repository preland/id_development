// The offset on line lhj of paragraph lhi whose pen is nearest to lhx, in lu from the left edge of the text area.
// By hand: line 1 of "BBB EEE BBB" has its offsets 4 to 7 at 0, 683, 1366 and 2049: 700 is nearest 683, offset 5; 1100 is nearer 1366 than 683, offset 6; left of everything is the first, 4; far to the right is the last, 7.
lay_off_at(View hit_view, int target_paragraph, int target_line, int target_x) {
  Para line_paragraph = hit_view.doc.body.paras[target_paragraph];
  int best_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_low)];
  int last_offset = layout_page_maximum_offset(line_paragraph, target_line);
} chain (View hit_view, int target_paragraph, int target_line, int target_x) {
  int candidate_offset = best_offset;
  while(candidate_offset <= last_offset) {
    if(fixed_point_absolute(line_paragraph.lay.pen[candidate_offset] - target_x) < fixed_point_absolute(line_paragraph.lay.pen[best_offset] - target_x)) {
      best_offset = candidate_offset;
    }
    candidate_offset = candidate_offset + 1;
  }
} return int best_offset;
