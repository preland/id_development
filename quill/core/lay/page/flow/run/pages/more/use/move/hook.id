// Does the move lhdir of unit lhunit from the caret of lhs into lho: a page for the page unit, a line up or down for dir 1 and -1, the end or the start of the line for dir 2 and -2. lhg is the x of the page the caret aims for, lhs.goal the one that was kept.
// By hand: unit 4 with dir 1 is a page down; unit 2 with dir 1 a line down, with dir 2 the end of the line, with dir -2 its start.
lay_dispatch(View hit_view, Sel moving_selection, int layout_direction, int move_unit, int aim_x, Pos output_position) {
  if(move_unit == (import ed_u_page)) {
    lay_page_move(hit_view, moving_selection.caret, layout_direction, aim_x, output_position);
  }
  if(move_unit == (import ed_u_line) && fixed_point_absolute(layout_direction) == 1) {
    lay_move_line(hit_view, moving_selection.caret, layout_direction, moving_selection.goal, output_position);
  }
  if(move_unit == (import ed_u_line) && layout_direction == 2) {
    lay_line_end(hit_view, moving_selection.caret, output_position);
  }
} chain (View hit_view, Sel moving_selection, int layout_direction, int move_unit, int aim_x, Pos output_position) {
  if(move_unit == (import ed_u_line) && layout_direction == -2) {
    lay_line_start(hit_view, moving_selection.caret, output_position);
  }
} return void;
