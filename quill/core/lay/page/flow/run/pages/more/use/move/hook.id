// The function ed_move calls for the line and page units once lay_hook_install has run: it moves the caret of lhs by one line (unit line, dir 1 and -1), to the end or the start of its line (dir 2 and -2) or by one page (unit page), the anchor staying, and keeps the x the caret aims for in lhs.goal across the vertical moves, which a horizontal one forgets (sel_put).
// By hand in "BBB", "A", "BBB": a line down from offset 2 of paragraph 0, x 2560 + 1366 = 3926, is offset 1 of paragraph 1 with the goal 3926 kept; the end of the line from offset 6 of "BBB EEE BBB" is 7 and the goal is unset.
lay_hook(Doc hook_document, Sel moving_selection, int layout_direction, int move_unit) {
  View hit_view = (import layout_page_hook_view);
  Pos output_position = Pos(moving_selection.caret.para, moving_selection.caret.off);
  int aim_x = lay_goal(hit_view, moving_selection.caret, moving_selection.goal) + lay_margin(hit_view.doc, 3);
} chain (Doc hook_document, Sel moving_selection, int layout_direction, int move_unit) {
  lay_dispatch(hit_view, moving_selection, layout_direction, move_unit, aim_x, output_position);
  editor_selection_put(moving_selection, output_position.para, output_position.off, 1);
  int moves_one_step = fixed_point_absolute(layout_direction) == 1;
} chain (Doc hook_document, Sel moving_selection, int layout_direction, int move_unit) {
  if(moves_one_step == 1) {
    moving_selection.goal = aim_x;
  }
} return void;
