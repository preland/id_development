// 1 when the walk may stop: the page it opened last starts where the old pagination lwo had its page of that number (lay_same), and there is such an old page, and the paragraph count is what it was (lay_moved), so that the numbers mean the same paragraphs.
// By hand: after paginating 8 paragraphs, the page 1 starting at paragraph 6 matches an old page 1 at 6 once the changed paragraphs, up to 3, are behind it, and does not when they go up to 6, nor when the old document had 9 paragraphs, nor when the old pagination had one page only.
lay_stable(View layout_walk_view, int[] old_starts, int last_changed_paragraph) {
  int last_page_index = layout_walk_view.pages.count - 1;
  int walk_may_stop = 0;
  if(last_page_index < len(old_starts) / 2 - 1 && lay_moved(layout_walk_view, old_starts) == 0) {
    walk_may_stop = lay_same(layout_walk_view, old_starts, last_page_index, last_changed_paragraph);
  }
} return int walk_may_stop;
