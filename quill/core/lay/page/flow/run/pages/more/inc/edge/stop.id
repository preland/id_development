// 1 when page lwj starts where the old pagination lwo has its page lwj, and past the last changed paragraph lwl, so that nothing after it can differ.
// By hand: page 1 starts at paragraph 6, line 0; the old one at 6, 0 matches it past paragraph 3, not past 6, and one at 6, 1 or at 7, 0 never.
lay_same(View layout_walk_view, int[] old_starts, int compared_page, int last_changed_paragraph) {
  int[] new_starts = layout_walk_view.pages.starts;
  int same_start = old_starts[2 * compared_page] == new_starts[2 * compared_page] && old_starts[2 * compared_page + 1] == new_starts[2 * compared_page + 1];
  int past_last_changed = new_starts[2 * compared_page] > last_changed_paragraph;
} chain (View layout_walk_view, int[] old_starts, int compared_page, int last_changed_paragraph) {
  int walk_may_stop = same_start * past_last_changed;
} return int walk_may_stop;
