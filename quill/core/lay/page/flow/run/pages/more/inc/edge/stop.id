// Puts the old pages that come after the ones just walked back, and the sentinel: the walk stopped because a page started as it did, so the rest is as it was.
// By hand: with page 0 walked and the old pages 0 and 6 of 8 paragraphs, the page at 6 and the sentinel 8 come back.
lay_tail(View layout_walk_view, int[] old_starts) {
  int old_page_total = len(old_starts) / 2 - 1;
  int restored_page = layout_walk_view.pages.count;
  while(restored_page < old_page_total) {
    push(layout_walk_view.pages.starts, old_starts[2 * restored_page]);
    push(layout_walk_view.pages.starts, old_starts[2 * restored_page + 1]);
    restored_page = restored_page + 1;
  }
} chain (View layout_walk_view, int[] old_starts) {
  layout_walk_view.pages.count = old_page_total;
  push(layout_walk_view.pages.starts, len(layout_walk_view.doc.body.paras));
  push(layout_walk_view.pages.starts, 0);
} return void;
