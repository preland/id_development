// Records in lhr, [paragraph, line], the line one step from line lhj of paragraph lhi, up (lhd -1) or down (1): the next line of the paragraph, or the first line of the next paragraph, or the last line of the one before; the same line when there is none.
// By hand: in "BBB", "A", "BBB" every paragraph has one line, so a step down from paragraph 0 is paragraph 1; in "BBB EEE BBB" a step down from line 0 is line 1 and from line 2 there is none.
lay_step(View hit_view, int target_paragraph, int target_line, int step_direction, int[] result_list) {
  integer_list_set(result_list, 0, target_paragraph);
  integer_list_set(result_list, 1, target_line);
  lay_cross(hit_view, target_paragraph, target_line, step_direction, result_list);
} return void;
given layout_page_test_rows(["BBB", "A", "BBB"]) ((import layout_paragraph_test_view), 0, 0, 1, [9, 9]):((import layout_paragraph_test_view), 0, 0, 1, [1, 0])
given layout_page_test_text("BBB EEE BBB") ((import layout_paragraph_test_view), 0, 0, 1, [9, 9]):((import layout_paragraph_test_view), 0, 0, 1, [0, 1])
given layout_page_test_text("BBB EEE BBB") ((import layout_paragraph_test_view), 0, 2, 1, [9, 9]):((import layout_paragraph_test_view), 0, 2, 1, [0, 2])

// Puts in lhr, [paragraph, line], line lhj + lhd of the paragraph when it has one, and the line beyond it in the next paragraph (lay_next) when it has not.
// By hand: "BBB EEE BBB" has lines 0 to 2, so from line 1 a step down is line 2 and from line 2 it leaves the paragraph.
lay_cross(View hit_view, int target_paragraph, int target_line, int step_direction, int[] result_list) {
  int line_total = len(hit_view.doc.body.paras[target_paragraph].lay.lines) / (import quill_line_stride);
  if(target_line + step_direction >= 0 && target_line + step_direction < line_total) {
    integer_list_set(result_list, 1, target_line + step_direction);
  } else {
    lay_next(hit_view, target_paragraph, step_direction, result_list);
  }
} return void;
given layout_page_test_text("BBB EEE BBB") ((import layout_paragraph_test_view), 0, 1, 1, [0, 1]):((import layout_paragraph_test_view), 0, 1, 1, [0, 2])
given layout_page_test_rows(["BBB EEE BBB", "A"]) ((import layout_paragraph_test_view), 0, 2, 1, [0, 2]):((import layout_paragraph_test_view), 0, 2, 1, [1, 0])
given layout_page_test_rows(["BBB EEE BBB", "A"]) ((import layout_paragraph_test_view), 1, 0, -1, [1, 0]):((import layout_paragraph_test_view), 1, 0, -1, [0, 2])

// Puts in lhr, [paragraph, line], the first line of paragraph lhi + lhd when stepping down, or its last line when stepping up, and leaves lhr alone when there is no such paragraph.
// By hand: with "BBB EEE BBB" and "A", a step up out of paragraph 1 is line 2 of paragraph 0; a step down out of paragraph 1 has nowhere to go.
lay_next(View hit_view, int target_paragraph, int step_direction, int[] result_list) {
  int next_paragraph = target_paragraph + step_direction;
  if(next_paragraph >= 0 && next_paragraph < len(hit_view.doc.body.paras)) {
    integer_list_set(result_list, 0, next_paragraph);
    integer_list_set(result_list, 1, (step_direction < 0) * (len(hit_view.doc.body.paras[next_paragraph].lay.lines) / (import quill_line_stride) - 1));
  }
} return void;
