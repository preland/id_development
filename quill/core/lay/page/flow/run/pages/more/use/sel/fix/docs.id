// Test setup: a view over n one-line paragraphs, laid out and paginated, on the sheet of 1500 by 3000 twips with margins 150, 300, 450 and 600 (top, right, bottom, left): a text area 2560 lu wide and 10240 high, so 6 paragraphs of 1664 lu (6 * 1664 = 9984 fits, 7 * 1664 does not) fill a page: 3 make one page, 8 make two, 120 make 20.
layout_page_test_paged(int paragraph_total) {
  layout_paragraph_test_font();
  layout_page_test_page(1500, 3000, 150, 300, 450, 600);
  layout_paragraph_test_paragraphs(paragraph_total);
} chain (int paragraph_total) {
  lay_all((import layout_paragraph_test_view));
  lay_paginate((import layout_paragraph_test_view), 0);
} return void;
(8):() then (import layout_paragraph_test_view).pages.count:(2)
(3):() then (import layout_paragraph_test_view).pages.starts:([0, 0, 3, 0])
(120):() then (import layout_paragraph_test_view).pages.count:(20)

// Test setup: a view over one paragraph of text lgtx on the same sheet as lg_t_paged, laid out and paginated. In lines of 2560 lu with 683 for a B, an E or an A and 285 for a space, "BBB EEE BBB" breaks into "BBB ", "EEE " and "BBB", and 28 A into 9 lines of 3 and one of 1, 8 lines to a page.
layout_page_test_text(string paragraph_text) {
  layout_page_test_rows([paragraph_text]);
} return void;
("BBB EEE BBB"):() then (import layout_paragraph_test_view).pages.starts:([0, 0, 1, 0])
("AAAAAAAAAAAAAAAAAAAAAAAAAAAA"):() then (import layout_paragraph_test_view).pages.starts:([0, 0, 0, 8, 1, 0])

// Test setup: a view with one paragraph for every text of lgtl, laid out and paginated on the sheet of lg_t_paged.
layout_page_test_rows(string[] text_list) {
  layout_paragraph_test_font();
  layout_page_test_page(1500, 3000, 150, 300, 450, 600);
  int paragraph_index = 0;
} chain (string[] text_list) {
  while(paragraph_index < len(text_list)) {
    layout_paragraph_test_insert(paragraph_index, text_list[paragraph_index]);
    if(paragraph_index + 1 < len(text_list)) {
      layout_paragraph_test_split(paragraph_index, len(text_list[paragraph_index]));
    }
    paragraph_index = paragraph_index + 1;
  }
  lay_all((import layout_paragraph_test_view));
  lay_paginate((import layout_paragraph_test_view), 0);
} return void;
(["AB", "C"]):() then len((import layout_paragraph_test_document).body.paras):(2)
(["AB"]):() then (import layout_paragraph_test_view).pages.starts:([0, 0, 1, 0])
