// Appends the four numbers of a rectangle, or of a caret, to lhc.
// By hand: appending 5, 6, 7, 8 to a list holding 9 gives 9, 5, 6, 7, 8.
lay_rect(int[] rectangle_list, int rect_first, int rect_second, int rect_third, int rect_fourth) {
  push(rectangle_list, rect_first);
  push(rectangle_list, rect_second);
  push(rectangle_list, rect_third);
} chain (int[] rectangle_list, int rect_first, int rect_second, int rect_third, int rect_fourth) {
  push(rectangle_list, rect_fourth);
} return void;
