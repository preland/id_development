// Where the caret is for position lhq: lhc becomes [page, x, y, height], x and y in lu from the top left corner of the page, the height that of the line. The pen of the offset gives x and the line gives y, as the glyphs are drawn, so caret and glyph agree.
// By hand in "BBB EEE BBB" (lines of 4, 4 and 3, B 683 wide, left margin 2560, top margin 640, lines of 1152): offset 5 is the second code point of line 1, at 2560 + 683 = 3243, 640 + 1152 = 1792 down; the end of the 28-letter paragraph is on page 1, after one letter of its last line.
lay_caret(View hit_view, Pos query_position, int[] caret_numbers) {
  Para line_paragraph = hit_view.doc.body.paras[query_position.para];
  int target_line = lay_line_in(line_paragraph, query_position.off);
  layout_paragraph_clear(caret_numbers);
} chain (View hit_view, Pos query_position, int[] caret_numbers) {
  lay_rect(caret_numbers, lay_page_of(hit_view, query_position.para, target_line), lay_margin(hit_view.doc, 3) + line_paragraph.lay.pen[query_position.off], lay_line_y(hit_view, query_position.para, target_line), layout_page_line_height(hit_view, query_position.para, target_line));
} return void;
