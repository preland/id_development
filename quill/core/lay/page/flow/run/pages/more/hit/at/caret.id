// The last offset a caret can have on line lhj of a paragraph: the end of the text on its last line, else the end of the visible text, before the spaces that hang past the edge, or the offset before the last code point of a line that broke inside a word, because the offset where the next line starts is that line's.
// By hand: in "BBB EEE BBB" in lines of 4, 4 and 3, line 0 ends at 3 (before its space), line 1 at 7 and line 2 at 11; four A in lines of 3 and 1, line 0 ends at 2.
layout_page_maximum_offset(Para line_paragraph, int target_line) {
  int line_low_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_low)];
  int line_high_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_high)];
  int visible_end = line_high_offset;
} chain (Para line_paragraph, int target_line) {
  if(line_high_offset < len(line_paragraph.txt.cps)) {
    visible_end = layout_paragraph_visible_end(line_paragraph, line_low_offset, line_high_offset);
  }
  if(visible_end == line_high_offset && line_high_offset < len(line_paragraph.txt.cps)) {
    visible_end = line_high_offset - 1;
  }
} return int visible_end;
