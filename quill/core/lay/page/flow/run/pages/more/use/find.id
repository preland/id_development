// Puts in lho the position one page up (lhdir -1) or down (1) from lhq at x lhg of the page, the same height on that page; past the first or the last page it is the start or the end of the document.
// By hand: with 6 one-line paragraphs to a page and 8 in all, a page down from paragraph 0 is paragraph 6 at the same height, a page up from paragraph 6 at x 3243 is offset 1 of paragraph 0, and a page down from page 1 is the end of the document, offset 1 of paragraph 7.
lay_page_move(View hit_view, Pos query_position, int layout_direction, int aim_x, Pos output_position) {
  int[] moving_caret_list = [0, 0, 0, 0];
  lay_caret(hit_view, query_position, moving_caret_list);
  int target_page = moving_caret_list[0] + layout_direction;
} chain (View hit_view, Pos query_position, int layout_direction, int aim_x, Pos output_position) {
  if(target_page >= 0 && target_page < hit_view.pages.count) {
    lay_hit(hit_view, target_page, aim_x, moving_caret_list[2], output_position);
  } else {
    Pos edge_position = editor_position_edge(hit_view.doc, layout_direction);
    output_position.para = edge_position.para;
    output_position.off = edge_position.off;
  }
} return void;
