// Records in lhr, [paragraph, line, found], the line of paragraph lhi that holds height lhy of page lhk, or its last line on the page when lhy is below them; found stays 0 until one is found. Only the lines that are on the page are looked at.
// By hand: in "BBB EEE BBB" height 1900 is on line 1; 9000 is below all of them, so line 2 without found; on page 1 of 28 letters in lines of 3 height 700 is above line 8, the first one there.
lay_pick_para(View hit_view, int target_page, int target_paragraph, int target_height, int[] result_list) {
  int[] span_list = [0, 0];
  lay_span(hit_view, target_page, target_paragraph, span_list);
  int target_line = span_list[0];
} chain (View hit_view, int target_page, int target_paragraph, int target_height, int[] result_list) {
  while(target_line < span_list[1] && result_list[2] == 0) {
    lay_visit(hit_view, target_paragraph, target_line, target_height, result_list);
    target_line = target_line + 1;
  }
} return void;
