// Notes that paragraph lwi was laid out again: the first one seen sets the first of lwr, [first, last, count], the last one seen the last, and the count goes up.
// By hand: noting 4 and then 7 on a fresh note gives [4, 7, 2].
lay_note(int[] relay_list, int layout_walk_paragraph) {
  if(relay_list[0] < 0) {
    integer_list_set(relay_list, 0, layout_walk_paragraph);
  }
  integer_list_set(relay_list, 1, layout_walk_paragraph);
  integer_list_set(relay_list, 2, relay_list[2] + 1);
} return void;
