// Lays out again every stale paragraph of the view in a text area lww lu wide and notes which ones in lwr, [first, last, count].
// By hand: three fresh paragraphs are all stale, so the note is [0, 2, 3]; after lay_all only the one that was edited is.
lay_relay_all(View layout_walk_view, int relay_width, int[] relay_list) {
  int layout_walk_paragraph = 0;
  while(layout_walk_paragraph < len(layout_walk_view.doc.body.paras)) {
    if(layout_walk_view.doc.body.paras[layout_walk_paragraph].lay.h < 0) {
      lay_one(layout_walk_view, layout_walk_paragraph, relay_width);
      lay_note(relay_list, layout_walk_paragraph);
    }
    layout_walk_paragraph = layout_walk_paragraph + 1;
  }
} return void;
