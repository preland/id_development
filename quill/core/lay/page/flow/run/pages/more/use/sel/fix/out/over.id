// Test setup: a view over the document of the edit fixtures (fx_setup), laid out and paginated on the default sheet, exported as lg_t_ov, with its layout installed for the line and page moves of ed_move (lay_hook_install).
lg_t_over() {
  gui_font_init();
  View lgv = lay_view((import fxd));
  export View lg_t_ov = lgv;
} chain () {
  lay_all(lgv);
  lay_paginate(lgv, 0);
  lay_hook_install(lgv);
} return void;
given fx_setup("BBB|A|BBB") ():() then ed_hook_probe:(2003)
given fx_setup("ab") ():() then ed_hook_probe:(2)
