// Test setup: a view over the document of the edit fixtures (fx_setup), laid out and paginated on the default sheet, exported as lg_t_ov, with its layout installed for the line and page moves of ed_move (lay_hook_install).
layout_page_test_over() {
  gui_font_state_create();
  View page_view = lay_view((import fixture_document));
  export View layout_page_test_over_view = page_view;
} chain () {
  lay_all(page_view);
  lay_paginate(page_view, 0);
  lay_hook_install(page_view);
} return void;
given editor_fixture_setup("BBB|A|BBB") ():() then editor_hook_probe:(2003)
