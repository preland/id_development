// Test check: how many offsets of paragraph lgi of the test view do not come back to themselves when the caret is put there (lay_caret) and a click is made at the middle of its line (lay_hit): 0 when the two agree on every offset.
// By hand: "BBB EEE BBB" has 12 offsets, 0 to 11, each of which must come back; the 28 A have 29, across the two pages.
lg_t_round(int lgi) {
  View lgv = (import lp_t_v);
  int lgn = len(lgv.doc.body.paras[lgi].txt.cps);
  int lgo = 0;
} chain (int lgi) {
  int lgbad = 0;
  while(lgo <= lgn) {
    lgbad = lgbad + lg_t_one(lgv, lgi, lgo);
    lgo = lgo + 1;
  }
} return int lgbad;
given lg_t_rows(["BBB EEE BBB", "A B", "EEE"]) (1):(0)
given lg_t_rows(["A B", "EEE", "BBB EEE BBB"]) (2):(0)
given lg_t_text("BBB EEE BBB") (0):(0)
given lg_t_text("AAAAAAAAAAAAAAAAAAAAAAAAAAAA") (0):(0)

// Test check: 1 when offset lgo of paragraph lgi, given a caret and then a click in the middle of the line the caret is on, is not the same position, 0 when it is.
// By hand: offset 5 of "BBB EEE BBB" is at 3243 across, 1792 down, 1152 high; a click at 3243 across and 2368 down is on line 1 and gives offset 5.
lg_t_one(View lgv, int lgi, int lgo) {
  int[] lgcl = [0, 0, 0, 0];
  Pos lgq = Pos(lgi, lgo);
  Pos lgpo = Pos(9, 9);
} chain (View lgv, int lgi, int lgo) {
  lay_caret(lgv, lgq, lgcl);
  lay_hit(lgv, lgcl[0], lgcl[1], lgcl[2] + lgcl[3] / 2, lgpo);
  int lgb = lgpo.para != lgi || lgpo.off != lgo;
} return int lgb;
given lg_t_text("BBB EEE BBB") ((import lp_t_v), 0, 5):(0)
given lg_t_text("BBB EEE BBB") ((import lp_t_v), 0, 11):(0)
