// Test check: 1 when offset lgo of paragraph lgi, given a caret and then a click in the middle of the line the caret is on, is not the same position, 0 when it is.
// By hand: offset 5 of "BBB EEE BBB" is at 3243 across, 1792 down, 1152 high; a click at 3243 across and 2368 down is on line 1 and gives offset 5.
layout_page_test_one(View page_view, int paragraph_index, int checked_offset) {
  int[] click_caret_list = [0, 0, 0, 0];
  Pos caret_position = Pos(paragraph_index, checked_offset);
  Pos click_position = Pos(9, 9);
} chain (View page_view, int paragraph_index, int checked_offset) {
  lay_caret(page_view, caret_position, click_caret_list);
  lay_hit(page_view, click_caret_list[0], click_caret_list[1], click_caret_list[2] + click_caret_list[3] / 2, click_position);
  int mismatch = click_position.para != paragraph_index || click_position.off != checked_offset;
} return int mismatch;
