// Test check: how many offsets of paragraph lgi of the test view do not come back to themselves when the caret is put there (lay_caret) and a click is made at the middle of its line (lay_hit): 0 when the two agree on every offset.
// By hand: "BBB EEE BBB" has 12 offsets, 0 to 11, each of which must come back; the 28 A have 29, across the two pages.
layout_page_test_round(int paragraph_index) {
  View page_view = (import layout_paragraph_test_view);
  int text_length = len(page_view.doc.body.paras[paragraph_index].txt.cps);
  int offset_index = 0;
} chain (int paragraph_index) {
  int mismatch_count = 0;
  while(offset_index <= text_length) {
    mismatch_count = mismatch_count + layout_page_test_one(page_view, paragraph_index, offset_index);
    offset_index = offset_index + 1;
  }
} return int mismatch_count;
