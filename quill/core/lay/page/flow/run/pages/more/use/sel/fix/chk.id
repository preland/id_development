// Test setup: appends text lgtx to paragraph lgi of the test document and marks the paragraph stale, as an edit does.
lg_t_edit(int lgi, string lgtx) {
  Doc lgd = (import lp_t_d);
  lp_t_ins(lgi, lgtx);
  para_stale(lgd.body.paras[lgi]);
} return void;
given lp_t_font given lp_t_ins(0, "A") given lay_all((import lp_t_v)) (0, "B"):() then lp_t_h0:(-1) then lp_t_c0:([65, 66])
