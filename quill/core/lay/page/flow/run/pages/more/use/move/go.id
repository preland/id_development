given layout_page_test_text("BBB EEE BBB") ((import layout_paragraph_test_view), Pos(0, 5), 4000):(1440)

// Puts in lho the position one line up (lhdir -1) or down (1) from lhq, at the offset whose pen is nearest to the goal lhg (the x of the page the caret aimed for when it started to move, -1 for the caret's own x). A caret on the first or last line stays where it is. The goal is not looked up again from the caret that results, so a short line in between does not shorten it (lay_goal is the caller's to keep).
// By hand in "BBB", "A", "BBB" (pens 0, 683, 1366 on the long lines): down from offset 2 of paragraph 0, x 1366, the short "A" gives offset 1; from there with the kept goal 3926 (1366 and the margin) the next gives offset 2 again, not 1.
lay_move_line(View hit_view, Pos query_position, int layout_direction, int aim_x, Pos output_position) {
  int target_line = lay_line_of(hit_view, query_position);
  int[] result_list = [0, 0];
  lay_step(hit_view, query_position.para, target_line, layout_direction, result_list);
} chain (View hit_view, Pos query_position, int layout_direction, int aim_x, Pos output_position) {
  output_position.para = result_list[0];
  output_position.off = lay_off_at(hit_view, result_list[0], result_list[1], lay_goal(hit_view, query_position, aim_x));
  if(result_list[0] == query_position.para && result_list[1] == target_line) {
    output_position.off = query_position.off;
  }
} return void;
