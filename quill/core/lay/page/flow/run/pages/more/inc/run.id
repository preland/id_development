// The last page whose first paragraph comes before paragraph lwf, which is where a walk that has to redo lwf starts again; 0 when no page does or none is known.
// By hand: with pages starting at paragraphs 0 and 6, paragraph 7 is redone from page 1 and paragraph 6, which starts page 1 itself, from page 0, because what comes before it may have changed.
lay_page_before(View layout_walk_view, int first_changed_paragraph) {
  int restart_page = 0;
  int scanned_page_index = 0;
  while(scanned_page_index < layout_walk_view.pages.count) {
    if(layout_walk_view.pages.starts[2 * scanned_page_index] < first_changed_paragraph) {
      restart_page = scanned_page_index;
    }
    scanned_page_index = scanned_page_index + 1;
  }
} return int restart_page;
