// Keeps the first lwn pages and forgets the rest, the sentinel too; a view that has no pages yet gets its first one.
// By hand: after paginating 8 paragraphs the pages are 0, 6 and the sentinel 8; keeping one leaves [0, 0].
lay_keep(View layout_walk_view, int pages_kept) {
  if(len(layout_walk_view.pages.starts) < 2 * pages_kept) {
    lay_pages_reset(layout_walk_view);
  } else {
    layout_walk_view.pages.count = pages_kept;
  }
  while(len(layout_walk_view.pages.starts) > 2 * pages_kept) {
    pop(layout_walk_view.pages.starts);
  }
} return void;
