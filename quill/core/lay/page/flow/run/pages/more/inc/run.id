// Paginates again from the page before paragraph lwf and answers how many paragraphs it placed. Paragraphs from lwf to lwl are the ones that changed: once a page starts at the same paragraph and line as it did, past lwl, with the paragraph count the same, everything after it is as it was, so the walk keeps the old pages and the old tops from there and stops. Every paragraph must have been laid out already.
// By hand: 100 one-line paragraphs, 6 to a page, with paragraph 50 changed: the page before it starts at 48, the page after it at 54 is where it was, so paragraphs 48 to 54 are walked, 7 of 100.
lay_walk(View layout_walk_view, int first_changed_paragraph, int last_changed_paragraph) {
  int[] old_starts = list_copy(layout_walk_view.pages.starts);
  int restart_page = lay_page_before(layout_walk_view, first_changed_paragraph);
  int[] pagination_walk = [0, 0, 0];
} chain (View layout_walk_view, int first_changed_paragraph, int last_changed_paragraph) {
  lay_resume(layout_walk_view, restart_page, pagination_walk);
  int restart_paragraph = layout_walk_view.pages.starts[2 * restart_page];
  lay_tops(layout_walk_view, old_starts, restart_paragraph);
} chain (View layout_walk_view, int first_changed_paragraph, int last_changed_paragraph) {
  int layout_walk_paragraph = restart_paragraph + 1;
  int paragraph_limit = len(layout_walk_view.doc.body.paras);
  int walk_may_stop = lay_stable(layout_walk_view, old_starts, last_changed_paragraph);
} chain (View layout_walk_view, int first_changed_paragraph, int last_changed_paragraph) {
  while(layout_walk_paragraph < paragraph_limit && walk_may_stop == 0) {
    lay_place(layout_walk_view, layout_walk_paragraph, pagination_walk);
    walk_may_stop = lay_stable(layout_walk_view, old_starts, last_changed_paragraph);
    layout_walk_paragraph = layout_walk_paragraph + 1;
  }
  lay_finish(layout_walk_view, old_starts, walk_may_stop);
  int placed_total = layout_walk_paragraph - restart_paragraph;
} return int placed_total;
