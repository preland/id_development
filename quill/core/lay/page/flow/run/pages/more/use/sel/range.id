// Records in lhr, [from, to, mark], what of line lhj of paragraph lhi the selection from lhsa to lhsb covers: the offsets from and to (to not above from when none of the line is covered) and mark 1 when the selection goes on past the paragraph, so that the line holds the paragraph mark in it, which is the end of its last line. The paragraph must lie between the two ends.
// By hand in "BBB EEE BBB" in lines of 4, 4 and 3, the selection 1 to 6 covers offsets 1 to 4 of line 0, 4 to 6 of line 1 and nothing of line 2 (8 to 6); from 1 of "BBB" to 1 of the next paragraph, the whole of the last line of the first and the mark.
lay_range(Para line_paragraph, int target_paragraph, int target_line, Pos selection_start, Pos selection_end, int[] result_list) {
  int paragraph_length = len(line_paragraph.txt.cps);
  int range_from = selection_start.off * (target_paragraph == selection_start.para);
  int range_to = paragraph_length + (selection_end.off - paragraph_length) * (target_paragraph == selection_end.para);
} chain (Para line_paragraph, int target_paragraph, int target_line, Pos selection_start, Pos selection_end, int[] result_list) {
  int line_low_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_low)];
  int line_high_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_high)];
  lset(result_list, 0, fixed_point_maximum(line_low_offset, range_from));
} chain (Para line_paragraph, int target_paragraph, int target_line, Pos selection_start, Pos selection_end, int[] result_list) {
  int mark_included = (target_paragraph < selection_end.para) * (line_high_offset == paragraph_length);
  lset(result_list, 1, fixed_point_minimum(line_high_offset, range_to));
  lset(result_list, 2, mark_included);
} return void;
