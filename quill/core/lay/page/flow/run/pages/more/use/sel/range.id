// The x, in lu from the left edge of the text area, where a selection that ends at offset lhb of line lhj stops: the pen of that offset, except at the end of a line that is followed by another, where the pen of the offset is the start of the next line and the line's own end, its start plus its used width, is meant.
// By hand: in "BBB EEE BBB" the end of line 0 (offset 4) is 0 + 2049, the used width of the line, not 0 which is the pen of the start of line 1; offset 2 is its pen 1366; the end of the text, offset 11, is its pen 2049.
layout_page_x_end(Para line_paragraph, int target_line, int end_offset) {
  int line_low_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_low)];
  int line_high_offset = line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_high)];
  int end_x = line_paragraph.lay.pen[end_offset];
} chain (Para line_paragraph, int target_line, int end_offset) {
  if(end_offset == line_high_offset && line_high_offset < len(line_paragraph.txt.cps)) {
    end_x = line_paragraph.lay.pen[line_low_offset] + line_paragraph.lay.lines[target_line * (import quill_line_stride) + (import quill_line_width)];
  }
} return int end_x;
