// The rectangles that show selection lhs on page lhk: lhc becomes four numbers [x, y, width, height] for every line of the page the selection covers, in lu from the top left corner of the page, one rectangle per line from the first covered offset to the last, plus the width of a paragraph mark (quill_layout_mark_width) at the end of a line whose paragraph the selection goes on past. Answers how many rectangles. A collapsed selection has none. Uses only the pagination and the pens, so it needs no font.
// By hand in "BBB", "A", "BBB" (pens 683 per letter, left margin 2560, paragraphs 1664 apart from 640): the selection from 1 of the first to 1 of the last is [3243, 640, 1366 + 256, 1152] for the rest of the first, [2560, 2304, 683 + 256, 1152] for the second whole, and [2560, 3968, 683, 1152] for the start of the third, three in all.
layout_page_selection_rectangles(View hit_view, Sel moving_selection, int target_page, int[] rectangle_list) {
  Pos selection_start = moving_selection.anchor;
  Pos selection_end = moving_selection.caret;
  if(document_position_less(moving_selection.caret, moving_selection.anchor) == 1) {
    selection_start = moving_selection.caret;
    selection_end = moving_selection.anchor;
  }
} chain (View hit_view, Sel moving_selection, int target_page, int[] rectangle_list) {
  layout_paragraph_clear(rectangle_list);
  int target_paragraph = fixed_point_maximum(hit_view.pages.starts[2 * target_page], selection_start.para);
  int layout_end_paragraph = fixed_point_minimum(hit_view.pages.starts[2 * target_page + 2] + (hit_view.pages.starts[2 * target_page + 3] > 0), selection_end.para + 1);
} chain (View hit_view, Sel moving_selection, int target_page, int[] rectangle_list) {
  while(target_paragraph < layout_end_paragraph) {
    layout_page_rectangles_paragraph(hit_view, target_page, target_paragraph, selection_start, selection_end, rectangle_list);
    target_paragraph = target_paragraph + 1;
  }
  int rectangle_total = len(rectangle_list) / 4;
} return int rectangle_total;
