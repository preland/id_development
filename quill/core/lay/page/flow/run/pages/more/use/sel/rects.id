// Adds the rectangles of the lines of paragraph lhi that are on page lhk to lhc (lay_rect_line), for the selection from lhsa to lhsb.
// By hand: "BBB EEE BBB" selected from 1 to 6 has a rectangle on line 0 and one on line 1, none on line 2.
layout_page_rectangles_paragraph(View hit_view, int target_page, int target_paragraph, Pos selection_start, Pos selection_end, int[] rectangle_list) {
  int[] span_list = [0, 0];
  lay_span(hit_view, target_page, target_paragraph, span_list);
  int target_line = span_list[0];
} chain (View hit_view, int target_page, int target_paragraph, Pos selection_start, Pos selection_end, int[] rectangle_list) {
  while(target_line < span_list[1]) {
    lay_rect_line(hit_view, target_paragraph, target_line, selection_start, selection_end, rectangle_list);
    target_line = target_line + 1;
  }
} return void;
