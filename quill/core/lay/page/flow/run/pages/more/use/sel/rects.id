// Adds the rectangle of line lhj of paragraph lhi for the selection from lhsa to lhsb to lhc, if any of the line is covered: from the pen of its first covered offset to where the covered text ends (lay_xend), the height of the line, and the width of the paragraph mark when the line ends one that the selection goes on past.
// By hand in "BBB EEE BBB" selected from 1 to 6: line 1 is covered from 4 to 6, 2560 to 3926 across the page, 1366 wide and 1792 down; line 2, from 8, is not covered at all and adds nothing.
lay_rect_line(View hit_view, int target_paragraph, int target_line, Pos selection_start, Pos selection_end, int[] rectangle_list) {
  Para line_paragraph = hit_view.doc.body.paras[target_paragraph];
  int[] result_list = [0, 0, 0];
  lay_range(line_paragraph, target_paragraph, target_line, selection_start, selection_end, result_list);
} chain (View hit_view, int target_paragraph, int target_line, Pos selection_start, Pos selection_end, int[] rectangle_list) {
  if(result_list[1] > result_list[0] || result_list[2] == 1) {
    lay_rect(rectangle_list, lay_margin(hit_view.doc, 3) + line_paragraph.lay.pen[result_list[0]], lay_line_y(hit_view, target_paragraph, target_line), layout_page_x_end(line_paragraph, target_line, result_list[1]) - line_paragraph.lay.pen[result_list[0]] + result_list[2] * (import quill_layout_mark_width), layout_page_line_height(hit_view, target_paragraph, target_line));
  }
} return void;
