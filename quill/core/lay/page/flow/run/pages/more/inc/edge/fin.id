// 1 when the old pagination lwo cannot be trusted for this document: it holds no page, or it was made for another number of paragraphs (its sentinel).
// By hand: 8 paragraphs against a sentinel 8 is 0, against 7 is 1, and against nothing is 1.
lay_moved(View layout_walk_view, int[] old_starts) {
  int pagination_moved = 1;
  if(len(old_starts) >= 2) {
    pagination_moved = old_starts[len(old_starts) - 2] != len(layout_walk_view.doc.body.paras);
  }
} return int pagination_moved;
