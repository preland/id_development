// Cuts the tops of the paragraphs after lwp when the paragraph count changed since the old pagination lwo, so that the walk writes them again; they are kept, to be written over, when it did not.
// By hand: 8 paragraphs have 8 tops; an old pagination of 7 leaves the 4 of paragraphs 0 to 3, one of 8 leaves all 8.
lay_tops(View layout_walk_view, int[] old_starts, int restart_paragraph) {
  if(lay_moved(layout_walk_view, old_starts) == 1) {
    while(len(layout_walk_view.pages.tops) > restart_paragraph + 1) {
      pop(layout_walk_view.pages.tops);
    }
  }
} return void;
