// Ends a walk: when it stopped because a page started as it did (lwx 1) the old pages after it come back, otherwise the walk went to the end of the document and its last page is closed.
// By hand: the old pages 0 and 6 after one kept page and a stop give 0, 6 and the sentinel 8; a walk that ran on and kept one page gives 0 and the sentinel 8.
lay_finish(View layout_walk_view, int[] old_starts, int walk_may_stop) {
  if(walk_may_stop == 1) {
    lay_tail(layout_walk_view, old_starts);
  } else {
    lay_pages_close(layout_walk_view);
  }
} return void;
