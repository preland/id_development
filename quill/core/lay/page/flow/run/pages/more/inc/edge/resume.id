// Places paragraph lwi from line lwj on the walk lws, whose y already says where the page's first line sits: a paragraph from its first line is placed whole, one that carries on from the page before places only its lines from lwj on and ends where they end.
// By hand: with the paragraph of 10 lines starting its page at line 8 and the base at minus 9216, the lines 8 and 9 are placed and the walk ends at 12032 - 9216 = 2816, in use, with that base.
lay_first(View layout_walk_view, int layout_walk_paragraph, int walk_line, int[] pagination_walk) {
  if(walk_line == 0) {
    lay_place(layout_walk_view, layout_walk_paragraph, pagination_walk);
  } else {
    integer_list_set(pagination_walk, 2, pagination_walk[0]);
    lay_lines(layout_walk_view, layout_walk_paragraph, walk_line, pagination_walk);
  }
  if(walk_line > 0) {
    integer_list_set(pagination_walk, 0, pagination_walk[2] + layout_walk_view.doc.body.paras[layout_walk_paragraph].lay.h);
  }
} return void;
