// Forgets the pages and opens the first one, at the first line of the first paragraph.
lay_pages_reset(View page_view) {
  layout_paragraph_clear(page_view.pages.starts);
  layout_paragraph_clear(page_view.pages.tops);
  page_view.pages.count = 0;
} chain (View page_view) {
  lay_page_open(page_view, 0, 0);
} return void;
