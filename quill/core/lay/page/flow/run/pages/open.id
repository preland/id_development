// A page starts at paragraph lgi, line lgj: its start is kept in starts (two cells, the paragraph then the line) and the page is counted.
lay_page_open(View page_view, int paragraph_index, int line_index) {
  push(page_view.pages.starts, paragraph_index);
  push(page_view.pages.starts, line_index);
  page_view.pages.count = page_view.pages.count + 1;
} return void;
