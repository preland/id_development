// Places paragraph lgi on the pages. lgs is the state of the walk, [y, used, base]: where the next paragraph starts on the current page, whether the page holds a line yet, and the y on the page of the current paragraph's own top. A paragraph that asks for a page break starts a new page unless the page is empty; its lines are then placed one by one, and the next paragraph starts where it ends.
lay_place(View page_view, int paragraph_index, int[] walk_state) {
  layout_page_break(page_view, paragraph_index, walk_state);
  integer_list_set(walk_state, 2, walk_state[0]);
  if(len(page_view.pages.tops) <= paragraph_index) {
    push(page_view.pages.tops, 0);
  }
} chain (View page_view, int paragraph_index, int[] walk_state) {
  lay_lines(page_view, paragraph_index, 0, walk_state);
  integer_list_set(walk_state, 0, walk_state[2] + page_view.doc.body.paras[paragraph_index].lay.h);
} return void;
