// A paragraph whose row says break before starts a new page, unless the page is empty already.
layout_page_break(View page_view, int paragraph_index, int[] walk_state) {
  Para subject_paragraph = page_view.doc.body.paras[paragraph_index];
  int break_before = document_style_effective_paragraph(page_view.doc.fmt, subject_paragraph.pprop, (import quill_paragraph_break_before));
  if(break_before == 1 && walk_state[1] == 1) {
    lay_page_open(page_view, paragraph_index, 0);
    integer_list_set(walk_state, 0, 0);
    integer_list_set(walk_state, 1, 0);
  }
} return void;
