// Places the lines of paragraph lgi one by one, from line lgf on: a page that starts in the middle of a paragraph resumes there.
lay_lines(View page_view, int paragraph_index, int first_line, int[] walk_state) {
  int line_count = len(page_view.doc.body.paras[paragraph_index].lay.lines) / (import quill_line_stride);
  int line_index = first_line;
  while(line_index < line_count) {
    lay_line(page_view, paragraph_index, line_index, walk_state);
    line_index = line_index + 1;
  }
} return void;
