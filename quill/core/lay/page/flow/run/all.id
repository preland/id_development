// Lays out every paragraph of the document in the text area's width, and gives an object paragraph the height of its box: the space before, the box, the space after. Layout is always at 100 percent, so this does not depend on the window or the zoom.
lay_all(View page_view) {
  int text_area_width = lay_area(page_view.doc, 0);
  int paragraph_index = 0;
  while(paragraph_index < len(page_view.doc.body.paras)) {
    lay_one(page_view, paragraph_index, text_area_width);
    paragraph_index = paragraph_index + 1;
  }
} return void;
