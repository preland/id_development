// Test check: the sheet and the margins of the test document as w,h,top,right,bottom,left.
layout_page_test_page_dump() {
  Doc document = (import layout_paragraph_test_document);
  int[] sheet_size_list = document.body.page.size;
  string result_text = sheet_size_list[0] + "," + sheet_size_list[1] + "," + document.body.page.margin[0] + "," + document.body.page.margin[1] + "," + document.body.page.margin[2] + "," + document.body.page.margin[3];
} return string result_text;
