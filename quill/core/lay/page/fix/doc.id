// Test setup: the test document's sheet is w by h twips with the margins t, r, b and l (top, right, bottom, left), in the exported test document lp_t_d.
layout_page_test_page(int sheet_width, int sheet_height, int margin_top, int margin_right, int margin_bottom, int margin_left) {
  Doc document = (import layout_paragraph_test_document);
  lset(document.body.page.size, 0, sheet_width);
  lset(document.body.page.size, 1, sheet_height);
} chain (int sheet_width, int sheet_height, int margin_top, int margin_right, int margin_bottom, int margin_left) {
  lset(document.body.page.margin, 0, margin_top);
  lset(document.body.page.margin, 1, margin_right);
  lset(document.body.page.margin, 2, margin_bottom);
} chain (int sheet_width, int sheet_height, int margin_top, int margin_right, int margin_bottom, int margin_left) {
  lset(document.body.page.margin, 3, margin_left);
} return void;
