// Test check: the height of every paragraph of the test document, comma separated.
layout_page_test_heights() {
  Doc document = (import layout_paragraph_test_document);
  int[] height_list = [];
  int paragraph_index = 0;
} chain () {
  while(paragraph_index < len(document.body.paras)) {
    push(height_list, document.body.paras[paragraph_index].lay.h);
    paragraph_index = paragraph_index + 1;
  }
  string result_text = document_dump_integers(height_list);
} return string result_text;
