// Test setup: n zeros in the tops of the test view, as lay_place makes room for the paragraphs it has walked.
layout_page_test_zeros(int zero_count) {
  int zeros_pushed = 0;
  while(zeros_pushed < zero_count) {
    push((import layout_paragraph_test_view).pages.tops, 0);
    zeros_pushed = zeros_pushed + 1;
  }
} return void;
