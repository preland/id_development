// A view of document lgd: no pages yet and an empty face cache at zoom 100, the document's layout to be made by lay_all and lay_paginate. Pages and the face cache keep lists of their own.
lay_view(Doc document) {
  int[] face_handle_list = [];
  int[] face_key_list = [];
  int[] page_start_list = [];
} chain (Doc document) {
  int[] page_top_list = [];
  Pages view_pages = Pages(page_start_list, page_top_list, 0);
  Face view_faces = Face(face_handle_list, face_key_list, 100);
} chain (Doc document) {
  View layout_new_view = View(document, view_pages, view_faces);
} return View layout_new_view;
