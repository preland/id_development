// Test check: how many keys the face cache of a fresh view holds after a paragraph's top was pushed into its pages: 0 when the two are separate lists.
layout_page_test_split() {
  View page_view = lay_view((import layout_paragraph_test_document));
  push(page_view.pages.tops, 5);
  int key_count = len(page_view.faces.key);
} return int key_count;
