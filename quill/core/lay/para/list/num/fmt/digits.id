// Appends the decimal digits of n to lbl as code points; a negative n is written as 0. It is a loop, not a recursion, because the analysis that frees lists keeps whatever a recursive function is given.
lp_dec(int[] lbl, int n) {
  int lpi_p = 1;
  while(n / lpi_p > 9) {
    lpi_p = lpi_p * 10;
  }
  while(lpi_p > 0) {
    push(lbl, 48 + fixed_point_maximum(n, 0) / lpi_p % 10);
    lpi_p = lpi_p / 10;
  }
} return void;
([], 7):([55])
([], 120):([49, 50, 48])
([], -3):([48])

// Appends n in bijective base 26 (1 is a, 26 is z, 27 is aa, 28 is ab) to lbl, with base 97 for lower case and 65 for upper case. The digits are pushed last first and the pushed part is turned round, so that it is a loop and not a recursion.
lp_alpha(int[] lbl, int n, int base) {
  int lpi_a = len(lbl);
  int lpi_m = n;
  while(lpi_m > 0) {
    push(lbl, base + (lpi_m - 1) % 26);
    lpi_m = (lpi_m - 1) / 26;
  }
} chain (int[] lbl, int n, int base) {
  int lpi_b = len(lbl) - 1;
  while(lpi_a < lpi_b) {
    lst_swap(lbl, lpi_a, lpi_b);
    lpi_a = lpi_a + 1;
    lpi_b = lpi_b - 1;
  }
} return void;
([], 1, 97):([97])
([], 26, 97):([122])
([], 27, 97):([97, 97])
([], 53, 65):([66, 65])
([7], 28, 97):([7, 97, 98])
