// Appends the number n written in list format lf to lbl: 0 decimal, 1 lower alpha, 2 upper alpha, 3 lower roman, 4 upper roman. A number below 1, an unknown format, or a number above 3999 for a roman format is written in decimal.
layout_paragraph_number(int[] pick_label, int pick_number, int lf) {
  if(pick_number < 1 || lf < 0 || lf > 4 || (lf > 2 && pick_number > 3999)) {
    lf = 0;
  }
  if(lf == 0) {
    layout_paragraph_decimal(pick_label, pick_number);
  }
  if(lf == 1) {
    layout_paragraph_alphabetic(pick_label, pick_number, 97);
  }
} chain (int[] pick_label, int pick_number, int lf) {
  if(lf == 2) {
    layout_paragraph_alphabetic(pick_label, pick_number, 65);
  }
  if(lf == 3) {
    layout_paragraph_roman(pick_label, pick_number, 0);
  }
  if(lf == 4) {
    layout_paragraph_roman(pick_label, pick_number, 1);
  }
} return void;
([], 12, 0):([49, 50])
([], 2, 1):([98])
([], 2, 2):([66])
([], 4, 3):([105, 118])
([], 4, 4):([73, 86])
