// Appends the number n written in list format lf to lbl: 0 decimal, 1 lower alpha, 2 upper alpha, 3 lower roman, 4 upper roman. A number below 1, an unknown format, or a number above 3999 for a roman format is written in decimal.
lp_num(int[] lbl, int n, int lf) {
  if(n < 1 || lf < 0 || lf > 4 || (lf > 2 && n > 3999)) {
    lf = 0;
  }
  if(lf == 0) {
    lp_dec(lbl, n);
  }
  if(lf == 1) {
    lp_alpha(lbl, n, 97);
  }
} chain (int[] lbl, int n, int lf) {
  if(lf == 2) {
    lp_alpha(lbl, n, 65);
  }
  if(lf == 3) {
    lp_roman(lbl, n, 0);
  }
  if(lf == 4) {
    lp_roman(lbl, n, 1);
  }
} return void;
([], 12, 0):([49, 50])
([], 2, 1):([98])
([], 2, 2):([66])
([], 4, 3):([105, 118])
([], 4, 4):([73, 86])
([], 0, 3):([48])
([], 4000, 4):([52, 48, 48, 48])
([], 5, 7):([53])
