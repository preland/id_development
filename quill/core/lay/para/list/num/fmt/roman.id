// Appends roman symbol j (an index into quill_layout_roman_values and quill_layout_roman_codes) to lbl, one or two code points, upper case when up is 1.
layout_paragraph_roman_symbol(int[] symbol_label, int symbol_index, int up) {
  int symbol_first = (import quill_layout_roman_codes)[symbol_index * 2];
  int symbol_second = (import quill_layout_roman_codes)[symbol_index * 2 + 1];
  push(symbol_label, symbol_first - up * 32);
} chain (int[] symbol_label, int symbol_index, int up) {
  if(symbol_second > 0) {
    push(symbol_label, symbol_second - up * 32);
  }
} return void;
([], 0, 0):([109])
([], 1, 0):([99, 109])
([], 9, 1):([73, 88])

// Appends n (1 to 3999) as a roman numeral to lbl by taking the largest symbol that still fits, as many times as it fits.
// By hand: 4 is iv; 1994 is 1000 + 900 + 90 + 4, mcmxciv.
layout_paragraph_roman(int[] roman_label, int roman_number, int up) {
  int roman_position = 0;
  while(roman_position < len((import quill_layout_roman_values))) {
    while(roman_number >= (import quill_layout_roman_values)[roman_position]) {
      layout_paragraph_roman_symbol(roman_label, roman_position, up);
      roman_number = roman_number - (import quill_layout_roman_values)[roman_position];
    }
    roman_position = roman_position + 1;
  }
} return void;
([], 4, 0):([105, 118])
([], 1994, 0):([109, 99, 109, 120, 99, 105, 118])
([], 8, 1):([86, 73, 73, 73])
