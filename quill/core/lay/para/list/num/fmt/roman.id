// Appends roman symbol j (an index into quill_layout_roman_values and quill_layout_roman_codes) to lbl, one or two code points, upper case when up is 1.
lp_sym(int[] lbl, int j, int up) {
  int c1 = (import quill_layout_roman_codes)[j * 2];
  int c2 = (import quill_layout_roman_codes)[j * 2 + 1];
  push(lbl, c1 - up * 32);
} chain (int[] lbl, int j, int up) {
  if(c2 > 0) {
    push(lbl, c2 - up * 32);
  }
} return void;
([], 0, 0):([109])
([], 1, 0):([99, 109])
([], 9, 1):([73, 88])

// Appends n (1 to 3999) as a roman numeral to lbl by taking the largest symbol that still fits, as many times as it fits.
// By hand: 4 is iv; 1994 is 1000 + 900 + 90 + 4, mcmxciv.
lp_roman(int[] lbl, int n, int up) {
  int j = 0;
  while(j < len((import quill_layout_roman_values))) {
    while(n >= (import quill_layout_roman_values)[j]) {
      lp_sym(lbl, j, up);
      n = n - (import quill_layout_roman_values)[j];
    }
    j = j + 1;
  }
} return void;
([], 4, 0):([105, 118])
([], 1994, 0):([109, 99, 109, 120, 99, 105, 118])
([], 8, 1):([86, 73, 73, 73])
