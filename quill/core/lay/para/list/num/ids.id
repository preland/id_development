// What paragraph j, met while counting backwards for an item of list lid at level lvl, does to the count: 1 it is an item of the same list and level and counts, 2 it is an item of the same list at a shallower level and so ends the count, 0 anything else (another list, no list, a deeper item).
layout_paragraph_count_effect(View effect_view, int effect_paragraph_index, int lid, int effect_level) {
  int effect_list = layout_paragraph_property(effect_view, effect_paragraph_index, (import quill_paragraph_list));
  int effect_other_level = layout_paragraph_property(effect_view, effect_paragraph_index, (import quill_paragraph_level));
  int effect_result = 0;
} chain (View effect_view, int effect_paragraph_index, int lid, int effect_level) {
  if(effect_list == lid) {
    effect_result = (effect_other_level == effect_level) + 2 * (effect_other_level < effect_level);
  }
} return int effect_result;
