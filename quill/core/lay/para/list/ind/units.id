// Twips (1/1440 in) as lu (1/64 px at 96 dpi): 64 / 15 per twip, truncated toward zero, once per property and never accumulated (docs/QUILL.md 3.1.5).
// By hand: 720 twips are half an inch, 48 px, 3072 lu; 360 are 1536; 1 twip is 4.27, so 4.
layout_paragraph_units(int units_raw) {
  int units_result = units_raw * 64 / 15;
} return int units_result;
(720):(3072)
(-360):(-1536)
(0):(0)
(1):(4)

// xs[at], or 0 when at is outside the list.
layout_paragraph_cell(int[] cell_list, int at) {
  int cell_value = 0;
  if(at >= 0 && at < len(cell_list)) {
    cell_value = cell_list[at];
  }
} return int cell_value;
([5, 6, 7], 1):(6)
([5], 3):(0)
([5], -1):(0)
