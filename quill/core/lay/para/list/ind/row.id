layout_paragraph_list_indent(View list_indent_view, int list_indent_paragraph_index, int field) {
  Para list_indent_paragraph = list_indent_view.doc.body.paras[list_indent_paragraph_index];
  int list_indent_raw = document_style_effective_paragraph(list_indent_view.doc.fmt, list_indent_paragraph.pprop, field);
  int lid = layout_paragraph_property(list_indent_view, list_indent_paragraph_index, (import quill_paragraph_list));
} chain (View list_indent_view, int list_indent_paragraph_index, int field) {
  int list_indent_level = layout_paragraph_property(list_indent_view, list_indent_paragraph_index, (import quill_paragraph_level));
  if(lid > 0 && field == (import quill_paragraph_indent_left)) {
    list_indent_raw = layout_paragraph_list_cell(list_indent_view, lid, list_indent_level, (import quill_list_level_indent));
  }
  if(lid > 0 && field == (import quill_paragraph_indent_first)) {
    list_indent_raw = 0 - layout_paragraph_list_cell(list_indent_view, lid, list_indent_level, (import quill_list_level_hanging));
  }
} return int list_indent_raw;
