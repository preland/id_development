// One cell of list definition lid's level lvl (offsets quill_list_level_kind ... quill_list_level_hanging), or 0 when there is no such list or level: list 0 means no list, and a level the definition does not have reads as 0.
layout_paragraph_list_cell(View list_cell_view, int lid, int list_cell_level, int off) {
  int list_cell_value = 0;
  if(lid > 0 && lid < len(list_cell_view.doc.fmt.sty.lists)) {
    list_cell_value = layout_paragraph_cell(list_cell_view.doc.fmt.sty.lists[lid].levels, fixed_point_maximum(list_cell_level, 0) * (import quill_list_level_stride) + off);
  }
} return int list_cell_value;
