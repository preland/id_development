// The indent of paragraph i in lu for field quill_paragraph_indent_left, quill_paragraph_indent_right or quill_paragraph_indent_first: the paragraph's own value when it sets one, else lp_lind (its list level, or its style).
lp_ind(View v, int i, int field) {
  Para p = v.doc.body.paras[i];
  int tw = tab_get(v.doc.fmt.paras, p.pprop, field);
  if(tw == -1) {
    tw = lp_lind(v, i, field);
  }
} chain (View v, int i, int field) {
  int lu = lp_lu(tw);
} return int lu;
