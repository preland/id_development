// The indent of paragraph i in lu for field quill_paragraph_indent_left, quill_paragraph_indent_right or quill_paragraph_indent_first: the paragraph's own value when it sets one, else lp_lind (its list level, or its style).
layout_paragraph_indent(View indent_view, int indent_paragraph_index, int field) {
  Para indent_paragraph = indent_view.doc.body.paras[indent_paragraph_index];
  int indent_raw = tab_get(indent_view.doc.fmt.paras, indent_paragraph.pprop, field);
  if(indent_raw == -1) {
    indent_raw = layout_paragraph_list_indent(indent_view, indent_paragraph_index, field);
  }
} chain (View indent_view, int indent_paragraph_index, int field) {
  int indent_units = layout_paragraph_units(indent_raw);
} return int indent_units;
