// The advance of all of cps in face fh, kerning included, in 64ths.
// By hand at 16 px: B and E are 683 each; A before V kerns by -76, 683 + 607 = 1290.
lp_sum(int fh, int[] cps) {
  int tot = 0;
  int j = 0;
  while(j < len(cps)) {
    tot = tot + gui_cp_adv(fh, cps[j], lp_nx(cps, j));
    j = j + 1;
  }
} return int tot;
