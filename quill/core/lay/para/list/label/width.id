// The width of the label of paragraph i in lu: the advances of its code points in the face of the paragraph's first run. It borrows the paragraph's pen list as scratch and leaves it empty, so it allocates nothing.
// By hand at 16 px: a bullet (U+2022) is 717 units, 717 * 16 / 32 = 358.5, so 359; the label "1." is a 1 of 1139 units, 569.5 so 570, and a full stop of 569 units, 284.5 so 285, 855 in all.
layout_paragraph_label_width(View label_width_view, int label_width_paragraph_index) {
  Para label_width_paragraph = label_width_view.doc.body.paras[label_width_paragraph_index];
  lay_label(label_width_view, label_width_paragraph_index, label_width_paragraph.lay.pen);
  int label_width_total = layout_paragraph_advance_sum(layout_paragraph_run_face(label_width_view, label_width_paragraph_index, 0), label_width_paragraph.lay.pen);
} chain (View label_width_view, int label_width_paragraph_index) {
  layout_paragraph_clear(label_width_paragraph.lay.pen);
} return int label_width_total;
