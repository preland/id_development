// The advance of all of cps in face fh, kerning included, in 64ths.
// By hand at 16 px: B and E are 683 each; A before V kerns by -76, 683 + 607 = 1290.
layout_paragraph_advance_sum(int sum_face_handle, int[] sum_code_points) {
  int tot = 0;
  int sum_position = 0;
  while(sum_position < len(sum_code_points)) {
    tot = tot + gui_seam_code_point_advance(sum_face_handle, sum_code_points[sum_position], layout_paragraph_next_code_point(sum_code_points, sum_position));
    sum_position = sum_position + 1;
  }
} return int tot;
