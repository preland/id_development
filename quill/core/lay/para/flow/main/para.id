// The space before (field quill_paragraph_space_before) or after (quill_paragraph_space_after) paragraph i in lu; unset is 0.
// By hand: the Normal style leaves 120 twips after, 120 * 64 / 15 = 512 lu, and nothing before; 240 twips set on the paragraph are 1024.
layout_paragraph_spacing(View spacing_view, int spacing_paragraph_index, int field) {
  Para spacing_paragraph = spacing_view.doc.body.paras[spacing_paragraph_index];
  int spacing_raw = document_style_effective_paragraph(spacing_view.doc.fmt, spacing_paragraph.pprop, field);
  int spacing_units = layout_paragraph_units(fixed_point_maximum(spacing_raw, 0));
} return int spacing_units;
