// Lays out every line of paragraph i inside a text area wd lu wide: the first line starts at lp_xfirst, the others at the left indent, all end at the width minus the right indent. An empty paragraph gets its one line. lay.h must hold the running height the lines start at.
// By hand at 16 px (B and E 683, line height 1152): in 3500 lu "BBBB EEEE" is the lines "BBBB " and "EEEE", each 2732 wide, the second 1152 lower. A left indent of 720 twips (3072 lu) with a first-line indent of 360 (1536) starts the first line at 4608 with 3392 left, so the break is the same, and the second line starts at 3072. A right indent of 720 twips in 6500 lu leaves 3428 and breaks a line that would have fit whole. An empty paragraph is one line at the first-line start.
layout_paragraph_lines(View lines_view, int lines_paragraph_index, int lines_width) {
  Para lines_paragraph = lines_view.doc.body.paras[lines_paragraph_index];
  int lines_left_edge = layout_paragraph_indent(lines_view, lines_paragraph_index, (import quill_paragraph_indent_left));
  int lines_right_edge = lines_width - layout_paragraph_indent(lines_view, lines_paragraph_index, (import quill_paragraph_indent_right));
} chain (View lines_view, int lines_paragraph_index, int lines_width) {
  int lines_first_origin = layout_paragraph_first_line_start(lines_view, lines_paragraph_index);
  int lines_start = 0;
  int lines_text_length = len(lines_paragraph.txt.cps);
} chain (View lines_view, int lines_paragraph_index, int lines_width) {
  while(lines_start < lines_text_length || len(lines_paragraph.lay.lines) == 0) {
    lines_start = layout_paragraph_one_line(lines_view, lines_paragraph_index, lines_start, lines_first_origin, lines_right_edge);
    lines_first_origin = lines_left_edge;
  }
} return void;
