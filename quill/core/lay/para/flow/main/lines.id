// Lays out one line of paragraph i from code point lo, starting at x0 and ending at the right edge xr, and returns the offset where the next line starts.
// By hand at 16 px (B and E 683): from 0 to 3500 "BBBB EEEE" breaks after the space, at 5, and the line is 2732 wide. From 1000 to 3500 only 2500 lu are left, so the fourth B (2732) does not fit and the word breaks at the glyph, at 3, with a line 2049 wide whose pen starts at 1000.
layout_paragraph_one_line(View one_view, int one_paragraph_index, int one_start, int one_origin, int one_right_edge) {
  int avail = one_right_edge - one_origin;
  int hi = layout_paragraph_scan(one_view, one_paragraph_index, one_start, one_origin, avail);
  layout_paragraph_close(one_view, one_paragraph_index, one_start, hi, avail);
} return int hi;
