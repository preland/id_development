// Spreads slack lu over the spaces of the line lo..hi-1 in whole lu: every space gets slack / spaces and the first slack % spaces of them one more, so the remainder goes left to right. Pen entry k moves by the extra of the spaces before it; trailing spaces get none, and a line with no space is left as it is.
// By hand: "A B C" with slack 11 over 2 spaces is 5 each plus 1 for the first, so the pen after the first space moves 6 and after the second 11.
layout_paragraph_justify(Para justify_paragraph, int justify_start, int hi, int slack) {
  int we = layout_paragraph_visible_end(justify_paragraph, justify_start, hi);
  int justify_spaces = layout_paragraph_justification_spaces(justify_paragraph, justify_start, we);
  int[] pen = justify_paragraph.lay.pen;
} chain (Para justify_paragraph, int justify_start, int hi, int slack) {
  int justify_quotient = slack / fixed_point_maximum(justify_spaces, 1);
  int justify_remainder = slack % fixed_point_maximum(justify_spaces, 1);
  int justify_passed = 0;
} chain (Para justify_paragraph, int justify_start, int hi, int slack) {
  int justify_position = justify_start + 1;
  while(justify_spaces > 0 && justify_position <= hi) {
    justify_passed = justify_passed + layout_paragraph_justification_space(justify_paragraph, justify_position - 1, we);
    pen[justify_position] = pen[justify_position] + justify_passed * justify_quotient + fixed_point_minimum(justify_passed, justify_remainder);
    justify_position = justify_position + 1;
  }
} return void;
