// How many spaces justification may widen in code points lo..we-1.
layout_paragraph_justification_spaces(Para count_paragraph, int count_start, int we) {
  int count_total = 0;
  int count_position = count_start;
  while(count_position < we) {
    count_total = count_total + layout_paragraph_justification_space(count_paragraph, count_position, we);
    count_position = count_position + 1;
  }
} return int count_total;
