// How many spaces justification may widen in code points lo..we-1.
lp_spaces(Para p, int lo, int we) {
  int cnt = 0;
  int j = lo;
  while(j < we) {
    cnt = cnt + lp_sp(p, j, we);
    j = j + 1;
  }
} return int cnt;
