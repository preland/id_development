// Appends the six ints of one line to lines.
layout_paragraph_record(int[] lines, int record_start, int hi, int record_top, int record_ascent, int record_descent, int record_width) {
  push(lines, record_start);
  push(lines, hi);
  push(lines, record_top);
} chain (int[] lines, int record_start, int hi, int record_top, int record_ascent, int record_descent, int record_width) {
  push(lines, record_ascent);
  push(lines, record_descent);
  push(lines, record_width);
} return void;
