// Finishes the line lo..hi-1 of paragraph i, which lp_scan has measured: aligns it, measures its ascent and descent over the runs it holds, applies the line spacing, appends its record at the paragraph's running height lay.h and grows lay.h by the line's height.
// By hand at 16 px (ascent 15 px = 960 lu with the line gap, descent 3 px = 192): the line "BBBB " has height 1152 and used width 2732, and at 150 percent (1728 - 192 = 1536 above the descent) it starts at the running height 1000 and the paragraph grows to 1000 + 1728 = 2728. With one E at 24 pt (32 px: ascent 30 px = 1920, descent 7 px = 448) the line takes those, width 683 + 1366 = 2049, height 2368.
layout_paragraph_close(View close_view, int close_paragraph_index, int close_start, int hi, int avail) {
  Para close_paragraph = close_view.doc.body.paras[close_paragraph_index];
  int we = layout_paragraph_visible_end(close_paragraph, close_start, hi);
  int close_width = close_paragraph.lay.pen[we] - close_paragraph.lay.pen[close_start];
} chain (View close_view, int close_paragraph_index, int close_start, int hi, int avail) {
  int close_final_width = layout_paragraph_align(close_view, close_paragraph_index, close_start, hi, avail, close_width);
  int close_ascent = layout_paragraph_maximum_extent(close_view, close_paragraph_index, close_start, hi, 0);
  int close_descent = layout_paragraph_maximum_extent(close_view, close_paragraph_index, close_start, hi, 1);
} chain (View close_view, int close_paragraph_index, int close_start, int hi, int avail) {
  int top = layout_paragraph_leading(close_ascent, close_descent, document_style_effective_paragraph(close_view.doc.fmt, close_paragraph.pprop, (import quill_paragraph_line_percent)));
  layout_paragraph_record(close_paragraph.lay.lines, close_start, hi, close_paragraph.lay.h, top, close_descent, close_final_width);
  close_paragraph.lay.h = close_paragraph.lay.h + top + close_descent;
} return void;
