// The end of the visible text of the line lo..hi-1: hi with the trailing spaces taken off, because they hang past the edge and count in no width, no alignment and no justification.
layout_paragraph_visible_end(Para visible_paragraph, int visible_start, int hi) {
  int we = hi;
  while(we > visible_start && visible_paragraph.txt.cps[we - 1] == (import quill_code_point_space)) {
    we = we - 1;
  }
} return int we;
