// How far alignment al moves a line of used width w inside avail: 0 for left and justified, half the slack for centred, all of it for right, never negative (a line that overflowed stays at its start).
// By hand: slack 1000 - 400 = 600, so centre 300 and right 600; slack 1001 - 400 = 601 centres at 300 (truncated).
layout_paragraph_alignment_offset(int offset_alignment, int avail, int offset_used_width) {
  int offset_distance = 0;
  if(offset_alignment == (import quill_alignment_center)) {
    offset_distance = (avail - offset_used_width) / 2;
  }
  if(offset_alignment == (import quill_alignment_right)) {
    offset_distance = avail - offset_used_width;
  }
} chain (int offset_alignment, int avail, int offset_used_width) {
  offset_distance = fixed_point_maximum(offset_distance, 0);
} return int offset_distance;
