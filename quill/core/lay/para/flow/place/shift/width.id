// How far alignment al moves a line of used width w inside avail: 0 for left and justified, half the slack for centred, all of it for right, never negative (a line that overflowed stays at its start).
// By hand: slack 1000 - 400 = 600, so centre 300 and right 600; slack 1001 - 400 = 601 centres at 300 (truncated).
lp_dx(int al, int avail, int w) {
  int dx = 0;
  if(al == (import quill_alignment_center)) {
    dx = (avail - w) / 2;
  }
  if(al == (import quill_alignment_right)) {
    dx = avail - w;
  }
} chain (int al, int avail, int w) {
  dx = fixed_point_maximum(dx, 0);
} return int dx;
(0, 1000, 400):(0)
(1, 1000, 400):(300)
(2, 1000, 400):(600)
(2, 100, 400):(0)
(1, 1001, 400):(300)
(3, 1000, 400):(0)

// Adds dx to the pen entries lo..hi of a line, which is how alignment moves it.
lp_shift(Para p, int lo, int hi, int dx) {
  int[] pen = p.lay.pen;
  int k = lo;
  while(k <= hi) {
    pen[k] = pen[k] + dx;
    k = k + 1;
  }
} return void;
