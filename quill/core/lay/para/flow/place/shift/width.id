// Adds dx to the pen entries lo..hi of a line, which is how alignment moves it.
layout_paragraph_shift(Para shift_paragraph, int shift_start, int hi, int shift_distance) {
  int[] pen = shift_paragraph.lay.pen;
  int shift_position = shift_start;
  while(shift_position <= hi) {
    pen[shift_position] = pen[shift_position] + shift_distance;
    shift_position = shift_position + 1;
  }
} return void;
