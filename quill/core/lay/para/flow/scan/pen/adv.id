// Places code point k: fills pen[k + 1] with pen[k] plus its advance, so a line is scanned left to right with every earlier pen entry final.
// By hand: A at pen 0 ends at 683; the tab at pen 100 ends on the first stop, 3072.
layout_paragraph_step(Para step_paragraph, int step_face_handle, int step_position) {
  int got = layout_paragraph_code_point_advance(step_paragraph, step_face_handle, step_position);
  layout_paragraph_put(step_paragraph.lay.pen, step_position + 1, step_paragraph.lay.pen[step_position] + got);
} return void;
