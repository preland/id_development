// How far code point k of paragraph p moves the pen, in 64ths: its face's advance with kerning against the next code point, or up to the next tab stop for a tab, which needs pen[k] (the pen where it starts) to be filled already.
// By hand at 16 px: A is 683; A before V kerns by -76, so 607; a tab at pen 683 moves 3072 - 683 = 2389.
layout_paragraph_code_point_advance(Para advance_paragraph, int advance_face_handle, int advance_position) {
  int advance_code_point = advance_paragraph.txt.cps[advance_position];
  int got = gui_seam_code_point_advance(advance_face_handle, advance_code_point, layout_paragraph_next_code_point(advance_paragraph.txt.cps, advance_position));
  if(advance_code_point == (import quill_code_point_tab)) {
    got = layout_paragraph_tab_advance(advance_paragraph.lay.pen[advance_position]);
  }
} return int got;
