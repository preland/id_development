// The offset where run ri ends, the sum of the lengths of runs 0..ri.
layout_paragraph_run_end(Para end_paragraph, int end_run_index) {
  int end_position = 0;
  int end_total = 0;
  while(end_position <= end_run_index) {
    end_total = end_total + end_paragraph.txt.runs[end_position].len;
    end_position = end_position + 1;
  }
} return int end_total;
