// Scans one line of paragraph i from code point lo, whose pen starts at x0, and returns where the line ends (exclusive). Every code point is placed in pen at its position on this line, and the code point that overflowed avail is placed too, so the caller can read pen[hi]; the next line overwrites what is past hi. With no overflow the line runs to the end of the paragraph.
// By hand at 16 px (B and E 683, a space 285, an E at 24 pt 1366; no kerning among them): in 3500 lu "BBBB EEEE" overflows at the first E, whose end is 3700, and breaks after the space at 5; a restart at 5 with the pen at 100 rewrites pen 5 to 9 as 100 to 2832 and leaves 0 to 4 alone; "AAAAAAAA" (A then A has no kerning pair) in 3000 breaks at the glyph, after four; a first code point wider than the line still takes a line of its own; with the last four code points at 24 pt the first of them ends at 2732 + 1366 = 4098, past 4000, so the line is the first four; an empty paragraph is one line ending at 0 with its pen entry at x0.
layout_paragraph_scan(View scanned_view, int scanned_paragraph_index, int scanned_start, int scanned_origin, int avail) {
  Para scanned_paragraph = scanned_view.doc.body.paras[scanned_paragraph_index];
  int scanned_run_index = para_run(scanned_paragraph, scanned_start);
  int scanned_run_end = layout_paragraph_run_end(scanned_paragraph, scanned_run_index);
} chain (View scanned_view, int scanned_paragraph_index, int scanned_start, int scanned_origin, int avail) {
  int scanned_text_length = len(scanned_paragraph.txt.cps);
  layout_paragraph_put(scanned_paragraph.lay.pen, scanned_start, scanned_origin);
  int scanned_position = layout_paragraph_walk_run(scanned_view, scanned_paragraph_index, scanned_run_index, scanned_start, scanned_run_end, scanned_start, avail);
} chain (View scanned_view, int scanned_paragraph_index, int scanned_start, int scanned_origin, int avail) {
  while(scanned_position == scanned_run_end && scanned_position < scanned_text_length) {
    scanned_run_index = scanned_run_index + 1;
    scanned_run_end = scanned_run_end + scanned_paragraph.txt.runs[scanned_run_index].len;
    scanned_position = layout_paragraph_walk_run(scanned_view, scanned_paragraph_index, scanned_run_index, scanned_position, scanned_run_end, scanned_start, avail);
  }
  int hi = scanned_text_length;
  if(layout_paragraph_fits(scanned_paragraph, scanned_start, scanned_position, avail) == 0) {
    hi = layout_paragraph_cut(scanned_paragraph, scanned_start, scanned_position - 1);
  }
} return int hi;
