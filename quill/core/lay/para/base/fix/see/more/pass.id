// Test helper: lays out paragraph 0 of the view n times in a row at 3500 lu, which is how a case sees that a pass refills its lists in place: after one pass or a thousand the lines, the pen and the height are the same, and the work grows with n only.
layout_paragraph_test_passes(View passes_view, int n) {
  int passes_position = 0;
  while(passes_position < n) {
    lay_para(passes_view, 0, 3500);
    passes_position = passes_position + 1;
  }
} return void;
given layout_paragraph_test_font given layout_paragraph_test_insert(0, "BBBB EEEE") ((import layout_paragraph_test_view), 1):((import layout_paragraph_test_view), 1) then layout_paragraph_test_first_lines:([0, 5, 0, 960, 192, 2732, 5, 9, 1152, 960, 192, 2732]) then layout_paragraph_test_first_pen:([0, 683, 1366, 2049, 2732, 0, 683, 1366, 2049, 2732]) then layout_paragraph_test_first_height:(2816) [time:O(n), mem:O(1)]
