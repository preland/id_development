// Test setup: n paragraphs, each holding the letter A, in the test document.
layout_paragraph_test_paragraphs(int paragraphs_count) {
  int paragraphs_position = 1;
  layout_paragraph_test_insert(0, "A");
  while(paragraphs_position < paragraphs_count) {
    layout_paragraph_test_split(paragraphs_position - 1, 1);
    layout_paragraph_test_insert(paragraphs_position, "A");
    paragraphs_position = paragraphs_position + 1;
  }
} return void;
