// Test helper: the ASCII bytes of s as code points.
layout_paragraph_test_code_points(string text) {
  int[] code_points_result = [];
  int code_points_position = 0;
  while(code_points_position < len(text)) {
    push(code_points_result, character_code_at(text, code_points_position));
    code_points_position = code_points_position + 1;
  }
} return int[] code_points_result;
("AB"):([65, 66])
(""):([])

// Test setup: appends s, in character row 0, to paragraph i of the test document.
layout_paragraph_test_insert(int insert_paragraph_index, string text) {
  Doc insert_document = (import layout_paragraph_test_document);
  Text insert_text = insert_document.body.paras[insert_paragraph_index].txt;
  text_insert(insert_text, len(insert_text.cps), layout_paragraph_test_code_points(text), 0);
} return void;
given layout_paragraph_test_new (0, "AB"):(0, "AB") then layout_paragraph_test_first_code_points:([65, 66])
given layout_paragraph_test_new given layout_paragraph_test_insert(0, "x") (0, "yz"):(0, "yz") then layout_paragraph_test_first_code_points:([120, 121, 122])

// Test setup: splits paragraph i of the test document at code point off.
layout_paragraph_test_split(int split_paragraph_index, int off) {
  Doc split_document = (import layout_paragraph_test_document);
  body_split(split_document.body, split_paragraph_index, off);
} return void;
