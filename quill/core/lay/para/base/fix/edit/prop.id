// Test setup: sets field of paragraph i's property row to value (the row is interned again, never edited).
layout_paragraph_test_set_property(int row_paragraph_index, int field, int value) {
  Doc row_document = (import layout_paragraph_test_document);
  Para row_paragraph = row_document.body.paras[row_paragraph_index];
  row_paragraph.pprop = tab_with(row_document.fmt.paras, row_paragraph.pprop, field, value);
} return void;
given layout_paragraph_test_new (0, 5, 600):(0, 5, 600) then layout_paragraph_test_first_property_row:([0, -1, -1, -1, -1, 600, -1, -1, 0, 0, 0, 0])
given layout_paragraph_test_new (0, 7, 150):(0, 7, 150) then layout_paragraph_test_first_property_row:([0, -1, -1, -1, -1, -1, -1, 150, 0, 0, 0, 0])

// Test setup: turns character flag bits on over lo..hi-1 of paragraph i, as the bold button would.
layout_paragraph_test_flag_bits(int bits_paragraph_index, int bits_start, int hi, int bits) {
  Doc bits_document = (import layout_paragraph_test_document);
  Text bits_text = bits_document.body.paras[bits_paragraph_index].txt;
  text_apply(bits_text, bits_start, hi, (bits_document.fmt.chars), bits, 1, (import quill_mode_bits));
} return void;
