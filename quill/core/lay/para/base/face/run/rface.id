// The face of run ri of paragraph i at layout zoom 100.
layout_paragraph_run_face(View face_view, int face_paragraph_index, int face_run_index) {
  Para face_paragraph = face_view.doc.body.paras[face_paragraph_index];
  int face_paragraph_style = tab_get(face_view.doc.fmt.paras, face_paragraph.pprop, (import quill_paragraph_style));
  int face_handle = face_for(face_view.faces, face_view.doc, face_paragraph_style, face_paragraph.txt.runs[face_run_index].cprop, (import quill_layout_zoom));
} return int face_handle;
