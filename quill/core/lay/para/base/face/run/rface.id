// The ascent (which 0) or descent (which 1) of run ri of paragraph i in lu, in whole pixels times 64: the descent is the face's own, the ascent is the rest of its line (gui_font_line, which carries the font's line gap that LibreOffice also puts in a line), never less than the face's own ascent, so a 16 px Liberation Serif line is 18 px, not 17. A raised run then gains its lift as ascent and loses it as descent (a dropped run the reverse), never going below 0.
layout_paragraph_run_metric(View metric_view, int metric_paragraph_index, int metric_run_index, int which) {
  int metric_handle = layout_paragraph_run_face(metric_view, metric_paragraph_index, metric_run_index);
  int lift = layout_paragraph_run_lift(metric_view, metric_paragraph_index, metric_run_index);
  int metric_value = 0;
} chain (View metric_view, int metric_paragraph_index, int metric_run_index, int which) {
  if(which == 0) {
    metric_value = fixed_point_maximum(gui_font_ascent(metric_handle), gui_font_line(metric_handle) - gui_font_descent(metric_handle)) * 64 + lift;
  } else {
    metric_value = gui_font_descent(metric_handle) * 64 - lift;
  }
  metric_value = fixed_point_maximum(metric_value, 0);
} return int metric_value;
