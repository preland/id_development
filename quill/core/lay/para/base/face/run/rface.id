// How far run ri of paragraph i is raised (positive) or dropped, in lu.
layout_paragraph_run_lift(View raised_view, int raised_paragraph_index, int raised_run_index) {
  Para raised_paragraph = raised_view.doc.body.paras[raised_paragraph_index];
  int raised_paragraph_style = tab_get(raised_view.doc.fmt.paras, raised_paragraph.pprop, (import quill_paragraph_style));
  int lift = face_lift(raised_view.doc, raised_paragraph_style, raised_paragraph.txt.runs[raised_run_index].cprop);
} return int lift;
