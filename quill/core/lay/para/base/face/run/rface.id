// The face of run ri of paragraph i at layout zoom 100.
lp_rface(View v, int i, int ri) {
  Para p = v.doc.body.paras[i];
  int pstyle = tab_get(v.doc.fmt.paras, p.pprop, (import word_p_style));
  int fh = face_for(v.faces, v.doc, pstyle, p.txt.runs[ri].cprop, (import word_lay_zoom));
} return int fh;
given lp_t_font given lp_t_ins(0, "AB") ((import lp_t_v), 0, 0):(1)
given lp_t_font given lp_t_ins(0, "AB") given lp_t_bits(0, 1, 2, 16) ((import lp_t_v), 0, 1):(0)

// How far run ri of paragraph i is raised (positive) or dropped, in lu.
lp_rlift(View v, int i, int ri) {
  Para p = v.doc.body.paras[i];
  int pstyle = tab_get(v.doc.fmt.paras, p.pprop, (import word_p_style));
  int lift = face_lift(v.doc, pstyle, p.txt.runs[ri].cprop);
} return int lift;
