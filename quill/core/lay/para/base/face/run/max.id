// The largest ascent (which 0) or descent (which 1) over the runs that overlap code points lo..hi-1 of paragraph i; the run holding lo always counts, so an empty paragraph measures its one run.
layout_paragraph_maximum_extent(View extent_view, int extent_paragraph_index, int extent_start, int hi, int which) {
  Para extent_paragraph = extent_view.doc.body.paras[extent_paragraph_index];
  int extent_run_index = para_run(extent_paragraph, extent_start);
  int extent_maximum = layout_paragraph_run_metric(extent_view, extent_paragraph_index, extent_run_index, which);
} chain (View extent_view, int extent_paragraph_index, int extent_start, int hi, int which) {
  int extent_run_boundary = layout_paragraph_run_end(extent_paragraph, extent_run_index);
  while(extent_run_boundary < hi) {
    extent_run_index = extent_run_index + 1;
    extent_maximum = fixed_point_maximum(extent_maximum, layout_paragraph_run_metric(extent_view, extent_paragraph_index, extent_run_index, which));
    extent_run_boundary = extent_run_boundary + extent_paragraph.txt.runs[extent_run_index].len;
  }
} return int extent_maximum;
