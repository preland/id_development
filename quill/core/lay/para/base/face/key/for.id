// The face of a run at the given zoom: its font, size and bold/italic bits are resolved through the run's row, its character style and the paragraph style pstyle, then looked up in the cache by (font index, pixel size, style bits). Only a miss reaches gui_face. Layout passes zoom 100; drawing passes the view's zoom, so a second handle is cached for the same run.
// By hand: a run with no size takes 24 half-points, 24 * 100 / 150 = 16 px; at zoom 200 it is 32 px; style 1 (Title) sets 56 half-points, 37 px; style 3 (Heading 1) sets 32 half-points and bold, 21 px bold.
face_for(Face for_face_cache, Doc for_document, int for_paragraph_style, int for_character_row, int zoom) {
  int bits = document_style_effective_character(for_document.fmt, for_paragraph_style, for_character_row, (import quill_character_on));
  int for_half_points = document_style_effective_character(for_document.fmt, for_paragraph_style, for_character_row, (import quill_character_size));
  int for_font_index = layout_paragraph_font_index(for_document, document_style_effective_character(for_document.fmt, for_paragraph_style, for_character_row, (import quill_character_font)));
} chain (Face for_face_cache, Doc for_document, int for_paragraph_style, int for_character_row, int zoom) {
  int for_pixels = face_pixel_size(for_half_points, bits, zoom);
  int fs = bits & ((import quill_flag_bold) + (import quill_flag_italic));
  int for_handle = face_find(for_face_cache, for_font_index, for_pixels, fs);
} chain (Face for_face_cache, Doc for_document, int for_paragraph_style, int for_character_row, int zoom) {
  if(for_handle < 0) {
    for_handle = gui_face(layout_paragraph_font_family(for_document, for_font_index), for_pixels, fs);
    face_add(for_face_cache, for_handle, for_font_index, for_pixels, fs);
  }
} return int for_handle;
