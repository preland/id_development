// The answer of sel_state from the samples: for a flag 0 off, 1 on, 2 mixed (and 0 when nothing was sampled); for any other field its value, -2 for mixed, -1 when nothing was sampled.
sel_out(int[] acc) {
  int res = acc[2];
  int isflag = acc[0] >= (import ed_s_flag) && acc[0] < (import ed_s_para);
  if(isflag == 1 && res == -2) {
    res = 2;
  }
} chain (int[] acc) {
  if(acc[1] == 0) {
    res = isflag - 1;
  }
} return int res;
([101, 1, 1]):(1)
([101, 1, 0]):(0)
([101, 1, -2]):(2)
([101, 0, 0]):(0)
([2, 1, 24]):(24)
([2, 1, -2]):(-2)
([2, 0, 0]):(-1)

// What is true of the selection, for the ribbon to show (docs/QUILL.md 4.3): for a flag (ed_s_flag plus a quill_flag_* bit) 0 off, 1 on, 2 mixed; for a character field (a quill_character_* offset) its effective value or -2 when the selection mixes values; for a paragraph field (ed_s_para plus a quill_paragraph_* offset) likewise. With nothing selected it describes the text the next typed character takes.
sel_state(Doc d, Ctl ctl, int field) {
  int[] acc = (import ed_acc);
  lset(acc, 0, field);
  lset(acc, 1, 0);
} chain (Doc d, Ctl ctl, int field) {
  lset(acc, 2, 0);
  sel_walk(d, ctl, acc);
  int res = sel_out(acc);
} return int res;
