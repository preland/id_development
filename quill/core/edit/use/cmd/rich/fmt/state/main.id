// The answer of sel_state from the samples: for a flag 0 off, 1 on, 2 mixed (and 0 when nothing was sampled); for any other field its value, -2 for mixed, -1 when nothing was sampled.
editor_selection_answer(int[] acc) {
  int res = acc[2];
  int is_flag_field = acc[0] >= (import ed_s_flag) && acc[0] < (import ed_s_para);
  if(is_flag_field == 1 && res == -2) {
    res = 2;
  }
} chain (int[] acc) {
  if(acc[1] == 0) {
    res = is_flag_field - 1;
  }
} return int res;
