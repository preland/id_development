// Samples what sel_state asks about into acc: a paragraph field over the paragraphs of the selection, a character field over its runs, or at the caret when nothing is selected.
sel_walk(Doc d, Ctl ctl, int[] acc) {
  int empty = sel_empty(ctl.sel);
  if(acc[0] >= (import ed_s_para)) {
    ed_over(d, ctl, smp_para, acc);
  }
  if(acc[0] < (import ed_s_para) && empty == 1) {
    smp_caret(d, ctl, acc);
  }
} chain (Doc d, Ctl ctl, int[] acc) {
  if(acc[0] < (import ed_s_para) && empty == 0) {
    ed_over(d, ctl, smp_run, acc);
  }
} return void;
given fx_setup("a*bc*d") given fx_at(0, 0, 0, 4) ((import fxd), (import fxc), [101, 0, 0]):((import fxd), (import fxc), [101, 1, -2])
given fx_setup("a*bc*d") given fx_at(0, 2, 0, 2) ((import fxd), (import fxc), [101, 0, 0]):((import fxd), (import fxc), [101, 1, 1])
