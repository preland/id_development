// Samples the character row a typed character would take at the caret (a bare caret has no selected text).
editor_sample_caret(Doc d, Ctl ctl, int[] acc) {
  int cprop = editor_character_property(d, ctl);
  editor_sample_add(d, ctl.sel.caret.para, cprop, acc);
} return void;
