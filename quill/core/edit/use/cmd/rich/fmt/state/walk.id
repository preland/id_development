// For ed_over: samples the character rows of the runs that cover code points lo..hi-1 of paragraph para (an empty paragraph gives its one empty run).
editor_sample_runs(Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  int[] runs = runs_span(d.body.paras[para].txt, lo, hi);
  int i = 1;
  while(i < len(runs)) {
    editor_sample_add(d, para, runs[i], acc);
    i = i + 3;
  }
} return void;
given editor_fixture_setup("a*bc*d") ((import fixture_document), (import fixture_control), 0, 0, 4, [101, 0, 0]):((import fixture_document), (import fixture_control), 0, 0, 4, [101, 1, -2])
