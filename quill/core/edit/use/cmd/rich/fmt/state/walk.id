// For ed_over: samples the paragraph field acc[0] - ed_s_para of paragraph para, resolved through its style.
editor_sample_paragraph(Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  Para p = d.body.paras[para];
  int got = document_style_effective_paragraph(d.fmt, p.pprop, acc[0] - (import ed_s_para));
  editor_sample_fold(acc, got);
} return void;
