// Sets the paragraph field (a quill_paragraph_* offset) to value in every paragraph the selection touches, as one undo step.
editor_set_paragraph(Doc d, Ctl ctl, int field, int value) {
  int[] acc = [field, value];
  editor_change(d, ctl, par_set, acc);
} return void;
