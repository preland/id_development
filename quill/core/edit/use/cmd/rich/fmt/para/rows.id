// Applies style (an index into the document's styles): a paragraph style goes on every paragraph the selection touches, a character style on the selected text.
editor_set_style(Doc d, Ctl ctl, int style) {
  int fam = d.fmt.sty.styles[style].rel[(import quill_style_family)];
  if(fam == 1) {
    editor_set_character(d, ctl, (import quill_character_style), style);
  } else {
    editor_set_paragraph(d, ctl, (import quill_paragraph_style), style);
  }
} return void;
