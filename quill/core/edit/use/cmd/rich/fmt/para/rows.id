// For ed_over: gives paragraph para the paragraph row it has now with the field acc[0] set to acc[1], as a SET_PPROP in the open undo step. Nothing is recorded when the row would not change, and a block the model does not edit is left alone.
par_set(Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  Para p = d.body.paras[para];
  int paragraph_row_index = tab_with(d.fmt.paras, p.pprop, acc[0], acc[1]);
  int[] location = [para];
} chain (Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  int[] dat = [paragraph_row_index];
  if(paragraph_row_index != p.pprop && editor_is_solid_block(d, para) == 0) {
    Op row_change = Op((import ed_k_pprop), location, dat);
    editor_run(d, ctl, row_change);
  }
} return void;
