// Sets the paragraph field (a word_p_* offset) to value in every paragraph the selection touches, as one undo step.
ed_set_para(Doc d, Ctl ctl, int field, int value) {
  int[] acc = [field, value];
  ed_change(d, ctl, par_set, acc);
} return void;
given fx_setup("ab|cd|ef") given fx_at(0, 1, 1, 1) ((import fxd), (import fxc), 1, 2):((import fxd), (import fxc), 1, 2) then fx_show:("{9}ab|{9}cd|ef") then fx_hist:("u1 r0 o-1 n2")
given fx_setup("ab|cd") given fx_at(1, 0, 1, 0) ((import fxd), (import fxc), 1, 1):((import fxd), (import fxc), 1, 1) then fx_show:("ab|{9}cd")

// Applies style (an index into the document's styles): a paragraph style goes on every paragraph the selection touches, a character style on the selected text.
ed_set_style(Doc d, Ctl ctl, int style) {
  int fam = d.fmt.sty.styles[style].rel[(import word_s_family)];
  if(fam == 1) {
    ed_set_char(d, ctl, (import word_c_style), style);
  } else {
    ed_set_para(d, ctl, (import word_p_style), style);
  }
} return void;
