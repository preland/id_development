// For ed_over: puts the part of paragraph para that is selected back to character row 0, and the paragraph to paragraph row 0, in the open undo step; hyperlinks stay.
editor_clear_run(Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  int[] runs = runs_span(d.body.paras[para].txt, lo, hi);
  int[] old = list_copy(runs);
  runs_zero(runs, 3);
} chain (Doc d, Ctl ctl, int para, int lo, int hi, int[] acc) {
  if(document_integers_equal(runs, old) == 0) {
    int[] location = [para, lo, hi];
    Op run_change = Op((import ed_k_runs), location, runs);
    editor_run(d, ctl, run_change);
  }
  par_reset(d, ctl, para);
} return void;
