// Clear formatting: the selected text goes back to no character formatting and every paragraph it touches to paragraph row 0, as one undo step.
editor_clear_format(Doc d, Ctl ctl) {
  int[] acc = [];
  editor_change(d, ctl, editor_clear_run, acc);
} return void;
