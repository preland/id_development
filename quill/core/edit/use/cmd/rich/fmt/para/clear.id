// Gives paragraph para the paragraph row 0 (Normal, nothing set) in the open undo step, unless it has it already or is a block the model does not edit.
par_reset(Doc d, Ctl ctl, int para) {
  int[] location = [para];
  int[] dat = [0];
  if(d.body.paras[para].pprop != 0 && editor_is_solid_block(d, para) == 0) {
    Op row_change = Op((import ed_k_pprop), location, dat);
    editor_run(d, ctl, row_change);
  }
} return void;
