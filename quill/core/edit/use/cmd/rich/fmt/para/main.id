// Sets the character field (a quill_character_* offset, or ed_s_flag plus a flag bit with value 1 on, 0 off, -1 unset, -2 off plainly) on the selected text as one undo step; with nothing selected it is the pending typing row instead.
editor_set_character(Doc d, Ctl ctl, int field, int value) {
  int[] acc = [field, value];
  if(editor_selection_empty(ctl.sel) == 1) {
    editor_set_pending(d, ctl, field, value);
  } else {
    editor_change(d, ctl, editor_format_runs, acc);
  }
} return void;
