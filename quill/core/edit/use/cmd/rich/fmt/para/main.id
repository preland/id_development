// A page setup change (field 0 to 2 a Page.size entry, 3 to 6 a margin; see ed_g_margin) as one undo step.
ed_set_page(Doc d, Ctl ctl, int field, int value) {
  int[] loc = [field];
  int[] dat = [value];
  txn_begin(ctl);
} chain (Doc d, Ctl ctl, int field, int value) {
  Op page_change = Op((import ed_k_page), loc, dat);
  ed_run(d, ctl, page_change);
  ed_close(ctl);
} return void;
