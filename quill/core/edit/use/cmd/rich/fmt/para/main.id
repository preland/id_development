// Bold, italic and the other flags (ed_toggle(d, ctl, quill_flag_bold)): when every selected character has the flag it is turned off, otherwise on for all of it, which is what Word does; with nothing selected it flips what the next typed character would get.
editor_toggle(Doc d, Ctl ctl, int bit) {
  int on = editor_selection_state(d, ctl, (import ed_s_flag) + bit);
  int val = 1;
  if(on == 1) {
    val = -2;
  }
} chain (Doc d, Ctl ctl, int bit) {
  editor_set_character(d, ctl, (import ed_s_flag) + bit, val);
} return void;
