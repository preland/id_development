// A page setup change (field 0 to 2 a Page.size entry, 3 to 6 a margin; see ed_g_margin) as one undo step.
editor_set_page(Doc d, Ctl ctl, int field, int value) {
  int[] location = [field];
  int[] dat = [value];
  editor_transaction_begin(ctl);
} chain (Doc d, Ctl ctl, int field, int value) {
  Op page_change = Op((import ed_k_page), location, dat);
  editor_run(d, ctl, page_change);
  editor_close_step(ctl);
} return void;
