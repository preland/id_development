// The character row equal to row cprop with field changed: a flag (field from ed_s_flag, the flag bit added) is turned on by 1, off by 0, unset by -1, off plainly by -2 (see fmt_val); any other field is set to value.
editor_format_row(Doc d, int para, int cprop, int field, int value) {
  int val = editor_format_value(d, para, field, value);
  int nc = cprop;
  blank;
} chain (Doc d, int para, int cprop, int field, int value) {
  if(field >= (import ed_s_flag)) {
    nc = tab_with_bits(d.fmt.chars, cprop, field - (import ed_s_flag), val);
  } else {
    nc = tab_with(d.fmt.chars, cprop, field, val);
  }
} return int nc;
