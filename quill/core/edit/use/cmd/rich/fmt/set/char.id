// Applies the change fmt_row describes to code points lo..hi-1 of text t (a copy of paragraph para's), splitting and merging runs as the model does.
editor_format_text(Doc d, int para, Text t, int lo, int hi, int field, int value) {
  int val = editor_format_value(d, para, field, value);
  if(field >= (import ed_s_flag)) {
    text_apply(t, lo, hi, (d.fmt.chars), (field - (import ed_s_flag)), val, (import quill_mode_bits));
  } else {
    text_apply(t, lo, hi, d.fmt.chars, field, val, (import quill_mode_field));
  }
} return void;
