// The value to write for a character-format change in paragraph para: value itself, except that -2 means "off, as plainly as possible": unset, unless the paragraph's style turns the flag on, when it must be an explicit 0.
editor_format_value(Doc d, int para, int field, int value) {
  Para p = d.body.paras[para];
  int sid = tab_get(d.fmt.paras, p.pprop, (import quill_paragraph_style));
  int val = value;
} chain (Doc d, int para, int field, int value) {
  if(value == -2) {
    val = -1;
  }
  if(value == -2 && (style_bits(d.fmt, sid, 0) & (field - (import ed_s_flag))) != 0) {
    val = 0;
  }
} return int val;
