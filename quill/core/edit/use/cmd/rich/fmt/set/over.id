// Calls act on paragraph i with the part of it the selection covers (pa to pb): the whole paragraph in the middle, from pa.off in the first, up to pb.off in the last.
editor_over_one_paragraph(Doc d, Ctl ctl, func(Doc, Ctl, int, int, int, int[]) return void act, int[] acc, int i, Pos pa, Pos pb) {
  int lo = 0;
  int hi = document_paragraph_length(d.body.paras[i]);
  if(i == pa.para) {
    lo = pa.off;
  }
} chain (Doc d, Ctl ctl, func(Doc, Ctl, int, int, int, int[]) return void act, int[] acc, int i, Pos pa, Pos pb) {
  if(i == pb.para) {
    hi = pb.off;
  }
  act(d, ctl, i, lo, hi, acc);
} return void;
