// An edit of the selection as one undo step: ed_over calls act (see ed_over) between the opening and the closing of the step. Nothing is recorded when act changes nothing.
editor_change(Doc d, Ctl ctl, func(Doc, Ctl, int, int, int, int[]) return void act, int[] acc) {
  editor_transaction_begin(ctl);
  editor_over_selection(d, ctl, act, acc);
  editor_close_step(ctl);
} return void;
