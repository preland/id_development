// Sets the pending typing row, the one row the next typed character takes: the row at the caret with the change [field, value]. Any caret move or edit drops it. The open undo step is closed.
editor_set_pending(Doc d, Ctl ctl, int field, int value) {
  editor_transaction_end(ctl);
  int cprop = editor_character_property(d, ctl);
  int nc = editor_format_row(d, ctl.sel.caret.para, cprop, field, value);
} chain (Doc d, Ctl ctl, int field, int value) {
  typing_set(nc);
} return void;
