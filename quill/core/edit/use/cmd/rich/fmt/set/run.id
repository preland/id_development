// Sets every step-th entry from the second to 0: with step 3 that is each run triple's character row (nothing set), and lengths and links stay.
runs_zero(int[] runs, int step) {
  int i = 1;
  while(i < len(runs)) {
    runs[i] = 0;
    i = i + step;
  }
} return void;
