// Copy: the selection becomes the fragment ctl.clip (kept with its character and paragraph rows) and its plain text is returned for the system clipboard (gfx_clip_set). Nothing selected leaves the fragment alone and returns "". It is not an edit: no undo step, and the open one stays open.
editor_copy(Doc d, Ctl ctl) {
  Pos pa = editor_selection_low(ctl.sel);
  Pos pb = editor_selection_high(ctl.sel);
  string plain = "";
} chain (Doc d, Ctl ctl) {
  if(editor_selection_empty(ctl.sel) == 0) {
    ctl.clip = clip_frag(d, pa, pb);
    plain = frag_plain(ctl.clip);
  }
} return string plain;
