// Cut: copy, then remove the selection as one undo step. Returns the plain text for the system clipboard, "" (and no change) with nothing selected.
editor_cut(Doc d, Ctl ctl) {
  string plain = editor_copy(d, ctl);
  editor_erase_transaction(d, ctl);
} return string plain;
