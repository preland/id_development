// Pastes the fragment when rich is 1 and the plain text otherwise, in the open undo step.
editor_paste_mix(Doc d, Ctl ctl, string text, int rich) {
  if(rich == 1) {
    editor_paste_rich(d, ctl);
  } else {
    editor_paste_plain(d, ctl, text);
  }
} return void;
