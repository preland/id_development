// A paste as one undo step: the selection is replaced, by the copied fragment when text is what that fragment's plain text says (the user pasted what was copied here) and by text as plain text otherwise.
editor_paste_do(Doc d, Ctl ctl, string text) {
  int rich = len(ctl.clip.txts) > 0 && text == frag_plain(ctl.clip);
  editor_begin_replace(d, ctl);
  editor_paste_mix(d, ctl, text, rich);
} chain (Doc d, Ctl ctl, string text) {
  editor_close_step(ctl);
} return void;
