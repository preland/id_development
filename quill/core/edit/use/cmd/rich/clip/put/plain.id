// The code points of a line of pasted text that may be typed (see cp_typable): carriage returns, other controls and invalid code points are dropped.
editor_code_points_can_be_typed(string line) {
  int[] cps = [];
  int i = 0;
  while(character_code_at(line, i) >= 0) {
    int cp = utf8_code_point(line, i);
    if(editor_code_point_can_be_typed(cp) == 1) {
      push(cps, cp);
    }
    i = utf8_next(line, i);
  }
} return int[] cps;
("a\tb\r"):([97, 9, 98])
