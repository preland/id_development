// Line k of pasted text: after the first, the paragraph is split at the caret; then the line goes in, in the typing properties.
editor_paste_line(Doc d, Ctl ctl, string[] pieces, int k) {
  if(k > 0) {
    editor_split(d, ctl, 0);
  }
  int[] cps = editor_code_points_can_be_typed(pieces[k]);
  if(len(cps) > 0) {
    editor_put_code_points(d, ctl, cps);
  }
} return void;
