// Pastes text that did not come from ctl.clip as plain text: line feeds start paragraphs, everything is in the typing properties. The step must already be open.
editor_paste_plain(Doc d, Ctl ctl, string text) {
  string[] pieces = str_split(text, "\n");
  int k = 0;
  while(k < len(pieces)) {
    editor_paste_line(d, ctl, pieces, k);
    k = k + 1;
  }
} return void;
