// Piece k of a fragment: after the first, the paragraph is split at the caret and the new paragraph gets the row the copied one had; then the piece's text goes in.
editor_paste_piece(Doc d, Ctl ctl, Frag frag, int k) {
  if(k > 0) {
    editor_split_row(d, ctl, frag.pprops[k]);
  }
  editor_put_text(d, ctl, frag.txts[k]);
} return void;
