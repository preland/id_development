// Inserts text t with its runs at the caret in the open undo step and moves the caret after it. An empty text changes nothing.
editor_put_text(Doc d, Ctl ctl, Text t) {
  int n = len(t.cps);
  int[] runs = runs_span(t, 0, n);
  Op edit_operation = editor_inverse_insert(ctl.sel.caret.para, ctl.sel.caret.off, t.cps, runs);
} chain (Doc d, Ctl ctl, Text t) {
  if(n > 0) {
    editor_run(d, ctl, edit_operation);
    editor_selection_put(ctl.sel, ctl.sel.caret.para, ctl.sel.caret.off + n, 0);
  }
} return void;
