// Pastes the fragment ctl.clip at the caret in the open undo step: its first text joins the paragraph at the caret and every later one starts a new paragraph, with the character and paragraph rows they were copied with.
editor_paste_rich(Doc d, Ctl ctl) {
  int k = 0;
  while(k < len(ctl.clip.txts)) {
    editor_paste_piece(d, ctl, ctl.clip, k);
    k = k + 1;
  }
} return void;
