// The history and clipboard verbs of ed_play: U undo, R redo, C copy, X cut, V paste what was copied (through its plain text, as the system clipboard would), P paste argt as foreign text.
editor_play_history(Doc d, Ctl ctl, int verb, string argument_text) {
  if(verb == 85) {
    hist_undo(d, ctl);
  }
  if(verb == 82) {
    hist_redo(d, ctl);
  }
  if(verb == 67) {
    editor_copy(d, ctl);
  }
} chain (Doc d, Ctl ctl, int verb, string argument_text) {
  if(verb == 88) {
    editor_cut(d, ctl);
  }
  if(verb == 86) {
    editor_paste(d, ctl, frag_plain(ctl.clip));
  }
  if(verb == 80) {
    editor_paste(d, ctl, argument_text);
  }
} return void;
