// The typing and deleting verbs of ed_play: T types argt, E is Enter, B Backspace, W Ctrl+Backspace, D Delete, F Ctrl+Delete.
editor_play_text(Doc d, Ctl ctl, int verb, string argument_text) {
  if(verb == 84) {
    editor_type_string(d, ctl, argument_text);
  }
  if(verb == 69) {
    editor_break(d, ctl, 0);
  }
  if(verb == 66) {
    editor_back(d, ctl, 0);
  }
} chain (Doc d, Ctl ctl, int verb, string argument_text) {
  if(verb == 87) {
    editor_back(d, ctl, 1);
  }
  if(verb == 68) {
    editor_delete(d, ctl, 0);
  }
  if(verb == 70) {
    editor_delete(d, ctl, 1);
  }
} return void;
