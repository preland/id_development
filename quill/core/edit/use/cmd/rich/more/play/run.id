given editor_fixture_setup("ab") ((import fixture_document), (import fixture_control), "?x"):((import fixture_document), (import fixture_control), "?x") then editor_fixture_show:("ab") then editor_fixture_history:("u0 r0 o-1 n0")

// Plays a script of events against the document, one event per line (the text of a "quill --script" file): T<text> types it, E presses Enter, B and W Backspace and Ctrl+Backspace, D and F Delete and Ctrl+Delete, U and R undo and redo, C X V copy, cut and paste what was copied, P<text> pastes foreign text, M<dir>:<unit>:<extend> moves, A selects all, S<para>:<off>:<para>:<off> selects, G<bit> toggles a flag, O<field>:<value> sets a character field, L<field>:<value> a paragraph field, Y<style> a style, Z clears formatting, K is a page break and H<needle>:<with> replaces all (matching case).
editor_play(Doc d, Ctl ctl, string script) {
  string[] pieces = str_split(script, "\n");
  int k = 0;
  while(k < len(pieces)) {
    editor_play_event(d, ctl, pieces[k]);
    k = k + 1;
  }
} return void;
