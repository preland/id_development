// One event of a script: the first character is the verb, the rest its argument, with ":" between numbers. Verbs (see ed_play): T E B W D F typing and deleting, U R C X V P history and clipboard, M A S G O L Y Z K H movement, selection and formatting. Anything else is skipped.
editor_play_event(Doc d, Ctl ctl, string line) {
  int verb = character_code_at(line, 0);
  int n = fixed_point_maximum(len(line) - 1, 0);
  string argument_text = str_sub(line, 1, n);
} chain (Doc d, Ctl ctl, string line) {
  string[] fields = str_split(argument_text, ":");
  editor_play_text(d, ctl, verb, argument_text);
  editor_play_history(d, ctl, verb, argument_text);
} chain (Doc d, Ctl ctl, string line) {
  editor_play_format(d, ctl, verb, fields);
} return void;
