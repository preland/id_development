// Types every code point of text, one ed_type each (so ed_type's rules and coalescing apply): what a stream of text events does.
editor_type_string(Doc d, Ctl ctl, string text) {
  int i = 0;
  while(character_code_at(text, i) >= 0) {
    editor_type(d, ctl, utf8_code_point(text, i));
    i = utf8_next(text, i);
  }
} return void;
