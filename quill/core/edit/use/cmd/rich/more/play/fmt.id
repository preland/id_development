// H<needle>:<with>: Replace All of the typable code points of the first field by the second, matching case.
editor_play_swap(Doc d, Ctl ctl, string[] fields) {
  int[] needle = editor_code_points_can_be_typed(fields[0]);
  int[] with = editor_code_points_can_be_typed(fields[1]);
  find_replace_all(d, ctl, needle, with, 1);
} return void;
