// S<para>:<off>:<para>:<off>: the first position becomes the anchor and the second the caret, as a click and a drag would.
editor_play_pick(Doc d, Ctl ctl, string[] fields) {
  int anchor_para = to_int(fields[0]);
  int anchor_off = to_int(fields[1]);
  int caret_para = to_int(fields[2]);
} chain (Doc d, Ctl ctl, string[] fields) {
  int caret_off = to_int(fields[3]);
  Pos pa = Pos(anchor_para, anchor_off);
  Pos pb = Pos(caret_para, caret_off);
} chain (Doc d, Ctl ctl, string[] fields) {
  editor_place(d, ctl, pa, 0);
  editor_place(d, ctl, pb, 1);
} return void;
