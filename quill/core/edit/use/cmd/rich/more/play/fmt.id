// The movement, selection and formatting verbs of ed_play, with flds the argument split at ":": M<dir>:<unit>:<extend> moves, A selects all, S<para>:<off>:<para>:<off> selects, G<bit> toggles a flag, O<field>:<value> sets a character field, L<field>:<value> a paragraph field, Y<style> applies a style, Z clears formatting, K is a page break, H<needle>:<with> replaces all matching case.
editor_play_format(Doc d, Ctl ctl, int verb, string[] fields) {
  if(verb == 77) {
    editor_move(d, ctl, to_int(fields[0]), to_int(fields[1]), to_int(fields[2]));
  }
  if(verb == 65) {
    editor_select_all(d, ctl);
  }
  if(verb == 83) {
    editor_play_pick(d, ctl, fields);
  }
} chain (Doc d, Ctl ctl, int verb, string[] fields) {
  if(verb == 71) {
    editor_toggle(d, ctl, to_int(fields[0]));
  }
  if(verb == 79) {
    editor_set_character(d, ctl, to_int(fields[0]), to_int(fields[1]));
  }
  if(verb == 76) {
    editor_set_paragraph(d, ctl, to_int(fields[0]), to_int(fields[1]));
  }
} chain (Doc d, Ctl ctl, int verb, string[] fields) {
  if(verb == 89) {
    editor_set_style(d, ctl, to_int(fields[0]));
  }
  if(verb == 90) {
    editor_clear_format(d, ctl);
  }
  if(verb == 75) {
    editor_break(d, ctl, 1);
  }
} chain (Doc d, Ctl ctl, int verb, string[] fields) {
  if(verb == 72) {
    editor_play_swap(d, ctl, fields);
  }
} return void;
