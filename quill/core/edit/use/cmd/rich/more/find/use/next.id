given fx_setup("One two") given fx_hit(9, 9) ((import fxd), Pos(0, 0), [111, 110, 101], 1, (import fxh)):(0)
given fx_setup("One two") given fx_hit(9, 9) ((import fxd), Pos(0, 0), [111, 110, 101], 0, (import fxh)):(1) then fx_hit_str:("0:0")

// The offsets of the matches of needle in paragraph p, ascending and not overlapping (the next search starts after the last match), ignoring ed_f_back. An empty needle has none.
find_all(Para p, int[] needle, int flags) {
  int[] ofs = [];
  int fw = flags & ~(import ed_f_back);
  int at = find_in(p, needle, 0, fw);
} chain (Para p, int[] needle, int flags) {
  while(at >= 0 && len(needle) > 0) {
    push(ofs, at);
    at = find_in(p, needle, at + len(needle), fw);
  }
} return int[] ofs;
