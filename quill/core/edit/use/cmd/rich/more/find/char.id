// The code point folded to lower case for a match that ignores case: the ASCII capitals and the Latin-1 capitals (but not the multiplication sign). Other scripts compare exactly.
editor_code_point_fold(int cp) {
  int low = cp;
  if(cp >= 65 && cp <= 90) {
    low = cp + 32;
  }
  if(cp >= 192 && cp <= 222 && cp != 215) {
    low = cp + 32;
  }
} return int low;
(65):(97)
(201):(233)
(97):(97)
(215):(215)
(1040):(1040)

// 1 when code points a and b match: equal, or equal after cp_fold unless flags has ed_f_case.
editor_code_point_same(int left_code_point, int right_code_point, int flags) {
  int res = left_code_point == right_code_point;
  if(res == 0 && (flags & (import ed_f_case)) == 0) {
    res = editor_code_point_fold(left_code_point) == editor_code_point_fold(right_code_point);
  }
} return int res;
(97, 97, 1):(1)
(65, 97, 0):(1)
(65, 97, 1):(0)
(97, 98, 0):(0)

// 1 when the code points of needle are the ones of paragraph p from off on, compared by cp_same. The needle must fit before the end of the paragraph.
find_at(Para p, int[] needle, int off, int flags) {
  int ok = 1;
  int j = 0;
  while(j < len(needle) && ok == 1) {
    ok = editor_code_point_same(p.txt.cps[off + j], needle[j], flags);
    j = j + 1;
  }
} return int ok;
(Para(Text([97, 66, 99], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), [66, 99], 1, 1):(1)
(Para(Text([97, 66, 99], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), [98, 99], 1, 1):(0)
(Para(Text([97, 66, 99], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), [98, 99], 1, 0):(1)
(Para(Text([97, 66, 99], [Run(3, 0, -1)], 0), Lay([], [], -1), 0), [97], 0, 1):(1)
