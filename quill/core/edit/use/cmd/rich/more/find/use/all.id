// Cuts both ends of a selection into the document (see pos_fit), for after an edit that made text shorter.
editor_selection_fit(Doc d, Sel sel) {
  editor_position_fit(d, sel.anchor);
  editor_position_fit(d, sel.caret);
} return void;
