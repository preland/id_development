// Cuts position ps (in place) into the document: a paragraph past the last becomes the last, an offset past the end of its paragraph becomes the end.
editor_position_fit(Doc d, Pos current_position) {
  current_position.para = fixed_point_clamp(current_position.para, 0, len(d.body.paras) - 1);
  current_position.off = fixed_point_clamp(current_position.off, 0, document_paragraph_length(d.body.paras[current_position.para]));
} return void;
