// Replace All: every match of needle in the document becomes with, as one undo step (even when there are many); answers how many it replaced, and leaves no step at all when there is none. flags is as for find_next, except that the direction is ignored. The selection is cut into the shortened document.
find_replace_all(Doc d, Ctl ctl, int[] needle, int[] with, int flags) {
  editor_transaction_end(ctl);
  int count = 0;
  int i = 0;
} chain (Doc d, Ctl ctl, int[] needle, int[] with, int flags) {
  while(i < len(d.body.paras)) {
    count = count + editor_replace_paragraph(d, ctl, i, needle, with, flags);
    i = i + 1;
  }
  editor_selection_fit(d, ctl.sel);
  editor_close_step(ctl);
} return int count;
