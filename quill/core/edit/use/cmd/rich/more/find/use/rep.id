// Replaces the n code points of needle that sit at off in paragraph para by with, in the open undo step; the new text takes the character row of the first replaced one.
editor_replace_one(Doc d, Ctl ctl, int para, int off, int[] needle, int[] with) {
  int cprop = document_paragraph_character_row(d.body.paras[para], off);
  int[] location = [para, off, cprop, 0];
  editor_delete_in(d, ctl, para, off, len(needle));
} chain (Doc d, Ctl ctl, int para, int off, int[] needle, int[] with) {
  if(len(with) > 0) {
    Op insertion = Op((import ed_k_ins), location, with);
    editor_run(d, ctl, insertion);
  }
} return void;
