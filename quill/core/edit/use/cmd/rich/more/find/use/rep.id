// Replaces every match of needle in paragraph para by with (last one first, so the offsets stay right), in the undo step opened for it, and answers how many there were.
editor_replace_paragraph(Doc d, Ctl ctl, int para, int[] needle, int[] with, int flags) {
  int[] match_offsets = find_all(d.body.paras[para], needle, flags);
  int k = len(match_offsets) - 1;
  if(k >= 0) {
    editor_open_step(ctl);
  }
} chain (Doc d, Ctl ctl, int para, int[] needle, int[] with, int flags) {
  while(k >= 0) {
    editor_replace_one(d, ctl, para, match_offsets[k], needle, with);
    k = k - 1;
  }
  int n = len(match_offsets);
} return int n;
