// The match in paragraph para when searching from position from: the first paragraph is searched from from.off, any other one from its start (its end when searching backwards).
find_row(Doc d, Pos from, int para, int[] needle, int flags) {
  Para p = d.body.paras[para];
  int back = (flags & (import ed_f_back)) != 0;
  int limit_offset = from.off;
} chain (Doc d, Pos from, int para, int[] needle, int flags) {
  if(para != from.para) {
    limit_offset = back * document_paragraph_length(p);
  }
  int at = find_in(p, needle, limit_offset, flags);
} return int at;
