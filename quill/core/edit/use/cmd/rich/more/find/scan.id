// The offset of the nearest match of needle in paragraph p that starts at or after lim, or with ed_f_back the nearest one that ends at or before lim; -1 when there is none.
find_in(Para p, int[] needle, int limit_offset, int flags) {
  int back = (flags & (import ed_f_back)) != 0;
  int at = -1;
  int i = fixed_point_minimum(limit_offset, document_paragraph_length(p)) - back * len(needle);
} chain (Para p, int[] needle, int limit_offset, int flags) {
  while(i >= 0 && i + len(needle) <= document_paragraph_length(p) && at < 0) {
    if(find_at(p, needle, i, flags) == 1) {
      at = i;
    }
    i = i + 1 - 2 * back;
  }
} return int at;
