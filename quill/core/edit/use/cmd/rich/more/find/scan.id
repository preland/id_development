// Looks for needle from from in the document, forward or (ed_f_back) backward, paragraph by paragraph, and on a match writes its start into spot and answers 1; 0 when there is none. A match never spans paragraphs.
find_scan(Doc d, Pos from, int[] needle, int flags, Pos spot) {
  int back = (flags & (import ed_f_back)) != 0;
  int para = from.para;
  int at = -1;
} chain (Doc d, Pos from, int[] needle, int flags, Pos spot) {
  int hit_paragraph = para;
  while(para >= 0 && para < len(d.body.paras) && at < 0) {
    at = find_row(d, from, para, needle, flags);
    hit_paragraph = para;
    para = para + 1 - 2 * back;
  }
  int res = at >= 0;
} chain (Doc d, Pos from, int[] needle, int flags, Pos spot) {
  if(res == 1) {
    spot.para = hit_paragraph;
    spot.off = at;
  }
} return int res;
