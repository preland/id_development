// The offset of the nearest match of needle in paragraph p that starts at or after lim, or with ed_f_back the nearest one that ends at or before lim; -1 when there is none.
find_in(Para p, int[] needle, int lim, int flags) {
  int back = (flags & (import ed_f_back)) != 0;
  int at = -1;
  int i = fixed_point_minimum(lim, para_len(p)) - back * len(needle);
} chain (Para p, int[] needle, int lim, int flags) {
  while(i >= 0 && i + len(needle) <= para_len(p) && at < 0) {
    if(find_at(p, needle, i, flags) == 1) {
      at = i;
    }
    i = i + 1 - 2 * back;
  }
} return int at;
(Para(Text([97, 98, 97, 98], [Run(4, 0, -1)], 0), Lay([], [], -1), 0), [97, 98], 1, 0):(2)
(Para(Text([97, 98, 97, 98], [Run(4, 0, -1)], 0), Lay([], [], -1), 0), [97, 98], 3, 2):(0)
(Para(Text([97, 98, 97, 98], [Run(4, 0, -1)], 0), Lay([], [], -1), 0), [97, 98], 4, 2):(2)
(Para(Text([97, 98, 97, 98], [Run(4, 0, -1)], 0), Lay([], [], -1), 0), [97, 98], 4, 3):(2)
(Para(Text([97, 98, 97, 98], [Run(4, 0, -1)], 0), Lay([], [], -1), 0), [97, 98], 3, 0):(-1)
(Para(Text([97, 98, 97, 98], [Run(4, 0, -1)], 0), Lay([], [], -1), 0), [120], 0, 0):(-1)

// The match in paragraph para when searching from position from: the first paragraph is searched from from.off, any other one from its start (its end when searching backwards).
find_row(Doc d, Pos from, int para, int[] needle, int flags) {
  Para p = d.body.paras[para];
  int back = (flags & (import ed_f_back)) != 0;
  int lim = from.off;
} chain (Doc d, Pos from, int para, int[] needle, int flags) {
  if(para != from.para) {
    lim = back * para_len(p);
  }
  int at = find_in(p, needle, lim, flags);
} return int at;
given fx_setup("ab|cab") ((import fxd), Pos(0, 1), 0, [97, 98], 0):(-1)
given fx_setup("ab|cab") ((import fxd), Pos(0, 1), 1, [97, 98], 0):(1)
given fx_setup("ab|cab") ((import fxd), Pos(1, 3), 0, [97, 98], 2):(0)
given fx_setup("ab|cab") ((import fxd), Pos(1, 3), 1, [97, 98], 2):(1)

// Looks for needle from from in the document, forward or (ed_f_back) backward, paragraph by paragraph, and on a match writes its start into spot and answers 1; 0 when there is none. A match never spans paragraphs.
find_scan(Doc d, Pos from, int[] needle, int flags, Pos spot) {
  int back = (flags & (import ed_f_back)) != 0;
  int para = from.para;
  int at = -1;
} chain (Doc d, Pos from, int[] needle, int flags, Pos spot) {
  int hp = para;
  while(para >= 0 && para < len(d.body.paras) && at < 0) {
    at = find_row(d, from, para, needle, flags);
    hp = para;
    para = para + 1 - 2 * back;
  }
  int res = at >= 0;
} chain (Doc d, Pos from, int[] needle, int flags, Pos spot) {
  if(res == 1) {
    spot.para = hp;
    spot.off = at;
  }
} return int res;
