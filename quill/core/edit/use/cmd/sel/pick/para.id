// Selects the whole paragraph of ps (what a triple click does): the anchor at its start and the caret at its end.
editor_select_paragraph(Doc d, Ctl ctl, Pos current_position) {
  Pos pa = Pos(current_position.para, 0);
  editor_place(d, ctl, pa, 0);
  editor_selection_put(ctl.sel, current_position.para, document_paragraph_length(d.body.paras[current_position.para]), 1);
} return void;
