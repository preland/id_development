// Selects the word at ps by the word rule (what a double click does).
editor_select_word(Doc d, Ctl ctl, Pos current_position) {
  Para p = d.body.paras[current_position.para];
  int lo = utf8_code_points_word_low(p.txt.cps, current_position.off);
  int hi = utf8_code_points_word_high(p.txt.cps, current_position.off);
} chain (Doc d, Ctl ctl, Pos current_position) {
  Pos word_anchor = Pos(current_position.para, lo);
  editor_place(d, ctl, word_anchor, 0);
  editor_selection_put(ctl.sel, current_position.para, hi, 1);
} return void;
