// Selects the whole document.
editor_select_all(Doc d, Ctl ctl) {
  Pos pb = editor_position_edge(d, 1);
  editor_place(d, ctl, pb, 1);
  editor_selection_put(ctl.sel, 0, 0, 0);
} chain (Doc d, Ctl ctl) {
  editor_selection_put(ctl.sel, pb.para, pb.off, 1);
} return void;
