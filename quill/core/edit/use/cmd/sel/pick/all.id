// Puts the caret at ps (cut to the document), and the anchor too unless extend is 1; this is what a mouse click does, and like any caret move it closes the open undo step and drops the pending typing row.
editor_place(Doc d, Ctl ctl, Pos current_position, int extend) {
  int para = fixed_point_clamp(current_position.para, 0, len(d.body.paras) - 1);
  int off = fixed_point_clamp(current_position.off, 0, document_paragraph_length(d.body.paras[para]));
  editor_transaction_end(ctl);
} chain (Doc d, Ctl ctl, Pos current_position, int extend) {
  typing_set(-1);
  editor_selection_put(ctl.sel, para, off, extend);
} return void;
given editor_fixture_setup("ab|cde") ((import fixture_document), (import fixture_control), Pos(1, 2), 0):((import fixture_document), (import fixture_control), Pos(1, 2), 0) then editor_fixture_selection:("1:2-1:2")
