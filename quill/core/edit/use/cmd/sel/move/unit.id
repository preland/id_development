// Moves the caret of ctl dir units without layout (see pos_unit). Unless extend is 1 the anchor follows, except that Left or Right over a selection only collapse it to its near end.
editor_move_position(Doc d, Ctl ctl, int editor_move_position_direction, int unit, int extend) {
  Pos position_result = editor_position_unit(d, ctl.sel.caret, editor_move_position_direction, unit);
  if(extend == 0 && unit == (import ed_u_char) && editor_selection_empty(ctl.sel) == 0) {
    position_result = editor_selection_edge(ctl.sel, editor_move_position_direction);
  }
  editor_selection_put(ctl.sel, position_result.para, position_result.off, extend);
} return void;
