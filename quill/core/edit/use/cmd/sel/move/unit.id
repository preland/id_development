editor_position_unit(Doc d, Pos current_position, int position_unit_direction, int unit) {
  Pos position_result = Pos(current_position.para, current_position.off);
  if(unit == (import ed_u_char)) {
    position_result = editor_position_character(d, current_position, position_unit_direction);
  }
  if(unit == (import ed_u_word)) {
    position_result = editor_position_word(d, current_position, position_unit_direction);
  }
} chain (Doc d, Pos current_position, int position_unit_direction, int unit) {
  if(unit == (import ed_u_para)) {
    position_result = editor_position_paragraph(d, current_position, position_unit_direction);
