// The end of the selection a plain Left or Right arrow collapses to: the earlier end for dir -1, the later end otherwise.
editor_selection_edge(Sel sel, int selection_edge_direction) {
  Pos position_result = editor_selection_high(sel);
  if(selection_edge_direction < 0) {
    position_result = editor_selection_low(sel);
  }
} return Pos position_result;
