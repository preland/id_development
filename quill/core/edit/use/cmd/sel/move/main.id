// Moves the caret of ctl by the layout hook (see ed_layout_hooks), on a copy of the selection so the hook may set the goal column, and then puts the result in ctl.sel.
ed_move_hook(Doc d, Ctl ctl, int dir, int unit, int extend) {
  Sel tmp = sel_copy(ctl.sel);
  func(Doc, Sel, int, int) return void mv = (import ed_mv);
  mv(d, tmp, dir, unit);
} chain (Doc d, Ctl ctl, int dir, int unit, int extend) {
  sel_put(ctl.sel, tmp.caret.para, tmp.caret.off, extend);
  ctl.sel.goal = tmp.goal;
} return void;
given fx_setup("ab|cde|f") given fx_at(1, 2, 1, 2) ((import fxd), (import fxc), 1, 2, 0):((import fxd), (import fxc), 1, 2, 0) then fx_sel:("2:1-2:1")
given fx_setup("ab|cde|f") given fx_at(1, 2, 1, 2) ((import fxd), (import fxc), -1, 2, 1):((import fxd), (import fxc), -1, 2, 1) then fx_sel:("1:2-0:2")

// Moves the caret dir units (docs/QUILL.md 4.3: dir -1 left or up, 1 right or down; unit 0 character, 1 word, 2 line, 3 paragraph, 4 page, 5 document). With extend 1 the anchor stays and the selection grows. The open undo step is closed and the pending typing row dropped, as any caret move does.
ed_move(Doc d, Ctl ctl, int dir, int unit, int extend) {
  txn_end(ctl);
  typing_set(-1);
  ed_move_to(d, ctl, dir, unit, extend);
} return void;
given fx_setup("abc") ((import fxd), (import fxc), 1, 0, 0):((import fxd), (import fxc), 1, 0, 0) then fx_sel:("0:1-0:1")
