// Picks the hook for the line and page units and the plain move for the others.
editor_move_to(Doc d, Ctl ctl, int editor_move_to_direction, int unit, int extend) {
  if(unit == (import ed_u_line) || unit == (import ed_u_page)) {
    editor_move_hook(d, ctl, editor_move_to_direction, unit, extend);
  } else {
    editor_move_position(d, ctl, editor_move_to_direction, unit, extend);
  }
} return void;
