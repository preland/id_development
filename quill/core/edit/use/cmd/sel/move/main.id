// Picks the hook for the line and page units and the plain move for the others.
ed_move_to(Doc d, Ctl ctl, int dir, int unit, int extend) {
  if(unit == (import ed_u_line) || unit == (import ed_u_page)) {
    ed_move_hook(d, ctl, dir, unit, extend);
  } else {
    ed_move_pos(d, ctl, dir, unit, extend);
  }
} return void;
