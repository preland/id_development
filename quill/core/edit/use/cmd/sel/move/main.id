// Moves the caret dir units (docs/QUILL.md 4.3: dir -1 left or up, 1 right or down; unit 0 character, 1 word, 2 line, 3 paragraph, 4 page, 5 document). With extend 1 the anchor stays and the selection grows. The open undo step is closed and the pending typing row dropped, as any caret move does.
editor_move(Doc d, Ctl ctl, int editor_move_direction, int unit, int extend) {
  editor_transaction_end(ctl);
  typing_set(-1);
  editor_move_to(d, ctl, editor_move_direction, unit, extend);
} return void;
