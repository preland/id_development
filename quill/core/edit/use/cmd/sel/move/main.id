// Moves the caret of ctl by the layout hook (see ed_layout_hooks), on a copy of the selection so the hook may set the goal column, and then puts the result in ctl.sel.
editor_move_hook(Doc d, Ctl ctl, int editor_move_hook_direction, int unit, int extend) {
  Sel selection_trial = editor_selection_copy(ctl.sel);
  func(Doc, Sel, int, int) return void layout_move = (import editor_move_slot);
  layout_move(d, selection_trial, editor_move_hook_direction, unit);
} chain (Doc d, Ctl ctl, int editor_move_hook_direction, int unit, int extend) {
  editor_selection_put(ctl.sel, selection_trial.caret.para, selection_trial.caret.off, extend);
  ctl.sel.goal = selection_trial.goal;
} return void;
