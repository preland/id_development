given fx_setup("ab|cde|f") ((import fxd), Pos(1, 1), -2):(Pos(1, 0))

// The layout hook used until real layout is installed: it moves the caret of sel as ed_line_para says for the line unit and to the document edge for the page unit; the anchor stays.
ed_hook_para(Doc d, Sel sel, int dir, int unit) {
  Pos ps = ed_line_para(d, sel.caret, dir);
  if(unit == (import ed_u_page)) {
    ps = pos_edge(d, dir);
  }
  sel_put(sel, ps.para, ps.off, 1);
} return void;
