// Where an Up, Down, Home or End goes when no layout is installed, one paragraph being one line: dir 1 and -1 are the next and previous paragraph at the same offset (cut to its length), dir 2 and -2 the end and the start of the paragraph.
editor_line_paragraph(Doc d, Pos current_position, int editor_line_para_direction) {
  int para = current_position.para;
  int n = len(d.body.paras);
  int off = current_position.off;
} chain (Doc d, Pos current_position, int editor_line_para_direction) {
  if(editor_line_para_direction == 1 && para + 1 < n) {
    para = para + 1;
  }
  if(editor_line_para_direction == -1 && para > 0) {
    para = para - 1;
  }
  off = fixed_point_minimum(off, document_paragraph_length(d.body.paras[para]));
} chain (Doc d, Pos current_position, int editor_line_para_direction) {
  if(editor_line_para_direction == 2) {
    off = document_paragraph_length(d.body.paras[para]);
  }
  if(editor_line_para_direction == -2) {
    off = 0;
  }
  Pos position_result = Pos(para, off);
} return Pos position_result;
