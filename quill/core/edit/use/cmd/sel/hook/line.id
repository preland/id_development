// Where an Up, Down, Home or End goes when no layout is installed, one paragraph being one line: dir 1 and -1 are the next and previous paragraph at the same offset (cut to its length), dir 2 and -2 the end and the start of the paragraph.
ed_line_para(Doc d, Pos ps, int dir) {
  int para = ps.para;
  int n = len(d.body.paras);
  int off = ps.off;
} chain (Doc d, Pos ps, int dir) {
  if(dir == 1 && para + 1 < n) {
    para = para + 1;
  }
  if(dir == -1 && para > 0) {
    para = para - 1;
  }
  off = fixed_point_minimum(off, para_len(d.body.paras[para]));
} chain (Doc d, Pos ps, int dir) {
  if(dir == 2) {
    off = para_len(d.body.paras[para]);
  }
  if(dir == -2) {
    off = 0;
  }
  Pos pq = Pos(para, off);
} return Pos pq;
