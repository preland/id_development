// Installs the function the line and page moves of ed_move call: mv(doc, sel, dir, unit) moves sel.caret (and may set sel.goal) for dir 1 and -1 (down and up a line or a page) and dir 2 and -2 (the end and the start of the line), as the layout does.
ed_layout_hooks(func(Doc, Sel, int, int) return void mv) {
  export func(Doc, Sel, int, int) return void ed_mv = mv;
} return void;
