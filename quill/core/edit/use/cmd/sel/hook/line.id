// The layout hook used until real layout is installed: it moves the caret of sel as ed_line_para says for the line unit and to the document edge for the page unit; the anchor stays.
editor_hook_paragraph(Doc d, Sel sel, int direction, int unit) {
  Pos current_position = editor_line_paragraph(d, sel.caret, direction);
  if(unit == (import ed_u_page)) {
    current_position = editor_position_edge(d, direction);
  }
  editor_selection_put(sel, current_position.para, current_position.off, 1);
} return void;
