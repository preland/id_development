// An Enter or page break as one undo step: the selection is replaced, the paragraph split (see ed_split), and the step closed.
editor_enter_do(Doc d, Ctl ctl, int editor_enter_do_break_kind) {
  editor_begin_replace(d, ctl);
  editor_split(d, ctl, editor_enter_do_break_kind);
  editor_close_step(ctl);
} return void;
