// 1 when paragraph para is a block the model does not edit (a table, a text box: paragraph row kind 1), 0 for text and for an index that is no paragraph.
editor_is_solid_block(Doc d, int para) {
  int res = 0;
  if(para >= 0 && para < len(d.body.paras)) {
    Para p = d.body.paras[para];
    int kind = tab_get(d.fmt.paras, p.pprop, (import quill_paragraph_kind));
    res = kind == 1;
  }
} return int res;
