// The paragraph row of the paragraph that Enter or a page break creates after one with row pprop: the same row with the page break set to brk, and at the end of the paragraph (atend 1) the style that follows its style.
editor_paragraph_property_after(Doc d, int pprop, int at_paragraph_end, int paragraph_after_break_kind) {
  int paragraph_row_index = tab_with(d.fmt.paras, pprop, (import quill_paragraph_break_before), paragraph_after_break_kind);
  int paragraph_after_next_style_index = style_next(d, tab_get(d.fmt.paras, paragraph_row_index, (import quill_paragraph_style)));
  if(at_paragraph_end == 1) {
    paragraph_row_index = tab_with(d.fmt.paras, paragraph_row_index, (import quill_paragraph_style), paragraph_after_next_style_index);
  }
} return int paragraph_row_index;
