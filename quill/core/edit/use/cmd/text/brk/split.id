// Splits the paragraph at the caret in the open undo step and puts the caret at the start of the new paragraph, which gets the row pprop_after says (a page break goes before it when brk is 1).
ed_split(Doc d, Ctl ctl, int brk) {
  Para p = d.body.paras[ctl.sel.caret.para];
  int atend = ctl.sel.caret.off == para_len(p) && brk == 0;
  int pn = pprop_after(d, p.pprop, atend, brk);
} chain (Doc d, Ctl ctl, int brk) {
  ed_split_row(d, ctl, pn);
} return void;
