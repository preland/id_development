// The style a paragraph of style sid is followed by when Enter is pressed at its end (Heading 1 is followed by Normal); a style with no next, or an id that is no style, stays itself.
style_next(Doc d, int sid) {
  int next_style_index = sid;
  if(sid >= 0 && sid < len(d.fmt.sty.styles) && d.fmt.sty.styles[sid].rel[(import quill_style_next)] >= 0) {
    next_style_index = d.fmt.sty.styles[sid].rel[(import quill_style_next)];
  }
} return int next_style_index;
