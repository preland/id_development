// The paragraph row of the paragraph that Enter or a page break creates after one with row pprop: the same row with the page break set to brk, and at the end of the paragraph (atend 1) the style that follows its style.
pprop_after(Doc d, int pprop, int atend, int brk) {
  int pn = tab_with(d.fmt.paras, pprop, (import quill_paragraph_break_before), brk);
  int nx = style_next(d, tab_get(d.fmt.paras, pn, (import quill_paragraph_style)));
  if(atend == 1) {
    pn = tab_with(d.fmt.paras, pn, (import quill_paragraph_style), nx);
  }
} return int pn;
