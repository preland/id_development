// Opens a new undo step and removes the selection in it, so that what is typed or pasted next replaces the selection and undoes with it.
editor_begin_replace(Doc d, Ctl ctl) {
  editor_transaction_begin(ctl);
  editor_erase(d, ctl);
} return void;
