// Inserts the code points cps at the caret in the character row ed_cprop gives, and moves the caret after them; the pending typing row is used up. The step must already be open.
editor_put_code_points(Doc d, Ctl ctl, int[] cps) {
  int cprop = editor_character_property(d, ctl);
  int[] location = [ctl.sel.caret.para, ctl.sel.caret.off, cprop, 0];
  Op insertion = Op((import ed_k_ins), location, cps);
} chain (Doc d, Ctl ctl, int[] cps) {
  editor_run(d, ctl, insertion);
  editor_selection_put(ctl.sel, ctl.sel.caret.para, ctl.sel.caret.off + len(cps), 0);
  typing_set(-1);
} return void;
