given fx_setup("") given ed_type((import fxd), (import fxc), 104) ((import fxd), (import fxc), 105):((import fxd), (import fxc), 105) then fx_show:("hi") then fx_hist:("u1 r0 o0 n2")

// Types the character cp at the caret, in place of the selection if there is one. A character that cannot be typed (see cp_typable) and a block the model does not edit are ignored.
ed_type(Doc d, Ctl ctl, int cp) {
  int ok = cp_typable(cp);
  if(ok == 1 && ed_solid(d, ctl.sel.caret.para) == 0) {
    ed_type_at(d, ctl, cp);
  }
} return void;
