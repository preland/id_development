// 1 when typing cp continues the open undo step, which is gui_tb's rule: a step is open, nothing is selected, a character was typed before the caret, and cp is not the first word character after a space or punctuation, so "hello world" is the steps "hello " and "world".
hist_joins(Doc d, Ctl ctl, int cp) {
  int character_class = utf8_class(cp);
  int previous_character_class = editor_previous_class(d, ctl.sel.caret);
  int cont = ctl.hist.open >= 0 && editor_selection_empty(ctl.sel) == 1 && previous_character_class >= 0 && (character_class != 1 || previous_character_class == 1);
} return int cont;
