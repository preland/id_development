given fx_setup("a ") given fx_at(0, 2, 0, 2) given txn_begin((import fxc)) ((import fxd), (import fxc), 32):(1)
given fx_setup("ab") given fx_at(0, 1, 0, 2) given txn_begin((import fxc)) ((import fxd), (import fxc), 99):(0)

// Types cp: it joins the open undo step when hist_joins says so, otherwise a new step opens (replacing the selection, if any) and stays open for the characters that follow.
ed_type_at(Doc d, Ctl ctl, int cp) {
  int cont = hist_joins(d, ctl, cp);
  int[] cps = [cp];
  if(cont == 0) {
    ed_begin_over(d, ctl);
  }
} chain (Doc d, Ctl ctl, int cp) {
  ed_put_cps(d, ctl, cps);
} return void;
