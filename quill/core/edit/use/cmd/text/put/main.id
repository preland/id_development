// Types cp: it joins the open undo step when hist_joins says so, otherwise a new step opens (replacing the selection, if any) and stays open for the characters that follow.
editor_type_at(Doc d, Ctl ctl, int cp) {
  int cont = hist_joins(d, ctl, cp);
  int[] cps = [cp];
  if(cont == 0) {
    editor_begin_replace(d, ctl);
  }
} chain (Doc d, Ctl ctl, int cp) {
  editor_put_code_points(d, ctl, cps);
} return void;
