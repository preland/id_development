// The class (0 space, 1 word character, 2 other) of the code point before ps, or -1 at the start of its paragraph.
editor_previous_class(Doc d, Pos current_position) {
  Para p = d.body.paras[current_position.para];
  int character_class = utf8_code_points_class_at(p.txt.cps, current_position.off - 1);
} return int character_class;
