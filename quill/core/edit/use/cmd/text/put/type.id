// 1 for a code point that may be typed: a printable one or a tab. Other controls (Enter and Escape arrive as text on some backends), the delete code, C1 controls, surrogates and values past U+10FFFF are not.
editor_code_point_can_be_typed(int cp) {
  int ok = cp == 9 || (cp >= 32 && cp != 127 && (cp < 128 || cp > 159) && cp <= 1114111 && (cp < 55296 || cp > 57343));
} return int ok;
