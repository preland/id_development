// The class (0 space, 1 word character, 2 other) of the code point before ps, or -1 at the start of its paragraph.
ed_prev_class(Doc d, Pos ps) {
  Para p = d.body.paras[ps.para];
  int cl = utf8_code_points_class_at(p.txt.cps, ps.off - 1);
} return int cl;
