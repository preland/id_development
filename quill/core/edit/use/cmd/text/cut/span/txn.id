// An undo step of its own that removes n code points of paragraph para from off and leaves the caret there.
editor_delete_transaction(Doc d, Ctl ctl, int para, int off, int n) {
  editor_transaction_begin(ctl);
  editor_delete_in(d, ctl, para, off, n);
  editor_selection_put(ctl.sel, para, off, 0);
} chain (Doc d, Ctl ctl, int para, int off, int n) {
  editor_close_step(ctl);
} return void;
