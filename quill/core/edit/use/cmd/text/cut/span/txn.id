// An undo step of its own that joins paragraph para with the next one and leaves the caret at the seam. When either is a block the model does not edit nothing is joined: the block is removed as a unit instead (the next paragraph's, if both are blocks) and the caret goes where it was.
editor_join_transaction(Doc d, Ctl ctl, int para) {
  int off = document_paragraph_length(d.body.paras[para]);
  int victim = para + editor_is_solid_block(d, para + 1);
  int sol = editor_is_solid_block(d, para) + editor_is_solid_block(d, para + 1);
} chain (Doc d, Ctl ctl, int para) {
  int kind = (import ed_k_join);
  int at = para;
  if(sol > 0) {
    kind = (import ed_k_delpara);
    at = victim;
  }
} chain (Doc d, Ctl ctl, int para) {
  if(sol > 0 && victim == para) {
    off = 0;
  }
  editor_transaction_begin(ctl);
  editor_one_number_operation(d, ctl, kind, at);
} chain (Doc d, Ctl ctl, int para) {
  editor_selection_put(ctl.sel, para, off, 0);
  editor_close_step(ctl);
} return void;
