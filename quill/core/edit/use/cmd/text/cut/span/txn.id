// An undo step of its own that joins paragraph para with the next one and leaves the caret at the seam. When either is a block the model does not edit nothing is joined: the block is removed as a unit instead (the next paragraph's, if both are blocks) and the caret goes where it was.
ed_join_txn(Doc d, Ctl ctl, int para) {
  int off = para_len(d.body.paras[para]);
  int victim = para + ed_solid(d, para + 1);
  int sol = ed_solid(d, para) + ed_solid(d, para + 1);
} chain (Doc d, Ctl ctl, int para) {
  int kind = (import ed_k_join);
  int at = para;
  if(sol > 0) {
    kind = (import ed_k_delpara);
    at = victim;
  }
} chain (Doc d, Ctl ctl, int para) {
  if(sol > 0 && victim == para) {
    off = 0;
  }
  txn_begin(ctl);
  ed_one(d, ctl, kind, at);
} chain (Doc d, Ctl ctl, int para) {
  sel_put(ctl.sel, para, off, 0);
  ed_close(ctl);
} return void;
