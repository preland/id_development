// Removes the selected text in the open undo step; with nothing selected it does nothing.
ed_erase(Doc d, Ctl ctl) {
  Pos pa = sel_lo(ctl.sel);
  Pos pb = sel_hi(ctl.sel);
  if(sel_empty(ctl.sel) == 0) {
    ed_erase_do(d, ctl, pa, pb);
  }
} return void;
