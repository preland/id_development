// Removes the text from pa to pb, which lie in different paragraphs, in the open undo step: the head of the last paragraph, the paragraphs between, the tail of the first one, and then the join of the two ends. The joined paragraph keeps the first one's row.
editor_delete_across(Doc d, Ctl ctl, Pos pa, Pos pb) {
  editor_delete_in(d, ctl, pb.para, 0, pb.off);
  editor_delete_middle(d, ctl, pa.para + 1, pb.para);
  editor_delete_in(d, ctl, pa.para, pa.off, document_paragraph_length(d.body.paras[pa.para]) - pa.off);
} chain (Doc d, Ctl ctl, Pos pa, Pos pb) {
  editor_one_number_operation(d, ctl, (import ed_k_join), pa.para);
} return void;
