// Removes the text from pa to pb, which lie in different paragraphs, in the open undo step: the head of the last paragraph, the paragraphs between, the tail of the first one, and then the join of the two ends. The joined paragraph keeps the first one's row.
ed_del_across(Doc d, Ctl ctl, Pos pa, Pos pb) {
  ed_del_in(d, ctl, pb.para, 0, pb.off);
  ed_del_mid(d, ctl, pa.para + 1, pb.para);
  ed_del_in(d, ctl, pa.para, pa.off, para_len(d.body.paras[pa.para]) - pa.off);
} chain (Doc d, Ctl ctl, Pos pa, Pos pb) {
  ed_one(d, ctl, (import ed_k_join), pa.para);
} return void;
given fx_setup("abc|def|ghi") given txn_begin((import fxc)) ((import fxd), (import fxc), Pos(0, 1), Pos(2, 2)):((import fxd), (import fxc), Pos(0, 1), Pos(2, 2)) then fx_show:("ai") then fx_hist:("u1 r0 o0 n4")
