// Removes the selection of ctl, in the open undo step, and puts the caret where it began.
ed_erase_do(Doc d, Ctl ctl, Pos pa, Pos pb) {
  if(pa.para == pb.para) {
    ed_del_in(d, ctl, pa.para, pa.off, pb.off - pa.off);
  } else {
    ed_del_across(d, ctl, pa, pb);
  }
  sel_put(ctl.sel, pa.para, pa.off, 0);
} return void;
