// Removes the selection of ctl, in the open undo step, and puts the caret where it began.
editor_erase_do(Doc d, Ctl ctl, Pos pa, Pos pb) {
  if(pa.para == pb.para) {
    editor_delete_in(d, ctl, pa.para, pa.off, pb.off - pa.off);
  } else {
    editor_delete_across(d, ctl, pa, pb);
  }
  editor_selection_put(ctl.sel, pa.para, pa.off, 0);
} return void;
