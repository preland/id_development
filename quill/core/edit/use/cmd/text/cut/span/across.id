// Removes the selected text in the open undo step; with nothing selected it does nothing.
editor_erase(Doc d, Ctl ctl) {
  Pos pa = editor_selection_low(ctl.sel);
  Pos pb = editor_selection_high(ctl.sel);
  if(editor_selection_empty(ctl.sel) == 0) {
    editor_erase_do(d, ctl, pa, pb);
  }
} return void;
