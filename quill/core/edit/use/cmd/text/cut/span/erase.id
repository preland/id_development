// Removes n code points of paragraph para from off, in the open undo step; n of 0 changes nothing and records nothing.
editor_delete_in(Doc d, Ctl ctl, int para, int off, int n) {
  int[] location = [para, off, n, -1, -1];
  int[] none = [];
  if(n > 0) {
    Op deletion = Op((import ed_k_del), location, none);
    editor_run(d, ctl, deletion);
  }
} return void;
