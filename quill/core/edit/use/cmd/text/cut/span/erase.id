given fx_setup("abcd") given txn_begin((import fxc)) ((import fxd), (import fxc), 0, 1, 0):((import fxd), (import fxc), 0, 1, 0) then fx_show:("abcd") then fx_hist:("u1 r0 o0 n0")

// Removes the paragraphs first up to stop - 1, last one first so the indices stay right, in the open undo step.
ed_del_mid(Doc d, Ctl ctl, int first, int stop) {
  int i = stop - 1;
  while(i >= first) {
    ed_one(d, ctl, (import ed_k_delpara), i);
    i = i - 1;
  }
} return void;
