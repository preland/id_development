// Runs the one-number operation of the given kind (a JOIN or a DEL_PARA) on paragraph para, in the open undo step.
editor_one_number_operation(Doc d, Ctl ctl, int kind, int para) {
  int[] location = [para];
  int[] none = [];
  Op operation = Op(kind, location, none);
} chain (Doc d, Ctl ctl, int kind, int para) {
  editor_run(d, ctl, operation);
} return void;
