// Removes the paragraphs first up to stop - 1, last one first so the indices stay right, in the open undo step.
editor_delete_middle(Doc d, Ctl ctl, int first, int stop) {
  int i = stop - 1;
  while(i >= first) {
    editor_one_number_operation(d, ctl, (import ed_k_delpara), i);
    i = i - 1;
  }
} return void;
