// Runs the one-number operation of the given kind (a JOIN or a DEL_PARA) on paragraph para, in the open undo step.
ed_one(Doc d, Ctl ctl, int kind, int para) {
  int[] loc = [para];
  int[] none = [];
  Op operation = Op(kind, loc, none);
} chain (Doc d, Ctl ctl, int kind, int para) {
  ed_run(d, ctl, operation);
} return void;
given fx_setup("a|b|c") given txn_begin((import fxc)) ((import fxd), (import fxc), 8, 1):((import fxd), (import fxc), 8, 1) then fx_show:("a|c") then fx_hist:("u1 r0 o0 n1")
given fx_setup("a|b|c") given txn_begin((import fxc)) ((import fxd), (import fxc), 4, 0):((import fxd), (import fxc), 4, 0) then fx_show:("ab|c")

// Removes n code points of paragraph para from off, in the open undo step; n of 0 changes nothing and records nothing.
ed_del_in(Doc d, Ctl ctl, int para, int off, int n) {
  int[] loc = [para, off, n, -1, -1];
  int[] none = [];
  if(n > 0) {
    Op deletion = Op((import ed_k_del), loc, none);
    ed_run(d, ctl, deletion);
  }
} return void;
