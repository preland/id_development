// Backspace at a bare caret: removes the code points ed_key_n counts as one undo step, or at the start of a paragraph joins it to the one before, which keeps its own row.
editor_back_one(Doc d, Ctl ctl, int by_word) {
  int para = ctl.sel.caret.para;
  int off = ctl.sel.caret.off;
  int n = editor_key_count(d, para, off, by_word, -1);
} chain (Doc d, Ctl ctl, int by_word) {
  if(n > 0) {
    editor_delete_transaction(d, ctl, para, off - n, n);
  }
  if(n == 0 && para > 0) {
    editor_join_transaction(d, ctl, para - 1);
  }
} return void;
