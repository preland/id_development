// Removes the selection as an undo step of its own, with the caret where the selection began.
editor_erase_transaction(Doc d, Ctl ctl) {
  editor_transaction_begin(ctl);
  editor_erase(d, ctl);
  editor_close_step(ctl);
} return void;
