// Delete: removes the selection when there is one, else a code point, or with by_word 1 (Ctrl+Delete) on to the start of the next word. It is one undo step, and does nothing at the very end of the document.
editor_delete(Doc d, Ctl ctl, int by_word) {
  if(editor_selection_empty(ctl.sel) == 0) {
    editor_erase_transaction(d, ctl);
  } else {
    editor_forward_one(d, ctl, by_word);
  }
} return void;
