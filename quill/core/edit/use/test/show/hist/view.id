// Test fixture: the fixture history as "u<undo steps> r<redo steps> o<open index> n<operations in the newest undo step>".
editor_fixture_history() {
  Ctl ctl = (import fixture_control);
  int n = len(ctl.hist.undo);
  int top = 0;
} chain () {
  if(n > 0) {
    top = len(ctl.hist.undo[n - 1].ops);
  }
  string text = "u" + n + " r" + len(ctl.hist.redo) + " o" + ctl.hist.open + " n" + top;
} return string text;
given editor_fixture_blank ():("u0 r0 o-1 n0")
given editor_fixture_blank given editor_transaction_begin((import fixture_control)) ():("u1 r0 o0 n0")

// Test fixture: the selections of the newest undo step, "before after", each as fx_sel writes one.
editor_fixture_transaction_selections() {
  Ctl ctl = (import fixture_control);
  Txn transaction = ctl.hist.undo[len(ctl.hist.undo) - 1];
  string text = editor_fixture_selection_of(transaction.before) + " " + editor_fixture_selection_of(transaction.after);
} return string text;
given editor_fixture_blank given editor_transaction_begin((import fixture_control)) ():("0:0-0:0 0:0-0:0")
given editor_fixture_blank given editor_fixture_selection_at(2, 1, 2, 3) given editor_transaction_begin((import fixture_control)) ():("2:1-2:3 2:1-2:3")

// Test fixture: the fragment last copied as text: its paragraphs joined by "|", each written as fx_runs writes it.
editor_fixture_clipboard() {
  Doc d = (import fixture_document);
  Ctl ctl = (import fixture_control);
  string text = "";
} chain () {
  int i = 0;
  while(i < len(ctl.clip.txts)) {
    text = text + "|" + editor_fixture_runs(d, ctl.clip.txts[i]);
    i = i + 1;
  }
  if(len(text) > 0) {
    text = str_sub(text, 1, len(text) - 1);
  }
} return string text;
given editor_fixture_blank ():("")
given editor_fixture_setup("ab*cd*|e") given editor_fixture_selection_at(0, 1, 1, 1) given editor_fixture_copied ():("b*cd*|e")
