// Test fixture: the whole fixture document as text, paragraphs joined by "|".
editor_fixture_show() {
  Doc d = (import fixture_document);
  string text = editor_fixture_paragraph(d, 0);
  int i = 1;
} chain () {
  while(i < len(d.body.paras)) {
    text = text + "|" + editor_fixture_paragraph(d, i);
    i = i + 1;
  }
} return string text;
given editor_fixture_setup("ab*cd*e|x") ():("ab*cd*e|x")
given editor_fixture_setup("") ():("")

