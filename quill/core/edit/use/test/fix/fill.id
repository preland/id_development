// Test fixture: one character of a spec. "*" turns bold on or off (togg[0]), "|" starts a paragraph, anything else is appended to the last paragraph with the bold setting in force.
editor_fixture_character(Doc d, int cp, int[] toggle_cell) {
  int last = len(d.body.paras) - 1;
  Para p = d.body.paras[last];
  int cprop = tab_with_bits(d.fmt.chars, 0, (import quill_flag_bold), 2 * toggle_cell[0] - 1);
} chain (Doc d, int cp, int[] toggle_cell) {
  if(cp == 42) {
    toggle_cell[0] = 1 - toggle_cell[0];
  }
  if(cp == 124) {
    body_split(d.body, last, document_paragraph_length(p));
  }
  if(cp != 42 && cp != 124) {
    text_insert(p.txt, document_paragraph_length(p), [cp], cprop);
  }
} return void;
given editor_fixture_blank ((import fixture_document), 97, [0]):((import fixture_document), 97, [0]) then editor_fixture_show:("a")
given editor_fixture_blank ((import fixture_document), 42, [0]):((import fixture_document), 42, [1]) then editor_fixture_show:("")
given editor_fixture_blank ((import fixture_document), 124, [0]):((import fixture_document), 124, [0]) then editor_fixture_show:("|")
given editor_fixture_blank ((import fixture_document), 98, [1]):((import fixture_document), 98, [1]) then editor_fixture_show:("*b*")

// Test fixture: appends the paragraphs and bold runs of spec (see fx_char) to d.
editor_fixture_fill(Doc d, string spec) {
  int[] toggle_cell = [0];
  int i = 0;
  while(i < len(spec)) {
    editor_fixture_character(d, character_code_at(spec, i), toggle_cell);
    i = i + 1;
  }
} return void;
given editor_fixture_blank ((import fixture_document), "ab"):((import fixture_document), "ab") then editor_fixture_show:("ab")
given editor_fixture_blank ((import fixture_document), "a*b*|c"):((import fixture_document), "a*b*|c") then editor_fixture_show:("a*b*|c")

// Test fixture: gives paragraph para of the fixture document the paragraph style sid.
editor_fixture_style(int para, int sid) {
  Doc d = (import fixture_document);
  Para p = d.body.paras[para];
  p.pprop = tab_with(d.fmt.paras, p.pprop, (import quill_paragraph_style), sid);
} return void;
given editor_fixture_setup("ab") (0, 3):() then editor_fixture_show:("{9}ab")
given editor_fixture_setup("a|b") (1, 0):() then editor_fixture_show:("a|b")
