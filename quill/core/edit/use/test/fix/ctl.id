// Test fixture: a selection as "para:off-para:off", anchor first.
editor_fixture_selection_of(Sel sel) {
  string text = sel.anchor.para + ":" + sel.anchor.off + "-" + sel.caret.para + ":" + sel.caret.off;
} return string text;
(Sel(Pos(1, 2), Pos(3, 4), -1)):("1:2-3:4")
(Sel(Pos(0, 0), Pos(0, 0), 5)):("0:0-0:0")

// Test fixture: pushes a step on the redo stack of ctl.
editor_fixture_push_redo(Ctl ctl, Txn transaction) {
  push(ctl.hist.redo, transaction);
} return void;
given editor_fixture_blank ((import fixture_control), Txn([], Sel(Pos(0, 0), Pos(0, 0), -1), Sel(Pos(0, 0), Pos(0, 0), -1))):((import fixture_control), Txn([], Sel(Pos(0, 0), Pos(0, 0), -1), Sel(Pos(0, 0), Pos(0, 0), -1))) then editor_fixture_history:("u0 r1 o-1 n0")
given editor_fixture_blank ((import fixture_control), Txn([], Sel(Pos(0, 0), Pos(0, 0), -1), Sel(Pos(0, 1), Pos(0, 1), -1))):((import fixture_control), Txn([], Sel(Pos(0, 0), Pos(0, 0), -1), Sel(Pos(0, 1), Pos(0, 1), -1))) then editor_fixture_history:("u0 r1 o-1 n0")

// Test fixture: makes paragraph para of the fixture document a block the model does not edit (paragraph row with kind 1).
editor_fixture_opaque(int para) {
  Doc d = (import fixture_document);
  Para p = d.body.paras[para];
  p.pprop = tab_with(d.fmt.paras, p.pprop, (import quill_paragraph_kind), 1);
} return void;
given editor_fixture_setup("ab") (0):() then editor_fixture_show:("{9}ab")
given editor_fixture_setup("a|b") (1):() then editor_fixture_show:("a|{9}b")
