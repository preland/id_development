// Test fixture: runs row k of the command table on the document, with the selection it arms (see fx_arm).
editor_fixture_command(Doc d, Ctl ctl, int k) {
  int[] row = list_slice((import ed_t_cmds), k * (import ed_t_cstride), (import ed_t_cstride));
  if(row[0] < 10) {
    editor_fixture_command_text(d, ctl, row);
  }
  if(row[0] >= 10 && row[0] < 20) {
    editor_fixture_command_format(d, ctl, row);
  }
} chain (Doc d, Ctl ctl, int k) {
  if(row[0] >= 20) {
    editor_fixture_command_more(d, ctl, row);
  }
} return void;
