// Test fixture: puts the fixture selection where row k of the command table (ed_t_cmds in conf.id) says, and for a paste does what comes before it (fx_pre_copy).
editor_fixture_arm(Doc d, Ctl ctl, int k) {
  int[] row = list_slice((import ed_t_cmds), k * (import ed_t_cstride), (import ed_t_cstride));
  Sel sel = editor_selection_make(row[1], row[2], row[3], row[4]);
  editor_selection_load(ctl.sel, sel);
} chain (Doc d, Ctl ctl, int k) {
  if(row[0] == 20) {
    editor_fixture_prepare_copy(d, ctl, row);
  }
} return void;
