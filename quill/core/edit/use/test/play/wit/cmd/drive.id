// Test fixture: puts the fixture selection where row k of the command table (ed_t_cmds in conf.id) says, and for a paste does what comes before it (fx_pre_copy).
fx_arm(Doc d, Ctl ctl, int k) {
  int[] row = lst_slice((import ed_t_cmds), k * (import ed_t_cstride), (import ed_t_cstride));
  Sel sel = sel_make(row[1], row[2], row[3], row[4]);
  sel_load(ctl.sel, sel);
} chain (Doc d, Ctl ctl, int k) {
  if(row[0] == 20) {
    fx_pre_copy(d, ctl, row);
  }
} return void;
given fx_rich ((import fxd), (import fxc), 1):((import fxd), (import fxc), 1) then fx_sel:("0:1-0:3")
given fx_rich ((import fxd), (import fxc), 10):((import fxd), (import fxc), 10) then fx_sel:("0:2-2:1")
given fx_rich ((import fxd), (import fxc), 21):((import fxd), (import fxc), 21) then fx_sel:("2:1-2:1")

// Test fixture: runs row k of the command table on the document, with the selection it arms (see fx_arm).
fx_cmd(Doc d, Ctl ctl, int k) {
  int[] row = lst_slice((import ed_t_cmds), k * (import ed_t_cstride), (import ed_t_cstride));
  if(row[0] < 10) {
    fx_cmd_text(d, ctl, row);
  }
  if(row[0] >= 10 && row[0] < 20) {
    fx_cmd_fmt(d, ctl, row);
  }
} chain (Doc d, Ctl ctl, int k) {
  if(row[0] >= 20) {
    fx_cmd_more(d, ctl, row);
  }
} return void;
given fx_rich given fx_arm((import fxd), (import fxc), 2) ((import fxd), (import fxc), 2):((import fxd), (import fxc), 2) then fx_show:("ab|*cd*e|fgh|ij*k*|**")
given fx_rich given fx_arm((import fxd), (import fxc), 14) ((import fxd), (import fxc), 14):((import fxd), (import fxc), 14) then fx_show:("a[9:b][10:cd]e|fgh|ij*k*|**")

// Test fixture: the fixture document and selection as one string, which an edit and its undo must leave as they were.
fx_dumpsel(Doc d) {
  string text = doc_dump(d) + "#" + fx_sel();
} return string text;
