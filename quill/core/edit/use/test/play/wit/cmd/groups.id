// Test fixture: the other commands of the table: 20 paste what fx_arm copied; 21 replace all of the code point row[5] by two of row[6]; 22 toggle flag row[5] and then type row[6].
editor_fixture_command_more(Doc d, Ctl ctl, int[] row) {
  if(row[0] == 20) {
    editor_paste(d, ctl, frag_plain(ctl.clip));
  }
  if(row[0] == 21) {
    editor_fixture_swap_two(d, ctl, row);
  }
  if(row[0] == 22) {
    editor_toggle(d, ctl, row[5]);
    editor_type(d, ctl, row[6]);
  }
} return void;
