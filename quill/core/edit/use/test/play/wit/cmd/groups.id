// Test fixture: the typing, deleting and clipboard commands of the table: 0 type row[5], 1 Enter, 2 Backspace (row[5] 1 for the word), 3 Delete (likewise), 4 page break, 5 cut, 6 paste ed_t_paste.
editor_fixture_command_text(Doc d, Ctl ctl, int[] row) {
  if(row[0] == 0) {
    editor_type(d, ctl, row[5]);
  }
  if(row[0] == 1) {
    editor_break(d, ctl, 0);
  }
  if(row[0] == 2) {
    editor_back(d, ctl, row[5]);
  }
} chain (Doc d, Ctl ctl, int[] row) {
  if(row[0] == 3) {
    editor_delete(d, ctl, row[5]);
  }
  if(row[0] == 4) {
    editor_break(d, ctl, 1);
  }
  if(row[0] == 5) {
    editor_cut(d, ctl);
  }
} chain (Doc d, Ctl ctl, int[] row) {
  if(row[0] == 6) {
    editor_paste(d, ctl, (import ed_t_paste));
  }
} return void;
