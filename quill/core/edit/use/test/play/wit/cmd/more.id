// Test fixture: for the paste command of the table: copies the selection and then puts the caret at paragraph row[5], offset row[6], which is what the user did before pressing paste. None of that is an edit, so the witness takes its first snapshot after it.
editor_fixture_prepare_copy(Doc d, Ctl ctl, int[] row) {
  Pos current_position = Pos(row[5], row[6]);
  editor_copy(d, ctl);
  editor_place(d, ctl, current_position, 0);
} return void;
given editor_fixture_rich given editor_fixture_selection_at(0, 1, 1, 1) ((import fixture_document), (import fixture_control), [20, 0, 1, 1, 1, 2, 1, 0]):((import fixture_document), (import fixture_control), [20, 0, 1, 1, 1, 2, 1, 0]) then editor_fixture_selection:("2:1-2:1") then editor_fixture_clipboard:("b*cd*e|f")
given editor_fixture_rich given editor_fixture_selection_at(0, 1, 0, 3) ((import fixture_document), (import fixture_control), [20, 0, 1, 0, 3, 3, 0, 0]):((import fixture_document), (import fixture_control), [20, 0, 1, 0, 3, 3, 0, 0]) then editor_fixture_selection:("3:0-3:0") then editor_fixture_clipboard:("b*c*")

// Test fixture: replaces every code point row[5] by two of row[6], matching case, as Replace All.
editor_fixture_swap_two(Doc d, Ctl ctl, int[] row) {
  int[] needle = [row[5]];
  int[] with = [row[6], row[6]];
  find_replace_all(d, ctl, needle, with, 1);
} return void;
