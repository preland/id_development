// Test fixture: replaces every code point row[5] by two of row[6], matching case, as Replace All.
fx_swap_two(Doc d, Ctl ctl, int[] row) {
  int[] needle = [row[5]];
  int[] with = [row[6], row[6]];
  find_replace_all(d, ctl, needle, with, 1);
} return void;
