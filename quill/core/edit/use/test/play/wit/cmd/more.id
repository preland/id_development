// Test fixture: for the paste command of the table: copies the selection and then puts the caret at paragraph row[5], offset row[6], which is what the user did before pressing paste. None of that is an edit, so the witness takes its first snapshot after it.
fx_pre_copy(Doc d, Ctl ctl, int[] row) {
  Pos ps = Pos(row[5], row[6]);
  ed_copy(d, ctl);
  ed_place(d, ctl, ps, 0);
} return void;
given fx_rich given fx_at(0, 1, 1, 1) ((import fxd), (import fxc), [20, 0, 1, 1, 1, 2, 1, 0]):((import fxd), (import fxc), [20, 0, 1, 1, 1, 2, 1, 0]) then fx_sel:("2:1-2:1") then fx_clip:("b*cd*e|f")
