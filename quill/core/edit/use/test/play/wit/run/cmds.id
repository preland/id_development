// Test fixture: the verdict for command k of the table (see fx_code) when it is run, undone and redone on the fixture document: the document and the selection are compared as one string (fx_dumpsel) before the command, after its undo (must equal the first) and after its redo (must equal the one after the command), and the document invariants must hold at the end.
editor_fixture_command_verdict(int k) {
  Doc d = (import fixture_document);
  Ctl ctl = (import fixture_control);
  editor_fixture_arm(d, ctl, k);
} chain (int k) {
  string dump_before = editor_fixture_dump_selection(d);
  editor_fixture_command(d, ctl, k);
  string dump_applied = editor_fixture_dump_selection(d);
} chain (int k) {
  hist_undo(d, ctl);
  string dump_undone = editor_fixture_dump_selection(d);
  hist_redo(d, ctl);
} chain (int k) {
  string dump_redone = editor_fixture_dump_selection(d);
  int code = editor_fixture_code(dump_before, dump_applied, dump_undone, dump_redone);
  if(code == 0 && doc_check(d) != 0) {
    code = 4;
  }
} return int code;
