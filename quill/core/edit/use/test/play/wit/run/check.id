// Test fixture: 1 when the fixture document is what the long session must leave, built here from the cycle's paragraphs alone ("hello world" and "zz" ed_t_rounds times, then an empty paragraph), 0 otherwise.
editor_fixture_session_ok() {
  string want = string_repeat("hello world|zz|", (import ed_t_rounds));
  string actual = editor_fixture_show();
  int ok = actual == want;
} return int ok;
given editor_fixture_session ():(1)
given editor_fixture_setup("hello world|zz|") ():(0)

// Test fixture: 1 when the fixture document and its selection are those of a new document, 0 otherwise.
editor_fixture_is_blank() {
  Doc fresh_document = doc_new();
  string want = doc_dump(fresh_document);
  string actual = doc_dump((import fixture_document));
} chain () {
  int ok = actual == want && editor_fixture_selection() == "0:0-0:0";
} return int ok;
given editor_fixture_blank ():(1)
given editor_fixture_setup("a") ():(0)
given editor_fixture_session given editor_fixture_unwind ():(1)
