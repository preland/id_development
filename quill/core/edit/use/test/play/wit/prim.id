// Test fixture: row k of the table of primitive operations (ed_t_ops in conf.id) as an operation.
fx_op(int k) {
  int[] row = lst_slice((import ed_t_ops), k * (import ed_t_stride), (import ed_t_stride));
  int[] loc = lst_slice(row, 1, 5);
  int[] dat = lst_slice(row, 7, row[6]);
} chain (int k) {
  Op eo = Op(row[0], loc, dat);
} return Op eo;
(0):(Op(1, [0, 1, 0, 0, 0], [120]))
(13):(Op(7, [1, 0, 0, 0, 0], [0, 2, 122, 122, 2, 0, -1]))
(16):(Op(9, [2, 0, 0, 0, 0], [1]))

// Test fixture: the verdict of an apply-undo-redo round trip from the four dumps: before the operation, after it, after its inverse and after the inverse of the inverse. 0 when the operation changed something, its inverse restored the first dump and the inverse of that restored the second; 1 when the operation changed nothing (a witness that cannot fail), 2 when the first restore differs, 3 when the second does.
fx_code(string dump0, string dump1, string dump2, string dump3) {
  int code = 0;
  if(dump0 == dump1) {
    code = 1;
  }
  if(code == 0 && dump2 != dump0) {
    code = 2;
  }
} chain (string dump0, string dump1, string dump2, string dump3) {
  if(code == 0 && dump3 != dump1) {
    code = 3;
  }
} return int code;
("a", "b", "a", "b"):(0)
("a", "a", "a", "a"):(1)
("a", "b", "c", "b"):(2)
("a", "b", "a", "c"):(3)

// Test fixture: applies primitive k of the table to the fixture document, then its inverse, then the inverse of that, and returns fx_code of the four doc_dump strings, or 4 when a document invariant (doc_check) broke on the way.
fx_twice(int k) {
  Doc d = (import fxd);
  string dump0 = doc_dump(d);
  Op inv = op_apply(d, fx_op(k));
} chain (int k) {
  string dump1 = doc_dump(d);
  int chk = doc_check(d);
  Op inv2 = op_apply(d, inv);
} chain (int k) {
  string dump2 = doc_dump(d);
  chk = chk + doc_check(d);
  Op inv3 = op_apply(d, inv2);
} chain (int k) {
  string dump3 = doc_dump(d);
  int code = fx_code(dump0, dump1, dump2, dump3);
  if(code == 0 && chk + doc_check(d) != 0) {
    code = 4;
  }
} return int code;
given fx_rich (0):(0)
