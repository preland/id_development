// Test fixture: row k of the table of primitive operations (ed_t_ops in conf.id) as an operation.
editor_fixture_operation(int k) {
  int[] row = list_slice((import ed_t_ops), k * (import ed_t_stride), (import ed_t_stride));
  int[] location = list_slice(row, 1, 5);
  int[] dat = list_slice(row, 7, row[6]);
} chain (int k) {
  Op edit_operation = Op(row[0], location, dat);
} return Op edit_operation;
(0):(Op(1, [0, 1, 0, 0, 0], [120]))
(13):(Op(7, [1, 0, 0, 0, 0], [0, 2, 122, 122, 2, 0, -1]))
(16):(Op(9, [2, 0, 0, 0, 0], [1]))

// Test fixture: the verdict of an apply-undo-redo round trip from the four dumps: before the operation, after it, after its inverse and after the inverse of the inverse. 0 when the operation changed something, its inverse restored the first dump and the inverse of that restored the second; 1 when the operation changed nothing (a witness that cannot fail), 2 when the first restore differs, 3 when the second does.
editor_fixture_code(string dump_before, string dump_applied, string dump_undone, string dump_redone) {
  int code = 0;
  if(dump_before == dump_applied) {
    code = 1;
  }
  if(code == 0 && dump_undone != dump_before) {
    code = 2;
  }
} chain (string dump_before, string dump_applied, string dump_undone, string dump_redone) {
  if(code == 0 && dump_redone != dump_applied) {
    code = 3;
  }
} return int code;
("a", "b", "a", "b"):(0)
("a", "a", "a", "a"):(1)
("a", "b", "c", "b"):(2)
("a", "b", "a", "c"):(3)

// Test fixture: applies primitive k of the table to the fixture document, then its inverse, then the inverse of that, and returns fx_code of the four doc_dump strings, or 4 when a document invariant (doc_check) broke on the way.
editor_fixture_twice(int k) {
  Doc d = (import fixture_document);
  string dump_before = doc_dump(d);
  Op inverse = editor_operation_apply(d, editor_fixture_operation(k));
} chain (int k) {
  string dump_applied = doc_dump(d);
  int check_result = doc_check(d);
  Op inverse_of_inverse = editor_operation_apply(d, inverse);
} chain (int k) {
  string dump_undone = doc_dump(d);
  check_result = check_result + doc_check(d);
  Op inverse_of_inverse_again = editor_operation_apply(d, inverse_of_inverse);
} chain (int k) {
  string dump_redone = doc_dump(d);
  int code = editor_fixture_code(dump_before, dump_applied, dump_undone, dump_redone);
  if(code == 0 && check_result + doc_check(d) != 0) {
    code = 4;
  }
} return int code;
