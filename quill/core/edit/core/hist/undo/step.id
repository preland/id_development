// Applies a step's operations last to first and returns what each answered, in the order they were applied: that list is the step that undoes the undo.
hist_apply(Doc d, Op[] ops) {
  Op[] inverses = [];
  int i = len(ops) - 1;
  while(i >= 0) {
    Op inverse = editor_operation_apply(d, ops[i]);
    push(inverses, inverse);
    i = i - 1;
  }
} return Op[] inverses;
given editor_fixture_setup("ab") ((import fixture_document), [Op(2, [0, 0, 1, -1, -1], [])]):([Op(1, [0, 0, 0, 1], [97, 1, 0, -1])]) then editor_fixture_show:("b")
given editor_fixture_setup("ab") ((import fixture_document), []):([]) then editor_fixture_show:("ab")

// Puts back the selection a step recorded: the one from before it, or the one from after it when redoing. The pending typing row is dropped too.
hist_land(Ctl ctl, Txn transaction, int again) {
  Sel sel = transaction.before;
  if(again == 1) {
    sel = transaction.after;
  }
  editor_selection_load(ctl.sel, sel);
} chain (Ctl ctl, Txn transaction, int again) {
  typing_set(-1);
} return void;
