// Undoes the last step: the open one is closed first, the document and selection go back, and the step moves to the redo stack. Answers 1, or 0 when there was nothing to undo.
hist_undo(Doc d, Ctl ctl) {
  editor_transaction_end(ctl);
  int ok = 0;
  if(len(ctl.hist.undo) > 0) {
    hist_step(d, ctl, ctl.hist.undo, ctl.hist.redo, 0);
    ok = 1;
  }
} return int ok;
