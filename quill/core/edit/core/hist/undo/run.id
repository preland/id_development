// Redoes the step the last undo took back, and answers 1, or 0 when there is nothing to redo.
hist_redo(Doc d, Ctl ctl) {
  editor_transaction_end(ctl);
  int ok = 0;
  if(len(ctl.hist.redo) > 0) {
    hist_step(d, ctl, ctl.hist.redo, ctl.hist.undo, 1);
    ok = 1;
  }
} return int ok;
