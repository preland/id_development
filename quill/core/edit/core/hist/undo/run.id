// Undoes the last step: the open one is closed first, the document and selection go back, and the step moves to the redo stack. Answers 1, or 0 when there was nothing to undo.
hist_undo(Doc d, Ctl ctl) {
  txn_end(ctl);
  int ok = 0;
  if(len(ctl.hist.undo) > 0) {
    hist_step(d, ctl, ctl.hist.undo, ctl.hist.redo, 0);
    ok = 1;
  }
} return int ok;
given fx_setup("a") ((import fxd), (import fxc)):(0) then fx_show:("a")
given fx_setup("a") given ed_type((import fxd), (import fxc), 98) ((import fxd), (import fxc)):(1) then fx_show:("a") then fx_hist:("u0 r1 o-1 n0")

// Redoes the step the last undo took back, and answers 1, or 0 when there is nothing to redo.
hist_redo(Doc d, Ctl ctl) {
  txn_end(ctl);
  int ok = 0;
  if(len(ctl.hist.redo) > 0) {
    hist_step(d, ctl, ctl.hist.redo, ctl.hist.undo, 1);
    ok = 1;
  }
} return int ok;
given fx_setup("a") ((import fxd), (import fxc)):(0) then fx_show:("a")
given fx_setup("a") given ed_type((import fxd), (import fxc), 98) given fx_undo ((import fxd), (import fxc)):(1) then fx_show:("ba") then fx_hist:("u1 r0 o-1 n1")
