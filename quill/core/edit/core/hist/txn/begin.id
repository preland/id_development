// Adds the inverse operation inv to the open step, so that undoing the step applies it; the operation that does nothing is not kept. There must be an open step.
hist_note(Ctl ctl, Op inv) {
  Txn tx = ctl.hist.undo[ctl.hist.open];
  if(inv.kind != (import ed_k_nop)) {
    push(tx.ops, inv);
  }
} return void;
