// Opens a new undo step that records the selection to come back to, closing the open one first and emptying the redo stack: a new edit makes redo meaningless.
editor_transaction_begin(Ctl ctl) {
  editor_transaction_end(ctl);
  Op[] ops = [];
  Sel before = editor_selection_copy(ctl.sel);
} chain (Ctl ctl) {
  Sel after = editor_selection_copy(ctl.sel);
  Txn transaction = Txn(ops, before, after);
  push(ctl.hist.undo, transaction);
} chain (Ctl ctl) {
  ctl.hist.open = len(ctl.hist.undo) - 1;
  hist_drop(ctl.hist.redo);
} return void;
