// Opens a new undo step that records the selection to come back to, closing the open one first and emptying the redo stack: a new edit makes redo meaningless.
txn_begin(Ctl ctl) {
  txn_end(ctl);
  Op[] ops = [];
  Sel before = sel_copy(ctl.sel);
} chain (Ctl ctl) {
  Sel after = sel_copy(ctl.sel);
  Txn tx = Txn(ops, before, after);
  push(ctl.hist.undo, tx);
} chain (Ctl ctl) {
  ctl.hist.open = len(ctl.hist.undo) - 1;
  hist_drop(ctl.hist.redo);
} return void;
