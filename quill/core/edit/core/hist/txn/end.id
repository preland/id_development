// Seals the open step at index at: it records the selection to restore on redo, and a step that holds no operation is dropped.
hist_seal(Ctl ctl, int at) {
  Txn transaction = ctl.hist.undo[at];
  transaction.after = editor_selection_copy(ctl.sel);
  ctl.hist.open = -1;
} chain (Ctl ctl, int at) {
  if(len(transaction.ops) == 0) {
    pop(ctl.hist.undo);
  }
} return void;
