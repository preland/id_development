// One code point to the left: across the paragraph start to the end of the previous paragraph, and not past the start of the document.
editor_position_back(Doc d, Pos current_position) {
  int para = current_position.para;
  int off = current_position.off - 1;
  if(off < 0 && para > 0) {
    para = para - 1;
    off = document_paragraph_length(d.body.paras[para]);
  }
} chain (Doc d, Pos current_position) {
  off = fixed_point_maximum(off, 0);
  Pos position_result = Pos(para, off);
} return Pos position_result;
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(1, 0)):(Pos(0, 2))
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(0, 0)):(Pos(0, 0))
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(1, 2)):(Pos(1, 1))

// One code point to the right: across the paragraph end to the start of the next paragraph, and not past the end of the document.
editor_position_forward(Doc d, Pos current_position) {
  int para = current_position.para;
  int off = current_position.off + 1;
  if(off > document_paragraph_length(d.body.paras[para]) && para + 1 < len(d.body.paras)) {
    para = para + 1;
    off = 0;
  }
} chain (Doc d, Pos current_position) {
  off = fixed_point_minimum(off, document_paragraph_length(d.body.paras[para]));
  Pos position_result = Pos(para, off);
} return Pos position_result;
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(0, 2)):(Pos(1, 0))
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(1, 3)):(Pos(1, 3))
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(0, 0)):(Pos(0, 1))

// The position dir code points from ps: -1 left, 1 right, anything else stays.
editor_position_character(Doc d, Pos current_position, int position_char_direction) {
  Pos position_result = Pos(current_position.para, current_position.off);
  if(position_char_direction < 0) {
    position_result = editor_position_back(d, current_position);
  }
  if(position_char_direction > 0) {
    position_result = editor_position_forward(d, current_position);
  }
} return Pos position_result;
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(1, 0), -1):(Pos(0, 2)) then calls editor_position_back:[1]
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(0, 2), 1):(Pos(1, 0)) then calls editor_position_forward:[1]
given editor_fixture_setup("ab|cde") ((import fixture_document), Pos(0, 1), 0):(Pos(0, 1))
