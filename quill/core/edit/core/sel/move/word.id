// Ctrl+Right: to the start of the next word, or from the end of a paragraph to the start of the next one.
editor_position_word_next(Doc d, Pos current_position) {
  Para p = d.body.paras[current_position.para];
  int off = utf8_code_points_word_next(p.txt.cps, current_position.off);
  int n = len(d.body.paras);
} chain (Doc d, Pos current_position) {
  int para = current_position.para;
  if(off == current_position.off && para + 1 < n) {
    para = para + 1;
    off = 0;
  }
  Pos position_result = Pos(para, off);
} return Pos position_result;
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 0)):(Pos(0, 4))
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 7)):(Pos(1, 0))
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(1, 3)):(Pos(1, 3))

// Ctrl+Left: to the start of the word before, or from the start of a paragraph to the end of the previous one.
editor_position_word_previous(Doc d, Pos current_position) {
  Para p = d.body.paras[current_position.para];
  int off = utf8_code_points_word_previous(p.txt.cps, current_position.off);
  int para = current_position.para;
} chain (Doc d, Pos current_position) {
  if(off == current_position.off && para > 0) {
    para = para - 1;
    off = document_paragraph_length(d.body.paras[para]);
  }
  Pos position_result = Pos(para, off);
} return Pos position_result;
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 4)):(Pos(0, 0))
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(1, 0)):(Pos(0, 7))
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 0)):(Pos(0, 0))

// The position dir words from ps: -1 back, 1 forward, anything else stays.
editor_position_word(Doc d, Pos current_position, int position_word_direction) {
  Pos position_result = Pos(current_position.para, current_position.off);
  if(position_word_direction < 0) {
    position_result = editor_position_word_previous(d, current_position);
  }
  if(position_word_direction > 0) {
    position_result = editor_position_word_next(d, current_position);
  }
} return Pos position_result;
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 4), -1):(Pos(0, 0)) then calls editor_position_word_previous:[1]
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 0), 1):(Pos(0, 4)) then calls editor_position_word_next:[1]
given editor_fixture_setup("foo bar|baz") ((import fixture_document), Pos(0, 4), 0):(Pos(0, 4))
