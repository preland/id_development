// Ctrl+Up and Ctrl+Down: up goes to the start of the paragraph, or of the one before when already there; down goes to the start of the next, or to the end of the last paragraph.
editor_position_paragraph(Doc d, Pos current_position, int position_para_direction) {
  int para = current_position.para;
  int off = 0;
  int n = len(d.body.paras);
} chain (Doc d, Pos current_position, int position_para_direction) {
  if(position_para_direction < 0 && current_position.off == 0 && para > 0) {
    para = para - 1;
  }
  if(position_para_direction > 0 && para + 1 < n) {
    para = para + 1;
  }
  if(position_para_direction > 0 && para == current_position.para) {
    off = document_paragraph_length(d.body.paras[para]);
  }
} chain (Doc d, Pos current_position, int position_para_direction) {
  Pos position_result = Pos(para, off);
} return Pos position_result;
given editor_fixture_setup("ab|cde|f") ((import fixture_document), Pos(1, 2), -1):(Pos(1, 0))
given editor_fixture_setup("ab|cde|f") ((import fixture_document), Pos(1, 0), -1):(Pos(0, 0))
given editor_fixture_setup("ab|cde|f") ((import fixture_document), Pos(1, 2), 1):(Pos(2, 0))
given editor_fixture_setup("ab|cde|f") ((import fixture_document), Pos(2, 0), 1):(Pos(2, 1))

// The start of the document for dir -1, the end of it for dir 1.
editor_position_edge(Doc d, int position_edge_direction) {
  int para = len(d.body.paras) - 1;
  int off = document_paragraph_length(d.body.paras[para]);
  if(position_edge_direction < 0) {
    para = 0;
    off = 0;
  }
} chain (Doc d, int position_edge_direction) {
  Pos position_result = Pos(para, off);
} return Pos position_result;
given editor_fixture_setup("ab|cde|f") ((import fixture_document), -1):(Pos(0, 0))
given editor_fixture_setup("ab|cde|f") ((import fixture_document), 1):(Pos(2, 1))
