
// A new selection from the four numbers of its anchor and its caret; the goal is unset.
sel_make(int para, int off, int para2, int off2) {
  Pos pa = Pos(para, off);
  Pos pb = Pos(para2, off2);
  Sel sel = Sel(pa, pb, -1);
} return Sel sel;
(0, 1, 2, 3):(Sel(Pos(0, 1), Pos(2, 3), -1))
(4, 0, 4, 0):(Sel(Pos(4, 0), Pos(4, 0), -1))

// A selection with nothing shared with sel, for a Txn to keep.
sel_copy(Sel sel) {
  Sel nsel = sel_make(sel.anchor.para, sel.anchor.off, sel.caret.para, sel.caret.off);
  nsel.goal = sel.goal;
} return Sel nsel;
(Sel(Pos(0, 1), Pos(2, 3), 40)):(Sel(Pos(0, 1), Pos(2, 3), 40)) then calls sel_make:(0, 1, 2, 3)
(Sel(Pos(1, 1), Pos(1, 1), -1)):(Sel(Pos(1, 1), Pos(1, 1), -1)) then calls sel_make:(1, 1, 1, 1)
