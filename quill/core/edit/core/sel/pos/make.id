
// A new selection from the four numbers of its anchor and its caret; the goal is unset.
editor_selection_make(int para, int off, int caret_paragraph, int caret_offset) {
  Pos pa = Pos(para, off);
  Pos pb = Pos(caret_paragraph, caret_offset);
  Sel sel = Sel(pa, pb, -1);
} return Sel sel;
(0, 1, 2, 3):(Sel(Pos(0, 1), Pos(2, 3), -1))
(4, 0, 4, 0):(Sel(Pos(4, 0), Pos(4, 0), -1))

// A selection with nothing shared with sel, for a Txn to keep.
editor_selection_copy(Sel sel) {
  Sel selection_clone = editor_selection_make(sel.anchor.para, sel.anchor.off, sel.caret.para, sel.caret.off);
  selection_clone.goal = sel.goal;
} return Sel selection_clone;
(Sel(Pos(0, 1), Pos(2, 3), 40)):(Sel(Pos(0, 1), Pos(2, 3), 40)) then calls editor_selection_make:(0, 1, 2, 3)
(Sel(Pos(1, 1), Pos(1, 1), -1)):(Sel(Pos(1, 1), Pos(1, 1), -1)) then calls editor_selection_make:(1, 1, 1, 1)
