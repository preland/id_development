// The later end of the selection in document order, as a position of its own.
editor_selection_high(Sel sel) {
  Pos current_position = Pos(sel.caret.para, sel.caret.off);
  if(document_position_less(sel.caret, sel.anchor) == 1) {
    current_position.para = sel.anchor.para;
    current_position.off = sel.anchor.off;
  }
} return Pos current_position;
(Sel(Pos(1, 2), Pos(3, 0), -1)):(Pos(3, 0))
(Sel(Pos(3, 0), Pos(1, 2), -1)):(Pos(3, 0))

// Puts the caret at para, off (and the anchor too unless extend is 1) and forgets the goal column.
editor_selection_put(Sel sel, int para, int off, int extend) {
  sel.caret.para = para;
  sel.caret.off = off;
  sel.goal = -1;
} chain (Sel sel, int para, int off, int extend) {
  if(extend == 0) {
    sel.anchor.para = para;
    sel.anchor.off = off;
  }
} return void;
(Sel(Pos(0, 0), Pos(0, 0), 5), 2, 3, 0):(Sel(Pos(2, 3), Pos(2, 3), -1), 2, 3, 0)
(Sel(Pos(0, 0), Pos(0, 1), 5), 2, 3, 1):(Sel(Pos(0, 0), Pos(2, 3), -1), 2, 3, 1)
