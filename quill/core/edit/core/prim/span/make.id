// Applies one operation to the document and returns the operation that undoes it; applying that one returns an operation equal to this one in effect, which is what makes undo and redo one mechanism.
editor_operation_apply(Doc d, Op edit_operation) {
  Op inverse = editor_apply_nothing();
  int k = edit_operation.kind;
  if(k == (import ed_k_ins)) {
    inverse = editor_apply_insert(d, edit_operation);
  }
} chain (Doc d, Op edit_operation) {
  if(k == (import ed_k_del)) {
    inverse = editor_apply_delete(d, edit_operation);
  }
  if(k == (import ed_k_split)) {
    inverse = editor_apply_split(d, edit_operation);
  }
  if(k == (import ed_k_join)) {
    inverse = editor_apply_join(d, edit_operation);
  }
} chain (Doc d, Op edit_operation) {
  if(k == (import ed_k_runs)) {
    inverse = editor_apply_runs(d, edit_operation);
  }
  if(k == (import ed_k_pprop)) {
    inverse = editor_apply_paragraph_property(d, edit_operation);
  }
  if(k == (import ed_k_inspara)) {
    inverse = editor_apply_insert_paragraph(d, edit_operation);
  }
} chain (Doc d, Op edit_operation) {
  if(k == (import ed_k_delpara)) {
    inverse = editor_apply_delete_paragraph(d, edit_operation);
  }
  if(k == (import ed_k_page)) {
    inverse = editor_apply_page(d, edit_operation);
  }
  editor_touch();
} return Op inverse;
