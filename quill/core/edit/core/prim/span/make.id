
// The operation that does nothing, which is also what a primitive that cannot apply (a join after the last paragraph) answers with as its own inverse.
editor_apply_nothing() {
  int[] none = [];
  Op edit_operation = Op((import ed_k_nop), none, none);
} return Op edit_operation;
