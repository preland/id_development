// A whole paragraph as numbers: [pprop, code point count, the code points, then its runs as triples], for INS_PARA and DEL_PARA to carry.
para_snap(Para p) {
  int[] snap = [p.pprop, len(p.txt.cps)];
  int[] runs = runs_span(p.txt, 0, len(p.txt.cps));
  list_extend(snap, p.txt.cps);
} chain (Para p) {
  list_extend(snap, runs);
} return int[] snap;
(Para(Text([97, 98], [Run(1, 0, -1), Run(1, 5, 2)], 3), Lay([], [], 9), 7)):([7, 2, 97, 98, 1, 0, -1, 1, 5, 2])
(Para(Text([], [Run(0, 5, -1)], 0), Lay([], [], -1), 3)):([3, 0, 0, 5, -1])

// The paragraph a snapshot describes, with a stale layout.
para_unsnap(int[] snap) {
  int n = snap[1];
  int[] cps = list_slice(snap, 2, n);
  int[] runs = list_slice(snap, 2 + n, len(snap) - 2 - n);
} chain (int[] snap) {
  Run[] rs = [];
  runs_load(rs, 0, runs);
  Text t = Text(cps, rs, 0);
} chain (int[] snap) {
  Para p = para_make(t, snap[0]);
} return Para p;
([7, 2, 97, 98, 1, 0, -1, 1, 5, 2]):(Para(Text([97, 98], [Run(1, 0, -1), Run(1, 5, 2)], 0), Lay([], [], -1), 7))
([3, 0, 0, 5, -1]):(Para(Text([], [Run(0, 5, -1)], 0), Lay([], [], -1), 3))

// Gives an empty paragraph its one empty run the properties cprop and link; a paragraph with text, or a cprop below 0, is left alone.
empty_fix(Text t, int cprop, int link) {
  int[] runs = [0, cprop, link];
  if(len(t.cps) == 0 && cprop >= 0) {
    text_runs_set(t, 0, 0, runs);
  }
} return void;
(Text([], [Run(0, 1, -1)], 0), 4, 2):(Text([], [Run(0, 4, 2)], 1), 4, 2)
(Text([1], [Run(1, 1, -1)], 0), 4, 2):(Text([1], [Run(1, 1, -1)], 0), 4, 2)
(Text([], [Run(0, 1, -1)], 0), -1, -1):(Text([], [Run(0, 1, -1)], 0), -1, -1)
