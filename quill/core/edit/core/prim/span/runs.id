// Appends to acc the [len, cprop, link] triple of the part of run ru (which starts at code point at) that lies inside lo..hi-1; a run outside it adds nothing.
run_clip(Run ru, int at, int lo, int hi, int[] acc) {
  int ia = fixed_point_maximum(at, lo);
  int iz = fixed_point_minimum(at + ru.len, hi);
  if(iz > ia) {
    push(acc, iz - ia);
    push(acc, ru.cprop);
    push(acc, ru.link);
  }
} return void;
(Run(3, 5, -1), 0, 1, 2, []):(Run(3, 5, -1), 0, 1, 2, [1, 5, -1])
(Run(3, 5, 7), 4, 0, 9, []):(Run(3, 5, 7), 4, 0, 9, [3, 5, 7])
(Run(3, 5, -1), 0, 4, 9, []):(Run(3, 5, -1), 0, 4, 9, [])

// The runs that cover code points lo..hi-1, as [len, cprop, link] triples clipped to that span. An empty paragraph (lo = hi = 0) gives its one empty run, so SET_RUNS can put it back.
runs_span(Text t, int lo, int hi) {
  int[] acc = [];
  int at = 0;
  int i = 0;
} chain (Text t, int lo, int hi) {
  while(i < len(t.runs)) {
    run_clip(t.runs[i], at, lo, hi, acc);
    at = at + t.runs[i].len;
    i = i + 1;
  }
  if(len(t.cps) == 0) {
    push(acc, 0);
    push(acc, t.runs[0].cprop);
    push(acc, t.runs[0].link);
  }
} return int[] acc;
(Text([1, 2, 3, 4], [Run(2, 0, -1), Run(2, 5, 3)], 0), 1, 3):([1, 0, -1, 1, 5, 3])
(Text([], [Run(0, 4, -1)], 0), 0, 0):([0, 4, -1])
(Text([1, 2], [Run(2, 0, -1)], 0), 1, 1):([])

// [cprop, link] of the one empty run of an empty paragraph, which is what a delete leaves behind and an insert would overwrite; [-1, -1] for a paragraph with text.
text_keep(Text t) {
  int[] keep_properties = [-1, -1];
  if(len(t.cps) == 0) {
    keep_properties[0] = t.runs[0].cprop;
    keep_properties[1] = t.runs[0].link;
  }
} return int[] keep_properties;
(Text([], [Run(0, 4, 2)], 0)):([4, 2])
(Text([1], [Run(1, 4, 2)], 0)):([-1, -1])
