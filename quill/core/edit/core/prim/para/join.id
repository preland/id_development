// JOIN, at = [para], data none or [cprop, link]: paragraph para takes in the next one and keeps its own row. Past the last paragraph it does nothing.
editor_apply_join(Doc d, Op edit_operation) {
  Op inverse = editor_apply_nothing();
  if(edit_operation.at[0] + 1 < len(d.body.paras)) {
    inverse = editor_apply_join_do(d, edit_operation.at[0], edit_operation.data);
  }
} return Op inverse;
