// Appends to dat what a SPLIT needs to undo the join of paragraph para and the one after it: the row of the one that goes away, then the kept empty-run properties of each side.
join_note(Doc d, int para, int[] dat) {
  int[] keep_left = text_keep(d.body.paras[para].txt);
  int[] keep_right = text_keep(d.body.paras[para + 1].txt);
  push(dat, d.body.paras[para + 1].pprop);
} chain (Doc d, int para, int[] dat) {
  list_extend(dat, keep_left);
  list_extend(dat, keep_right);
} return void;
