// Joins paragraph para and the next one (fix is JOIN's data, see join_fix), and returns the SPLIT that undoes it.
editor_apply_join_do(Doc d, int para, int[] fix) {
  int[] dat = [];
  int off = document_paragraph_length(d.body.paras[para]);
  join_note(d, para, dat);
} chain (Doc d, int para, int[] fix) {
  body_join(d.body, para);
  join_fix(d, para, fix);
  int[] location = [para, off];
} chain (Doc d, int para, int[] fix) {
  Op inverse = Op((import ed_k_split), location, dat);
} return Op inverse;
