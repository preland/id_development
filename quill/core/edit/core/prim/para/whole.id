// INS_PARA, at = [index], data = a para_snap: the paragraph goes in at index. The inverse is the DEL_PARA of it.
editor_apply_insert_paragraph(Doc d, Op edit_operation) {
  Para np = para_unsnap(edit_operation.data);
  body_insert(d.body, edit_operation.at[0], np);
  int[] location = list_copy(edit_operation.at);
} chain (Doc d, Op edit_operation) {
  int[] none = [];
  Op inverse = Op((import ed_k_delpara), location, none);
} return Op inverse;
given editor_fixture_setup("ab|cd") ((import fixture_document), Op(7, [1], [0, 2, 120, 121, 2, 0, -1])):(Op(8, [1], [])) then editor_fixture_show:("ab|xy|cd")
given editor_fixture_setup("ab") ((import fixture_document), Op(7, [1], [3, 0, 0, 8, -1])):(Op(8, [1], [])) then editor_fixture_show:("ab|{3}**")

// DEL_PARA, at = [index]: the paragraph is removed, and the inverse INS_PARA carries its snapshot. The only paragraph of a document is never removed (the answer is the operation that does nothing).
editor_apply_delete_paragraph(Doc d, Op edit_operation) {
  Op inverse = editor_apply_nothing();
  if(len(d.body.paras) > 1) {
    inverse = editor_apply_delete_paragraph_do(d, edit_operation.at[0]);
  }
} return Op inverse;
given editor_fixture_setup("ab|cd") ((import fixture_document), Op(8, [1], [])):(Op(7, [1], [0, 2, 99, 100, 2, 0, -1])) then editor_fixture_show:("ab")
given editor_fixture_setup("ab") ((import fixture_document), Op(8, [0], [])):(Op(0, [], [])) then editor_fixture_show:("ab")

// Removes paragraph index and returns the INS_PARA that puts it back.
editor_apply_delete_paragraph_do(Doc d, int index) {
  int[] snap = para_snap(d.body.paras[index]);
  body_remove(d.body, index);
  int[] location = [index];
} chain (Doc d, int index) {
  Op inverse = Op((import ed_k_inspara), location, snap);
} return Op inverse;
given editor_fixture_setup("ab|c*d*") ((import fixture_document), 1):(Op(7, [1], [0, 2, 99, 100, 1, 0, -1, 1, 8, -1])) then editor_fixture_show:("ab")
given editor_fixture_setup("ab|cd|ef") ((import fixture_document), 0):(Op(7, [0], [0, 2, 97, 98, 2, 0, -1])) then editor_fixture_show:("cd|ef")
