// The INS_TEXT that undoes a delete of cps at para, off: the code points followed by the runs that covered them, so the runs come back exactly.
editor_inverse_insert(int para, int off, int[] cps, int[] runs) {
  int run_count = len(runs) / 3;
  int cprop = 0;
  int[] dat = list_copy(cps);
} chain (int para, int off, int[] cps, int[] runs) {
  if(run_count > 0) {
    cprop = runs[1];
  }
  list_extend(dat, runs);
  int[] location = [para, off, cprop, run_count];
} chain (int para, int off, int[] cps, int[] runs) {
  Op edit_operation = Op((import ed_k_ins), location, dat);
} return Op edit_operation;
(1, 2, [7, 8], [2, 5, -1]):(Op(1, [1, 2, 5, 1], [7, 8, 2, 5, -1]))
(0, 0, [], []):(Op(1, [0, 0, 0, 0], []))

// DEL_TEXT, at = [para, off, count, keep cprop, keep link]: removes count code points; when that empties the paragraph and keep cprop is not -1, the empty run gets those properties. The inverse is an INS_TEXT that brings back the code points and their runs.
editor_apply_delete(Doc d, Op edit_operation) {
  Para p = d.body.paras[edit_operation.at[0]];
  int lo = edit_operation.at[1];
  int hi = lo + edit_operation.at[2];
} chain (Doc d, Op edit_operation) {
  int[] cps = list_slice(p.txt.cps, lo, hi - lo);
  int[] runs = runs_span(p.txt, lo, hi);
  text_delete(p.txt, lo, hi);
} chain (Doc d, Op edit_operation) {
  empty_fix(p.txt, edit_operation.at[3], edit_operation.at[4]);
  para_stale(p);
  Op inverse = editor_inverse_insert(edit_operation.at[0], lo, cps, runs);
} return Op inverse;
given editor_fixture_setup("abc") ((import fixture_document), Op(2, [0, 1, 1, -1, -1], [])):(Op(1, [0, 1, 0, 1], [98, 1, 0, -1])) then editor_fixture_show:("ac")
