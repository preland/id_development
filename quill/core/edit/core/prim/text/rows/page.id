// The list of the page a SET_PAGE field lives in: 0 to 2 are Page.size, ed_g_margin and above are Page.margin.
page_list(Page pg, int field) {
  int[] cells = pg.size;
  if(field >= (import ed_g_margin)) {
    cells = pg.margin;
  }
} return int[] cells;
(Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 1):([1, 2, 0])
(Page([1, 2, 0], [3, 4, 5, 6], [0, 0, 0]), 4):([3, 4, 5, 6])

// The index inside page_list's list of a SET_PAGE field.
editor_page_index(int field) {
  int page_index_page_field_index = field;
  if(field >= (import ed_g_margin)) {
    page_index_page_field_index = field - (import ed_g_margin);
  }
} return int page_index_page_field_index;
(4):(1)
(6):(3)
(1):(1)

// SET_PAGE, at = [field], data = [the new value]: a page size entry (0 width, 1 height, 2 orientation) or a margin (3 top, 4 right, 5 bottom, 6 left). The inverse sets the old value. Every paragraph is marked stale, since the text area they are laid out in changes.
editor_apply_page(Doc d, Op edit_operation) {
  int[] cells = page_list(d.body.page, edit_operation.at[0]);
  int apply_page_page_field_index = editor_page_index(edit_operation.at[0]);
  int[] old = [cells[apply_page_page_field_index]];
} chain (Doc d, Op edit_operation) {
  cells[apply_page_page_field_index] = edit_operation.data[0];
  d.body.rev = d.body.rev + 1;
  int[] location = list_copy(edit_operation.at);
} chain (Doc d, Op edit_operation) {
  Op inverse = Op((import ed_k_page), location, old);
  editor_stale_all(d);
} return Op inverse;
