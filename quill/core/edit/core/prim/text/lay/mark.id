// Marks paragraph para of d stale (height -1) when there is such a paragraph, and does nothing for an index outside the document.
editor_stale(Doc d, int para) {
  if(para >= 0 && para < len(d.body.paras)) {
    d.body.paras[para].lay.h = 0 - 1;
  }
} return void;
given editor_fixture_setup("ab|cd") given editor_fixture_fresh ((import fixture_document), 1):((import fixture_document), 1) then editor_fixture_stale:("0,-1")
given editor_fixture_setup("ab|cd") given editor_fixture_fresh ((import fixture_document), 2):((import fixture_document), 2) then editor_fixture_stale:("0,0")

// Marks every paragraph of d stale: what setting a page field does, since the text area every paragraph is laid out in changes with it (a primitive that touches one paragraph marks that one, para_stale).
editor_stale_all(Doc d) {
  int i = 0;
  while(i < len(d.body.paras)) {
    editor_stale(d, i);
    i = i + 1;
  }
} return void;
