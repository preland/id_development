// `gym ai probe` as its own program: grade one sample answer to one item of a
// pack against a running model server, to see the grader work before it is wired
// into a session. Usage: gymprobe PACK_DIRECTORY ITEM_ID ANSWER [URL]; the URL
// defaults to GYM_MODEL_URL, then http://127.0.0.1:8184. It prints the feedback
// one labelled field per line (status: graded, self_grade, unsure, refused or
// unreachable, and why). Nothing is written but a throwaway log.

main(int argc, string[] argv) {
  string probe_url = model_address();
  if (argc > 4) {
    probe_url = argv[4];
  }
  string probe_text = "usage: gymprobe PACK_DIRECTORY ITEM_ID ANSWER [URL]";
} chain (int argc, string[] argv) {
  if (argc >= 4) {
    probe_text = probe_lines(probe_attempt(probe_url, argv[1], argv[2], argv[3]));
  }
  print(probe_text);
} return int 0;
